t\t}\n\t\t\t\t\tcfg.checkChars = n\n\t\t\t\t\tj = len(arg)\n\t\t\t\t\tcontinue\n\t\t\t\tdefault:\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid option -- '%c'\", ch)\n\t\t\t\t}\n\t\t\t\tj++\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tpositional = append(positional, arg)\n\t}\n\treturn cfg, positional, nil\n}\n\n// compareKey extracts the portion of a line used for comparison after\n// applying field skip (-f), char skip (-s), and width limit (-w).\nfunc compareKey(line string, cfg config) string {\n\ts := line\n\t// R3.2: Skip fields.\n\tfor n := 0; n < cfg.skipFields && len(s) > 0; n++ {\n\t\t// Skip leading blanks before the field.\n\t\tfor len(s) > 0 && (s[0] == ' ' || s[0] == '\\t') {\n\t\t\ts = s[1:]\n\t\t}\n\t\t// Skip non-blank characters (the field itself).\n\t\tfor len(s) > 0 && s[0] != ' ' && s[0] != '\\t' {\n\t\t\ts = s[1:]\n\t\t}\n\t}\n\t// R3.3: Skip characters.\n\tif cfg.skipChars > 0 {\n\t\tif cfg.skipChars >= len(s) {\n\t\t\ts = \"\"\n\t\t} else {\n\t\t\ts = s[cfg.skipChars:]\n\t\t}\n\t}\n\t// R3.4: Limit comparison width.\n\tif cfg.checkChars > 0 && cfg.checkChars < len(s) {\n\t\ts = s[:cfg.checkChars]\n\t}\n\t// R3.1: Case folding.\n\tif cfg.ignoreCase {\n\t\ts = strings.Map(unicode.ToLower, s)\n\t}\n\treturn s\n}\n\nfunc run(cfg config, input io.Reader, output io.Writer) error {\n\tdelim := byte('\\n')\n\tif cfg.zeroTerm {\n\t\tdelim = 0\n\t}\n\n\tw := bufio.NewWriter(output)\n\tdefer w.Flush()\n\n\treader := bufio.NewReader(input)\n\tvar prevLine string\n\tvar prevKey string\n\tcount := 0\n\tfirstGroup := true\n\t// For -D separate/prepend, track lines in current group.\n\tvar groupLines []string\n\n\tflush := func() error {\n\t\tif count == 0 {\n\t\t\treturn nil\n\t\t}\n\t\tshouldPrint := true\n\t\tif cfg.repeated && !cfg.unique && count < 2 {\n\t\t\tshouldPrint = false\n\t\t}\n\t\tif cfg.unique && !cfg.repeated && count != 1 {\n\t\t\tshouldPrint = false\n\t\t}\n\t\tif cfg.repeated && cfg.unique {\n\t\t\t// -d and -u together: no output (GNU behavior).\n\t\t\tshouldPrint = false\n\t\t}\n\n\t\tif cfg.allRepeated != \"\" {\n\t\t\t// -D mode: handled separately via groupLines.\n\t\t\tif count >= 2 {\n\t\t\t\tif cfg.allRepeated == \"prepend\" || (cfg.allRepeated == \"separate\" && !firstGroup) {\n\t\t\t\t\tif _, err := fmt.Fprintf(w, \"%c\", delim); err != nil {\n\t\t\t\t\t\treturn err\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tfirstGroup = false\n\t\t\t\tfor _, l := range groupLines {\n\t\t\t\t\tif _, err := fmt.Fprintf(w, \"%s%c\", l, delim); err != nil {\n\t\t\t\t\t\treturn err\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tgroupLines = groupLines[:0]\n\t\t\treturn nil\n\t\t}\n\n\t\tif !shouldPrint {\n\t\t\treturn nil\n\t\t}\n\t\tif cfg.count {\n\t\t\tif _, err := fmt.Fprintf(w, \"%7d %s%c\", count, prevLine, delim); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t} else {\n\t\t\tif _, err := fmt.Fprintf(w, \"%s%c\", prevLine, delim); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}\n\n\tfor {\n\t\tline, err := readLine(reader, delim)\n\t\tif err == io.EOF {\n\t\t\tbreak\n\t\t}\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\n\t\tkey := compareKey(line, cfg)\n\n\t\tif count == 0 {\n\t\t\tprevLine = line\n\t\t\tprevKey = key\n\t\t\tcount = 1\n\t\t\tif cfg.allRepeated != \"\" {\n\t\t\t\tgroupLines = append(groupLines, line)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\tif key == prevKey {\n\t\t\tcount++\n\t\t\tif cfg.allRepeated != \"\" {\n\t\t\t\tgroupLines = append(groupLines, line)\n\t\t\t}\n\t\t} else {\n\t\t\tif err := flush(); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tprevLine = line\n\t\t\tprevKey = key\n\t\t\tcount = 1\n\t\t\tif cfg.allRepeated != \"\" {\n\t\t\t\tgroupLines = append(groupLines, line)\n\t\t\t}\n\t\t}\n\t}\n\n\treturn flush()\n}\n\n// readLine reads up to the delimiter, stripping the delimiter from the result.\nfunc readLine(r *bufio.Reader, delim byte) (string, error) {\n\tvar buf []byte\n\tfor {\n\t\tchunk, err := r.ReadBytes(delim)\n\t\tif len(chunk) > 0 {\n\t\t\t// Strip trailing delimiter if present.\n\t\t\tif chunk[len(chunk)-1] == delim {\n\t\t\t\tbuf = append(buf, chunk[:len(chunk)-1]...)\n\t\t\t\treturn string(buf), nil\n\t\t\t}\n\t\t\tbuf = append(buf, chunk...)\n\t\t}\n\t\tif err != nil {\n\t\t\tif len(buf) > 0 {\n\t\t\t\treturn string(buf), nil\n\t\t\t}\n\t\t\treturn \"\", err\n\t\t}\n\t}\n}\n\nfunc printUsage(w io.Writer) {\n\tfmt.Fprintf(w, `Usage: uniq [OPTION]... [INPUT [OUTPUT]]\nFilter adjacent matching lines from INPUT (or standard input),\nwriting to OUTPUT (or standard output).\n\nWith no options, matching lines are merged to the first occurrence.\n\n  -c, --count           prefix lines by the number of occurrences\n  -d, --repeated        only print duplicate lines, one for each group\n  -D, --all-repeated[=METHOD]  print all duplicate lines;\n                          groups can be delimited with an empty line;\n                          METHOD={none(default),prepend,separate}\n  -f, --skip-fields=N   avoid comparing the first N fields\n  -i, --ignore-case     ignore differences in case when comparing\n  -s, --skip-chars=N    avoid comparing the first N characters\n  -u, --unique          only print unique lines\n  -w, --check-chars=N   compare no more than N characters in lines\n  -z, --zero-terminated  line delimiter is NUL, not newline\n      --help            display this help and exit\n      --version         output version information and exit\n`)\n}\n","structuredPatch":[],"originalFile":null}}
