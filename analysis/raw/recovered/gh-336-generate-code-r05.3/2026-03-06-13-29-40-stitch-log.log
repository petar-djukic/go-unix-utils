alue (not another flag).\n\t\t\tif i+1 < len(args) && (args[i+1] == \"none\" || args[i+1] == \"prepend\" || args[i+1] == \"separate\") {\n\t\t\t\tout = append(out, \"-D=\"+args[i+1])\n\t\t\t\ti++\n\t\t\t} else {\n\t\t\t\tout = append(out, \"-D=none\")\n\t\t\t}\n\t\t} else if strings.HasPrefix(a, \"--all-repeated=\") {\n\t\t\tout = append(out, \"-D=\"+a[len(\"--all-repeated=\"):])\n\t\t} else if strings.HasPrefix(a, \"--all-repeated\") {\n\t\t\tout = append(out, \"-D=none\")\n\t\t} else {\n\t\t\tout = append(out, a)\n\t\t}\n\t}\n\treturn out\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tvar cfg config\n\tvar showVersion bool\n\tfs := flag.NewFlagSet(\"uniq\", flag.ContinueOnError)\n\tfs.SetOutput(os.Stderr)\n\tfs.BoolVar(&cfg.count, \"c\", false, \"\")\n\tfs.BoolVar(&cfg.repeated, \"d\", false, \"\")\n\tfs.StringVar(&cfg.allRepeated, \"D\", \"\", \"\")\n\tfs.BoolVar(&cfg.unique, \"u\", false, \"\")\n\tfs.BoolVar(&cfg.ignoreCase, \"i\", false, \"\")\n\tfs.IntVar(&cfg.skipFields, \"f\", 0, \"\")\n\tfs.IntVar(&cfg.skipChars, \"s\", 0, \"\")\n\tfs.IntVar(&cfg.checkChars, \"w\", 0, \"\")\n\tfs.BoolVar(&cfg.zeroTerm, \"z\", false, \"\")\n\tfs.BoolVar(&showVersion, \"version\", false, \"\")\n\tfs.Usage = func() { printUsage(os.Stdout) }\n\tif err := fs.Parse(preprocessArgs(os.Args[1:])); err != nil {\n\t\tif err == flag.ErrHelp {\n\t\t\tos.Exit(0)\n\t\t}\n\t\tos.Exit(1)\n\t}","originalFile":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements cmd/uniq — report or filter adjacent duplicate lines.\n// Implements prd028-uniq R1-R4.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\t\"unicode\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst version = \"uniq (go-unix-utils) 0.1\"\n\ntype config struct {\n\tcount       bool\n\trepeated    bool\n\tallRepeated string\n\tunique      bool\n\tignoreCase  bool\n\tskipFields  int\n\tskipChars   int\n\tcheckChars  int\n\tzeroTerm    bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tvar cfg config\n\tvar showVersion bool\n\tfs := flag.NewFlagSet(\"uniq\", flag.ContinueOnError)\n\tfs.SetOutput(os.Stderr)\n\tfs.BoolVar(&cfg.count, \"c\", false, \"prefix lines by the number of occurrences\")\n\tfs.BoolVar(&cfg.repeated, \"d\", false, \"only print duplicate lines\")\n\tfs.Func(\"D\", \"print all duplicate lines\", func(s string) error {\n\t\tif s == \"\" {\n\t\t\tcfg.allRepeated = \"none\"\n\t\t} else {\n\t\t\tcfg.allRepeated = s\n\t\t}\n\t\treturn nil\n\t})\n\tfs.BoolVar(&cfg.unique, \"u\", false, \"only print unique lines\")\n\tfs.BoolVar(&cfg.ignoreCase, \"i\", false, \"ignore case\")\n\tfs.IntVar(&cfg.skipFields, \"f\", 0, \"skip fields\")\n\tfs.IntVar(&cfg.skipChars, \"s\", 0, \"skip chars\")\n\tfs.IntVar(&cfg.checkChars, \"w\", 0, \"check chars\")\n\tfs.BoolVar(&cfg.zeroTerm, \"z\", false, \"zero-terminated\")\n\tfs.BoolVar(&showVersion, \"version\", false, \"\")\n\tfs.Usage = func() { printUsage(os.Stdout) }\n\tif err := fs.Parse(os.Args[1:]); err != nil {\n\t\tif err == flag.ErrHelp {\n\t\t\tos.Exit(0)\n\t\t}\n\t\tos.Exit(1)\n\t}\n\tif showVersion {\n\t\tfmt.Println(version)\n\t\tos.Exit(0)\n\t}\n\t// R3: -c with -D is an error.\n\tif cfg.count && cfg.allRepeated != \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"uniq: printing all duplicated lines and repeat counts is meaningless\\nTry 'uniq --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tvar input io.Reader = os.Stdin\n\tvar output io.Writer = os.Stdout\n\targs := fs.Args()\n\tif len(args) > 0 && args[0] != \"-\" {\n\t\tf, err := os.Open(args[0])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"uniq: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tdefer f.Close()\n\t\tinput = f\n\t}\n\tif len(args) > 1 {\n\t\tf, err := os.Create(args[1])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"uniq: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tdefer f.Close()\n\t\toutput = f\n\t}\n\tif err := run(cfg, input, output); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"uniq: write error: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\n// compareKey extracts the comparison portion after field skip, char skip, and width limit.\nfunc compareKey(line string, cfg config) string {\n\ts := line\n\tfor n := 0; n < cfg.skipFields && len(s) > 0; n++ {\n\t\tfor len(s) > 0 && (s[0] == ' ' || s[0] == '\\t') {\n\t\t\ts = s[1:]\n\t\t}\n\t\tfor len(s) > 0 && s[0] != ' ' && s[0] != '\\t' {\n\t\t\ts = s[1:]\n\t\t}\n\t}\n\tif cfg.skipChars > 0 && cfg.skipChars < len(s) {\n\t\ts = s[cfg.skipChars:]\n\t} else if cfg.skipChars >= len(s) {\n\t\ts = \"\"\n\t}\n\tif cfg.checkChars > 0 && cfg.checkChars < len(s) {\n\t\ts = s[:cfg.checkChars]\n\t}\n\tif cfg.ignoreCase {\n\t\ts = strings.Map(unicode.ToLower, s)\n\t}\n\treturn s\n}\n\nfunc run(cfg config, input io.Reader, output io.Writer) error {\n\tdelim := byte('\\n')\n\tif cfg.zeroTerm {\n\t\tdelim = 0\n\t}\n\tw := bufio.NewWriter(output)\n\tdefer w.Flush()\n\treader := bufio.NewReader(input)\n\n\tvar prevLine, prevKey string\n\tcount := 0\n\tfirstGroup := true\n\tvar groupLines []string\n\n\tflush := func() error {\n\t\tif count == 0 {\n\t\t\treturn nil\n\t\t}\n\t\tif cfg.allRepeated != \"\" {\n\t\t\tif count >= 2 {\n\t\t\t\tif cfg.allRepeated == \"prepend\" || (cfg.allRepeated == \"separate\" && !firstGroup) {\n\t\t\t\t\tif err := w.WriteByte(delim); err != nil {\n\t\t\t\t\t\treturn err\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tfirstGroup = false\n\t\t\t\tfor _, l := range groupLines {\n\t\t\t\t\tif _, err := fmt.Fprintf(w, \"%s%c\", l, delim); err != nil {\n\t\t\t\t\t\treturn err\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tgroupLines = groupLines[:0]\n\t\t\treturn nil\n\t\t}\n\t\tshow := true\n\t\tif cfg.repeated && cfg.unique {\n\t\t\tshow = false\n\t\t} else if cfg.repeated && count < 2 {\n\t\t\tshow = false\n\t\t} else if cfg.unique && count != 1 {\n\t\t\tshow = false\n\t\t}\n\t\tif !show {\n\t\t\treturn nil\n\t\t}\n\t\tif cfg.count {\n\t\t\t_, err := fmt.Fprintf(w, \"%7d %s%c\", count, prevLine, delim)\n\t\t\treturn err\n\t\t}\n\t\t_, err := fmt.Fprintf(w, \"%s%c\", prevLine, delim)\n\t\treturn err\n\t}\n\n\tfor {\n\t\tline, err := readLine(reader, delim)\n\t\tif err == io.EOF {\n\t\t\tbreak\n\t\t}\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tkey := compareKey(line, cfg)\n\t\tif count == 0 {\n\t\t\tprevLine, prevKey, count = line, key, 1\n\t\t\tif cfg.allRepeated != \"\" {\n\t\t\t\tgroupLines = append(groupLines, line)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif key == prevKey {\n\t\t\tcount++\n\t\t\tif cfg.allRepeated != \"\" {\n\t\t\t\tgroupLines = append(groupLines, line)\n\t\t\t}\n\t\t} else {\n\t\t\tif err := flush(); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tprevLine, prevKey, count = line, key, 1\n\t\t\tif cfg.allRepeated != \"\" {\n\t\t\t\tgroupLines = append(groupLines, line)\n\t\t\t}\n\t\t}\n\t}\n\treturn flush()\n}\n\nfunc readLine(r *bufio.Reader, delim byte) (string, error) {\n\tvar buf []byte\n\tfor {\n\t\tchunk, err := r.ReadBytes(delim)\n\t\tif len(chunk) > 0 {\n\t\t\tif chunk[len(chunk)-1] == delim {\n\t\t\t\tbuf = append(buf, chunk[:len(chunk)-1]...)\n\t\t\t\treturn string(buf), nil\n\t\t\t}\n\t\t\tbuf = append(buf, chunk...)\n\t\t}\n\t\tif err != nil {\n\t\t\tif len(buf) > 0 {\n\t\t\t\treturn string(buf), nil\n\t\t\t}\n\t\t\treturn \"\", err\n\t\t}\n\t}\n}\n\nfunc printUsage(w io.Writer) {\n\tfmt.Fprintf(w, \"Usage: uniq [OPTION]... [INPUT [OUTPUT]]\\n\"+\n\t\t\"Filter adjacent matching lines from INPUT (or standard input),\\n\"+\n\t\t\"writing to OUTPUT (or standard output).\\n\\n\"+\n\t\t\"  -c             prefix lines by the number of occurrences\\n\"+\n\t\t\"  -d             only print duplicate lines, one for each group\\n\"+\n\t\t\"  -D[METHOD]     print all duplicate lines (none, prepend, separate)\\n\"+\n\t\t\"  -f N           avoid comparing the first N fields\\n\"+\n\t\t\"  -i             ignore differences in case when comparing\\n\"+\n\t\t\"  -s N           avoid comparing the first N characters\\n\"+\n\t\t\"  -u             only print unique lines\\n\"+\n\t\t\"  -w N           compare no more than N characters in lines\\n\"+\n\t\t\"  -z             line delimiter is NUL, not newline\\n\"+\n\t\t\"      --help     display this help and exit\\n\"+\n\t\t\"      --version  output version information and exit\\n\")\n}\n","structuredPatch":[{"oldStart":31,"oldLines":6,"newStart":31,"newLines":30,"lines":["   zeroTerm    bool"," }"," ","+// preprocessArgs normalizes -D (optional value) so flag.Parse can handle it.","+func preprocessArgs(args []string) []string {","+  out := make([]string, 0, len(args))","+  for i := 0; i < len(args); i++ {","+    a := args[i]","+    if a == \"-D\" || a == \"--all-repeated\" {","+      // Check if next arg looks like a method value (not another flag).","+      if i+1 < len(args) && (args[i+1] == \"none\" || args[i+1] == \"prepend\" || args[i+1] == \"separate\") {","+        out = append(out, \"-D=\"+args[i+1])","+        i++","+      } else {","+        out = append(out, \"-D=none\")","+      }","+    } else if strings.HasPrefix(a, \"--all-repeated=\") {","+      out = append(out, \"-D=\"+a[len(\"--all-repeated=\"):])","+    } else if strings.HasPrefix(a, \"--all-repeated\") {","+      out = append(out, \"-D=none\")","+    } else {","+      out = append(out, a)","+    }","+  }","+  return out","+}","+"," func main() {","   sys.InstallSIGPIPEHandler()"," "]},{"oldStart":38,"oldLines":25,"newStart":62,"newLines":18,"lines":["   var showVersion bool","   fs := flag.NewFlagSet(\"uniq\", flag.ContinueOnError)","   fs.SetOutput(os.Stderr)","-  fs.BoolVar(&cfg.count, \"c\", false, \"prefix lines by the number of occurrences\")","-  fs.BoolVar(&cfg.repeated, \"d\", false, \"only print duplicate lines\")","-  fs.Func(\"D\", \"print all duplicate lines\", func(s string) error {","-    if s == \"\" {","-      cfg.allRepeated = \"none\"","-    } else {","-      cfg.allRepeated = s","-    }","-    return nil","-  })",