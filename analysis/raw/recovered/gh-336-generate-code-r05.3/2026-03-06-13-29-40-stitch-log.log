Var(&cfg.zeroTerm, \"z\", false, \"zero-terminated\")\n    57→\tfs.BoolVar(&showVersion, \"version\", false, \"\")\n    58→\tfs.Usage = func() { printUsage(os.Stdout) }\n    59→\tif err := fs.Parse(os.Args[1:]); err != nil {\n    60→\t\tif err == flag.ErrHelp {\n    61→\t\t\tos.Exit(0)\n    62→\t\t}\n    63→\t\tos.Exit(1)\n    64→\t}\n    65→\tif showVersion {\n    66→\t\tfmt.Println(version)\n    67→\t\tos.Exit(0)\n    68→\t}\n    69→\t// R3: -c with -D is an error.\n    70→\tif cfg.count && cfg.allRepeated != \"\" {\n    71→\t\tfmt.Fprintf(os.Stderr, \"uniq: printing all duplicated lines and repeat counts is meaningless\\nTry 'uniq --help' for more information.\\n\")\n    72→\t\tos.Exit(1)\n    73→\t}\n    74→\n    75→\tvar input io.Reader = os.Stdin\n    76→\tvar output io.Writer = os.Stdout\n    77→\targs := fs.Args()\n    78→\tif len(args) > 0 && args[0] != \"-\" {\n    79→\t\tf, err := os.Open(args[0])\n    80→\t\tif err != nil {\n    81→\t\t\tfmt.Fprintf(os.Stderr, \"uniq: %v\\n\", err)\n    82→\t\t\tos.Exit(1)\n    83→\t\t}\n    84→\t\tdefer f.Close()\n    85→\t\tinput = f\n    86→\t}\n    87→\tif len(args) > 1 {\n    88→\t\tf, err := os.Create(args[1])\n    89→\t\tif err != nil {\n    90→\t\t\tfmt.Fprintf(os.Stderr, \"uniq: %v\\n\", err)\n    91→\t\t\tos.Exit(1)\n    92→\t\t}\n    93→\t\tdefer f.Close()\n    94→\t\toutput = f\n    95→\t}\n    96→\tif err := run(cfg, input, output); err != nil {\n    97→\t\tfmt.Fprintf(os.Stderr, \"uniq: write error: %v\\n\", err)\n    98→\t\tos.Exit(1)\n    99→\t}\n   100→}\n   101→\n   102→// compareKey extracts the comparison portion after field skip, char skip, and width limit.\n   103→func compareKey(line string, cfg config) string {\n   104→\ts := line\n   105→\tfor n := 0; n < cfg.skipFields && len(s) > 0; n++ {\n   106→\t\tfor len(s) > 0 && (s[0] == ' ' || s[0] == '\\t') {\n   107→\t\t\ts = s[1:]\n   108→\t\t}\n   109→\t\tfor len(s) > 0 && s[0] != ' ' && s[0] != '\\t' {\n   110→\t\t\ts = s[1:]\n   111→\t\t}\n   112→\t}\n   113→\tif cfg.skipChars > 0 && cfg.skipChars < len(s) {\n   114→\t\ts = s[cfg.skipChars:]\n   115→\t} else if cfg.skipChars >= len(s) {\n   116→\t\ts = \"\"\n   117→\t}\n   118→\tif cfg.checkChars > 0 && cfg.checkChars < len(s) {\n   119→\t\ts = s[:cfg.checkChars]\n   120→\t}\n   121→\tif cfg.ignoreCase {\n   122→\t\ts = strings.Map(unicode.ToLower, s)\n   123→\t}\n   124→\treturn s\n   125→}\n   126→\n   127→func run(cfg config, input io.Reader, output io.Writer) error {\n   128→\tdelim := byte('\\n')\n   129→\tif cfg.zeroTerm {\n   130→\t\tdelim = 0\n   131→\t}\n   132→\tw := bufio.NewWriter(output)\n   133→\tdefer w.Flush()\n   134→\treader := bufio.NewReader(input)\n   135→\n   136→\tvar prevLine, prevKey string\n   137→\tcount := 0\n   138→\tfirstGroup := true\n   139→\tvar groupLines []string\n   140→\n   141→\tflush := func() error {\n   142→\t\tif count == 0 {\n   143→\t\t\treturn nil\n   144→\t\t}\n   145→\t\tif cfg.allRepeated != \"\" {\n   146→\t\t\tif count >= 2 {\n   147→\t\t\t\tif cfg.allRepeated == \"prepend\" || (cfg.allRepeated == \"separate\" && !firstGroup) {\n   148→\t\t\t\t\tif err := w.WriteByte(delim); err != nil {\n   149→\t\t\t\t\t\treturn err\n   150→\t\t\t\t\t}\n   151→\t\t\t\t}\n   152→\t\t\t\tfirstGroup = false\n   153→\t\t\t\tfor _, l := range groupLines {\n   154→\t\t\t\t\tif _, err := fmt.Fprintf(w, \"%s%c\", l, delim); err != nil {\n   155→\t\t\t\t\t\treturn err\n   156→\t\t\t\t\t}\n   157→\t\t\t\t}\n   158→\t\t\t}\n   159→\t\t\tgroupLines = groupLines[:0]\n   160→\t\t\treturn nil\n   161→\t\t}\n   162→\t\tshow := true\n   163→\t\tif cfg.repeated && cfg.unique {\n   164→\t\t\tshow = false\n   165→\t\t} else if cfg.repeated && count < 2 {\n   166→\t\t\tshow = false\n   167→\t\t} else if cfg.unique && count != 1 {\n   168→\t\t\tshow = false\n   169→\t\t}\n   170→\t\tif !show {\n   171→\t\t\treturn nil\n   172→\t\t}\n   173→\t\tif cfg.count {\n   174→\t\t\t_, err := fmt.Fprintf(w, \"%7d %s%c\", count, prevLine, delim)\n   175→\t\t