         }","-          cfg.skipChars = n","-          j = len(arg)","-          continue","-        case 'w':","-          val := arg[j+1:]","-          if val == \"\" {","-            i++","-            if i >= len(args) {","-              return cfg, nil, fmt.Errorf(\"option requires an argument -- 'w'\")","-            }","-            val = args[i]","-          }","-          n, err := strconv.Atoi(val)","-          if err != nil {","-            return cfg, nil, fmt.Errorf(\"invalid number of bytes to compare: '%s'\", val)","-          }","-          cfg.checkChars = n","-          j = len(arg)","-          continue","-        default:","-          return cfg, nil, fmt.Errorf(\"invalid option -- '%c'\", ch)","-        }","-        j++","-      }","-      continue","-    }","-    positional = append(positional, arg)","-  }","-  return cfg, positional, nil","-}","-","-// compareKey extracts the portion of a line used for comparison after","-// applying field skip (-f), char skip (-s), and width limit (-w).","+// compareKey extracts the comparison portion after field skip, char skip, and width limit."," func compareKey(line string, cfg config) string {","   s := line","-  // R3.2: Skip fields.","   for n := 0; n < cfg.skipFields && len(s) > 0; n++ {","-    // Skip leading blanks before the field.","     for len(s) > 0 && (s[0] == ' ' || s[0] == '\\t') {","       s = s[1:]","     }","-    // Skip non-blank characters (the field itself).","     for len(s) > 0 && s[0] != ' ' && s[0] != '\\t' {","       s = s[1:]","     }","   }","-  // R3.3: Skip characters.","-  if cfg.skipChars > 0 {","-    if cfg.skipChars >= len(s) {","-      s = \"\"","-    } else {","-      s = s[cfg.skipChars:]","-    }","+  if cfg.skipChars > 0 && cfg.skipChars < len(s) {","+    s = s[cfg.skipChars:]","+  } else if cfg.skipChars >= len(s) {","+    s = \"\"","   }","-  // R3.4: Limit comparison width.","   if cfg.checkChars > 0 && cfg.checkChars < len(s) {","     s = s[:cfg.checkChars]","   }","-  // R3.1: Case folding.","   if cfg.ignoreCase {","     s = strings.Map(unicode.ToLower, s)","   }"]},{"oldStart":294,"oldLines":39,"newStart":129,"newLines":23,"lines":["   if cfg.zeroTerm {","     delim = 0","   }","-","   w := bufio.NewWriter(output)","   defer w.Flush()","-","   reader := bufio.NewReader(input)","-  var prevLine string","-  var prevKey string","+","+  var prevLine, prevKey string","   count := 0","   firstGroup := true","-  // For -D separate/prepend, track lines in current group.","   var groupLines []string"," ","   flush := func() error {","     if count == 0 {","       return nil","     }","-    shouldPrint := true","-    if cfg.repeated && !cfg.unique && count < 2 {","-      shouldPrint = false","-    }","-    if cfg.unique && !cfg.repeated && count != 1 {","-      shouldPrint = false","-    }","-    if cfg.repeated && cfg.unique {","-      // -d and -u together: no output (GNU behavior).","-      shouldPrint = false","-    }","-","     if cfg.allRepeated != \"\" {","-      // -D mode: handled separately via groupLines.","       if count >= 2 {","         if cfg.allRepeated == \"prepend\" || (cfg.allRepeated == \"separate\" && !firstGroup) {","-          if _, err := fmt.Fprintf(w, \"%c\", delim); err != nil {","+          if err := w.WriteByte(delim); err != nil {","             return err","           }","         }"]},{"oldStart":340,"oldLines":20,"newStart":159,"newLines":23,"lines":["       groupLines = groupLines[:0]","       return nil","     }","-","-    if !shouldPrint {","+    show := true","+    if cfg.repeated && cfg.unique {","+      show = false","+    } else if cfg.repeated && count < 2 {","+      show = false","+    } else if cfg.unique && count != 1 {","+      show = false","+    }","+    if !show {","       return nil","     }","     if cfg.count {","-      if _, err := fmt.Fprintf(w, \"%7d %s%c\", count, prevLine, delim); err != nil {","-        return err","-      }","-    } else {","-      if _, err := fmt.Fprintf(