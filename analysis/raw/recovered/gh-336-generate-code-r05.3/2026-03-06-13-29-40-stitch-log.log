ly print duplicate lines, one for each group","-  -D, --all-repeated[=METHOD]  print all duplicate lines;","-                          groups can be delimited with an empty line;","-                          METHOD={none(default),prepend,separate}","-  -f, --skip-fields=N   avoid comparing the first N fields","-  -i, --ignore-case     ignore differences in case when comparing","-  -s, --skip-chars=N    avoid comparing the first N characters","-  -u, --unique          only print unique lines","-  -w, --check-chars=N   compare no more than N characters in lines","-  -z, --zero-terminated  line delimiter is NUL, not newline","-      --help            display this help and exit","-      --version         output version information and exit","+  -c             prefix lines by the number of occurrences","+  -d             only print duplicate lines, one for each group","+  -D[METHOD]     print all duplicate lines (none, prepend, separate)","+  -f N           avoid comparing the first N fields","+  -i             ignore differences in case when comparing","+  -s N           avoid comparing the first N characters","+  -u             only print unique lines","+  -w N           compare no more than N characters in lines","+  -z             line delimiter is NUL, not newline","+      --help     display this help and exit","+      --version  output version information and exit"," `)"," }"]}],"originalFile":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements cmd/uniq — report or filter adjacent duplicate lines.\n// Implements prd028-uniq R1-R4.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"unicode\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst version = \"uniq (go-unix-utils) 0.1\"\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tcfg, args, err := parseFlags(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"uniq: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\tif cfg.showVersion {\n\t\tfmt.Println(version)\n\t\tos.Exit(0)\n\t}\n\tif cfg.showHelp {\n\t\tprintUsage(os.Stdout)\n\t\tos.Exit(0)\n\t}\n\n\t// R3: -c with -D is an error (GNU behavior).\n\tif cfg.count && cfg.allRepeated != \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"uniq: printing all duplicated lines and repeat counts is meaningless\\n\")\n\t\tfmt.Fprintf(os.Stderr, \"Try 'uniq --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tvar input io.Reader = os.Stdin\n\tvar output io.Writer = os.Stdout\n\n\t// R1.3: Optional input file (first positional arg) and output file (second).\n\tif len(args) > 0 && args[0] != \"-\" {\n\t\tf, err := os.Open(args[0])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"uniq: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tdefer f.Close()\n\t\tinput = f\n\t}\n\tif len(args) > 1 {\n\t\tf, err := os.Create(args[1])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"uniq: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tdefer f.Close()\n\t\toutput = f\n\t}\n\n\tif err := run(cfg, input, output); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"uniq: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\ntype config struct {\n\tcount       bool   // -c\n\trepeated    bool   // -d\n\tallRepeated string // -D [none|prepend|separate]\n\tunique      bool   // -u\n\tignoreCase  bool   // -i\n\tskipFields  int    // -f N\n\tskipChars   int    // -s N\n\tcheckChars  int    // -w N (0 = unlimited)\n\tzeroTerm    bool   // -z\n\tshowVersion bool\n\tshowHelp    bool\n}\n\nfunc parseFlags(args []string) (config, []string, error) {\n\tvar cfg config\n\tvar positional []string\n\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tpositional = append(positional, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif arg == \"-\" {\n\t\t\tpositional = append(positional, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tkey := arg[2:]\n\t\t\tswitch {\n\t\t\tcase key == \"count\":\n\t\t\t\tcfg.count = true\n\t\t\tcase key == \"repeated\":\n\t\t\t\tcfg.repeated = true\n\t\t\tcase key == \"all-repeated\":\n\t\t\t\tcfg.allRepeated = \"none\"\n\t\t\tcase strings.HasPrefix(key, \"all-repeated=\"):\n\t\t\t\tcfg.allRepeated = key[len(\"all-repeated=\"):]\n\t\t\t\tif cfg.allRepeated != \"none\" && cfg.allRepeated != \"prepend\" && cfg.allRepeated != \"separate\" {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid argument '%s' for '--all-repeated'\", cfg.allRepeated)\n\t\t\t\t}\n\t\t\tcase key == \"unique\":\n\t\t\t\tcfg.unique = true\n\t\t\tcase key == \"ignore-case\":\n\t\t\t\tcfg.ignoreCase = true\n\t\t\tcase key == \"zero-terminated\":\n\t\t\t\tcfg.zeroTerm = true\n\t\t\tcase key == \"version\":\n\t\t\t\tcfg.showVersion = true\n\t\t\tcase key == \"help\":\n\t\t\t\tcfg.showHelp = true\n\t\t\tcase strings.HasPrefix(key, \"skip-fields=\"):\n\t\t\t\tn, err := strconv.Atoi(key[len(\"skip-fields=\"):])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid number of fields to skip: '%s'\", key[len(\"skip-fields=\"):])\n\t\t\t\t}\n\t\t\t\tcfg.skipFields = n\n\t\t\tcase key == \"skip-fields\":\n\t\t\t\ti++\n\t\t\t\tif i >= len(args) {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"option '--skip-fields' requires an argument\")\n\t\t\t\t}\n\t\t\t\tn, err := strconv.Atoi(args[i])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid number of fields to skip: '%s'\", args[i])\n\t\t\t\t}\n\t\t\t\tcfg.skipFields = n\n\t\t\tcase strings.HasPrefix(key, \"skip-chars=\"):\n\t\t\t\tn, err := strconv.Atoi(key[len(\"skip-chars=\"):])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid number of bytes to skip: '%s'\", key[len(\"skip-chars=\"):])\n\t\t\t\t}\n\t\t\t\tcfg.skipChars = n\n\t\t\tcase key == \"skip-chars\":\n\t\t\t\ti++\n\t\t\t\tif i >= len(args) {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"option '--skip-chars' requires an argument\")\n\t\t\t\t}\n\t\t\t\tn, err := strconv.Atoi(args[i])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid number of bytes to skip: '%s'\", args[i])\n\t\t\t\t}\n\t\t\t\tcfg.skipChars = n\n\t\t\tcase strings.HasPrefix(key, \"check-chars=\"):\n\t\t\t\tn, err := strconv.Atoi(key[len(\"check-chars=\"):])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid number of bytes to compare: '%s'\", key[len(\"check-chars=\"):])\n\t\t\t\t}\n\t\t\t\tcfg.checkChars = n\n\t\t\tcase key == \"check-chars\":\n\t\t\t\ti++\n\t\t\t\tif i >= len(args) {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"option '--check-chars' requires an argument\")\n\t\t\t\t}\n\t\t\t\tn, err := strconv.Atoi(args[i])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid number of bytes to compare: '%s'\", args[i])\n\t\t\t\t}\n\t\t\t\tcfg.checkChars = n\n\t\t\tdefault:\n\t\t\t\treturn cfg, nil, fmt.Errorf(\"unrecognized option '--%s'\", key)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"-\") && len(arg) > 1 {\n\t\t\t// Short flags — may be combined (e.g., -ci).\n\t\t\tj := 1\n\t\t\tfor j < len(arg) {\n\t\t\t\tch := arg[j]\n\t\t\t\tswitch ch {\n\t\t\t\tcase 'c':\n\t\t\t\t\tcfg.count = true\n\t\t\t\tcase 'd':\n\t\t\t\t\tcfg.repeated = true\n\t\t\t\tcase 'D':\n\t\t\t\t\tcfg.allRepeated = \"none\"\n\t\t\t\tcase 'u':\n\t\t\t\t\tcfg.unique = true\n\t\t\t\tcase 'i':\n\t\t\t\t\tcfg.ignoreCase = true\n\t\t\t\tcase 'z':\n\t\t\t\t\tcfg.zeroTerm = true\n\t\t\t\tcase 'f':\n\t\t\t\t\tval := arg[j+1:]\n\t\t\t\t\tif val == \"\" {\n\t\t\t\t\t\ti++\n\t\t\t\t\t\tif i >= len(args) {\n\t\t\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"option requires an argument -- 'f'\")\n\t\t\t\t\t\t}\n\t\t\t\t\t\tval = args[i]\n\t\t\t\t\t}\n\t\t\t\t\tn, err := strconv.Atoi(val)\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\treturn cfg, nil, fmt.Errorf(\"invalid number of fields to skip: '%s'\", val)\n\t\t\t\t\t}\n\t\t\t\t\tcfg.skipFields = n\n\t\t\t\t\tj = len(arg) // consumed rest\n\t\t\t\t\tcontinue\n\t\t\t\tcase 's':\n\t\t\t\t\tval := arg[j+1:]\n\t\t\t\t\tif val =