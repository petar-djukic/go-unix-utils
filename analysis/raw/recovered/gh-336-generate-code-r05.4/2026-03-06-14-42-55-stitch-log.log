code: 0\n   220→      stdout: \"e7c22b994c59d9cf2b48e549b1e24666636045930d3da7c1acb299d1c3b7f931f94aae41edda2c2b207a36e10f8bcb8d45223e54878f5b316e7ce3b6bc019629  -\\n\"\n   221→      stderr: \"\"\n   222→    traces:\n   223→      - prd033-sha512sum R1.1\n   224→      - prd033-sha512sum R1.2\n   225→\n   226→  - name: sha512sum_check_valid\n   227→    description: \"--check on a valid SHA-512 checksum file exits 0.\"\n   228→    inputs:\n   229→      args: [\"--check\", \"checksums.sha512\"]\n   230→      stdin: null\n   231→      env: [\"LC_ALL=C\"]\n   232→    normalization: none\n   233→    expected:\n   234→      exit_code: 0\n   235→      stdout: \"hello.txt: OK\\n\"\n   236→      stderr: \"\"\n   237→    traces:\n   238→      - prd033-sha512sum R2.1\n   239→      - prd033-sha512sum R2.2\n   240→\n   241→  - name: sha512sum_tag_format\n   242→    description: \"--tag uses BSD format: 'SHA512 (FILENAME) = HASH'.\"\n   243→    inputs:\n   244→      args: [\"--tag\", \"hello.txt\"]\n   245→      stdin: null\n   246→      env: [\"LC_ALL=C\"]\n   247→    normalization: none\n   248→    expected:\n   249→      exit_code: 0\n   250→      stdout: \"SHA512 (hello.txt) = e7c22b994c59d9cf2b48e549b1e24666636045930d3da7c1acb299d1c3b7f931f94aae41edda2c2b207a36e10f8bcb8d45223e54878f5b316e7ce3b6bc019629\\n\"\n   251→      stderr: \"\"\n   252→    traces:\n   253→      - prd033-sha512sum R1.3\n   254→"}]},"parent_tool_use_id":null,"session_id":"4c927fb3-444c-4f7d-863b-08a94c529f16","uuid":"473ad949-1a4e-4a18-bf70-ed0e5d4adaf0","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/372/docs/specs/test-suites/test-rel05.4.yaml","content":"id: test-rel05.4\ntitle: \"Test Suite: rel05.4 — md5sum, sha1sum, sha256sum, sha512sum\"\nrelease: rel05.4\n\ntraces:\n  - rel05.4-uc001-md5sum\n  - rel05.4-uc002-sha1sum\n  - rel05.4-uc003-sha256sum\n  - rel05.4-uc004-sha512sum\n  - prd030-md5sum R1\n  - prd030-md5sum R2\n  - prd031-sha1sum R1\n  - prd031-sha1sum R2\n  - prd032-sha256sum R1\n  - prd032-sha256sum R2\n  - prd033-sha512sum R1\n  - prd033-sha512sum R2\n\npreconditions:\n  - ./bin/md5sum, ./bin/sha1sum, ./bin/sha256sum, and ./bin/sha512sum exist (built via mage build).\n  - Reference binaries gmd5sum, gsha1sum, gsha256sum, and gsha512sum are installed via Homebrew (coreutils) and on PATH.\n  - Tests are run via go test ./cmd/md5sum/... ./cmd/sha1sum/... ./cmd/sha256sum/... ./cmd/sha512sum/... which invoke RunDiffTests from pkg/testutils.\n  - All tests use LC_ALL=C to eliminate locale-dependent divergence.\n  - No normalization is applied; all outputs are compared byte-for-byte.\n  - Test setup creates a known file (e.g. containing \"hello\\n\") and a pre-computed checksum file for check-mode tests.\n\ntest_cases:\n\n  # ---- md5sum ----\n\n  - name: md5sum_compute_stdin\n    description: Compute MD5 of stdin; output is \"HASH  -\" in GNU text format.\n    inputs:\n      args: []\n      stdin: \"hello\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"b1946ac92492d2347c6235b4d2611184  -\\n\"\n      stderr: \"\"\n    traces:\n      - prd030-md5sum R1.1\n      - prd030-md5sum R1.2\n\n  - name: md5sum_compute_file\n    description: \"Compute MD5 of a named file. Setup: hello.txt contains 'hello\\\\n'.\"\n    inputs:\n      args: [\"hello.txt\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"b1946ac92492d2347c6235b4d2611184  hello.txt\\n\"\n      stderr: \"\"\n    traces:\n      - prd030-md5sum R1.1\n\n  - name: md5sum_binary_mode\n    description: \"-b uses asterisk format: 'HASH *FILENAME'.\"\n    inputs:\n      args: [\"-b\", \"hello.txt\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"b1946ac92492d2347c6235b4d2611184 *hello.txt\\n\"\n      stderr: \"\"\n    traces:\n      - prd030-md5sum R3.1\n\n  - name: md5sum_tag_format\n    description: \"--tag uses BSD format: 'MD5 (FILENAME) = HASH'.\"\n    inputs:\n      args: [\"--tag\", \"hello.txt\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"MD5 (hello.txt) = b1946ac92492d2347c6235b4d2611184\\n\"\n      stderr: \"\"\n    traces:\n      - prd030-md5sum R1.3\n\n  - name: md5sum_check_valid\n    description: \"--check on a valid checksum file exits 0 and prints OK. Setup: checksums.md5 contains the correct hash for hello.txt.\"\n    inputs:\n      args: [\"--check\", \"checksums.md5\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello.txt: OK\\n\"\n      stderr: \"\"\n    traces:\n      - prd030-md5sum R2.1\n      - prd030-md5sum R2.2\n\n  - name: md5sum_check_failure\n    description: \"--check on a file with wrong hash exits 1 and prints FAILED. Setup: bad.md5 contains an incorrect hash for hello.txt.\"\n    inputs:\n      args: [\"--check\", \"bad.md5\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 1\n      stdout: \"hello.txt: FAILED\\n\"\n      stderr_contains: \"WARNING\"\n    traces:\n      - prd030-md5sum R2.2\n\n  # ---- sha1sum ----\n\n  - name: sha1sum_compute_stdin\n    description: Compute SHA-1 of stdin.\n    inputs:\n      args: []\n      stdin: \"hello\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"f572d396fae9206628714fb2ce00f72e94f2258f  -\\n\"\n      stderr: \"\"\n    traces:\n      - prd031-sha1sum R1.1\n      - prd031-sha1sum R1.2\n\n  - name: sha1sum_check_valid\n    description: \"--check on a valid SHA-1 checksum file exits 0.\"\n    inputs:\n      args: [\"--check\", \"checksums.sha1\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello.txt: OK\\n\"\n      stderr: \"\"\n    traces:\n      - prd031-sha1sum R2.1\n      - prd031-sha1sum R2.2\n\n  - name: sha1sum_tag_format\n    description: \"--tag uses BSD format: 'SHA1 (FILENAME) = HASH'.\"\n    inputs:\n      args: [\"--tag\", \"hello.txt\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"SHA1 (hello.txt) = f572d396fae9206628714fb2ce00f72e94f2258f\\n\"\n      stderr: \"\"\n    traces:\n      - prd031-sha1sum R1.3\n\n  # ---- sha256sum ----\n\n  - name: sha256sum_compute_stdin\n    description: Compute SHA-256 of stdin.\n    inputs:\n      args: []\n      stdin: \"hello\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03  -\\n\"\n      stderr: \"\"\n    traces:\n      - prd032-sha256sum R1.1\n      - prd032-sha256sum R1.2\n\n  - name: sha256sum_check_valid\n    description: \"--check on a valid SHA-256 checksum file exits 0.\"\n    inputs:\n      args: [\"--check\", \"checksums.sha256\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello.txt: OK\\n\"\n      stderr: \"\"\n    traces:\n      - prd032-sha256sum R2.1\n      - prd032-sha256sum R2.2\n\n  - name: sha256sum_tag_format\n    description: \"--tag uses BSD format: 'SHA256 (FILENAME) = HASH'.\"\n    inputs:\n      args: [\"--tag\", \"hello.txt\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"SHA256 (hello.txt) = 5891b5b522d5df086d0ff0b110fbd9d21bb4fc7163af34d08286a2e846f6be03\\n\"\n      stderr: \"\"\n    traces:\n      - prd032-sha256sum R1.3\n\n  # ---- sha512sum ----\n\n  - name: sha512sum_compute_stdin\n    description: Compute SHA-512 of stdin.\n    inputs:\n      args: []\n      stdin: \"hello\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"e7c22b994c59d9cf2b48e549b1e24666636045930d3da7c1acb299d1c3b7f931f94aae41edda2c2b207a36e10f8bcb8d45223e54878f5b316e7ce3b6bc019629  -\\n\"\n      stderr: \"\"\n    traces:\n      - prd033-sha512sum R1.1\n      - prd033-sha512sum R1.2\n\n  - name: sha512sum_check_valid\n    description: \"--check on a valid SHA-512 checksum file exits 0.\"\n    inputs:\n      args: [\"--check\", \"checksums.sha512\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello.txt: OK\\n\"\n      stderr: \"\"\n    traces:\n      - prd033-sha512sum R2.1\n      - prd033-sha512sum R2.2\n\n  - name: sha512sum_tag_format\n    description: \"--tag uses BSD format: 'SHA512 (FILENAME) = HASH'.\"\n    inputs:\n      args: [\"--tag\", \"hello.txt\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"SHA512 (hello.txt) = e7c22b994c59d9cf2b48e549b1e24666636045930d3da7c1acb299d1c3b7f931f94aae41edda2c2b207a36e10f8bcb8d45223e54878f5b316e7ce3b6bc019629\\n\"\n      stderr: \"\"\n    traces:\n      - prd033-sha512sum R1.3\n","numLines":254,"startLine":1,"totalLines":254}}}
