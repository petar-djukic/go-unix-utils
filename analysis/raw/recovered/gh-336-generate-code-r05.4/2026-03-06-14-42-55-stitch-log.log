{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RVZCExgENUgnZQFUGjbXeJ","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package testutils provides the differential testing harness (prd001-testutils).\n     5→package testutils\n     6→\n     7→import (\n     8→\t\"bytes\"\n     9→\t\"os\"\n    10→\t\"os/exec\"\n    11→\t\"path/filepath\"\n    12→\t\"testing\"\n    13→)\n    14→\n    15→// NormalizeFunc transforms output bytes before comparison.\n    16→type NormalizeFunc = func([]byte) []byte\n    17→\n    18→// DiffTest defines a single differential test case.\n    19→type DiffTest struct {\n    20→\tName          string\n    21→\tArgs          []string\n    22→\tStdin         []byte\n    23→\tEnv           []string\n    24→\tWorkDir       string\n    25→\tExitCode      int\n    26→\tNormalize     []NormalizeFunc\n    27→\tExpectedFiles map[string][]byte\n    28→}\n    29→\n    30→// BuildBinary compiles the Go package in dir and returns the path to the binary.\n    31→func BuildBinary(t *testing.T, dir string) string {\n    32→\tt.Helper()\n    33→\ttmp := t.TempDir()\n    34→\tbin := filepath.Join(tmp, \"testbin\")\n    35→\tcmd := exec.Command(\"go\", \"build\", \"-o\", bin, dir)\n    36→\tout, err := cmd.CombinedOutput()\n    37→\tif err != nil {\n    38→\t\tt.Fatalf(\"BuildBinary: go build %s: %v\\n%s\", dir, err, out)\n    39→\t}\n    40→\treturn bin\n    41→}\n    42→\n    43→// RunDiffTests runs each test case against both the Go binary and the reference\n    44→// binary, comparing stdout, stderr, and exit code byte-for-byte.\n    45→func RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n    46→\tt.Helper()\n    47→\tfor _, tc := range tests {\n    48→\t\tt.Run(tc.Name, func(t *testing.T) {\n    49→\t\t\tt.Parallel()\n    50→\t\t\tgoOut, goErr, goExit := runCmd(goBinary, tc)\n    51→\t\t\trefOut, refErr, refExit := runCmd(refBinary, tc)\n    52→\t\t\tfor _, n := range tc.Normalize {\n    53→\t\t\t\tgoOut = n(goOut)\n    54→\t\t\t\trefOut = n(refOut)\n    55→\t\t\t\tgoErr = n(goErr)\n    56→\t\t\t\trefErr = n(refErr)\n    57→\t\t\t}\n    58→\t\t\tif goExit != refExit {\n    59→\t\t\t\tt.Errorf(\"exit code: go=%d ref=%d\", goExit, refExit)\n    60→\t\t\t}\n    61→\t\t\tif !bytes.Equal(goOut, refOut) {\n    62→\t\t\t\tt.Errorf(\"stdout differs:\\n  go:  %q\\n  ref: %q\", goOut, refOut)\n    63→\t\t\t}\n    64→\t\t\tif !bytes.Equal(goErr, refErr) {\n    65→\t\t\t\tt.Errorf(\"stderr differs:\\n  go:  %q\\n  ref: %q\", goErr, refErr)\n    66→\t\t\t}\n    67→\t\t})\n    68→\t}\n    69→}\n    70→\n    71→func runCmd(binary string, tc DiffTest) (stdout, stderr []byte, exitCode int) {\n    72→\tcmd := exec.Command(binary, tc.Args...)\n    73→\tif tc.Stdin != nil {\n    74→\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n    75→\t}\n    76→\tcmd.Env = append(os.Environ(), tc.Env...)\n    77→\tif tc.WorkDir != \"\" {\n    78→\t\tcmd.Dir = tc.WorkDir\n    79→\t}\n    80→\tvar outBuf, errBuf bytes.Buffer\n    81→\tcmd.Stdout = &outBuf\n    82→\tcmd.Stderr = &errBuf\n    83→\terr := cmd.Run()\n    84→\tif err != nil {\n    85→\t\tif ee, ok := err.(*exec.ExitError); ok {\n    86→\t\t\texitCode = ee.ExitCode()\n    87→\t\t}\n    88→\t}\n    89→\treturn outBuf.Bytes(), errBuf.Bytes(), exitCode\n    90→}\n    91→"}]},"parent_tool_use_id":null,"session_id":"4c927fb3-444c-4f7d-863b-08a94c529f16","uuid":"87311d4d-f6be-4a33-a468-c7a702b63c9b","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/372/pkg/testutils/testutils.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides the differential testing harness (prd001-testutils).\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// NormalizeFunc transforms output bytes before comparison.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest defines a single differential test case.\ntype DiffTest struct {\n\tName          string\n\tArgs          []string\n\tStdin         []byte\n\tEnv           []string\n\tWorkDir       string\n\tExitCode      int\n\tNormalize     []NormalizeFunc\n\tExpectedFiles map[string][]byte\n}\n\n// BuildBinary compiles the Go package in dir and returns the path to the binary.\nfunc BuildBinary(t *testing.T, dir string) string {\n\tt.Helper()\n\ttmp := t.TempDir()\n\tbin := filepath.Join(tmp, \"testbin\")\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", bin, dir)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tt.Fatalf(\"BuildBinary: go build %s: %v\\n%s\", dir, err, out)\n\t}\n\treturn bin\n}\n\n// RunDiffTests runs each test case against both the Go binary and the reference\n// binary, comparing stdout, stderr, and exit code byte-for-byte.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tgoOut, goErr, goExit := runCmd(goBinary, tc)\n\t\t\trefOut, refErr, refExit := runCmd(refBinary, tc)\n\t\t\tfor _, n := range tc.Normalize {\n\t\t\t\tgoOut = n(goOut)\n\t\t\t\trefOut = n(refOut)\n\t\t\t\tgoErr = n(goErr)\n\t\t\t\trefErr = n(refErr)\n\t\t\t}\n\t\t\tif goExit != refExit {\n\t\t\t\tt.Errorf(\"exit code: go=%d ref=%d\", goExit, refExit)\n\t\t\t}\n\t\t\tif !bytes.Equal(goOut, refOut) {\n\t\t\t\tt.Errorf(\"stdout differs:\\n  go:  %q\\n  ref: %q\", goOut, refOut)\n\t\t\t}\n\t\t\tif !bytes.Equal(goErr, refErr) {\n\t\t\t\tt.Errorf(\"stderr differs:\\n  go:  %q\\n  ref: %q\", goErr, refErr)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc runCmd(binary string, tc DiffTest) (stdout, stderr []byte, exitCode int) {\n\tcmd := exec.Command(binary, tc.Args...)\n\tif tc.Stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n\t}\n\tcmd.Env = append(os.Environ(), tc.Env...)\n\tif tc.WorkDir != \"\" {\n\t\tcmd.Dir = tc.WorkDir\n\t}\n\tvar outBuf, errBuf bytes.Buffer\n\tcmd.Stdout = &outBuf\n\tcmd.Stderr = &errBuf\n\terr := cmd.Run()\n\tif err != nil {\n\t\tif ee, ok := err.(*exec.ExitError); ok {\n\t\t\texitCode = ee.ExitCode()\n\t\t}\n\t}\n\treturn outBuf.Bytes(), errBuf.Bytes(), exitCode\n}\n","numLines":91,"startLine":1,"totalLines":91}}}
