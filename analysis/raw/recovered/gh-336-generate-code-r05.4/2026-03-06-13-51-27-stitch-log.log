 (string, error) {\n\tif name == \"-\" {\n\t\treturn digest(os.Stdin)\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer f.Close()\n\treturn digest(f)\n}\n\nfunc runCompute(files []string, binaryMode, tag bool) int {\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\trc := 0\n\tfor _, name := range files {\n\t\th, err := hashFile(name)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"%s: %s\\n\", programName, formatErr(err))\n\t\t\trc = 1\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase tag:\n\t\t\tfmt.Printf(\"%s (%s) = %s\\n\", tagName, name, h)\n\t\tcase binaryMode:\n\t\t\tfmt.Printf(\"%s *%s\\n\", h, name)\n\t\tdefault:\n\t\t\tfmt.Printf(\"%s  %s\\n\", h, name)\n\t\t}\n\t}\n\treturn rc\n}\n\nfunc runCheck(files []string, warn, quiet, status bool) int {\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\trc := 0\n\tfor _, cf := range files {\n\t\tvar r io.Reader\n\t\tif cf == \"-\" {\n\t\t\tr = os.Stdin\n\t\t} else {\n\t\t\tf, err := os.Open(cf)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: %s\\n\", programName, formatErr(err))\n\t\t\t\trc = 1\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tdefer f.Close()\n\t\t\tr = f\n\t\t}\n\t\tfailed, lineNum := 0, 0\n\t\tscanner := bufio.NewScanner(r)\n\t\tfor scanner.Scan() {\n\t\t\tlineNum++\n\t\t\tline := scanner.Text()\n\t\t\texpectedHash, filename, ok := parseLine(line)\n\t\t\tif !ok {\n\t\t\t\tif warn {\n\t\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: %s: %d: improperly formatted %s checksum line\\n\",\n\t\t\t\t\t\tprogramName, cf, lineNum, tagName)\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tactual, err := hashFile(filename)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: %s\\n\", programName, formatErr(err))\n\t\t\t\tif !status {\n\t\t\t\t\tfmt.Printf(\"%s: FAILED open or read\\n\", filename)\n\t\t\t\t}\n\t\t\t\tfailed++\n\t\t\t\trc = 1\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif strings.EqualFold(actual, expectedHash) {\n\t\t\t\tif !quiet && !status {\n\t\t\t\t\tfmt.Printf(\"%s: OK\\n\", filename)\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif !status {\n\t\t\t\t\tfmt.Printf(\"%s: FAILED\\n\", filename)\n\t\t\t\t}\n\t\t\t\tfailed++\n\t\t\t\trc = 1\n\t\t\t}\n\t\t}\n\t\tif failed > 0 && !status {\n\t\t\tnoun := \"checksum\"\n\t\t\tif failed > 1 {\n\t\t\t\tnoun = \"checksums\"\n\t\t\t}\n\t\t\tfmt.Fprintf(os.Stderr, \"%s: WARNING: %d computed %s did NOT match\\n\",\n\t\t\t\tprogramName, failed, noun)\n\t\t}\n\t}\n\treturn rc\n}\n\nfunc parseLine(line string) (hash, filename string, ok bool) {\n\tif i := strings.Index(line, \" (\"); i >= 0 {\n\t\trest := line[i+2:]\n\t\tif j := strings.Index(rest, \") = \"); j >= 0 {\n\t\t\treturn rest[j+4:], rest[:j], true\n\t\t}\n\t}\n\ti := strings.IndexByte(line, ' ')\n\tif i < 1 || i >= len(line)-1 {\n\t\treturn \"\", \"\", false\n\t}\n\tif line[i+1] == ' ' || line[i+1] == '*' {\n\t\treturn line[:i], line[i+2:], true\n\t}\n\treturn \"\", \"\", false\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := err.(*os.PathError); ok {\n\t\tmsg := pe.Err.Error()\n\t\tif len(msg) > 0 {\n\t\t\tmsg = strings.ToUpper(msg[:1]) + msg[1:]\n\t\t}\n\t\treturn pe.Path + \": \" + msg\n\t}\n\treturn err.Error()\n}\n"}}
