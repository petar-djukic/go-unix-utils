aces:\n      - prd030-md5sum R3.1\n\n  - name: md5sum_tag_format\n    description: \"--tag uses BSD format: 'MD5 (FILENAME) = HASH'.\"\n    inputs:\n      args: [\"--tag\", \"hello.txt\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"MD5 (hello.txt) = b1946ac92492d2347c6235b4d2611184\\n\"\n      stderr: \"\"\n    traces:\n      - prd030-md5sum R1.3\n\n  - name: md5sum_check_valid\n    description: \"--check on a valid checksum file exits 0 and prints OK. Setup: checksums.md5 contains the correct hash for hello.txt.\"\n    inputs:\n      args: [\"--check\", \"checksums.md5\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello.txt: OK\\n\"\n      stderr: \"\"\n    traces:\n      - prd030-md5sum R2.1\n      - prd030-md5sum R2.2\n\n  - name: md5sum_check_failure\n    description: \"--check on a file with wrong hash exits 1 and prints FAILED. Setup: bad.md5 contains an incorrect hash for hello.txt.\"\n    inputs:\n      args: [\"--check\", \"bad.md5\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 1\n      stdout: \"hello.txt: FAILED\\n\"\n      stderr_contains: \"WARNING\"\n    traces:\n      - prd030-md5sum R2.2\n\n  # ---- sha1sum ----\n\n  - name: sha1sum_compute_stdin\n    description: Compute SHA-1 of stdin.\n    inputs:\n      args: []\n      stdin: \"hello\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"f572d396fae9206628714fb2ce00f72e94f2258f  -\\n\"\n      stderr: \"\"\n    traces:\n      - prd031-sha1sum R1.1\n      - prd031-sha1sum R1.2\n\n  - name: sha1sum_check_valid\n    description: \"--check on a valid SHA-1 checksum file exits 0.\"\n    inputs:\n      args: [\"--check\", \"checksums.sha1\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      ex