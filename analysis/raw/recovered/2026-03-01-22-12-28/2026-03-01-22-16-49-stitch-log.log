 stdout: same as bin/version with no arguments\n      stderr: \"\"\n    traces:\n      - prd011-magefiles R1.4\n\n  - name: version_unknown_flag\n    description: bin/version --bogus prints usage to stderr and exits 2.\n    inputs:\n      command: \"bin/version --bogus\"\n    expected:\n      exit_code: 2\n      stdout: \"\"\n      stderr_contains: \"usage\"\n    traces:\n      - prd011-magefiles R1.4\n\n  - name: version_dev_build\n    description: A build without ldflags prints \"dev\".\n    inputs:\n      command: \"go build -o /tmp/version-dev ./cmd/version && /tmp/version-dev\"\n    expected:\n      exit_code: 0\n      stdout: \"dev\\n\"\n      stderr: \"\"\n    traces:\n      - prd011-magefiles R1.2\n\n  - name: lint_passes\n    description: mage lint runs golangci-lint with no warnings.\n    inputs:\n      command: \"mage lint\"\n    expected:\n      exit_code: 0\n    traces:\n      - prd011-magefiles R3.1\n      - prd011-magefiles R3.2\n\n  - name: clean_removes_bin\n    description: mage clean removes the bin/ directory.\n    inputs:\n      command: \"mage build && mage clean\"\n    expected:\n      exit_code: 0\n      postcondition: bin/ does not exist\n    traces:\n      - prd011-magefiles R4.1\n\n  - name: clean_idempotent\n    description: mage clean succeeds when bin/ does not exist.\n    inputs:\n      command: \"mage clean && mage clean\"\n    expected:\n      exit_code: 0\n    traces:\n      - prd011-magefiles R4.1\n\n  # --- uc002-format: pkg/format output formatting ---\n\n  - name: columns_20_entries_80_width\n    description: Columns distributes 20 filenames into a grid fitting 80 columns.\n    inputs:\n      function: \"format.Columns(entries, 80)\"\n      entries: 20 filenames of varying lengths\n    expected:\n      postcondition: each row fits within 80 characters; column count is maximized\n    traces:\n      - prd003-format R1.1\n      - prd003-format R1.4\n\n  - name: columns_empty_input\n    description: Columns returns nil for empty input.\n    inputs:\n      function: \"format.Columns(nil, 80)\"\n    expected:\n      result: nil\n    traces:\n      - prd003-format R1.1\n\n  - name: pad_right\n    description: PadRight pads a string with trailing spaces to the specified width.\n    inputs:\n      function: 'format.PadRight(\"abc\", 10)'\n    expected:\n      result: '\"abc       \"  (abc + 7 spaces)'\n    traces:\n      - prd003-format R1.2\n\n  - name: pad_left\n    description: PadLeft pads a string with leading spaces to the specified width.\n    inputs:\n      function: 'format.PadLeft(\"abc\", 10)'\n    expected:\n      result: '\"       abc\"  (7 spaces + abc)'\n    traces:\n      - prd003-format R1.2\n\n  - name: display_width_multibyte\n    description: Column width uses rune count, not byte count, for multi-byte strings.\n    inputs:\n      function: 'format.PadRight(\"café\", 10)'\n    expected:\n      result: '\"café      \"  (café is 4 runes, padded to 10)'\n    traces:\n      - prd003-format R1.3\n\n  - name: file_type_color_all_types\n    description: FileTypeColor returns correct ANSI codes for all eight file types.\n    inputs:\n      function: \"format.FileTypeColor(mode) for each file type\"\n      setup: \"format.SetColorEnabled(true)\"\n    expected:\n      directory: '\"\\033[34m\"'\n      symlink: '\"\\033[36m\"'\n      executable: '\"\\033[32m\"'\n      block_device: '\"\\033[33;1m\"'\n      char_device: '\"\\033[33;1m\"'\n      socket: '\"\\033[35m\"'\n      pipe: '\"\\033[33m\"'\n      regular: '\"\"'\n    traces:\n      - prd003-format R2.1\n      - prd003-format R2.4\n\n  - name: reset_color_enabled\n    description: Reset returns ANSI reset sequence when color is enabled.\n    inputs:\n      function: \"format.Reset()\"\n      setup: \"format.SetColorEnabled(true)\"\n    expected:\n      result: '\"\\033[0m\"'\n    traces:\n      - prd003-format R2.2\n\n  - name: color_disabled_suppresses_output\n    description: SetColorEnabled(false) causes FileTypeColor and Reset to return empty strings.\n    inputs:\n      function: \"format.FileTypeColor(os.ModeDir) and format.Reset()\"\n      setup: \"format.SetColorEnabled(false)\"\n    expected:\n      file_type_color: '\"\"'\n      reset: '\"\"'\n    traces:\n      - prd003-format R2.6\n\n  - name: reset_color_enabled_restores_auto\n    description: ResetColorEnabled clears the override and reverts to TTY detection.\n    inputs:\n      function: \"format.ResetColorEnabled() then format.ColorEnabled(pipe)\"\n      setup: \"format.SetColorEnabled(true); format.ResetColorEnabled()\"\n    expected:\n      color_enabled_pipe: false\n    traces:\n      - prd003-format R2.7\n\n  - name: color_enabled_pipe\n    description: ColorEnabled returns false for an os.Pipe writer.\n    inputs:\n      function: \"format.ColorEnabled(pipeWriter)\"\n    expected:\n      result: false\n    traces:\n      - prd003-format R2.3\n\n  - name: color_enabled_non_file\n    description: ColorEnabled returns false for a bytes.Buffer (non-*os.File).\n    inputs:\n      function: \"format.ColorEnabled(&bytes.Buffer{})\"\n    expected:\n      result: false\n    traces:\n      - prd003-format R2.3\n\n  - name: human_size_binary\n    description: HumanSize converts bytes using 1024-based units.\n    inputs:\n      function: \"format.HumanSize(1536, HumanSizeOpts{Binary: true})\"\n    expected:\n      result: '\"1.5K\"'\n    traces:\n      - prd003-format R3.1\n      - prd003-format R3.2\n      - prd003-format R3.3\n\n  - name: human_size_si\n    description: HumanSize converts bytes using 1000-based SI units.\n    inputs:\n      function: \"format.HumanSize(1000000, HumanSizeOpts{Binary: false})\"\n    expected:\n      result: '\"1.0MB\"'\n    traces:\n      - prd003-format R3.1\n      - prd003-format R3.2\n\n  - name: human_size_zero\n    description: HumanSize returns \"0\" for zero bytes.\n    inputs:\n      function: \"format.HumanSize(0, HumanSizeOpts{Binary: true})\"\n    expected:\n      result: '\"0\"'\n    traces: