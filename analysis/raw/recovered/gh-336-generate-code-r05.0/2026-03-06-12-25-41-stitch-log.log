{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01QU2i1jfmBZkddgFjsncT5u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01K2EQihgn3HbCwPoJ6eave3","name":"Write","input":{"file_path":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/346/pkg/testutils/testutils.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// NormalizeFunc transforms output bytes for comparison.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest defines a single differential test case.\ntype DiffTest struct {\n\tName          string\n\tArgs          []string\n\tStdin         []byte\n\tEnv           []string\n\tWorkDir       string\n\tExitCode      int\n\tNormalize     []NormalizeFunc\n\tExpectedFiles map[string][]byte\n}\n\n// BuildBinary compiles the package at dir and returns the path to the binary.\nfunc BuildBinary(t *testing.T, dir string) string {\n\tt.Helper()\n\ttmpDir := t.TempDir()\n\tbinPath := filepath.Join(tmpDir, \"binary\")\n\tabsDir, err := filepath.Abs(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"abs path: %v\", err)\n\t}\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", binPath, absDir)\n\tcmd.Stderr = os.Stderr\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"build failed: %v\", err)\n\t}\n\treturn binPath\n}\n\n// RunDiffTests runs each test case against both binaries and compares output.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tgoOut, goErr, goExit := runBin(t, goBinary, tc)\n\t\t\trefOut, refErr, refExit := runBin(t, refBinary, tc)\n\n\t\t\tif goExit != refExit {\n\t\t\t\tt.Errorf(\"exit code: go=%d ref=%d\", goExit, refExit)\n\t\t\t}\n\t\t\tif !bytes.Equal(goOut, refOut) {\n\t\t\t\tt.Errorf(\"stdout mismatch:\\n  go:  %q\\n  ref: %q\", goOut, refOut)\n\t\t\t}\n\t\t\tif !bytes.Equal(goErr, refErr) {\n\t\t\t\tt.Errorf(\"stderr mismatch:\\n  go:  %q\\n  ref: %q\", goErr, refErr)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc runBin(t *testing.T, bin string, tc DiffTest) ([]byte, []byte, int) {\n\tt.Helper()\n\tcmd := exec.Command(bin, tc.Args...)\n\tif tc.Stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n\t}\n\tif len(tc.Env) > 0 {\n\t\tcmd.Env = append(os.Environ(), tc.Env...)\n\t}\n\tif tc.WorkDir != \"\" {\n\t\tcmd.Dir = tc.WorkDir\n\t}\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\terr := cmd.Run()\n\texitCode := 0\n\tif err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\texitCode = exitErr.ExitCode()\n\t\t} else {\n\t\t\tt.Fatalf(\"run %s: %v\", bin, err)\n\t\t}\n\t}\n\treturn stdout.Bytes(), stderr.Bytes(), exitCode\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":345,"cache_read_input_tokens":53014,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":345},"output_tokens":24,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"697b6b51-98ac-429a-8c87-1d8bb215b693","uuid":"a0f2298e-9939-4b55-86bc-3c07541a2bc1"}
