by the orchestrator init contract (R6.2). Helper\n    # functions such as logf are scaffold-provided and may have no callers in the\n    # current magefiles set.\n    - path: magefiles/\n      linters:\n        - gochecknoglobals\n        - unused\n    # staticcheck SA4017 (\"X is never called\") for magefiles/ scaffold helpers.\n    - path: magefiles/\n      text: \"is never called\"\n      linters:\n        - staticcheck\n","structuredPatch":[{"oldStart":1,"oldLines":23,"newStart":1,"newLines":19,"lines":["-# Golangci-lint configuration for go-unix-utils.","+# Golangci-lint v2 configuration for go-unix-utils."," # Covers cmd/, pkg/, and magefiles/. Implements prd011-magefiles R3.3.","-#","-# Run:","-#   golangci-lint run ./cmd/... ./pkg/...","-#   golangci-lint run ./...       (from magefiles/ directory)"," ","+version: \"2\"","+"," run:","   go: \"1.25\""," "," linters:","-  disable-all: true","+  default: none","   enable:","     - errcheck          # check return values of error-returning functions","     - govet             # vet-like checks (printf format strings, composite literals, etc.)","-    - staticcheck       # comprehensive static analysis (SA* rules)","-    - gosimple          # simplification suggestions (S* rules)","+    - staticcheck       # comprehensive static analysis (SA* rules; absorbs gosimple)","     - ineffassign       # detect ineffectual assignments","     - unused            # detect unused exported and unexported identifiers","-    - gofmt             # check gofmt formatting","     - revive            # idiomatic Go style (godoc on exported symbols, naming, etc.)","     - gochecknoglobals  # flag package-level variables; suppressed per-file with //nolint","     - misspell          # detect common spelling mistakes in comments and strings"]}],"originalFile":"# Golangci-lint configuration for go-unix-utils.\n# Covers cmd/, pkg/, and magefiles/. Implements prd011-magefiles R3.3.\n#\n# Run:\n#   golangci-lint run ./cmd/... ./pkg/...\n#   golangci-lint run ./...       (from magefiles/ directory)\n\nrun:\n  go: \"1.25\"\n\nlinters:\n  disable-all: true\n  enable:\n    - errcheck          # check return values of error-returning functions\n    - govet             # vet-like checks (printf format strings, composite literals, etc.)\n    - staticcheck       # comprehensive static analysis (SA* rules)\n    - gosimple          # simplification suggestions (S* rules)\n    - ineffassign       # detect ineffectual assignments\n    - unused            # detect unused exported and unexported identifiers\n    - gofmt             # check gofmt formatting\n    - revive            # idiomatic Go style (godoc on exported symbols, naming, etc.)\n    - gochecknoglobals  # flag package-level variables; suppressed per-file with //nolint\n    - misspell          # detect common spelling mistakes in comments and strings\n\nlinters-settings:\n  errcheck:\n    # fmt print functions write to stdout/stderr; errors are non-actionable at the call site.\n    exclude-functions:\n      - fmt.Print\n      - fmt.Println\n      - fmt.Printf\n      - fmt.Fprint\n      - fmt.Fprintln\n      - fmt.Fprintf\n  revive:\n    rules:\n      - name: exported\n        severity: warning\n        disabled: false\n      - name: var-naming\n        severity: warning\n        disabled: false\n\nissues:\n  exclude-rules:\n    # magefiles/ is build tooling provided by cobbler-scaffold. The package-level\n    # baseCfg variable is required by the orchestrator init contract (R6.2). Helper\n    # functions such as logf are scaffold-provided and may have no callers in the\n    # current magefiles set.\n    - path: magefiles/\n      linters:\n        - gochecknoglobals\n        - unused\n    # staticcheck SA4017 (\"X is never called\") for magefiles/ scaffold helpers.\n    - path: magefiles/\n      text: \"is never called\"\n      linters:\n        - staticcheck\n"}}
