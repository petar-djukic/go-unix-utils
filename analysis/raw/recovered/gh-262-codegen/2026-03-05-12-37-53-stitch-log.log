hecknoglobals  # flag package-level variables; suppressed per-file with //nolint\n    - misspell          # detect common spelling mistakes in comments and strings\n\nlinters-settings:\n  errcheck:\n    # fmt print functions write to stdout/stderr; errors are non-actionable at the call site.\n    exclude-functions:\n      - fmt.Print\n      - fmt.Println\n      - fmt.Printf\n      - fmt.Fprint\n      - fmt.Fprintln\n      - fmt.Fprintf\n  revive:\n    rules:\n      - name: exported\n        severity: warning\n        disabled: false\n      - name: var-naming\n        severity: warning\n        disabled: false\n\nissues:\n  exclude-rules:\n    # Test files commonly use package-level variables for shared fixtures (e.g.,\n    # table-driven test inputs, reusable test options). These are intentional.\n    - path: \"_test\\\\.go\"\n      linters:\n        - gochecknoglobals\n    # magefiles/ is build tooling provided by cobbler-scaffold. The package-level\n    # baseCfg variable is required by the orchestrator init contract (R6.2). Helper\n    # functions such as logf are scaffold-provided and may have no callers in the\n    # current magefiles set.\n    - path: magefiles/\n      linters:\n        - gochecknoglobals\n        - unused\n    # staticcheck SA4017 (\"X is never called\") for magefiles/ scaffold helpers.\n    - path: magefiles/\n      text: \"is never called\"\n      linters:\n        - staticcheck\n","numLines":60,"startLine":1,"totalLines":60}}}
