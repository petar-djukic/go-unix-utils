{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ke3VR9GdnBMgZ6zS3d5s5u","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package testutils provides the differential testing harness used by cmd/\n     5→// packages to verify Go utility implementations against reference GNU binaries.\n     6→// Each test case executes two binaries with identical inputs and compares the\n     7→// Go binary's outputs against expected values.\n     8→//\n     9→// Implements: prd001-testutils\n    10→// Architecture: docs/ARCHITECTURE.yaml § pkg/testutils\n    11→package testutils\n    12→\n    13→import (\n    14→\t\"bytes\"\n    15→\t\"fmt\"\n    16→\t\"os\"\n    17→\t\"os/exec\"\n    18→\t\"testing\"\n    19→)\n    20→\n    21→// DiffTest defines a single differential test case. Both the reference binary\n    22→// (refBin) and the Go binary (goBin) are executed with identical inputs; the\n    23→// Go binary's outputs are compared against the expected Want* values.\n    24→//\n    25→// Implements prd001-testutils R1.\n    26→type DiffTest struct {\n    27→\t// Args are the command-line arguments passed to both binaries.\n    28→\tArgs []string\n    29→\n    30→\t// Stdin is content piped to stdin of both binaries.\n    31→\t// nil means both binaries receive EOF immediately.\n    32→\tStdin []byte\n    33→\n    34→\t// Env contains additional KEY=VALUE environment variable pairs merged\n    35→\t// into the inherited process environment. Matching keys are overridden;\n    36→\t// new keys are added.\n    37→\tEnv []string\n    38→\n    39→\t// WantExit is the expected exit code of the Go binary.\n    40→\tWantExit int\n    41→\n    42→\t// WantStdout is the expected stdout output of the Go binary.\n    43→\tWantStdout []byte\n    44→\n    45→\t// WantStderr is the expected stderr output of the Go binary.\n    46→\tWantStderr []byte\n    47→\n    48→\t// NormStdout, when non-nil, is applied to the actual stdout before\n    49→\t// comparison, enabling normalization of acceptable differences (e.g.,\n    50→\t// stripping trailing newlines or timestamps).\n    51→\tNormStdout func([]byte) []byte\n    52→\n    53→\t// NormStderr, when non-nil, is applied to the actual stderr before\n    54→\t// comparison.\n    55→\tNormStderr func([]byte) []byte\n    56→}\n    57→\n    58→// Run executes refBin and goBin with identical inputs and reports divergence\n    59→// between the Go binary's outputs and the expected Want* values. t.Errorf is\n    60→// used (not t.Fatalf) so all three mismatch kinds — exit code, stdout, stderr\n    61→// — are reported in a single invocation without halting at the first failure.\n    62→//\n    63→// Implements prd001-testutils R2, R3.\n    64→func (tc DiffTest) Run(t *testing.T, refBin, goBin string) {\n    65→\tt.Helper()\n    66→\n    67→\tenv := append(os.Environ(), tc.Env...)\n    68→\n    69→\t// Execute the reference binary. Its output is not compared against\n    70→\t// Want*; it is run to confirm the reference binary is reachable.\n    71→\tif _, err := runBinary(refBin, tc.Args, tc.Stdin, env); err != nil {\n    72→\t\tt.Fatalf(\"reference binary %s: %v\", refBin, err)\n    73→\t}\n    74→\n    75→\t// Execute the Go binary and capture its outputs.\n    76→\tres, err := runBinary(goBin, tc.Args, tc.Stdin, env)\n    77→\tif err != nil {\n    78→\t\tt.Fatalf(\"go binary %s: %v\", goBin, err)\n    79→\t}\n    80→\n    81→\tgotStdout := res.stdout\n    82→\tgotStderr := res.stderr\n    83→\tif tc.NormStdout != nil {\n    84→\t\tgotStdout = tc.NormStdout(gotStdout)\n    85→\t}\n    86→\tif tc.NormStderr != nil {\n    87→\t\tgotStderr = tc.NormStderr(gotStderr)\n    88→\t}\n    89→\n    90→\t// R3: report each mismatch independently so all failures are visible.\n    91→\tif res.exitCode != tc.WantExit {\n    92→\t\tt.Errorf(\"%s: exit code = %d, want %d\", goBin, res.exitCode, tc.WantExit)\n    93→\t}\n    94→\tif !bytes.Equal(gotStdout, tc.WantStdout) {\n    95→\t\tt.Errorf(\"%s: stdout = %q, want %q\", goBin, gotStdout, tc.WantStdout)\n    96→\t}\n    97→\tif !bytes.Equal(gotStderr, tc.WantStderr) {\n    98→\t\tt.Errorf(\"%s: stderr = %q, want %q\", goBin, gotStderr, tc.WantStderr)\n    99→\t}\n   100→}\n   101→\n   102→// binaryResult holds the captured output of a single binary execution.\n   103→type binaryResult struct {\n   104→\tstdout   []byte\n   105→\tstderr   []byte\n   106→\texitCode int\n   107→}\n   108→\n   109→// runBinary executes the binary at path with the given arguments, stdin, and\n   110→// environment and returns the captured stdout, stderr, and exit code.\n   111→// It returns an error only when the binary cannot be started; a non-zero exit\n   112→// code is captured in the result, not treated as an error.\n   113→func runBinary(path string, args []string, stdin []byte, env []string) (binaryResult, error) {\n   114→\tvar outBuf, errBuf bytes.Buffer\n   115→\tcmd := exec.Command(path, args...)\n   116→\tcmd.Stdin = bytes.NewReader(stdin)\n   117→\tcmd.Stdout = &outBuf\n   118→\tcmd.Stderr = &errBuf\n   119→\tcmd.Env = env\n   120→\n   121→\terr := cmd.Run()\n   122→\texitCode := 0\n   123→\tif err != nil {\n   124→\t\texitErr, ok := err.(*exec.ExitError) //nolint:errorlint\n   125→\t\tif !ok {\n   126→\t\t\treturn binaryResult{}, fmt.Errorf(\"starting %s: %w\", path, err)\n   127→\t\t}\n   128→\t\texitCode = exitErr.ExitCode()\n   129→\t}\n   130→\treturn binaryResult{\n   131→\t\tstdout:   outBuf.Bytes(),\n   132→\t\tstderr:   errBuf.Bytes(),\n   133→\t\texitCode: exitCode,\n   134→\t}, nil\n   135→}\n   136→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d9efc00c-de85-4587-a818-7b80ecd56cee","uuid":"ee17c639-430a-4cc5-b2b9-05be7dad6d81","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/287/pkg/testutils/difftest.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides the differential testing harness used by cmd/\n// packages to verify Go utility implementations against reference GNU binaries.\n// Each test case executes two binaries with identical inputs and compares the\n// Go binary's outputs against expected values.\n//\n// Implements: prd001-testutils\n// Architecture: docs/ARCHITECTURE.yaml § pkg/testutils\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"testing\"\n)\n\n// DiffTest defines a single differential test case. Both the reference binary\n// (refBin) and the Go binary (goBin) are executed with identical inputs; the\n// Go binary's outputs are compared against the expected Want* values.\n//\n// Implements prd001-testutils R1.\ntype DiffTest struct {\n\t// Args are the command-line arguments passed to both binaries.\n\tArgs []string\n\n\t// Stdin is content piped to stdin of both binaries.\n\t// nil means both binaries receive EOF immediately.\n\tStdin []byte\n\n\t// Env contains additional KEY=VALUE environment variable pairs merged\n\t// into the inherited process environment. Matching keys are overridden;\n\t// new keys are added.\n\tEnv []string\n\n\t// WantExit is the expected exit code of the Go binary.\n\tWantExit int\n\n\t// WantStdout is the expected stdout output of the Go binary.\n\tWantStdout []byte\n\n\t// WantStderr is the expected stderr output of the Go binary.\n\tWantStderr []byte\n\n\t// NormStdout, when non-nil, is applied to the actual stdout before\n\t// comparison, enabling normalization of acceptable differences (e.g.,\n\t// stripping trailing newlines or timestamps).\n\tNormStdout func([]byte) []byte\n\n\t// NormStderr, when non-nil, is applied to the actual stderr before\n\t// comparison.\n\tNormStderr func([]byte) []byte\n}\n\n// Run executes refBin and goBin with identical inputs and reports divergence\n// between the Go binary's outputs and the expected Want* values. t.Errorf is\n// used (not t.Fatalf) so all three mismatch kinds — exit code, stdout, stderr\n// — are reported in a single invocation without halting at the first failure.\n//\n// Implements prd001-testutils R2, R3.\nfunc (tc DiffTest) Run(t *testing.T, refBin, goBin string) {\n\tt.Helper()\n\n\tenv := append(os.Environ(), tc.Env...)\n\n\t// Execute the reference binary. Its output is not compared against\n\t// Want*; it is run to confirm the reference binary is reachable.\n\tif _, err := runBinary(refBin, tc.Args, tc.Stdin, env); err != nil {\n\t\tt.Fatalf(\"reference binary %s: %v\", refBin, err)\n\t}\n\n\t// Execute the Go binary and capture its outputs.\n\tres, err := runBinary(goBin, tc.Args, tc.Stdin, env)\n\tif err != nil {\n\t\tt.Fatalf(\"go binary %s: %v\", goBin, err)\n\t}\n\n\tgotStdout := res.stdout\n\tgotStderr := res.stderr\n\tif tc.NormStdout != nil {\n\t\tgotStdout = tc.NormStdout(gotStdout)\n\t}\n\tif tc.NormStderr != nil {\n\t\tgotStderr = tc.NormStderr(gotStderr)\n\t}\n\n\t// R3: report each mismatch independently so all failures are visible.\n\tif res.exitCode != tc.WantExit {\n\t\tt.Errorf(\"%s: exit code = %d, want %d\", goBin, res.exitCode, tc.WantExit)\n\t}\n\tif !bytes.Equal(gotStdout, tc.WantStdout) {\n\t\tt.Errorf(\"%s: stdout = %q, want %q\", goBin, gotStdout, tc.WantStdout)\n\t}\n\tif !bytes.Equal(gotStderr, tc.WantStderr) {\n\t\tt.Errorf(\"%s: stderr = %q, want %q\", goBin, gotStderr, tc.WantStderr)\n\t}\n}\n\n// binaryResult holds the captured output of a single binary execution.\ntype binaryResult struct {\n\tstdout   []byte\n\tstderr   []byte\n\texitCode int\n}\n\n// runBinary executes the binary at path with the given arguments, stdin, and\n// environment and returns the captured stdout, stderr, and exit code.\n// It returns an error only when the binary cannot be started; a non-zero exit\n// code is captured in the result, not treated as an error.\nfunc runBinary(path string, args []string, stdin []byte, env []string) (binaryResult, error) {\n\tvar outBuf, errBuf bytes.Buffer\n\tcmd := exec.Command(path, args...)\n\tcmd.Stdin = bytes.NewReader(stdin)\n\tcmd.Stdout = &outBuf\n\tcmd.Stderr = &errBuf\n\tcmd.Env = env\n\n\terr := cmd.Run()\n\texitCode := 0\n\tif err != nil {\n\t\texitErr, ok := err.(*exec.ExitError) //nolint:errorlint\n\t\tif !ok {\n\t\t\treturn binaryResult{}, fmt.Errorf(\"starting %s: %w\", path, err)\n\t\t}\n\t\texitCode = exitErr.ExitCode()\n\t}\n\treturn binaryResult{\n\t\tstdout:   outBuf.Bytes(),\n\t\tstderr:   errBuf.Bytes(),\n\t\texitCode: exitCode,\n\t}, nil\n}\n","numLines":136,"startLine":1,"totalLines":136}}}
