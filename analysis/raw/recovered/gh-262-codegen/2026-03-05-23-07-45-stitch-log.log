{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012eygHc1v5t4KgJJYCh7p5Q","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package main implements the cmd/wc binary.\n     5→// Counts lines, words, bytes, characters, and maximum line length for\n     6→// one or more files or stdin, with column-aligned output matching GNU wc.\n     7→//\n     8→// Implements: prd005-wc R1-R6\n     9→// Architecture: docs/ARCHITECTURE.yaml § cmd/\n    10→package main\n    11→\n    12→import (\n    13→\t\"bufio\"\n    14→\t\"fmt\"\n    15→\t\"io\"\n    16→\t\"os\"\n    17→\t\"os/signal\"\n    18→\t\"strings\"\n    19→\t\"syscall\"\n    20→\t\"unicode\"\n    21→\t\"unicode/utf8\"\n    22→)\n    23→\n    24→// progName is the program name used in error diagnostics (R6.2).\n    25→const progName = \"wc\"\n    26→\n    27→// totalMode controls when the totals line is printed (R3.3).\n    28→type totalMode int\n    29→\n    30→const (\n    31→\ttotalAuto   totalMode = iota // print total when more than one file (default)\n    32→\ttotalAlways                  // always print total, even for one file\n    33→\ttotalOnly                    // print only the total line, not per-file lines\n    34→\ttotalNever                   // never print total\n    35→)\n    36→\n    37→// counts holds the accumulated counts for a single input source.\n    38→type counts struct {\n    39→\tlines      int64\n    40→\twords      int64\n    41→\tbytes      int64\n    42→\tchars      int64\n    43→\tmaxLineLen int64\n    44→}\n    45→\n    46→// add returns the element-wise sum of c and other.\n    47→func (c counts) add(other counts) counts {\n    48→\tc.lines += other.lines\n    49→\tc.words += other.words\n    50→\tc.bytes += other.bytes\n    51→\tc.chars += other.chars\n    52→\tif other.maxLineLen > c.maxLineLen {\n    53→\t\tc.maxLineLen = other.maxLineLen\n    54→\t}\n    55→\treturn c\n    56→}\n    57→\n    58→// wcConfig holds the resolved flag settings for a single wc invocation.\n    59→type wcConfig struct {\n    60→\tprintLines   bool\n    61→\tprintWords   bool\n    62→\tprintBytes   bool\n    63→\tprintChars   bool\n    64→\tprintMaxLen  bool\n    65→\ttotalMode    totalMode\n    66→\tfiles0From   string // --files0-from=FILE; empty means not used\n    67→}\n    68→\n    69→func main() {\n    70→\t// R6.3 / R5.1 equivalent: SIGPIPE handler so piping to head exits cleanly.\n    71→\tsigCh := make(chan os.Signal, 1)\n    72→\tsignal.Notify(sigCh, syscall.SIGPIPE)\n    73→\tgo func() {\n    74→\t\t<-sigCh\n    75→\t\tos.Exit(0)\n    76→\t}()\n    77→\n    78→\tcfg, files := parseFlags()\n    79→\n    80→\texitCode := 0\n    81→\tvar results []fileResult\n    82→\n    83→\tfor _, name := range files {\n    84→\t\tc, err := countInput(name)\n    85→\t\tif err != nil {\n    86→\t\t\tfmt.Fprintf(os.Stderr, \"%s: %s: %v\\n\", progName, name, sysErr(err))\n    87→\t\t\texitCode = 1\n    88→\t\t\t// R6.2: still record zero counts so total is correct for remaining files.\n    89→\t\t\tresults = append(results, fileResult{name: name, counts: counts{}})\n    90→\t\t\tcontinue\n    91→\t\t}\n    92→\t\tresults = append(results, fileResult{name: name, counts: c})\n    93→\t}\n    94→\n    95→\t// Compute totals.\n    96→\tvar total counts\n    97→\tfor _, r := range results {\n    98→\t\ttotal = total.add(r.counts)\n    99→\t}\n   100→\n   101→\t// Determine column width from the largest count that will be printed.\n   102→\twidth := numberWidth(total, cfg)\n   103→\n   104→\t// Print per-file lines unless --total=only.\n   105→\tif cfg.totalMode != totalOnly {\n   106→\t\tfor _, r := range results {\n   107→\t\t\tprintCounts(r.counts, r.name, width, cfg)\n   108→\t\t}\n   109→\t}\n   110→\n   111→\t// Print total line per R3.3.\n   112→\tshowTotal := false\n   113→\tswitch cfg.totalMode {\n   114→\tcase totalAuto:\n   115→\t\tshowTotal = len(files) > 1\n   116→\tcase totalAlways:\n   117→\t\tshowTotal = true\n   118→\tcase totalOnly:\n   119→\t\tshowTotal = true\n   120→\tcase totalNever:\n   121→\t\tshowTotal = false\n   122→\t}\n   123→\tif showTotal {\n   124→\t\tprintCounts(total, \"total\", width, cfg)\n   125→\t}\n   126→\n   127→\tos.Exit(exitCode)\n   128→}\n   129→\n   130→// fileResult pairs a filename with its counts.\n   131→type fileResult struct {\n   132→\tname   string\n   133→\tcounts counts\n   134→}\n   135→\n   136→// parseFlags parses command-line arguments manually to support GNU-style long\n   137→// flags (--total=VALUE, --files0-from=FILE) alongside single-character flags.\n   138→// Go's flag package does not support --key=value syntax natively, so we parse\n   139→// by hand to match GNU wc flag behavior.\n   140→func parseFlags() (wcConfig, []string) {\n   141→\tcfg := wcConfig{}\n   142→\tvar files []string\n   143→\texplicitFlags := false\n   144→\n   145→\targs := os.Args[1:]\n   146→\tfor i := 0; i < len(args); i++ {\n   147→\t\targ := args[i]\n   148→\n   149→\t\t// \"--\" terminates flag parsing.\n   150→\t\tif arg == \"--\" {\n   151→\t\t\tfiles = append(files, args[i+1:]...)\n   152→\t\t\tbreak\n   153→\t\t}\n   154→\n   155→\t\t// Long flags.\n   156→\t\tif strings.HasPrefix(arg, \"--\") {\n   157→\t\t\tif strings.HasPrefix(arg, \"--total=\") {\n   158→\t\t\t\tval := arg[len(\"--total=\"):]\n   159→\t\t\t\tswitch val {\n   160→\t\t\t\tcase \"auto\":\n   161→\t\t\t\t\tcfg.totalMode = totalAuto\n   162→\t\t\t\tcase \"always\":\n   163→\t\t\t\t\tcfg.totalMode = totalAlways\n   164→\t\t\t\tcase \"only\":\n   165→\t\t\t\t\tcfg.totalMode = totalOnly\n   166→\t\t\t\tcase \"never\":\n   167→\t\t\t\t\tcfg.totalMode = totalNever\n   168→\t\t\t\tdefault:\n   169→\t\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: invalid argument '%s' for '--total'\\n\", progName, val)\n   170→\t\t\t\t\tos.Exit(1)\n   171→\t\t\t\t}\n   172→\t\t\t\tcontinue\n   173→\t\t\t}\n   174→\t\t\tif strings.HasPrefix(arg, \"--files0-from=\") {\n   175→\t\t\t\tcfg.files0From = arg[len(\"--files0-from=\"):]\n   176→\t\t\t\tcontinue\n   177→\t\t\t}\n   178→\t\t\t// Long flag aliases.\n   179→\t\t\tswitch arg {\n   180→\t\t\tcase \"--lines\":\n   181→\t\t\t\tcfg.printLines = true\n   182→\t\t\t\texplicitFlags = true\n   183→\t\t\tcase \"--words\":\n   184→\t\t\t\tcfg.printWords = true\n   185→\t\t\t\texplicitFlags = true\n   186→\t\t\tcase \"--bytes\":\n   187→\t\t\t\tcfg.printBytes = true\n   188→\t\t\t\texplicitFlags = true\n   189→\t\t\tcase \"--chars\":\n   190→\t\t\t\tcfg.printChars = true\n   191→\t\t\t\texplicitFlags = true\n   192→\t\t\tcase \"--max-line-length\":\n   193→\t\t\t\tcfg.printMaxLen = true\n   194→\t\t\t\texplicitFlags = true\n   195→\t\t\tdefault:\n   196→\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: unrecognized option '%s'\\n\", progName, arg)\n   197→\t\t\t\tos.Exit(1)\n   198→\t\t\t}\n   199→\t\t\tcontinue\n   200→\t\t}\n   201→\n   202→\t\t// Short flags (may be combined: -lwc).\n   203→\t\tif len(arg) > 1 && arg[0] == '-' {\n   204→\t\t\tfor _, ch := range arg[1:] {\n   205→\t\t\t\tswitch ch {\n   206→\t\t\t\tcase 'l':\n   207→\t\t\t\t\tcfg.printLines = true\n   208→\t\t\t\t\texplicitFlags = true\n   209→\t\t\t\tcase 'w':\n   210→\t\t\t\t\tcfg.printWords = true\n   211→\t\t\t\t\texplicitFlags = true\n   212→\t\t\t\tcase 'c':\n   213→\t\t\t\t\tcfg.printBytes = true\n   214→\t\t\t\t\texplicitFlags = true\n   215→\t\t\t\tcase 'm':\n   216→\t\t\t\t\tcfg.printChars = true\n   217→\t\t\t\t\texplicitFlags = true\n   218→\t\t\t\tcase 'L':\n   219→\t\t\t\t\tcfg.printMaxLen = true\n   220→\t\t\t\t\texplicitFlags = true\n   221→\t\t\t\tdefault:\n   222→\t\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: invalid option -- '%c'\\n\", progName, ch)\n   223→\t\t\t\t\tos.Exit(1)\n   224→\t\t\t\t}\n   225→\t\t\t}\n   226→\t\t\tcontinue\n   227→\t\t}\n   228→\n   229→\t\t// Not a flag — it's a filename.\n   230→\t\tfiles = append(files, arg)\n   231→\t}\n   232→\n   233→\t// R1.1: when no flags are given, default to lines + words + bytes.\n   234→\tif !explicitFlags {\n   235→\t\tcfg.printLines = true\n   236→\t\tcfg.printWords = true\n   237→\t\tcfg.printBytes = true\n   238→\t}\n   239→\n   240→\t// R2.3: -m takes precedence over -c when both are given.\n   241→\tif cfg.printChars && cfg.printBytes {\n   242→\t\tcfg.printBytes = false\n   243→\t}\n   244→\n   245→\t// Handle --files0-from (R4.4).\n   246→\tif cfg.files0From != \"\" {\n   247→\t\tf0files, err := readFiles0From(cfg.files0From)\n   248→\t\tif err != nil {\n   249→\t\t\tfmt.Fprintf(os.Stderr, \"%s: %v\\n\", progName, err)\n   250→\t\t\tos.Exit(1)\n   251→\t\t}\n   252→\t\tfiles = append(files, f0files...)\n   253→\t}\n   254→\n   255→\t// R1.2: when no file arguments, read from stdin.\n   256→\tif len(files) == 0 {\n   257→\t\tfiles = []string{\"-\"}\n   258→\t}\n   259→\n   260→\treturn cfg, files\n   261→}\n   262→\n   263→// readFiles0From reads NUL-delimited filenames from the given path.\n   264→// When path is \"-\", filenames are read from stdin (R4.4).\n   265→func readFiles0From(path string) ([]string, error) {\n   266→\tvar r io.Reader\n   267→\tif path == \"-\" {\n   268→\t\tr = os.Stdin\n   269→\t} else {\n   270→\t\tf, err := os.Open(path)\n   271→\t\tif err != nil {\n   272→\t\t\treturn nil, fmt.Errorf(\"cannot open '%s' for reading: %w\", path, sysErr(err))\n   273→\t\t}\n   274→\t\tdefer func() { _ = f.Close() }() // best-effort cleanup\n   275→\t\tr = f\n   276→\t}\n   277→\n   278→\tdata, err := io.ReadAll(r)\n   279→\tif err != nil {\n   280→\t\treturn nil, fmt.Errorf(\"reading files0-from: %w\", err)\n   281→\t}\n   282→\n   283→\tvar files []string\n   284→\tfor _, name := range strings.Split(string(data), \"\\x00\") {\n   285→\t\tif name != \"\" {\n   286→\t\t\tfiles = append(files, name)\n   287→\t\t}\n   288→\t}\n   289→\treturn files, nil\n   290→}\n   291→\n   292→// countInput reads an input source and returns its counts.\n   293→// When name is \"-\", stdin is read (R4.1).\n   294→func countInput(name string) (counts, error) {\n   295→\tvar r io.Reader\n   296→\tif name == \"-\" {\n   297→\t\tr = os.Stdin\n   298→\t} else {\n   299→\t\tf, err := os.Open(name)\n   300→\t\tif err != nil {\n   301→\t\t\treturn counts{}, err\n   302→\t\t}\n   303→\t\tdefer func() { _ = f.Close() }() // best-effort cleanup\n   304→\t\tr = f\n   305→\t}\n   306→\treturn countReader(r)\n   307→}\n   308→\n   309→// countReader counts lines, words, bytes, characters, and max line length\n   310→// from r in a single pass. A word is a maximal sequence of non-whitespace\n   311→// characters (R2.2). Line length is measured with tab expansion to the next\n   312→// multiple of 8 (R2.5).\n   313→func countReader(r io.Reader) (counts, error) {\n   314→\tvar c counts\n   315→\tbr := bufio.NewReader(r)\n   316→\tinWord := false\n   317→\tvar lineLen int64\n   318→\n   319→\tfor {\n   320→\t\tbuf := make([]byte, 32*1024)\n   321→\t\tn, err := br.Read(buf)\n   322→\t\tbuf = buf[:n]\n   323→\t\tc.bytes += int64(n)\n   324→\n   325→\t\ti := 0\n   326→\t\tfor i < len(buf) {\n   327→\t\t\tru, size := utf8.DecodeRune(buf[i:])\n   328→\t\t\tif ru == utf8.RuneError && size == 1 {\n   329→\t\t\t\t// R2.4: invalid byte counts as one character.\n   330→\t\t\t\tc.chars++\n   331→\t\t\t\tif inWord {\n   332→\t\t\t\t\t// Invalid byte is not whitespace; stay in word.\n   333→\t\t\t\t} else {\n   334→\t\t\t\t\tinWord = true\n   335→\t\t\t\t\tc.words++\n   336→\t\t\t\t}\n   337→\t\t\t\tlineLen++\n   338→\t\t\t\ti++\n   339→\t\t\t\tcontinue\n   340→\t\t\t}\n   341→\n   342→\t\t\tc.chars++\n   343→\n   344→\t\t\tif ru == '\\n' {\n   345→\t\t\t\tc.lines++\n   346→\t\t\t\tif inWord {\n   347→\t\t\t\t\tinWord = false\n   348→\t\t\t\t}\n   349→\t\t\t\t// R2.5: end of line — check max.\n   350→\t\t\t\tif lineLen > c.maxLineLen {\n   351→\t\t\t\t\tc.maxLineLen = lineLen\n   352→\t\t\t\t}\n   353→\t\t\t\tlineLen = 0\n   354→\t\t\t} else if ru == '\\t' {\n   355→\t\t\t\t// R2.5: tab advances to next multiple of 8.\n   356→\t\t\t\tlineLen = (lineLen/8 + 1) * 8\n   357→\t\t\t\tif inWord {\n   358→\t\t\t\t\tinWord = false\n   359→\t\t\t\t}\n   360→\t\t\t} else if unicode.IsSpace(ru) {\n   361→\t\t\t\tif inWord {\n   362→\t\t\t\t\tinWord = false\n   363→\t\t\t\t}\n   364→\t\t\t\tlineLen++\n   365→\t\t\t} else {\n   366→\t\t\t\tif !inWord {\n   367→\t\t\t\t\tinWord = true\n   368→\t\t\t\t\tc.words++\n   369→\t\t\t\t}\n   370→\t\t\t\tlineLen++\n   371→\t\t\t}\n   372→\n   373→\t\t\ti += size\n   374→\t\t}\n   375→\n   376→\t\tif err == io.EOF {\n   377→\t\t\tbreak\n   378→\t\t}\n   379→\t\tif err != nil {\n   380→\t\t\treturn c, err\n   381→\t\t}\n   382→\t}\n   383→\n   384→\t// R2.5: handle last line if it didn't end with newline.\n   385→\tif lineLen > c.maxLineLen {\n   386→\t\tc.maxLineLen = lineLen\n   387→\t}\n   388→\n   389→\treturn c, nil\n   390→}\n   391→\n   392→// numberWidth returns the minimum field width for printing counts.\n   393→// It is the number of decimal digits in the largest count that will be printed,\n   394→// matching GNU wc's dynamic column-width behavior (R3.1).\n   395→func numberWidth(total counts, cfg wcConfig) int {\n   396→\tmaxVal := int64(0)\n   397→\tif cfg.printLines && total.lines > maxVal {\n   398→\t\tmaxVal = total.lines\n   399→\t}\n   400→\tif cfg.printWords && total.words > maxVal {\n   401→\t\tmaxVal = total.words\n   402→\t}\n   403→\tif cfg.printBytes && total.bytes > maxVal {\n   404→\t\tmaxVal = total.bytes\n   405→\t}\n   406→\tif cfg.printChars && total.chars > maxVal {\n   407→\t\tmaxVal = total.chars\n   408→\t}\n   409→\tif cfg.printMaxLen && total.maxLineLen > maxVal {\n   410→\t\tmaxVal = total.maxLineLen\n   411→\t}\n   412→\tw := 1\n   413→\tfor maxVal >= 10 {\n   414→\t\tmaxVal /= 10\n   415→\t\tw++\n   416→\t}\n   417→\treturn w\n   418→}\n   419→\n   420→// printCounts writes one output line with the requested counts and filename.\n   421→// Counts are right-justified to width columns (R3.1). The filename is omitted\n   422→// when name is \"-\" and it's the only input (stdin with no filename) (R1.3).\n   423→func printCounts(c counts, name string, width int, cfg wcConfig) {\n   424→\tvar parts []string\n   425→\n   426→\tif cfg.printLines {\n   427→\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.lines))\n   428→\t}\n   429→\tif cfg.printWords {\n   430→\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.words))\n   431→\t}\n   432→\tif cfg.printChars {\n   433→\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.chars))\n   434→\t}\n   435→\tif cfg.printBytes {\n   436→\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.bytes))\n   437→\t}\n   438→\tif cfg.printMaxLen {\n   439→\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.maxLineLen))\n   440→\t}\n   441→\n   442→\tline := strings.Join(parts, \" \")\n   443→\n   444→\t// R1.3: append filename unless stdin with no explicit \"-\" argument.\n   445→\tif name == \"-\" {\n   446→\t\tfmt.Println(line)\n   447→\t} else {\n   448→\t\tfmt.Printf(\"%s %s\\n\", line, name)\n   449→\t}\n   450→}\n   451→\n   452→// sysErr extracts the underlying system error from an os.PathError for\n   453→// cleaner diagnostic messages matching GNU wc format.\n   454→func sysErr(err error) error {\n   455→\tif pe, ok := err.(*os.PathError); ok { //nolint:errorlint\n   456→\t\treturn pe.Err\n   457→\t}\n   458→\treturn err\n   459→}\n   460→"}]},"parent_tool_use_id":null,"session_id":"343fd1c1-e462-4614-a39e-fffa4b487ce0","uuid":"bec078a2-3615-4552-8381-0215331eee36","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/306/cmd/wc/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements the cmd/wc binary.\n// Counts lines, words, bytes, characters, and maximum line length for\n// one or more files or stdin, with column-aligned output matching GNU wc.\n//\n// Implements: prd005-wc R1-R6\n// Architecture: docs/ARCHITECTURE.yaml § cmd/\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strings\"\n\t\"syscall\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n)\n\n// progName is the program name used in error diagnostics (R6.2).\nconst progName = \"wc\"\n\n// totalMode controls when the totals line is printed (R3.3).\ntype totalMode int\n\nconst (\n\ttotalAuto   totalMode = iota // print total when more than one file (default)\n\ttotalAlways                  // always print total, even for one file\n\ttotalOnly                    // print only the total line, not per-file lines\n\ttotalNever                   // never print total\n)\n\n// counts holds the accumulated counts for a single input source.\ntype counts struct {\n\tlines      int64\n\twords      int64\n\tbytes      int64\n\tchars      int64\n\tmaxLineLen int64\n}\n\n// add returns the element-wise sum of c and other.\nfunc (c counts) add(other counts) counts {\n\tc.lines += other.lines\n\tc.words += other.words\n\tc.bytes += other.bytes\n\tc.chars += other.chars\n\tif other.maxLineLen > c.maxLineLen {\n\t\tc.maxLineLen = other.maxLineLen\n\t}\n\treturn c\n}\n\n// wcConfig holds the resolved flag settings for a single wc invocation.\ntype wcConfig struct {\n\tprintLines   bool\n\tprintWords   bool\n\tprintBytes   bool\n\tprintChars   bool\n\tprintMaxLen  bool\n\ttotalMode    totalMode\n\tfiles0From   string // --files0-from=FILE; empty means not used\n}\n\nfunc main() {\n\t// R6.3 / R5.1 equivalent: SIGPIPE handler so piping to head exits cleanly.\n\tsigCh := make(chan os.Signal, 1)\n\tsignal.Notify(sigCh, syscall.SIGPIPE)\n\tgo func() {\n\t\t<-sigCh\n\t\tos.Exit(0)\n\t}()\n\n\tcfg, files := parseFlags()\n\n\texitCode := 0\n\tvar results []fileResult\n\n\tfor _, name := range files {\n\t\tc, err := countInput(name)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"%s: %s: %v\\n\", progName, name, sysErr(err))\n\t\t\texitCode = 1\n\t\t\t// R6.2: still record zero counts so total is correct for remaining files.\n\t\t\tresults = append(results, fileResult{name: name, counts: counts{}})\n\t\t\tcontinue\n\t\t}\n\t\tresults = append(results, fileResult{name: name, counts: c})\n\t}\n\n\t// Compute totals.\n\tvar total counts\n\tfor _, r := range results {\n\t\ttotal = total.add(r.counts)\n\t}\n\n\t// Determine column width from the largest count that will be printed.\n\twidth := numberWidth(total, cfg)\n\n\t// Print per-file lines unless --total=only.\n\tif cfg.totalMode != totalOnly {\n\t\tfor _, r := range results {\n\t\t\tprintCounts(r.counts, r.name, width, cfg)\n\t\t}\n\t}\n\n\t// Print total line per R3.3.\n\tshowTotal := false\n\tswitch cfg.totalMode {\n\tcase totalAuto:\n\t\tshowTotal = len(files) > 1\n\tcase totalAlways:\n\t\tshowTotal = true\n\tcase totalOnly:\n\t\tshowTotal = true\n\tcase totalNever:\n\t\tshowTotal = false\n\t}\n\tif showTotal {\n\t\tprintCounts(total, \"total\", width, cfg)\n\t}\n\n\tos.Exit(exitCode)\n}\n\n// fileResult pairs a filename with its counts.\ntype fileResult struct {\n\tname   string\n\tcounts counts\n}\n\n// parseFlags parses command-line arguments manually to support GNU-style long\n// flags (--total=VALUE, --files0-from=FILE) alongside single-character flags.\n// Go's flag package does not support --key=value syntax natively, so we parse\n// by hand to match GNU wc flag behavior.\nfunc parseFlags() (wcConfig, []string) {\n\tcfg := wcConfig{}\n\tvar files []string\n\texplicitFlags := false\n\n\targs := os.Args[1:]\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\n\t\t// \"--\" terminates flag parsing.\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\n\t\t// Long flags.\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tif strings.HasPrefix(arg, \"--total=\") {\n\t\t\t\tval := arg[len(\"--total=\"):]\n\t\t\t\tswitch val {\n\t\t\t\tcase \"auto\":\n\t\t\t\t\tcfg.totalMode = totalAuto\n\t\t\t\tcase \"always\":\n\t\t\t\t\tcfg.totalMode = totalAlways\n\t\t\t\tcase \"only\":\n\t\t\t\t\tcfg.totalMode = totalOnly\n\t\t\t\tcase \"never\":\n\t\t\t\t\tcfg.totalMode = totalNever\n\t\t\t\tdefault:\n\t\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: invalid argument '%s' for '--total'\\n\", progName, val)\n\t\t\t\t\tos.Exit(1)\n\t\t\t\t}\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif strings.HasPrefix(arg, \"--files0-from=\") {\n\t\t\t\tcfg.files0From = arg[len(\"--files0-from=\"):]\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// Long flag aliases.\n\t\t\tswitch arg {\n\t\t\tcase \"--lines\":\n\t\t\t\tcfg.printLines = true\n\t\t\t\texplicitFlags = true\n\t\t\tcase \"--words\":\n\t\t\t\tcfg.printWords = true\n\t\t\t\texplicitFlags = true\n\t\t\tcase \"--bytes\":\n\t\t\t\tcfg.printBytes = true\n\t\t\t\texplicitFlags = true\n\t\t\tcase \"--chars\":\n\t\t\t\tcfg.printChars = true\n\t\t\t\texplicitFlags = true\n\t\t\tcase \"--max-line-length\":\n\t\t\t\tcfg.printMaxLen = true\n\t\t\t\texplicitFlags = true\n\t\t\tdefault:\n\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: unrecognized option '%s'\\n\", progName, arg)\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\t// Short flags (may be combined: -lwc).\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tfor _, ch := range arg[1:] {\n\t\t\t\tswitch ch {\n\t\t\t\tcase 'l':\n\t\t\t\t\tcfg.printLines = true\n\t\t\t\t\texplicitFlags = true\n\t\t\t\tcase 'w':\n\t\t\t\t\tcfg.printWords = true\n\t\t\t\t\texplicitFlags = true\n\t\t\t\tcase 'c':\n\t\t\t\t\tcfg.printBytes = true\n\t\t\t\t\texplicitFlags = true\n\t\t\t\tcase 'm':\n\t\t\t\t\tcfg.printChars = true\n\t\t\t\t\texplicitFlags = true\n\t\t\t\tcase 'L':\n\t\t\t\t\tcfg.printMaxLen = true\n\t\t\t\t\texplicitFlags = true\n\t\t\t\tdefault:\n\t\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: invalid option -- '%c'\\n\", progName, ch)\n\t\t\t\t\tos.Exit(1)\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\t// Not a flag — it's a filename.\n\t\tfiles = append(files, arg)\n\t}\n\n\t// R1.1: when no flags are given, default to lines + words + bytes.\n\tif !explicitFlags {\n\t\tcfg.printLines = true\n\t\tcfg.printWords = true\n\t\tcfg.printBytes = true\n\t}\n\n\t// R2.3: -m takes precedence over -c when both are given.\n\tif cfg.printChars && cfg.printBytes {\n\t\tcfg.printBytes = false\n\t}\n\n\t// Handle --files0-from (R4.4).\n\tif cfg.files0From != \"\" {\n\t\tf0files, err := readFiles0From(cfg.files0From)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"%s: %v\\n\", progName, err)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tfiles = append(files, f0files...)\n\t}\n\n\t// R1.2: when no file arguments, read from stdin.\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\treturn cfg, files\n}\n\n// readFiles0From reads NUL-delimited filenames from the given path.\n// When path is \"-\", filenames are read from stdin (R4.4).\nfunc readFiles0From(path string) ([]string, error) {\n\tvar r io.Reader\n\tif path == \"-\" {\n\t\tr = os.Stdin\n\t} else {\n\t\tf, err := os.Open(path)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"cannot open '%s' for reading: %w\", path, sysErr(err))\n\t\t}\n\t\tdefer func() { _ = f.Close() }() // best-effort cleanup\n\t\tr = f\n\t}\n\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"reading files0-from: %w\", err)\n\t}\n\n\tvar files []string\n\tfor _, name := range strings.Split(string(data), \"\\x00\") {\n\t\tif name != \"\" {\n\t\t\tfiles = append(files, name)\n\t\t}\n\t}\n\treturn files, nil\n}\n\n// countInput reads an input source and returns its counts.\n// When name is \"-\", stdin is read (R4.1).\nfunc countInput(name string) (counts, error) {\n\tvar r io.Reader\n\tif name == \"-\" {\n\t\tr = os.Stdin\n\t} else {\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\treturn counts{}, err\n\t\t}\n\t\tdefer func() { _ = f.Close() }() // best-effort cleanup\n\t\tr = f\n\t}\n\treturn countReader(r)\n}\n\n// countReader counts lines, words, bytes, characters, and max line length\n// from r in a single pass. A word is a maximal sequence of non-whitespace\n// characters (R2.2). Line length is measured with tab expansion to the next\n// multiple of 8 (R2.5).\nfunc countReader(r io.Reader) (counts, error) {\n\tvar c counts\n\tbr := bufio.NewReader(r)\n\tinWord := false\n\tvar lineLen int64\n\n\tfor {\n\t\tbuf := make([]byte, 32*1024)\n\t\tn, err := br.Read(buf)\n\t\tbuf = buf[:n]\n\t\tc.bytes += int64(n)\n\n\t\ti := 0\n\t\tfor i < len(buf) {\n\t\t\tru, size := utf8.DecodeRune(buf[i:])\n\t\t\tif ru == utf8.RuneError && size == 1 {\n\t\t\t\t// R2.4: invalid byte counts as one character.\n\t\t\t\tc.chars++\n\t\t\t\tif inWord {\n\t\t\t\t\t// Invalid byte is not whitespace; stay in word.\n\t\t\t\t} else {\n\t\t\t\t\tinWord = true\n\t\t\t\t\tc.words++\n\t\t\t\t}\n\t\t\t\tlineLen++\n\t\t\t\ti++\n\t\t\t\tcontinue\n\t\t\t}\n\n\t\t\tc.chars++\n\n\t\t\tif ru == '\\n' {\n\t\t\t\tc.lines++\n\t\t\t\tif inWord {\n\t\t\t\t\tinWord = false\n\t\t\t\t}\n\t\t\t\t// R2.5: end of line — check max.\n\t\t\t\tif lineLen > c.maxLineLen {\n\t\t\t\t\tc.maxLineLen = lineLen\n\t\t\t\t}\n\t\t\t\tlineLen = 0\n\t\t\t} else if ru == '\\t' {\n\t\t\t\t// R2.5: tab advances to next multiple of 8.\n\t\t\t\tlineLen = (lineLen/8 + 1) * 8\n\t\t\t\tif inWord {\n\t\t\t\t\tinWord = false\n\t\t\t\t}\n\t\t\t} else if unicode.IsSpace(ru) {\n\t\t\t\tif inWord {\n\t\t\t\t\tinWord = false\n\t\t\t\t}\n\t\t\t\tlineLen++\n\t\t\t} else {\n\t\t\t\tif !inWord {\n\t\t\t\t\tinWord = true\n\t\t\t\t\tc.words++\n\t\t\t\t}\n\t\t\t\tlineLen++\n\t\t\t}\n\n\t\t\ti += size\n\t\t}\n\n\t\tif err == io.EOF {\n\t\t\tbreak\n\t\t}\n\t\tif err != nil {\n\t\t\treturn c, err\n\t\t}\n\t}\n\n\t// R2.5: handle last line if it didn't end with newline.\n\tif lineLen > c.maxLineLen {\n\t\tc.maxLineLen = lineLen\n\t}\n\n\treturn c, nil\n}\n\n// numberWidth returns the minimum field width for printing counts.\n// It is the number of decimal digits in the largest count that will be printed,\n// matching GNU wc's dynamic column-width behavior (R3.1).\nfunc numberWidth(total counts, cfg wcConfig) int {\n\tmaxVal := int64(0)\n\tif cfg.printLines && total.lines > maxVal {\n\t\tmaxVal = total.lines\n\t}\n\tif cfg.printWords && total.words > maxVal {\n\t\tmaxVal = total.words\n\t}\n\tif cfg.printBytes && total.bytes > maxVal {\n\t\tmaxVal = total.bytes\n\t}\n\tif cfg.printChars && total.chars > maxVal {\n\t\tmaxVal = total.chars\n\t}\n\tif cfg.printMaxLen && total.maxLineLen > maxVal {\n\t\tmaxVal = total.maxLineLen\n\t}\n\tw := 1\n\tfor maxVal >= 10 {\n\t\tmaxVal /= 10\n\t\tw++\n\t}\n\treturn w\n}\n\n// printCounts writes one output line with the requested counts and filename.\n// Counts are right-justified to width columns (R3.1). The filename is omitted\n// when name is \"-\" and it's the only input (stdin with no filename) (R1.3).\nfunc printCounts(c counts, name string, width int, cfg wcConfig) {\n\tvar parts []string\n\n\tif cfg.printLines {\n\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.lines))\n\t}\n\tif cfg.printWords {\n\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.words))\n\t}\n\tif cfg.printChars {\n\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.chars))\n\t}\n\tif cfg.printBytes {\n\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.bytes))\n\t}\n\tif cfg.printMaxLen {\n\t\tparts = append(parts, fmt.Sprintf(\"%*d\", width, c.maxLineLen))\n\t}\n\n\tline := strings.Join(parts, \" \")\n\n\t// R1.3: append filename unless stdin with no explicit \"-\" argument.\n\tif name == \"-\" {\n\t\tfmt.Println(line)\n\t} else {\n\t\tfmt.Printf(\"%s %s\\n\", line, name)\n\t}\n}\n\n// sysErr extracts the underlying system error from an os.PathError for\n// cleaner diagnostic messages matching GNU wc format.\nfunc sysErr(err error) error {\n\tif pe, ok := err.(*os.PathError); ok { //nolint:errorlint\n\t\treturn pe.Err\n\t}\n\treturn err\n}\n","numLines":460,"startLine":1,"totalLines":460}}}
