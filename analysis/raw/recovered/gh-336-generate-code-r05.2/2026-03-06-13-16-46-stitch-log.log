 cut_field_multiple\n    description: \"-d: -f1,3 extracts fields 1 and 3.\"\n    inputs:\n      args: [\"-d:\", \"-f1,3\"]\n      stdin: \"a:b:c\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a:c\\n\"\n      stderr: \"\"\n    traces:\n      - prd026-cut R2.1\n\n  - name: cut_suppress_no_delimiter\n    description: -s suppresses lines that contain no delimiter.\n    inputs:\n      args: [\"-d:\", \"-f2\", \"-s\"]\n      stdin: \"no-delimiter\\na:b\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"b\\n\"\n      stderr: \"\"\n    traces:\n      - prd026-cut R2.3\n\n  - name: cut_no_delimiter_passthrough\n    description: Without -s, lines with no delimiter are printed unchanged.\n    inputs:\n      args: [\"-d:\", \"-f2\"]\n      stdin: \"no-delimiter\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"no-delimiter\\n\"\n      stderr: \"\"\n    traces:\n      - prd026-cut R2.3\n\n  - name: cut_output_delimiter\n    description: \"--output-delimiter uses a different separator in the output.\"\n    inputs:\n      args: [\"-d:\", \"-f1,3\", \"--output-delimiter=|\"]\n      stdin: \"a:b:c\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a|c\\n\"\n      stderr: \"\"\n    traces:\n      - prd026-cut R2.4\n\n  - name: cut_complement\n    description: \"--complement with -f inverts the field selection.\"\n    inputs:\n      args: [\"-d:\", \"--complement\", \"-f2\"]\n      stdin: \"a:b:c\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a:c\\n\"\n      stderr: \"\"\n    traces:\n      - prd026-cut R3.1\n\n  # ---- paste ----\n\n  - name: paste_two_files_default\n    description: \"Two files merged with tab delimiter. Setup: file1 has 'a\\\\nb\\\\n', file2 has '1\\\\n2\\\\n'.\"\n    in