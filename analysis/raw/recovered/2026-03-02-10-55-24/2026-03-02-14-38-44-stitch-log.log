{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SjbGrobtUToutgBn9i4pbz","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Differential tests for cmd/du comparing Go binary against GNU gdu reference.\n     5→//\n     6→// Implements: prd009-du R1, R2, R3, R4, R5\n     7→// Traces: test-rel01.3, rel01.3-uc001-du\n     8→package main\n     9→\n    10→import (\n    11→\t\"fmt\"\n    12→\t\"os\"\n    13→\t\"os/exec\"\n    14→\t\"path/filepath\"\n    15→\t\"testing\"\n    16→\n    17→\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n    18→)\n    19→\n    20→// goBinaryPath is the path to the compiled Go du binary.\n    21→var goBinaryPath string\n    22→\n    23→// refBinaryPath is the path to the GNU reference binary (gdu).\n    24→var refBinaryPath string\n    25→\n    26→func TestMain(m *testing.M) {\n    27→\t// Locate GNU reference binary.\n    28→\tref, err := exec.LookPath(\"gdu\")\n    29→\tif err != nil {\n    30→\t\tfmt.Println(\"gdu not found; skipping du differential tests\")\n    31→\t\tos.Exit(0)\n    32→\t}\n    33→\trefBinaryPath = ref\n    34→\n    35→\t// Build the Go du binary to a temp directory.\n    36→\ttmpDir, err := os.MkdirTemp(\"\", \"du-test-*\")\n    37→\tif err != nil {\n    38→\t\tpanic(\"creating temp dir: \" + err.Error())\n    39→\t}\n    40→\n    41→\tgoBinaryPath = filepath.Join(tmpDir, \"du\")\n    42→\tcmd := exec.Command(\"go\", \"build\", \"-o\", goBinaryPath, \".\")\n    43→\tcmd.Dir = filepath.Join(\".\")\n    44→\tif out, err := cmd.CombinedOutput(); err != nil {\n    45→\t\tos.RemoveAll(tmpDir)\n    46→\t\tpanic(fmt.Sprintf(\"building du binary: %v\\n%s\", err, out))\n    47→\t}\n    48→\n    49→\tcode := m.Run()\n    50→\tos.RemoveAll(tmpDir) // best-effort cleanup\n    51→\tos.Exit(code)\n    52→}\n    53→\n    54→// writeFile creates a file with the given content in dir and returns the filename.\n    55→func writeFile(t *testing.T, dir, name, content string) string {\n    56→\tt.Helper()\n    57→\tpath := filepath.Join(dir, name)\n    58→\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n    59→\t\tt.Fatalf(\"writing test file %s: %v\", name, err)\n    60→\t}\n    61→\treturn name\n    62→}\n    63→\n    64→// makeFixtureTree creates a nested directory tree for du tests:\n    65→//\n    66→//\troot/\n    67→//\t  subdir1/\n    68→//\t    file1.txt (1024 bytes)\n    69→//\t  subdir2/\n    70→//\t    file2.txt (2048 bytes)\n    71→//\t    nested/\n    72→//\t      file3.txt (512 bytes)\n    73→func makeFixtureTree(t *testing.T) string {\n    74→\tt.Helper()\n    75→\troot := t.TempDir()\n    76→\n    77→\tsubdir1 := filepath.Join(root, \"subdir1\")\n    78→\tsubdir2 := filepath.Join(root, \"subdir2\")\n    79→\tnested := filepath.Join(subdir2, \"nested\")\n    80→\n    81→\tfor _, d := range []string{subdir1, subdir2, nested} {\n    82→\t\tif err := os.Mkdir(d, 0o755); err != nil {\n    83→\t\t\tt.Fatalf(\"creating directory %s: %v\", d, err)\n    84→\t\t}\n    85→\t}\n    86→\n    87→\tif err := os.WriteFile(filepath.Join(subdir1, \"file1.txt\"), make([]byte, 1024), 0o644); err != nil {\n    88→\t\tt.Fatalf(\"writing file1.txt: %v\", err)\n    89→\t}\n    90→\tif err := os.WriteFile(filepath.Join(subdir2, \"file2.txt\"), make([]byte, 2048), 0o644); err != nil {\n    91→\t\tt.Fatalf(\"writing file2.txt: %v\", err)\n    92→\t}\n    93→\tif err := os.WriteFile(filepath.Join(nested, \"file3.txt\"), make([]byte, 512), 0o644); err != nil {\n    94→\t\tt.Fatalf(\"writing file3.txt: %v\", err)\n    95→\t}\n    96→\n    97→\treturn root\n    98→}\n    99→\n   100→// --- Default traversal (prd009-du R1.1, R1.3, R1.4, R1.5) ---\n   101→\n   102→func TestDefault_Recursive(t *testing.T) {\n   103→\troot := makeFixtureTree(t)\n   104→\n   105→\ttests := []testutils.DiffTest{\n   106→\t\t{\n   107→\t\t\tName:    \"default-recursive\",\n   108→\t\t\tArgs:    []string{\"-k\", root},\n   109→\t\t\tWorkDir: root,\n   110→\t\t},\n   111→\t}\n   112→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   113→}\n   114→\n   115→func TestDefault_MultipleArgs(t *testing.T) {\n   116→\troot := makeFixtureTree(t)\n   117→\tsubdir1 := filepath.Join(root, \"subdir1\")\n   118→\tsubdir2 := filepath.Join(root, \"subdir2\")\n   119→\n   120→\ttests := []testutils.DiffTest{\n   121→\t\t{\n   122→\t\t\tName:    \"multiple-args-in-order\",\n   123→\t\t\tArgs:    []string{\"-k\", subdir1, subdir2},\n   124→\t\t\tWorkDir: root,\n   125→\t\t},\n   126→\t}\n   127→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   128→}\n   129→\n   130→func TestDefault_EmptyDirectory(t *testing.T) {\n   131→\tdir := t.TempDir()\n   132→\temptyDir := filepath.Join(dir, \"empty\")\n   133→\tif err := os.Mkdir(emptyDir, 0o755); err != nil {\n   134→\t\tt.Fatalf(\"creating empty dir: %v\", err)\n   135→\t}\n   136→\n   137→\ttests := []testutils.DiffTest{\n   138→\t\t{\n   139→\t\t\tName:    \"empty-directory\",\n   140→\t\t\tArgs:    []string{\"-k\", emptyDir},\n   141→\t\t\tWorkDir: dir,\n   142→\t\t},\n   143→\t}\n   144→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   145→}\n   146→\n   147→// --- Non-directory argument (prd009-du R1.5) ---\n   148→\n   149→func TestDefault_NonDirectoryArg(t *testing.T) {\n   150→\tdir := t.TempDir()\n   151→\tif err := os.WriteFile(filepath.Join(dir, \"single.txt\"), make([]byte, 4096), 0o644); err != nil {\n   152→\t\tt.Fatalf(\"writing single.txt: %v\", err)\n   153→\t}\n   154→\n   155→\ttests := []testutils.DiffTest{\n   156→\t\t{\n   157→\t\t\tName:    \"non-directory-argument\",\n   158→\t\t\tArgs:    []string{\"-k\", filepath.Join(dir, \"single.txt\")},\n   159→\t\t\tWorkDir: dir,\n   160→\t\t},\n   161→\t}\n   162→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   163→}\n   164→\n   165→// --- Human-readable -h (prd009-du R2.1) ---\n   166→\n   167→func TestFlag_HumanReadable(t *testing.T) {\n   168→\troot := makeFixtureTree(t)\n   169→\n   170→\ttests := []testutils.DiffTest{\n   171→\t\t{\n   172→\t\t\tName:    \"human-readable\",\n   173→\t\t\tArgs:    []string{\"-h\", root},\n   174→\t\t\tWorkDir: root,\n   175→\t\t},\n   176→\t}\n   177→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   178→}\n   179→\n   180→// --- Summarize -s (prd009-du R2.2) ---\n   181→\n   182→func TestFlag_Summarize(t *testing.T) {\n   183→\troot := makeFixtureTree(t)\n   184→\n   185→\ttests := []testutils.DiffTest{\n   186→\t\t{\n   187→\t\t\tName:    \"summarize\",\n   188→\t\t\tArgs:    []string{\"-sk\", root},\n   189→\t\t\tWorkDir: root,\n   190→\t\t},\n   191→\t}\n   192→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   193→}\n   194→\n   195→// --- All files -a (prd009-du R2.3) ---\n   196→\n   197→func TestFlag_AllFiles(t *testing.T) {\n   198→\troot := makeFixtureTree(t)\n   199→\n   200→\ttests := []testutils.DiffTest{\n   201→\t\t{\n   202→\t\t\tName:    \"all-files\",\n   203→\t\t\tArgs:    []string{\"-ak\", root},\n   204→\t\t\tWorkDir: root,\n   205→\t\t},\n   206→\t}\n   207→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   208→}\n   209→\n   210→// --- Depth limiting -d (prd009-du R2.4) ---\n   211→\n   212→func TestFlag_MaxDepth(t *testing.T) {\n   213→\troot := makeFixtureTree(t)\n   214→\n   215→\ttests := []testutils.DiffTest{\n   216→\t\t{\n   217→\t\t\tName:    \"max-depth-0\",\n   218→\t\t\tArgs:    []string{\"-k\", \"-d\", \"0\", root},\n   219→\t\t\tWorkDir: root,\n   220→\t\t},\n   221→\t\t{\n   222→\t\t\tName:    \"max-depth-1\",\n   223→\t\t\tArgs:    []string{\"-k\", \"-d\", \"1\", root},\n   224→\t\t\tWorkDir: root,\n   225→\t\t},\n   226→\t}\n   227→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   228→}\n   229→\n   230→// --- Kilobyte units -k (prd009-du R2.5) ---\n   231→\n   232→func TestFlag_Kilobyte(t *testing.T) {\n   233→\troot := makeFixtureTree(t)\n   234→\n   235→\ttests := []testutils.DiffTest{\n   236→\t\t{\n   237→\t\t\tName:    \"kilobyte-flag\",\n   238→\t\t\tArgs:    []string{\"-k\", root},\n   239→\t\t\tWorkDir: root,\n   240→\t\t},\n   241→\t}\n   242→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   243→}\n   244→\n   245→// --- Megabyte units -m (prd009-du R2.6) ---\n   246→\n   247→func TestFlag_Megabyte(t *testing.T) {\n   248→\troot := makeFixtureTree(t)\n   249→\n   250→\ttests := []testutils.DiffTest{\n   251→\t\t{\n   252→\t\t\tName:    \"megabyte-flag\",\n   253→\t\t\tArgs:    []string{\"-m\", root},\n   254→\t\t\tWorkDir: root,\n   255→\t\t},\n   256→\t}\n   257→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   258→}\n   259→\n   260→// --- Grand total -c (prd009-du R2.7) ---\n   261→\n   262→func TestFlag_GrandTotal(t *testing.T) {\n   263→\troot := makeFixtureTree(t)\n   264→\tsubdir1 := filepath.Join(root, \"subdir1\")\n   265→\tsubdir2 := filepath.Join(root, \"subdir2\")\n   266→\n   267→\ttests := []testutils.DiffTest{\n   268→\t\t{\n   269→\t\t\tName:    \"grand-total\",\n   270→\t\t\tArgs:    []string{\"-ck\", subdir1, subdir2},\n   271→\t\t\tWorkDir: root,\n   272→\t\t},\n   273→\t}\n   274→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   275→}\n   276→\n   277→// --- Apparent size --apparent-size (prd009-du R2.8) ---\n   278→\n   279→func TestFlag_ApparentSize(t *testing.T) {\n   280→\troot := makeFixtureTree(t)\n   281→\n   282→\ttests := []testutils.DiffTest{\n   283→\t\t{\n   284→\t\t\tName:    \"apparent-size\",\n   285→\t\t\tArgs:    []string{\"--apparent-size\", \"-k\", root},\n   286→\t\t\tWorkDir: root,\n   287→\t\t},\n   288→\t}\n   289→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   290→}\n   291→\n   292→// --- Byte mode -b (prd009-du R2.8) ---\n   293→\n   294→func TestFlag_ByteMode(t *testing.T) {\n   295→\troot := makeFixtureTree(t)\n   296→\n   297→\ttests := []testutils.DiffTest{\n   298→\t\t{\n   299→\t\t\tName:    \"byte-mode\",\n   300→\t\t\tArgs:    []string{\"-b\", root},\n   301→\t\t\tWorkDir: root,\n   302→\t\t},\n   303→\t}\n   304→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   305→}\n   306→\n   307→// --- Hard-link deduplication (prd009-du R3.1, R3.2, R3.3) ---\n   308→\n   309→func TestHardLink_Dedup(t *testing.T) {\n   310→\troot := t.TempDir()\n   311→\tdirA := filepath.Join(root, \"dir_a\")\n   312→\tdirB := filepath.Join(root, \"dir_b\")\n   313→\n   314→\tif err := os.Mkdir(dirA, 0o755); err != nil {\n   315→\t\tt.Fatalf(\"creating dir_a: %v\", err)\n   316→\t}\n   317→\tif err := os.Mkdir(dirB, 0o755); err != nil {\n   318→\t\tt.Fatalf(\"creating dir_b: %v\", err)\n   319→\t}\n   320→\n   321→\t// Create original file and hard link it into a second directory.\n   322→\torigPath := filepath.Join(dirA, \"shared.txt\")\n   323→\tif err := os.WriteFile(origPath, make([]byte, 4096), 0o644); err != nil {\n   324→\t\tt.Fatalf(\"writing shared.txt: %v\", err)\n   325→\t}\n   326→\tlinkPath := filepath.Join(dirB, \"shared.txt\")\n   327→\tif err := os.Link(origPath, linkPath); err != nil {\n   328→\t\tt.Skipf(\"os.Link not supported: %v\", err)\n   329→\t}\n   330→\n   331→\ttests := []testutils.DiffTest{\n   332→\t\t{\n   333→\t\t\tName:    \"hardlink-dedup\",\n   334→\t\t\tArgs:    []string{\"-ak\", root},\n   335→\t\t\tWorkDir: root,\n   336→\t\t},\n   337→\t}\n   338→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   339→}\n   340→\n   341→// --- Error handling: missing path (prd009-du R4.2) ---\n   342→\n   343→func TestError_MissingPath(t *testing.T) {\n   344→\tdir := t.TempDir()\n   345→\n   346→\ttests := []testutils.DiffTest{\n   347→\t\t{\n   348→\t\t\tName:    \"missing-path\",\n   349→\t\t\tArgs:    []string{\"-k\", filepath.Join(dir, \"nonexistent_dir\")},\n   350→\t\t\tWorkDir: dir,\n   351→\t\t},\n   352→\t}\n   353→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   354→}\n   355→\n   356→// --- Error handling: mixed valid and invalid paths (prd009-du R4.2) ---\n   357→\n   358→func TestError_MixedValidInvalid(t *testing.T) {\n   359→\troot := makeFixtureTree(t)\n   360→\n   361→\ttests := []testutils.DiffTest{\n   362→\t\t{\n   363→\t\t\tName:    \"mixed-valid-invalid\",\n   364→\t\t\tArgs:    []string{\"-k\", filepath.Join(root, \"nonexistent\"), filepath.Join(root, \"subdir1\")},\n   365→\t\t\tWorkDir: root,\n   366→\t\t},\n   367→\t}\n   368→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   369→}\n   370→\n   371→// --- Combined flags (prd009-du R2.1, R2.7) ---\n   372→\n   373→func TestFlag_Combined_HC(t *testing.T) {\n   374→\troot := makeFixtureTree(t)\n   375→\tsubdir1 := filepath.Join(root, \"subdir1\")\n   376→\tsubdir2 := filepath.Join(root, \"subdir2\")\n   377→\n   378→\ttests := []testutils.DiffTest{\n   379→\t\t{\n   380→\t\t\tName:    \"combined-h-c\",\n   381→\t\t\tArgs:    []string{\"-h\", \"-c\", subdir1, subdir2},\n   382→\t\t\tWorkDir: root,\n   383→\t\t},\n   384→\t}\n   385→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   386→}\n   387→\n   388→// --- Combined -a with -d (prd009-du R2.3, R2.4) ---\n   389→\n   390→func TestFlag_Combined_AD(t *testing.T) {\n   391→\troot := makeFixtureTree(t)\n   392→\n   393→\ttests := []testutils.DiffTest{\n   394→\t\t{\n   395→\t\t\tName:    \"combined-a-d1\",\n   396→\t\t\tArgs:    []string{\"-ak\", \"-d\", \"1\", root},\n   397→\t\t\tWorkDir: root,\n   398→\t\t},\n   399→\t}\n   400→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   401→}\n   402→"}]},"parent_tool_use_id":null,"session_id":"d5f090b0-510a-426e-a107-172e2443796c","uuid":"76418d08-b186-405e-a1ed-ef9e70b2660f","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/137/cmd/du/du_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Differential tests for cmd/du comparing Go binary against GNU gdu reference.\n//\n// Implements: prd009-du R1, R2, R3, R4, R5\n// Traces: test-rel01.3, rel01.3-uc001-du\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\n// goBinaryPath is the path to the compiled Go du binary.\nvar goBinaryPath string\n\n// refBinaryPath is the path to the GNU reference binary (gdu).\nvar refBinaryPath string\n\nfunc TestMain(m *testing.M) {\n\t// Locate GNU reference binary.\n\tref, err := exec.LookPath(\"gdu\")\n\tif err != nil {\n\t\tfmt.Println(\"gdu not found; skipping du differential tests\")\n\t\tos.Exit(0)\n\t}\n\trefBinaryPath = ref\n\n\t// Build the Go du binary to a temp directory.\n\ttmpDir, err := os.MkdirTemp(\"\", \"du-test-*\")\n\tif err != nil {\n\t\tpanic(\"creating temp dir: \" + err.Error())\n\t}\n\n\tgoBinaryPath = filepath.Join(tmpDir, \"du\")\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", goBinaryPath, \".\")\n\tcmd.Dir = filepath.Join(\".\")\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tos.RemoveAll(tmpDir)\n\t\tpanic(fmt.Sprintf(\"building du binary: %v\\n%s\", err, out))\n\t}\n\n\tcode := m.Run()\n\tos.RemoveAll(tmpDir) // best-effort cleanup\n\tos.Exit(code)\n}\n\n// writeFile creates a file with the given content in dir and returns the filename.\nfunc writeFile(t *testing.T, dir, name, content string) string {\n\tt.Helper()\n\tpath := filepath.Join(dir, name)\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tt.Fatalf(\"writing test file %s: %v\", name, err)\n\t}\n\treturn name\n}\n\n// makeFixtureTree creates a nested directory tree for du tests:\n//\n//\troot/\n//\t  subdir1/\n//\t    file1.txt (1024 bytes)\n//\t  subdir2/\n//\t    file2.txt (2048 bytes)\n//\t    nested/\n//\t      file3.txt (512 bytes)\nfunc makeFixtureTree(t *testing.T) string {\n\tt.Helper()\n\troot := t.TempDir()\n\n\tsubdir1 := filepath.Join(root, \"subdir1\")\n\tsubdir2 := filepath.Join(root, \"subdir2\")\n\tnested := filepath.Join(subdir2, \"nested\")\n\n\tfor _, d := range []string{subdir1, subdir2, nested} {\n\t\tif err := os.Mkdir(d, 0o755); err != nil {\n\t\t\tt.Fatalf(\"creating directory %s: %v\", d, err)\n\t\t}\n\t}\n\n\tif err := os.WriteFile(filepath.Join(subdir1, \"file1.txt\"), make([]byte, 1024), 0o644); err != nil {\n\t\tt.Fatalf(\"writing file1.txt: %v\", err)\n\t}\n\tif err := os.WriteFile(filepath.Join(subdir2, \"file2.txt\"), make([]byte, 2048), 0o644); err != nil {\n\t\tt.Fatalf(\"writing file2.txt: %v\", err)\n\t}\n\tif err := os.WriteFile(filepath.Join(nested, \"file3.txt\"), make([]byte, 512), 0o644); err != nil {\n\t\tt.Fatalf(\"writing file3.txt: %v\", err)\n\t}\n\n\treturn root\n}\n\n// --- Default traversal (prd009-du R1.1, R1.3, R1.4, R1.5) ---\n\nfunc TestDefault_Recursive(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"default-recursive\",\n\t\t\tArgs:    []string{\"-k\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\nfunc TestDefault_MultipleArgs(t *testing.T) {\n\troot := makeFixtureTree(t)\n\tsubdir1 := filepath.Join(root, \"subdir1\")\n\tsubdir2 := filepath.Join(root, \"subdir2\")\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"multiple-args-in-order\",\n\t\t\tArgs:    []string{\"-k\", subdir1, subdir2},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\nfunc TestDefault_EmptyDirectory(t *testing.T) {\n\tdir := t.TempDir()\n\temptyDir := filepath.Join(dir, \"empty\")\n\tif err := os.Mkdir(emptyDir, 0o755); err != nil {\n\t\tt.Fatalf(\"creating empty dir: %v\", err)\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"empty-directory\",\n\t\t\tArgs:    []string{\"-k\", emptyDir},\n\t\t\tWorkDir: dir,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Non-directory argument (prd009-du R1.5) ---\n\nfunc TestDefault_NonDirectoryArg(t *testing.T) {\n\tdir := t.TempDir()\n\tif err := os.WriteFile(filepath.Join(dir, \"single.txt\"), make([]byte, 4096), 0o644); err != nil {\n\t\tt.Fatalf(\"writing single.txt: %v\", err)\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"non-directory-argument\",\n\t\t\tArgs:    []string{\"-k\", filepath.Join(dir, \"single.txt\")},\n\t\t\tWorkDir: dir,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Human-readable -h (prd009-du R2.1) ---\n\nfunc TestFlag_HumanReadable(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"human-readable\",\n\t\t\tArgs:    []string{\"-h\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Summarize -s (prd009-du R2.2) ---\n\nfunc TestFlag_Summarize(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"summarize\",\n\t\t\tArgs:    []string{\"-sk\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- All files -a (prd009-du R2.3) ---\n\nfunc TestFlag_AllFiles(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"all-files\",\n\t\t\tArgs:    []string{\"-ak\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Depth limiting -d (prd009-du R2.4) ---\n\nfunc TestFlag_MaxDepth(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"max-depth-0\",\n\t\t\tArgs:    []string{\"-k\", \"-d\", \"0\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t\t{\n\t\t\tName:    \"max-depth-1\",\n\t\t\tArgs:    []string{\"-k\", \"-d\", \"1\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Kilobyte units -k (prd009-du R2.5) ---\n\nfunc TestFlag_Kilobyte(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"kilobyte-flag\",\n\t\t\tArgs:    []string{\"-k\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Megabyte units -m (prd009-du R2.6) ---\n\nfunc TestFlag_Megabyte(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"megabyte-flag\",\n\t\t\tArgs:    []string{\"-m\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Grand total -c (prd009-du R2.7) ---\n\nfunc TestFlag_GrandTotal(t *testing.T) {\n\troot := makeFixtureTree(t)\n\tsubdir1 := filepath.Join(root, \"subdir1\")\n\tsubdir2 := filepath.Join(root, \"subdir2\")\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"grand-total\",\n\t\t\tArgs:    []string{\"-ck\", subdir1, subdir2},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Apparent size --apparent-size (prd009-du R2.8) ---\n\nfunc TestFlag_ApparentSize(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"apparent-size\",\n\t\t\tArgs:    []string{\"--apparent-size\", \"-k\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Byte mode -b (prd009-du R2.8) ---\n\nfunc TestFlag_ByteMode(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"byte-mode\",\n\t\t\tArgs:    []string{\"-b\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Hard-link deduplication (prd009-du R3.1, R3.2, R3.3) ---\n\nfunc TestHardLink_Dedup(t *testing.T) {\n\troot := t.TempDir()\n\tdirA := filepath.Join(root, \"dir_a\")\n\tdirB := filepath.Join(root, \"dir_b\")\n\n\tif err := os.Mkdir(dirA, 0o755); err != nil {\n\t\tt.Fatalf(\"creating dir_a: %v\", err)\n\t}\n\tif err := os.Mkdir(dirB, 0o755); err != nil {\n\t\tt.Fatalf(\"creating dir_b: %v\", err)\n\t}\n\n\t// Create original file and hard link it into a second directory.\n\torigPath := filepath.Join(dirA, \"shared.txt\")\n\tif err := os.WriteFile(origPath, make([]byte, 4096), 0o644); err != nil {\n\t\tt.Fatalf(\"writing shared.txt: %v\", err)\n\t}\n\tlinkPath := filepath.Join(dirB, \"shared.txt\")\n\tif err := os.Link(origPath, linkPath); err != nil {\n\t\tt.Skipf(\"os.Link not supported: %v\", err)\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"hardlink-dedup\",\n\t\t\tArgs:    []string{\"-ak\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Error handling: missing path (prd009-du R4.2) ---\n\nfunc TestError_MissingPath(t *testing.T) {\n\tdir := t.TempDir()\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"missing-path\",\n\t\t\tArgs:    []string{\"-k\", filepath.Join(dir, \"nonexistent_dir\")},\n\t\t\tWorkDir: dir,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Error handling: mixed valid and invalid paths (prd009-du R4.2) ---\n\nfunc TestError_MixedValidInvalid(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"mixed-valid-invalid\",\n\t\t\tArgs:    []string{\"-k\", filepath.Join(root, \"nonexistent\"), filepath.Join(root, \"subdir1\")},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Combined flags (prd009-du R2.1, R2.7) ---\n\nfunc TestFlag_Combined_HC(t *testing.T) {\n\troot := makeFixtureTree(t)\n\tsubdir1 := filepath.Join(root, \"subdir1\")\n\tsubdir2 := filepath.Join(root, \"subdir2\")\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"combined-h-c\",\n\t\t\tArgs:    []string{\"-h\", \"-c\", subdir1, subdir2},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- Combined -a with -d (prd009-du R2.3, R2.4) ---\n\nfunc TestFlag_Combined_AD(t *testing.T) {\n\troot := makeFixtureTree(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:    \"combined-a-d1\",\n\t\t\tArgs:    []string{\"-ak\", \"-d\", \"1\", root},\n\t\t\tWorkDir: root,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n","numLines":402,"startLine":1,"totalLines":402}}}
