     Add a writeFile helper (same signature as cmd/wc/wc_test.go) and a\n          mkdirAll helper that creates subdirectories within the test temp dir.\n          Use known file content sizes (e.g., 4096 bytes) to produce predictable\n          block allocations.\n\n    acceptance_criteria:\n      - id: AC1\n        text: cmd/du/du_test.go compiles with \"go build ./cmd/du/\"\n      - id: AC2\n        text: \"go test ./cmd/du/ passes when gdu is available on PATH\"\n      - id: AC3\n        text: |\n          Test file contains at least 8 DiffTest cases covering: default traversal,\n          -s, -h, -b, -c, -a flags, and nonexistent path error\n      - id: AC4\n        text: |\n          File header includes copyright, SPDX license, package main declaration,\n          Implements comment referencing prd009-du, and Traces comment referencing\n          test-rel01.3 and rel01.3-uc001-du\n```","stop_reason":null,"session_id":"28f2da05-f954-4c15-bec7-cf50ae8af60a","total_cost_usd":0.7008622499999999,"usage":{"input_tokens":2,"cache_creation_input_tokens":79917,"cache_read_input_tokens":19292,"output_tokens":7669,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":79917,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"modelUsage":{"claude-opus-4-6":{"inputTokens":2,"outputTokens":7669,"cacheReadInputTokens":19292,"cacheCreationInputTokens":79917,"webSearchRequests":0,"costUSD":0.7008622499999999,"contextWindow":200000,"maxOutputTokens":32000}},"permission_denials":[],"uuid":"d5876973-8bd7-45fb-b9c0-0d9d84e1a1c5"}
