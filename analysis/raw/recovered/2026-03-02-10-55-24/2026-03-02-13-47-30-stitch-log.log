{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017KFVfRxVXAJ4zaNcfLMYWW","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package format provides output formatting shared across utilities including\n     5→// column alignment, ANSI color output, and human-readable size conversion.\n     6→//\n     7→// Implements prd003-format (R1, R2, R3).\n     8→package format\n     9→\n    10→import \"fmt\"\n    11→\n    12→// HumanSizeOpts configures human-readable size formatting.\n    13→type HumanSizeOpts struct {\n    14→\t// Binary selects the unit base. true uses 1024-based units with suffixes\n    15→\t// K, M, G, T, P, E. false uses SI 1000-based units with suffixes\n    16→\t// kB, MB, GB, TB.\n    17→\tBinary bool\n    18→}\n    19→\n    20→var (\n    21→\tbinarySuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n    22→\tsiSuffixes     = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n    23→)\n    24→\n    25→// HumanSize converts a byte count to a human-readable string matching GNU\n    26→// coreutils human_readable() behavior. Values below the first unit threshold\n    27→// are returned as plain integers. Values at or above a unit threshold are\n    28→// formatted with one decimal place when under 10, or zero decimal places\n    29→// otherwise. Zero always returns \"0\".\n    30→//\n    31→// prd003-format R3.\n    32→func HumanSize(bytes int64, opts HumanSizeOpts) string {\n    33→\tif bytes == 0 {\n    34→\t\treturn \"0\"\n    35→\t}\n    36→\n    37→\tbase := 1000.0\n    38→\tsuffixes := siSuffixes\n    39→\tif opts.Binary {\n    40→\t\tbase = 1024.0\n    41→\t\tsuffixes = binarySuffixes\n    42→\t}\n    43→\n    44→\tval := float64(bytes)\n    45→\tfor i := 0; i < len(suffixes)-1; i++ {\n    46→\t\tif val < base {\n    47→\t\t\tif i == 0 {\n    48→\t\t\t\treturn fmt.Sprintf(\"%d\", bytes)\n    49→\t\t\t}\n    50→\t\t\treturn formatWithSuffix(val, suffixes[i])\n    51→\t\t}\n    52→\t\tval /= base\n    53→\t}\n    54→\treturn formatWithSuffix(val, suffixes[len(suffixes)-1])\n    55→}\n    56→\n    57→// formatWithSuffix formats a scaled value with its unit suffix. Uses one\n    58→// decimal place for values under 10, no decimal place otherwise.\n    59→func formatWithSuffix(val float64, suffix string) string {\n    60→\tif val < 10 {\n    61→\t\treturn fmt.Sprintf(\"%.1f%s\", val, suffix)\n    62→\t}\n    63→\treturn fmt.Sprintf(\"%.0f%s\", val, suffix)\n    64→}\n    65→"}]},"parent_tool_use_id":null,"session_id":"42bb9627-c016-4ec5-b3b3-3f0638943305","uuid":"f8cc436d-89c8-4817-86bb-db748885e9e3","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/121/pkg/format/size.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package format provides output formatting shared across utilities including\n// column alignment, ANSI color output, and human-readable size conversion.\n//\n// Implements prd003-format (R1, R2, R3).\npackage format\n\nimport \"fmt\"\n\n// HumanSizeOpts configures human-readable size formatting.\ntype HumanSizeOpts struct {\n\t// Binary selects the unit base. true uses 1024-based units with suffixes\n\t// K, M, G, T, P, E. false uses SI 1000-based units with suffixes\n\t// kB, MB, GB, TB.\n\tBinary bool\n}\n\nvar (\n\tbinarySuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\tsiSuffixes     = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n)\n\n// HumanSize converts a byte count to a human-readable string matching GNU\n// coreutils human_readable() behavior. Values below the first unit threshold\n// are returned as plain integers. Values at or above a unit threshold are\n// formatted with one decimal place when under 10, or zero decimal places\n// otherwise. Zero always returns \"0\".\n//\n// prd003-format R3.\nfunc HumanSize(bytes int64, opts HumanSizeOpts) string {\n\tif bytes == 0 {\n\t\treturn \"0\"\n\t}\n\n\tbase := 1000.0\n\tsuffixes := siSuffixes\n\tif opts.Binary {\n\t\tbase = 1024.0\n\t\tsuffixes = binarySuffixes\n\t}\n\n\tval := float64(bytes)\n\tfor i := 0; i < len(suffixes)-1; i++ {\n\t\tif val < base {\n\t\t\tif i == 0 {\n\t\t\t\treturn fmt.Sprintf(\"%d\", bytes)\n\t\t\t}\n\t\t\treturn formatWithSuffix(val, suffixes[i])\n\t\t}\n\t\tval /= base\n\t}\n\treturn formatWithSuffix(val, suffixes[len(suffixes)-1])\n}\n\n// formatWithSuffix formats a scaled value with its unit suffix. Uses one\n// decimal place for values under 10, no decimal place otherwise.\nfunc formatWithSuffix(val float64, suffix string) string {\n\tif val < 10 {\n\t\treturn fmt.Sprintf(\"%.1f%s\", val, suffix)\n\t}\n\treturn fmt.Sprintf(\"%.0f%s\", val, suffix)\n}\n","numLines":65,"startLine":1,"totalLines":65}}}
