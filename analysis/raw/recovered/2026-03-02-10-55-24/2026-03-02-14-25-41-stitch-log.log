{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FdKegaoNpnT22iXKGWC23w","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package main implements the sponge command, which reads all of standard input\n     5→// before writing to a named file, enabling safe pipelines like \"cmd file | sponge file\".\n     6→//\n     7→// Implements: prd007-sponge R1, R2, R3, R4, R5\n     8→package main\n     9→\n    10→import (\n    11→\t\"flag\"\n    12→\t\"fmt\"\n    13→\t\"io\"\n    14→\t\"os\"\n    15→\t\"os/signal\"\n    16→\t\"path/filepath\"\n    17→\t\"syscall\"\n    18→)\n    19→\n    20→// initialBufSize is the starting buffer capacity, matching sponge.c BUFF_SIZE.\n    21→//\n    22→// Implements: prd007-sponge R1.2\n    23→const initialBufSize = 8192\n    24→\n    25→// spillThreshold is the in-memory buffer size beyond which stdin content is\n    26→// spilled to a temporary file. This approximates the reference implementation's\n    27→// physmem_available() check using a fixed fraction of typical available memory.\n    28→//\n    29→// Implements: prd007-sponge R1.3\n    30→const spillThreshold = 256 * 1024 * 1024\n    31→\n    32→func main() {\n    33→\tos.Exit(run(os.Args[1:]))\n    34→}\n    35→\n    36→// run parses flags and executes the sponge operation. Returns 0 on success,\n    37→// 1 on error.\n    38→//\n    39→// Implements: prd007-sponge R1, R2, R3, R4, R5\n    40→func run(args []string) int {\n    41→\tfs := flag.NewFlagSet(\"sponge\", flag.ContinueOnError)\n    42→\tfs.SetOutput(os.Stderr)\n    43→\n    44→\tflagAppend := fs.Bool(\"a\", false, \"append to the output file\")\n    45→\n    46→\tif err := fs.Parse(args); err != nil {\n    47→\t\treturn 1\n    48→\t}\n    49→\n    50→\tfiles := fs.Args()\n    51→\tvar outFile string\n    52→\tif len(files) > 0 {\n    53→\t\toutFile = files[0]\n    54→\t}\n    55→\n    56→\t// Read all stdin before touching the output file (R1.1).\n    57→\tbuf, spillPath, err := readAllStdin()\n    58→\tif err != nil {\n    59→\t\tprintError(err)\n    60→\t\tcleanupSpill(spillPath)\n    61→\t\treturn 1\n    62→\t}\n    63→\n    64→\t// Register signal-based cleanup for spill temp file (R1.5).\n    65→\tif spillPath != \"\" {\n    66→\t\tinstallCleanupHandler(spillPath)\n    67→\t\tdefer cleanupSpill(spillPath)\n    68→\t}\n    69→\n    70→\t// Passthrough mode: no output filename (R4.1).\n    71→\tif outFile == \"\" {\n    72→\t\tif err := writeToStdout(buf, spillPath); err != nil {\n    73→\t\t\tprintError(err)\n    74→\t\t\treturn 1\n    75→\t\t}\n    76→\t\treturn 0\n    77→\t}\n    78→\n    79→\t// Write to named output file (R2, R3).\n    80→\tif err := writeToFile(outFile, buf, spillPath, *flagAppend); err != nil {\n    81→\t\tprintError(err)\n    82→\t\treturn 1\n    83→\t}\n    84→\n    85→\treturn 0\n    86→}\n    87→\n    88→// readAllStdin reads all of stdin into memory or a temporary file.\n    89→// Returns (data, \"\", nil) when stdin fits in memory, or (nil, tempPath, nil)\n    90→// when stdin was spilled to a temp file.\n    91→//\n    92→// Implements: prd007-sponge R1.1, R1.2, R1.3, R1.4\n    93→func readAllStdin() ([]byte, string, error) {\n    94→\tbuf := make([]byte, 0, initialBufSize)\n    95→\tchunk := make([]byte, initialBufSize)\n    96→\n    97→\tfor {\n    98→\t\tn, err := os.Stdin.Read(chunk)\n    99→\t\tif n > 0 {\n   100→\t\t\tbuf = append(buf, chunk[:n]...)\n   101→\t\t}\n   102→\t\tif err == io.EOF {\n   103→\t\t\treturn buf, \"\", nil\n   104→\t\t}\n   105→\t\tif err != nil {\n   106→\t\t\treturn nil, \"\", fmt.Errorf(\"read error: %v\", err)\n   107→\t\t}\n   108→\n   109→\t\t// Spill to temp file when threshold exceeded (R1.3).\n   110→\t\tif len(buf) >= spillThreshold {\n   111→\t\t\tspillPath, spillErr := spillToTempFile(buf)\n   112→\t\t\tif spillErr != nil {\n   113→\t\t\t\treturn nil, \"\", spillErr\n   114→\t\t\t}\n   115→\t\t\t// Continue reading remaining stdin directly to temp file.\n   116→\t\t\tif appendErr := appendStdinToFile(spillPath); appendErr != nil {\n   117→\t\t\t\treturn nil, spillPath, appendErr\n   118→\t\t\t}\n   119→\t\t\treturn nil, spillPath, nil\n   120→\t\t}\n   121→\t}\n   122→}\n   123→\n   124→// spillToTempFile writes the current in-memory buffer to a temp file in\n   125→// TMPDIR (or /tmp) and returns the temp file path.\n   126→//\n   127→// Implements: prd007-sponge R1.3, R1.4\n   128→func spillToTempFile(buf []byte) (string, error) {\n   129→\ttmpDir := os.Getenv(\"TMPDIR\")\n   130→\tif tmpDir == \"\" {\n   131→\t\ttmpDir = \"/tmp\"\n   132→\t}\n   133→\n   134→\tf, err := os.CreateTemp(tmpDir, \"sponge.\")\n   135→\tif err != nil {\n   136→\t\treturn \"\", fmt.Errorf(\"creating temp file: %v\", err)\n   137→\t}\n   138→\tname := f.Name()\n   139→\n   140→\tif _, err := f.Write(buf); err != nil {\n   141→\t\tf.Close()\n   142→\t\treturn name, fmt.Errorf(\"writing temp file: %v\", err)\n   143→\t}\n   144→\n   145→\tif err := f.Close(); err != nil {\n   146→\t\treturn name, fmt.Errorf(\"closing temp file: %v\", err)\n   147→\t}\n   148→\n   149→\treturn name, nil\n   150→}\n   151→\n   152→// appendStdinToFile reads remaining stdin and appends it to the given file.\n   153→func appendStdinToFile(path string) error {\n   154→\tf, err := os.OpenFile(path, os.O_WRONLY|os.O_APPEND, 0)\n   155→\tif err != nil {\n   156→\t\treturn fmt.Errorf(\"opening temp file for append: %v\", err)\n   157→\t}\n   158→\tdefer f.Close()\n   159→\n   160→\tif _, err := io.Copy(f, os.Stdin); err != nil {\n   161→\t\treturn fmt.Errorf(\"writing to temp file: %v\", err)\n   162→\t}\n   163→\n   164→\treturn nil\n   165→}\n   166→\n   167→// writeToStdout writes the buffered stdin content to stdout.\n   168→//\n   169→// Implements: prd007-sponge R4.1, R4.2, R4.3\n   170→func writeToStdout(buf []byte, spillPath string) error {\n   171→\tif buf != nil {\n   172→\t\t// In-memory buffer (R4.3).\n   173→\t\tif _, err := os.Stdout.Write(buf); err != nil {\n   174→\t\t\treturn fmt.Errorf(\"write error: %v\", err)\n   175→\t\t}\n   176→\t\treturn nil\n   177→\t}\n   178→\n   179→\t// Spilled to temp file (R4.2).\n   180→\tf, err := os.Open(spillPath)\n   181→\tif err != nil {\n   182→\t\treturn fmt.Errorf(\"opening temp file: %v\", err)\n   183→\t}\n   184→\tdefer f.Close()\n   185→\n   186→\tif _, err := io.Copy(os.Stdout, f); err != nil {\n   187→\t\treturn fmt.Errorf(\"write error: %v\", err)\n   188→\t}\n   189→\n   190→\treturn nil\n   191→}\n   192→\n   193→// writeToFile writes buffered stdin content to the named output file,\n   194→// using atomic rename with cross-device fallback and permission preservation.\n   195→//\n   196→// Implements: prd007-sponge R2, R3\n   197→func writeToFile(outFile string, buf []byte, spillPath string, appendMode bool) error {\n   198→\t// Check existing file permissions via lstat (R2.3, R2.4).\n   199→\tvar mode os.FileMode = 0666\n   200→\tinfo, err := os.Lstat(outFile)\n   201→\tif err == nil && info.Mode().IsRegular() {\n   202→\t\tmode = info.Mode().Perm()\n   203→\t}\n   204→\n   205→\t// Create temp file in same directory as target for atomic rename (R2.1).\n   206→\tdir := filepath.Dir(outFile)\n   207→\tif dir == \"\" {\n   208→\t\tdir = \".\"\n   209→\t}\n   210→\ttmpOut, err := os.CreateTemp(dir, \".sponge-tmp-\")\n   211→\tif err != nil {\n   212→\t\treturn fmt.Errorf(\"%s: %v\", outFile, err)\n   213→\t}\n   214→\ttmpOutPath := tmpOut.Name()\n   215→\tsuccess := false\n   216→\tdefer func() {\n   217→\t\tif !success {\n   218→\t\t\tos.Remove(tmpOutPath) // best-effort cleanup on failure\n   219→\t\t}\n   220→\t}()\n   221→\n   222→\t// In append mode, prepend existing file content (R3.1, R3.3).\n   223→\tif appendMode {\n   224→\t\tif err := prependExistingContent(tmpOut, outFile); err != nil {\n   225→\t\t\ttmpOut.Close()\n   226→\t\t\treturn err\n   227→\t\t}\n   228→\t}\n   229→\n   230→\t// Write stdin content to temp file.\n   231→\tif err := writeStdinContent(tmpOut, buf, spillPath); err != nil {\n   232→\t\ttmpOut.Close()\n   233→\t\treturn err\n   234→\t}\n   235→\n   236→\tif err := tmpOut.Close(); err != nil {\n   237→\t\treturn fmt.Errorf(\"closing temp file: %v\", err)\n   238→\t}\n   239→\n   240→\t// Set permissions before rename (R2.3).\n   241→\tif err := os.Chmod(tmpOutPath, mode); err != nil {\n   242→\t\treturn fmt.Errorf(\"setting permissions: %v\", err)\n   243→\t}\n   244→\n   245→\t// Atomic rename (R2.1).\n   246→\tif err := os.Rename(tmpOutPath, outFile); err != nil {\n   247→\t\t// Cross-device fallback (R2.2).\n   248→\t\tif copyErr := copyFile(tmpOutPath, outFile, mode); copyErr != nil {\n   249→\t\t\treturn copyErr\n   250→\t\t}\n   251→\t\tos.Remove(tmpOutPath) // clean up temp after successful copy\n   252→\t}\n   253→\n   254→\tsuccess = true\n   255→\treturn nil\n   256→}\n   257→\n   258→// prependExistingContent copies the existing content of outFile into dst.\n   259→// If outFile does not exist, this is a no-op (R3.2).\n   260→//\n   261→// Implements: prd007-sponge R3.1, R3.3\n   262→func prependExistingContent(dst *os.File, outFile string) error {\n   263→\tsrc, err := os.Open(outFile)\n   264→\tif err != nil {\n   265→\t\tif os.IsNotExist(err) {\n   266→\t\t\treturn nil // R3.2: non-existent file, behave as default mode.\n   267→\t\t}\n   268→\t\treturn fmt.Errorf(\"%s: %v\", outFile, err)\n   269→\t}\n   270→\tdefer src.Close()\n   271→\n   272→\tif _, err := io.Copy(dst, src); err != nil {\n   273→\t\treturn fmt.Errorf(\"reading %s: %v\", outFile, err)\n   274→\t}\n   275→\n   276→\treturn nil\n   277→}\n   278→\n   279→// writeStdinContent writes the buffered stdin content to dst, reading from\n   280→// either the in-memory buffer or the spill temp file.\n   281→func writeStdinContent(dst *os.File, buf []byte, spillPath string) error {\n   282→\tif buf != nil {\n   283→\t\tif _, err := dst.Write(buf); err != nil {\n   284→\t\t\treturn fmt.Errorf(\"writing output: %v\", err)\n   285→\t\t}\n   286→\t\treturn nil\n   287→\t}\n   288→\n   289→\tif spillPath == \"\" {\n   290→\t\treturn nil\n   291→\t}\n   292→\n   293→\tsrc, err := os.Open(spillPath)\n   294→\tif err != nil {\n   295→\t\treturn fmt.Errorf(\"opening temp file: %v\", err)\n   296→\t}\n   297→\tdefer src.Close()\n   298→\n   299→\tif _, err := io.Copy(dst, src); err != nil {\n   300→\t\treturn fmt.Errorf(\"writing output: %v\", err)\n   301→\t}\n   302→\n   303→\treturn nil\n   304→}\n   305→\n   306→// copyFile copies src to dst with the given file mode. Used as fallback\n   307→// when atomic rename fails due to cross-device move.\n   308→//\n   309→// Implements: prd007-sponge R2.2\n   310→func copyFile(src, dst string, mode os.FileMode) error {\n   311→\tin, err := os.Open(src)\n   312→\tif err != nil {\n   313→\t\treturn fmt.Errorf(\"opening source: %v\", err)\n   314→\t}\n   315→\tdefer in.Close()\n   316→\n   317→\tout, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n   318→\tif err != nil {\n   319→\t\treturn fmt.Errorf(\"%s: %v\", dst, err)\n   320→\t}\n   321→\n   322→\tif _, err := io.Copy(out, in); err != nil {\n   323→\t\tout.Close()\n   324→\t\treturn fmt.Errorf(\"writing %s: %v\", dst, err)\n   325→\t}\n   326→\n   327→\tif err := out.Close(); err != nil {\n   328→\t\treturn fmt.Errorf(\"closing %s: %v\", dst, err)\n   329→\t}\n   330→\n   331→\treturn nil\n   332→}\n   333→\n   334→// installCleanupHandler registers signal handlers that delete the temp file\n   335→// before exiting. Handles SIGINT, SIGTERM, SIGHUP, and SIGPIPE.\n   336→//\n   337→// Implements: prd007-sponge R1.5\n   338→func installCleanupHandler(tmpPath string) {\n   339→\tc := make(chan os.Signal, 1)\n   340→\tsignal.Notify(c, syscall.SIGINT, syscall.SIGTERM, syscall.SIGHUP, syscall.SIGPIPE)\n   341→\tgo func() {\n   342→\t\t<-c\n   343→\t\tos.Remove(tmpPath) // best-effort cleanup\n   344→\t\tos.Exit(1)\n   345→\t}()\n   346→}\n   347→\n   348→// cleanupSpill removes the spill temp file if it exists.\n   349→//\n   350→// Implements: prd007-sponge R5.4\n   351→func cleanupSpill(path string) {\n   352→\tif path != \"\" {\n   353→\t\tos.Remove(path) // best-effort; file may already be renamed or deleted\n   354→\t}\n   355→}\n   356→\n   357→// printError writes an error message to stderr in the format \"sponge: <description>\".\n   358→//\n   359→// Implements: prd007-sponge R5.2\n   360→func printError(err error) {\n   361→\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n   362→}\n   363→"}]},"parent_tool_use_id":null,"session_id":"d21f8c7e-2c67-4416-ab87-bc43899a6f6f","uuid":"0c70a6e5-f4b4-4819-8cae-e9eb7044397f","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/132/cmd/sponge/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements the sponge command, which reads all of standard input\n// before writing to a named file, enabling safe pipelines like \"cmd file | sponge file\".\n//\n// Implements: prd007-sponge R1, R2, R3, R4, R5\npackage main\n\nimport (\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"syscall\"\n)\n\n// initialBufSize is the starting buffer capacity, matching sponge.c BUFF_SIZE.\n//\n// Implements: prd007-sponge R1.2\nconst initialBufSize = 8192\n\n// spillThreshold is the in-memory buffer size beyond which stdin content is\n// spilled to a temporary file. This approximates the reference implementation's\n// physmem_available() check using a fixed fraction of typical available memory.\n//\n// Implements: prd007-sponge R1.3\nconst spillThreshold = 256 * 1024 * 1024\n\nfunc main() {\n\tos.Exit(run(os.Args[1:]))\n}\n\n// run parses flags and executes the sponge operation. Returns 0 on success,\n// 1 on error.\n//\n// Implements: prd007-sponge R1, R2, R3, R4, R5\nfunc run(args []string) int {\n\tfs := flag.NewFlagSet(\"sponge\", flag.ContinueOnError)\n\tfs.SetOutput(os.Stderr)\n\n\tflagAppend := fs.Bool(\"a\", false, \"append to the output file\")\n\n\tif err := fs.Parse(args); err != nil {\n\t\treturn 1\n\t}\n\n\tfiles := fs.Args()\n\tvar outFile string\n\tif len(files) > 0 {\n\t\toutFile = files[0]\n\t}\n\n\t// Read all stdin before touching the output file (R1.1).\n\tbuf, spillPath, err := readAllStdin()\n\tif err != nil {\n\t\tprintError(err)\n\t\tcleanupSpill(spillPath)\n\t\treturn 1\n\t}\n\n\t// Register signal-based cleanup for spill temp file (R1.5).\n\tif spillPath != \"\" {\n\t\tinstallCleanupHandler(spillPath)\n\t\tdefer cleanupSpill(spillPath)\n\t}\n\n\t// Passthrough mode: no output filename (R4.1).\n\tif outFile == \"\" {\n\t\tif err := writeToStdout(buf, spillPath); err != nil {\n\t\t\tprintError(err)\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n\n\t// Write to named output file (R2, R3).\n\tif err := writeToFile(outFile, buf, spillPath, *flagAppend); err != nil {\n\t\tprintError(err)\n\t\treturn 1\n\t}\n\n\treturn 0\n}\n\n// readAllStdin reads all of stdin into memory or a temporary file.\n// Returns (data, \"\", nil) when stdin fits in memory, or (nil, tempPath, nil)\n// when stdin was spilled to a temp file.\n//\n// Implements: prd007-sponge R1.1, R1.2, R1.3, R1.4\nfunc readAllStdin() ([]byte, string, error) {\n\tbuf := make([]byte, 0, initialBufSize)\n\tchunk := make([]byte, initialBufSize)\n\n\tfor {\n\t\tn, err := os.Stdin.Read(chunk)\n\t\tif n > 0 {\n\t\t\tbuf = append(buf, chunk[:n]...)\n\t\t}\n\t\tif err == io.EOF {\n\t\t\treturn buf, \"\", nil\n\t\t}\n\t\tif err != nil {\n\t\t\treturn nil, \"\", fmt.Errorf(\"read error: %v\", err)\n\t\t}\n\n\t\t// Spill to temp file when threshold exceeded (R1.3).\n\t\tif len(buf) >= spillThreshold {\n\t\t\tspillPath, spillErr := spillToTempFile(buf)\n\t\t\tif spillErr != nil {\n\t\t\t\treturn nil, \"\", spillErr\n\t\t\t}\n\t\t\t// Continue reading remaining stdin directly to temp file.\n\t\t\tif appendErr := appendStdinToFile(spillPath); appendErr != nil {\n\t\t\t\treturn nil, spillPath, appendErr\n\t\t\t}\n\t\t\treturn nil, spillPath, nil\n\t\t}\n\t}\n}\n\n// spillToTempFile writes the current in-memory buffer to a temp file in\n// TMPDIR (or /tmp) and returns the temp file path.\n//\n// Implements: prd007-sponge R1.3, R1.4\nfunc spillToTempFile(buf []byte) (string, error) {\n\ttmpDir := os.Getenv(\"TMPDIR\")\n\tif tmpDir == \"\" {\n\t\ttmpDir = \"/tmp\"\n\t}\n\n\tf, err := os.CreateTemp(tmpDir, \"sponge.\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"creating temp file: %v\", err)\n\t}\n\tname := f.Name()\n\n\tif _, err := f.Write(buf); err != nil {\n\t\tf.Close()\n\t\treturn name, fmt.Errorf(\"writing temp file: %v\", err)\n\t}\n\n\tif err := f.Close(); err != nil {\n\t\treturn name, fmt.Errorf(\"closing temp file: %v\", err)\n\t}\n\n\treturn name, nil\n}\n\n// appendStdinToFile reads remaining stdin and appends it to the given file.\nfunc appendStdinToFile(path string) error {\n\tf, err := os.OpenFile(path, os.O_WRONLY|os.O_APPEND, 0)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"opening temp file for append: %v\", err)\n\t}\n\tdefer f.Close()\n\n\tif _, err := io.Copy(f, os.Stdin); err != nil {\n\t\treturn fmt.Errorf(\"writing to temp file: %v\", err)\n\t}\n\n\treturn nil\n}\n\n// writeToStdout writes the buffered stdin content to stdout.\n//\n// Implements: prd007-sponge R4.1, R4.2, R4.3\nfunc writeToStdout(buf []byte, spillPath string) error {\n\tif buf != nil {\n\t\t// In-memory buffer (R4.3).\n\t\tif _, err := os.Stdout.Write(buf); err != nil {\n\t\t\treturn fmt.Errorf(\"write error: %v\", err)\n\t\t}\n\t\treturn nil\n\t}\n\n\t// Spilled to temp file (R4.2).\n\tf, err := os.Open(spillPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"opening temp file: %v\", err)\n\t}\n\tdefer f.Close()\n\n\tif _, err := io.Copy(os.Stdout, f); err != nil {\n\t\treturn fmt.Errorf(\"write error: %v\", err)\n\t}\n\n\treturn nil\n}\n\n// writeToFile writes buffered stdin content to the named output file,\n// using atomic rename with cross-device fallback and permission preservation.\n//\n// Implements: prd007-sponge R2, R3\nfunc writeToFile(outFile string, buf []byte, spillPath string, appendMode bool) error {\n\t// Check existing file permissions via lstat (R2.3, R2.4).\n\tvar mode os.FileMode = 0666\n\tinfo, err := os.Lstat(outFile)\n\tif err == nil && info.Mode().IsRegular() {\n\t\tmode = info.Mode().Perm()\n\t}\n\n\t// Create temp file in same directory as target for atomic rename (R2.1).\n\tdir := filepath.Dir(outFile)\n\tif dir == \"\" {\n\t\tdir = \".\"\n\t}\n\ttmpOut, err := os.CreateTemp(dir, \".sponge-tmp-\")\n\tif err != nil {\n\t\treturn fmt.Errorf(\"%s: %v\", outFile, err)\n\t}\n\ttmpOutPath := tmpOut.Name()\n\tsuccess := false\n\tdefer func() {\n\t\tif !success {\n\t\t\tos.Remove(tmpOutPath) // best-effort cleanup on failure\n\t\t}\n\t}()\n\n\t// In append mode, prepend existing file content (R3.1, R3.3).\n\tif appendMode {\n\t\tif err := prependExistingContent(tmpOut, outFile); err != nil {\n\t\t\ttmpOut.Close()\n\t\t\treturn err\n\t\t}\n\t}\n\n\t// Write stdin content to temp file.\n\tif err := writeStdinContent(tmpOut, buf, spillPath); err != nil {\n\t\ttmpOut.Close()\n\t\treturn err\n\t}\n\n\tif err := tmpOut.Close(); err != nil {\n\t\treturn fmt.Errorf(\"closing temp file: %v\", err)\n\t}\n\n\t// Set permissions before rename (R2.3).\n\tif err := os.Chmod(tmpOutPath, mode); err != nil {\n\t\treturn fmt.Errorf(\"setting permissions: %v\", err)\n\t}\n\n\t// Atomic rename (R2.1).\n\tif err := os.Rename(tmpOutPath, outFile); err != nil {\n\t\t// Cross-device fallback (R2.2).\n\t\tif copyErr := copyFile(tmpOutPath, outFile, mode); copyErr != nil {\n\t\t\treturn copyErr\n\t\t}\n\t\tos.Remove(tmpOutPath) // clean up temp after successful copy\n\t}\n\n\tsuccess = true\n\treturn nil\n}\n\n// prependExistingContent copies the existing content of outFile into dst.\n// If outFile does not exist, this is a no-op (R3.2).\n//\n// Implements: prd007-sponge R3.1, R3.3\nfunc prependExistingContent(dst *os.File, outFile string) error {\n\tsrc, err := os.Open(outFile)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn nil // R3.2: non-existent file, behave as default mode.\n\t\t}\n\t\treturn fmt.Errorf(\"%s: %v\", outFile, err)\n\t}\n\tdefer src.Close()\n\n\tif _, err := io.Copy(dst, src); err != nil {\n\t\treturn fmt.Errorf(\"reading %s: %v\", outFile, err)\n\t}\n\n\treturn nil\n}\n\n// writeStdinContent writes the buffered stdin content to dst, reading from\n// either the in-memory buffer or the spill temp file.\nfunc writeStdinContent(dst *os.File, buf []byte, spillPath string) error {\n\tif buf != nil {\n\t\tif _, err := dst.Write(buf); err != nil {\n\t\t\treturn fmt.Errorf(\"writing output: %v\", err)\n\t\t}\n\t\treturn nil\n\t}\n\n\tif spillPath == \"\" {\n\t\treturn nil\n\t}\n\n\tsrc, err := os.Open(spillPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"opening temp file: %v\", err)\n\t}\n\tdefer src.Close()\n\n\tif _, err := io.Copy(dst, src); err != nil {\n\t\treturn fmt.Errorf(\"writing output: %v\", err)\n\t}\n\n\treturn nil\n}\n\n// copyFile copies src to dst with the given file mode. Used as fallback\n// when atomic rename fails due to cross-device move.\n//\n// Implements: prd007-sponge R2.2\nfunc copyFile(src, dst string, mode os.FileMode) error {\n\tin, err := os.Open(src)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"opening source: %v\", err)\n\t}\n\tdefer in.Close()\n\n\tout, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"%s: %v\", dst, err)\n\t}\n\n\tif _, err := io.Copy(out, in); err != nil {\n\t\tout.Close()\n\t\treturn fmt.Errorf(\"writing %s: %v\", dst, err)\n\t}\n\n\tif err := out.Close(); err != nil {\n\t\treturn fmt.Errorf(\"closing %s: %v\", dst, err)\n\t}\n\n\treturn nil\n}\n\n// installCleanupHandler registers signal handlers that delete the temp file\n// before exiting. Handles SIGINT, SIGTERM, SIGHUP, and SIGPIPE.\n//\n// Implements: prd007-sponge R1.5\nfunc installCleanupHandler(tmpPath string) {\n\tc := make(chan os.Signal, 1)\n\tsignal.Notify(c, syscall.SIGINT, syscall.SIGTERM, syscall.SIGHUP, syscall.SIGPIPE)\n\tgo func() {\n\t\t<-c\n\t\tos.Remove(tmpPath) // best-effort cleanup\n\t\tos.Exit(1)\n\t}()\n}\n\n// cleanupSpill removes the spill temp file if it exists.\n//\n// Implements: prd007-sponge R5.4\nfunc cleanupSpill(path string) {\n\tif path != \"\" {\n\t\tos.Remove(path) // best-effort; file may already be renamed or deleted\n\t}\n}\n\n// printError writes an error message to stderr in the format \"sponge: <description>\".\n//\n// Implements: prd007-sponge R5.2\nfunc printError(err error) {\n\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n}\n","numLines":363,"startLine":1,"totalLines":363}}}
