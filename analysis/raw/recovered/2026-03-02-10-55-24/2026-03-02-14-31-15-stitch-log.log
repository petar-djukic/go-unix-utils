{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Us4MNxUUGDqMCjkgnhznxd","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Differential tests for cmd/sponge comparing Go binary against moreutils\n     5→// reference sponge binary.\n     6→//\n     7→// Implements: prd007-sponge R1, R2, R3, R4, R5\n     8→// Traces: test-rel01.2, rel01.2-uc001-sponge\n     9→package main\n    10→\n    11→import (\n    12→\t\"bytes\"\n    13→\t\"context\"\n    14→\t\"fmt\"\n    15→\t\"os\"\n    16→\t\"os/exec\"\n    17→\t\"path/filepath\"\n    18→\t\"strings\"\n    19→\t\"testing\"\n    20→\t\"time\"\n    21→\n    22→\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n    23→)\n    24→\n    25→// goBinaryPath is the path to the compiled Go sponge binary.\n    26→var goBinaryPath string\n    27→\n    28→// refBinaryPath is the path to the moreutils reference binary (sponge).\n    29→var refBinaryPath string\n    30→\n    31→func TestMain(m *testing.M) {\n    32→\t// Locate moreutils reference binary (D1).\n    33→\tref, err := exec.LookPath(\"sponge\")\n    34→\tif err != nil {\n    35→\t\tfmt.Println(\"sponge not found; skipping sponge differential tests\")\n    36→\t\tos.Exit(0)\n    37→\t}\n    38→\trefBinaryPath = ref\n    39→\n    40→\t// Build the Go sponge binary to a temp directory.\n    41→\ttmpDir, err := os.MkdirTemp(\"\", \"sponge-test-*\")\n    42→\tif err != nil {\n    43→\t\tpanic(\"creating temp dir: \" + err.Error())\n    44→\t}\n    45→\n    46→\tgoBinaryPath = filepath.Join(tmpDir, \"sponge\")\n    47→\tcmd := exec.Command(\"go\", \"build\", \"-o\", goBinaryPath, \".\")\n    48→\tcmd.Dir = \".\"\n    49→\tif out, err := cmd.CombinedOutput(); err != nil {\n    50→\t\tos.RemoveAll(tmpDir)\n    51→\t\tpanic(fmt.Sprintf(\"building sponge binary: %v\\n%s\", err, out))\n    52→\t}\n    53→\n    54→\tcode := m.Run()\n    55→\tos.RemoveAll(tmpDir) // best-effort cleanup\n    56→\tos.Exit(code)\n    57→}\n    58→\n    59→// --- File-output differential test infrastructure (D3) ---\n    60→\n    61→// fileDiffTest defines a differential test case for file-output utilities\n    62→// where both binaries write to files rather than stdout.\n    63→type fileDiffTest struct {\n    64→\tName            string               // subtest name\n    65→\tArgs            []string             // command-line arguments\n    66→\tStdin           []byte               // stdin content\n    67→\tPreFiles        map[string]fileSetup // files to create before running each binary\n    68→\tCheckFiles      []string             // filenames to compare after running\n    69→\tSkipStderrMatch bool                 // skip exact stderr comparison for implementation-specific error messages\n    70→}\n    71→\n    72→// fileSetup describes a pre-existing file to create before running a binary.\n    73→type fileSetup struct {\n    74→\tContent []byte\n    75→\tMode    os.FileMode\n    76→}\n    77→\n    78→// binaryResult holds captured output from a single binary invocation.\n    79→type binaryResult struct {\n    80→\tStdout   []byte\n    81→\tStderr   []byte\n    82→\tExitCode int\n    83→}\n    84→\n    85→// fileDiffTimeout is the maximum duration each binary invocation may run.\n    86→const fileDiffTimeout = 10 * time.Second\n    87→\n    88→// runFileDiffTests runs each fileDiffTest as a named subtest.\n    89→func runFileDiffTests(t *testing.T, tests []fileDiffTest) {\n    90→\tt.Helper()\n    91→\tfor _, tc := range tests {\n    92→\t\tt.Run(tc.Name, func(t *testing.T) {\n    93→\t\t\tt.Helper()\n    94→\t\t\trunSingleFileDiffTest(t, tc)\n    95→\t\t})\n    96→\t}\n    97→}\n    98→\n    99→// runSingleFileDiffTest executes both binaries in separate directories with\n   100→// identical pre-conditions and compares output files, stderr, and exit code.\n   101→func runSingleFileDiffTest(t *testing.T, tc fileDiffTest) {\n   102→\tt.Helper()\n   103→\n   104→\trefDir := t.TempDir()\n   105→\tgoDir := t.TempDir()\n   106→\n   107→\t// Set up identical pre-existing files in both directories.\n   108→\tfor name, setup := range tc.PreFiles {\n   109→\t\tfor _, dir := range []string{refDir, goDir} {\n   110→\t\t\tpath := filepath.Join(dir, name)\n   111→\t\t\tif err := os.WriteFile(path, setup.Content, setup.Mode); err != nil {\n   112→\t\t\t\tt.Fatalf(\"writing pre-file %s: %v\", name, err)\n   113→\t\t\t}\n   114→\t\t}\n   115→\t}\n   116→\n   117→\tenv := buildTestEnv()\n   118→\n   119→\trefResult := execBinary(t, refBinaryPath, tc.Args, tc.Stdin, env, refDir)\n   120→\tgoResult := execBinary(t, goBinaryPath, tc.Args, tc.Stdin, env, goDir)\n   121→\n   122→\tfailed := false\n   123→\n   124→\t// Compare exit codes.\n   125→\tif refResult.ExitCode != goResult.ExitCode {\n   126→\t\tfailed = true\n   127→\t}\n   128→\n   129→\t// Compare stderr.\n   130→\tif !tc.SkipStderrMatch {\n   131→\t\tif !bytes.Equal(refResult.Stderr, goResult.Stderr) {\n   132→\t\t\tfailed = true\n   133→\t\t}\n   134→\t} else {\n   135→\t\t// For error tests, verify both produce stderr or both produce none.\n   136→\t\tif (len(refResult.Stderr) > 0) != (len(goResult.Stderr) > 0) {\n   137→\t\t\tfailed = true\n   138→\t\t}\n   139→\t}\n   140→\n   141→\t// Compare output files byte-for-byte.\n   142→\tfor _, name := range tc.CheckFiles {\n   143→\t\trefPath := filepath.Join(refDir, name)\n   144→\t\tgoPath := filepath.Join(goDir, name)\n   145→\n   146→\t\trefContent, refErr := os.ReadFile(refPath)\n   147→\t\tgoContent, goErr := os.ReadFile(goPath)\n   148→\n   149→\t\tif refErr != nil && goErr != nil {\n   150→\t\t\tcontinue // both failed to create the file — consistent\n   151→\t\t}\n   152→\t\tif (refErr != nil) != (goErr != nil) {\n   153→\t\t\tfailed = true\n   154→\t\t\tt.Errorf(\"file %s existence divergence: ref err=%v, go err=%v\", name, refErr, goErr)\n   155→\t\t\tcontinue\n   156→\t\t}\n   157→\t\tif !bytes.Equal(refContent, goContent) {\n   158→\t\t\tfailed = true\n   159→\t\t\tt.Errorf(\"file content divergence for %s\\nref: %q\\ngo:  %q\", name, refContent, goContent)\n   160→\t\t}\n   161→\t}\n   162→\n   163→\tif failed {\n   164→\t\tt.Errorf(\"divergence detected\\n\"+\n   165→\t\t\t\"args:       %v\\n\"+\n   166→\t\t\t\"ref stderr: %q\\n\"+\n   167→\t\t\t\"go  stderr: %q\\n\"+\n   168→\t\t\t\"ref exit:   %d\\n\"+\n   169→\t\t\t\"go  exit:   %d\",\n   170→\t\t\ttc.Args,\n   171→\t\t\trefResult.Stderr,\n   172→\t\t\tgoResult.Stderr,\n   173→\t\t\trefResult.ExitCode,\n   174→\t\t\tgoResult.ExitCode,\n   175→\t\t)\n   176→\t}\n   177→}\n   178→\n   179→// buildTestEnv constructs the environment for binary invocations with LC_ALL=C.\n   180→func buildTestEnv() []string {\n   181→\tenv := os.Environ()\n   182→\tfor i, e := range env {\n   183→\t\tif strings.HasPrefix(e, \"LC_ALL=\") {\n   184→\t\t\tenv[i] = \"LC_ALL=C\"\n   185→\t\t\treturn env\n   186→\t\t}\n   187→\t}\n   188→\treturn append(env, \"LC_ALL=C\")\n   189→}\n   190→\n   191→// execBinary runs a binary with the given arguments, stdin, environment, and\n   192→// working directory, capturing stdout, stderr, and exit code.\n   193→func execBinary(t *testing.T, binPath string, args []string, stdin []byte, env []string, workDir string) binaryResult {\n   194→\tt.Helper()\n   195→\n   196→\tctx, cancel := context.WithTimeout(context.Background(), fileDiffTimeout)\n   197→\tdefer cancel()\n   198→\n   199→\tcmd := exec.CommandContext(ctx, binPath, args...)\n   200→\tcmd.Env = env\n   201→\tcmd.Dir = workDir\n   202→\n   203→\tif stdin != nil {\n   204→\t\tcmd.Stdin = bytes.NewReader(stdin)\n   205→\t}\n   206→\n   207→\tvar stdout, stderr bytes.Buffer\n   208→\tcmd.Stdout = &stdout\n   209→\tcmd.Stderr = &stderr\n   210→\n   211→\terr := cmd.Run()\n   212→\n   213→\texitCode := 0\n   214→\tif err != nil {\n   215→\t\tif ctx.Err() == context.DeadlineExceeded {\n   216→\t\t\tt.Fatalf(\"binary %s timed out after %v\", binPath, fileDiffTimeout)\n   217→\t\t}\n   218→\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n   219→\t\t\texitCode = exitErr.ExitCode()\n   220→\t\t} else {\n   221→\t\t\tt.Fatalf(\"executing %s: %v\", binPath, err)\n   222→\t\t}\n   223→\t}\n   224→\n   225→\treturn binaryResult{\n   226→\t\tStdout:   stdout.Bytes(),\n   227→\t\tStderr:   stderr.Bytes(),\n   228→\t\tExitCode: exitCode,\n   229→\t}\n   230→}\n   231→\n   232→// --- Passthrough mode: no output filename (prd007-sponge R4) ---\n   233→\n   234→func TestPassthrough_Stdin(t *testing.T) {\n   235→\ttests := []testutils.DiffTest{\n   236→\t\t{\n   237→\t\t\tName:  \"passthrough-text\",\n   238→\t\t\tStdin: []byte(\"hello world\\n\"),\n   239→\t\t},\n   240→\t\t{\n   241→\t\t\tName:  \"passthrough-multiline\",\n   242→\t\t\tStdin: []byte(\"line one\\nline two\\nline three\\n\"),\n   243→\t\t},\n   244→\t}\n   245→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   246→}\n   247→\n   248→func TestPassthrough_EmptyStdin(t *testing.T) {\n   249→\ttests := []testutils.DiffTest{\n   250→\t\t{\n   251→\t\t\tName:  \"passthrough-empty\",\n   252→\t\t\tStdin: []byte(\"\"),\n   253→\t\t},\n   254→\t}\n   255→\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n   256→}\n   257→\n   258→// --- File output mode (prd007-sponge R1, R2) ---\n   259→\n   260→func TestFile_SmallStdin(t *testing.T) {\n   261→\tvar buf bytes.Buffer\n   262→\tfor i := 1; i <= 100; i++ {\n   263→\t\tfmt.Fprintf(&buf, \"%d\\n\", i)\n   264→\t}\n   265→\n   266→\trunFileDiffTests(t, []fileDiffTest{\n   267→\t\t{\n   268→\t\t\tName:       \"small-stdin-to-file\",\n   269→\t\t\tArgs:       []string{\"outfile.txt\"},\n   270→\t\t\tStdin:      buf.Bytes(),\n   271→\t\t\tCheckFiles: []string{\"outfile.txt\"},\n   272→\t\t},\n   273→\t})\n   274→}\n   275→\n   276→func TestFile_EmptyStdin(t *testing.T) {\n   277→\trunFileDiffTests(t, []fileDiffTest{\n   278→\t\t{\n   279→\t\t\tName:       \"empty-stdin-to-file\",\n   280→\t\t\tArgs:       []string{\"empty_out.txt\"},\n   281→\t\t\tStdin:      []byte(\"\"),\n   282→\t\t\tCheckFiles: []string{\"empty_out.txt\"},\n   283→\t\t},\n   284→\t})\n   285→}\n   286→\n   287→func TestFile_SoakBeforeWrite(t *testing.T) {\n   288→\tcontent := []byte(\"line1\\nline2\\nline3\\n\")\n   289→\n   290→\trunFileDiffTests(t, []fileDiffTest{\n   291→\t\t{\n   292→\t\t\tName:  \"soak-before-write\",\n   293→\t\t\tArgs:  []string{\"data.txt\"},\n   294→\t\t\tStdin: content,\n   295→\t\t\tPreFiles: map[string]fileSetup{\n   296→\t\t\t\t\"data.txt\": {Content: content, Mode: 0o644},\n   297→\t\t\t},\n   298→\t\t\tCheckFiles: []string{\"data.txt\"},\n   299→\t\t},\n   300→\t})\n   301→}\n   302→\n   303→// --- Append mode (prd007-sponge R3) ---\n   304→\n   305→func TestAppend_ExistingFile(t *testing.T) {\n   306→\trunFileDiffTests(t, []fileDiffTest{\n   307→\t\t{\n   308→\t\t\tName:  \"append-existing-file\",\n   309→\t\t\tArgs:  []string{\"-a\", \"existing.txt\"},\n   310→\t\t\tStdin: []byte(\"appended line\\n\"),\n   311→\t\t\tPreFiles: map[string]fileSetup{\n   312→\t\t\t\t\"existing.txt\": {Content: []byte(\"original line\\n\"), Mode: 0o644},\n   313→\t\t\t},\n   314→\t\t\tCheckFiles: []string{\"existing.txt\"},\n   315→\t\t},\n   316→\t})\n   317→}\n   318→\n   319→func TestAppend_NonexistentFile(t *testing.T) {\n   320→\trunFileDiffTests(t, []fileDiffTest{\n   321→\t\t{\n   322→\t\t\tName:       \"append-nonexistent-file\",\n   323→\t\t\tArgs:       []string{\"-a\", \"newfile.txt\"},\n   324→\t\t\tStdin:      []byte(\"new content\\n\"),\n   325→\t\t\tCheckFiles: []string{\"newfile.txt\"},\n   326→\t\t},\n   327→\t})\n   328→}\n   329→\n   330→// --- Error handling (prd007-sponge R5) ---\n   331→\n   332→func TestError_NonexistentDirectory(t *testing.T) {\n   333→\trunFileDiffTests(t, []fileDiffTest{\n   334→\t\t{\n   335→\t\t\tName:            \"error-nonexistent-dir\",\n   336→\t\t\tArgs:            []string{filepath.Join(\"nonexistent\", \"dir\", \"file.txt\")},\n   337→\t\t\tStdin:           []byte(\"test\\n\"),\n   338→\t\t\tSkipStderrMatch: true,\n   339→\t\t},\n   340→\t})\n   341→}\n   342→"}]},"parent_tool_use_id":null,"session_id":"056dabcf-3fdf-4632-b122-5fc43bd135d0","uuid":"fc7734d2-fcda-41a5-8286-3b255231c068","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/134/cmd/sponge/sponge_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Differential tests for cmd/sponge comparing Go binary against moreutils\n// reference sponge binary.\n//\n// Implements: prd007-sponge R1, R2, R3, R4, R5\n// Traces: test-rel01.2, rel01.2-uc001-sponge\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\n// goBinaryPath is the path to the compiled Go sponge binary.\nvar goBinaryPath string\n\n// refBinaryPath is the path to the moreutils reference binary (sponge).\nvar refBinaryPath string\n\nfunc TestMain(m *testing.M) {\n\t// Locate moreutils reference binary (D1).\n\tref, err := exec.LookPath(\"sponge\")\n\tif err != nil {\n\t\tfmt.Println(\"sponge not found; skipping sponge differential tests\")\n\t\tos.Exit(0)\n\t}\n\trefBinaryPath = ref\n\n\t// Build the Go sponge binary to a temp directory.\n\ttmpDir, err := os.MkdirTemp(\"\", \"sponge-test-*\")\n\tif err != nil {\n\t\tpanic(\"creating temp dir: \" + err.Error())\n\t}\n\n\tgoBinaryPath = filepath.Join(tmpDir, \"sponge\")\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", goBinaryPath, \".\")\n\tcmd.Dir = \".\"\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tos.RemoveAll(tmpDir)\n\t\tpanic(fmt.Sprintf(\"building sponge binary: %v\\n%s\", err, out))\n\t}\n\n\tcode := m.Run()\n\tos.RemoveAll(tmpDir) // best-effort cleanup\n\tos.Exit(code)\n}\n\n// --- File-output differential test infrastructure (D3) ---\n\n// fileDiffTest defines a differential test case for file-output utilities\n// where both binaries write to files rather than stdout.\ntype fileDiffTest struct {\n\tName            string               // subtest name\n\tArgs            []string             // command-line arguments\n\tStdin           []byte               // stdin content\n\tPreFiles        map[string]fileSetup // files to create before running each binary\n\tCheckFiles      []string             // filenames to compare after running\n\tSkipStderrMatch bool                 // skip exact stderr comparison for implementation-specific error messages\n}\n\n// fileSetup describes a pre-existing file to create before running a binary.\ntype fileSetup struct {\n\tContent []byte\n\tMode    os.FileMode\n}\n\n// binaryResult holds captured output from a single binary invocation.\ntype binaryResult struct {\n\tStdout   []byte\n\tStderr   []byte\n\tExitCode int\n}\n\n// fileDiffTimeout is the maximum duration each binary invocation may run.\nconst fileDiffTimeout = 10 * time.Second\n\n// runFileDiffTests runs each fileDiffTest as a named subtest.\nfunc runFileDiffTests(t *testing.T, tests []fileDiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\tt.Helper()\n\t\t\trunSingleFileDiffTest(t, tc)\n\t\t})\n\t}\n}\n\n// runSingleFileDiffTest executes both binaries in separate directories with\n// identical pre-conditions and compares output files, stderr, and exit code.\nfunc runSingleFileDiffTest(t *testing.T, tc fileDiffTest) {\n\tt.Helper()\n\n\trefDir := t.TempDir()\n\tgoDir := t.TempDir()\n\n\t// Set up identical pre-existing files in both directories.\n\tfor name, setup := range tc.PreFiles {\n\t\tfor _, dir := range []string{refDir, goDir} {\n\t\t\tpath := filepath.Join(dir, name)\n\t\t\tif err := os.WriteFile(path, setup.Content, setup.Mode); err != nil {\n\t\t\t\tt.Fatalf(\"writing pre-file %s: %v\", name, err)\n\t\t\t}\n\t\t}\n\t}\n\n\tenv := buildTestEnv()\n\n\trefResult := execBinary(t, refBinaryPath, tc.Args, tc.Stdin, env, refDir)\n\tgoResult := execBinary(t, goBinaryPath, tc.Args, tc.Stdin, env, goDir)\n\n\tfailed := false\n\n\t// Compare exit codes.\n\tif refResult.ExitCode != goResult.ExitCode {\n\t\tfailed = true\n\t}\n\n\t// Compare stderr.\n\tif !tc.SkipStderrMatch {\n\t\tif !bytes.Equal(refResult.Stderr, goResult.Stderr) {\n\t\t\tfailed = true\n\t\t}\n\t} else {\n\t\t// For error tests, verify both produce stderr or both produce none.\n\t\tif (len(refResult.Stderr) > 0) != (len(goResult.Stderr) > 0) {\n\t\t\tfailed = true\n\t\t}\n\t}\n\n\t// Compare output files byte-for-byte.\n\tfor _, name := range tc.CheckFiles {\n\t\trefPath := filepath.Join(refDir, name)\n\t\tgoPath := filepath.Join(goDir, name)\n\n\t\trefContent, refErr := os.ReadFile(refPath)\n\t\tgoContent, goErr := os.ReadFile(goPath)\n\n\t\tif refErr != nil && goErr != nil {\n\t\t\tcontinue // both failed to create the file — consistent\n\t\t}\n\t\tif (refErr != nil) != (goErr != nil) {\n\t\t\tfailed = true\n\t\t\tt.Errorf(\"file %s existence divergence: ref err=%v, go err=%v\", name, refErr, goErr)\n\t\t\tcontinue\n\t\t}\n\t\tif !bytes.Equal(refContent, goContent) {\n\t\t\tfailed = true\n\t\t\tt.Errorf(\"file content divergence for %s\\nref: %q\\ngo:  %q\", name, refContent, goContent)\n\t\t}\n\t}\n\n\tif failed {\n\t\tt.Errorf(\"divergence detected\\n\"+\n\t\t\t\"args:       %v\\n\"+\n\t\t\t\"ref stderr: %q\\n\"+\n\t\t\t\"go  stderr: %q\\n\"+\n\t\t\t\"ref exit:   %d\\n\"+\n\t\t\t\"go  exit:   %d\",\n\t\t\ttc.Args,\n\t\t\trefResult.Stderr,\n\t\t\tgoResult.Stderr,\n\t\t\trefResult.ExitCode,\n\t\t\tgoResult.ExitCode,\n\t\t)\n\t}\n}\n\n// buildTestEnv constructs the environment for binary invocations with LC_ALL=C.\nfunc buildTestEnv() []string {\n\tenv := os.Environ()\n\tfor i, e := range env {\n\t\tif strings.HasPrefix(e, \"LC_ALL=\") {\n\t\t\tenv[i] = \"LC_ALL=C\"\n\t\t\treturn env\n\t\t}\n\t}\n\treturn append(env, \"LC_ALL=C\")\n}\n\n// execBinary runs a binary with the given arguments, stdin, environment, and\n// working directory, capturing stdout, stderr, and exit code.\nfunc execBinary(t *testing.T, binPath string, args []string, stdin []byte, env []string, workDir string) binaryResult {\n\tt.Helper()\n\n\tctx, cancel := context.WithTimeout(context.Background(), fileDiffTimeout)\n\tdefer cancel()\n\n\tcmd := exec.CommandContext(ctx, binPath, args...)\n\tcmd.Env = env\n\tcmd.Dir = workDir\n\n\tif stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(stdin)\n\t}\n\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\n\terr := cmd.Run()\n\n\texitCode := 0\n\tif err != nil {\n\t\tif ctx.Err() == context.DeadlineExceeded {\n\t\t\tt.Fatalf(\"binary %s timed out after %v\", binPath, fileDiffTimeout)\n\t\t}\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\texitCode = exitErr.ExitCode()\n\t\t} else {\n\t\t\tt.Fatalf(\"executing %s: %v\", binPath, err)\n\t\t}\n\t}\n\n\treturn binaryResult{\n\t\tStdout:   stdout.Bytes(),\n\t\tStderr:   stderr.Bytes(),\n\t\tExitCode: exitCode,\n\t}\n}\n\n// --- Passthrough mode: no output filename (prd007-sponge R4) ---\n\nfunc TestPassthrough_Stdin(t *testing.T) {\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:  \"passthrough-text\",\n\t\t\tStdin: []byte(\"hello world\\n\"),\n\t\t},\n\t\t{\n\t\t\tName:  \"passthrough-multiline\",\n\t\t\tStdin: []byte(\"line one\\nline two\\nline three\\n\"),\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\nfunc TestPassthrough_EmptyStdin(t *testing.T) {\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:  \"passthrough-empty\",\n\t\t\tStdin: []byte(\"\"),\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBinaryPath, refBinaryPath, tests)\n}\n\n// --- File output mode (prd007-sponge R1, R2) ---\n\nfunc TestFile_SmallStdin(t *testing.T) {\n\tvar buf bytes.Buffer\n\tfor i := 1; i <= 100; i++ {\n\t\tfmt.Fprintf(&buf, \"%d\\n\", i)\n\t}\n\n\trunFileDiffTests(t, []fileDiffTest{\n\t\t{\n\t\t\tName:       \"small-stdin-to-file\",\n\t\t\tArgs:       []string{\"outfile.txt\"},\n\t\t\tStdin:      buf.Bytes(),\n\t\t\tCheckFiles: []string{\"outfile.txt\"},\n\t\t},\n\t})\n}\n\nfunc TestFile_EmptyStdin(t *testing.T) {\n\trunFileDiffTests(t, []fileDiffTest{\n\t\t{\n\t\t\tName:       \"empty-stdin-to-file\",\n\t\t\tArgs:       []string{\"empty_out.txt\"},\n\t\t\tStdin:      []byte(\"\"),\n\t\t\tCheckFiles: []string{\"empty_out.txt\"},\n\t\t},\n\t})\n}\n\nfunc TestFile_SoakBeforeWrite(t *testing.T) {\n\tcontent := []byte(\"line1\\nline2\\nline3\\n\")\n\n\trunFileDiffTests(t, []fileDiffTest{\n\t\t{\n\t\t\tName:  \"soak-before-write\",\n\t\t\tArgs:  []string{\"data.txt\"},\n\t\t\tStdin: content,\n\t\t\tPreFiles: map[string]fileSetup{\n\t\t\t\t\"data.txt\": {Content: content, Mode: 0o644},\n\t\t\t},\n\t\t\tCheckFiles: []string{\"data.txt\"},\n\t\t},\n\t})\n}\n\n// --- Append mode (prd007-sponge R3) ---\n\nfunc TestAppend_ExistingFile(t *testing.T) {\n\trunFileDiffTests(t, []fileDiffTest{\n\t\t{\n\t\t\tName:  \"append-existing-file\",\n\t\t\tArgs:  []string{\"-a\", \"existing.txt\"},\n\t\t\tStdin: []byte(\"appended line\\n\"),\n\t\t\tPreFiles: map[string]fileSetup{\n\t\t\t\t\"existing.txt\": {Content: []byte(\"original line\\n\"), Mode: 0o644},\n\t\t\t},\n\t\t\tCheckFiles: []string{\"existing.txt\"},\n\t\t},\n\t})\n}\n\nfunc TestAppend_NonexistentFile(t *testing.T) {\n\trunFileDiffTests(t, []fileDiffTest{\n\t\t{\n\t\t\tName:       \"append-nonexistent-file\",\n\t\t\tArgs:       []string{\"-a\", \"newfile.txt\"},\n\t\t\tStdin:      []byte(\"new content\\n\"),\n\t\t\tCheckFiles: []string{\"newfile.txt\"},\n\t\t},\n\t})\n}\n\n// --- Error handling (prd007-sponge R5) ---\n\nfunc TestError_NonexistentDirectory(t *testing.T) {\n\trunFileDiffTests(t, []fileDiffTest{\n\t\t{\n\t\t\tName:            \"error-nonexistent-dir\",\n\t\t\tArgs:            []string{filepath.Join(\"nonexistent\", \"dir\", \"file.txt\")},\n\t\t\tStdin:           []byte(\"test\\n\"),\n\t\t\tSkipStderrMatch: true,\n\t\t},\n\t})\n}\n","numLines":342,"startLine":1,"totalLines":342}}}
