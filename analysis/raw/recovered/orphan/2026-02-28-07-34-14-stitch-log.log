MTIME placeholder.\n// Handles both \"Mon DD HH:MM\" (recent) and \"Mon DD  YYYY\" (old) formats.\nfunc LsNormalizer(data []byte) []byte {\n\tre := regexp.MustCompile(`[A-Z][a-z]{2}\\s+\\d{1,2}\\s+(?:\\d{2}:\\d{2}|\\s?\\d{4})`)\n\treturn re.ReplaceAll(data, []byte(\"MTIME\"))\n}\n\n// LsExtendedNormalizer extends LsNormalizer for recursive listings.\n// Same replacement but applied globally.\nfunc LsExtendedNormalizer(data []byte) []byte {\n\treturn LsNormalizer(data)\n}\n\n// BuildBinary compiles a Go package and returns the path to the resulting binary.\nfunc BuildBinary(t *testing.T, pkg string) string {\n\tt.Helper()\n\tbinary := filepath.Join(t.TempDir(), filepath.Base(pkg))\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", binary, pkg)\n\tcmd.Env = os.Environ()\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tt.Fatalf(\"failed to build %s: %v\\n%s\", pkg, err, out)\n\t}\n\treturn binary\n}\n\n// FindRefBinary locates a reference binary on PATH. Returns the path or\n// calls t.Skip if not found.\nfunc FindRefBinary(t *testing.T, name string) string {\n\tt.Helper()\n\tpath, err := exec.LookPath(name)\n\tif err != nil {\n\t\tt.Skipf(\"reference binary %s not found on PATH: %v\", name, err)\n\t}\n\treturn path\n}\n\n// FormatDivergence formats a divergence message for test output.\nfunc FormatDivergence(args []string, stdin []byte, refOut, goOut, refErr, goErr []byte, refExit, goExit int) string {\n\treturn fmt.Sprintf(\"args: %v\\nstdin: %s\\nref stdout:\\n%s\\ngo stdout:\\n%s\\nref stderr:\\n%s\\ngo stderr:\\n%s\\nref exit: %d\\ngo exit: %d\",\n\t\targs, truncate(stdin, 256), refOut, goOut, refErr, goErr, refExit, goExit)\n}\n","structuredPatch":[],"originalFile":null}}
