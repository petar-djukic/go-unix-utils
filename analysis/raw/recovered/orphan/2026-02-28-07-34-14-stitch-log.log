}\n\treturn result\n}\n\n// PadRight pads a string on the right to the given width.\n// Per prd003-format R1.2.\nfunc PadRight(s string, width int) string {\n\tw := displayWidth(s)\n\tif w >= width {\n\t\treturn s\n\t}\n\treturn s + strings.Repeat(\" \", width-w)\n}\n\n// PadLeft pads a string on the left to the given width.\n// Per prd003-format R1.2.\nfunc PadLeft(s string, width int) string {\n\tw := displayWidth(s)\n\tif w >= width {\n\t\treturn s\n\t}\n\treturn strings.Repeat(\" \", width-w) + s\n}\n\nfunc displayWidth(s string) int {\n\treturn utf8.RuneCountInString(s)\n}\n\n// FileTypeColor returns the ANSI escape sequence for a file's type.\n// Per prd003-format R2.1 and R2.4.\nfunc FileTypeColor(mode os.FileMode) string {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn \"\\033[34m\"\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn \"\\033[36m\"\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn \"\\033[33;1m\"\n\tcase mode&os.ModeDevice != 0:\n\t\treturn \"\\033[33;1m\"\n\tcase mode&os.ModeSocket != 0:\n\t\treturn \"\\033[35m\"\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn \"\\033[33m\"\n\tcase mode&0o111 != 0:\n\t\treturn \"\\033[32m\"\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\n// Reset returns the ANSI reset sequence. Per prd003-format R2.2.\nfunc Reset() string {\n\treturn \"\\033[0m\"\n}\n\n// ColorEnabled returns true only when w is a TTY.\n// Per prd003-format R2.3.\nfunc ColorEnabled(w io.Writer) bool {\n\treturn sys.IsTerminal(w)\n}\n\n// HumanSizeOpts configures HumanSize output mode.\n// Per prd003-format R3.1.\ntype HumanSizeOpts struct {\n\tBinary bool // true = 1024-based; false = SI 1000-based\n}\n\n// HumanSize converts a byte count to a human-readable string.\n// Per prd003-format R3.1.\nfunc HumanSize(b int64, opts HumanSizeOpts) string {\n\tif b == 0 {\n\t\treturn \"0\"\n\t}\n\n\tvar base float64\n\tvar suffixes []string\n\tif opts.Binary {\n\t\tbase = 1024\n\t\tsuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\