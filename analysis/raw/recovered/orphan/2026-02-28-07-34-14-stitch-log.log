tif b == 0 {\n\t\treturn \"0\"\n\t}\n\n\tvar base float64\n\tvar suffixes []string\n\tif opts.Binary {\n\t\tbase = 1024\n\t\tsuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\t} else {\n\t\tbase = 1000\n\t\tsuffixes = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n\t}\n\n\tf := float64(b)\n\ti := 0\n\tfor f >= base && i < len(suffixes)-1 {\n\t\tf /= base\n\t\ti++\n\t}\n\n\tif i == 0 {\n\t\treturn strings.TrimRight(strings.TrimRight(\n\t\t\tstrings.Replace(\n\t\t\t\tstrings.Replace(\n\t\t\t\t\tstring(rune(b+'0')), \"\", \"\", 0,\n\t\t\t\t), \"\", \"\", 0,\n\t\t\t), \"0\"), \".\")\n\t}\n\n\tif f == float64(int64(f)) {\n\t\treturn strings.Replace(\n\t\t\tstrings.Replace(\n\t\t\t\tstring(rune(int64(f)+'0')), \"\", \"\", 0,\n\t\t\t)+suffixes[i], \"\", \"\", 0,\n\t\t)\n\t}\n\n\treturn strings.TrimRight(strings.TrimRight(\n\t\tstrings.Replace(\n\t\t\tstrings.Replace(\n\t\t\t\tstring(rune(0)), \"\", \"\", 0,\n\t\t\t), \"\", \"\", 0,\n\t\t), \"0\"), \".\") + suffixes[i]\n}\n"}}
