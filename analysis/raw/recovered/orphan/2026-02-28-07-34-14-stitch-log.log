{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_013hnevE557o3zwTb2pYPdaz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JVVU78HH6CgpaWfnuEvnnN","name":"Write","input":{"file_path":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/generation-2026-02-27-21-48-32-21v/pkg/testutils/testutils.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides the differential testing harness.\n// Implements prd001-testutils.\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"testing\"\n\t\"time\"\n)\n\n// NormalizeFunc is a function that normalizes output bytes before comparison.\n// Per prd001-testutils R1.4.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest defines a single differential test case.\n// Per prd001-testutils R1.1.\ntype DiffTest struct {\n\tName          string            // subtest name used with t.Run; required\n\tArgs          []string          // command-line arguments passed to both binaries\n\tStdin         []byte            // nil = no stdin (both binaries receive EOF immediately)\n\tEnv           []string          // nil = inherit test process environment; non-nil replaces it\n\tExitCode      int               // expected exit code for both binaries\n\tNormalize     []func([]byte) []byte // applied in order to stdout/stderr before comparison\n\tExpectedFiles map[string][]byte // optional: path -> expected byte content after execution\n\tWorkDir       string            // optional: working directory for both binaries\n}\n\nconst defaultTimeout = 10 * time.Second\n\n// RunDiffTests runs each DiffTest as a named subtest via t.Run.\n// Per prd001-testutils R2.1.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tt := range tests {\n\t\tt.Run(tt.Name, func(t *testing.T) {\n\t\t\tt.Helper()\n\t\t\trunSingleDiffTest(t, goBinary, refBinary, tt)\n\t\t})\n\t}\n}\n\nfunc runSingleDiffTest(t *testing.T, goBinary, refBinary string, tt DiffTest) {\n\tt.Helper()\n\n\tworkDir := tt.WorkDir\n\tif workDir == \"\" {\n\t\tworkDir = t.TempDir()\n\t}\n\n\trefStdout, refStderr, refExit := runBinary(t, refBinary, tt.Args, tt.Stdin, tt.Env, workDir)\n\tgoStdout, goStderr, goExit := runBinary(t, goBinary, tt.Args, tt.Stdin, tt.Env, workDir)\n\n\trefStdoutNorm := applyNormalizers(refStdout, tt.Normalize)\n\tgoStdoutNorm := applyNormalizers(goStdout, tt.Normalize)\n\trefStderrNorm := applyNormalizers(refStderr, tt.Normalize)\n\tgoStderrNorm := applyNormalizers(goStderr, tt.Normalize)\n\n\tif !bytes.Equal(refStdoutNorm, goStdoutNorm) {\n\t\tt.Fatalf(\"stdout divergence\\nargs: %v\\nstdin: %s\\nref stdout:\\n%s\\ngo stdout:\\n%s\\nref stderr:\\n%s\\ngo stderr:\\n%s\\nref exit: %d\\ngo exit: %d\",\n\t\t\ttt.Args, truncate(tt.Stdin, 256),\n\t\t\trefStdout, goStdout, refStderr, goStderr, refExit, goExit)\n\t}\n\n\tif !bytes.Equal(refStderrNorm, goStderrNorm) {\n\t\tt.Fatalf(\"stderr divergence\\nargs: %v\\nstdin: %s\\nref stderr:\\n%s\\ngo stderr:\\n%s\\nref exit: %d\\ngo exit: %d\",\n\t\t\ttt.Args, truncate(tt.Stdin, 256),\n\t\t\trefStderr, goStderr, refExit, goExit)\n\t}\n\n\tif refExit != goExit {\n\t\tt.Fatalf(\"exit code divergence\\nargs: %v\\nref exit: %d\\ngo exit: %d\\nref stdout:\\n%s\\ngo stdout:\\n%s\\nref stderr:\\n%s\\ngo stderr:\\n%s\",\n\t\t\ttt.Args, refExit, goExit, refStdout, goStdout, refStderr, goStderr)\n\t}\n\n\tfor path, expectedContent := range tt.ExpectedFiles {\n\t\tfullPath := filepath.Join(workDir, path)\n\t\tactual, err := os.ReadFile(fullPath)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"expected file %s not found: %v\", path, err)\n\t\t}\n\t\tif !bytes.Equal(actual, expectedContent) {\n\t\t\tt.Fatalf(\"file content divergence for %s\\nexpected:\\n%s\\nactual:\\n%s\",\n\t\t\t\tpath, expectedContent, actual)\n\t\t}\n\t}\n}\n\nfunc runBinary(t *testing.T, binary string, args []string, stdin []byte, env []string, workDir string) (stdout, stderr []byte, exitCode int) {\n\tt.Helper()\n\n\tctx, cancel := context.WithTimeout(context.Background(), defaultTimeout)\n\tdefer cancel()\n\n\tcmd := exec.CommandContext(ctx, binary, args...)\n\tcmd.Dir = workDir\n\n\tif env != nil {\n\t\tcmd.Env = env\n\t} else {\n\t\tcmd.Env = os.Environ()\n\t}\n\n\tif stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(stdin)\n\t}\n\n\tvar stdoutBuf, stderrBuf bytes.Buffer\n\tcmd.Stdout = &stdoutBuf\n\tcmd.Stderr = &stderrBuf\n\n\terr := cmd.Run()\n\tstdout = stdoutBuf.Bytes()\n\tstderr = stderrBuf.Bytes()\n\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatalf(\"binary %s timed out after %v\\nargs: %v\", binary, defaultTimeout, args)\n\t}\n\n\tif err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\texitCode = exitErr.ExitCode()\n\t\t} else {\n\t\t\tt.Fatalf(\"failed to run binary %s: %v\", binary, err)\n\t\t}\n\t}\n\n\treturn stdout, stderr, exitCode\n}\n\nfunc applyNormalizers(data []byte, normalizers []func([]byte) []byte) []byte {\n\tresult := data\n\tfor _, norm := range normalizers {\n\t\tresult = norm(result)\n\t}\n\treturn result\n}\n\nfunc truncate(data []byte, max int) []byte {\n\tif len(data) <= max {\n\t\treturn data\n\t}\n\treturn append(data[:max], []byte(\"... (truncated)\")...)\n}\n\n// TimestampNormalizer replaces common strftime timestamp patterns with a fixed\n// placeholder. Per prd001-testutils R4.2.\nfunc TimestampNormalizer(data []byte) []byte {\n\tre := regexp.MustCompile(`[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}`)\n\treturn re.ReplaceAll(data, []byte(\"TIMESTAMP\"))\n}\n\n// LsNormalizer replaces the mtime column in ls -l output with MTIME placeholder.\n// Handles both \"Mon DD HH:MM\" (recent) and \"Mon DD  YYYY\" (old) formats.\nfunc LsNormalizer(data []byte) []byte {\n\tre := regexp.MustCompile(`[A-Z][a-z]{2}\\s+\\d{1,2}\\s+(?:\\d{2}:\\d{2}|\\s?\\d{4})`)\n\treturn re.ReplaceAll(data, []byte(\"MTIME\"))\n}\n\n// LsExtendedNormalizer extends LsNormalizer for recursive listings.\n// Same replacement but applied globally.\nfunc LsExtendedNormalizer(data []byte) []byte {\n\treturn LsNormalizer(data)\n}\n\n// BuildBinary compiles a Go package and returns the path to the resulting binary.\nfunc BuildBinary(t *testing.T, pkg string) string {\n\tt.Helper()\n\tbinary := filepath.Join(t.TempDir(), filepath.Base(pkg))\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", binary, pkg)\n\tcmd.Env = os.Environ()\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tt.Fatalf(\"failed to build %s: %v\\n%s\", pkg, err, out)\n\t}\n\treturn binary\n}\n\n// FindRefBinary locates a reference binary on PATH. Returns the path or\n// calls t.Skip if not found.\nfunc FindRefBinary(t *testing.T, name string) string {\n\tt.Helper()\n\tpath, err := exec.LookPath(name)\n\tif err != nil {\n\t\tt.Skipf(\"reference binary %s not found on PATH: %v\", name, err)\n\t}\n\treturn path\n}\n\n// FormatDivergence formats a divergence message for test output.\nfunc FormatDivergence(args []string, stdin []byte, refOut, goOut, refErr, goErr []byte, refExit, goExit int) string {\n\treturn fmt.Sprintf(\"args: %v\\nstdin: %s\\nref stdout:\\n%s\\ngo stdout:\\n%s\\nref stderr:\\n%s\\ngo stderr:\\n%s\\nref exit: %d\\ngo exit: %d\",\n\t\targs, truncate(stdin, 256), refOut, goOut, refErr, goErr, refExit, goExit)\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":328,"cache_read_input_tokens":95409,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":328},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"69a146e4-fa50-4ec5-bd01-ac65e0ea05f2","uuid":"f049c061-717b-4634-9a0f-35b7ce916b17"}
