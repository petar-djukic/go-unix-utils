rt":15,"oldLines":7,"newStart":15,"newLines":7,"lines":["   return &FileInfo{","     Mode:    osFI.Mode(),","     Size:    st.Size,","-    Nlink:   st.Nlink,","+    Nlink:   uint64(st.Nlink),","     Uid:     st.Uid,","     Gid:     st.Gid,","     Rdev:    st.Rdev,"]}],"userModified":false,"replaceAll":false}}
