{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_015KV9sGot7T1xDarBTtuhxo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MpMLqSnDUbUYdmt3YK35gC","name":"Write","input":{"file_path":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/generation-2026-02-27-21-48-32-21v/pkg/format/format.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package format provides output formatting shared across utilities including\n// table alignment, ANSI color output, and human-readable unit conversion.\n// Implements prd003-format.\npackage format\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\t\"sync\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\n// displayWidth returns the display width of a string in rune count.\n// Implements prd003-format R1.3.\nfunc displayWidth(s string) int {\n\treturn utf8.RuneCountInString(s)\n}\n\n// Columns distributes entries into the maximum number of columns fitting within termWidth.\n// Implements prd003-format R1.1, R1.4.\nfunc Columns(entries []string, termWidth int) [][]string {\n\tif len(entries) == 0 {\n\t\treturn nil\n\t}\n\tn := len(entries)\n\t// Try increasing number of columns until they don't fit.\n\tbestCols := 1\n\tfor cols := n; cols >= 1; cols-- {\n\t\trows := (n + cols - 1) / cols\n\t\twidths := make([]int, cols)\n\t\tfor i, e := range entries {\n\t\t\tcol := i / rows\n\t\t\tif col >= cols {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tw := displayWidth(e)\n\t\t\tif w > widths[col] {\n\t\t\t\twidths[col] = w\n\t\t\t}\n\t\t}\n\t\ttotal := 0\n\t\tfor i, w := range widths {\n\t\t\ttotal += w\n\t\t\tif i < cols-1 {\n\t\t\t\ttotal += 2 // gap between columns\n\t\t\t}\n\t\t}\n\t\tif total <= termWidth {\n\t\t\tbestCols = cols\n\t\t\tbreak\n\t\t}\n\t}\n\n\trows := (n + bestCols - 1) / bestCols\n\tresult := make([][]string, rows)\n\tfor r := 0; r < rows; r++ {\n\t\tvar row []string\n\t\tfor c := 0; c < bestCols; c++ {\n\t\t\tidx := c*rows + r\n\t\t\tif idx < n {\n\t\t\t\trow = append(row, entries[idx])\n\t\t\t}\n\t\t}\n\t\tresult[r] = row\n\t}\n\treturn result\n}\n\n// PadRight pads a string with trailing spaces to the specified display width.\n// Implements prd003-format R1.2.\nfunc PadRight(s string, width int) string {\n\tdw := displayWidth(s)\n\tif dw >= width {\n\t\treturn s\n\t}\n\treturn s + strings.Repeat(\" \", width-dw)\n}\n\n// PadLeft pads a string with leading spaces to the specified display width.\n// Implements prd003-format R1.2.\nfunc PadLeft(s string, width int) string {\n\tdw := displayWidth(s)\n\tif dw >= width {\n\t\treturn s\n\t}\n\treturn strings.Repeat(\" \", width-dw) + s\n}\n\n// Color constants matching GNU ls LS_COLORS defaults.\n// Implements prd003-format R2.4.\nconst (\n\tcolorDirectory = \"\\033[34m\"\n\tcolorSymlink   = \"\\033[36m\"\n\tcolorExec      = \"\\033[32m\"\n\tcolorBlock     = \"\\033[33;1m\"\n\tcolorChar      = \"\\033[33;1m\"\n\tcolorSocket    = \"\\033[35m\"\n\tcolorPipe      = \"\\033[33m\"\n\tcolorReset     = \"\\033[0m\"\n)\n\nvar (\n\tcolorOverrideMu sync.Mutex\n\tcolorOverride   *bool // nil = auto, true = forced on, false = forced off\n)\n\n// SetColorEnabled overrides automatic TTY detection.\n// Implements prd003-format R2.6.\nfunc SetColorEnabled(enabled bool) {\n\tcolorOverrideMu.Lock()\n\tdefer colorOverrideMu.Unlock()\n\tcolorOverride = &enabled\n}\n\n// ResetColorEnabled clears any override set by SetColorEnabled.\n// Implements prd003-format R2.7.\nfunc ResetColorEnabled() {\n\tcolorOverrideMu.Lock()\n\tdefer colorOverrideMu.Unlock()\n\tcolorOverride = nil\n}\n\n// ColorEnabled returns true when w is a TTY, respecting any override.\n// Implements prd003-format R2.3.\nfunc ColorEnabled(w io.Writer) bool {\n\tcolorOverrideMu.Lock()\n\toverride := colorOverride\n\tcolorOverrideMu.Unlock()\n\tif override != nil {\n\t\treturn *override\n\t}\n\tf, ok := w.(*os.File)\n\tif !ok {\n\t\treturn false\n\t}\n\treturn sys.IsTerminal(f.Fd())\n}\n\nfunc isColorActive() bool {\n\tcolorOverrideMu.Lock()\n\toverride := colorOverride\n\tcolorOverrideMu.Unlock()\n\tif override != nil {\n\t\treturn *override\n\t}\n\treturn false\n}\n\n// FileTypeColor returns the ANSI escape sequence for a file type.\n// Implements prd003-format R2.1.\nfunc FileTypeColor(mode os.FileMode) string {\n\tif !isColorActive() {\n\t\treturn \"\"\n\t}\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn colorDirectory\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn colorSymlink\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn colorChar\n\tcase mode&os.ModeDevice != 0:\n\t\treturn colorBlock\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn colorPipe\n\tcase mode&os.ModeSocket != 0:\n\t\treturn colorSocket\n\tcase mode&0o111 != 0:\n\t\treturn colorExec\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\n// Reset returns the ANSI reset sequence when color is enabled.\n// Implements prd003-format R2.2.\nfunc Reset() string {\n\tif !isColorActive() {\n\t\treturn \"\"\n\t}\n\treturn colorReset\n}\n\n// HumanSizeOpts controls the unit base for HumanSize.\n// Implements prd003-format R3.1.\ntype HumanSizeOpts struct {\n\tBinary bool // true = 1024-based (K/M/G); false = 1000-based SI (kB/MB/GB)\n}\n\n// HumanSize converts a byte count to a human-readable string.\n// Implements prd003-format R3.1, R3.2, R3.3, R3.4.\nfunc HumanSize(bytes int64, opts HumanSizeOpts) string {\n\tif bytes == 0 {\n\t\treturn \"0\"\n\t}\n\tvar base float64\n\tvar suffixes []string\n\tif opts.Binary {\n\t\tbase = 1024\n\t\tsuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\t} else {\n\t\tbase = 1000\n\t\tsuffixes = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n\t}\n\tf := float64(bytes)\n\ti := 0\n\tfor f >= base && i < len(suffixes)-1 {\n\t\tf /= base\n\t\ti++\n\t}\n\tif i == 0 {\n\t\treturn fmt.Sprintf(\"%d\", bytes)\n\t}\n\tif f == float64(int64(f)) {\n\t\treturn fmt.Sprintf(\"%d%s\", int64(f), suffixes[i])\n\t}\n\treturn fmt.Sprintf(\"%.1f%s\", f, suffixes[i])\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":380,"cache_read_input_tokens":108974,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":380},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"2a10b715-7029-4090-909b-50ac17d5a283","uuid":"a568c17b-d87c-4767-9ab4-d6f6375b87a4"}
