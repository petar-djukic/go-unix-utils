romStat(fi, &st)\n\tfi.Mode = osInfo.Mode()\n\tfi.Size = osInfo.Size()\n\treturn fi, nil\n}\n\n// Lstat does not follow symbolic links and returns the symlink's own metadata.\n// Implements prd002-sys R2.1.\nfunc Lstat(path string) (*FileInfo, error) {\n\tosInfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar st syscall.Stat_t\n\tif err := syscall.Lstat(path, &st); err != nil {\n\t\treturn nil, err\n\t}\n\tfi := &FileInfo{Info: osInfo}\n\tfillFromStat(fi, &st)\n\tfi.Mode = osInfo.Mode()\n\tfi.Size = osInfo.Size()\n\treturn fi, nil\n}\n\n// TerminalWidth returns the current terminal column count via TIOCGWINSZ ioctl on stdout.\n// Returns an error when stdout is not a terminal.\n// Implements prd002-sys R1.1.\nfunc TerminalWidth() (int, error) {\n\tws, err := unix.IoctlGetWinsize(int(os.Stdout.Fd()), unix.TIOCGWINSZ)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn int(ws.Col), nil\n}\n\n// IsTerminal returns true when the file descriptor refers to a terminal.\n// Implements prd002-sys R1.3.\nfunc IsTerminal(fd uintptr) bool {\n\t_, err := unix.IoctlGetWinsize(int(fd), unix.TIOCGWINSZ)\n\treturn err == nil\n}\n\n// InstallSIGPIPEHandler installs a SIGPIPE handler that exits 0 on broken pipe.\n// Implements prd002-sys R3.1, R3.2.\nfunc InstallSIGPIPEHandler() {\n\tc := make(chan os.Signal, 1)\n\tsignal.Notify(c, syscall.SIGPIPE)\n\tgo func() {\n\t\t<-c\n\t\tos.Exit(0)\n\t}()\n}\n\nvar (\n\tresizeMu        sync.Mutex\n\tresizeCallbacks []func(int)\n\tresizeOnce      sync.Once\n)\n\n// OnTerminalResize registers a callback invoked on SIGWINCH with the new terminal width.\n// Implements prd002-sys R4.1, R4.2.\nfunc OnTerminalResize(callback func(width int)) {\n\tresizeMu.Lock()\n\tresizeCallbacks = append(resizeCallbacks, callback)\n\tresizeMu.Unlock()\n\n\tresizeOnce.Do(func() {\n\t\tc := make(chan os.Signal, 1)\n\t\tsignal.Notify(c, syscall.SIGWINCH)\n\t\tgo func() {\n\t\t\tfor range c {\n\t\t\t\twidth, err := TerminalWidth()\n\t\t\t\tif 