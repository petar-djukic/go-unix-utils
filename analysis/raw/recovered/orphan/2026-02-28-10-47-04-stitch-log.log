{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01CzJeAim4MjkHYjPBsbSyUn","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MLw83MuNQX9oSioS5rJdUs","name":"Write","input":{"file_path":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/generation-2026-02-27-21-48-32-21v/pkg/testutils/testutils.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides the differential testing harness for go-unix-utils.\n// Implements prd001-testutils.\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"regexp\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// NormalizeFunc is a function that normalizes binary output before comparison.\n// Implements prd001-testutils R1.4.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest defines a single differential test case.\n// Implements prd001-testutils R1.1, R1.2, R1.3.\ntype DiffTest struct {\n\tName          string            // subtest name used with t.Run; required\n\tArgs          []string          // command-line arguments passed to both binaries\n\tStdin         []byte            // nil = no stdin (both binaries receive EOF immediately)\n\tEnv           []string          // nil = use defaults only (LC_ALL=C); non-nil = KEY=VALUE pairs merged\n\tWorkDir       string            // empty = per-test t.TempDir(); non-empty = use this directory\n\tExitCode      int               // expected exit code for both binaries\n\tNormalize     []NormalizeFunc   // applied in order to stdout and stderr before comparison\n\tExpectedFiles map[string][]byte // optional: path -> expected byte content after execution\n}\n\nconst defaultTimeout = 10 * time.Second\n\n// RunDiffTests runs each DiffTest as a named subtest.\n// Implements prd001-testutils R2.1, R2.2, R2.3, R2.4, R2.5, R2.6.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests [