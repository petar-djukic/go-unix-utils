ile writer. Per prd002-sys R1.3.\nfunc IsTerminal(w io.Writer) bool {\n\tf, ok := w.(*os.File)\n\tif !ok {\n\t\treturn false\n\t}\n\treturn isTerminalFd(f.Fd())\n}\n","structuredPatch":[],"originalFile":null}}
{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01BgFPGcxi9SVGW43VZnM2Y1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011LmnEeizwWrQUDV41xmD6g","name":"Write","input":{"file_path":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/generation-2026-02-27-21-48-32-21v/pkg/sys/sys_linux.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n//go:build linux\n\npackage sys\n\nimport (\n\t\"os\"\n\t\"os/signal\"\n\t\"sync\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"golang.org/x/sys/unix\"\n)\n\n// TerminalWidth returns the current terminal column count by calling\n// ioctl(TIOCGWINSZ) on stdout. Returns an error when stdout is not a\n// terminal or when ioctl fails. Per prd002-sys R1.1.\nfunc TerminalWidth() (int, error) {\n\tws, err := unix.IoctlGetWinsize(int(os.Stdout.Fd()), unix.TIOCGWINSZ)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn int(ws.Col), nil\n}\n\n// isTerminalFd returns true when the file descriptor is a terminal.\nfunc isTerminalFd(fd uintptr) bool {\n\t_, err := unix.IoctlGetWinsize(int(fd), unix.TIOCGWINSZ)\n\treturn err == nil\n}\n\n// Stat follows symbolic links and returns extended file metadata.\n// Per prd002-sys R2.1.\nfunc Stat(path string) (*FileInfo, error) {\n\tosInfo, err := os.Stat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tvar stat syscall.Stat_t\n\tif err := syscall.Stat(path, &stat); err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn &FileInfo{\n\t\tMode:    osInfo.Mode(),\n\t\tSize:    stat.Size,\n\t\tNlink:   uint64(stat.Nlink),\n\t\tUid:     stat.Uid,\n\t\tGid:     stat.Gid,\n\t\tRdev:    stat.Rdev,\n\t\tDev:     stat.Dev,\n\t\tIno:     stat.Ino,\n\t\tBlocks:  stat.Blocks,\n\t\tBlksize: int64(stat.Blksize),\n\t\tModTime: time.Unix(stat.Mtim.Sec, stat.Mtim.Nsec),\n\t\tSys:     osInfo,\n\t}, nil\n}\n\n// Lstat does not follow symbolic links. Returns the symlink's own metadata\n// when path is a symlink. Per prd002-sys R2.1.\nfunc Lstat(path string) (*FileInfo, error) {\n\tosInfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tvar stat syscall.Stat_t\n\tif err := syscall.Lstat(path, &stat); err != nil {\n\t\treturn nil, err\n\t}\n\n\treturn &FileInfo{\n\t\tMode:    osInfo.Mode(),\n\t\tSize:    stat.Size,\n\t\tNlink:   uint64(stat.Nlink),\n\t\tUid:     stat.Uid,\n\t\tGid:     stat.Gid,\n\t\tRdev:    stat.Rdev,\n\t\tDev:     stat.Dev,\n\t\tIno:     stat.Ino,\n\t\tBlocks:  stat.Blocks,\n\t\tBlksize: int64(stat.Blksize),\n\t\tModTime: time.Unix(stat.Mtim.Sec, stat.Mtim.Nsec),\n\t\tSys:     osInfo,\n\t}, nil\n}\n\n// InstallSIGPIPEHandler installs a SIGPIPE handler causing the process to\n// exit 0 when stdout or stderr is closed by a downstream consumer.\n// Per prd002-sys R3.1.\nfunc InstallSIGPIPEHandler() {\n\tc := make(chan os.Signal, 1)\n\tsignal.Notify(c, syscall.SIGPIPE)\n\tgo func() {\n\t\t<-c\n\t\tos.Exit(0)\n\t}()\n}\n\nvar (\n\tresizeCallbacks []func(int)\n\tresizeMu        sync.Mutex\n\tresizeOnce       sync.Once\n)\n\n// OnTerminalResize registers a SIGWINCH handler. When the terminal is resized,\n// the handler calls TerminalWidth() and invokes the callback with the new width.\n// Per prd002-sys R4.1.\nfunc OnTerminalResize(callback func(width int)) {\n\tresizeMu.Lock()\n\tresizeCallbacks = append(resizeCallbacks, callback)\n\tresizeMu.Unlock()\n\n\tresizeOnce.Do(func() {\n\t\tc := make(chan os.Signal, 1)\n\t\tsignal.Notify(c, syscall.SIGWINCH)\n\t\tgo func() {\n\t\t\tfor range c {\n\t\t\t\tw, err := TerminalWidth()\n\t\t\t\tif err != nil {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tresizeMu.Lock()\n\t\t\t\tcbs := make([]func(int), len(resizeCallbacks))\n\t\t\t\tcopy(cbs, resizeCallbacks)\n\t\t\t\tresizeMu.Unlock()\n\t\t\t\tfor _, cb := range cbs {\n\t\t\t\t\tcb(w)\n\t\t\t\t}\n\t\t\t}\n\t\t}()\n\t})\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":