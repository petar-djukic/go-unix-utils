{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PAVGbC1xgNeV5m95bianRs","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Differential tests for cat core I/O, error handling, line numbering,\n     5→// squeeze, end markers, cross-boundary squeeze, and non-printing display.\n     6→//\n     7→// Implements prd006-cat R1.1, R1.2, R2.1, R2.3, R3.1, R3.2, R4.1, R4.2,\n     8→// R4.3, R4.4, R5.2, R5.3.\n     9→package main\n    10→\n    11→import (\n    12→\t\"bytes\"\n    13→\t\"fmt\"\n    14→\t\"os\"\n    15→\t\"os/exec\"\n    16→\t\"path/filepath\"\n    17→\t\"testing\"\n    18→\n    19→\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n    20→)\n    21→\n    22→// goBinary is the path to the compiled Go cat binary. Set by TestMain.\n    23→var goBinary string\n    24→\n    25→// refBinary is the path to the GNU gcat reference binary. Set by TestMain.\n    26→var refBinary string\n    27→\n    28→// TestMain builds the Go cat binary and locates the gcat reference binary.\n    29→// D2: skip all tests if gcat is not on PATH.\n    30→// D3: build Go cat binary into a temporary directory.\n    31→func TestMain(m *testing.M) {\n    32→\tref, err := exec.LookPath(\"gcat\")\n    33→\tif err != nil {\n    34→\t\tfmt.Fprintln(os.Stderr, \"gcat not found on PATH; skipping cat differential tests\")\n    35→\t\tos.Exit(0)\n    36→\t}\n    37→\trefBinary = ref\n    38→\n    39→\tbinDir, err := os.MkdirTemp(\"\", \"cat-test-*\")\n    40→\tif err != nil {\n    41→\t\tfmt.Fprintf(os.Stderr, \"creating bin dir: %v\\n\", err)\n    42→\t\tos.Exit(1)\n    43→\t}\n    44→\n    45→\tgoBinary = filepath.Join(binDir, \"cat\")\n    46→\tcmd := exec.Command(\"go\", \"build\", \"-o\", goBinary, \".\")\n    47→\tif out, err := cmd.CombinedOutput(); err != nil {\n    48→\t\tfmt.Fprintf(os.Stderr, \"building Go cat binary: %v\\n%s\", err, out)\n    49→\t\tos.RemoveAll(binDir) // best-effort cleanup\n    50→\t\tos.Exit(1)\n    51→\t}\n    52→\n    53→\tcode := m.Run()\n    54→\tos.RemoveAll(binDir) // best-effort cleanup\n    55→\tos.Exit(code)\n    56→}\n    57→\n    58→// writeTestFile creates a file with the given content in dir.\n    59→func writeTestFile(t *testing.T, dir, name, content string) {\n    60→\tt.Helper()\n    61→\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n    62→\t\tt.Fatalf(\"writing test file %s: %v\", name, err)\n    63→\t}\n    64→}\n    65→\n    66→// normalizeProgramName replaces \"gcat: \" with \"cat: \" in output so stderr\n    67→// from the GNU reference binary and the Go binary can be compared.\n    68→func normalizeProgramName(data []byte) []byte {\n    69→\treturn bytes.ReplaceAll(data, []byte(\"gcat: \"), []byte(\"cat: \"))\n    70→}\n    71→\n    72→// TestCatFileRead verifies R1.1: cat reads named files in argument order\n    73→// and writes their contents to stdout.\n    74→func TestCatFileRead(t *testing.T) {\n    75→\tt.Parallel()\n    76→\n    77→\tdir := t.TempDir()\n    78→\twriteTestFile(t, dir, \"file1.txt\", \"hello\\nworld\\n\")\n    79→\twriteTestFile(t, dir, \"file2.txt\", \"foo\\nbar\\n\")\n    80→\n    81→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n    82→\t\t{\n    83→\t\t\tName:     \"single-file\",\n    84→\t\t\tArgs:     []string{\"file1.txt\"},\n    85→\t\t\tWorkDir:  dir,\n    86→\t\t\tExitCode: 0,\n    87→\t\t},\n    88→\t\t{\n    89→\t\t\tName:     \"multi-file-argument-order\",\n    90→\t\t\tArgs:     []string{\"file1.txt\", \"file2.txt\"},\n    91→\t\t\tWorkDir:  dir,\n    92→\t\t\tExitCode: 0,\n    93→\t\t},\n    94→\t})\n    95→}\n    96→\n    97→// TestCatStdinRead verifies R1.2: cat reads from stdin when no file arguments\n    98→// are given and when \"-\" appears as a file argument.\n    99→func TestCatStdinRead(t *testing.T) {\n   100→\tt.Parallel()\n   101→\n   102→\tdir := t.TempDir()\n   103→\twriteTestFile(t, dir, \"before.txt\", \"before\\n\")\n   104→\twriteTestFile(t, dir, \"after.txt\", \"after\\n\")\n   105→\n   106→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   107→\t\t{\n   108→\t\t\tName:     \"stdin-no-args\",\n   109→\t\t\tStdin:    []byte(\"from stdin\\n\"),\n   110→\t\t\tExitCode: 0,\n   111→\t\t},\n   112→\t\t{\n   113→\t\t\tName:     \"stdin-dash-arg\",\n   114→\t\t\tArgs:     []string{\"-\"},\n   115→\t\t\tStdin:    []byte(\"dash stdin\\n\"),\n   116→\t\t\tExitCode: 0,\n   117→\t\t},\n   118→\t\t{\n   119→\t\t\tName:     \"stdin-dash-interspersed\",\n   120→\t\t\tArgs:     []string{\"before.txt\", \"-\", \"after.txt\"},\n   121→\t\t\tStdin:    []byte(\"middle\\n\"),\n   122→\t\t\tWorkDir:  dir,\n   123→\t\t\tExitCode: 0,\n   124→\t\t},\n   125→\t})\n   126→}\n   127→\n   128→// TestCatErrorHandling verifies R5.2 and R5.3: cat writes error messages to\n   129→// stderr for nonexistent files, continues processing remaining arguments, and\n   130→// exits with code 1 when any file produces an error.\n   131→func TestCatErrorHandling(t *testing.T) {\n   132→\tt.Parallel()\n   133→\n   134→\tdir := t.TempDir()\n   135→\twriteTestFile(t, dir, \"real.txt\", \"data\\n\")\n   136→\n   137→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   138→\t\t{\n   139→\t\t\tName:      \"nonexistent-file\",\n   140→\t\t\tArgs:      []string{\"nonexistent.txt\"},\n   141→\t\t\tWorkDir:   dir,\n   142→\t\t\tExitCode:  1,\n   143→\t\t\tNormalize: []testutils.NormalizeFunc{normalizeProgramName},\n   144→\t\t},\n   145→\t\t{\n   146→\t\t\tName:      \"mixed-valid-invalid\",\n   147→\t\t\tArgs:      []string{\"nonexistent.txt\", \"real.txt\"},\n   148→\t\t\tWorkDir:   dir,\n   149→\t\t\tExitCode:  1,\n   150→\t\t\tNormalize: []testutils.NormalizeFunc{normalizeProgramName},\n   151→\t\t},\n   152→\t})\n   153→}\n   154→\n   155→// TestCatLineNumbering verifies R2.1: cat -n numbers all output lines with\n   156→// the format \"%6d\\t\" prefix, including blank lines.\n   157→func TestCatLineNumbering(t *testing.T) {\n   158→\tt.Parallel()\n   159→\n   160→\tdir := t.TempDir()\n   161→\twriteTestFile(t, dir, \"mixed.txt\", \"first\\n\\nsecond\\n\\n\\nthird\\n\")\n   162→\twriteTestFile(t, dir, \"simple.txt\", \"alpha\\nbeta\\n\")\n   163→\n   164→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   165→\t\t{\n   166→\t\t\tName:     \"number-all-lines-with-blanks\",\n   167→\t\t\tArgs:     []string{\"-n\", \"mixed.txt\"},\n   168→\t\t\tWorkDir:  dir,\n   169→\t\t\tExitCode: 0,\n   170→\t\t},\n   171→\t\t{\n   172→\t\t\tName:     \"number-across-files\",\n   173→\t\t\tArgs:     []string{\"-n\", \"simple.txt\", \"mixed.txt\"},\n   174→\t\t\tWorkDir:  dir,\n   175→\t\t\tExitCode: 0,\n   176→\t\t},\n   177→\t})\n   178→}\n   179→\n   180→// TestCatNumberNonblank verifies R2.2 and R2.3: cat -b numbers only non-blank\n   181→// lines, and -b overrides -n when both are given.\n   182→func TestCatNumberNonblank(t *testing.T) {\n   183→\tt.Parallel()\n   184→\n   185→\tdir := t.TempDir()\n   186→\twriteTestFile(t, dir, \"blanks.txt\", \"line1\\n\\n\\nline2\\n\\nline3\\n\")\n   187→\n   188→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   189→\t\t{\n   190→\t\t\tName:     \"number-nonblank-only\",\n   191→\t\t\tArgs:     []string{\"-b\", \"blanks.txt\"},\n   192→\t\t\tWorkDir:  dir,\n   193→\t\t\tExitCode: 0,\n   194→\t\t},\n   195→\t\t{\n   196→\t\t\tName:     \"b-overrides-n\",\n   197→\t\t\tArgs:     []string{\"-b\", \"-n\", \"blanks.txt\"},\n   198→\t\t\tWorkDir:  dir,\n   199→\t\t\tExitCode: 0,\n   200→\t\t},\n   201→\t})\n   202→}\n   203→\n   204→// TestCatSqueeze verifies R3.1: cat -s squeezes runs of consecutive blank\n   205→// lines down to a single blank line.\n   206→func TestCatSqueeze(t *testing.T) {\n   207→\tt.Parallel()\n   208→\n   209→\tdir := t.TempDir()\n   210→\twriteTestFile(t, dir, \"multi-blank.txt\", \"top\\n\\n\\n\\nmiddle\\n\\n\\nbottom\\n\")\n   211→\twriteTestFile(t, dir, \"double-blank.txt\", \"a\\n\\n\\nb\\n\")\n   212→\n   213→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   214→\t\t{\n   215→\t\t\tName:     \"squeeze-multiple-blanks\",\n   216→\t\t\tArgs:     []string{\"-s\", \"multi-blank.txt\"},\n   217→\t\t\tWorkDir:  dir,\n   218→\t\t\tExitCode: 0,\n   219→\t\t},\n   220→\t\t{\n   221→\t\t\tName:     \"squeeze-two-blanks\",\n   222→\t\t\tArgs:     []string{\"-s\", \"double-blank.txt\"},\n   223→\t\t\tWorkDir:  dir,\n   224→\t\t\tExitCode: 0,\n   225→\t\t},\n   226→\t})\n   227→}\n   228→\n   229→// TestCatShowEnds verifies R4.3: cat -E appends a \"$\" character before each\n   230→// newline in the output.\n   231→func TestCatShowEnds(t *testing.T) {\n   232→\tt.Parallel()\n   233→\n   234→\tdir := t.TempDir()\n   235→\twriteTestFile(t, dir, \"lines.txt\", \"hello\\nworld\\n\")\n   236→\twriteTestFile(t, dir, \"with-blanks.txt\", \"first\\n\\nsecond\\n\")\n   237→\n   238→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   239→\t\t{\n   240→\t\t\tName:     \"show-ends-basic\",\n   241→\t\t\tArgs:     []string{\"-E\", \"lines.txt\"},\n   242→\t\t\tWorkDir:  dir,\n   243→\t\t\tExitCode: 0,\n   244→\t\t},\n   245→\t\t{\n   246→\t\t\tName:     \"show-ends-with-blank-lines\",\n   247→\t\t\tArgs:     []string{\"-E\", \"with-blanks.txt\"},\n   248→\t\t\tWorkDir:  dir,\n   249→\t\t\tExitCode: 0,\n   250→\t\t},\n   251→\t})\n   252→}\n   253→\n   254→// TestCatCrossBoundarySqueeze verifies R3.2: when -s is active, squeeze state\n   255→// (prevBlank) persists across file boundaries. Consecutive blank lines spanning\n   256→// two files are collapsed to a single blank line.\n   257→func TestCatCrossBoundarySqueeze(t *testing.T) {\n   258→\tt.Parallel()\n   259→\n   260→\tdir := t.TempDir()\n   261→\t// File A ends with consecutive blank lines; file B starts with blank lines.\n   262→\twriteTestFile(t, dir, \"a.txt\", \"content-a\\n\\n\\n\")\n   263→\twriteTestFile(t, dir, \"b.txt\", \"\\n\\ncontent-b\\n\")\n   264→\t// File C ends with a single blank line; file D starts with one blank line.\n   265→\twriteTestFile(t, dir, \"c.txt\", \"content-c\\n\\n\")\n   266→\twriteTestFile(t, dir, \"d.txt\", \"\\ncontent-d\\n\")\n   267→\n   268→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   269→\t\t{\n   270→\t\t\tName:     \"squeeze-across-files-multiple-blanks\",\n   271→\t\t\tArgs:     []string{\"-s\", \"a.txt\", \"b.txt\"},\n   272→\t\t\tWorkDir:  dir,\n   273→\t\t\tExitCode: 0,\n   274→\t\t},\n   275→\t\t{\n   276→\t\t\tName:     \"squeeze-across-files-single-blanks\",\n   277→\t\t\tArgs:     []string{\"-s\", \"c.txt\", \"d.txt\"},\n   278→\t\t\tWorkDir:  dir,\n   279→\t\t\tExitCode: 0,\n   280→\t\t},\n   281→\t})\n   282→}\n   283→\n   284→// TestCatNonPrintingControl verifies R4.1 for control characters: with -v,\n   285→// bytes 0x01-0x1F (excluding 0x09 tab and 0x0A newline) are displayed as\n   286→// ^A through ^_ caret notation, and byte 0x7F is displayed as ^?.\n   287→func TestCatNonPrintingControl(t *testing.T) {\n   288→\tt.Parallel()\n   289→\n   290→\tdir := t.TempDir()\n   291→\t// 0x01 (^A), 0x02 (^B), 0x1B (^[), 0x1F (^_)\n   292→\twriteTestFile(t, dir, \"control-low.txt\", \"\\x01\\x02\\x1b\\x1f\\n\")\n   293→\t// 0x7F (^?)\n   294→\twriteTestFile(t, dir, \"del.txt\", \"\\x7f\\n\")\n   295→\n   296→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   297→\t\t{\n   298→\t\t\tName:     \"control-chars-caret-notation\",\n   299→\t\t\tArgs:     []string{\"-v\", \"control-low.txt\"},\n   300→\t\t\tWorkDir:  dir,\n   301→\t\t\tExitCode: 0,\n   302→\t\t},\n   303→\t\t{\n   304→\t\t\tName:     \"del-char-caret-question\",\n   305→\t\t\tArgs:     []string{\"-v\", \"del.txt\"},\n   306→\t\t\tWorkDir:  dir,\n   307→\t\t\tExitCode: 0,\n   308→\t\t},\n   309→\t})\n   310→}\n   311→\n   312→// TestCatNonPrintingHighByte verifies R4.1 for high bytes: with -v, bytes in\n   313→// the range 0x80-0xFF are displayed with M- prefix notation. Control-range\n   314→// high bytes (0x80-0x9F) become M-^@ through M-^_, printable-range high bytes\n   315→// (0xA0-0xFE) become M- followed by the character, and 0xFF becomes M-^?.\n   316→func TestCatNonPrintingHighByte(t *testing.T) {\n   317→\tt.Parallel()\n   318→\n   319→\tdir := t.TempDir()\n   320→\t// 0x80 (M-^@), 0x9F (M-^_)\n   321→\twriteTestFile(t, dir, \"high-control.txt\", \"\\x80\\x9f\\n\")\n   322→\t// 0xA0 (M- ), 0xC0 (M-@), 0xFE (M-~)\n   323→\twriteTestFile(t, dir, \"high-printable.txt\", \"\\xa0\\xc0\\xfe\\n\")\n   324→\t// 0xFF (M-^?)\n   325→\twriteTestFile(t, dir, \"high-ff.txt\", \"\\xff\\n\")\n   326→\n   327→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   328→\t\t{\n   329→\t\t\tName:     \"high-control-m-caret\",\n   330→\t\t\tArgs:     []string{\"-v\", \"high-control.txt\"},\n   331→\t\t\tWorkDir:  dir,\n   332→\t\t\tExitCode: 0,\n   333→\t\t},\n   334→\t\t{\n   335→\t\t\tName:     \"high-printable-m-prefix\",\n   336→\t\t\tArgs:     []string{\"-v\", \"high-printable.txt\"},\n   337→\t\t\tWorkDir:  dir,\n   338→\t\t\tExitCode: 0,\n   339→\t\t},\n   340→\t\t{\n   341→\t\t\tName:     \"high-ff-m-caret-question\",\n   342→\t\t\tArgs:     []string{\"-v\", \"high-ff.txt\"},\n   343→\t\t\tWorkDir:  dir,\n   344→\t\t\tExitCode: 0,\n   345→\t\t},\n   346→\t})\n   347→}\n   348→\n   349→// TestCatTabExemptFromV verifies R4.2: when only -v is given without -T,\n   350→// tab characters (0x09) pass through unchanged in the output.\n   351→func TestCatTabExemptFromV(t *testing.T) {\n   352→\tt.Parallel()\n   353→\n   354→\tdir := t.TempDir()\n   355→\twriteTestFile(t, dir, \"tabs.txt\", \"before\\tafter\\n\\t\\tindented\\n\")\n   356→\n   357→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   358→\t\t{\n   359→\t\t\tName:     \"v-preserves-tabs\",\n   360→\t\t\tArgs:     []string{\"-v\", \"tabs.txt\"},\n   361→\t\t\tWorkDir:  dir,\n   362→\t\t\tExitCode: 0,\n   363→\t\t},\n   364→\t})\n   365→}\n   366→\n   367→// TestCatShowTabs verifies R4.4: when -T is active, tab characters are\n   368→// displayed as ^I. Tests both -T alone and -T combined with -v.\n   369→func TestCatShowTabs(t *testing.T) {\n   370→\tt.Parallel()\n   371→\n   372→\tdir := t.TempDir()\n   373→\twriteTestFile(t, dir, \"tabs.txt\", \"col1\\tcol2\\n\\tindented\\n\")\n   374→\n   375→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   376→\t\t{\n   377→\t\t\tName:     \"show-tabs-standalone\",\n   378→\t\t\tArgs:     []string{\"-T\", \"tabs.txt\"},\n   379→\t\t\tWorkDir:  dir,\n   380→\t\t\tExitCode: 0,\n   381→\t\t},\n   382→\t\t{\n   383→\t\t\tName:     \"show-tabs-with-v\",\n   384→\t\t\tArgs:     []string{\"-T\", \"-v\", \"tabs.txt\"},\n   385→\t\t\tWorkDir:  dir,\n   386→\t\t\tExitCode: 0,\n   387→\t\t},\n   388→\t})\n   389→}\n   390→"}]},"parent_tool_use_id":null,"session_id":"f7a4f29b-051b-4694-b4bd-8b5a491bc4bf","uuid":"92ae79bb-978c-48f2-822e-59aec8a05e61","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/253/cmd/cat/cat_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Differential tests for cat core I/O, error handling, line numbering,\n// squeeze, end markers, cross-boundary squeeze, and non-printing display.\n//\n// Implements prd006-cat R1.1, R1.2, R2.1, R2.3, R3.1, R3.2, R4.1, R4.2,\n// R4.3, R4.4, R5.2, R5.3.\npackage main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\n// goBinary is the path to the compiled Go cat binary. Set by TestMain.\nvar goBinary string\n\n// refBinary is the path to the GNU gcat reference binary. Set by TestMain.\nvar refBinary string\n\n// TestMain builds the Go cat binary and locates the gcat reference binary.\n// D2: skip all tests if gcat is not on PATH.\n// D3: build Go cat binary into a temporary directory.\nfunc TestMain(m *testing.M) {\n\tref, err := exec.LookPath(\"gcat\")\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, \"gcat not found on PATH; skipping cat differential tests\")\n\t\tos.Exit(0)\n\t}\n\trefBinary = ref\n\n\tbinDir, err := os.MkdirTemp(\"\", \"cat-test-*\")\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"creating bin dir: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tgoBinary = filepath.Join(binDir, \"cat\")\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", goBinary, \".\")\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"building Go cat binary: %v\\n%s\", err, out)\n\t\tos.RemoveAll(binDir) // best-effort cleanup\n\t\tos.Exit(1)\n\t}\n\n\tcode := m.Run()\n\tos.RemoveAll(binDir) // best-effort cleanup\n\tos.Exit(code)\n}\n\n// writeTestFile creates a file with the given content in dir.\nfunc writeTestFile(t *testing.T, dir, name, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n\t\tt.Fatalf(\"writing test file %s: %v\", name, err)\n\t}\n}\n\n// normalizeProgramName replaces \"gcat: \" with \"cat: \" in output so stderr\n// from the GNU reference binary and the Go binary can be compared.\nfunc normalizeProgramName(data []byte) []byte {\n\treturn bytes.ReplaceAll(data, []byte(\"gcat: \"), []byte(\"cat: \"))\n}\n\n// TestCatFileRead verifies R1.1: cat reads named files in argument order\n// and writes their contents to stdout.\nfunc TestCatFileRead(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"file1.txt\", \"hello\\nworld\\n\")\n\twriteTestFile(t, dir, \"file2.txt\", \"foo\\nbar\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"single-file\",\n\t\t\tArgs:     []string{\"file1.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"multi-file-argument-order\",\n\t\t\tArgs:     []string{\"file1.txt\", \"file2.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatStdinRead verifies R1.2: cat reads from stdin when no file arguments\n// are given and when \"-\" appears as a file argument.\nfunc TestCatStdinRead(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"before.txt\", \"before\\n\")\n\twriteTestFile(t, dir, \"after.txt\", \"after\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"stdin-no-args\",\n\t\t\tStdin:    []byte(\"from stdin\\n\"),\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"stdin-dash-arg\",\n\t\t\tArgs:     []string{\"-\"},\n\t\t\tStdin:    []byte(\"dash stdin\\n\"),\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"stdin-dash-interspersed\",\n\t\t\tArgs:     []string{\"before.txt\", \"-\", \"after.txt\"},\n\t\t\tStdin:    []byte(\"middle\\n\"),\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatErrorHandling verifies R5.2 and R5.3: cat writes error messages to\n// stderr for nonexistent files, continues processing remaining arguments, and\n// exits with code 1 when any file produces an error.\nfunc TestCatErrorHandling(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"real.txt\", \"data\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:      \"nonexistent-file\",\n\t\t\tArgs:      []string{\"nonexistent.txt\"},\n\t\t\tWorkDir:   dir,\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeProgramName},\n\t\t},\n\t\t{\n\t\t\tName:      \"mixed-valid-invalid\",\n\t\t\tArgs:      []string{\"nonexistent.txt\", \"real.txt\"},\n\t\t\tWorkDir:   dir,\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeProgramName},\n\t\t},\n\t})\n}\n\n// TestCatLineNumbering verifies R2.1: cat -n numbers all output lines with\n// the format \"%6d\\t\" prefix, including blank lines.\nfunc TestCatLineNumbering(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"mixed.txt\", \"first\\n\\nsecond\\n\\n\\nthird\\n\")\n\twriteTestFile(t, dir, \"simple.txt\", \"alpha\\nbeta\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"number-all-lines-with-blanks\",\n\t\t\tArgs:     []string{\"-n\", \"mixed.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"number-across-files\",\n\t\t\tArgs:     []string{\"-n\", \"simple.txt\", \"mixed.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatNumberNonblank verifies R2.2 and R2.3: cat -b numbers only non-blank\n// lines, and -b overrides -n when both are given.\nfunc TestCatNumberNonblank(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"blanks.txt\", \"line1\\n\\n\\nline2\\n\\nline3\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"number-nonblank-only\",\n\t\t\tArgs:     []string{\"-b\", \"blanks.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"b-overrides-n\",\n\t\t\tArgs:     []string{\"-b\", \"-n\", \"blanks.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatSqueeze verifies R3.1: cat -s squeezes runs of consecutive blank\n// lines down to a single blank line.\nfunc TestCatSqueeze(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"multi-blank.txt\", \"top\\n\\n\\n\\nmiddle\\n\\n\\nbottom\\n\")\n\twriteTestFile(t, dir, \"double-blank.txt\", \"a\\n\\n\\nb\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"squeeze-multiple-blanks\",\n\t\t\tArgs:     []string{\"-s\", \"multi-blank.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"squeeze-two-blanks\",\n\t\t\tArgs:     []string{\"-s\", \"double-blank.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatShowEnds verifies R4.3: cat -E appends a \"$\" character before each\n// newline in the output.\nfunc TestCatShowEnds(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"lines.txt\", \"hello\\nworld\\n\")\n\twriteTestFile(t, dir, \"with-blanks.txt\", \"first\\n\\nsecond\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"show-ends-basic\",\n\t\t\tArgs:     []string{\"-E\", \"lines.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"show-ends-with-blank-lines\",\n\t\t\tArgs:     []string{\"-E\", \"with-blanks.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatCrossBoundarySqueeze verifies R3.2: when -s is active, squeeze state\n// (prevBlank) persists across file boundaries. Consecutive blank lines spanning\n// two files are collapsed to a single blank line.\nfunc TestCatCrossBoundarySqueeze(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\t// File A ends with consecutive blank lines; file B starts with blank lines.\n\twriteTestFile(t, dir, \"a.txt\", \"content-a\\n\\n\\n\")\n\twriteTestFile(t, dir, \"b.txt\", \"\\n\\ncontent-b\\n\")\n\t// File C ends with a single blank line; file D starts with one blank line.\n\twriteTestFile(t, dir, \"c.txt\", \"content-c\\n\\n\")\n\twriteTestFile(t, dir, \"d.txt\", \"\\ncontent-d\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"squeeze-across-files-multiple-blanks\",\n\t\t\tArgs:     []string{\"-s\", \"a.txt\", \"b.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"squeeze-across-files-single-blanks\",\n\t\t\tArgs:     []string{\"-s\", \"c.txt\", \"d.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatNonPrintingControl verifies R4.1 for control characters: with -v,\n// bytes 0x01-0x1F (excluding 0x09 tab and 0x0A newline) are displayed as\n// ^A through ^_ caret notation, and byte 0x7F is displayed as ^?.\nfunc TestCatNonPrintingControl(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\t// 0x01 (^A), 0x02 (^B), 0x1B (^[), 0x1F (^_)\n\twriteTestFile(t, dir, \"control-low.txt\", \"\\x01\\x02\\x1b\\x1f\\n\")\n\t// 0x7F (^?)\n\twriteTestFile(t, dir, \"del.txt\", \"\\x7f\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"control-chars-caret-notation\",\n\t\t\tArgs:     []string{\"-v\", \"control-low.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"del-char-caret-question\",\n\t\t\tArgs:     []string{\"-v\", \"del.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatNonPrintingHighByte verifies R4.1 for high bytes: with -v, bytes in\n// the range 0x80-0xFF are displayed with M- prefix notation. Control-range\n// high bytes (0x80-0x9F) become M-^@ through M-^_, printable-range high bytes\n// (0xA0-0xFE) become M- followed by the character, and 0xFF becomes M-^?.\nfunc TestCatNonPrintingHighByte(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\t// 0x80 (M-^@), 0x9F (M-^_)\n\twriteTestFile(t, dir, \"high-control.txt\", \"\\x80\\x9f\\n\")\n\t// 0xA0 (M- ), 0xC0 (M-@), 0xFE (M-~)\n\twriteTestFile(t, dir, \"high-printable.txt\", \"\\xa0\\xc0\\xfe\\n\")\n\t// 0xFF (M-^?)\n\twriteTestFile(t, dir, \"high-ff.txt\", \"\\xff\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"high-control-m-caret\",\n\t\t\tArgs:     []string{\"-v\", \"high-control.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"high-printable-m-prefix\",\n\t\t\tArgs:     []string{\"-v\", \"high-printable.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"high-ff-m-caret-question\",\n\t\t\tArgs:     []string{\"-v\", \"high-ff.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatTabExemptFromV verifies R4.2: when only -v is given without -T,\n// tab characters (0x09) pass through unchanged in the output.\nfunc TestCatTabExemptFromV(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"tabs.txt\", \"before\\tafter\\n\\t\\tindented\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"v-preserves-tabs\",\n\t\t\tArgs:     []string{\"-v\", \"tabs.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestCatShowTabs verifies R4.4: when -T is active, tab characters are\n// displayed as ^I. Tests both -T alone and -T combined with -v.\nfunc TestCatShowTabs(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\twriteTestFile(t, dir, \"tabs.txt\", \"col1\\tcol2\\n\\tindented\\n\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"show-tabs-standalone\",\n\t\t\tArgs:     []string{\"-T\", \"tabs.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"show-tabs-with-v\",\n\t\t\tArgs:     []string{\"-T\", \"-v\", \"tabs.txt\"},\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n","numLines":390,"startLine":1,"totalLines":390}}}
