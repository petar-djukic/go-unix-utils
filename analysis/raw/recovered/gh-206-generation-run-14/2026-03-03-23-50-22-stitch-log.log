{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BniodQg5r9runnfpvmGwN4","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Differential tests for du core disk usage reporting.\n     5→//\n     6→// Implements prd009-du R1.1, R1.2, R1.3, R1.5.\n     7→package main\n     8→\n     9→import (\n    10→\t\"bytes\"\n    11→\t\"fmt\"\n    12→\t\"os\"\n    13→\t\"os/exec\"\n    14→\t\"path/filepath\"\n    15→\t\"testing\"\n    16→\n    17→\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n    18→)\n    19→\n    20→// goBinary is the path to the compiled Go du binary. Set by TestMain.\n    21→var goBinary string\n    22→\n    23→// refBinary is the path to the GNU gdu reference binary. Set by TestMain.\n    24→var refBinary string\n    25→\n    26→// TestMain builds the Go du binary and locates the gdu reference binary.\n    27→// D1: skip all tests if gdu is not on PATH.\n    28→// D1: build Go du binary into a temporary directory.\n    29→func TestMain(m *testing.M) {\n    30→\tref, err := exec.LookPath(\"gdu\")\n    31→\tif err != nil {\n    32→\t\tfmt.Fprintln(os.Stderr, \"gdu not found on PATH; skipping du differential tests\")\n    33→\t\tos.Exit(0)\n    34→\t}\n    35→\trefBinary = ref\n    36→\n    37→\tbinDir, err := os.MkdirTemp(\"\", \"du-test-*\")\n    38→\tif err != nil {\n    39→\t\tfmt.Fprintf(os.Stderr, \"creating bin dir: %v\\n\", err)\n    40→\t\tos.Exit(1)\n    41→\t}\n    42→\n    43→\tgoBinary = filepath.Join(binDir, \"du\")\n    44→\tcmd := exec.Command(\"go\", \"build\", \"-o\", goBinary, \".\")\n    45→\tif out, err := cmd.CombinedOutput(); err != nil {\n    46→\t\tfmt.Fprintf(os.Stderr, \"building Go du binary: %v\\n%s\", err, out)\n    47→\t\tos.RemoveAll(binDir) // best-effort cleanup\n    48→\t\tos.Exit(1)\n    49→\t}\n    50→\n    51→\tcode := m.Run()\n    52→\tos.RemoveAll(binDir) // best-effort cleanup\n    53→\tos.Exit(code)\n    54→}\n    55→\n    56→// writeTestFile creates a file with the given content in dir.\n    57→func writeTestFile(t *testing.T, dir, name, content string) {\n    58→\tt.Helper()\n    59→\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n    60→\t\tt.Fatalf(\"writing test file %s: %v\", name, err)\n    61→\t}\n    62→}\n    63→\n    64→// normalizeProgramName replaces \"gdu: \" with \"du: \" in output so stderr\n    65→// from the GNU reference binary and the Go binary can be compared.\n    66→func normalizeProgramName(data []byte) []byte {\n    67→\treturn bytes.ReplaceAll(data, []byte(\"gdu: \"), []byte(\"du: \"))\n    68→}\n    69→\n    70→// buildDirTree creates a two-level directory tree for testing recursive\n    71→// traversal. The tree has the structure:\n    72→//\n    73→//\troot/\n    74→//\t  file1.txt  (small file)\n    75→//\t  sub/\n    76→//\t    file2.txt  (small file)\n    77→//\t    deep/\n    78→//\t      file3.txt  (small file)\n    79→//\n    80→// D3: at least two levels of nesting to exercise walkDir recursion.\n    81→func buildDirTree(t *testing.T, root string) {\n    82→\tt.Helper()\n    83→\tsub := filepath.Join(root, \"sub\")\n    84→\tdeep := filepath.Join(sub, \"deep\")\n    85→\tif err := os.MkdirAll(deep, 0o755); err != nil {\n    86→\t\tt.Fatalf(\"creating directory tree: %v\", err)\n    87→\t}\n    88→\twriteTestFile(t, root, \"file1.txt\", \"hello world\\n\")\n    89→\twriteTestFile(t, sub, \"file2.txt\", \"second file content\\n\")\n    90→\twriteTestFile(t, deep, \"file3.txt\", \"deep nested file\\n\")\n    91→}\n    92→\n    93→// buildFlatDir creates a single directory containing only files (no\n    94→// subdirectories) for testing flat directory traversal.\n    95→//\n    96→//\troot/\n    97→//\t  a.txt\n    98→//\t  b.txt\n    99→func buildFlatDir(t *testing.T, root string) {\n   100→\tt.Helper()\n   101→\twriteTestFile(t, root, \"a.txt\", \"alpha\\n\")\n   102→\twriteTestFile(t, root, \"b.txt\", \"bravo content here\\n\")\n   103→}\n   104→\n   105→// TestDuFlatDirectory verifies R1.1 and R1.3: du on a directory containing\n   106→// only files (no subdirectories) prints a single line for the directory itself.\n   107→func TestDuFlatDirectory(t *testing.T) {\n   108→\tt.Parallel()\n   109→\n   110→\tdir := t.TempDir()\n   111→\tbuildFlatDir(t, dir)\n   112→\n   113→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   114→\t\t{\n   115→\t\t\tName:     \"flat-directory\",\n   116→\t\t\tArgs:     []string{dir},\n   117→\t\t\tExitCode: 0,\n   118→\t\t},\n   119→\t})\n   120→}\n   121→\n   122→// TestDuRecursiveTraversal verifies R1.1: du recurses into each directory\n   123→// and prints accumulated size for each subdirectory and the directory itself.\n   124→// Also exercises R1.2 (block unit display) and R1.3 (SIZE\\tPATH format)\n   125→// since RunDiffTests compares stdout byte-for-byte.\n   126→func TestDuRecursiveTraversal(t *testing.T) {\n   127→\tt.Parallel()\n   128→\n   129→\tdir := t.TempDir()\n   130→\tbuildDirTree(t, dir)\n   131→\n   132→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   133→\t\t{\n   134→\t\t\tName:     \"recursive-directory-tree\",\n   135→\t\t\tArgs:     []string{dir},\n   136→\t\t\tExitCode: 0,\n   137→\t\t},\n   138→\t})\n   139→}\n   140→\n   141→// TestDuBlockUnits verifies R1.2: both binaries report identical block counts\n   142→// for the same directory tree, confirming the Go implementation's 512-to-1024\n   143→// block conversion matches the reference binary. The byte-for-byte stdout\n   144→// comparison in RunDiffTests confirms block counts agree.\n   145→func TestDuBlockUnits(t *testing.T) {\n   146→\tt.Parallel()\n   147→\n   148→\tdir := t.TempDir()\n   149→\tbuildDirTree(t, dir)\n   150→\n   151→\t// Run on a subdirectory to verify block counts at a different tree level.\n   152→\tsub := filepath.Join(dir, \"sub\")\n   153→\n   154→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   155→\t\t{\n   156→\t\t\tName:     \"block-units-subdirectory\",\n   157→\t\t\tArgs:     []string{sub},\n   158→\t\t\tExitCode: 0,\n   159→\t\t},\n   160→\t})\n   161→}\n   162→\n   163→// TestDuOutputFormat verifies R1.3: each output line is \"SIZE\\tPATH\\n\" for both\n   164→// directory and non-directory file arguments.\n   165→// D3: tests both directory and non-directory arguments to exercise both branches\n   166→// of duArg.\n   167→func TestDuOutputFormat(t *testing.T) {\n   168→\tt.Parallel()\n   169→\n   170→\tdir := t.TempDir()\n   171→\tbuildDirTree(t, dir)\n   172→\n   173→\tfilePath := filepath.Join(dir, \"file1.txt\")\n   174→\n   175→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   176→\t\t{\n   177→\t\t\tName:     \"format-directory-arg\",\n   178→\t\t\tArgs:     []string{dir},\n   179→\t\t\tExitCode: 0,\n   180→\t\t},\n   181→\t\t{\n   182→\t\t\tName:     \"format-non-directory-arg\",\n   183→\t\t\tArgs:     []string{filePath},\n   184→\t\t\tExitCode: 0,\n   185→\t\t},\n   186→\t})\n   187→}\n   188→\n   189→// TestDuDefaultArgument verifies R1.5: when no arguments are given, du defaults\n   190→// to \".\". Run both binaries with no arguments inside a temporary directory and\n   191→// verify identical output.\n   192→func TestDuDefaultArgument(t *testing.T) {\n   193→\tt.Parallel()\n   194→\n   195→\tdir := t.TempDir()\n   196→\tbuildDirTree(t, dir)\n   197→\n   198→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   199→\t\t{\n   200→\t\t\tName:     \"default-current-directory\",\n   201→\t\t\tWorkDir:  dir,\n   202→\t\t\tExitCode: 0,\n   203→\t\t},\n   204→\t})\n   205→}\n   206→\n   207→// TestDuMultipleArguments verifies R1.5: multiple directory arguments are\n   208→// processed in command-line order, each traversed independently.\n   209→func TestDuMultipleArguments(t *testing.T) {\n   210→\tt.Parallel()\n   211→\n   212→\tdir := t.TempDir()\n   213→\tbuildDirTree(t, dir)\n   214→\n   215→\tsub := filepath.Join(dir, \"sub\")\n   216→\tdeep := filepath.Join(dir, \"sub\", \"deep\")\n   217→\n   218→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   219→\t\t{\n   220→\t\t\tName:     \"multiple-directory-args\",\n   221→\t\t\tArgs:     []string{sub, deep},\n   222→\t\t\tExitCode: 0,\n   223→\t\t},\n   224→\t})\n   225→}\n   226→\n   227→// TestDuNonexistentArgument verifies R4.1 and R4.2: du exits 1 for a\n   228→// nonexistent path and prints a diagnostic to stderr.\n   229→func TestDuNonexistentArgument(t *testing.T) {\n   230→\tt.Parallel()\n   231→\n   232→\tdir := t.TempDir()\n   233→\n   234→\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n   235→\t\t{\n   236→\t\t\tName:      \"nonexistent-path\",\n   237→\t\t\tArgs:      []string{filepath.Join(dir, \"does-not-exist\")},\n   238→\t\t\tExitCode:  1,\n   239→\t\t\tNormalize: []testutils.NormalizeFunc{normalizeProgramName},\n   240→\t\t},\n   241→\t})\n   242→}\n   243→"}]},"parent_tool_use_id":null,"session_id":"ec06f708-4b1f-4231-b67c-b6b5518fae70","uuid":"e73ac2f3-f916-4dff-ae10-5f3180ab0bd4","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/259/cmd/du/du_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Differential tests for du core disk usage reporting.\n//\n// Implements prd009-du R1.1, R1.2, R1.3, R1.5.\npackage main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\n// goBinary is the path to the compiled Go du binary. Set by TestMain.\nvar goBinary string\n\n// refBinary is the path to the GNU gdu reference binary. Set by TestMain.\nvar refBinary string\n\n// TestMain builds the Go du binary and locates the gdu reference binary.\n// D1: skip all tests if gdu is not on PATH.\n// D1: build Go du binary into a temporary directory.\nfunc TestMain(m *testing.M) {\n\tref, err := exec.LookPath(\"gdu\")\n\tif err != nil {\n\t\tfmt.Fprintln(os.Stderr, \"gdu not found on PATH; skipping du differential tests\")\n\t\tos.Exit(0)\n\t}\n\trefBinary = ref\n\n\tbinDir, err := os.MkdirTemp(\"\", \"du-test-*\")\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"creating bin dir: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tgoBinary = filepath.Join(binDir, \"du\")\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", goBinary, \".\")\n\tif out, err := cmd.CombinedOutput(); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"building Go du binary: %v\\n%s\", err, out)\n\t\tos.RemoveAll(binDir) // best-effort cleanup\n\t\tos.Exit(1)\n\t}\n\n\tcode := m.Run()\n\tos.RemoveAll(binDir) // best-effort cleanup\n\tos.Exit(code)\n}\n\n// writeTestFile creates a file with the given content in dir.\nfunc writeTestFile(t *testing.T, dir, name, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n\t\tt.Fatalf(\"writing test file %s: %v\", name, err)\n\t}\n}\n\n// normalizeProgramName replaces \"gdu: \" with \"du: \" in output so stderr\n// from the GNU reference binary and the Go binary can be compared.\nfunc normalizeProgramName(data []byte) []byte {\n\treturn bytes.ReplaceAll(data, []byte(\"gdu: \"), []byte(\"du: \"))\n}\n\n// buildDirTree creates a two-level directory tree for testing recursive\n// traversal. The tree has the structure:\n//\n//\troot/\n//\t  file1.txt  (small file)\n//\t  sub/\n//\t    file2.txt  (small file)\n//\t    deep/\n//\t      file3.txt  (small file)\n//\n// D3: at least two levels of nesting to exercise walkDir recursion.\nfunc buildDirTree(t *testing.T, root string) {\n\tt.Helper()\n\tsub := filepath.Join(root, \"sub\")\n\tdeep := filepath.Join(sub, \"deep\")\n\tif err := os.MkdirAll(deep, 0o755); err != nil {\n\t\tt.Fatalf(\"creating directory tree: %v\", err)\n\t}\n\twriteTestFile(t, root, \"file1.txt\", \"hello world\\n\")\n\twriteTestFile(t, sub, \"file2.txt\", \"second file content\\n\")\n\twriteTestFile(t, deep, \"file3.txt\", \"deep nested file\\n\")\n}\n\n// buildFlatDir creates a single directory containing only files (no\n// subdirectories) for testing flat directory traversal.\n//\n//\troot/\n//\t  a.txt\n//\t  b.txt\nfunc buildFlatDir(t *testing.T, root string) {\n\tt.Helper()\n\twriteTestFile(t, root, \"a.txt\", \"alpha\\n\")\n\twriteTestFile(t, root, \"b.txt\", \"bravo content here\\n\")\n}\n\n// TestDuFlatDirectory verifies R1.1 and R1.3: du on a directory containing\n// only files (no subdirectories) prints a single line for the directory itself.\nfunc TestDuFlatDirectory(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\tbuildFlatDir(t, dir)\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"flat-directory\",\n\t\t\tArgs:     []string{dir},\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestDuRecursiveTraversal verifies R1.1: du recurses into each directory\n// and prints accumulated size for each subdirectory and the directory itself.\n// Also exercises R1.2 (block unit display) and R1.3 (SIZE\\tPATH format)\n// since RunDiffTests compares stdout byte-for-byte.\nfunc TestDuRecursiveTraversal(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\tbuildDirTree(t, dir)\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"recursive-directory-tree\",\n\t\t\tArgs:     []string{dir},\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestDuBlockUnits verifies R1.2: both binaries report identical block counts\n// for the same directory tree, confirming the Go implementation's 512-to-1024\n// block conversion matches the reference binary. The byte-for-byte stdout\n// comparison in RunDiffTests confirms block counts agree.\nfunc TestDuBlockUnits(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\tbuildDirTree(t, dir)\n\n\t// Run on a subdirectory to verify block counts at a different tree level.\n\tsub := filepath.Join(dir, \"sub\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"block-units-subdirectory\",\n\t\t\tArgs:     []string{sub},\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestDuOutputFormat verifies R1.3: each output line is \"SIZE\\tPATH\\n\" for both\n// directory and non-directory file arguments.\n// D3: tests both directory and non-directory arguments to exercise both branches\n// of duArg.\nfunc TestDuOutputFormat(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\tbuildDirTree(t, dir)\n\n\tfilePath := filepath.Join(dir, \"file1.txt\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"format-directory-arg\",\n\t\t\tArgs:     []string{dir},\n\t\t\tExitCode: 0,\n\t\t},\n\t\t{\n\t\t\tName:     \"format-non-directory-arg\",\n\t\t\tArgs:     []string{filePath},\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestDuDefaultArgument verifies R1.5: when no arguments are given, du defaults\n// to \".\". Run both binaries with no arguments inside a temporary directory and\n// verify identical output.\nfunc TestDuDefaultArgument(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\tbuildDirTree(t, dir)\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"default-current-directory\",\n\t\t\tWorkDir:  dir,\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestDuMultipleArguments verifies R1.5: multiple directory arguments are\n// processed in command-line order, each traversed independently.\nfunc TestDuMultipleArguments(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\tbuildDirTree(t, dir)\n\n\tsub := filepath.Join(dir, \"sub\")\n\tdeep := filepath.Join(dir, \"sub\", \"deep\")\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:     \"multiple-directory-args\",\n\t\t\tArgs:     []string{sub, deep},\n\t\t\tExitCode: 0,\n\t\t},\n\t})\n}\n\n// TestDuNonexistentArgument verifies R4.1 and R4.2: du exits 1 for a\n// nonexistent path and prints a diagnostic to stderr.\nfunc TestDuNonexistentArgument(t *testing.T) {\n\tt.Parallel()\n\n\tdir := t.TempDir()\n\n\ttestutils.RunDiffTests(t, goBinary, refBinary, []testutils.DiffTest{\n\t\t{\n\t\t\tName:      \"nonexistent-path\",\n\t\t\tArgs:      []string{filepath.Join(dir, \"does-not-exist\")},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeProgramName},\n\t\t},\n\t})\n}\n","numLines":243,"startLine":1,"totalLines":243}}}
