{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LCrdNjvUZCVvL81XkhepxJ","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package main implements the du utility for reporting recursive directory\n     5→// disk usage.\n     6→//\n     7→// Implements prd009-du (R1.1, R1.2, R1.3, R1.4, R1.5, R4.1, R4.2, R5.1).\n     8→package main\n     9→\n    10→import (\n    11→\t\"errors\"\n    12→\t\"flag\"\n    13→\t\"fmt\"\n    14→\t\"os\"\n    15→\t\"os/signal\"\n    16→\t\"syscall\"\n    17→\n    18→\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n    19→)\n    20→\n    21→// options holds the parsed command-line flags for du.\n    22→// D3: scaffolding for future flags (-a, -s, -h, -c, -k, -d, etc.).\n    23→type options struct{}\n    24→\n    25→// reportError writes a du-style error message to stderr.\n    26→// R4.2: per-path error messages to stderr.\n    27→func reportError(path string, err error) {\n    28→\tvar pathErr *os.PathError\n    29→\tif errors.As(err, &pathErr) {\n    30→\t\tfmt.Fprintf(os.Stderr, \"du: %s: %v\\n\", path, pathErr.Err)\n    31→\t} else {\n    32→\t\tfmt.Fprintf(os.Stderr, \"du: %s: %v\\n\", path, err)\n    33→\t}\n    34→}\n    35→\n    36→// duArg processes a single command-line argument.\n    37→// R1.1: reads named paths in argument order.\n    38→// R1.5: each argument is traversed independently.\n    39→func duArg(arg string, opts *options) error {\n    40→\tinfo, err := os.Lstat(arg)\n    41→\tif err != nil {\n    42→\t\treportError(arg, err)\n    43→\t\treturn err\n    44→\t}\n    45→\n    46→\tif !info.IsDir() {\n    47→\t\t// Non-directory argument: print its own block count as a single line.\n    48→\t\tmeta, err := sys.Lstat(arg)\n    49→\t\tif err != nil {\n    50→\t\t\treportError(arg, err)\n    51→\t\t\treturn err\n    52→\t\t}\n    53→\t\tfmt.Printf(\"%d\\t%s\\n\", displayBlocks(meta.Blocks()), arg)\n    54→\t\treturn nil\n    55→\t}\n    56→\n    57→\t// Directory: depth-first traversal printing per-directory subtotals.\n    58→\t_, hasErr := walkDir(arg, opts)\n    59→\tif hasErr {\n    60→\t\treturn fmt.Errorf(\"errors during traversal of %s\", arg)\n    61→\t}\n    62→\treturn nil\n    63→}\n    64→\n    65→// walkDir recursively traverses a directory, accumulating 512-byte block\n    66→// counts bottom-up. Returns the total raw block count for the subtree and\n    67→// whether any error occurred during traversal.\n    68→// R1.1: recurse into each directory and print accumulated size.\n    69→// R1.4: does not follow symbolic links (uses sys.Lstat and DirEntry.IsDir).\n    70→func walkDir(dirPath string, opts *options) (int64, bool) {\n    71→\tvar totalBlocks int64\n    72→\thasErr := false\n    73→\n    74→\t// D1: use pkg/sys.Lstat to obtain the directory's own 512-byte block count.\n    75→\tmeta, err := sys.Lstat(dirPath)\n    76→\tif err != nil {\n    77→\t\treportError(dirPath, err)\n    78→\t\treturn 0, true\n    79→\t}\n    80→\ttotalBlocks += meta.Blocks()\n    81→\n    82→\t// D1: use os.ReadDir for directory listing; DirEntry.IsDir() uses d_type\n    83→\t// from the dirent to avoid a second stat call per entry.\n    84→\tentries, readErr := os.ReadDir(dirPath)\n    85→\tif readErr != nil {\n    86→\t\treportError(dirPath, readErr)\n    87→\t\thasErr = true\n    88→\t}\n    89→\n    90→\tfor _, entry := range entries {\n    91→\t\tchildPath := joinPath(dirPath, entry.Name())\n    92→\n    93→\t\tif entry.IsDir() {\n    94→\t\t\tsubtotal, childErr := walkDir(childPath, opts)\n    95→\t\t\ttotalBlocks += subtotal\n    96→\t\t\tif childErr {\n    97→\t\t\t\thasErr = true\n    98→\t\t\t}\n    99→\t\t} else {\n   100→\t\t\t// Non-directory: count blocks but do not print in default mode.\n   101→\t\t\tchildMeta, err := sys.Lstat(childPath)\n   102→\t\t\tif err != nil {\n   103→\t\t\t\treportError(childPath, err)\n   104→\t\t\t\thasErr = true\n   105→\t\t\t\tcontinue\n   106→\t\t\t}\n   107→\t\t\ttotalBlocks += childMeta.Blocks()\n   108→\t\t}\n   109→\t}\n   110→\n   111→\t// R1.3: print SIZE\\tPATH for this directory.\n   112→\t// R1.2: convert from 512-byte blocks to 1024-byte display units.\n   113→\tfmt.Printf(\"%d\\t%s\\n\", displayBlocks(totalBlocks), dirPath)\n   114→\treturn totalBlocks, hasErr\n   115→}\n   116→\n   117→// joinPath constructs a child path by appending name to a directory path,\n   118→// preserving the argument prefix as given on the command line. Unlike\n   119→// filepath.Join, this does not clean the path (filepath.Join strips \"./\"\n   120→// prefixes, which changes du output).\n   121→func joinPath(dir, name string) string {\n   122→\tif dir[len(dir)-1] == '/' {\n   123→\t\treturn dir + name\n   124→\t}\n   125→\treturn dir + \"/\" + name\n   126→}\n   127→\n   128→// displayBlocks converts a 512-byte block count to 1024-byte display units\n   129→// using integer ceiling division: (rawBlocks + 1) / 2.\n   130→// R1.2: 1024-byte block units by default.\n   131→func displayBlocks(rawBlocks int64) int64 {\n   132→\treturn (rawBlocks + 1) / 2\n   133→}\n   134→\n   135→func main() {\n   136→\t// R5.1: handle SIGPIPE by exiting cleanly.\n   137→\tsigpipe := make(chan os.Signal, 1)\n   138→\tsignal.Notify(sigpipe, syscall.SIGPIPE)\n   139→\tgo func() {\n   140→\t\t<-sigpipe\n   141→\t\tos.Exit(0)\n   142→\t}()\n   143→\n   144→\tvar opts options\n   145→\tflag.Parse()\n   146→\n   147→\t// R1.5: process arguments in command-line order; default to \".\".\n   148→\targs := flag.Args()\n   149→\tif len(args) == 0 {\n   150→\t\targs = []string{\".\"}\n   151→\t}\n   152→\n   153→\texitCode := 0\n   154→\tfor _, arg := range args {\n   155→\t\tif err := duArg(arg, &opts); err != nil {\n   156→\t\t\texitCode = 1\n   157→\t\t}\n   158→\t}\n   159→\n   160→\tos.Exit(exitCode)\n   161→}\n   162→"}]},"parent_tool_use_id":null,"session_id":"2111581c-5ab1-41cd-b38c-38140798a1e8","uuid":"2f17bd1a-6f3d-4d8a-9fe9-3b12f23d3706","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/237/cmd/du/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements the du utility for reporting recursive directory\n// disk usage.\n//\n// Implements prd009-du (R1.1, R1.2, R1.3, R1.4, R1.5, R4.1, R4.2, R5.1).\npackage main\n\nimport (\n\t\"errors\"\n\t\"flag\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/signal\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\n// options holds the parsed command-line flags for du.\n// D3: scaffolding for future flags (-a, -s, -h, -c, -k, -d, etc.).\ntype options struct{}\n\n// reportError writes a du-style error message to stderr.\n// R4.2: per-path error messages to stderr.\nfunc reportError(path string, err error) {\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\tfmt.Fprintf(os.Stderr, \"du: %s: %v\\n\", path, pathErr.Err)\n\t} else {\n\t\tfmt.Fprintf(os.Stderr, \"du: %s: %v\\n\", path, err)\n\t}\n}\n\n// duArg processes a single command-line argument.\n// R1.1: reads named paths in argument order.\n// R1.5: each argument is traversed independently.\nfunc duArg(arg string, opts *options) error {\n\tinfo, err := os.Lstat(arg)\n\tif err != nil {\n\t\treportError(arg, err)\n\t\treturn err\n\t}\n\n\tif !info.IsDir() {\n\t\t// Non-directory argument: print its own block count as a single line.\n\t\tmeta, err := sys.Lstat(arg)\n\t\tif err != nil {\n\t\t\treportError(arg, err)\n\t\t\treturn err\n\t\t}\n\t\tfmt.Printf(\"%d\\t%s\\n\", displayBlocks(meta.Blocks()), arg)\n\t\treturn nil\n\t}\n\n\t// Directory: depth-first traversal printing per-directory subtotals.\n\t_, hasErr := walkDir(arg, opts)\n\tif hasErr {\n\t\treturn fmt.Errorf(\"errors during traversal of %s\", arg)\n\t}\n\treturn nil\n}\n\n// walkDir recursively traverses a directory, accumulating 512-byte block\n// counts bottom-up. Returns the total raw block count for the subtree and\n// whether any error occurred during traversal.\n// R1.1: recurse into each directory and print accumulated size.\n// R1.4: does not follow symbolic links (uses sys.Lstat and DirEntry.IsDir).\nfunc walkDir(dirPath string, opts *options) (int64, bool) {\n\tvar totalBlocks int64\n\thasErr := false\n\n\t// D1: use pkg/sys.Lstat to obtain the directory's own 512-byte block count.\n\tmeta, err := sys.Lstat(dirPath)\n\tif err != nil {\n\t\treportError(dirPath, err)\n\t\treturn 0, true\n\t}\n\ttotalBlocks += meta.Blocks()\n\n\t// D1: use os.ReadDir for directory listing; DirEntry.IsDir() uses d_type\n\t// from the dirent to avoid a second stat call per entry.\n\tentries, readErr := os.ReadDir(dirPath)\n\tif readErr != nil {\n\t\treportError(dirPath, readErr)\n\t\thasErr = true\n\t}\n\n\tfor _, entry := range entries {\n\t\tchildPath := joinPath(dirPath, entry.Name())\n\n\t\tif entry.IsDir() {\n\t\t\tsubtotal, childErr := walkDir(childPath, opts)\n\t\t\ttotalBlocks += subtotal\n\t\t\tif childErr {\n\t\t\t\thasErr = true\n\t\t\t}\n\t\t} else {\n\t\t\t// Non-directory: count blocks but do not print in default mode.\n\t\t\tchildMeta, err := sys.Lstat(childPath)\n\t\t\tif err != nil {\n\t\t\t\treportError(childPath, err)\n\t\t\t\thasErr = true\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\ttotalBlocks += childMeta.Blocks()\n\t\t}\n\t}\n\n\t// R1.3: print SIZE\\tPATH for this directory.\n\t// R1.2: convert from 512-byte blocks to 1024-byte display units.\n\tfmt.Printf(\"%d\\t%s\\n\", displayBlocks(totalBlocks), dirPath)\n\treturn totalBlocks, hasErr\n}\n\n// joinPath constructs a child path by appending name to a directory path,\n// preserving the argument prefix as given on the command line. Unlike\n// filepath.Join, this does not clean the path (filepath.Join strips \"./\"\n// prefixes, which changes du output).\nfunc joinPath(dir, name string) string {\n\tif dir[len(dir)-1] == '/' {\n\t\treturn dir + name\n\t}\n\treturn dir + \"/\" + name\n}\n\n// displayBlocks converts a 512-byte block count to 1024-byte display units\n// using integer ceiling division: (rawBlocks + 1) / 2.\n// R1.2: 1024-byte block units by default.\nfunc displayBlocks(rawBlocks int64) int64 {\n\treturn (rawBlocks + 1) / 2\n}\n\nfunc main() {\n\t// R5.1: handle SIGPIPE by exiting cleanly.\n\tsigpipe := make(chan os.Signal, 1)\n\tsignal.Notify(sigpipe, syscall.SIGPIPE)\n\tgo func() {\n\t\t<-sigpipe\n\t\tos.Exit(0)\n\t}()\n\n\tvar opts options\n\tflag.Parse()\n\n\t// R1.5: process arguments in command-line order; default to \".\".\n\targs := flag.Args()\n\tif len(args) == 0 {\n\t\targs = []string{\".\"}\n\t}\n\n\texitCode := 0\n\tfor _, arg := range args {\n\t\tif err := duArg(arg, &opts); err != nil {\n\t\t\texitCode = 1\n\t\t}\n\t}\n\n\tos.Exit(exitCode)\n}\n","numLines":162,"startLine":1,"totalLines":162}}}
