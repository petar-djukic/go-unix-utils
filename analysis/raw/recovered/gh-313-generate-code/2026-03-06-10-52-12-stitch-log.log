es:\n      - prd014-false R1.2\n\n  # --- yes ---\n  - name: yes_default_output\n    description: \"yes with no arguments piped through head -n 5; expect 5 lines of 'y'.\"\n    inputs:\n      args: []\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n      pipe_through: \"head -n 5\"\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"y\\ny\\ny\\ny\\ny\\n\"\n      stderr: \"\"\n    traces:\n      - prd012-yes R1.1\n\n  - name: yes_single_arg\n    description: \"yes hello piped through head -n 3; expect 3 lines of 'hello'.\"\n    inputs:\n      args: [\"hello\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n      pipe_through: \"head -n 3\"\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello\\nhello\\nhello\\n\"\n      stderr: \"\"\n    traces:\n      - prd012-yes R1.2\n\n  - name: yes_multi_arg\n    description: \"yes hello world piped through head -n 2; expect 2 lines of 'hello world'.\"\n    inputs:\n      args: [\"hello\", \"world\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n      pipe_through: \"head -n 2\"\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello world\\nhello world\\n\"\n      stderr: \"\"\n    traces:\n      - prd012-yes R1.2\n\n  - name: yes_double_dash_separator\n    description: \"yes -- --help piped through head -n 1; expect '--help'.\"\n    inputs:\n      args: [\"--\", \"--help\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n      pipe_through: \"head -n 1\"\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"--help\\n\"\n      stderr: \"\"\n    traces:\n      - prd012-yes R1.3\n\n  # --- basename ---\n  - name: basename_simple_path\n    description: \"basename /usr/bin/sort; expect 'sort'.\"\n    inputs:\n      args: [\"/usr/bin/sort\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"sort\\n\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R1.1\n\n  - name: basename_suffix_removal\n    description: \"basename include/stdio.h .h; expect 'stdio'.\"\n    inputs:\n      args: [\"include/stdio.h\", \".h\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"stdio\\n\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R1.2\n\n  - name: basename_trailing_slashes\n    description: \"basename /usr/bin/sort///; expect 'sort' (trailing slashes stripped).\"\n    inputs:\n      args: [\"/usr/bin/sort///\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"sort\\n\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R1.3\n\n  - name: basename_root_path\n    description: \"basename /; expect '/'.\"\n    inputs:\n      args: [\"/\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"/\\n\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R1.4\n\n  - name: basename_empty_string\n    description: \"basename ''; expect empty line.\"\n    inputs:\n      args: [\"\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"\\n\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R1.5\n\n  - name: basename_multi_argument_mode\n    description: \"basename -a /usr/bin/sort /usr/bin/cat; expect 'sort' and 'cat' on separate lines.\"\n    inputs:\n      args: [\"-a\", \"/usr/bin/sort\", \"/usr/bin/cat\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"sort\\ncat\\n\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R2.1\n\n  - name: basename_suffix_mode\n    description: \"basename -s .h include/stdio.h include/stdlib.h; expect 'stdio' and 'stdlib'.\"\n    inputs:\n      args: [\"-s\", \".h\", \"include/stdio.h\", \"include/stdlib.h\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"stdio\\nstdlib\\n\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R2.2\n\n  - name: basename_nul_delimited\n    description: \"basename -z /usr/bin/sort; expect 'sort' followed by NUL byte instead of newline.\"\n    inputs:\n      args: [\"-z\", \"/usr/bin/sort\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"sort\\x00\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R3.1\n\n  # --- dirname ---\n  - name: dirname_simple_path\n    description: \"dirname /usr/bin/sort; expect '/usr/bin'.\"\n    inputs:\n      args: [\"/usr/bin/sort\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"/usr/bin\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.1\n\n  - name: dirname_no_directory\n    description: \"dirname stdio.h; expect '.' (current directory).\"\n    inputs:\n      args: [\"stdio.h\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \".\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.2\n\n  - name: dirname_root_path\n    description: \"dirname /; expect '/'.\"\n    inputs:\n      args: [\"/\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"/\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.3\n\n  - name: dirname_trailing_slashes\n    description: \"dirname /usr/bin/; expect '/usr' (trailing slash stripped before processing).\"\n    inputs:\n      args: [\"/usr/bin/\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"/usr\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.1\n      - prd016-dirname R1.4\n\n  - name: dirname_dot_path\n    description: \"dirname .; expect '.'.\"\n    inputs:\n      args: [\".\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \".\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.2\n\n  - name: dirname_dotdot_path\n    description: \"dirname ..; expect '.'.\"\n    inputs:\n      args: [\"..\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \".\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.2\n\n  - name: dirname_multiple_args\n    description: \"dirname dir1/file dir2/file; expect 'dir1' and 'dir2' on separate lines.\"\n    inputs:\n      args: [\"dir1/file\", \"dir2/file\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"dir1\\ndir2\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.5\n\n  - name: dirname_nul_delimited\n    description: \"dirname -z /usr/bin/sort; expect '/usr/bin' followed by NUL byte.\"\n    inputs:\n      args: [\"-z\", \"/usr/bin/sort\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"/usr/bin\\x00\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R2.1\n\n  - name: dirname_no_args_error\n    description: \"dirname with no arguments; expect exit 1 and error message on stderr.\"\n    inputs:\n      args: []\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 1\n      stdout: \"\"\n      stderr: \"non-empty error message\"\n    traces:\n      - prd016-dirname R3.2\n","numLines":399,"startLine":1,"totalLines":399}}}
