ee]","-      //   r=1: 1(bb),3(dd),5(ff),7(skip) → [bb,dd,ff]","-      // Still 3 effective. Let me use termWidth=10:","-      // numCols=4: total=6+6=12>10 fail","-      // numCols=3: numRows=2, col=i/2: [0]=2,[1]=2,[2]=2, total=6+2*2=10<=10 → bestCols=3","-      //   numRows=(6+3-1)/3=2","-      //   r=0: 0*2+0=0(aa), 1*2+0=2(cc), 2*2+0=4(ee) → [aa,cc,ee]","-      //   r=1: 0*2+1=1(bb), 1*2+1=3(dd), 2*2+1=5(ff) → [bb,dd,ff]","+      name:    \"column-major ordering three columns\",","+      entries: []string{\"aa\", \"bb\", \"cc\", \"dd\", \"ee\", \"ff\"},","+      // numCols=3, numRows=2: colWidths=[2,2,2], total=6+2*2=10 <= 10","+      // Row 0: entries[0]=\"aa\", entries[2]=\"cc\", entries[4]=\"ee\"","+      // Row 1: entries[1]=\"bb\", entries[3]=\"dd\", entries[5]=\"ff\"","       termWidth: 10,","       want: [][]string{","         {\"aa\", \"cc\", \"ee\"},"]},{"oldStart":108,"oldLines":26,"newStart":72,"newLines":26,"lines":["       },","     },","     {","-      name:      \"uneven last column\",","-      entries:   []string{\"alpha\", \"beta\", \"gamma\", \"delta\"},","+      name:    \"uneven last column\",","+      entries: []string{\"alpha\", \"beta\", \"gamma\", \"delta\"},","+      // 4 entries all fit in 1 row: widths=[5,4,5,5], total=19+2*3=25 <= 80","       termWidth: 80,","-      // 4 entries all fit in 1 row: widths=[5,4,5,5], total=19+2*3=25<=80","-      want: [][]string{{\"alpha\", \"beta\", \"gamma\", \"delta\"}},","+      want:      [][]string{{\"alpha\", \"beta\", \"gamma\", \"delta\"}},","     },","     {","-      name:      \"exact fit at terminal width\",","-      entries:   []string{\"abc\", \"def\"},","-      termWidth: 8,","+      name:    \"exact fit at terminal width\",","+      entries: []string{\"abc\", \"def\"},","       // 2 cols, 1 row: total = 3+3+2 = 8 <= 8","-      want: [][]string{{\"abc\", \"def\"}},","+      termWidth: 8,","+      want:      [][]string{{\"abc\", \"def\"}},","     },","     {","-      name:      \"one char too narrow forces fewer columns\",","-      entries:   []string{\"abc\", \"def\"},","-      termWidth: 7,","+      name:    \"one char too narrow forces fewer columns\",","+      entries: []string{\"abc\", \"def\"},","       // 2 cols, 1 row: total = 3+3+2 = 8 > 7","       // 1 col, 2 rows: total = 3 <= 7","-      want: [][]string{{\"abc\"}, {\"def\"}},","+      termWidth: 7,","+      want:      [][]string{{\"abc\"}, {\"def\"}},","     },","   }"," "]},{"oldStart":192,"oldLines":21,"newStart":156,"newLines":21,"lines":["     },","     {","       name:  \"multi-byte UTF-8 shorter than width\",","-      s:     \"café\",","+      s:     \"caf\\u00e9\",","       width: 8,","-      want:  \"café    \",","+      want:  \"caf\\u00e9    \",","     },","     {","       name:  \"multi-byte UTF-8 rune count equals width\",","-      s:     \"café\",","+      s:     \"caf\\u00e9\",","       width: 4,","-      want:  \"café\",","+      want:  \"caf\\u00e9\",","     },","     {","       name:  \"multi-byte UTF-8 rune count exceeds width\",","-      s:     \"日本語\",","+      s:     \"\\u65e5\\u672c\\u8a9e\",","       width: 2,","-      want:  \"日本語\",","+      want:  \"\\u65e5\\u672c\\u8a9e\",","     },","     {","       name:  \"width zero\","]},{"oldStart":259,"oldLines":21,"newStart":223,"newLines":21,"lines":["     },","     {","       name:  \"multi-byte UTF-8 shorter than width\",","-      s:     \"café\",","+      s:     \"caf\\u00e9\",","       width: 8,","-      want:  \"    café\",","+      want:  \"    caf\\u00e9\",","     },","     {","       name:  \"multi-byte UTF-8 rune count equals width\",","-      s:     \"café\",","+      s:     \"caf\\u00e9\",","       width: 4,","-      want:  \"café\",","+      want:  \"caf\\u00e9\",","     },","     {","       name:  \"multi-byte UTF-8 rune count exceeds width\",","-      s:     \"日本語\",","+      s:     \"\\u65e5\\u672c\\u8a9e\",","       width: 2,","-      want:  \"日本語\",","+      want:  \"\\u65e5\\u672c\\u8a9e\",","     },","     {","       name:  \"width zero\","]}],"originalFile":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Tests for Columns, PadRight, and PadLeft (prd003-format R1.1, R1.2, R1.3, R1.4).\npackage format\n\nimport (\n\t\"testing\"\n)\n\nfunc TestColumns(t *testing.T) {\n\ttests := []struct {\n\t\tname      string\n\t\tentries   []string\n\t\ttermWidth int\n\t\twant      [][]string\n\t}{\n\t\t{\n\t\t\tname:      \"empty input returns nil\",\n\t\t\tentries:   []string{},\n\t\t\ttermWidth: 80,\n\t\t\twant:      nil,\n\t\t},\n\t\t{\n\t\t\tname:      \"single entry\",\n\t\t\tentries:   []string{\"hello\"},\n\t\t\ttermWidth: 80,\n\t\t\twant:      [][]string{{\"hello\"}},\n\t\t},\n\t\t{\n\t\t\tname:      \"all entries fit in one row\",\n\t\t\tentries:   []string{\"a\", \"bb\", \"ccc\"},\n\t\t\ttermWidth: 80,\n\t\t\t// 3 cols, 1 row: colWidths=[1,2,3], total=1+2+3 + 2*2 = 10 <= 80\n\t\t\twant: [][]string{{\"a\", \"bb\", \"ccc\"}},\n\t\t},\n\t\t{\n\t\t\tname:      \"entries wider than terminal force single column\",\n\t\t\tentries:   []string{\"abcdef\", \"ghijkl\", \"mnopqr\"},\n\t\t\ttermWidth: 5,\n\t\t\t// Each entry is 6 chars, wider than termWidth=5.\n\t\t\t// Even 2 cols: min total = 6+6+2 = 14 > 5. Falls to 1 col.\n\t\t\twant: [][]string{{\"abcdef\"}, {\"ghijkl\"}, {\"mnopqr\"}},\n\t\t},\n\t\t{\n\t\t\tname:      \"column-major ordering two columns\",\n\t\t\tentries:   []string{\"a\", \"bb\", \"ccc\", \"d\", \"ee\"},\n\t\t\ttermWidth: 10,\n\t\t\t// numCols=2, numRows=3\n\t\t\t// col 0: a(1), bb(2), ccc(3) → width=3\n\t\t\t// col 1: d(1), ee(2) → width=2\n\t\t\t// total = 3+2 + 2 = 7 <= 10\n\t\t\t// Row 0: entries[0]=\"a\", entries[3]=\"d\"\n\t\t\t// Row 1: entries[1]=\"bb\", entries[4]=\"ee\"\n\t\t\t// Row 2: entries[2]=\"ccc\"\n\t\t\twant: [][]string{\n\t\t\t\t{\"a\", \"d\"},\n\t\t\t\t{\"bb\", \"ee\"},\n\t\t\t\t{\"ccc\"},\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tname:      \"column-major ordering three columns\",\n\t\t\tentries:   []string{\"aa\", \"bb\", \"cc\", \"dd\", \"ee\", \"ff\"},\n\t\t\ttermWidth: 20,\n\t\t\t// 6 entries, try numCols=6: numRows=1, total=2*6+2*5=22 > 20\n\t\t\t// numCols=5: numRows=2\n\t\t\t//   col 0: aa,bb → 2; col 1: cc,dd → 2; col 2: ee,ff → 2; col 3: empty; col 4: empty\n\t\t\t//   Wait, numRows=2, so col = i/numRows: 0/2=0, 1/2=0, 2/2=1, 3/2=1, 4/2=2, 5/2=2\n\t\t\t//   Only 3 cols actually used but numCols=5 allocates 5 col widths.\n\t\t\t//   colWidths = [2,2,2,0,0], total = 6 + 2*4 = 14 <= 20\n\t\t\t//   But the rows would be: row0=[0,2,4,6(skip),8(skip)], row1=[1,3,5,7(skip),9(skip)]\n\t\t\t//   = [aa,cc,ee], [bb,dd,ff]\n\t\t\t// Actually numCols=6 numRows=1: total = 2*6 + 2*5 = 22 > 20, no\n\t\t\t// numCols=5 numRows=2: works at 14\n\t\t\t// But actually numCols=6 is tried first (loop goes n down to 1).\n\t\t\t// n=6, numCols=6: numRows=1, total=12+10=22>20 fail\n\t\t\t// numCols=5: numRows=2, 3 cols used out of 5\n\t\t\t//   row 0: idx 0*2+0=0(aa), 1*2+0=2(cc), 2*2+0=4(ee), 3*2+0=6(skip), 4*2+0=8(skip)\n\t\t\t//   row 1: idx 0*2+1=1(bb), 1*2+1=3(dd), 2*2+1=5(ff), 3*2+1=7(skip), 4*2+1=9(skip)\n\t\t\t//   = [aa,cc,ee], [bb,dd,ff]  -- but this is 5 cols not 3\n\t\t\t// Wait, colWidths for numCols=5 are:\n\t\t\t//   i=0: col=0/2=0, i=1: col=1/2=0, i=2: col=2/2=1, i=3: col=3/2=1\n\t\t\t//   i=4: col=4/2=2, i=5: col=5/2=2\n\t\t\t//   colWidths = [2,2,2,0,0], total = 6+2*4=14 <= 20 → bestCols=5\n\t\t\t// Then numRows=(6+5-1)/5=2, rows:\n\t\t\t//   r=0: c0=0*2+0=0(aa), c1=1*2+0=2(cc), c2=2*2+0=4(ee), c3=3*2+0=6(skip), c4=4*2+0=8(skip) → [aa,cc,ee]\n\t\t\t//   r=1: c0=0*2+1=1(bb), c1=1*2+1=3(dd), c2=2*2+1=5(ff), c3=3*2+1=7(skip), c4=4*2+1=9(skip) → [bb,dd,ff]\n\t\t\t// So with termWidth=20, entries of width 2 each, we get 5 cols with 2 rows (3 effective cols)\n\t\t\t// Let me use termWidth=12 to force 3 actual columns:\n\t\t\t// numCols=6: 22>12 fail\n\t\t\t// numCols=5: 14>12 fail\n\t\t\t// numCols=4: numRows=2, col=i/2: same as above but 4 cols\n\t\t\t//   colWidths[0]=2, [1]=2, [2]=2, [3]=0, total=6+2*3=12 <= 12 → bestCols=4\n\t\t\t//   numRows=(6+4-1)/4=2\n\t\t\t//   r=0: 0(aa),2(cc),4(ee),6(skip) → [aa,cc,ee]\n\t\t\t//   r=1: 1(bb),3(dd),5(ff),7(skip) → [bb,dd,ff]\n\t\t\t// Still 3 effective. Let me use termWidth=10:\n\t\t\t// numCols=4: total=6+6=12>10 fail\n\t\t\t// numCols=3: numRows=2, col=i/2: [0]=2,[1]=2,[2]=2, total=6+2*2=10<=10 → bestCols=3\n\t\t\t//   numRows=(6+3-1)/3=2\n\t\t\t//   r=0: 0*2+0=0(aa), 1*2+0=2(cc), 2*2+0=4(ee) → [aa,cc,ee]\n\t\t\t//   r=1: 0*2+1=1(bb), 1*2+1=3(dd), 2*2+1=5(ff) → [bb,dd,ff]\n\t\t\ttermWidth: 10,\n\t\t\twant: [][]string{\n\t\t\t\t{\"aa\", \"cc\", \"ee\"},\n\t\t\t\t{\"bb\", \"dd\", \"ff\"},\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tname:      \"uneven last column\",\n\t\t\tentries:   []string{\"alpha\", \"beta\", \"gamma\", \"delta\"},\n\t\t\ttermWidth: 80,\n\t\t\t// 4 entries all fit in 1 row: widths=[5,4,5,5], total=19+2*3=25<=80\n\t\t\twant: [][]string{{\"alpha\", \"beta\", \"gamma\", \"delta\"}},\n\t\t},\n\t\t{\n\t\t\tname:      \"exact fit at terminal width\",\n\t\t\tentries:   []string{\"abc\", \"def\"},\n\t\t\ttermWidth: 8,\n\t\t\t// 2 cols, 1 row: total = 3+3+2 = 8 <= 8\n\t\t\twant: [][]string{{\"abc\", \"def\"}},\n\t\t},\n\t\t{\n\t\t\tname:      \"one char too narrow forces fewer columns\",\n\t\t\tentries:   []string{\"abc\", \"def\"},\n\t\t\ttermWidth: 7,\n\t\t\t// 2 cols, 1 row: total = 3+3+2 = 8 > 7\n\t\t\t// 1 col, 2 rows: total = 3 <= 7\n\t\t\twant: [][]string{{\"abc\"}, {\"def\"}},\n\t\t},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tgot := Columns(tt.entries, tt.termWidth)\n\t\t\tif tt.want == nil {\n\t\t\t\tif got != nil {\n\t\t\t\t\tt.Errorf(\"Columns() = %v; want nil\", got)\n\t\t\t\t}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif len(got) != len(tt.want) {\n\t\t\t\tt.Fatalf(\"Columns() returned %d rows; want %d\", len(got), len(tt.want))\n\t\t\t}\n\t\t\tfor r, wantRow := range tt.want {\n\t\t\t\tgotRow := got[r]\n\t\t\t\tif len(gotRow) != len(wantRow) {\n\t\t\t\t\tt.Errorf(\"row %d: got %d entries %v; want %d entries %v\", r, len(gotRow), gotRow, len(wantRow), wantRow)\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tfor c, wantVal := range wantRow {\n\t\t\t\t\tif gotRow[c] != wantVal {\n\t\t\t\t\t\tt.Errorf(\"row %d col %d: got %q; want %q\", r, c, gotRow[c], wantVal)\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestPadRight(t *testing.T) {\n\ttests := []struct {\n\t\tname  string\n\t\ts     string\n\t\twidth int\n\t\twant  string\n\t}{\n\t\t{\n\t\t\tname:  \"ASCII shorter than width\",\n\t\t\ts:     \"abc\",\n\t\t\twidth: 6,\n\t\t\twant:  \"abc   \",\n\t\t},\n\t\t{\n\t\t\tname:  \"ASCII equal to width\",\n\t\t\ts:     \"abc\",\n\t\t\twidth: 3,\n\t\t\twant:  \"abc\",\n\t\t},\n\t\t{\n\t\t\tname:  \"ASCII exceeds width\",\n\t\t\ts:     \"abcdef\",\n\t\t\twidth: 3,\n\t\t\twant:  \"abcdef\",\n\t\t},\n\t\t{\n\t\t\tname:  \"empty string\",\n\t\t\ts:     \"\",\n\t\t\twidth: 4,\n\t\t\twant:  \"    \",\n\t\t},\n\t\t{\n\t\t\tname:  \"multi-byte UTF-8 shorter than width\",\n\t\t\ts:     \"café\",\n\t\t\twidth: 8,\n\t\t\twant:  \"café    \",\n\t\t},\n\t\t{\n\t\t\tname:  \"multi-byte UTF-8 rune count equals width\",\n\t\t\ts:     \"café\",\n\t\t\twidth: 4,\n\t\t\twant:  \"café\",\n\t\t},\n\t\t{\n\t\t\tname:  \"multi-byte UTF-8 rune count exceeds width\",\n\t\t\ts:     \"日本語\",\n\t\t\twidth: 2,\n\t\t\twant:  \"日本語\",\n\t\t},\n\t\t{\n\t\t\tname:  \"width zero\",\n\t\t\ts:     \"abc\",\n\t\t\twidth: 0,\n\t\t\twant:  \"abc\",\n\t\t},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tgot := PadRight(tt.s, tt.width)\n\t\t\tif got != tt.want {\n\t\t\t\tt.Errorf(\"PadRight(%q, %d) = %q; want %q\", tt.s, tt.width, got, tt.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestPadLeft(t *testing.T) {\n\ttests := []struct {\n\t\tname  string\n\t\ts     string\n\t\twidth int\n\t\twant  string\n\t}{\n\t\t{\n\t\t\tname:  \"ASCII shorter than width\",\n\t\t\ts:     \"abc\",\n\t\t\twidth: 6,\n\t\t\twant:  \"   abc\",\n\t\t},\n\t\t{\n\t\t\tname:  \"ASCII equal to width\",\n\t\t\ts:     \"abc\",\n\t\t\twidth: 3,\n\t\t\twant:  \"abc\",\n\t\t},\n\t\t{\n\t\t\tname:  \"ASCII exceeds width\",\n\t\t\ts:     \"abcdef\",\n\t\t\twidth: 3,\n\t\t\twant:  \"abcdef\",\n\t\t},\n\t\t{\n\t\t\tname:  \"empty string\",\n\t\t\ts:     \"\",\n\t\t\twidth: 4,\n\t\t\twant:  \"    \",\n\t\t},\n\t\t{\n\t\t\tname:  \"multi-byte UTF-8 shorter than width\",\n\t\t\ts:     \"café\",\n\t\t\twidth: 8,\n\t\t\twant:  \"    café\",\n\t\t},\n\t\t{\n\t\t\tname:  \"multi-byte UTF-8 rune count equals width\",\n\t\t\ts:     \"café\",\n\t\t\twidth: 4,\n\t\t\twant:  \"café\",\n\t\t},\n\t\t{\n\t\t\tname:  \"multi-byte UTF-8 rune count exceeds width\",\n\t\t\ts:     \"日本語\",\n\t\t\twidth: 2,\n\t\t\twant:  \"日本語\",\n\t\t},\n\t\t{\n\t\t\tname:  \"width zero\",\n\t\t\ts:     \"abc\",\n\t\t\twidth: 0,\n\t\t\twant:  \"abc\",\n\t\t},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tgot := PadLeft(tt.s, tt.width)\n\t\t\tif got != tt.want {\n\t\t\t\tt.Errorf(\"PadLeft(%q, %d) = %q; want %q\", tt.s, tt.width, got, tt.want)\n\t\t\t}\n\t\t})\n\t}\n}\n"}}
