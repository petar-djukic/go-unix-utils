   50→  - name: cat_line_numbering_n\n    51→    description: -n flag prepends line numbers to all lines including blank lines.\n    52→    inputs:\n    53→      args: [\"-n\"]\n    54→      stdin: \"alpha\\n\\nbeta\\n\"\n    55→      env: []\n    56→    normalization: none\n    57→    expected:\n    58→      exit_code: 0\n    59→      stdout: \"     1\\talpha\\n     2\\t\\n     3\\tbeta\\n\"\n    60→      stderr: \"\"\n    61→    traces:\n    62→      - prd006-cat R2.1\n    63→\n    64→  - name: cat_line_numbering_b\n    65→    description: -b flag prepends line numbers only to non-blank lines.\n    66→    inputs:\n    67→      args: [\"-b\"]\n    68→      stdin: \"first\\n\\n\\nsecond\\n\"\n    69→      env: []\n    70→    normalization: none\n    71→    expected:\n    72→      exit_code: 0\n    73→      stdout: \"     1\\tfirst\\n\\n\\n     2\\tsecond\\n\"\n    74→      stderr: \"\"\n    75→    traces:\n    76→      - prd006-cat R2.2\n    77→      - prd006-cat R2.4\n    78→\n    79→  - name: cat_squeeze_blanks\n    80→    description: -s collapses consecutive blank lines to one.\n    81→    inputs:\n    82→      args: [\"-s\"]\n    83→      stdin: \"a\\n\\n\\n\\nb\\n\"\n    84→      env: []\n    85→    normalization: none\n    86→    expected:\n    87→      exit_code: 0\n    88→      stdout: \"a\\n\\nb\\n\"\n    89→      stderr: \"\"\n    90→    traces:\n    91→      - prd006-cat R3.1\n    92→\n    93→  - name: cat_show_nonprinting\n    94→    description: -v displays non-printing characters with caret and M- notation.\n    95→    inputs:\n    96→      args: [\"-v\"]\n    97→      stdin: \"\\\\x01\\\\x09\\\\x1b\\\\x7f\\\\x80\\\\xff\"\n    98→      env: []\n    99→    normalization: none\n   100→    expected:\n   101→      exit_code: 0\n   102→      stdout: \"^A\\\\x09^[^?M-^@M-^?\"\n   103→      stderr: \"\"\n   104→    traces:\n   105→      - prd006-cat R4.1\n   106→      - prd006-cat R4.2\n   107→\n   108→  - name: cat_show_ends\n   109→    description: -E appends \"$\" before each newline.\n   110→    inputs:\n   111→      args: [\"-E\"]\n   112→      stdin: \"line one\\nline two\\n\"\n   113→      env: []\n   114→    normalization: none\n   115→    expected:\n   116→      exit_code: 0\n   117→      stdout: \"line one$\\nline two$\\n\"\n   118→      stderr: \"\"\n   119→    traces:\n   120→      - prd006-cat R4.3\n   121→\n   122→  - name: cat_show_tabs\n   123→    description: -T displays tabs as \"^I\".\n   124→    inputs:\n   125→      args: [\"-T\"]\n   126→      stdin: \"col1\\\\tcol2\\\\tcol3\\n\"\n   127→      env: []\n   128→    normalization: none\n   129→    expected:\n   130→      exit_code: 0\n   131→      stdout: \"col1^Icol2^Icol3\\n\"\n   132→      stderr: \"\"\n   133→    traces:\n   134→      - prd006-cat R4.4\n   135→\n   136→  - name: cat_show_all\n   137→    description: -A is equivalent to -vET combined.\n   138→    inputs:\n   139→      args: [\"-A\"]\n   140→      stdin: \"\\\\x01\\\\thello\\n\"\n   141→      env: []\n   142→    normalization: none\n   143→    expected:\n   144→      exit_code: 0\n   145→      stdout: \"^A^Ihello$\\n\"\n   146→      stderr: \"\"\n   147→    traces:\n   148→      - prd006-cat R4.5\n   149→\n   150→  - name: cat_flag_e\n   151→    description: -e is equivalent to -vE (show non-printing and show ends).\n   152→    inputs:\n   153→      args: [\"-e\"]\n   154→      stdin: \"\\\\x01hello\\n\"\n   155→      env: []\n   156→    normalization: none\n   157→    expected:\n   158→      exit_code: 0\n   159→      stdout: \"^Ahello$\\n\"\n   160→      stderr: \"\"\n   161→    traces:\n   162→      - prd006-cat R4.6\n   163→\n   164→  - name: cat_flag_t\n   165→    description: -t is equivalent to -vT (show non-printing and show tabs).\n   166→    inputs:\n   167→      args: [\"-t\"]\n   168→      stdin: \"\\\\x01\\\\thello\\n\"\n   169→      env: []\n   170→    normalization: none\n   171→    expected:\n   172→      exit_code: 0\n   173→      stdout: \"^A^Ihello\\n\"\n   174→      stderr: \"\"\n   175→    traces:\n   176→      - prd006-cat R4.7\n   177→\n   178→  - name: cat_flag_u_accepted\n   179→    description: -u flag is accepted without error, output unchanged from default.\n   180→    inputs:\n   181→      args: [\"-u\"]\n   182→      stdin: \"test\\n\"\n   183→      env: []\n   184→    normalization: none\n   185→    expected:\n   186→      exit_code: 0\n   187→      stdout: \"test\\n\"\n   188→      stderr: \"\"\n   189→    traces:\n   190→      - prd006-cat R4.8\n   191→\n   192→  - name: cat_combined_ns\n   193→    description: -n -s combined; squeeze applied before numbering.\n   194→    inputs:\n   195→      args: [\"-n\", \"-s\"]\n   196→      stdin: \"a\\n\\n\\n\\nb\\n\"\n   197→      env: []\n   198→    normalization: none\n   199→    expected:\n   200→      exit_code: 0\n   201→      stdout: \"     1\\ta\\n     2\\t\\n     3\\tb\\n\"\n   202→      stderr: \"\"\n   203→    traces:\n   204→      - prd006-cat R3.3\n   205→      - prd006-cat R4.9\n   206→\n   207→  - name: cat_multiple_files\n   208→    description: 'Two files concatenated with no separator between them. Setup: file1.txt contains \"aaa\\n\", file2.txt contains \"bbb\\n\"'\n   209→    inputs:\n   210→      args: [\"file1.txt\", \"file2.txt\"]\n   211→      stdin: null\n   212→      env: []\n   213→    normalization: none\n   214→    expected:\n   215→      exit_code: 0\n   216→      stdout: \"aaa\\nbbb\\n\"\n   217→      stderr: \"\"\n   218→    traces:\n   219→      - prd006-cat R1.1\n   220→      - prd006-cat R1.3\n   221→\n   222→  - name: cat_stdin_dash\n   223→    description: '\"-\" as a filename argument reads from stdin.'\n   224→    inputs:\n   225→      args: [\"-\"]\n   226→      stdin: \"from stdin\\n\"\n   227→      env: []\n   228→    normalization: none\n   229→    expected:\n   230→      exit_code: 0\n   231→      stdout: \"from stdin\\n\"\n   232→      stderr: \"\"\n   233→    traces:\n   234→      - prd006-cat R1.2\n   235→\n   236→  - name: