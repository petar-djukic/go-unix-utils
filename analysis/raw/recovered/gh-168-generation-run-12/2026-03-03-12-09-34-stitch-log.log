No flags, binary input (all byte values 0x00-0xFF) passes through without corruption.\n    inputs:\n      args: []\n      stdin: \"\\\\x00\\\\x01\\\\x02...\\\\xfe\\\\xff (all 256 byte values)\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: identical 256 bytes as input\n      stderr: \"\"\n    traces:\n      - prd006-cat R1.4\n\n  - name: cat_line_numbering_n\n    description: -n flag prepends line numbers to all lines including blank lines.\n    inputs:\n      args: [\"-n\"]\n      stdin: \"alpha\\n\\nbeta\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\talpha\\n     2\\t\\n     3\\tbeta\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R2.1\n\n  - name: cat_line_numbering_b\n    description: -b flag prepends line numbers only to non-blank lines.\n    inputs:\n      args: [\"-b\"]\n      stdin: \"first\\n\\n\\nsecond\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\tfirst\\n\\n\\n     2\\tsecond\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R2.2\n      - prd006-cat R2.4\n\n  - name: cat_squeeze_blanks\n    description: -s collapses consecutive blank lines to one.\n    inputs:\n      args: [\"-s\"]\n      stdin: \"a\\n\\n\\n\\nb\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a\\n\\nb\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R3.1\n\n  - name: cat_show_nonprinting\n    description: -v displays non-printing characters with caret and M- notation.\n    inputs:\n      args: [\"-v\"]\n      stdin: \"\\\\x01\\\\x09\\\\x1b\\\\x7f\\\\x80\\\\xff\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"^A\\\\x09^[^?M-^@M-^?\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R4.1\n      - prd006-cat R4.2\n\n  - name: cat_show_ends\n    description: -E appends \"$\" before each newline.\n    inputs:\n      args: [\"-E\"]\n      stdin: \"line one\\nline two\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"line one$\\nline two$\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R4.3\n\n  - name: cat_show_tabs\n    description: -T displays tabs as \"^I\".\n    inputs:\n      args: [\"-T\"]\n      stdin: \"col1\\\\tcol2\\\\tcol3\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"col1^Icol2^Icol3\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R4.4\n\n  - name: cat_show_all\n    description: -A is equivalent to -vET combined.\n    inputs:\n      args: [\"-A\"]\n      stdin: \"\\\\x01\\\\thello\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"^A^Ihello$\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R4.5\n\n  - name: cat_flag_e\n    description: -e is equivalent to -vE (show non-printing and show ends).\n    inputs:\n      args: [\"-e\"]\n      stdin: \"\\\\x01hello\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"^Ahello$\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R4.6\n\n  - name: cat_flag_t\n    description: -t is equivalent to -vT (show non-printing and show tabs).\n    inputs:\n      args: [\"-t\"]\n      stdin: \"\\\\x01\\\\thello\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"^A^Ihello\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R4.7\n\n  - name: cat_flag_u_accepted\n    description: -u flag is accepted without error, output unchanged from default.\n    inputs:\n      args: [\"-u\"]\n      stdin: \"test\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"test\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R4.8\n\n  - name: cat_combined_ns\n    description: -n -s combined; squeeze applied before numbering.\n    inputs:\n      args: [\"-n\", \"-s\"]\n      stdin: \"a\\n\\n\\n\\nb\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\ta\\n     2\\t\\n     3\\tb\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R3.3\n      - prd006-cat R4.9\n\n  - name: cat_multiple_files\n    description: 'Two files concatenated with no separator between them. Setup: file1.txt contains \"aaa\\n\", file2.txt contains \"bbb\\n\"'\n    inputs:\n      args: [\"file1.txt\", \"file2.txt\"]\n      stdin: null\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"aaa\\nbbb\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R1.1\n      - prd006-cat R1.3\n\n  - name: cat_stdin_dash\n    description: '\"-\" as a filename argument reads from stdin.'\n    inputs:\n      args: [\"-\"]\n      stdin: \"from stdin\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"from stdin\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R1.2\n\n  - name: cat_missing_file\n    description: 'Non-existent file prints error to stderr, exits 1, continues processing. Setup: real.txt contains \"data\\n\", nonexistent.txt does not exist'\n    inputs:\n      args: [\"nonexistent.txt\", \"real.txt\"]\n      stdin: null\n      env: []\n    normalization: none\n    expected:\n      exit_code: 1\n      stdout: \"data\\n\"\n      stderr_contains: \"nonexistent.txt\"\n    traces:\n      - prd006-cat R5.2\n","numLines":249,"startLine":1,"totalLines":249}}}
