{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ma8nzV8Cjq4us683CCZ6qW","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package main implements the head utility (prd018-head R1-R4).\n     5→// head prints the first lines or bytes of each input file.\n     6→package main\n     7→\n     8→import (\n     9→\t\"bufio\"\n    10→\t\"fmt\"\n    11→\t\"io\"\n    12→\t\"os\"\n    13→\t\"strconv\"\n    14→\t\"strings\"\n    15→\t\"unicode\"\n    16→\n    17→\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n    18→)\n    19→\n    20→// countMode selects between line-count and byte-count output.\n    21→type countMode int\n    22→\n    23→const (\n    24→\tmodeLines countMode = iota\n    25→\tmodeBytes\n    26→)\n    27→\n    28→func main() {\n    29→\tsys.InstallSIGPIPEHandler()\n    30→\n    31→\tcount := int64(10)\n    32→\tnegative := false\n    33→\tmode := modeLines\n    34→\tquiet := false\n    35→\tverbose := false\n    36→\tvar files []string\n    37→\n    38→\targs := os.Args[1:]\n    39→\tfor i := 0; i < len(args); i++ {\n    40→\t\targ := args[i]\n    41→\t\tif arg == \"--\" {\n    42→\t\t\tfiles = append(files, args[i+1:]...)\n    43→\t\t\tbreak\n    44→\t\t}\n    45→\t\tif arg == \"-\" {\n    46→\t\t\tfiles = append(files, \"-\")\n    47→\t\t\tcontinue\n    48→\t\t}\n    49→\t\tif !strings.HasPrefix(arg, \"-\") {\n    50→\t\t\tfiles = append(files, arg)\n    51→\t\t\tcontinue\n    52→\t\t}\n    53→\n    54→\t\t// Long options.\n    55→\t\tif strings.HasPrefix(arg, \"--lines\") {\n    56→\t\t\tval, ok := longOptValue(args, &i)\n    57→\t\t\tif !ok {\n    58→\t\t\t\tdie(\"option '--lines' requires an argument\")\n    59→\t\t\t}\n    60→\t\t\tcount, negative = mustParseLineCount(val)\n    61→\t\t\tmode = modeLines\n    62→\t\t\tcontinue\n    63→\t\t}\n    64→\t\tif strings.HasPrefix(arg, \"--bytes\") {\n    65→\t\t\tval, ok := longOptValue(args, &i)\n    66→\t\t\tif !ok {\n    67→\t\t\t\tdie(\"option '--bytes' requires an argument\")\n    68→\t\t\t}\n    69→\t\t\tcount, negative = mustParseByteCount(val)\n    70→\t\t\tmode = modeBytes\n    71→\t\t\tcontinue\n    72→\t\t}\n    73→\t\tif arg == \"--quiet\" || arg == \"--silent\" {\n    74→\t\t\tquiet = true\n    75→\t\t\tverbose = false\n    76→\t\t\tcontinue\n    77→\t\t}\n    78→\t\tif arg == \"--verbose\" {\n    79→\t\t\tverbose = true\n    80→\t\t\tquiet = false\n    81→\t\t\tcontinue\n    82→\t\t}\n    83→\n    84→\t\t// Numeric shorthand: -N means -n N.\n    85→\t\tif isNumericShorthand(arg) {\n    86→\t\t\tn, err := strconv.ParseInt(arg[1:], 10, 64)\n    87→\t\t\tif err != nil {\n    88→\t\t\t\tdie(fmt.Sprintf(\"invalid number of lines: '%s'\", arg[1:]))\n    89→\t\t\t}\n    90→\t\t\tcount = n\n    91→\t\t\tnegative = false\n    92→\t\t\tmode = modeLines\n    93→\t\t\tcontinue\n    94→\t\t}\n    95→\n    96→\t\t// Short options: -n, -c, -q, -v and combinations.\n    97→\t\tj := 1\n    98→\t\tfor j < len(arg) {\n    99→\t\t\tswitch arg[j] {\n   100→\t\t\tcase 'n':\n   101→\t\t\t\tval := shortOptValue(args, &i, arg, j)\n   102→\t\t\t\tcount, negative = mustParseLineCount(val)\n   103→\t\t\t\tmode = modeLines\n   104→\t\t\t\tj = len(arg)\n   105→\t\t\tcase 'c':\n   106→\t\t\t\tval := shortOptValue(args, &i, arg, j)\n   107→\t\t\t\tcount, negative = mustParseByteCount(val)\n   108→\t\t\t\tmode = modeBytes\n   109→\t\t\t\tj = len(arg)\n   110→\t\t\tcase 'q':\n   111→\t\t\t\tquiet = true\n   112→\t\t\t\tverbose = false\n   113→\t\t\t\tj++\n   114→\t\t\tcase 'v':\n   115→\t\t\t\tverbose = true\n   116→\t\t\t\tquiet = false\n   117→\t\t\t\tj++\n   118→\t\t\tdefault:\n   119→\t\t\t\tdie(fmt.Sprintf(\"invalid option -- '%c'\", arg[j]))\n   120→\t\t\t}\n   121→\t\t}\n   122→\t}\n   123→\n   124→\tif len(files) == 0 {\n   125→\t\tfiles = []string{\"-\"}\n   126→\t}\n   127→\n   128→\tshowHeaders := (len(files) > 1 && !quiet) || verbose\n   129→\tif quiet {\n   130→\t\tshowHeaders = false\n   131→\t}\n   132→\n   133→\texitCode := 0\n   134→\tfor idx, file := range files {\n   135→\t\tif showHeaders {\n   136→\t\t\tif idx > 0 {\n   137→\t\t\t\tfmt.Println()\n   138→\t\t\t}\n   139→\t\t\tname := file\n   140→\t\t\tif file == \"-\" {\n   141→\t\t\t\tname = \"standard input\"\n   142→\t\t\t}\n   143→\t\t\tfmt.Printf(\"==> %s <==\\n\", name)\n   144→\t\t}\n   145→\n   146→\t\tr, closer, err := openInput(file)\n   147→\t\tif err != nil {\n   148→\t\t\tfmt.Fprintf(os.Stderr, \"head: cannot open '%s' for reading: %s\\n\",\n   149→\t\t\t\tfile, capitalizeErr(err))\n   150→\t\t\texitCode = 1\n   151→\t\t\tcontinue\n   152→\t\t}\n   153→\n   154→\t\tswitch {\n   155→\t\tcase mode == modeLines && !negative:\n   156→\t\t\terr = printFirstNLines(r, count)\n   157→\t\tcase mode == modeLines && negative:\n   158→\t\t\terr = printAllButLastNLines(r, count)\n   159→\t\tcase mode == modeBytes && !negative:\n   160→\t\t\terr = printFirstNBytes(r, count)\n   161→\t\tcase mode == modeBytes && negative:\n   162→\t\t\terr = printAllButLastNBytes(r, count)\n   163→\t\t}\n   164→\t\tif closer != nil {\n   165→\t\t\tcloser.Close()\n   166→\t\t}\n   167→\t\tif err != nil {\n   168→\t\t\tfmt.Fprintf(os.Stderr, \"head: error reading '%s': %s\\n\", file, err)\n   169→\t\t\texitCode = 1\n   170→\t\t}\n   171→\t}\n   172→\tos.Exit(exitCode)\n   173→}\n   174→\n   175→// R1.1, R1.2: Print the first n lines.\n   176→func printFirstNLines(r io.Reader, n int64) error {\n   177→\tbr := bufio.NewReader(r)\n   178→\tvar printed int64\n   179→\tfor printed < n {\n   180→\t\tline, err := br.ReadBytes('\\n')\n   181→\t\tif len(line) > 0 {\n   182→\t\t\tos.Stdout.Write(line)\n   183→\t\t\tprinted++\n   184→\t\t}\n   185→\t\tif err != nil {\n   186→\t\t\tif err == io.EOF {\n   187→\t\t\t\treturn nil\n   188→\t\t\t}\n   189→\t\t\treturn err\n   190→\t\t}\n   191→\t}\n   192→\treturn nil\n   193→}\n   194→\n   195→// R1.3: Print all lines except the last n.\n   196→func printAllButLastNLines(r io.Reader, n int64) error {\n   197→\tdata, err := io.ReadAll(r)\n   198→\tif err != nil {\n   199→\t\treturn err\n   200→\t}\n   201→\tlines := splitLines(data)\n   202→\tend := int64(len(lines)) - n\n   203→\tif end <= 0 {\n   204→\t\treturn nil\n   205→\t}\n   206→\tfor i := range end {\n   207→\t\tos.Stdout.Write(lines[i])\n   208→\t}\n   209→\treturn nil\n   210→}\n   211→\n   212→// R2.1: Print the first n bytes.\n   213→func printFirstNBytes(r io.Reader, n int64) error {\n   214→\t_, err := io.CopyN(os.Stdout, r, n)\n   215→\tif err == io.EOF {\n   216→\t\treturn nil\n   217→\t}\n   218→\treturn err\n   219→}\n   220→\n   221→// R2.2: Print all bytes except the last n.\n   222→func printAllButLastNBytes(r io.Reader, n int64) error {\n   223→\tdata, err := io.ReadAll(r)\n   224→\tif err != nil {\n   225→\t\treturn err\n   226→\t}\n   227→\tend := int64(len(data)) - n\n   228→\tif end <= 0 {\n   229→\t\treturn nil\n   230→\t}\n   231→\t_, err = os.Stdout.Write(data[:end])\n   232→\treturn err\n   233→}\n   234→\n   235→func splitLines(data []byte) [][]byte {\n   236→\tvar lines [][]byte\n   237→\tstart := 0\n   238→\tfor i, b := range data {\n   239→\t\tif b == '\\n' {\n   240→\t\t\tlines = append(lines, data[start:i+1])\n   241→\t\t\tstart = i + 1\n   242→\t\t}\n   243→\t}\n   244→\tif start < len(data) {\n   245→\t\tlines = append(lines, data[start:])\n   246→\t}\n   247→\treturn lines\n   248→}\n   249→\n   250→func openInput(file string) (io.Reader, io.Closer, error) {\n   251→\tif file == \"-\" {\n   252→\t\treturn os.Stdin, nil, nil\n   253→\t}\n   254→\tf, err := os.Open(file)\n   255→\tif err != nil {\n   256→\t\treturn nil, nil, err\n   257→\t}\n   258→\treturn f, f, nil\n   259→}\n   260→\n   261→func longOptValue(args []string, i *int) (string, bool) {\n   262→\targ := args[*i]\n   263→\tif _, val, ok := strings.Cut(arg, \"=\"); ok {\n   264→\t\treturn val, true\n   265→\t}\n   266→\t*i++\n   267→\tif *i >= len(args) {\n   268→\t\treturn \"\", false\n   269→\t}\n   270→\treturn args[*i], true\n   271→}\n   272→\n   273→func shortOptValue(args []string, i *int, arg string, j int) string {\n   274→\tif j+1 < len(arg) {\n   275→\t\treturn arg[j+1:]\n   276→\t}\n   277→\t*i++\n   278→\tif *i >= len(args) {\n   279→\t\tdie(fmt.Sprintf(\"option requires an argument -- '%c'\", arg[j]))\n   280→\t}\n   281→\treturn args[*i]\n   282→}\n   283→\n   284→func isNumericShorthand(arg string) bool {\n   285→\tif len(arg) < 2 || arg[0] != '-' {\n   286→\t\treturn false\n   287→\t}\n   288→\tfor _, c := range arg[1:] {\n   289→\t\tif c < '0' || c > '9' {\n   290→\t\t\treturn false\n   291→\t\t}\n   292→\t}\n   293→\treturn true\n   294→}\n   295→\n   296→func mustParseLineCount(s string) (int64, bool) {\n   297→\tneg := strings.HasPrefix(s, \"-\")\n   298→\tif neg {\n   299→\t\ts = s[1:]\n   300→\t}\n   301→\tn, err := strconv.ParseInt(s, 10, 64)\n   302→\tif err != nil {\n   303→\t\tdie(fmt.Sprintf(\"invalid number of lines: '%s'\", s))\n   304→\t}\n   305→\treturn n, neg\n   306→}\n   307→\n   308→func mustParseByteCount(s string) (int64, bool) {\n   309→\tneg := strings.HasPrefix(s, \"-\")\n   310→\tif neg {\n   311→\t\ts = s[1:]\n   312→\t}\n   313→\tn, suffix := splitNumSuffix(s)\n   314→\tval, err := strconv.ParseInt(n, 10, 64)\n   315→\tif err != nil {\n   316→\t\tdie(fmt.Sprintf(\"invalid number of bytes: '%s'\", s))\n   317→\t}\n   318→\tmult, ok := byteSuffix(suffix)\n   319→\tif !ok {\n   320→\t\tdie(fmt.Sprintf(\"invalid number of bytes: '%s'\", s))\n   321→\t}\n   322→\treturn val * mult, neg\n   323→}\n   324→\n   325→func splitNumSuffix(s string) (string, string) {\n   326→\ti := 0\n   327→\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n   328→\t\ti++\n   329→\t}\n   330→\treturn s[:i], s[i:]\n   331→}\n   332→\n   333→func byteSuffix(s string) (int64, bool) {\n   334→\tswitch s {\n   335→\tcase \"\":\n   336→\t\treturn 1, true\n   337→\tcase \"b\":\n   338→\t\treturn 512, true\n   339→\tcase \"K\", \"KiB\":\n   340→\t\treturn 1024, true\n   341→\tcase \"M\", \"MiB\":\n   342→\t\treturn 1024 * 1024, true\n   343→\tcase \"G\", \"GiB\":\n   344→\t\treturn 1024 * 1024 * 1024, true\n   345→\t}\n   346→\treturn 0, false\n   347→}\n   348→\n   349→// capitalizeErr capitalizes the first letter of the underlying error message\n   350→// to match GNU coreutils strerror() output format.\n   351→func capitalizeErr(err error) string {\n   352→\tmsg := err.Error()\n   353→\t// Extract the innermost error message (after last \": \").\n   354→\tif idx := strings.LastIndex(msg, \": \"); idx >= 0 {\n   355→\t\tmsg = msg[idx+2:]\n   356→\t}\n   357→\tif msg == \"\" {\n   358→\t\treturn msg\n   359→\t}\n   360→\trunes := []rune(msg)\n   361→\trunes[0] = unicode.ToUpper(runes[0])\n   362→\treturn string(runes)\n   363→}\n   364→\n   365→func die(msg string) {\n   366→\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", msg)\n   367→\tos.Exit(1)\n   368→}\n   369→"}]},"parent_tool_use_id":null,"session_id":"6d4c178c-c666-4b39-b0d2-ff47d37e3168","uuid":"f5c4c2e5-02ee-4110-a7e6-c5488e11a2b3","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/343/cmd/head/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements the head utility (prd018-head R1-R4).\n// head prints the first lines or bytes of each input file.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"unicode\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\n// countMode selects between line-count and byte-count output.\ntype countMode int\n\nconst (\n\tmodeLines countMode = iota\n\tmodeBytes\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tcount := int64(10)\n\tnegative := false\n\tmode := modeLines\n\tquiet := false\n\tverbose := false\n\tvar files []string\n\n\targs := os.Args[1:]\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif arg == \"-\" {\n\t\t\tfiles = append(files, \"-\")\n\t\t\tcontinue\n\t\t}\n\t\tif !strings.HasPrefix(arg, \"-\") {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\n\t\t// Long options.\n\t\tif strings.HasPrefix(arg, \"--lines\") {\n\t\t\tval, ok := longOptValue(args, &i)\n\t\t\tif !ok {\n\t\t\t\tdie(\"option '--lines' requires an argument\")\n\t\t\t}\n\t\t\tcount, negative = mustParseLineCount(val)\n\t\t\tmode = modeLines\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--bytes\") {\n\t\t\tval, ok := longOptValue(args, &i)\n\t\t\tif !ok {\n\t\t\t\tdie(\"option '--bytes' requires an argument\")\n\t\t\t}\n\t\t\tcount, negative = mustParseByteCount(val)\n\t\t\tmode = modeBytes\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--quiet\" || arg == \"--silent\" {\n\t\t\tquiet = true\n\t\t\tverbose = false\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--verbose\" {\n\t\t\tverbose = true\n\t\t\tquiet = false\n\t\t\tcontinue\n\t\t}\n\n\t\t// Numeric shorthand: -N means -n N.\n\t\tif isNumericShorthand(arg) {\n\t\t\tn, err := strconv.ParseInt(arg[1:], 10, 64)\n\t\t\tif err != nil {\n\t\t\t\tdie(fmt.Sprintf(\"invalid number of lines: '%s'\", arg[1:]))\n\t\t\t}\n\t\t\tcount = n\n\t\t\tnegative = false\n\t\t\tmode = modeLines\n\t\t\tcontinue\n\t\t}\n\n\t\t// Short options: -n, -c, -q, -v and combinations.\n\t\tj := 1\n\t\tfor j < len(arg) {\n\t\t\tswitch arg[j] {\n\t\t\tcase 'n':\n\t\t\t\tval := shortOptValue(args, &i, arg, j)\n\t\t\t\tcount, negative = mustParseLineCount(val)\n\t\t\t\tmode = modeLines\n\t\t\t\tj = len(arg)\n\t\t\tcase 'c':\n\t\t\t\tval := shortOptValue(args, &i, arg, j)\n\t\t\t\tcount, negative = mustParseByteCount(val)\n\t\t\t\tmode = modeBytes\n\t\t\t\tj = len(arg)\n\t\t\tcase 'q':\n\t\t\t\tquiet = true\n\t\t\t\tverbose = false\n\t\t\t\tj++\n\t\t\tcase 'v':\n\t\t\t\tverbose = true\n\t\t\t\tquiet = false\n\t\t\t\tj++\n\t\t\tdefault:\n\t\t\t\tdie(fmt.Sprintf(\"invalid option -- '%c'\", arg[j]))\n\t\t\t}\n\t\t}\n\t}\n\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\tshowHeaders := (len(files) > 1 && !quiet) || verbose\n\tif quiet {\n\t\tshowHeaders = false\n\t}\n\n\texitCode := 0\n\tfor idx, file := range files {\n\t\tif showHeaders {\n\t\t\tif idx > 0 {\n\t\t\t\tfmt.Println()\n\t\t\t}\n\t\t\tname := file\n\t\t\tif file == \"-\" {\n\t\t\t\tname = \"standard input\"\n\t\t\t}\n\t\t\tfmt.Printf(\"==> %s <==\\n\", name)\n\t\t}\n\n\t\tr, closer, err := openInput(file)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"head: cannot open '%s' for reading: %s\\n\",\n\t\t\t\tfile, capitalizeErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\n\t\tswitch {\n\t\tcase mode == modeLines && !negative:\n\t\t\terr = printFirstNLines(r, count)\n\t\tcase mode == modeLines && negative:\n\t\t\terr = printAllButLastNLines(r, count)\n\t\tcase mode == modeBytes && !negative:\n\t\t\terr = printFirstNBytes(r, count)\n\t\tcase mode == modeBytes && negative:\n\t\t\terr = printAllButLastNBytes(r, count)\n\t\t}\n\t\tif closer != nil {\n\t\t\tcloser.Close()\n\t\t}\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"head: error reading '%s': %s\\n\", file, err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tos.Exit(exitCode)\n}\n\n// R1.1, R1.2: Print the first n lines.\nfunc printFirstNLines(r io.Reader, n int64) error {\n\tbr := bufio.NewReader(r)\n\tvar printed int64\n\tfor printed < n {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tos.Stdout.Write(line)\n\t\t\tprinted++\n\t\t}\n\t\tif err != nil {\n\t\t\tif err == io.EOF {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\n// R1.3: Print all lines except the last n.\nfunc printAllButLastNLines(r io.Reader, n int64) error {\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tlines := splitLines(data)\n\tend := int64(len(lines)) - n\n\tif end <= 0 {\n\t\treturn nil\n\t}\n\tfor i := range end {\n\t\tos.Stdout.Write(lines[i])\n\t}\n\treturn nil\n}\n\n// R2.1: Print the first n bytes.\nfunc printFirstNBytes(r io.Reader, n int64) error {\n\t_, err := io.CopyN(os.Stdout, r, n)\n\tif err == io.EOF {\n\t\treturn nil\n\t}\n\treturn err\n}\n\n// R2.2: Print all bytes except the last n.\nfunc printAllButLastNBytes(r io.Reader, n int64) error {\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tend := int64(len(data)) - n\n\tif end <= 0 {\n\t\treturn nil\n\t}\n\t_, err = os.Stdout.Write(data[:end])\n\treturn err\n}\n\nfunc splitLines(data []byte) [][]byte {\n\tvar lines [][]byte\n\tstart := 0\n\tfor i, b := range data {\n\t\tif b == '\\n' {\n\t\t\tlines = append(lines, data[start:i+1])\n\t\t\tstart = i + 1\n\t\t}\n\t}\n\tif start < len(data) {\n\t\tlines = append(lines, data[start:])\n\t}\n\treturn lines\n}\n\nfunc openInput(file string) (io.Reader, io.Closer, error) {\n\tif file == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(file)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc longOptValue(args []string, i *int) (string, bool) {\n\targ := args[*i]\n\tif _, val, ok := strings.Cut(arg, \"=\"); ok {\n\t\treturn val, true\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\treturn \"\", false\n\t}\n\treturn args[*i], true\n}\n\nfunc shortOptValue(args []string, i *int, arg string, j int) string {\n\tif j+1 < len(arg) {\n\t\treturn arg[j+1:]\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\tdie(fmt.Sprintf(\"option requires an argument -- '%c'\", arg[j]))\n\t}\n\treturn args[*i]\n}\n\nfunc isNumericShorthand(arg string) bool {\n\tif len(arg) < 2 || arg[0] != '-' {\n\t\treturn false\n\t}\n\tfor _, c := range arg[1:] {\n\t\tif c < '0' || c > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc mustParseLineCount(s string) (int64, bool) {\n\tneg := strings.HasPrefix(s, \"-\")\n\tif neg {\n\t\ts = s[1:]\n\t}\n\tn, err := strconv.ParseInt(s, 10, 64)\n\tif err != nil {\n\t\tdie(fmt.Sprintf(\"invalid number of lines: '%s'\", s))\n\t}\n\treturn n, neg\n}\n\nfunc mustParseByteCount(s string) (int64, bool) {\n\tneg := strings.HasPrefix(s, \"-\")\n\tif neg {\n\t\ts = s[1:]\n\t}\n\tn, suffix := splitNumSuffix(s)\n\tval, err := strconv.ParseInt(n, 10, 64)\n\tif err != nil {\n\t\tdie(fmt.Sprintf(\"invalid number of bytes: '%s'\", s))\n\t}\n\tmult, ok := byteSuffix(suffix)\n\tif !ok {\n\t\tdie(fmt.Sprintf(\"invalid number of bytes: '%s'\", s))\n\t}\n\treturn val * mult, neg\n}\n\nfunc splitNumSuffix(s string) (string, string) {\n\ti := 0\n\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n\t\ti++\n\t}\n\treturn s[:i], s[i:]\n}\n\nfunc byteSuffix(s string) (int64, bool) {\n\tswitch s {\n\tcase \"\":\n\t\treturn 1, true\n\tcase \"b\":\n\t\treturn 512, true\n\tcase \"K\", \"KiB\":\n\t\treturn 1024, true\n\tcase \"M\", \"MiB\":\n\t\treturn 1024 * 1024, true\n\tcase \"G\", \"GiB\":\n\t\treturn 1024 * 1024 * 1024, true\n\t}\n\treturn 0, false\n}\n\n// capitalizeErr capitalizes the first letter of the underlying error message\n// to match GNU coreutils strerror() output format.\nfunc capitalizeErr(err error) string {\n\tmsg := err.Error()\n\t// Extract the innermost error message (after last \": \").\n\tif idx := strings.LastIndex(msg, \": \"); idx >= 0 {\n\t\tmsg = msg[idx+2:]\n\t}\n\tif msg == \"\" {\n\t\treturn msg\n\t}\n\trunes := []rune(msg)\n\trunes[0] = unicode.ToUpper(runes[0])\n\treturn string(runes)\n}\n\nfunc die(msg string) {\n\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", msg)\n\tos.Exit(1)\n}\n","numLines":369,"startLine":1,"totalLines":369}}}
