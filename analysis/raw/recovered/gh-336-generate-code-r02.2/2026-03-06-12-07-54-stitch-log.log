en(arg); j++ {\n    56→\t\t\t\tswitch arg[j] {\n    57→\t\t\t\tcase 'n':\n    58→\t\t\t\t\tcount, negative = mustParseLineCount(shortVal(args, &i, arg, j))\n    59→\t\t\t\t\tmode, j = modeLines, len(arg)-1\n    60→\t\t\t\tcase 'c':\n    61→\t\t\t\t\tcount, negative = mustParseByteCount(shortVal(args, &i, arg, j))\n    62→\t\t\t\t\tmode, j = modeBytes, len(arg)-1\n    63→\t\t\t\tcase 'q':\n    64→\t\t\t\t\tquiet, verbose = true, false\n    65→\t\t\t\tcase 'v':\n    66→\t\t\t\t\tverbose, quiet = true, false\n    67→\t\t\t\tdefault:\n    68→\t\t\t\t\tdie(fmt.Sprintf(\"invalid option -- '%c'\", arg[j]))\n    69→\t\t\t\t}\n    70→\t\t\t}\n    71→\t\t}\n    72→\t}\n    73→\tif len(files) == 0 {\n    74→\t\tfiles = []string{\"-\"}\n    75→\t}\n    76→\tshowHeaders := (len(files) > 1 && !quiet) || (verbose && !quiet)\n    77→\texitCode := 0\n    78→\tfor idx, file := range files {\n    79→\t\tif showHeaders {\n    80→\t\t\tif idx > 0 {\n    81→\t\t\t\tfmt.Println()\n    82→\t\t\t}\n    83→\t\t\tname := file\n    84→\t\t\tif file == \"-\" {\n    85→\t\t\t\tname = \"standard input\"\n    86→\t\t\t}\n    87→\t\t\tfmt.Printf(\"==> %s <==\\n\", name)\n    88→\t\t}\n    89→\t\tr, closer, err := openInput(file)\n    90→\t\tif err != nil {\n    91→\t\t\tfmt.Fprintf(os.Stderr, \"head: cannot open '%s' for reading: %s\\n\", file, capitalizeErr(err))\n    92→\t\t\texitCode = 1\n    93→\t\t\tcontinue\n    94→\t\t}\n    95→\t\tswitch {\n    96→\t\tcase mode == modeLines && !negative:\n    97→\t\t\terr = headLines(r, count)\n    98→\t\tcase mode == modeLines && negative:\n    99→\t\t\terr = headLinesNeg(r, count)\n   100→\t\tcase mode == modeBytes && !negative:\n   101→\t\t\terr = headBytes(r, count)\n   102→\t\tdefault:\n   103→\t\t\terr = headBytesNeg(r, count)\n   104→\t\t}\n   105→\t\tif closer != nil {\n   106→\t\t\tcloser.Close()\n   107→\t\t}\n   108→\t\tif err != nil {\n   109→\t\t\tfmt.Fprintf(os.Stderr, \"head: error reading '%s': %s\\n\", file, err)\n   110→\t\t\texitCode = 1\n   111→\t\t}\n   112→\t}\n   113→\tos.Exit(exitCode)\n   114→}\n   115→\n   116→// R1.1, R1.2: Print the first n lines.\n   117→func headLines(r io.Reader, n int64) error {\n   118→\tbr := bufio.NewReader(r)\n   119→\tfor printed := int64(0); printed < n; printed++ {\n   120→\t\tline, err := br.ReadBytes('\\n')\n   121→\t\tif len(line) > 0 {\n   122→\t\t\tos.Stdout.Write(line)\n   123→\t\t}\n   124→\t\tif err != nil {\n   125→\t\t\tif err == io.EOF {\n   126→\t\t\t\treturn nil\n   127→\t\t\t}\n   128→\t\t\treturn err\n   129→\t\t}\n   130→\t}\n   131→\treturn nil\n   132→}\n   133→\n   134→// R1.3: Print all lines except the last n.\n   135→func headLinesNeg(r io.Reader, n int64) error {\n   136→\tdata, err := io.ReadAll(r)\n   137→\tif err != nil {\n   138→\t\treturn err\n   139→\t}\n   140→\tlines := splitLines(data)\n   141→\tend := int64(len(lines)) - n\n   142→\tfor i := range max(end, 0) {\n   143→\t\tos.Stdout.Write(lines[i])\n   144→\t}\n   145→\treturn nil\n   146→}\n   147→\n   148→// R2.1: Print the first n bytes.\n   149→func headBytes(r io.Reader, n int64) error {\n   150→\t_, err := io.CopyN(os.Stdout, r, n)\n   151→\tif err == io.EOF {\n   152→\t\treturn nil\n   153→\t}\n   154→\treturn err\n   155→}\n   156→\n   157→// R2.2: Print all bytes except the last n.\n   158→func headBytesNeg(r io.Reader, n int64) error {\n   159→\tdata, err := io.ReadAll(r)\n   160→\tif err != nil {\n   161→\t\treturn err\n   162→\t}\n   163→\tif end := int64(len(data)) - n; end > 0 {\n   164→\t\t_, err = os.Stdout.Write(data[:end])\n   165→\t\treturn err\n   166→\t}\n   167→\treturn nil\n   168→}\n   169→\n   170→func splitLines(data []byte) [][]byte {\n   171→\tvar lines [][]byte\n   172→\tstart := 0\n   173→\tfor i, b := range data {\n   174→\t\tif b == '\\n' {\n   175→\t\t\tlines = append(lines, data[start:i+1])\n   176→\t\t\tstart = i + 1\n   177→\t\t}\n   178→\t}\n   179→\tif start < len(data) {\n   180→\t\tlines = append(lines, data[start:])\n   181→\t}\n   182→\treturn lines\n   183→}\n   184→\n   185→func openInput(file string) (io.Reader, io.Closer, error) {\n   186→\tif file == \"-\" {\n   187→\t\treturn os.Stdin, nil, nil\n   188→\t}\n   189→\tf, err := os.Open(file)\n   190→\tif err != nil {\n   191→\t\treturn nil, nil, err\n   192→\t}\n   193→\treturn f, f, nil\n   194→}\n   195→\n   196→func mustLongVal(args []string, i *int, name string) string {\n   197→\tif _, val, ok := strings.Cut(args[*i], \"=\"); ok {\n   198→\t\treturn val\n   199→\t}\n   200→\t*i++\n   201→\tif *i >= len(args) {\n   202→\t\tdie(fmt.Sprintf(\"option '%s' requires an argument\", name))\n   203→\t}\n   204→\treturn args[*i]\n   205→}\n   206→\n   207→func shortVal(args []string, i *int, arg string, j int) string {\n   208→\tif j+1 < len(arg) {\n   209→\t\treturn arg[j+1:]\n   210→\t}\n   211→\t*i++\n   212→\tif *i >= len(args) {\n   213→\t\tdie(fmt.Sprintf(\"option requires an argument -- '%c'\", arg[j]))\n   214→\t}\n   215→\treturn args[*i]\n   216→}\n   217→\n   218→func isNumericShorthand(arg string) bool {\n   219→\tif len(arg) < 2 {\n   220→\t\treturn false\n   221→\t}\n   222→\tfor _, c := range arg[1:] {\n   223→\t\tif c < '0' || c > '9' {\n   224→\t\t\treturn false\n   225→\t\t}\n   226→\t}\n   227→\treturn true\n   228→}\n   229→\n   230→func mustParseLineCount(s string) (int64, bool) {\n   231→\tneg := strings.HasPrefix(s, \"-\")\n   232→\tif neg {\n   233→\t\ts = s[1:]\n   234→\t}\n   235→\tn, err := strconv.ParseInt(s, 10, 64)\n   236→\tif err != nil {\n   237→\t\tdie(fmt.Sprintf(\"invalid number of lines: '%s'\", s))\n   238→\t}\n   239→\treturn n, neg\n   240→}\n   241→\n   242→func mustParseByteCount(s string) (int64, bool) {\n   243→\tneg := strings.HasPrefix(s, \"-\")\n   244→\tif neg {\n   245→\t\ts = s[1:]\n   246→\t}\n   247→\ti := 0\n   248→\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n   249→\t\ti++\n   250→\t}\n   251→\tval, err := strconv.ParseInt(s[:i], 10, 64)\n   252→\tif err != nil {\n   253→\t\tdie(fmt.Sprintf(\"invalid number of bytes: '%s'\", s))\n   254→\t}\n   255→\tmult := int64(1)\n   256→\tswitch s[i:] {\n   257→\tcase \"\":\n   258→\tcase \"b\":\n   259→\t\tmult = 512\n   260→\tcase \"K\", \"KiB\":\n   261→\t\tmult = 1024\n   262→\tcase \"M\", \"MiB\":\n   263→\t\tmult = 1024 * 1024\n   264→\tcase \"G\", \"GiB\":\n   265→\t\tmult = 1024 * 1024 * 1024\n   266→\tdefault:\n   267→\t\tdie(fmt.Sprintf(\"invalid number of bytes: '%s'\", s))\n   268→\t}\n   269→\treturn val * mult, neg\n   270→}\n   271→\n   272→func capitalizeErr(err error) string {\n   273→\tmsg := err.Error()\n   274→\tif idx := strings.LastIndex(msg, \": \"); idx >= 0 {\n   275→\t\tmsg = msg[idx+2:]\n   276→\t}\n   277→\trunes := []rune(msg)\n   278→\tif len(runes) > 0 {\n   279→\t\trunes[0] = unicode.ToUpper(runes[0])\n   280→\t}\n   281→\treturn string(runes)\n   282→}\n   283→\n   284→func die(msg string) {\n   285→\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", msg)\n   286→\tos.Exit(1)\n   287→}\n   288→"}]},"parent_tool_use_id":null,"session_id":"6d4c178c-c666-4b39-b0d2-ff47d37e3168","uuid":"c99ea11c-a11d-47cb-892d-e018ec9ac6d3","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/343/cmd/head/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements the head utility (prd018-head R1-R4).\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"unicode\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype countMode int\n\nconst (\n\tmodeLines countMode = iota\n\tmodeBytes\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tcount, negative, mode, quiet, verbose, files := int64(10), false, modeLines, false, false, []string(nil)\n\targs := os.Args[1:]\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase strings.HasPrefix(arg, \"--lines\"):\n\t\t\tcount, negative = mustParseLineCount(mustLongVal(args, &i, \"--lines\"))\n\t\t\tmode = modeLines\n\t\tcase strings.HasPrefix(arg, \"--bytes\"):\n\t\t\tcount, negative = mustParseByteCount(mustLongVal(args, &i, \"--bytes\"))\n\t\t\tmode = modeBytes\n\t\tcase arg == \"--quiet\", arg == \"--silent\":\n\t\t\tquiet, verbose = true, false\n\t\tcase arg == \"--verbose\":\n\t\t\tverbose, quiet = true, false\n\t\tcase isNumericShorthand(arg):\n\t\t\tcount, _ = strconv.ParseInt(arg[1:], 10, 64)\n\t\t\tnegative, mode = false, modeLines\n\t\tdefault:\n\t\t\tfor j := 1; j < len(arg); j++ {\n\t\t\t\tswitch arg[j] {\n\t\t\t\tcase 'n':\n\t\t\t\t\tcount, negative = mustParseLineCount(shortVal(args, &i, arg, j))\n\t\t\t\t\tmode, j = modeLines, len(arg)-1\n\t\t\t\tcase 'c':\n\t\t\t\t\tcount, negative = mustParseByteCount(shortVal(args, &i, arg, j))\n\t\t\t\t\tmode, j = modeBytes, len(arg)-1\n\t\t\t\tcase 'q':\n\t\t\t\t\tquiet, verbose = true, false\n\t\t\t\tcase 'v':\n\t\t\t\t\tverbose, quiet = true, false\n\t\t\t\tdefault:\n\t\t\t\t\tdie(fmt.Sprintf(\"invalid option -- '%c'\", arg[j]))\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\tshowHeaders := (len(files) > 1 && !quiet) || (verbose && !quiet)\n\texitCode := 0\n\tfor idx, file := range files {\n\t\tif showHeaders {\n\t\t\tif idx > 0 {\n\t\t\t\tfmt.Println()\n\t\t\t}\n\t\t\tname := file\n\t\t\tif file == \"-\" {\n\t\t\t\tname = \"standard input\"\n\t\t\t}\n\t\t\tfmt.Printf(\"==> %s <==\\n\", name)\n\t\t}\n\t\tr, closer, err := openInput(file)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"head: cannot open '%s' for reading: %s\\n\", file, capitalizeErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase mode == modeLines && !negative:\n\t\t\terr = headLines(r, count)\n\t\tcase mode == modeLines && negative:\n\t\t\terr = headLinesNeg(r, count)\n\t\tcase mode == modeBytes && !negative:\n\t\t\terr = headBytes(r, count)\n\t\tdefault:\n\t\t\terr = headBytesNeg(r, count)\n\t\t}\n\t\tif closer != nil {\n\t\t\tcloser.Close()\n\t\t}\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"head: error reading '%s': %s\\n\", file, err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tos.Exit(exitCode)\n}\n\n// R1.1, R1.2: Print the first n lines.\nfunc headLines(r io.Reader, n int64) error {\n\tbr := bufio.NewReader(r)\n\tfor printed := int64(0); printed < n; printed++ {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tos.Stdout.Write(line)\n\t\t}\n\t\tif err != nil {\n\t\t\tif err == io.EOF {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\n// R1.3: Print all lines except the last n.\nfunc headLinesNeg(r io.Reader, n int64) error {\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tlines := splitLines(data)\n\tend := int64(len(lines)) - n\n\tfor i := range max(end, 0) {\n\t\tos.Stdout.Write(lines[i])\n\t}\n\treturn nil\n}\n\n// R2.1: Print the first n bytes.\nfunc headBytes(r io.Reader, n int64) error {\n\t_, err := io.CopyN(os.Stdout, r, n)\n\tif err == io.EOF {\n\t\treturn nil\n\t}\n\treturn err\n}\n\n// R2.2: Print all bytes except the last n.\nfunc headBytesNeg(r io.Reader, n int64) error {\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif end := int64(len(data)) - n; end > 0 {\n\t\t_, err = os.Stdout.Write(data[:end])\n\t\treturn err\n\t}\n\treturn nil\n}\n\nfunc splitLines(data []byte) [][]byte {\n\tvar lines [][]byte\n\tstart := 0\n\tfor i, b := range data {\n\t\tif b == '\\n' {\n\t\t\tlines = append(lines, data[start:i+1])\n\t\t\tstart = i + 1\n\t\t}\n\t}\n\tif start < len(data) {\n\t\tlines = append(lines, data[start:])\n\t}\n\treturn lines\n}\n\nfunc openInput(file string) (io.Reader, io.Closer, error) {\n\tif file == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(file)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc mustLongVal(args []string, i *int, name string) string {\n\tif _, val, ok := strings.Cut(args[*i], \"=\"); ok {\n\t\treturn val\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\tdie(fmt.Sprintf(\"option '%s' requires an argument\", name))\n\t}\n\treturn args[*i]\n}\n\nfunc shortVal(args []string, i *int, arg string, j int) string {\n\tif j+1 < len(arg) {\n\t\treturn arg[j+1:]\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\tdie(fmt.Sprintf(\"option requires an argument -- '%c'\", arg[j]))\n\t}\n\treturn args[*i]\n}\n\nfunc isNumericShorthand(arg string) bool {\n\tif len(arg) < 2 {\n\t\treturn false\n\t}\n\tfor _, c := range arg[1:] {\n\t\tif c < '0' || c > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc mustParseLineCount(s string) (int64, bool) {\n\tneg := strings.HasPrefix(s, \"-\")\n\tif neg {\n\t\ts = s[1:]\n\t}\n\tn, err := strconv.ParseInt(s, 10, 64)\n\tif err != nil {\n\t\tdie(fmt.Sprintf(\"invalid number of lines: '%s'\", s))\n\t}\n\treturn n, neg\n}\n\nfunc mustParseByteCount(s string) (int64, bool) {\n\tneg := strings.HasPrefix(s, \"-\")\n\tif neg {\n\t\ts = s[1:]\n\t}\n\ti := 0\n\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n\t\ti++\n\t}\n\tval, err := strconv.ParseInt(s[:i], 10, 64)\n\tif err != nil {\n\t\tdie(fmt.Sprintf(\"invalid number of bytes: '%s'\", s))\n\t}\n\tmult := int64(1)\n\tswitch s[i:] {\n\tcase \"\":\n\tcase \"b\":\n\t\tmult = 512\n\tcase \"K\", \"KiB\":\n\t\tmult = 1024\n\tcase \"M\", \"MiB\":\n\t\tmult = 1024 * 1024\n\tcase \"G\", \"GiB\":\n\t\tmult = 1024 * 1024 * 1024\n\tdefault:\n\t\tdie(fmt.Sprintf(\"invalid number of bytes: '%s'\", s))\n\t}\n\treturn val * mult, neg\n}\n\nfunc capitalizeErr(err error) string {\n\tmsg := err.Error()\n\tif idx := strings.LastIndex(msg, \": \"); idx >= 0 {\n\t\tmsg = msg[idx+2:]\n\t}\n\trunes := []rune(msg)\n\tif len(runes) > 0 {\n\t\trunes[0] = unicode.ToUpper(runes[0])\n\t}\n\treturn string(runes)\n}\n\nfunc die(msg string) {\n\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", msg)\n\tos.Exit(1)\n}\n","numLines":288,"startLine":1,"totalLines":288}}}
