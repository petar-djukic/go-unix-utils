 sys\n\nimport (\n\t\"os\"\n\t\"time\"\n\n\t\"golang.org/x/sys/unix\"\n)\n\n// FileInfo holds extended file metadata extracted from the platform stat\n// structure. It supplements os.FileInfo with Unix-specific fields that the\n// standard library does not expose portably (Nlink, Uid, Gid, Rdev, Dev,\n// Ino, Blocks, Blksize, AccessTime, ChangeTime).\n//\n// R2.2: extended file metadata struct.\ntype FileInfo struct {\n\tMode       os.FileMode\n\tSize       int64\n\tNlink      uint64\n\tUid        uint32\n\tGid        uint32\n\tRdev       uint64\n\tDev        uint64\n\tIno        uint64\n\tBlocks     int64\n\tBlksize    int64\n\tModTime    time.Time\n\tAccessTime time.Time\n\tChangeTime time.Time\n\tInfo       os.FileInfo\n}\n\n// Stat returns extended file metadata for path, following symlinks.\n//\n// R2.1: Stat follows symlinks.\nfunc Stat(path string) (*FileInfo, error) {\n\tosInfo, err := os.Stat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar st unix.Stat_t\n\tif err := unix.Stat(path, &st); err != nil {\n\t\treturn nil, err\n\t}\n\treturn populateFileInfo(osInfo, &st), nil\n}\n\n// Lstat returns extended file metadata for path without following symlinks.\n//\n// R2.1: Lstat does not follow symlinks.\nfunc Lstat(path string) (*FileInfo, error) {\n\tosInfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar st unix.Stat_t\n\tif err := unix.Lstat(path, &st); err != nil {\n\t\treturn nil, err\n\t}\n\treturn populateFileInfo(osInfo, &st), nil\n}\n"}}
