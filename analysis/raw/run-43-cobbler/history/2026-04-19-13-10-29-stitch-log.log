NCH listener goroutine starts exactly once.\nvar resizeOnce sync.Once\n\n// OnTerminalResize registers a callback invoked when the terminal is resized\n// (SIGWINCH). The callback receives the new terminal width. Multiple calls\n// register multiple callbacks; all are invoked in registration order.\n// If TerminalWidth() returns an error on resize, the callback is not invoked.\n//\n// R2.6: SIGWINCH-based resize notification.\n// R3.1: handler calls TerminalWidth() and invokes callback with new width.\n// R3.2: supports multiple callbacks in registration order.\nfunc OnTerminalResize(callback func(width int)) {\n\tresizeMu.Lock()\n\tresizeCallbacks = append(resizeCallbacks, callback)\n\tresizeMu.Unlock()\n\n\tresizeOnce.Do(func() {\n\t\tc := make(chan os.Signal, 1)\n\t\tsignal.Notify(c, syscall.SIGWINCH)\n\t\tgo listenForResize(c)\n\t})\n}\n\n// listenForResize loops on the signal channel, querying the terminal width\n// and invoking all registered callbacks on each SIGWINCH.\nfunc listenForResize(c <-chan os.Signal) {\n\tfor range c {\n\t\twidth, err := TerminalWidth()\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tresizeMu.Lock()\n\t\tcbs := make([]func(width int), len(resizeCallbacks))\n\t\tcopy(cbs, resizeCallbacks)\n\t\tresizeMu.Unlock()\n\t\tfor _, cb := range cbs {\n\t\t\tcb(width)\n\t\t}\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":176,"cache_read_input_tokens":80982,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":176},"output_tokens":65,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"f925e3bd-1225-4c4f-a60e-443f7116398f","uuid":"059f391b-2d4d-48fa-aeec-6ef9fff8b0fc"}
