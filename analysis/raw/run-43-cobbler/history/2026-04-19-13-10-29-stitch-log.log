{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01WecZfwGHYYtCJMLPt3nx3V","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WJiUAuXogCXCPWUvoikM9h","name":"Write","input":{"file_path":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5011/pkg/sys/terminal.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage sys\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/signal\"\n\t\"sync\"\n\t\"syscall\"\n\n\t\"golang.org/x/sys/unix\"\n)\n\n// stdoutFD is the file descriptor for stdout, used by TerminalWidth.\nconst stdoutFD = 1\n\n// IsTerminal reports whether fd refers to a terminal device.\n// Returns false for pipes, regular files, non-terminal descriptors,\n// and invalid file descriptors without panicking.\n//\n// R1.3: terminal detection via IoctlGetWinsize.\n// R2.2-R2.4: works for any fd (stdin=0, stdout=1, stderr=2, or other).\nfunc IsTerminal(fd uintptr) bool {\n\t_, err := unix.IoctlGetWinsize(int(fd), unix.TIOCGWINSZ)\n\treturn err == nil\n}\n\n// TerminalWidth returns the width of the terminal in columns by querying\n// stdout via the TIOCGWINSZ ioctl. Returns an error if stdout is not a\n// terminal or the ioctl fails.\n//\n// R1.1: terminal width query via TIOCGWINSZ ioctl.\n// R2.5: uses IsTerminal as a guard before attempting the ioctl.\n// D2: no fallback width; returns 0 and the error on failure.\nfunc TerminalWidth() (int, error) {\n\tif !IsTerminal(stdoutFD) {\n\t\treturn 0, fmt.Errorf(\"stdout (fd %d) is not a terminal\", stdoutFD)\n\t}\n\tws, err := unix.IoctlGetWinsize(stdoutFD, unix.TIOCGWINSZ)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn int(ws.Col), nil\n}\n\n// resizeMu protects resizeCallbacks from concurrent access.\nvar resizeMu sync.Mutex\n\n// resizeCallbacks holds registered OnTerminalResize callbacks in\n// registration order.\nvar resizeCallbacks []func(width int)\n\n// resizeOnce ensures the SIGWINCH listener goroutine starts exactly once.\nvar resizeOnce sync.Once\n\n// OnTerminalResize registers a callback invoked when the terminal is resized\n// (SIGWINCH). The callback receives the new terminal width. Multiple calls\n// register multiple callbacks; all are invoked in registration order.\n// If TerminalWidth() returns an error on resize, the callback is not invoked.\n//\n// R2.6: SIGWINCH-based resize notification.\n// R3.1: handler calls TerminalWidth() and invokes callback with new width.\n// R3.2: supports multiple callbacks in registration order.\nfunc OnTerminalResize(callback func(width int)) {\n\tresizeMu.Lock()\n\tresizeCallbacks = append(resizeCallbacks, callback)\n\tresizeMu.Unlock()\n\n\tresizeOnce.Do(func() {\n\t\tc := make(chan os.Signal, 1)\n\t\tsignal.Notify(c, syscall.SIGWINCH)\n\t\tgo listenForResize(c)\n\t})\n}\n\n// listenForResize loops on the signal channel, querying the terminal width\n// and invoking all registered callbacks on each SIGWINCH.\nfunc listenForResize(c <-chan os.Signal) {\n\tfor range c {\n\t\twidth, err := TerminalWidth()\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tresizeMu.Lock()\n\t\tcbs := make([]func(width int), len(resizeCallbacks))\n\t\tcopy(cbs, resizeCallbacks)\n\t\tresizeMu.Unlock()\n\t\tfor _, cb := range cbs {\n\t\t\tcb(width)\n\t\t}\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2281,"cache_read_input_tokens":76669,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2281},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"f925e3bd-1225-4c4f-a60e-443f7116398f","uuid":"c5c6152f-8f2f-4288-b081-21043e1688fd"}
