on in next task (srd087-sizeparse R2.1-R2.2).\nfunc ParseWithOptions(s string, opts ParseOptions) (int64, error) {\n\tif s == \"\" {\n\t\treturn 0, fmt.Errorf(\"invalid size: empty string\")\n\t}\n\n\tnum, suffix, err := splitNumSuffix(s, opts.AllowSign)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\tmultiplier := opts.DefaultUnit\n\tif multiplier == 0 {\n\t\tmultiplier = 1\n\t}\n\n\tif suffix != \"\" {\n\t\tupper := strings.ToUpper(suffix)\n\t\tm, ok := suffixMultiplier[upper]\n\t\tif !ok {\n\t\t\treturn 0, fmt.Errorf(\"invalid suffix %q in size %q\", suffix, s)\n\t\t}\n\t\tmultiplier = m\n\t}\n\n\treturn num * multiplier, nil\n}\n\n// splitNumSuffix splits a size string into its numeric and suffix parts.\nfunc splitNumSuffix(s string, allowSign bool) (int64, string, error) {\n\tstart := 0\n\tsign := int64(1)\n\n\tif len(s) > 0 && (s[0] == '+' || s[0] == '-') {\n\t\tif !allowSign {\n\t\t\treturn 0, \"\", fmt.Errorf(\"invalid size %q: sign not allowed\", s)\n\t\t}\n\t\tif s[0] == '-' {\n\t\t\tsign = -1\n\t\t}\n\t\tstart = 1\n\t}\n\n\t// Find where digits end.\n\tend := start\n\tfor end < len(s) && s[end] >= '0' && s[end] <= '9' {\n\t\tend++\n\t}\n\n\tif end == start {\n\t\treturn 0, \"\", fmt.Errorf(\"invalid size %q: no digits\", s)\n\t}\n\n\tnumStr := s[start:end]\n\tsuffix := s[end:]\n\n\tnum, err := strconv.ParseInt(numStr, 10, 64)\n\tif err != nil {\n\t\treturn 0, \"\", fmt.Errorf(\"invalid size %q: %w\", s, err)\n\t}\n\n\treturn sign * num, suffix, nil\n}\n","structuredPatch":[{"oldStart":35,"oldLines":10,"newStart":35,"newLines":7,"lines":["   \"PIB\": 1024 * 1024 * 1024 * 1024 * 1024,","   \"E\":   1024 * 1024 * 1024 * 1024 * 1024 * 1024,","   \"EIB\": 1024 * 1024 * 1024 * 1024 * 1024 * 1024,","-  \"Z\":   1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024,","-  \"ZIB\": 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024,","-  \"Y\":   1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024,","-  \"YIB\": 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024 * 1024,","+  // Z and Y suffixes overflow int64; omitted per R3.1."," ","   \"KB\": 1000,","   \"MB\": 1000 * 1000,"]},{"oldStart":46,"oldLines":8,"newStart":43,"newLines":7,"lines":["   \"TB\": 1000 * 1000 * 1000 * 1000,","   \"PB\": 1000 * 1000 * 1000 * 1000 * 1000,","   \"EB\": 1000 * 1000 * 1000 * 1000 * 1000 * 1000,","-  \"ZB\": 1000 * 1000 * 1000 * 1000 * 1000 * 1000 * 1000,","-  \"YB\": 1000 * 1000 * 1000 * 1000 * 1000 * 1000 * 1000 * 1000,","+  // ZB and YB suffixes overflow int64; omitted per R3.1."," }"," "," // Parse parses a size string and returns the byte count."]}],"userModified":false,"replaceAll":false}}
