byte count.\n// R1.1: accepts a non-negative integer with an optional size suffix.\n// R1.3: suffix matching is case-insensitive.\n// R1.4: bare integers with no suffix return the numeric value as-is.\nfunc Parse(s string) (int64, error) {\n\treturn ParseWithOptions(s, ParseOptions{\n\t\tAllowSign:   false,\n\t\tDefaultUnit: 1,\n\t})\n}\n\n// ParseWithOptions parses a size string with configurable options.\n// TODO: Full implementation in next task (srd087-sizeparse R2.1-R2.2).\nfunc ParseWithOptions(s string, opts ParseOptions) (int64, error) {\n\tif s == \"\" {\n\t\treturn 0, fmt.Errorf(\"invalid size: empty string\")\n\t}\n\n\tnum, suffix, err := splitNumSuffix(s, opts.AllowSign)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\tmultiplier := opts.DefaultUnit\n\tif multiplier == 0 {\n\t\tmultiplier = 1\n\t}\n\n\tif suffix != \"\" {\n\t\tupper := strings.ToUpper(suffix)\n\t\tm, ok := suffixMultiplier[upper]\n\t\tif !ok {\n\t\t\treturn 0, fmt.Errorf(\"invalid suffix %q in size %q\", suffix, s)\n\t\t}\n\t\tmultiplier = m\n\t}\n\n\treturn num * multiplier, nil\n}\n\n// splitNumSuffix splits a size string into its numeric and suffix parts.\nfunc splitNumSuffix(s string, allowSign bool) (int64, string, error) {\n\tstart := 0\n\tsign := int64(1)\n\n\tif len(s) > 0 && (s[0] == '+' || s[0] == '-') {\n\t\tif !allowSign {\n\t\t\treturn 0, \"\", fmt.Errorf(\"invalid size %q: sign not allowed\", s)\n\t\t}\n\t\tif s[0] == '-' {\n\t\t\tsign = -1\n\t\t}\n\t\tstart = 1\n\t}\n\n\t// Find where digits end.\n\tend := start\n\tfor end < len(s) && s[end] >= '0' && s[end] <= '9' {\n\t\tend++\n\t}\n\n\tif end == start {\n\t\treturn 0, \"\", fmt.Errorf(\"invalid size %q: no digits\", s)\n\t}\n\n\tnumStr := s[start:end]\n\tsuffix := s[end:]\n\n\tnum, err := strconv.ParseInt(numStr, 10, 64)\n\tif err != nil {\n\t\treturn 0, \"\", fmt.Errorf(\"invalid size %q: %w\", s, err)\n\t}\n\n\treturn sign * num, suffix, nil\n}\n","numLines":124,"startLine":1,"totalLines":124}}}
