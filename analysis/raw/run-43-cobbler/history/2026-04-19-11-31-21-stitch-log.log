{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CrWXMhF8oLc8Hr59w7oNdY","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Package testutils provides the differential testing harness for go-unix-utils.\n5\t// It executes a Go binary and a GNU reference binary with identical inputs and\n6\t// compares stdout, stderr, and exit code.\n7\t//\n8\t// Implements: srd001-testutils (R1-R5).\n9\tpackage testutils\n10\t\n11\timport (\n12\t\t\"bytes\"\n13\t\t\"context\"\n14\t\t\"fmt\"\n15\t\t\"os\"\n16\t\t\"os/exec\"\n17\t\t\"strings\"\n18\t\t\"testing\"\n19\t\t\"time\"\n20\t)\n21\t\n22\t// defaultTimeout is the maximum duration each binary invocation may run.\n23\t// R2.3: configurable timeout with 10-second default.\n24\tconst defaultTimeout = 10 * time.Second\n25\t\n26\t// maxStdinDisplay is the maximum bytes of stdin shown in error messages.\n27\t// R3.5: truncate stdin to 256 bytes in divergence reports.\n28\tconst maxStdinDisplay = 256\n29\t\n30\t// NormalizeFunc transforms raw output bytes before comparison. Applied to both\n31\t// the Go and reference binary outputs so non-deterministic fields (timestamps,\n32\t// PIDs) can be replaced with fixed placeholders.\n33\t//\n34\t// R1.4, R4.1: per-DiffTest normalization hook.\n35\ttype NormalizeFunc = func([]byte) []byte\n36\t\n37\t// DiffTest describes a single differential test case. Both the Go binary and the\n38\t// GNU reference binary are invoked with identical Args, Stdin, and Env. Their\n39\t// outputs are compared after optional normalization.\n40\t//\n41\t// R1.1-R1.4: test case data structure.\n42\ttype DiffTest struct {\n43\t\t// Name is the subtest name passed to t.Run. Required.\n44\t\tName string\n45\t\n46\t\t// Args are command-line arguments passed to both binaries.\n47\t\tArgs []string\n48\t\n49\t\t// Stdin is fed to both binaries on stdin. nil means EOF immediately;\n50\t\t// an empty non-nil slice opens stdin and closes it immediately (R1.2).\n51\t\tStdin []byte\n52\t\n53\t\t// Env contains KEY=VALUE pairs merged into the inherited environment.\n54\t\t// nil means inherit with LC_ALL=C default only (R1.3, R2.6).\n55\t\tEnv []string\n56\t\n57\t\t// WorkDir sets the working directory for both binaries. Empty means\n58\t\t// a per-test t.TempDir() is used (R2.5).\n59\t\tWorkDir string\n60\t\n61\t\t// ExitCode is the expected exit code from both binaries.\n62\t\tExitCode int\n63\t\n64\t\t// Normalize is a slice of functions applied in order to stdout and stderr\n65\t\t// of both binaries before comparison. nil or empty means no normalization\n66\t\t// (R4.1, R4.3).\n67\t\tNormalize []NormalizeFunc\n68\t\n69\t\t// ExpectedFiles maps relative file paths to expected byte content after\n70\t\t// execution, for utilities whose primary output is a file (R5.1).\n71\t\tExpectedFiles map[string][]byte\n72\t}\n73\t\n74\t// RunDiffTests runs each DiffTest as a named subtest, executing goBinary and\n75\t// refBinary with identical inputs and comparing their outputs.\n76\t//\n77\t// R2.1-R2.6, R3.1-R3.6: binary execution and comparison.\n78\tfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n79\t\tt.Helper()\n80\t\tfor _, tc := range tests {\n81\t\t\tt.Run(tc.Name, func(t *testing.T) {\n82\t\t\t\trunSubtest(t, goBinary, refBinary, tc)\n83\t\t\t})\n84\t\t}\n85\t}\n86\t\n87\t// runSubtest executes both binaries and compares their outputs for one test case.\n88\tfunc runSubtest(t *testing.T, goBinary, refBinary string, tc DiffTest) {\n89\t\tt.Helper()\n90\t\tworkDir := tc.WorkDir\n91\t\tif workDir == \"\" {\n92\t\t\tworkDir = t.TempDir()\n93\t\t}\n94\t\tenv := buildEnv(tc.Env)\n95\t\n96\t\trefOut, refErr, refExit := execBinary(t, refBinary, tc, env, workDir)\n97\t\tgoOut, goErr, goExit := execBinary(t, goBinary, tc, env, workDir)\n98\t\n99\t\tgoOut, goErr = applyNormalizers(goOut, goErr, tc.Normalize)\n100\t\trefOut, refErr = applyNormalizers(refOut, refErr, tc.Normalize)\n101\t\n102\t\treportDivergence(t, tc, refOut, goOut, refErr, goErr, refExit, goExit)\n103\t}\n104\t\n105\t// execBinary runs a single binary and returns its stdout, stderr, and exit code.\n106\t// R2.2: capture stdout, stderr, and exit code independently.\n107\t// R2.3: timeout enforcement via context.\n108\tfunc execBinary(t *testing.T, bin string, tc DiffTest, env []string, workDir string) ([]byte, []byte, int) {\n109\t\tt.Helper()\n110\t\tctx, cancel := context.WithTimeout(context.Background(), defaultTimeout)\n111\t\tdefer cancel()\n112\t\n113\t\tcmd := exec.CommandContext(ctx, bin, tc.Args...)\n114\t\tvar stdout, stderr bytes.Buffer\n115\t\tcmd.Stdout = &stdout\n116\t\tcmd.Stderr = &stderr\n117\t\tcmd.Env = env\n118\t\tcmd.Dir = workDir\n119\t\tif tc.Stdin != nil {\n120\t\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n121\t\t}\n122\t\n123\t\terr := cmd.Run()\n124\t\tif err != nil {\n125\t\t\treturn stdout.Bytes(), stderr.Bytes(), extractExitCode(t, err, ctx)\n126\t\t}\n127\t\treturn stdout.Bytes(), stderr.Bytes(), 0\n128\t}\n129\t\n130\t// extractExitCode returns the process exit code from an exec error.\n131\t// D2: extract exit code from exec.ExitError.ExitCode().\n132\tfunc extractExitCode(t *testing.T, err error, ctx context.Context) int {\n133\t\tt.Helper()\n134\t\tif ctx.Err() == context.DeadlineExceeded {\n135\t\t\tt.Fatalf(\"binary exceeded timeout of %v\", defaultTimeout)\n136\t\t}\n137\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n138\t\t\treturn exitErr.ExitCode()\n139\t\t}\n140\t\tt.Fatalf(\"unexpected exec error: %v\", err)\n141\t\treturn -1 // unreachable\n142\t}\n143\t\n144\t// buildEnv constructs the process environment for binary execution.\n145\t// R2.6: LC_ALL=C is set unless the test explicitly overrides it.\n146\tfunc buildEnv(testEnv []string) []string {\n147\t\tenv := os.Environ()\n148\t\tenv = setEnvDefault(env, \"LC_ALL\", \"C\")\n149\t\tfor _, kv := range testEnv {\n150\t\t\tenv = setEnvOverride(env, kv)\n151\t\t}\n152\t\treturn env\n153\t}\n154\t\n155\t// setEnvDefault adds key=value only if key is not already present.\n156\tfunc setEnvDefault(env []string, key, value string) []string {\n157\t\tprefix := key + \"=\"\n158\t\tfor _, e := range env {\n159\t\t\tif strings.HasPrefix(e, prefix) {\n160\t\t\t\treturn env\n161\t\t\t}\n162\t\t}\n163\t\treturn append(env, prefix+value)\n164\t}\n165\t\n166\t// setEnvOverride replaces an existing KEY=VALUE pair or appends it.\n167\tfunc setEnvOverride(env []string, kv string) []string {\n168\t\tkey, _, _ := strings.Cut(kv, \"=\")\n169\t\tprefix := key + \"=\"\n170\t\tfor i, e := range env {\n171\t\t\tif strings.HasPrefix(e, prefix) {\n172\t\t\t\tenv[i] = kv\n173\t\t\t\treturn env\n174\t\t\t}\n175\t\t}\n176\t\treturn append(env, kv)\n177\t}\n178\t\n179\t// applyNormalizers applies normalize functions to stdout and stderr in order.\n180\t// R4.1, R4.3: per-test normalization before comparison.\n181\tfunc applyNormalizers(stdout, stderr []byte, fns []NormalizeFunc) ([]byte, []byte) {\n182\t\tfor _, fn := range fns {\n183\t\t\tstdout = fn(stdout)\n184\t\t\tstderr = fn(stderr)\n185\t\t}\n186\t\treturn stdout, stderr\n187\t}\n188\t\n189\t// reportDivergence compares outputs and reports any differences via t.Errorf.\n190\t// D3: use t.Errorf so all tests in the slice run even when some fail.\n191\t// R3.5: report args, stdin, stdout, stderr, and exit codes.\n192\tfunc reportDivergence(t *testing.T, tc DiffTest, refOut, goOut, refErr, goErr []byte, refExit, goExit int) {\n193\t\tt.Helper()\n194\t\tif bytes.Equal(refOut, goOut) && bytes.Equal(refErr, goErr) && refExit == goExit {\n195\t\t\treturn\n196\t\t}\n197\t\tt.Errorf(\"divergence detected\\nargs: %v\\nstdin: %s\\n\"+\n198\t\t\t\"ref stdout: %q\\n go stdout: %q\\n\"+\n199\t\t\t\"ref stderr: %q\\n go stderr: %q\\n\"+\n200\t\t\t\"ref exit: %d\\n go exit: %d\",\n201\t\t\ttc.Args, formatStdin(tc.Stdin), refOut, goOut, refErr, goErr, refExit, goExit)\n202\t}\n203\t\n204\t// formatStdin f