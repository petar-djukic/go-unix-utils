the\n// GNU reference binary are invoked with identical Args, Stdin, and Env. Their\n// outputs are compared after optional normalization.\n//\n// R1.1-R1.4: test case data structure.\ntype DiffTest struct {\n\t// Name is the subtest name passed to t.Run. Required.\n\tName string\n\n\t// Args are command-line arguments passed to both binaries.\n\tArgs []string\n\n\t// Stdin is fed to both binaries on stdin. nil means EOF immediately;\n\t// an empty non-nil slice opens stdin and closes it immediately (R1.2).\n\tStdin []byte\n\n\t// Env contains KEY=VALUE pairs merged into the inherited environment.\n\t// nil means inherit with LC_ALL=C default only (R1.3, R2.6).\n\tEnv []string\n\n\t// WorkDir sets the working directory for both binaries. Empty means\n\t// a per-test t.TempDir() is used (R2.5).\n\tWorkDir string\n\n\t// ExitCode is the expected exit code from both binaries.\n\tExitCode int\n\n\t// Normalize is a slice of functions applied in order to stdout and stderr\n\t// of both binaries before comparison. nil or empty means no normalization\n\t// (R4.1, R4.3).\n\tNormalize []NormalizeFunc\n\n\t// ExpectedFiles maps relative file paths to expected byte content after\n\t// execution, for utilities whose primary output is a file (R5.1).\n\tExpectedFiles map[string][]byte\n}\n\n// RunDiffTests runs each DiffTest as a named subtest, executing goBinary and\n// refBinary with identical inputs and comparing their outputs.\n//\n// R2.1-R2.6, R3.1-R3.6: binary execution and comparison.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\trunSubtest(t, goBinary, refBinary, tc)\n\t\t})\n\t}\n}\n\n// runSubtest executes both binaries and compares their outputs for one test case.\nfunc runSubtest(t *testing.T, goBinary, refBinary string, tc DiffTest) {\n\tt.Helper()\n\tworkDir := tc.WorkDir\n\tif workDir == \"\" {\n\t\tworkDir = t.TempDir()\n\t}\n\tenv := buildEnv(tc.Env)\n\n\trefOut, refErr, refExit := execBinary(t, refBinary, tc, env, workDir)\n\tgoOut, goErr, goExit := execBinary(t, goBinary, tc, env, workDir)\n\n\tgoOut, goErr = applyNormalizers(goOut, goErr, tc.Normalize)\n\trefOut, refErr = applyNormalizers(refOut, refErr, tc.Normalize)\n\n\treportDivergence(t, tc, refOut, goOut, refErr, goErr, refExit, goExit)\n\tcheckExpectedFiles(t, tc, workDir)\n}\n\n// execBinary runs a single binary and returns its stdout, stderr, and exit code.\n// R2.2: capture stdout, stderr, and exit code independently.\n// R2.3: timeout enforcement via context.\nfunc execBinary(t *testing.T, bin string, tc DiffTest, env []string, workDir string) ([]byte, []byte, int) {\n\tt.Helper()\n\tctx, cancel := context.WithTimeout(context.Background(), defaultTimeout)\n\tdefer cancel()\n\n\tcmd := exec.CommandContext(ctx, bin, tc.Args...)\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\tcmd.Env = env\n\tcmd.Dir = workDir\n\tif tc.Stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n\t}\n\n\terr := cmd.Run()\n\tif err != nil {\n\t\treturn stdout.Bytes(), stderr.Bytes(), extractExitCode(t, err, ctx)\n\t}\n\treturn stdout.Bytes(), stderr.Bytes(), 0\n}\n\n// extractExitCode returns the process exit code from an exec error.\n// D2: extract exit code from exec.ExitError.ExitCode().\nfunc extractExitCode(t *testing.T, err error, ctx context.Context) int {\n\tt.Helper()\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatalf(\"binary exceeded timeout of %v\", defaultTimeout)\n\t}\n\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\treturn exitErr.ExitCode()\n\t}\n\tt.Fatalf(\"unexpected exec error: %v\", err)\n\treturn -1 // unreachable\n}\n\n// buildEnv constructs the process environment for binary execution.\n// R2.6: LC_ALL=C is set unless the test explicitly overrides it.\nfunc buildEnv(testEnv []string) []string {\n\tenv := os.Environ()\n\tenv = setEnvDefault(env, \"LC_ALL\", \"C\")\n\tfor _, kv := rang