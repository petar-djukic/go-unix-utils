timestamp patterns with a fixed"," // placeholder string. Used by cmd/ts tests."," //"," // R4.2: built-in timestamp normalization."," var TimestampNormalizer NormalizeFunc = func(b []byte) []byte {","-  panic(\"not implemented\")","+  return timestampPatterns.ReplaceAll(b, []byte(timestampPlaceholder))"," }"," "," // BuildBinary compiles the Go package at the given directory path and returns"," // the path to the resulting binary. The binary is placed in a test-managed"," // temporary directory and cleaned up when the test completes."," func BuildBinary(t *testing.T, dir string) string {","-  panic(\"not implemented\")","+  t.Helper()","+  out := filepath.Join(t.TempDir(), \"binary\")","+  cmd := exec.Command(\"go\", \"build\", \"-o\", out, dir)","+  var stderr bytes.Buffer","+  cmd.Stderr = &stderr","+  if err := cmd.Run(); err != nil {","+    t.Fatalf(\"BuildBinary: go build %s: %v\\n%s\", dir, err, stderr.String())","+  }","+  return out"," }"]}],"originalFile":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides the differential testing harness for go-unix-utils.\n// It executes a Go binary and a GNU reference binary with identical inputs and\n// compares stdout, stderr, and exit code.\n//\n// Implements: srd001-testutils (R1-R5).\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\n// defaultTimeout is the maximum duration each binary invocation may run.\n// R2.3: configurable timeout with 10-second default.\nconst defaultTimeout = 10 * time.Second\n\n// maxStdinDisplay is the maximum bytes of stdin shown in error messages.\n// R3.5: truncate stdin to 256 bytes in divergence reports.\nconst maxStdinDisplay = 256\n\n// NormalizeFunc transforms raw output bytes before comparison. Applied to both\n// the Go and reference binary outputs so non-deterministic fields (timestamps,\n// PIDs) can be replaced with fixed placeholders.\n//\n// R1.4, R4.1: per-DiffTest normalization hook.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest describes a single differential test case. Both the Go binary and the\n// GNU reference binary are invoked with identical Args, Stdin, and Env. Their\n// outputs are compared after optional normalization.\n//\n// R1.1-R1.4: test case data structure.\ntype DiffTest struct {\n\t// Name is the subtest name passed to t.Run. Required.\n\tName string\n\n\t// Args are command-line arguments passed to both binaries.\n\tArgs []string\n\n\t// Stdin is fed to both binaries on stdin. nil means EOF immediately;\n\t// an empty non-nil slice opens stdin and closes it immediately (R1.2).\n\tStdin []byte\n\n\t// Env contains KEY=VALUE pairs merged into the inherited environment.\n\t// nil means inherit with LC_ALL=C default only (R1.3, R2.6).\n\tEnv []string\n\n\t// WorkDir sets the working directory for both binaries. Empty means\n\t// a per-test t.TempDir() is used (R2.5).\n\tWorkDir string\n\n\t// ExitCode is the expected exit code from both binaries.\n\tExitCode int\n\n\t// Normalize is a slice of functions applied in order to stdout and stderr\n\t// of both binaries before comparison. nil or empty means no normalization\n\t// (R4.1, R4.3).\n\tNormalize []NormalizeFunc\n\n\t// ExpectedFiles maps relative file paths to expected byte content after\n\t// execution, for utilities whose primary output is a file (R5.1).\n\tExpectedFiles map[string][]byte\n}\n\n// RunDiffTests runs each DiffTest as a named subtest, executing goBinary and\n// refBinary with identical inputs and comparing their outputs.\n//\n// R2.1-R2.6, R3.1-R3.6: binary execution and comparison.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\trunSubtest(t, goBinary, refBinary, tc)\n\t\t})\n\t}\n}\n\n// runSubtest executes both binaries and compares their outputs for one test case.\nfunc runSubtest(t *testing.T, goBinary, refBinary string, tc DiffTest) {\n\tt.Helper()\n\tworkDir := tc.WorkDir\n\tif workDir == \"\" {\n\t\tworkDir = t.TempDir()\n\t}\n\tenv := buildEnv(tc.Env)\n\n\trefOut, refErr, refExit := execBinary(t, refBinary, tc, env, workDir)\n\tgoOut, goErr, goExit := execBinary(t, goBinary, tc, env, workDir)\n\n\tgoOut, goErr = applyNormalizers(goOut, goErr, tc.Normalize)\n\trefOut, refErr = applyNormalizers(refOut, refErr, tc.Normalize)\n\n\treportDivergence(t, tc, refOut, goOut, refErr, goErr, refExit, goExit)\n}\n\n// execBinary runs a single binary and returns its stdout, stderr, and exit code.\n// R2.2: capture stdout, stderr, and exit code independently.\n// R2.3: timeout enforcement via context.\nfunc execBinary(t *testing.T, bin string, tc DiffTest, env []string, workDir string) ([]byte, []byte, int) {\n\tt.Helper()\n\tctx, cancel := context.WithTimeout(context.Background(), defaultTimeout)\n\tdefer cancel()\n\n\tcmd := exec.CommandContext(ctx, bin, tc.Args...)\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\tcmd.Env = env\n\tcmd.Dir = workDir\n\tif tc.Stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n\t}\n\n\terr := cmd.Run()\n\tif err != nil {\n\t\treturn stdout.Bytes(), stderr.Bytes(), extractExitCode(t, err, ctx)\n\t}\n\treturn stdout.Bytes(), stderr.Bytes(), 0\n}\n\n// extractExitCode returns the process exit code from an exec error.\n// D2: extract exit code from exec.ExitError.ExitCode().\nfunc extractExitCode(t *testing.T, err error, ctx context.Context) int {\n\tt.Helper()\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatalf(\"binary exceeded timeout of %v\", defaultTimeout)\n\t}\n\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\treturn exitErr.ExitCode()\n\t}\n\tt.Fatalf(\"unexpected exec error: %v\", err)\n\treturn -1 // unreachable\n}\n\n// buildEnv constructs the process environment for binary execution.\n// R2.6: LC_ALL=C is set unless the test explicitly overrides it.\nfunc buildEnv(testEnv []string) []string {\n\tenv := os.Environ()\n\tenv = setEnvDefault(env, \"LC_ALL\", \"C\")\n\tfor _, kv := range testEnv {\n\t\tenv = setEnvOverride(env, kv)\n\t}\n\treturn env\n}\n\n// setEnvDefault adds key=value only if key is not already present.\nfunc setEnvDefault(env []string, key, value string) []string {\n\tprefix := key + \"=\"\n\tfor _, e := range env {\n\t\tif strings.HasPrefix(e, prefix) {\n\t\t\treturn env\n\t\t}\n\t}\n\treturn append(env, prefix+value)\n}\n\n// setEnvOverride replaces an existing KEY=VALUE pair or appends it.\nfunc setEnvOverride(env []string, kv string) []string {\n\tkey, _, _ := strings.Cut(kv, \"=\")\n\tprefix := key + \"=\"\n\tfor i, e := range env {\n\t\tif strings.HasPrefix(e, prefix) {\n\t\t\tenv[i] = kv\n\t\t\treturn env\n\t\t}\n\t}\n\treturn append(env, kv)\n}\n\n// applyNormalizers applies normalize functions to stdout and stderr in order.\n// R4.1, R4.3: per-test normalization before comparison.\nfunc applyNormalizers(stdout, stderr []byte, fns []NormalizeFunc) ([]byte, []byte) {\n\tfor _, fn := range fns {\n\t\tstdout = fn(stdout)\n\t\tstderr = fn(stderr)\n\t}\n\treturn stdout, stderr\n}\n\n// reportDivergence compares outputs and reports any differences via t.Errorf.\n// D3: use t.Errorf so all tests in the slice run even when some fail.\n// R3.5: report args, stdin, stdout, stderr, and exit codes.\nfunc reportDivergence(t *testing.T, tc DiffTest, refOut, goOut, refErr, goErr []byte, refExit, goExit int) {\n\tt.Helper()\n\tif bytes.Equal(refOut, goOut) && bytes.Equal(refErr, goErr) && refExit == goExit {\n\t\treturn\n\t}\n\tt.Errorf(\"divergence detected\\nargs: %v\\nstdin: %s\\n\"+\n\t\t\"ref stdout: %q\\n go stdout: %q\\n\"+\n\t\t\"ref stderr: %q\\n go stderr: %q\\n\"+\n\t\t\"ref exit: %d\\n go exit: %d\",\n\t\ttc.Args, formatStdin(tc.Stdin), refOut, goOut, refErr, goErr, refExit, goExit)\n}\n\n// formatStdin formats stdin content for display in error messages.\n// R3.5: truncate to 256 bytes.\nfunc formatStdin(stdin []byte) string {\n\tif stdin == nil {\n\t\treturn \"<nil>\"\n\t}\n\tif len(stdin) <= maxStdinDisplay {\n\t\treturn fmt.Sprintf(\"%q\", stdin)\n\t}\n\treturn fmt.Sprintf(\"%q...(truncated)\", stdin[:maxStdinDisplay])\n}\n\n// ComposeNormalizers returns a single NormalizeFunc that applies fns in order.\n//\n// R4.4: normalizer composition convenience.\nfunc ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n\tpanic(\"not implemented\")\n}\n\n// TimestampNormalizer replaces common strftime timestamp patterns with a fixed\n// placeholder string. Used by cmd/ts tests.\n//\n// R4.2: built-in timestamp normalization.\nvar TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n\tpanic(\"not implemented\")\n}\n\n// BuildBinary compiles the Go package at the given directory path and returns\n// the path to the resulting binary. The binary is placed in a test-managed\n// temporary directory and cleaned up when the test completes.\nfunc BuildBinary(t *testing.T, dir string) string {\n\tpanic(\"not implemented\")\n}\n"}}
