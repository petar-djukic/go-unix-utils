{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018VuCMbj3ufggkWPiBHDLeq","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage sys\n5\t\n6\timport (\n7\t\t\"golang.org/x/sys/unix\"\n8\t)\n9\t\n10\t// stdoutFD is the file descriptor for stdout, used by TerminalWidth.\n11\tconst stdoutFD = 1\n12\t\n13\t// TerminalWidth returns the width of the terminal in columns by querying\n14\t// stdout via the TIOCGWINSZ ioctl. Returns an error if stdout is not a\n15\t// terminal or the ioctl fails.\n16\t//\n17\t// R1.1: terminal width query via TIOCGWINSZ ioctl.\n18\t// D1: uses unix.IoctlGetWinsize on fd 1.\n19\t// D2: no fallback width; returns 0 and the error on failure.\n20\tfunc TerminalWidth() (int, error) {\n21\t\tws, err := unix.IoctlGetWinsize(stdoutFD, unix.TIOCGWINSZ)\n22\t\tif err != nil {\n23\t\t\treturn 0, err\n24\t\t}\n25\t\treturn int(ws.Col), nil\n26\t}\n27\t\n28\t// IsTerminal reports whether fd refers to a terminal device.\n29\t//\n30\t// R1.3: terminal detection via IoctlGetWinsize.\n31\tfunc IsTerminal(fd uintptr) bool {\n32\t\t_, err := unix.IoctlGetWinsize(int(fd), unix.TIOCGWINSZ)\n33\t\treturn err == nil\n34\t}\n35\t\n36\t// OnTerminalResize registers a callback invoked when the terminal is resized\n37\t// (SIGWINCH). The callback receives the new terminal width.\n38\t//\n39\t// R3.1: SIGWINCH-based resize notification.\n40\tfunc OnTerminalResize(callback func(width int)) {\n41\t}\n42\t"}]},"parent_tool_use_id":null,"session_id":"5ed0f51a-51be-49ea-a57b-d29c31e18a63","uuid":"2bf3c1de-1403-4997-acd3-1e8d2aa8ec62","timestamp":"2026-04-19T17:00:30.546Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5010/pkg/sys/terminal.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage sys\n\nimport (\n\t\"golang.org/x/sys/unix\"\n)\n\n// stdoutFD is the file descriptor for stdout, used by TerminalWidth.\nconst stdoutFD = 1\n\n// TerminalWidth returns the width of the terminal in columns by querying\n// stdout via the TIOCGWINSZ ioctl. Returns an error if stdout is not a\n// terminal or the ioctl fails.\n//\n// R1.1: terminal width query via TIOCGWINSZ ioctl.\n// D1: uses unix.IoctlGetWinsize on fd 1.\n// D2: no fallback width; returns 0 and the error on failure.\nfunc TerminalWidth() (int, error) {\n\tws, err := unix.IoctlGetWinsize(stdoutFD, unix.TIOCGWINSZ)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn int(ws.Col), nil\n}\n\n// IsTerminal reports whether fd refers to a terminal device.\n//\n// R1.3: terminal detection via IoctlGetWinsize.\nfunc IsTerminal(fd uintptr) bool {\n\t_, err := unix.IoctlGetWinsize(int(fd), unix.TIOCGWINSZ)\n\treturn err == nil\n}\n\n// OnTerminalResize registers a callback invoked when the terminal is resized\n// (SIGWINCH). The callback receives the new terminal width.\n//\n// R3.1: SIGWINCH-based resize notification.\nfunc OnTerminalResize(callback func(width int)) {\n}\n","numLines":42,"startLine":1,"totalLines":42}}}
