e from both binaries.\n\tExitCode int\n\n\t// Normalize is a slice of functions applied in order to stdout and stderr\n\t// of both binaries before comparison. nil or empty means no normalization\n\t// (R4.1, R4.3).\n\tNormalize []NormalizeFunc\n\n\t// ExpectedFiles maps relative file paths to expected byte content after\n\t// execution, for utilities whose primary output is a file (R5.1).\n\tExpectedFiles map[string][]byte\n}\n\n// RunDiffTests runs each DiffTest as a named subtest, executing goBinary and\n// refBinary with identical inputs and comparing their outputs.\n//\n// R2.1-R2.6, R3.1-R3.6: binary execution and comparison.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tpanic(\"not implemented\")\n}\n\n// ComposeNormalizers returns a single NormalizeFunc that applies fns in order.\n//\n// R4.4: normalizer composition convenience.\nfunc ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n\tpanic(\"not implemented\")\n}\n\n// TimestampNormalizer replaces common strftime timestamp patterns with a fixed\n// placeholder string. Used by cmd/ts tests.\n//\n// R4.2: built-in timestamp normalization.\nvar TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n\tpanic(\"not implemented\")\n}\n\n// BuildBinary compiles the Go package at the given directory path and returns\n// the path to the resulting binary. The binary is placed in a test-managed\n// temporary directory and cleaned up when the test completes.\nfunc BuildBinary(t *testing.T, dir string) string {\n\tpanic(\"not implemented\")\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":143,"cache_read_input_tokens":68170,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":143},"output_tokens":53,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"27cb1b87-3737-4ae9-82c