{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PkvGYSZPypWZCHhYesfhof","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd113-pee R1.1, R1.2, R1.3, R2.1, R2.2.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"os/exec\"\n13\t\t\"sync\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tfunc main() {\n19\t\tsys.InstallSIGPIPEHandler()\n20\t\tos.Exit(run(os.Args[1:]))\n21\t}\n22\t\n23\tfunc run(args []string) int {\n24\t\tif len(args) == 0 {\n25\t\t\treturn 0\n26\t\t}\n27\t\n28\t\tinput, err := io.ReadAll(os.Stdin)\n29\t\tif err != nil {\n30\t\t\tfmt.Fprintf(os.Stderr, \"pee: %v\\n\", err)\n31\t\t\treturn 1\n32\t\t}\n33\t\n34\t\tcmds, pipes := startCommands(args)\n35\t\tfanOut(pipes, input)\n36\t\treturn waitAll(cmds)\n37\t}\n38\t\n39\tfunc startCommands(args []string) ([]*exec.Cmd, []io.WriteCloser) {\n40\t\tcmds := make([]*exec.Cmd, 0, len(args))\n41\t\tpipes := make([]io.WriteCloser, 0, len(args))\n42\t\n43\t\tfor _, arg := range args {\n44\t\t\tcmd := exec.Command(\"sh\", \"-c\", arg)\n45\t\t\tcmd.Stdout = os.Stdout\n46\t\t\tcmd.Stderr = os.Stderr\n47\t\n48\t\t\tw, err := cmd.StdinPipe()\n49\t\t\tif err != nil {\n50\t\t\t\tfmt.Fprintf(os.Stderr, \"pee: %v\\n\", err)\n51\t\t\t\tcontinue\n52\t\t\t}\n53\t\n54\t\t\tif err := cmd.Start(); err != nil {\n55\t\t\t\tw.Close()\n56\t\t\t\tfmt.Fprintf(os.Stderr, \"pee: %v\\n\", err)\n57\t\t\t\tcontinue\n58\t\t\t}\n59\t\n60\t\t\tcmds = append(cmds, cmd)\n61\t\t\tpipes = append(pipes, w)\n62\t\t}\n63\t\n64\t\treturn cmds, pipes\n65\t}\n66\t\n67\tfunc fanOut(pipes []io.WriteCloser, input []byte) {\n68\t\tvar wg sync.WaitGroup\n69\t\twg.Add(len(pipes))\n70\t\tfor _, w := range pipes {\n71\t\t\tgo func(w io.WriteCloser) {\n72\t\t\t\tdefer wg.Done()\n73\t\t\t\tw.Write(input)\n74\t\t\t\tw.Close()\n75\t\t\t}(w)\n76\t\t}\n77\t\twg.Wait()\n78\t}\n79\t\n80\tfunc waitAll(cmds []*exec.Cmd) int {\n81\t\texitCode := 0\n82\t\tfor _, cmd := range cmds {\n83\t\t\tif err := cmd.Wait(); err != nil {\n84\t\t\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n85\t\t\t\t\tif exitErr.ExitCode() != 0 {\n86\t\t\t\t\t\texitCode = 1\n87\t\t\t\t\t}\n88\t\t\t\t} else {\n89\t\t\t\t\texitCode = 1\n90\t\t\t\t}\n91\t\t\t}\n92\t\t}\n93\t\treturn exitCode\n94\t}\n95\t"}]},"parent_tool_use_id":null,"session_id":"47959a2e-5314-4fa9-bbd8-52024579fa0b","uuid":"3ea34044-4ac4-48dc-a4a6-0f23073cab34","timestamp":"2026-05-28T17:20:55.794Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5636/cmd/pee/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd113-pee R1.1, R1.2, R1.3, R2.1, R2.2.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"sync\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run(os.Args[1:]))\n}\n\nfunc run(args []string) int {\n\tif len(args) == 0 {\n\t\treturn 0\n\t}\n\n\tinput, err := io.ReadAll(os.Stdin)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"pee: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\tcmds, pipes := startCommands(args)\n\tfanOut(pipes, input)\n\treturn waitAll(cmds)\n}\n\nfunc startCommands(args []string) ([]*exec.Cmd, []io.WriteCloser) {\n\tcmds := make([]*exec.Cmd, 0, len(args))\n\tpipes := make([]io.WriteCloser, 0, len(args))\n\n\tfor _, arg := range args {\n\t\tcmd := exec.Command(\"sh\", \"-c\", arg)\n\t\tcmd.Stdout = os.Stdout\n\t\tcmd.Stderr = os.Stderr\n\n\t\tw, err := cmd.StdinPipe()\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"pee: %v\\n\", err)\n\t\t\tcontinue\n\t\t}\n\n\t\tif err := cmd.Start(); err != nil {\n\t\t\tw.Close()\n\t\t\tfmt.Fprintf(os.Stderr, \"pee: %v\\n\", err)\n\t\t\tcontinue\n\t\t}\n\n\t\tcmds = append(cmds, cmd)\n\t\tpipes = append(pipes, w)\n\t}\n\n\treturn cmds, pipes\n}\n\nfunc fanOut(pipes []io.WriteCloser, input []byte) {\n\tvar wg sync.WaitGroup\n\twg.Add(len(pipes))\n\tfor _, w := range pipes {\n\t\tgo func(w io.WriteCloser) {\n\t\t\tdefer wg.Done()\n\t\t\tw.Write(input)\n\t\t\tw.Close()\n\t\t}(w)\n\t}\n\twg.Wait()\n}\n\nfunc waitAll(cmds []*exec.Cmd) int {\n\texitCode := 0\n\tfor _, cmd := range cmds {\n\t\tif err := cmd.Wait(); err != nil {\n\t\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n\t\t\t\tif exitErr.ExitCode() != 0 {\n\t\t\t\t\texitCode = 1\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\texitCode = 1\n\t\t\t}\n\t\t}\n\t}\n\treturn exitCode\n}\n","numLines":95,"startLine":1,"totalLines":95}}}
