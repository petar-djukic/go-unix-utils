{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KhUSydFsfzFYgCJBQ9DYDW","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/cp implements srd056-cp: copy files and directories.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"path/filepath\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\ttype overwriteMode int\n20\t\n21\tconst (\n22\t\towDefault  overwriteMode = iota\n23\t\towAskUser                // -i\n24\t\towNoClobber              // -n\n25\t)\n26\t\n27\tvar (\n28\t\towMode      overwriteMode\n29\t\tunlinkDest  bool\n30\t\tstdinReader = bufio.NewReader(os.Stdin)\n31\t\terrDeclined = errors.New(\"declined\")\n32\t)\n33\t\n34\tfunc main() {\n35\t\tsys.InstallSIGPIPEHandler()\n36\t\targs := parseFlags(os.Args[1:])\n37\t\tif len(args) == 0 {\n38\t\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n39\t\t\tos.Exit(1)\n40\t\t}\n41\t\tif len(args) == 1 {\n42\t\t\tfmt.Fprintf(os.Stderr,\n43\t\t\t\t\"cp: missing destination file operand after '%s'\\n\", args[0])\n44\t\t\tos.Exit(1)\n45\t\t}\n46\t\tdest := args[len(args)-1]\n47\t\tsources := args[:len(args)-1]\n48\t\tcode := 0\n49\t\tif len(sources) > 1 {\n50\t\t\tcode = copyMultiple(sources, dest)\n51\t\t} else {\n52\t\t\tcode = copySingle(sources[0], dest)\n53\t\t}\n54\t\tif code != 0 {\n55\t\t\tos.Exit(code)\n56\t\t}\n57\t}\n58\t\n59\tfunc parseFlags(args []string) []string {\n60\t\tvar files []string\n61\t\tendOfFlags := false\n62\t\tfor _, arg := range args {\n63\t\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n64\t\t\t\tfiles = append(files, arg)\n65\t\t\t\tcontinue\n66\t\t\t}\n67\t\t\tif arg == \"--\" {\n68\t\t\t\tendOfFlags = true\n69\t\t\t\tcontinue\n70\t\t\t}\n71\t\t\tif strings.HasPrefix(arg, \"--\") {\n72\t\t\t\tapplyLongFlag(arg[2:])\n73\t\t\t\tcontinue\n74\t\t\t}\n75\t\t\tfor _, c := range arg[1:] {\n76\t\t\t\tapplyFlag(c)\n77\t\t\t}\n78\t\t}\n79\t\treturn files\n80\t}\n81\t\n82\tfunc applyFlag(c rune) {\n83\t\tswitch c {\n84\t\tcase 'f':\n85\t\t\towMode = owDefault\n86\t\t\tunlinkDest = true\n87\t\tcase 'i':\n88\t\t\towMode = owAskUser\n89\t\t\tunlinkDest = false\n90\t\tcase 'n':\n91\t\t\towMode = owNoClobber\n92\t\t}\n93\t}\n94\t\n95\tfunc applyLongFlag(name string) {\n96\t\tswitch name {\n97\t\tcase \"force\":\n98\t\t\towMode = owDefault\n99\t\t\tunlinkDest = true\n100\t\tcase \"interactive\":\n101\t\t\towMode = owAskUser\n102\t\t\tunlinkDest = false\n103\t\tcase \"no-clobber\":\n104\t\t\towMode = owNoClobber\n105\t\t}\n106\t}\n107\t\n108\tfunc copySingle(src, dest string) int {\n109\t\tinfo, err := os.Stat(dest)\n110\t\tif err == nil && info.IsDir() {\n111\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n112\t\t}\n113\t\tif err := copyFile(src, dest); err != nil {\n114\t\t\tif err != errDeclined {\n115\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n116\t\t\t}\n117\t\t\treturn 1\n118\t\t}\n119\t\treturn 0\n120\t}\n121\t\n122\tfunc copyMultiple(sources []string, dest string) int {\n123\t\tinfo, err := os.Stat(dest)\n124\t\tif err != nil || !info.IsDir() {\n125\t\t\tfmt.Fprintf(os.Stderr, \"cp: target '%s': not a directory\\n\", dest)\n126\t\t\treturn 1\n127\t\t}\n128\t\tcode := 0\n129\t\tfor _, src := range sources {\n130\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n131\t\t\tif err := copyFile(src, target); err != nil {\n132\t\t\t\tif err != errDeclined {\n133\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n134\t\t\t\t}\n135\t\t\t\tcode = 1\n136\t\t\t}\n137\t\t}\n138\t\treturn code\n139\t}\n140\t\n141\tfunc copyFile(src, dest string) error {\n142\t\tsrcInfo, err := os.Stat(src)\n143\t\tif err != nil {\n144\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n145\t\t}\n146\t\tif srcInfo.IsDir() {\n147\t\t\treturn fmt.Errorf(\"-r not specified; omitting directory '%s'\", src)\n148\t\t}\n149\t\t