arseArgs(args []string) (options, []string, error) {\n78\t\topts := defaultOptions()\n79\t\tvar files []string\n80\t\ti := 0\n81\t\tfor i < len(args) {\n82\t\t\targ := args[i]\n83\t\t\tif arg == \"--\" {\n84\t\t\t\tfiles = append(files, args[i+1:]...)\n85\t\t\t\tbreak\n86\t\t\t}\n87\t\t\tif arg == \"-\" {\n88\t\t\t\tfiles = append(files, arg)\n89\t\t\t\ti++\n90\t\t\t\tcontinue\n91\t\t\t}\n92\t\t\tif len(arg) > 1 && arg[0] == '-' {\n93\t\t\t\tconsumed, err := parseFlag(arg, args[i+1:], &opts)\n94\t\t\t\tif err != nil {\n95\t\t\t\t\treturn opts, nil, err\n96\t\t\t\t}\n97\t\t\t\ti += 1 + consumed\n98\t\t\t\tcontinue\n99\t\t\t}\n100\t\t\tfiles = append(files, arg)\n101\t\t\ti++\n102\t\t}\n103\t\treturn opts, files, nil\n104\t}\n105\t\n106\tfunc parseFlag(arg string, remaining []string, opts *options) (int, error) {\n107\t\tflag := arg[1:]\n108\t\tswitch {\n109\t\tcase flag == \"p\":\n110\t\t\topts.noReset = true\n111\t\t\treturn 0, nil\n112\t\tcase strings.HasPrefix(flag, \"b\"):\n113\t\t\treturn setStyle(flag[1:], remaining, &opts.bodyStyle, 'b')\n114\t\tcase strings.HasPrefix(flag, \"h\"):\n115\t\t\treturn setStyle(flag[1:], remaining, &opts.headerStyle, 'h')\n116\t\tcase strings.HasPrefix(flag, \"f\"):\n117\t\t\treturn setStyle(flag[1:], remaining, &opts.footerStyle, 'f')\n118\t\tcase strings.HasPrefix(flag, \"n\"):\n119\t\t\treturn setStringOpt(flag[1:], remaining, &opts.numberFormat, 'n')\n120\t\tcase strings.HasPrefix(flag, \"s\"):\n121\t\t\treturn setStringOpt(flag[1:], remaining, &opts.separator, 's')\n122\t\tcase strings.HasPrefix(flag, \"d\"):\n123\t\t\treturn setStringOpt(flag[1:], remaining, &opts.delimiter, 'd')\n124\t\tcase strings.HasPrefix(flag, \"w\"):\n125\t\t\treturn setIntOpt(flag[1:], remaining, &opts.width, 'w')\n126\t\tcase strings.HasPrefix(flag, \"v\"):\n127\t\t\treturn setIntOpt(flag[1:], remaining, &opts.startNum, 'v')\n128\t\tcase strings.HasPrefix(flag, \"i\"):\n129\t\t\treturn setIntOpt(flag[1:], remaining, &opts.increment, 'i')\n130\t\tcas