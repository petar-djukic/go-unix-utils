lim\n\t}\n\tbr := bufio.NewReader(r)\n\tfor {\n\t\tline, readErr := br.ReadString('\\n')\n\t\thasNewline := len(line) > 0 && line[len(line)-1] == '\\n'\n\t\tif hasNewline {\n\t\t\tline = line[:len(line)-1]\n\t\t}\n\t\thasDelim := containsByte(line, opts.delimiter)\n\t\tif !hasDelim && opts.onlyDelimited {\n\t\t\tif readErr != nil {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif hasDelim {\n\t\t\twriteSelectedFields(w, line, opts.delimiter, ranges, outDelim)\n\t\t} else if len(line) > 0 {\n\t\t\tw.WriteString(line)\n\t\t}\n\t\tif readErr == nil || len(line) > 0 {\n\t\t\tw.WriteByte('\\n')\n\t\t}\n\t\tif readErr != nil {\n\t\t\tbreak\n\t\t}\n\t}\n}\n\nfunc writeSelectedFields(w *bufio.Writer, line string, delim byte, ranges [][2]int, outDelim string) {\n\tfields := splitFields(line, delim)\n\tselected := selectFields(fields, ranges)\n\tw.WriteString(strings.Join(selected, outDelim))\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1096,"cache_read_input_tokens":33804,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1096},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"36cddd2e-27ae-48e0-94da-16eb2cbdfdbb","uuid":"417f6331-d144-407b-ac14-9bb4f7a642e1"}
