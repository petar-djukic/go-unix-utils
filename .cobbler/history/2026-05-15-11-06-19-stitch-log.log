c cutChars(r io.Reader, w *bufio.Writer, opts options) {\n206\t\tranges, err := parseRangeList(opts.charList)\n207\t\tif err != nil {\n208\t\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n209\t\t\treturn\n210\t\t}\n211\t\tif opts.complement {\n212\t\t\tranges = complementRanges(ranges)\n213\t\t}\n214\t\tprocessLines(r, w, ranges)\n215\t}\n216\t\n217\tfunc processLines(r io.Reader, w *bufio.Writer, ranges [][2]int) {\n218\t\tbr := bufio.NewReader(r)\n219\t\tfor {\n220\t\t\tline, err := br.ReadBytes('\\n')\n221\t\t\tif len(line) > 0 && line[len(line)-1] == '\\n' {\n222\t\t\t\tline = line[:len(line)-1]\n223\t\t\t}\n224\t\t\tif len(line) > 0 {\n225\t\t\t\twriteSelectedBytes(w, line, ranges)\n226\t\t\t}\n227\t\t\tif err == nil || len(line) > 0 {\n228\t\t\t\tw.WriteByte('\\n')\n229\t\t\t}\n230\t\t\tif err != nil {\n231\t\t\t\tbreak\n232\t\t\t}\n233\t\t}\n234\t}\n235\t\n236\tfunc writeSelectedBytes(w *bufio.Writer, line []byte, ranges [][2]int) {\n237\t\tlineLen := len(line)\n238\t\tfor _, rng := range ranges {\n239\t\t\tlo := rng[0] - 1\n240\t\t\thi := rng[1]\n241\t\t\tif lo >= lineLen {\n242\t\t\t\tcontinue\n243\t\t\t}\n244\t\t\tif hi > lineLen {\n245\t\t\t\thi = lineLen\n246\t\t\t}\n247\t\t\tw.Write(line[lo:hi])\n248\t\t}\n249\t}\n250\t\n251\tfunc parseRangeList(list string) ([][2]int, error) {\n252\t\tparts := strings.Split(list, \",\")\n253\t\tvar ranges [][2]int\n254\t\tfor _, p := range parts {\n255\t\t\tr, err := parseRange(p)\n256\t\t\tif err != nil {\n257\t\t\t\treturn nil, err\n258\t\t\t}\n259\t\t\tranges = append(ranges, r)\n260\t\t}\n261\t\treturn mergeRanges(ranges), nil\n262\t}\n263\t\n264\tfunc parseRange(s string) ([2]int, error) {\n265\t\tif s == \"\" {\n266\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range\")\n267\t\t}\n268\t\tidx := strings.Index(s, \"-\")\n269\t\tif idx < 0 {\n270\t\t\tn, err := strconv.Atoi(s)\n271\t\t\tif err != nil || n <= 0 {\n272\t\t\t\treturn [2]int{}, fmt.Errorf(\"invalid byte/character position '%s'\", s)\n273\t\t\t}\n274\t\t\treturn [2]int{n, n}, nil\n275\t\t}\n276\t\treturn parseHyphenRange(s, idx)\n277\t}\n278\t\n279\tfunc parseHyphenRange(s string, idx int) ([2]int, error) {\n280\t\tif idx == 0 {\n281\t\t\thi, err := strconv.Atoi(s[1:])\n282\t\t\tif err != nil || hi <= 0 {\n283\t\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n284\t\t\t}\n285\t\t\treturn [2]int{1, hi}, nil\n286\t\t}\n287\t\tlo, err := strconv.Atoi(s[:idx])\n288\t\tif err != nil || lo <= 0 {\n289\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n290\t\t}\n291\t\tif idx == len(s)-1 {\n292\t\t\treturn [2]int{lo, math.MaxInt}, nil\n293\t\t}\n294\t\thi, err := strconv.Atoi(s[idx+1:])\n295\t\tif err != nil || hi <= 0 {\n296\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n297\t\t}\n298\t\tif lo > hi {\n299\t\t\treturn [2]int{}, fmt.Errorf(\"invalid decreasing range\")\n300\t\t}\n301\t\treturn [2]int{lo, hi}, nil\n302\t}\n303\t\n304\tfunc mergeRanges(ranges [][2]int) [][2]int {\n305\t\tif len(ranges) == 0 {\n306\t\t\treturn ranges\n307\t\t}\n308\t\tsort.Slice(ranges, func(i, j int) bool {\n309\t\t\treturn ranges[i][0] < ranges[j][0]\n310\t\t})\n311\t\tmerged := [][2]int{ranges[0]}\n312\t\tfor _, r := range ranges[1:] {\n313\t\t\tlast := &merged[len(merged)-1]\n314\t\t\tif r[0] <= last[1]+1 {\n315\t\t\t\tif r[1] > last[1] {\n316\t\t\t\t\tlast[1] = r[1]\n317\t\t\t\t}\n318\t\t\t} else {\n319\t\t\t\tmerged = append(merged, r)\n320\t\t\t}\n321\t\t}\n322\t\treturn merged\n323\t}\n324\t\n325\tfunc complementRanges(ranges [][2]int) [][2]int {\n326\t\tvar result [][2]int\n327\t\tprev := 1\n328\t\tfor _, r := range ranges {\n329\t\t\tif r[0] > prev {\n330\t\t\t\tresult = append(result, [2]int{prev, r[0] - 1})\n331\t\t\t}\n332\t\t\tprev = r[1] + 1\n333\t\t}\n334\t\tif prev > 0 && prev < math.MaxInt {\n335\t\t\tresult = append(result, [2]int{prev, math.MaxInt})\n336\t\t}\n337\t\treturn result\n338\t}\n339\t\n340\tfunc cutFields(_ io.Reader, _ *bufio.Writer, _ options) {\n341\t\tpanic(\"not implemented