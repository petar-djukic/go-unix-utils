e) for --color=never. For --color=auto, call pkg/sys.IsTerminal(os.Stdout.Fd()) and pass the result to pkg/format.SetColorEnabled. When color is disabled, pkg/format.FileTypeColor returns empty strings.\n\n**Line:** 137-141"}],"totalDurationMs":8514,"totalTokens":26441,"totalToolUseCount":1,"usage":{"input_tokens":5,"cache_creation_input_tokens":9824,"cache_read_input_tokens":16126,"output_tokens":486,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":9824},"inference_geo":"","iterations":[{"input_tokens":5,"output_tokens":486,"cache_read_input_tokens":16126,"cache_creation_input_tokens":9824,"cache_creation":{"ephemeral_5m_input_tokens":9824,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"toolStats":{"readCount":1,"searchCount":0,"bashCount":0,"editFileCount":0,"linesAdded":0,"linesRemoved":0,"otherToolCount":0}}}
