{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M5g2NdKTqpa3Bnav7xA5Qi","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd008-ls R1.1-R1.14, R2.1-R2.15.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\t\"unicode/utf8\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n21\t)\n22\t\n23\tconst helpText = `Usage: ls [OPTION]... [FILE]...\n24\tList information about the FILEs (the current directory by default).\n25\tSort entries alphabetically if no flags given.\n26\t\n27\t  -a             do not ignore entries starting with .\n28\t  -A             do not list implied . and ..\n29\t  -C             list entries by columns\n30\t  -d             list directories themselves, not their contents\n31\t  -i             print the index number of each file\n32\t  -l             use a long listing format\n33\t  -n             like -l, but list numeric user and group IDs\n34\t  -r             reverse order while sorting\n35\t  -s             print the allocated size of each file, in blocks\n36\t  -S             sort by file size, largest first\n37\t  -t             sort by modification time, newest first\n38\t  -U             do not sort; list entries in directory order\n39\t  -v             natural sort of (version) numbers within text\n40\t  -x             list entries by lines instead of by columns\n41\t  -1             list one file per line\n42\t      --help     display this help and exit\n43\t      --version  output version information and exit\n44\t`\n45\t\n46\tconst versionText = `ls (go-unix-utils) dev\n47\t`\n48\t\n49\ttype options struct {\n50\t\tsingleColumn   bool\n51\t\tlongFormat     bool\n52\t\tforceColumns   bool\n53\t\thorizontalSort bool\n54\t\tshowAll        bool\n55\t\tshowAlmostAll  bool\n56\t\tdirAsEntry     bool\n57\t\tsortByTime     bool\n58\t\tsortBySize     bool\n59\t\treverseSort    bool\n60\t\tunsorted       bool\n61\t\tversionSort    bool\n62\t\tshowInode      bool\n63\t\tshowBlocks     bool\n64\t\tnumericIds     bool\n65\t}\n66\t\n67\tfunc main() {\n68\t\tsys.InstallSIGPIPEHandler()\n69\t\topts, paths := parseArgs(os.Args[1:])\n70\t\tif len(paths) == 0 {\n71\t\t\tpaths = []string{\".\"}\n72\t\t}\n73\t\tos.Exit(run(paths, opts))\n74\t}\n75\t\n76\tfunc parseArgs(args []string) (options, []string) {\n77\t\tvar opts options\n78\t\tvar paths []string\n79\t\tfor len(args) > 0 {\n80\t\t\targ := args[0]\n81\t\t\targs = args[1:]\n82\t\t\tswitch {\n83\t\t\tcase arg == \"--help\":\n84\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n85\t\t\t\tos.Exit(0)\n86\t\t\tcase arg == \"--version\":\n87\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n88\t\t\t\tos.Exit(0)\n89\t\t\tcase arg == \"--\":\n90\t\t\t\treturn opts, append(paths, args...)\n91\t\t\tcase strings.HasPrefix(arg, \"--\"):\n92\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n93\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n94\t\t\t\tos.Exit(2)\n95\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n96\t\t\t\tparseShortFlags(arg[1:], &opts)\n97\t\t\tdefault:\n98\t\t\t\tpaths = append(paths, arg)\n99\t\t\t}\n100\t\t}\n101\t\treturn opts, paths\n102\t}\n103\t\n104\tfunc parseShortFlags(flags string, opts *options) {\n105\t\tfor _, ch := range flags {\n106\t\t\tswitch ch {\n107\t\t\tcase '1':\n108\t\t\t\topts.forceColumns = false\n109\t\t\t\topts.horizontalSort = false\n110\t\t\t\tif !opts.longFormat {\n111\t\t\t\t\topts.singleColumn = true\n112\t\t\t\t}\n113\t\t\tcase 'l':\n114\t\t\t\topts.longFormat = true\n115\t\t\t\topts.singleColumn = false\n116\t\t\t\topts.forceColumns = false\n117\t\t\t\topts.horizontalSort = false\n118\t\t\tcase 'C':\n119\t\t\t\topts.forceColumns = true\n120\t\t\t\topts.horizontalSort = false\n121\t\t\t\topts.longFormat = false\n122\t\t\t\topts.singleColumn = false\n123\t\t\tcase 'x':\n124\t\t\t\topts.forceColumns = true\n125\t\t\t\topts.horizontalSort = true\n126\t\t\t\topts.longFormat = false\n127\t\t\t\topts.singleColumn = false\n128\t\t\tcase 'a':\n129\t\t\t\topts.showAll = true\n130\t\t\t\topts.showAlmostAll = false\n131\t\t\tcase 'A':\n132\t\t\t\topts.showAlmostAll = true\n133\t\t\t\topts.showAll = false\n134\t\t\tcase 'd':\n135\t\t\t\topts.dirAsEntry = true\n136\t\t\tcase 'i':\n137\t\t\t\topts.showInode = true\n138\t\t\tcase 'n':\n139\t\t\t\topts.numericIds = true\n140\t\t\t\topts.longFormat = true\n141\t\t\t\topts.singleColumn = false\n142\t\t\t\topts.forceColumns = false\n143\t\t\t\topts.horizontalSort = false\n144\t\t\tcase 'r':\n145\t\t\t\topts.reverseSort = true\n146\t\t\tcase 's':\n147\t\t\t\topts.showBlocks = true\n148\t\t\tcase 't':\n149\t\t\t\topts.sortByTime = true\n150\t\t\t\topts.sortBySize = false\n151\t\t\t\topts.unsorted = false\n152\t\t\t\topts.versionSort = false\n153\t\t\tcase 'S':\n154\t\t\t\topts.sortBySize = true\n155\t\t\t\topts.sortByTime = false\n156\t\t\t\topts.unsorted = false\n157\t\t\t\topts.versionSort = false\n158\t\t\tcase 'U':\n159\t\t\t\topts.unsorted = true\n160\t\t\t\topts.sortByTime = false\n161\t\t\t\topts.sortBySize = false\n162\t\t\t\topts.versionSort = false\n163\t\t\tcase 'v':\n164\t\t\t\topts.versionSort = true\n165\t\t\t\topts.sortByTime = false\n166\t\t\t\topts.sortBySize = false\n167\t\t\t\topts.unsorted = false\n168\t\t\tdefault:\n169\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n170\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n171\t\t\t\tos.Exit(2)\n172\t\t\t}\n173\t\t}\n174\t}\n175\t\n176\tfunc run(paths []string, opts options) int {\n177\t\texitCode := 0\n178\t\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n179\t\tneedSep := false\n180\t\tif len(files) > 0 {\n181\t\t\tsortEntries(files, \"\", opts)\n182\t\t\tif opts.longFormat {\n183\t\t\t\texitCode = maxCode(exitCode, writeLongFiles(files, opts))\n184\t\t\t} else {\n185\t\t\t\tdisplay := prependPrefixes(files, \"\", opts)\n186\t\t\t\twriteEntries(display, opts)\n187\t\t\t}\n188\t\t\tneedSep = true\n189\t\t}\n190\t\tshowHeader := len(dirs) > 1 || len(files) > 0\n191\t\tsortEntries(dirs, \"\", opts)\n192\t\tfor _, dir := range dirs {\n193\t\t\tif needSep {\n194\t\t\t\tfmt.Fprintln(os.Stdout)\n195\t\t\t}\n196\t\t\tif showHeader {\n197\t\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n198\t\t\t}\n199\t\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n200\t\t\tneedSep = true\n201\t\t}\n202\t\treturn exitCode\n203\t}\n204\t\n205\tfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n206\t\tvar files, dirs []string\n207\t\tfor _, p := range paths {\n208\t\t\tinfo, err := os.Lstat(p)\n209\t\t\tif err != nil {\n210\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n211\t\t\t\t*exitCode = 2\n212\t\t\t\tcontinue\n213\t\t\t}\n214\t\t\tif info.IsDir() && !dirAsEntry {\n215\t\t\t\tdirs = append(dirs, p)\n216\t\t\t} else {\n217\t\t\t\tfiles = append(files, p)\n218\t\t\t}\n219\t\t}\n220\t\treturn files, dirs\n221\t}\n222\t\n223\tfunc maxCode(a, b int) int {\n224\t\tif a > b {\n225\t\t\treturn a\n226\t\t}\n227\t\treturn b\n228\t}\n229\t\n230\tfunc listDir(path string, opts options) int {\n231\t\tnames, err := readNames(path, opts)\n232\t\tif err != nil {\n233\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n234\t\t\t\tpath, sysError(err))\n235\t\t\treturn 2\n236\t\t}\n237\t\tif opts.longFormat {\n238\t\t\treturn writeLongDir(path, names, opts)\n239\t\t}\n240\t\tdisplay := prependPrefixes(names, path, opts)\n241\t\twriteEntries(display, opts)\n242\t\treturn 0\n243\t}\n244\t\n245\tfunc readNames(path string, opts options) ([]string, error) {\n246\t\tentries, err := os.ReadDir(path)\n247\t\tif err != nil {\n248\t\t\treturn nil, err\n249\t\t}\n250\t\tnames := make([]string, 0, len(entries))\n251\t\tif opts.showAll {\n252\t\t\tnames = append(names, \".\", \"..\")\n253\t\t}\n254\t\tfor _, e := range entries {\n255\t\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n256\t\t\t\tcontinue\n257\t\t\t}\n258\t\t\tnames = append(names, e.Name())\n259\t\t}\n260\t\tsortEntries(names, path, opts)\n261\t\treturn names, nil\n262\t}\n263\t\n264\tfunc sortEntries(names []string, basePath string, opts options) {\n265\t\tif opts.unsorted {\n266\t\t\treturn\n267\t\t}\n268\t\tif opts.versionSort {\n269\t\t\tsort.SliceStable(names, func(i, j int) bool {\n270\t\t\t\treturn strverscmp(names[i], names[j]) < 0\n271\t\t\t})\n272\t\t\tif opts.reverseSort {\n273\t\t\t\treverseSlice(names)\n274\t\t\t}\n275\t\t\treturn\n276\t\t}\n277\t\tif !opts.sortByTime && !opts.sortBySize {\n278\t\t\tsort.Strings(names)\n279\t\t\tif opts.reverseSort {\n280\t\t\t\treverseSlice(names)\n281\t\t\t}\n282\t\t\treturn\n283\t\t}\n284\t\ttype entry struct {\n285\t\t\tname    string\n286\t\t\tmodTime time.Time\n287\t\t\tsize    int64\n288\t\t}\n289\t\tentries := make([]entry, len(names))\n290\t\tfor i, name := range names {\n291\t\t\tentries[i].name = name\n292\t\t\tp := name\n293\t\t\tif basePath != \"\" {\n294\t\t\t\tp = filepath.Join(basePath, name)\n295\t\t\t}\n296\t\t\tif fi, err := sys.Lstat(p); err == nil {\n297\t\t\t\tentries[i].modTime = fi.ModTime\n298\t\t\t\tentries[i].size = fi.Size\n299\t\t\t}\n300\t\t}\n301\t\tsort.SliceStable(entries, func(i, j int) bool {\n302\t\t\tif opts.sortByTime {\n303\t\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n304\t\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n305\t\t\t\t}\n306\t\t\t\treturn entries[i].name < entries[j].name\n307\t\t\t}\n308\t\t\tif entries[i].size != entries[j].size {\n309\t\t\t\treturn entries[i].size > entries[j].size\n310\t\t\t}\n311\t\t\treturn entries[i].name < entries[j].name\n312\t\t})\n313\t\tfor i, e := range entries {\n314\t\t\tnames[i] = e.name\n315\t\t}\n316\t\tif opts.reverseSort {\n317\t\t\treverseSlice(names)\n318\t\t}\n319\t}\n320\t\n321\ttype prefixInfo struct {\n322\t\tinode  uint64\n323\t\tblocks int64\n324\t}\n325\t\n326\tfunc prependPrefixes(names []string, basePath string, opts options) []string {\n327\t\tif !opts.showInode && !opts.showBlocks {\n328\t\t\treturn names\n329\t\t}\n330\t\tinfos := make([]prefixInfo, len(names))\n331\t\tvar inodeW, blocksW int\n332\t\tfor i, name := range names {\n333\t\t\tp := name\n334\t\t\tif basePath != \"\" {\n335\t\t\t\tp = filepath.Join(basePath, name)\n336\t\t\t}\n337\t\t\tfi, err := sys.Lstat(p)\n338\t\t\tif err != nil {\n339\t\t\t\tcontinue\n340\t\t\t}\n341\t\t\tinfos[i] = prefixInfo{fi.Ino, fi.Blocks / 2}\n342\t\t\tif n := len(strconv.FormatUint(fi.Ino, 10)); n > inodeW {\n343\t\t\t\tinodeW = n\n344\t\t\t}\n345\t\t\tif n := len(strconv.FormatInt(fi.Blocks/2, 10)); n > blocksW {\n346\t\t\t\tblocksW = n\n347\t\t\t}\n348\t\t}\n349\t\tresult := make([]string, len(names))\n350\t\tfor i, name := range names {\n351\t\t\tvar b strings.Builder\n352\t\t\tif opts.showInode {\n353\t\t\t\tb.WriteString(format.PadLeft(strconv.FormatUint(infos[i].inode, 10), inodeW))\n354\t\t\t\tb.WriteByte(' ')\n355\t\t\t}\n356\t\t\tif opts.showBlocks {\n357\t\t\t\tb.WriteString(format.PadLeft(strconv.FormatInt(infos[i].blocks, 10), blocksW))\n358\t\t\t\tb.WriteByte(' ')\n359\t\t\t}\n360\t\t\tb.WriteString(name)\n361\t\t\tresult[i] = b.String()\n362\t\t}\n363\t\treturn result\n364\t}\n365\t\n366\tfunc writeEntries(names []string, opts options) {\n367\t\tif len(names) == 0 {\n368\t\t\treturn\n369\t\t}\n370\t\tif opts.forceColumns {\n371\t\t\tif opts.horizontalSort {\n372\t\t\t\twriteHorizontalColumns(names, 0)\n373\t\t\t} else {\n374\t\t\t\twriteColumnsWidth(names, 0)\n375\t\t\t}\n376\t\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n377\t\t\twriteLines(names)\n378\t\t} else {\n379\t\t\twriteColumnsWidth(names, 0)\n380\t\t}\n381\t}\n382\t\n383\tfunc writeColumnsWidth(names []string, width int) {\n384\t\tif width <= 0 {\n385\t\t\tw, err := sys.TerminalWidth()\n386\t\t\tif err != nil {\n387\t\t\t\tw = 80\n388\t\t\t}\n389\t\t\twidth = w\n390\t\t}\n391\t\tgrid := format.Columns(names, width)\n392\t\twidths := gridColumnWidths(grid)\n393\t\tfor _, row := range grid {\n394\t\t\twriteGridRow(row, widths)\n395\t\t}\n396\t}\n397\t\n398\tfunc writeHorizontalColumns(names []string, width int) {\n399\t\tif width <= 0 {\n400\t\t\tw, err := sys.TerminalWidth()\n401\t\t\tif err != nil {\n402\t\t\t\tw = 80\n403\t\t\t}\n404\t\t\twidth = w\n405\t\t}\n406\t\tnumCols := findHorizontalMaxCols(names, width)\n407\t\trows := (len(names) + numCols - 1) / numCols\n408\t\tcolWidths := make([]int, numCols)\n409\t\tfor c := 0; c < numCols; c++ {\n410\t\t\tfor r := 0; r < rows; r++ {\n411\t\t\t\tidx := r*numCols + c\n412\t\t\t\tif idx >= len(names) {\n413\t\t\t\t\tbreak\n414\t\t\t\t}\n415\t\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n416\t\t\t\t\tcolWidths[c] = w\n417\t\t\t\t}\n418\t\t\t}\n419\t\t}\n420\t\tfor r := 0; r < rows; r++ {\n421\t\t\tvar row []string\n422\t\t\tfor c := 0; c < numCols; c++ {\n423\t\t\t\tidx := r*numCols + c\n424\t\t\t\tif idx >= len(names) {\n425\t\t\t\t\tbreak\n426\t\t\t\t}\n427\t\t\t\trow = append(row, names[idx])\n428\t\t\t}\n429\t\t\twriteGridRow(row, colWidths)\n430\t\t}\n431\t}\n432\t\n433\tfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n434\t\tn := len(entries)\n435\t\tfor cols := n; cols > 1; cols-- {\n436\t\t\tif horizontalGridFits(entries, cols, termWidth) {\n437\t\t\t\treturn cols\n438\t\t\t}\n439\t\t}\n440\t\treturn 1\n441\t}\n442\t\n443\tfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n444\t\trows := (len(entries) + cols - 1) / cols\n445\t\tcolWidths := make([]int, cols)\n446\t\tfor c := 0; c < cols; c++ {\n447\t\t\tfor r := 0; r < rows; r++ {\n448\t\t\t\tidx := r*cols + c\n449\t\t\t\tif idx >= len(entries) {\n450\t\t\t\t\tbreak\n451\t\t\t\t}\n452\t\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n453\t\t\t\t\tcolWidths[c] = w\n454\t\t\t\t}\n455\t\t\t}\n456\t\t}\n457\t\ttotal := 0\n458\t\tfor c := 0; c < cols; c++ {\n459\t\t\tif c < cols-1 {\n460\t\t\t\ttotal += colWidths[c] + 2\n461\t\t\t} else {\n462\t\t\t\ttotal += colWidths[c]\n463\t\t\t}\n464\t\t\tif total > termWidth {\n465\t\t\t\treturn false\n466\t\t\t}\n467\t\t}\n468\t\treturn true\n469\t}\n470\t\n471\tfunc writeLines(names []string) {\n472\t\tfor _, name := range names {\n473\t\t\twriteLine(name)\n474\t\t}\n475\t}\n476\t\n477\tfunc gridColumnWidths(grid [][]string) []int {\n478\t\tif len(grid) == 0 {\n479\t\t\treturn nil\n480\t\t}\n481\t\twidths := make([]int, len(grid[0]))\n482\t\tfor _, row := range grid {\n483\t\t\tfor c, cell := range row {\n484\t\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n485\t\t\t\t\twidths[c] = w\n486\t\t\t\t}\n487\t\t\t}\n488\t\t}\n489\t\treturn widths\n490\t}\n491\t\n492\tfunc writeGridRow(row []string, widths []int) {\n493\t\tvar b strings.Builder\n494\t\tfor i, cell := range row {\n495\t\t\tif i < len(row)-1 {\n496\t\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n497\t\t\t\tb.WriteString(\"  \")\n498\t\t\t} else {\n499\t\t\t\tb.WriteString(cell)\n500\t\t\t}\n501\t\t}\n502\t\twriteLine(b.String())\n503\t}\n504\t\n505\ttype longEntry struct {\n506\t\tname  string\n507\t\tpath  string\n508\t\tinfo  *sys.FileInfo\n509\t\towner string\n510\t\tgroup string\n511\t}\n512\t\n513\ttype longWidths struct {\n514\t\tinode  int\n515\t\tblocks int\n516\t\tnlink  int\n517\t\towner  int\n518\t\tgroup  int\n519\t\tsize   int\n520\t}\n521\t\n522\tfunc writeLongFiles(paths []string, opts options) int {\n523\t\tentries := make([]longEntry, 0, len(paths))\n524\t\tcode := 0\n525\t\tfor _, p := range paths {\n526\t\t\tfi, err := sys.Lstat(p)\n527\t\t\tif err != nil {\n528\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n529\t\t\t\tcode = 2\n530\t\t\t\tcontinue\n531\t\t\t}\n532\t\t\tentries = append(entries, newLongEntry(p, p, fi, opts))\n533\t\t}\n534\t\twriteLongEntries(entries, opts)\n535\t\treturn code\n536\t}\n537\t\n538\tfunc writeLongDir(path string, names []string, opts options) int {\n539\t\tentries := make([]longEntry, 0, len(names))\n540\t\tcode := 0\n541\t\tfor _, name := range names {\n542\t\t\tfull := filepath.Join(path, name)\n543\t\t\tfi, err := sys.Lstat(full)\n544\t\t\tif err != nil {\n545\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n546\t\t\t\tcode = 2\n547\t\t\t\tcontinue\n548\t\t\t}\n549\t\t\tentries = append(entries, newLongEntry(name, full, fi, opts))\n550\t\t}\n551\t\ttotalBlocks := int64(0)\n552\t\tfor _, e := range entries {\n553\t\t\ttotalBlocks += e.info.Blocks\n554\t\t}\n555\t\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n556\t\twriteLongEntries(entries, opts)\n557\t\treturn code\n558\t}\n559\t\n560\tfunc newLongEntry(name, path string, fi *sys.FileInfo, opts options) longEntry {\n561\t\towner := resolveOwner(fi.Uid)\n562\t\tgroup := resolveGroup(fi.Gid)\n563\t\tif opts.numericIds {\n564\t\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n565\t\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n566\t\t}\n567\t\treturn longEntry{\n568\t\t\tname:  name,\n569\t\t\tpath:  path,\n570\t\t\tinfo:  fi,\n571\t\t\towner: owner,\n572\t\t\tgroup: group,\n573\t\t}\n574\t}\n575\t\n576\tfunc writeLongEntries(entries []longEntry, opts options) {\n577\t\tif len(entries) == 0 {\n578\t\t\treturn\n579\t\t}\n580\t\tw := computeLongWidths(entries, opts)\n581\t\tfor _, e := range entries {\n582\t\t\twriteLine(formatLongLine(e, w, opts))\n583\t\t}\n584\t}\n585\t\n586\tfunc computeLongWidths(entries []longEntry, opts options) longWidths {\n587\t\tvar w longWidths\n588\t\tfor _, e := range entries {\n589\t\t\tif opts.showInode {\n590\t\t\t\tif n := len(strconv.FormatUint(e.info.Ino, 10)); n > w.inode {\n591\t\t\t\t\tw.inode = n\n592\t\t\t\t}\n593\t\t\t}\n594\t\t\tif opts.showBlocks {\n595\t\t\t\tif n := len(strconv.FormatInt(e.info.Blocks/2, 10)); n > w.blocks {\n596\t\t\t\t\tw.blocks = n\n597\t\t\t\t}\n598\t\t\t}\n599\t\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n600\t\t\t\tw.nlink = n\n601\t\t\t}\n602\t\t\tif n := len(e.owner); n > w.owner {\n603\t\t\t\tw.owner = n\n604\t\t\t}\n605\t\t\tif n := len(e.group); n > w.group {\n606\t\t\t\tw.group = n\n607\t\t\t}\n608\t\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n609\t\t\t\tw.size = n\n610\t\t\t}\n611\t\t}\n612\t\treturn w\n613\t}\n614\t\n615\tfunc formatLongLine(e longEntry, w longWidths, opts options) string {\n616\t\tvar prefix string\n617\t\tif opts.showInode {\n618\t\t\tprefix += format.PadLeft(strconv.FormatUint(e.info.Ino, 10), w.inode) + \" \"\n619\t\t}\n620\t\tif opts.showBlocks {\n621\t\t\tprefix += format.PadLeft(strconv.FormatInt(e.info.Blocks/2, 10), w.blocks) + \" \"\n622\t\t}\n623\t\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n624\t\tsize := strconv.FormatInt(e.info.Size, 10)\n625\t\tname := e.name\n626\t\tif e.info.Mode&os.ModeSymlink != 0 {\n627\t\t\tif target, err := os.Readlink(e.path); err == nil {\n628\t\t\t\tname += \" -> \" + target\n629\t\t\t}\n630\t\t}\n631\t\treturn prefix +\n632\t\t\tpermString(e.info.Mode) + \" \" +\n633\t\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n634\t\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n635\t\t\tformat.PadRight(e.group, w.group) + \" \" +\n636\t\t\tformat.PadLeft(size, w.size) + \" \" +\n637\t\t\tformatMtime(e.info.ModTime) + \" \" +\n638\t\t\tname\n639\t}\n640\t\n641\tfunc permString(mode os.FileMode) string {\n642\t\tvar b [10]byte\n643\t\tb[0] = fileTypeChar(mode)\n644\t\tconst rwx = \"rwx\"\n645\t\tperm := mode.Perm()\n646\t\tfor i := 0; i < 9; i++ {\n647\t\t\tif perm&(1<<uint(8-i)) != 0 {\n648\t\t\t\tb[1+i] = rwx[i%3]\n649\t\t\t} else {\n650\t\t\t\tb[1+i] = '-'\n651\t\t\t}\n652\t\t}\n653\t\tapplySpecialBits(mode, &b)\n654\t\treturn string(b[:])\n655\t}\n656\t\n657\tfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n658\t\tif mode&os.ModeSetuid != 0 {\n659\t\t\tif b[3] == 'x' {\n660\t\t\t\tb[3] = 's'\n661\t\t\t} else {\n662\t\t\t\tb[3] = 'S'\n663\t\t\t}\n664\t\t}\n665\t\tif mode&os.ModeSetgid != 0 {\n666\t\t\tif b[6] == 'x' {\n667\t\t\t\tb[6] = 's'\n668\t\t\t} else {\n669\t\t\t\tb[6] = 'S'\n670\t\t\t}\n671\t\t}\n672\t\tif mode&os.ModeSticky != 0 {\n673\t\t\tif b[9] == 'x' {\n674\t\t\t\tb[9] = 't'\n675\t\t\t} else {\n676\t\t\t\tb[9] = 'T'\n677\t\t\t}\n678\t\t}\n679\t}\n680\t\n681\tfunc fileTypeChar(mode os.FileMode) byte {\n682\t\tswitch {\n683\t\tcase mode&os.ModeDir != 0:\n684\t\t\treturn 'd'\n685\t\tcase mode&os.ModeSymlink != 0:\n686\t\t\treturn 'l'\n687\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n688\t\t\treturn 'c'\n689\t\tcase mode&os.ModeDevice != 0:\n690\t\t\treturn 'b'\n691\t\tcase mode&os.ModeNamedPipe != 0:\n692\t\t\treturn 'p'\n693\t\tcase mode&os.ModeSocket != 0:\n694\t\t\treturn 's'\n695\t\tdefault:\n696\t\t\treturn '-'\n697\t\t}\n698\t}\n699\t\n700\tfunc resolveOwner(uid uint32) string {\n701\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n702\t\tif err != nil {\n703\t\t\treturn strconv.FormatUint(uint64(uid), 10)\n704\t\t}\n705\t\treturn u.Username\n706\t}\n707\t\n708\tfunc resolveGroup(gid uint32) string {\n709\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n710\t\tif err != nil {\n711\t\t\treturn strconv.FormatUint(uint64(gid), 10)\n712\t\t}\n713\t\treturn g.Name\n714\t}\n715\t\n716\tfunc formatMtime(t time.Time) string {\n717\t\tsixMonths := 6 * 30 * 24 * time.Hour\n718\t\tago := time.Since(t)\n719\t\tif ago >= 0 && ago < sixMonths {\n720\t\t\treturn t.Format(\"Jan _2 15:04\")\n721\t\t}\n722\t\treturn t.Format(\"Jan _2  2006\")\n723\t}\n724\t\n725\tfunc writeLine(s string) {\n726\t\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n727\t\t\tos.Exit(1)\n728\t\t}\n729\t}\n730\t\n731\tfunc sysError(err error) string {\n732\t\tvar pathErr *os.PathError\n733\t\tif errors.As(err, &pathErr) {\n734\t\t\treturn pathErr.Err.Error()\n735\t\t}\n736\t\treturn err.Error()\n737\t}\n738\t"}]},"parent_tool_use_id":null,"session_id":"6949b217-412c-4560-bd4a-9e3e6a1dfd95","uuid":"bba2e46a-d3eb-46d0-911b-8e06331c13e3","timestamp":"2026-05-14T22:07:08.532Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5217/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd008-ls R1.1-R1.14, R2.1-R2.15.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n  -a             do not ignore entries starting with .\n  -A             do not list implied . and ..\n  -C             list entries by columns\n  -d             list directories themselves, not their contents\n  -i             print the index number of each file\n  -l             use a long listing format\n  -n             like -l, but list numeric user and group IDs\n  -r             reverse order while sorting\n  -s             print the allocated size of each file, in blocks\n  -S             sort by file size, largest first\n  -t             sort by modification time, newest first\n  -U             do not sort; list entries in directory order\n  -v             natural sort of (version) numbers within text\n  -x             list entries by lines instead of by columns\n  -1             list one file per line\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn   bool\n\tlongFormat     bool\n\tforceColumns   bool\n\thorizontalSort bool\n\tshowAll        bool\n\tshowAlmostAll  bool\n\tdirAsEntry     bool\n\tsortByTime     bool\n\tsortBySize     bool\n\treverseSort    bool\n\tunsorted       bool\n\tversionSort    bool\n\tshowInode      bool\n\tshowBlocks     bool\n\tnumericIds     bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'C':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = false\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'x':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = true\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'a':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\tcase 'A':\n\t\t\topts.showAlmostAll = true\n\t\t\topts.showAll = false\n\t\tcase 'd':\n\t\t\topts.dirAsEntry = true\n\t\tcase 'i':\n\t\t\topts.showInode = true\n\t\tcase 'n':\n\t\t\topts.numericIds = true\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'r':\n\t\t\topts.reverseSort = true\n\t\tcase 's':\n\t\t\topts.showBlocks = true\n\t\tcase 't':\n\t\t\topts.sortByTime = true\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'S':\n\t\t\topts.sortBySize = true\n\t\t\topts.sortByTime = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'U':\n\t\t\topts.unsorted = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.versionSort = false\n\t\tcase 'v':\n\t\t\topts.versionSort = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\texitCode := 0\n\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n\tneedSep := false\n\tif len(files) > 0 {\n\t\tsortEntries(files, \"\", opts)\n\t\tif opts.longFormat {\n\t\t\texitCode = maxCode(exitCode, writeLongFiles(files, opts))\n\t\t} else {\n\t\t\tdisplay := prependPrefixes(files, \"\", opts)\n\t\t\twriteEntries(display, opts)\n\t\t}\n\t\tneedSep = true\n\t}\n\tshowHeader := len(dirs) > 1 || len(files) > 0\n\tsortEntries(dirs, \"\", opts)\n\tfor _, dir := range dirs {\n\t\tif needSep {\n\t\t\tfmt.Fprintln(os.Stdout)\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n\t\t}\n\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n\t\tneedSep = true\n\t}\n\treturn exitCode\n}\n\nfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n\tvar files, dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\t*exitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() && !dirAsEntry {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\treturn files, dirs\n}\n\nfunc maxCode(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc listDir(path string, opts options) int {\n\tnames, err := readNames(path, opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n\t\t\tpath, sysError(err))\n\t\treturn 2\n\t}\n\tif opts.longFormat {\n\t\treturn writeLongDir(path, names, opts)\n\t}\n\tdisplay := prependPrefixes(names, path, opts)\n\twriteEntries(display, opts)\n\treturn 0\n}\n\nfunc readNames(path string, opts options) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tif opts.showAll {\n\t\tnames = append(names, \".\", \"..\")\n\t}\n\tfor _, e := range entries {\n\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name())\n\t}\n\tsortEntries(names, path, opts)\n\treturn names, nil\n}\n\nfunc sortEntries(names []string, basePath string, opts options) {\n\tif opts.unsorted {\n\t\treturn\n\t}\n\tif opts.versionSort {\n\t\tsort.SliceStable(names, func(i, j int) bool {\n\t\t\treturn strverscmp(names[i], names[j]) < 0\n\t\t})\n\t\tif opts.reverseSort {\n\t\t\treverseSlice(names)\n\t\t}\n\t\treturn\n\t}\n\tif !opts.sortByTime && !opts.sortBySize {\n\t\tsort.Strings(names)\n\t\tif opts.reverseSort {\n\t\t\treverseSlice(names)\n\t\t}\n\t\treturn\n\t}\n\ttype entry struct {\n\t\tname    string\n\t\tmodTime time.Time\n\t\tsize    int64\n\t}\n\tentries := make([]entry, len(names))\n\tfor i, name := range names {\n\t\tentries[i].name = name\n\t\tp := name\n\t\tif basePath != \"\" {\n\t\t\tp = filepath.Join(basePath, name)\n\t\t}\n\t\tif fi, err := sys.Lstat(p); err == nil {\n\t\t\tentries[i].modTime = fi.ModTime\n\t\t\tentries[i].size = fi.Size\n\t\t}\n\t}\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\tif opts.sortByTime {\n\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n\t\t\t}\n\t\t\treturn entries[i].name < entries[j].name\n\t\t}\n\t\tif entries[i].size != entries[j].size {\n\t\t\treturn entries[i].size > entries[j].size\n\t\t}\n\t\treturn entries[i].name < entries[j].name\n\t})\n\tfor i, e := range entries {\n\t\tnames[i] = e.name\n\t}\n\tif opts.reverseSort {\n\t\treverseSlice(names)\n\t}\n}\n\ntype prefixInfo struct {\n\tinode  uint64\n\tblocks int64\n}\n\nfunc prependPrefixes(names []string, basePath string, opts options) []string {\n\tif !opts.showInode && !opts.showBlocks {\n\t\treturn names\n\t}\n\tinfos := make([]prefixInfo, len(names))\n\tvar inodeW, blocksW int\n\tfor i, name := range names {\n\t\tp := name\n\t\tif basePath != \"\" {\n\t\t\tp = filepath.Join(basePath, name)\n\t\t}\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tinfos[i] = prefixInfo{fi.Ino, fi.Blocks / 2}\n\t\tif n := len(strconv.FormatUint(fi.Ino, 10)); n > inodeW {\n\t\t\tinodeW = n\n\t\t}\n\t\tif n := len(strconv.FormatInt(fi.Blocks/2, 10)); n > blocksW {\n\t\t\tblocksW = n\n\t\t}\n\t}\n\tresult := make([]string, len(names))\n\tfor i, name := range names {\n\t\tvar b strings.Builder\n\t\tif opts.showInode {\n\t\t\tb.WriteString(format.PadLeft(strconv.FormatUint(infos[i].inode, 10), inodeW))\n\t\t\tb.WriteByte(' ')\n\t\t}\n\t\tif opts.showBlocks {\n\t\t\tb.WriteString(format.PadLeft(strconv.FormatInt(infos[i].blocks, 10), blocksW))\n\t\t\tb.WriteByte(' ')\n\t\t}\n\t\tb.WriteString(name)\n\t\tresult[i] = b.String()\n\t}\n\treturn result\n}\n\nfunc writeEntries(names []string, opts options) {\n\tif len(names) == 0 {\n\t\treturn\n\t}\n\tif opts.forceColumns {\n\t\tif opts.horizontalSort {\n\t\t\twriteHorizontalColumns(names, 0)\n\t\t} else {\n\t\t\twriteColumnsWidth(names, 0)\n\t\t}\n\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n\t\twriteLines(names)\n\t} else {\n\t\twriteColumnsWidth(names, 0)\n\t}\n}\n\nfunc writeColumnsWidth(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tgrid := format.Columns(names, width)\n\twidths := gridColumnWidths(grid)\n\tfor _, row := range grid {\n\t\twriteGridRow(row, widths)\n\t}\n}\n\nfunc writeHorizontalColumns(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tnumCols := findHorizontalMaxCols(names, width)\n\trows := (len(names) + numCols - 1) / numCols\n\tcolWidths := make([]int, numCols)\n\tfor c := 0; c < numCols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\tfor r := 0; r < rows; r++ {\n\t\tvar row []string\n\t\tfor c := 0; c < numCols; c++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\trow = append(row, names[idx])\n\t\t}\n\t\twriteGridRow(row, colWidths)\n\t}\n}\n\nfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n\tn := len(entries)\n\tfor cols := n; cols > 1; cols-- {\n\t\tif horizontalGridFits(entries, cols, termWidth) {\n\t\t\treturn cols\n\t\t}\n\t}\n\treturn 1\n}\n\nfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n\trows := (len(entries) + cols - 1) / cols\n\tcolWidths := make([]int, cols)\n\tfor c := 0; c < cols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*cols + c\n\t\t\tif idx >= len(entries) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\ttotal := 0\n\tfor c := 0; c < cols; c++ {\n\t\tif c < cols-1 {\n\t\t\ttotal += colWidths[c] + 2\n\t\t} else {\n\t\t\ttotal += colWidths[c]\n\t\t}\n\t\tif total > termWidth {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc writeLines(names []string) {\n\tfor _, name := range names {\n\t\twriteLine(name)\n\t}\n}\n\nfunc gridColumnWidths(grid [][]string) []int {\n\tif len(grid) == 0 {\n\t\treturn nil\n\t}\n\twidths := make([]int, len(grid[0]))\n\tfor _, row := range grid {\n\t\tfor c, cell := range row {\n\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n\t\t\t\twidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\treturn widths\n}\n\nfunc writeGridRow(row []string, widths []int) {\n\tvar b strings.Builder\n\tfor i, cell := range row {\n\t\tif i < len(row)-1 {\n\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n\t\t\tb.WriteString(\"  \")\n\t\t} else {\n\t\t\tb.WriteString(cell)\n\t\t}\n\t}\n\twriteLine(b.String())\n}\n\ntype longEntry struct {\n\tname  string\n\tpath  string\n\tinfo  *sys.FileInfo\n\towner string\n\tgroup string\n}\n\ntype longWidths struct {\n\tinode  int\n\tblocks int\n\tnlink  int\n\towner  int\n\tgroup  int\n\tsize   int\n}\n\nfunc writeLongFiles(paths []string, opts options) int {\n\tentries := make([]longEntry, 0, len(paths))\n\tcode := 0\n\tfor _, p := range paths {\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(p, p, fi, opts))\n\t}\n\twriteLongEntries(entries, opts)\n\treturn code\n}\n\nfunc writeLongDir(path string, names []string, opts options) int {\n\tentries := make([]longEntry, 0, len(names))\n\tcode := 0\n\tfor _, name := range names {\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(full)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(name, full, fi, opts))\n\t}\n\ttotalBlocks := int64(0)\n\tfor _, e := range entries {\n\t\ttotalBlocks += e.info.Blocks\n\t}\n\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n\twriteLongEntries(entries, opts)\n\treturn code\n}\n\nfunc newLongEntry(name, path string, fi *sys.FileInfo, opts options) longEntry {\n\towner := resolveOwner(fi.Uid)\n\tgroup := resolveGroup(fi.Gid)\n\tif opts.numericIds {\n\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n\t}\n\treturn longEntry{\n\t\tname:  name,\n\t\tpath:  path,\n\t\tinfo:  fi,\n\t\towner: owner,\n\t\tgroup: group,\n\t}\n}\n\nfunc writeLongEntries(entries []longEntry, opts options) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tw := computeLongWidths(entries, opts)\n\tfor _, e := range entries {\n\t\twriteLine(formatLongLine(e, w, opts))\n\t}\n}\n\nfunc computeLongWidths(entries []longEntry, opts options) longWidths {\n\tvar w longWidths\n\tfor _, e := range entries {\n\t\tif opts.showInode {\n\t\t\tif n := len(strconv.FormatUint(e.info.Ino, 10)); n > w.inode {\n\t\t\t\tw.inode = n\n\t\t\t}\n\t\t}\n\t\tif opts.showBlocks {\n\t\t\tif n := len(strconv.FormatInt(e.info.Blocks/2, 10)); n > w.blocks {\n\t\t\t\tw.blocks = n\n\t\t\t}\n\t\t}\n\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n\t\t\tw.nlink = n\n\t\t}\n\t\tif n := len(e.owner); n > w.owner {\n\t\t\tw.owner = n\n\t\t}\n\t\tif n := len(e.group); n > w.group {\n\t\t\tw.group = n\n\t\t}\n\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n\t\t\tw.size = n\n\t\t}\n\t}\n\treturn w\n}\n\nfunc formatLongLine(e longEntry, w longWidths, opts options) string {\n\tvar prefix string\n\tif opts.showInode {\n\t\tprefix += format.PadLeft(strconv.FormatUint(e.info.Ino, 10), w.inode) + \" \"\n\t}\n\tif opts.showBlocks {\n\t\tprefix += format.PadLeft(strconv.FormatInt(e.info.Blocks/2, 10), w.blocks) + \" \"\n\t}\n\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n\tsize := strconv.FormatInt(e.info.Size, 10)\n\tname := e.name\n\tif e.info.Mode&os.ModeSymlink != 0 {\n\t\tif target, err := os.Readlink(e.path); err == nil {\n\t\t\tname += \" -> \" + target\n\t\t}\n\t}\n\treturn prefix +\n\t\tpermString(e.info.Mode) + \" \" +\n\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n\t\tformat.PadRight(e.group, w.group) + \" \" +\n\t\tformat.PadLeft(size, w.size) + \" \" +\n\t\tformatMtime(e.info.ModTime) + \" \" +\n\t\tname\n}\n\nfunc permString(mode os.FileMode) string {\n\tvar b [10]byte\n\tb[0] = fileTypeChar(mode)\n\tconst rwx = \"rwx\"\n\tperm := mode.Perm()\n\tfor i := 0; i < 9; i++ {\n\t\tif perm&(1<<uint(8-i)) != 0 {\n\t\t\tb[1+i] = rwx[i%3]\n\t\t} else {\n\t\t\tb[1+i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(mode, &b)\n\treturn string(b[:])\n}\n\nfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif b[3] == 'x' {\n\t\t\tb[3] = 's'\n\t\t} else {\n\t\t\tb[3] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif b[6] == 'x' {\n\t\t\tb[6] = 's'\n\t\t} else {\n\t\t\tb[6] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif b[9] == 'x' {\n\t\t\tb[9] = 't'\n\t\t} else {\n\t\t\tb[9] = 'T'\n\t\t}\n\t}\n}\n\nfunc fileTypeChar(mode os.FileMode) byte {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn 'l'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\treturn 'b'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\treturn 's'\n\tdefault:\n\t\treturn '-'\n\t}\n}\n\nfunc resolveOwner(uid uint32) string {\n\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(uid), 10)\n\t}\n\treturn u.Username\n}\n\nfunc resolveGroup(gid uint32) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(gid), 10)\n\t}\n\treturn g.Name\n}\n\nfunc formatMtime(t time.Time) string {\n\tsixMonths := 6 * 30 * 24 * time.Hour\n\tago := time.Since(t)\n\tif ago >= 0 && ago < sixMonths {\n\t\treturn t.Format(\"Jan _2 15:04\")\n\t}\n\treturn t.Format(\"Jan _2  2006\")\n}\n\nfunc writeLine(s string) {\n\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc sysError(err error) string {\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\treturn pathErr.Err.Error()\n\t}\n\treturn err.Error()\n}\n","numLines":738,"startLine":1,"totalLines":738}}}
