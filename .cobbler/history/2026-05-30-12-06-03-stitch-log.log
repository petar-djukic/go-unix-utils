ols {\n\t\treturn c*rows + r\n\t}\n\treturn fullCols*rows + (c-fullCols)*(rows-1) + r\n}\n\nfunc padToCol(s string, absStart, absTarget int) string {\n\tif absStart+len(s) >= absTarget {\n\t\treturn s[:absTarget-absStart]\n\t}\n\tvar buf strings.Builder\n\tbuf.WriteString(s)\n\tpos := absStart + len(s)\n\tfor pos < absTarget {\n\t\tnextTab := (pos/8 + 1) * 8\n\t\tif nextTab <= absTarget {\n\t\t\tbuf.WriteByte('\\t')\n\t\t\tpos = nextTab\n\t\t} else {\n\t\t\tbuf.WriteString(strings.Repeat(\" \", absTarget-pos))\n\t\t\tpos = absTarget\n\t\t}\n\t}\n\treturn buf.String()\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":3,"cache_creation_input_tokens":14525,"cache_read_input_tokens":11845,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14525},"output_tokens":39,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c8b6e4b3-6e51-463e-bd73-d80dca36194e","uuid":"9638cefc-298a-4414-8605-89c1b8cc2191"}
