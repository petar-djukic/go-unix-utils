{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DjBgSj91qMFaZ5HBUQdgHT","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd110-pr R1.1, R2.1, R2.2, R2.3, R3.1.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n19\t)\n20\t\n21\tconst (\n22\t\theaderSize     = 5\n23\t\tfooterSize     = 5\n24\t\tdefaultPageLen = 66\n25\t\tdefaultWidth   = 72\n26\t)\n27\t\n28\ttype options struct {\n29\t\tpageLength     int\n30\t\theaderText     string\n31\t\theaderSet      bool\n32\t\tomitHeader     bool\n33\t\tomitPagination bool\n34\t\tcolumns        int\n35\t\tacross         bool\n36\t}\n37\t\n38\tfunc main() {\n39\t\tsys.InstallSIGPIPEHandler()\n40\t\tos.Exit(run(os.Args[1:]))\n41\t}\n42\t\n43\tfunc run(args []string) int {\n44\t\topts, files, err := parseArgs(args)\n45\t\tif err != nil {\n46\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n47\t\t\treturn 1\n48\t\t}\n49\t\tif len(files) == 0 {\n50\t\t\tfiles = []string{\"-\"}\n51\t\t}\n52\t\tw := bufio.NewWriter(os.Stdout)\n53\t\texitCode := 0\n54\t\tfor _, f := range files {\n55\t\t\tif err := processFile(f, opts, w); err != nil {\n56\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n57\t\t\t\t\tos.Exit(0)\n58\t\t\t\t}\n59\t\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n60\t\t\t\texitCode = 1\n61\t\t\t}\n62\t\t}\n63\t\tif err := w.Flush(); err != nil {\n64\t\t\tif errors.Is(err, syscall.EPIPE) {\n65\t\t\t\tos.Exit(0)\n66\t\t\t}\n67\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n68\t\t\texitCode = 1\n69\t\t}\n70\t\treturn exitCode\n71\t}\n72\t\n73\tfunc parseArgs(args []string) (options, []string, error) {\n74\t\topts := options{pageLength: defaultPageLen}\n75\t\tvar files []string\n76\t\tfor i := 0; i < len(args); i++ {\n77\t\t\ta := args[i]\n78\t\t\tif a == \"--\" {\n79\t\t\t\tfiles = append(files, args[i+1:]...)\n80\t\t\t\tbreak\n81\t\t\t}\n82\t\t\tvar err error\n83\t\t\tswitch {\n84\t\t\tcase strings.HasPrefix(a, \"--length=\"):\n85\t\t\t\terr = setPageLen(&opts, a[len(\"--length=\"):])\n86\t\t\tcase strings.HasPrefix(a, \"--header=\"):\n87\t\t\t\topts.headerText, opts.headerSet = a[len(\"--header=\"):], true\n88\t\t\tcase a == \"--omit-header\" || a == \"-t\":\n89\t\t\t\topts.omitHeader = true\n90\t\t\tcase a == \"--omit-pagination\" || a == \"-T\":\n91\t\t\t\topts.omitPagination = true\n92\t\t\tcase strings.HasPrefix(a, \"-l\"):\n93\t\t\t\terr = parseLenFlag(args, &i, &opts)\n94\t\t\tcase strings.HasPrefix(a, \"-h\"):\n95\t\t\t\terr = parseHdrFlag(args, &i, &opts)\n96\t\t\tcase a == \"--across\" || a == \"-a\":\n97\t\t\t\topts.across = true\n98\t\t\tcase strings.HasPrefix(a, \"--columns=\"):\n99\t\t\t\terr = setColumns(&opts, a[len(\"--columns=\"):])\n100\t\t\tcase isColumnsFlag(a):\n101\t\t\t\terr = setColumns(&opts, a[1:])\n102\t\t\tcase strings.HasPrefix(a, \"-\") && a != \"-\":\n103\t\t\t\terr = fmt.Errorf(\"unrecognized option '%s'\", a)\n104\t\t\tdefault:\n105\t\t\t\tfiles = append(files, a)\n106\t\t\t}\n107\t\t\tif err != nil {\n108\t\t\t\treturn opts, nil, err\n109\t\t\t}\n110\t\t}\n111\t\tif opts.pageLength <= 10 {\n112\t\t\topts.omitHeader = true\n113\t\t}\n114\t\treturn opts, files, nil\n115\t}\n116\t\n117\tfunc parseLenFlag(args []string, i *int, opts *options) error {\n118\t\tv, err := valFlag(args, i, \"-l\")\n119\t\tif err != nil {\n120\t\t\treturn err\n121\t\t}\n122\t\treturn setPageLen(opts, v)\n123\t}\n124\t\n125\tfunc parseHdrFlag(args []string, i *int, opts *options) error {\n126\t\tv, err := valFlag(args, i, \"-h\")\n127\t\tif err != nil {\n128\t\t\treturn err\n129\t\t}\n130\t\topts.headerText, opts.headerSet = v, true\n131\t\treturn nil\n132\t}\n133\t\n134\tfunc valFlag(args []string, i *int, prefix string) (string, error) {\n135\t\ta := args[*i]\n136\t\tif len(a) > len(prefix) {\n137\t\t\treturn a[len(prefix):], nil\n138\t\t}\n139\t\t*i++\n140\t\tif *i >= len(args) {\n141\t\t\treturn \"\", fmt.Errorf(\"option requires an argument -- '%c'\", prefix[1])\n142\t\t}\n143\t\treturn args[*i], nil\n144\t}\n145\t\n146\tfunc setPageLen(opts *options, s string) error {\n147\t\tn, err := strconv.Atoi(s)\n148\t\tif err != nil || n < 1 {\n149\t\t\treturn fmt.Errorf(\"invalid page length: %q\", s)\n150\t\t}\n151\t\topts.pageLength = n\n152\t\treturn nil\n153\t}\n154\t\n155\tfunc setColumns(opts *options, s string) error {\n156\t\tn, err := strconv.Atoi(s)\n157\t\tif err != nil || n < 1 {\n158\t\t\treturn fmt.Errorf(\"invalid number of columns: %q\", s)\n159\t\t}\n160\t\topts.columns = n\n161\t\treturn nil\n162\t}\n163\t\n164\tfunc isColumnsFlag(s string) bool {\n165\t\tif len(s) < 2 || s[0] != '-' {\n166\t\t\treturn false\n167\t\t}\n168\t\tfor _, c := range s[1:] {\n169\t\t\tif c < '0' || c > '9' {\n170\t\t\t\treturn false\n171\t\t\t}\n172\t\t}\n173\t\treturn true\n174\t}\n175\t\n176\tfunc processFile(path string, opts options, w *bufio.Writer) error {\n177\t\tvar r io.Reader\n178\t\tvar filename string\n179\t\tvar modTime time.Time\n180\t\tif path == \"-\" {\n181\t\t\tr = os.Stdin\n182\t\t\tfilename = \"\"\n183\t\t\tmodTime = time.Now()\n184\t\t} else {\n185\t\t\tf, err := os.Open(path)\n186\t\t\tif err != nil {\n187\t\t\t\treturn err\n188\t\t\t}\n189\t\t\tdefer f.Close()\n190\t\t\tinfo, err := f.Stat()\n191\t\t\tif err != nil {\n192\t\t\t\treturn err\n193\t\t\t}\n194\t\t\tr = f\n195\t\t\tfilename = path\n196\t\t\tmodTime = info.ModTime()\n197\t\t}\n198\t\tif opts.headerSet {\n199\t\t\tfilename = opts.headerText\n200\t\t}\n201\t\treturn paginate(r, filename, modTime, opts, w)\n202\t}\n203\t\n204\tfunc paginate(r io.Reader, filename string, modTime time.Time, opts options, w *bufio.Writer) error {\n205\t\tscanner := bufio.NewScanner(r)\n206\t\tcols := max(opts.columns, 1)\n207\t\tnoHdr := opts.omitHeader || opts.omitPagination\n208\t\tif noHdr && cols <= 1 {\n209\t\t\treturn paginateNoHeader(scanner, w)\n210\t\t}\n211\t\tbody := max(opts.pageLength-headerSize-footerSize, 1)\n212\t\tif noHdr {\n213\t\t\tbody = opts.pageLength\n214\t\t}\n215\t\tdate := modTime.Format(\"2006-01-02 15:04\")\n216\t\tpageNum := 1\n217\t\tfor {\n218\t\t\tlines, eof := readBody(scanner, body*cols)\n219\t\t\tif len(lines) == 0 && eof {\n220\t\t\t\tbreak\n221\t\t\t}\n222\t\t\tif !noHdr {\n223\t\t\t\tif err := writeHeader(w, date, filename, pageNum); err != nil {\n224\t\t\t\t\treturn err\n225\t\t\t\t}\n226\t\t\t}\n227\t\t\tif cols > 1 {\n228\t\t\t\tif err := writeColumns(w, lines, body, cols, opts.across, !noHdr); err != nil {\n229\t\t\t\t\treturn err\n230\t\t\t\t}\n231\t\t\t} else if err := writeBody(w, lines, body); err != nil {\n232\t\t\t\treturn err\n233\t\t\t}\n234\t\t\tif !noHdr {\n235\t\t\t\tif err := writeFooter(w); err != nil {\n236\t\t\t\t\treturn err\n237\t\t\t\t}\n238\t\t\t}\n239\t\t\tpageNum++\n240\t\t\tif eof {\n241\t\t\t\tbreak\n242\t\t\t}\n243\t\t}\n244\t\treturn scanner.Err()\n245\t}\n246\t\n247\tfunc paginateNoHeader(scanner *bufio.Scanner, w *bufio.Writer) error {\n248\t\tfor scanner.Scan() {\n249\t\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", scanner.Text()); err != nil {\n250\t\t\t\treturn err\n251\t\t\t}\n252\t\t}\n253\t\treturn scanner.Err()\n254\t}\n255\t\n256\tfunc readBody(scanner *bufio.Scanner, n int) ([]string, bool) {\n257\t\tvar lines []string\n258\t\tfor range n {\n259\t\t\tif !scanner.Scan() {\n260\t\t\t\treturn lines, true\n261\t\t\t}\n262\t\t\tlines = append(lines, scanner.Text())\n263\t\t}\n264\t\treturn lines, false\n265\t}\n266\t\n267\tfunc writeHeader(w *bufio.Writer, date, filename string, pageNum int) error {\n268\t\tif _, err := fmt.Fprint(w, \"\\n\\n\"); err != nil {\n269\t\t\treturn err\n270\t\t}\n271\t\tright := fmt.Sprintf(\"Page %d\", pageNum)\n272\t\tavail := defaultWidth - len(date) - len(right)\n273\t\tlpad := avail\n274\t\trpad := 0\n275\t\tif len(filename) < avail {\n276\t\t\tlpad = (avail - len(filename)) / 2\n277\t\t\trpad = avail - len(filename) - lpad\n278\t\t}\n279\t\tline := date + strings.Repeat(\" \", lpad) + filename + strings.Repeat(\" \", rpad) + right\n280\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", line); err != nil {\n281\t\t\treturn err\n282\t\t}\n283\t\t_, err := fmt.Fprint(w, \"\\n\\n\")\n284\t\treturn err\n285\t}\n286\t\n287\tfunc writeBody(w *bufio.Writer, lines []string, bodySize int) error {\n288\t\tfor _, line := range lines {\n289\t\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", line); err != nil {\n290\t\t\t\treturn err\n291\t\t\t}\n292\t\t}\n293\t\tfor range bodySize - len(lines) {\n294\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n295\t\t\t\treturn err\n296\t\t\t}\n297\t\t}\n298\t\treturn nil\n299\t}\n300\t\n301\tfunc writeFooter(w *bufio.Writer) error {\n302\t\tfor range footerSize {\n303\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n304\t\t\t\treturn err\n305\t\t\t}\n306\t\t}\n307\t\treturn nil\n308\t}\n309\t\n310\tfunc writeColumns(w *bufio.Writer, lines []string, bodySize, cols int, across, pad bool) error {\n311\t\tcolWidth := defaultWidth / cols\n312\t\tn := len(lines)\n313\t\trows := (n + cols - 1) / cols\n314\t\tfullCols := n - (rows-1)*cols\n315\t\tfor r := range rows {\n316\t\t\tlast := lastDataCol(r, cols, rows, fullCols, n, across)\n317\t\t\tfor c := 0; c <= last; c++ {\n318\t\t\t\ttext := \"\"\n319\t\t\t\tif across {\n320\t\t\t\t\ttext = lines[r*cols+c]\n321\t\t\t\t} else {\n322\t\t\t\t\ttext = lines[colDownIdx(r, c, rows, fullCols)]\n323\t\t\t\t}\n324\t\t\t\tif c < last {\n325\t\t\t\t\ttext = padToCol(text, c*colWidth, (c+1)*colWidth)\n326\t\t\t\t}\n327\t\t\t\tif _, err := fmt.Fprint(w, text); err != nil {\n328\t\t\t\t\treturn err\n329\t\t\t\t}\n330\t\t\t}\n331\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n332\t\t\t\treturn err\n333\t\t\t}\n334\t\t}\n335\t\tif pad {\n336\t\t\tfor range bodySize - rows {\n337\t\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n338\t\t\t\t\treturn err\n339\t\t\t\t}\n340\t\t\t}\n341\t\t}\n342\t\treturn nil\n343\t}\n344\t\n345\tfunc lastDataCol(r, cols, rows, fullCols, n int, across bool) int {\n346\t\tif across {\n347\t\t\tif remaining := n - r*cols; remaining >= cols {\n348\t\t\t\treturn cols - 1\n349\t\t\t} else {\n350\t\t\t\treturn remaining - 1\n351\t\t\t}\n352\t\t}\n353\t\tif r < rows-1 || fullCols >= cols {\n354\t\t\treturn cols - 1\n355\t\t}\n356\t\treturn fullCols - 1\n357\t}\n358\t\n359\tfunc colDownIdx(r, c, rows, fullCols int) int {\n360\t\tif c < fullCols {\n361\t\t\treturn c*rows + r\n362\t\t}\n363\t\treturn fullCols*rows + (c-fullCols)*(rows-1) + r\n364\t}\n365\t\n366\tfunc padToCol(s string, absStart, absTarget int) string {\n367\t\tif absStart+len(s) >= absTarget {\n368\t\t\treturn s[:absTarget-absStart]\n369\t\t}\n370\t\tvar buf strings.Builder\n371\t\tbuf.WriteString(s)\n372\t\tpos := absStart + len(s)\n373\t\tfor pos < absTarget {\n374\t\t\tnextTab := (pos/8 + 1) * 8\n375\t\t\tif nextTab <= absTarget {\n376\t\t\t\tbuf.WriteByte('\\t')\n377\t\t\t\tpos = nextTab\n378\t\t\t} else {\n379\t\t\t\tbuf.WriteString(strings.Repeat(\" \", absTarget-pos))\n380\t\t\t\tpos = absTarget\n381\t\t\t}\n382\t\t}\n383\t\treturn buf.String()\n384\t}\n385\t"}]},"parent_tool_use_id":null,"session_id":"c8b6e4b3-6e51-463e-bd73-d80dca36194e","uuid":"bcd35564-fc6e-4b4e-96b7-0d9467e8353b","timestamp":"2026-05-30T16:06:15.999Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5670/cmd/pr/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd110-pr R1.1, R2.1, R2.2, R2.3, R3.1.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst (\n\theaderSize     = 5\n\tfooterSize     = 5\n\tdefaultPageLen = 66\n\tdefaultWidth   = 72\n)\n\ntype options struct {\n\tpageLength     int\n\theaderText     string\n\theaderSet      bool\n\tomitHeader     bool\n\tomitPagination bool\n\tcolumns        int\n\tacross         bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run(os.Args[1:]))\n}\n\nfunc run(args []string) int {\n\topts, files, err := parseArgs(args)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n\t\treturn 1\n\t}\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\tw := bufio.NewWriter(os.Stdout)\n\texitCode := 0\n\tfor _, f := range files {\n\t\tif err := processFile(f, opts, w); err != nil {\n\t\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\t\tos.Exit(0)\n\t\t\t}\n\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif err := w.Flush(); err != nil {\n\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\tos.Exit(0)\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n\t\texitCode = 1\n\t}\n\treturn exitCode\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\topts := options{pageLength: defaultPageLen}\n\tvar files []string\n\tfor i := 0; i < len(args); i++ {\n\t\ta := args[i]\n\t\tif a == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tvar err error\n\t\tswitch {\n\t\tcase strings.HasPrefix(a, \"--length=\"):\n\t\t\terr = setPageLen(&opts, a[len(\"--length=\"):])\n\t\tcase strings.HasPrefix(a, \"--header=\"):\n\t\t\topts.headerText, opts.headerSet = a[len(\"--header=\"):], true\n\t\tcase a == \"--omit-header\" || a == \"-t\":\n\t\t\topts.omitHeader = true\n\t\tcase a == \"--omit-pagination\" || a == \"-T\":\n\t\t\topts.omitPagination = true\n\t\tcase strings.HasPrefix(a, \"-l\"):\n\t\t\terr = parseLenFlag(args, &i, &opts)\n\t\tcase strings.HasPrefix(a, \"-h\"):\n\t\t\terr = parseHdrFlag(args, &i, &opts)\n\t\tcase a == \"--across\" || a == \"-a\":\n\t\t\topts.across = true\n\t\tcase strings.HasPrefix(a, \"--columns=\"):\n\t\t\terr = setColumns(&opts, a[len(\"--columns=\"):])\n\t\tcase isColumnsFlag(a):\n\t\t\terr = setColumns(&opts, a[1:])\n\t\tcase strings.HasPrefix(a, \"-\") && a != \"-\":\n\t\t\terr = fmt.Errorf(\"unrecognized option '%s'\", a)\n\t\tdefault:\n\t\t\tfiles = append(files, a)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn opts, nil, err\n\t\t}\n\t}\n\tif opts.pageLength <= 10 {\n\t\topts.omitHeader = true\n\t}\n\treturn opts, files, nil\n}\n\nfunc parseLenFlag(args []string, i *int, opts *options) error {\n\tv, err := valFlag(args, i, \"-l\")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn setPageLen(opts, v)\n}\n\nfunc parseHdrFlag(args []string, i *int, opts *options) error {\n\tv, err := valFlag(args, i, \"-h\")\n\tif err != nil {\n\t\treturn err\n\t}\n\topts.headerText, opts.headerSet = v, true\n\treturn nil\n}\n\nfunc valFlag(args []string, i *int, prefix string) (string, error) {\n\ta := args[*i]\n\tif len(a) > len(prefix) {\n\t\treturn a[len(prefix):], nil\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\treturn \"\", fmt.Errorf(\"option requires an argument -- '%c'\", prefix[1])\n\t}\n\treturn args[*i], nil\n}\n\nfunc setPageLen(opts *options, s string) error {\n\tn, err := strconv.Atoi(s)\n\tif err != nil || n < 1 {\n\t\treturn fmt.Errorf(\"invalid page length: %q\", s)\n\t}\n\topts.pageLength = n\n\treturn nil\n}\n\nfunc setColumns(opts *options, s string) error {\n\tn, err := strconv.Atoi(s)\n\tif err != nil || n < 1 {\n\t\treturn fmt.Errorf(\"invalid number of columns: %q\", s)\n\t}\n\topts.columns = n\n\treturn nil\n}\n\nfunc isColumnsFlag(s string) bool {\n\tif len(s) < 2 || s[0] != '-' {\n\t\treturn false\n\t}\n\tfor _, c := range s[1:] {\n\t\tif c < '0' || c > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc processFile(path string, opts options, w *bufio.Writer) error {\n\tvar r io.Reader\n\tvar filename string\n\tvar modTime time.Time\n\tif path == \"-\" {\n\t\tr = os.Stdin\n\t\tfilename = \"\"\n\t\tmodTime = time.Now()\n\t} else {\n\t\tf, err := os.Open(path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tdefer f.Close()\n\t\tinfo, err := f.Stat()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tr = f\n\t\tfilename = path\n\t\tmodTime = info.ModTime()\n\t}\n\tif opts.headerSet {\n\t\tfilename = opts.headerText\n\t}\n\treturn paginate(r, filename, modTime, opts, w)\n}\n\nfunc paginate(r io.Reader, filename string, modTime time.Time, opts options, w *bufio.Writer) error {\n\tscanner := bufio.NewScanner(r)\n\tcols := max(opts.columns, 1)\n\tnoHdr := opts.omitHeader || opts.omitPagination\n\tif noHdr && cols <= 1 {\n\t\treturn paginateNoHeader(scanner, w)\n\t}\n\tbody := max(opts.pageLength-headerSize-footerSize, 1)\n\tif noHdr {\n\t\tbody = opts.pageLength\n\t}\n\tdate := modTime.Format(\"2006-01-02 15:04\")\n\tpageNum := 1\n\tfor {\n\t\tlines, eof := readBody(scanner, body*cols)\n\t\tif len(lines) == 0 && eof {\n\t\t\tbreak\n\t\t}\n\t\tif !noHdr {\n\t\t\tif err := writeHeader(w, date, filename, pageNum); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tif cols > 1 {\n\t\t\tif err := writeColumns(w, lines, body, cols, opts.across, !noHdr); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t} else if err := writeBody(w, lines, body); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !noHdr {\n\t\t\tif err := writeFooter(w); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tpageNum++\n\t\tif eof {\n\t\t\tbreak\n\t\t}\n\t}\n\treturn scanner.Err()\n}\n\nfunc paginateNoHeader(scanner *bufio.Scanner, w *bufio.Writer) error {\n\tfor scanner.Scan() {\n\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", scanner.Text()); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn scanner.Err()\n}\n\nfunc readBody(scanner *bufio.Scanner, n int) ([]string, bool) {\n\tvar lines []string\n\tfor range n {\n\t\tif !scanner.Scan() {\n\t\t\treturn lines, true\n\t\t}\n\t\tlines = append(lines, scanner.Text())\n\t}\n\treturn lines, false\n}\n\nfunc writeHeader(w *bufio.Writer, date, filename string, pageNum int) error {\n\tif _, err := fmt.Fprint(w, \"\\n\\n\"); err != nil {\n\t\treturn err\n\t}\n\tright := fmt.Sprintf(\"Page %d\", pageNum)\n\tavail := defaultWidth - len(date) - len(right)\n\tlpad := avail\n\trpad := 0\n\tif len(filename) < avail {\n\t\tlpad = (avail - len(filename)) / 2\n\t\trpad = avail - len(filename) - lpad\n\t}\n\tline := date + strings.Repeat(\" \", lpad) + filename + strings.Repeat(\" \", rpad) + right\n\tif _, err := fmt.Fprintf(w, \"%s\\n\", line); err != nil {\n\t\treturn err\n\t}\n\t_, err := fmt.Fprint(w, \"\\n\\n\")\n\treturn err\n}\n\nfunc writeBody(w *bufio.Writer, lines []string, bodySize int) error {\n\tfor _, line := range lines {\n\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", line); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tfor range bodySize - len(lines) {\n\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc writeFooter(w *bufio.Writer) error {\n\tfor range footerSize {\n\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc writeColumns(w *bufio.Writer, lines []string, bodySize, cols int, across, pad bool) error {\n\tcolWidth := defaultWidth / cols\n\tn := len(lines)\n\trows := (n + cols - 1) / cols\n\tfullCols := n - (rows-1)*cols\n\tfor r := range rows {\n\t\tlast := lastDataCol(r, cols, rows, fullCols, n, across)\n\t\tfor c := 0; c <= last; c++ {\n\t\t\ttext := \"\"\n\t\t\tif across {\n\t\t\t\ttext = lines[r*cols+c]\n\t\t\t} else {\n\t\t\t\ttext = lines[colDownIdx(r, c, rows, fullCols)]\n\t\t\t}\n\t\t\tif c < last {\n\t\t\t\ttext = padToCol(text, c*colWidth, (c+1)*colWidth)\n\t\t\t}\n\t\t\tif _, err := fmt.Fprint(w, text); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif pad {\n\t\tfor range bodySize - rows {\n\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc lastDataCol(r, cols, rows, fullCols, n int, across bool) int {\n\tif across {\n\t\tif remaining := n - r*cols; remaining >= cols {\n\t\t\treturn cols - 1\n\t\t} else {\n\t\t\treturn remaining - 1\n\t\t}\n\t}\n\tif r < rows-1 || fullCols >= cols {\n\t\treturn cols - 1\n\t}\n\treturn fullCols - 1\n}\n\nfunc colDownIdx(r, c, rows, fullCols int) int {\n\tif c < fullCols {\n\t\treturn c*rows + r\n\t}\n\treturn fullCols*rows + (c-fullCols)*(rows-1) + r\n}\n\nfunc padToCol(s string, absStart, absTarget int) string {\n\tif absStart+len(s) >= absTarget {\n\t\treturn s[:absTarget-absStart]\n\t}\n\tvar buf strings.Builder\n\tbuf.WriteString(s)\n\tpos := absStart + len(s)\n\tfor pos < absTarget {\n\t\tnextTab := (pos/8 + 1) * 8\n\t\tif nextTab <= absTarget {\n\t\t\tbuf.WriteByte('\\t')\n\t\t\tpos = nextTab\n\t\t} else {\n\t\t\tbuf.WriteString(strings.Repeat(\" \", absTarget-pos))\n\t\t\tpos = absTarget\n\t\t}\n\t}\n\treturn buf.String()\n}\n","numLines":385,"startLine":1,"totalLines":385}}}
