{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NGTKGC6wFV6PCj2FwM32dX","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"slices\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: sort [OPTION]... [FILE]...\n18\tWrite sorted concatenation of all FILE(s) to standard output.\n19\t\n20\tWith no FILE, or when FILE is -, read standard input.\n21\t\n22\tMandatory arguments to long options are mandatory for short options too.\n23\tOrdering options:\n24\t\n25\t  -b, --ignore-leading-blanks  ignore leading blanks\n26\t  -h, --human-numeric-sort     compare human readable numbers (e.g., 2K 1G)\n27\t  -M, --month-sort             compare (unknown) < 'JAN' < ... < 'DEC'\n28\t  -n, --numeric-sort           compare according to string numerical value\n29\t  -V, --version-sort           natural sort of (version) numbers within text\n30\t  -r, --reverse                reverse the result of comparisons\n31\t\n32\tOther options:\n33\t\n34\t  -c, --check, --check=diagnose-first  check for sorted input; do not sort\n35\t  -C, --check=quiet, --check=silent  like -c, but do not report first bad line\n36\t  -k, --key=KEYDEF             sort via a key; KEYDEF gives location and type\n37\t  -o, --output=FILE            write result to FILE instead of standard output\n38\t  -s, --stable                 stabilize sort by disabling last-resort comparison\n39\t  -t, --field-separator=SEP    use SEP instead of non-blank to blank transition\n40\t  -u, --unique                 with -c, check for strict ordering;\n41\t                                 without -c, output only the first of an equal run\n42\t      --help        display this help and exit\n43\t      --version     output version information and exit\n44\t`\n45\t\n46\tconst versionText = `sort (go-unix-utils) dev\n47\t`\n48\t\n49\ttype sortMode int\n50\t\n51\tconst (\n52\t\tsortDefault sortMode = iota\n53\t\tsortNumeric\n54\t\tsortHumanNumeric\n55\t\tsortMonth\n56\t\tsortVersion\n57\t)\n58\t\n59\ttype checkMode int\n60\t\n61\tconst (\n62\t\tcheckNone checkMode = iota\n63\t\tcheckDiagnose\n64\t\tcheckQuiet\n65\t)\n66\t\n67\ttype options struct {\n68\t\treverse        bool\n69\t\tunique         bool\n70\t\tstable         bool\n71\t\tignoreBlanks   bool\n72\t\tcheck          checkMode\n73\t\tmode           sortMode\n74\t\toutputFile     string\n75\t\tfieldSeparator string\n76\t\tkeys           []keyDef\n77\t}\n78\t\n79\tvar monthMap = map[string]int{\n80\t\t\"JAN\": 1, \"FEB\": 2, \"MAR\": 3, \"APR\": 4,\n81\t\t\"MAY\": 5, \"JUN\": 6, \"JUL\": 7, \"AUG\": 8,\n82\t\t\"SEP\": 9, \"OCT\": 10, \"NOV\": 11, \"DEC\": 12,\n83\t}\n84\t\n85\tfunc main() {\n86\t\tsys.InstallSIGPIPEHandler()\n87\t\n88\t\topts, files, err := parseArgs(os.Args[1:])\n89\t\tif err != nil {\n90\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n91\t\t\tfmt.Fprintf(os.Stderr, \"Try 'sort --help' for more information.\\n\")\n92\t\t\tos.Exit(2)\n93\t\t}\n94\t\n95\t\tif len(files) == 0 {\n96\t\t\tfiles = []string{\"-\"}\n97\t\t}\n98\t\n99\t\tif opts.check != checkNone {\n100\t\t\tos.Exit(runCheck(files, opts))\n101\t\t}\n102\t\n103\t\tlines, err := readAllLines(files)\n104\t\tif err != nil {\n105\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n106\t\t\tos.Exit(2)\n107\t\t}\n108\t\n109\t\tlines = sortAndFilter(lines, opts)\n110\t\n111\t\tvar w io.Writer = os.Stdout\n112\t\tif opts.outputFile != \"\" {\n113\t\t\tf, err := os.Create(opts.outputFile)\n114\t\t\tif err != nil {\n115\t\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n116\t\t\t\tos.Exit(2)\n117\t\t\t}\n118\t\t\tdefer f.Close()\n119\t\t\tw = f\n120\t\t}\n121\t\twriteLines(lines, w)\n122\t}\n123\t\n124\tfunc parseArgs(args []string) (options, []string, error) {\n125\t\tvar opts options\n126\t\tvar files []string\n127\t\n128\t\ti := 0\n129\t\tfor i < len(args) {\n130\t\t\targ := args[i]\n131\t\t\tif arg == \"--\" {\n132\t\t\t\tfiles = append(files, args[i+1:]...)\n133\t\t\t\tbreak\n134\t\t\t}\n135\t\t\tif strings.HasPrefix(arg, \"--\") {\n136\t\t\t\tn, err := parseLongFlag(arg, &opts, args[i+1:])\n137\t\t\t\tif err != nil {\n138\t\t\t\t\treturn opts, nil, err\n139\t\t\t\t}\n140\t\t\t\ti += n\n141\t\t\t\tcontinue\n142\t\t\t}\n143\t\t\tif len(arg) > 1 && arg[0] == '-' {\n144\t\t\t\textra, err := parseShortFlags(arg[1:], &opts, args[i+1:])\n145\t\t\t\tif err != nil {\n146\t\t\t\t\treturn opts, nil, err\n147\t\t\t\t}\n148\t\t\t\ti += 1 + extra\n149\t\t\t\tcontinue\n150\t\t\t}\n151\t\t\tfiles = append(files, arg)\n152\t\t\ti++\n153\t\t}\n154\t\n155\t\treturn opts, files, nil\n156\t}\n157\t\n158\tfunc parseLongPrefix(flag string, opts *options) (int, bool, error) {\n159\t\tif v, ok := strings.CutPrefix(flag, \"--output=\"); ok {\n160\t\t\topts.outputFile = v\n161\t\t\treturn 1, true, nil\n162\t\t}\n163\t\tif v, ok := strings.CutPrefix(flag, \"--field-separator=\"); ok {\n164\t\t\tif len(v) != 1 {\n165\t\t\t\treturn 0, true, fmt.Errorf(\"multi-character tab '%s'\", v)\n166\t\t\t}\n167\t\t\topts.fieldSeparator = v\n168\t\t\treturn 1, true, nil\n169\t\t}\n170\t\tif v, ok := strings.CutPrefix(flag, \"--key=\"); ok {\n171\t\t\tkey, err := parseKeyDef(v)\n172\t\t\tif err != nil {\n173\t\t\t\treturn 0, true, err\n174\t\t\t}\n175\t\t\topts.keys = append(opts.keys, key)\n176\t\t\treturn 1, true, nil\n177\t\t}\n178\t\tif v, ok := strings.CutPrefix(flag, \"--check=\"); ok {\n179\t\t\tswitch v {\n180\t\t\tcase \"diagnose-first\":\n181\t\t\t\topts.check = checkDiagnose\n182\t\t\tcase \"quiet\", \"silent\":\n183\t\t\t\topts.check = checkQuiet\n184\t\t\tdefault:\n185\t\t\t\treturn 0, true, fmt.Errorf(\"invalid argument '%s' for '--check'\", v)\n186\t\t\t}\n187\t\t\treturn 1, true, nil\n188\t\t}\n189\t\treturn 0, false, nil\n190\t}\n191\t\n192\tfunc parseLongFlag(flag string, opts *options, remaining []string) (int, error) {\n193\t\tif n, handled, err := parseLongPrefix(flag, opts); handled {\n194\t\t\treturn n, err\n195\t\t}\n196\t\tswitch flag {\n197\t\tcase \"--help\":\n198\t\t\tfmt.Fprint(os.Stdout, helpText)\n199\t\t\tos.Exit(0)\n200\t\tcase \"--version\":\n201\t\t\tfmt.Fprint(os.Stdout, versionText)\n202\t\t\tos.Exit(0)\n203\t\tcase \"--reverse\":\n204\t\t\topts.reverse = true\n205\t\tcase \"--unique\":\n206\t\t\topts.unique = true\n207\t\tcase \"--stable\":\n208\t\t\topts.stable = true\n209\t\tcase \"--ignore-leading-blanks\":\n210\t\t\topts.ignoreBlanks = true\n211\t\tcase \"--numeric-sort\":\n212\t\t\topts.mode = sortNumeric\n213\t\tcase \"--human-numeric-sort\":\n214\t\t\topts.mode = sortHumanNumeric\n215\t\tcase \"--month-sort\":\n216\t\t\topts.mode = sortMonth\n217\t\tcase \"--version-sort\":\n218\t\t\topts.mode = sortVersion\n219\t\tcase \"--check\":\n220\t\t\topts.check = checkDiagnose\n221\t\tcase \"--output\", \"--field-separator\", \"--key\":\n222\t\t\treturn parseLongWithArg(flag, opts, remaining)\n223\t\tdefault:\n224\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n225\t\t}\n226\t\treturn 1, nil\n227\t}\n228\t\n229\tfunc parseLongWithArg(flag string, opts *options, remaining []string) (int, error) {\n230\t\tif len(remaining) == 0 {\n231\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n232\t\t}\n233\t\tswitch flag {\n234\t\tcase \"--output\":\n235\t\t\topts.outputFile = remaining[0]\n236\t\tcase \"--field-separator\":\n237\t\t\tif len(remaining[0]) != 1 {\n238\t\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n239\t\t\t}\n240\t\t\topts.fieldSeparator = remaining[0]\n241\t\tcase \"--key\":\n242\t\t\tkey, err := parseKeyDef(remaining[0])\n243\t\t\tif err != nil {\n244\t\t\t\treturn 0, err\n245\t\t\t}\n246\t\t\topts.keys = append(opts.keys, key)\n247\t\t}\n248\t\treturn 2, nil\n249\t}\n250\t\n251\tfunc parseShortFlags(flags string, opts *options, remaining []string) (int, error) {\n252\t\tfor idx := 0; idx < len(flags); idx++ {\n253\t\t\tswitch flags[idx] {\n254\t\t\tcase 'r':\n255\t\t\t\topts.reverse = true\n256\t\t\tcase 'u':\n257\t\t\t\topts.unique = true\n258\t\t\tcase 's':\n259\t\t\t\topts.stable = true\n260\t\t\tcase 'b':\n261\t\t\t\topts.ignoreBlanks = true\n262\t\t\tcase 'n':\n263\t\t\t\topts.mode = sortNumeric\n264\t\t\tcase 'h':\n265\t\t\t\topts.mode = sortHumanNumeric\n266\t\t\tcase 'M':\n267\t\t\t\topts.mode = sortMonth\n268\t\t\tcase 'V':\n269\t\t\t\topts.mode = sortVersion\n270\t\t\tcase 'c':\n271\t\t\t\topts.check = checkDiagnose\n272\t\t\tcase 'C':\n273\t\t\t\topts.check = checkQuiet\n274\t\t\tcase 'o':\n275\t\t\t\trest := flags[idx+1:]\n276\t\t\t\tif rest != \"\" {\n277\t\t\t\t\topts.outputFile = rest\n278\t\t\t\t\treturn 0, nil\n279\t\t\t\t}\n280\t\t\t\tif len(remaining) == 0 {\n281\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'o'\")\n282\t\t\t\t}\n283\t\t\t\topts.outputFile = remaining[0]\n284\t\t\t\treturn 1, nil\n285\t\t\tcase 't':\n286\t\t\t\treturn parseFieldSep(flags[idx+1:], remaining, opts)\n287\t\t\tcase 'k':\n288\t\t\t\treturn parseKeyArg(flags[idx+1:], remaining, opts)\n289\t\t\tdefault:\n290\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[idx])\n291\t\t\t}\n292\t\t}\n293\t\treturn 0, nil\n294\t}\n295\t\n296\tfunc parseFieldSep(rest string, remaining []string, opts *options) (int, error) {\n297\t\tif rest != \"\" {\n298\t\t\tif len(rest) != 1 {\n299\t\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", rest)\n300\t\t\t}\n301\t\t\topts.fieldSeparator = rest\n302\t\t\treturn 0, nil\n303\t\t}\n304\t\tif len(remaining) == 0 {\n305\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 't'\")\n306\t\t}\n307\t\tif len(remaining[0]) != 1 {\n308\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n309\t\t}\n310\t\topts.fieldSeparator = remaining[0]\n311\t\treturn 1, nil\n312\t}\n313\t\n314\tfunc parseKeyArg(rest string, remaining []string, opts *options) (int, error) {\n315\t\tif rest != \"\" {\n316\t\t\tkey, err := parseKeyDef(rest)\n317\t\t\tif err != nil {\n318\t\t\t\treturn 0, err\n319\t\t\t}\n320\t\t\topts.keys = append(opts.keys, key)\n321\t\t\treturn 0, nil\n322\t\t}\n323\t\tif len(remaining) == 0 {\n324\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'k'\")\n325\t\t}\n326\t\tkey, err := parseKeyDef(remaining[0])\n327\t\tif err != nil {\n328\t\t\treturn 0, err\n329\t\t}\n330\t\topts.keys = append(opts.keys, key)\n331\t\treturn 1, nil\n332\t}\n333\t\n334\tfunc readAllLines(files []string) ([]string, error) {\n335\t\tvar lines []string\n336\t\tfor _, file := range files {\n337\t\t\tr, closer, err := openInput(file)\n338\t\t\tif err != nil {\n339\t\t\t\treturn nil, err\n340\t\t\t}\n341\t\t\tfileLines, err := readLines(r)\n342\t\t\tif closer != nil {\n343\t\t\t\tcloser.Close()\n344\t\t\t}\n345\t\t\tif err != nil {\n346\t\t\t\treturn nil, err\n347\t\t\t}\n348\t\t\tlines = append(lines, fileLines...)\n349\t\t}\n350\t\treturn lines, nil\n351\t}\n352\t\n353\tfunc openInput(name string) (io.Reader, io.Closer, error) {\n354\t\tif name == \"-\" {\n355\t\t\treturn os.Stdin, nil, nil\n356\t\t}\n357\t\tf, err := os.Open(name)\n358\t\tif err != nil {\n359\t\t\treturn nil, nil, err\n360\t\t}\n361\t\treturn f, f, nil\n362\t}\n363\t\n364\tfunc readLines(r io.Reader) ([]string, error) {\n365\t\tvar lines []string\n366\t\tscanner := bufio.NewScanner(r)\n367\t\tfor scanner.Scan() {\n368\t\t\tlines = append(lines, scanner.Text())\n369\t\t}\n370\t\tif err := scanner.Err(); err != nil {\n371\t\t\treturn nil, err\n372\t\t}\n373\t\treturn lines, nil\n374\t}\n375\t\n376\tfunc sortAndFilter(lines []string, opts options) []string {\n377\t\tkeyCmp := buildKeyCmp(opts)\n378\t\thasKeys := len(opts.keys) > 0\n379\t\tsortCmp := buildSortCmp(keyCmp, opts, hasKeys)\n380\t\n381\t\tif opts.stable {\n382\t\t\tslices.SortStableFunc(lines, sortCmp)\n383\t\t} else {\n384\t\t\tslices.SortFunc(lines, sortCmp)\n385\t\t}\n386\t\tif opts.unique {\n387\t\t\tlines = dedup(lines, keyCmp)\n388\t\t}\n389\t\treturn lines\n390\t}\n391\t\n392\tfunc buildSortCmp(\n393\t\tkeyCmp func(string, string) int, opts options, hasKeys bool,\n394\t) func(string, string) int {\n395\t\tcmp := keyCmp\n396\t\tif !opts.stable && (hasKeys || opts.mode != sortDefault) {\n397\t\t\trev := opts.reverse && hasKeys\n398\t\t\tcmp = withLastResort(keyCmp, rev)\n399\t\t}\n400\t\tif opts.reverse && !hasKeys {\n401\t\t\tinner := cmp\n402\t\t\tcmp = func(a, b string) int { return inner(b, a) }\n403\t\t}\n404\t\treturn cmp\n405\t}\n406\t\n407\tfunc withLastResort(\n408\t\tkeyCmp func(string, string) int, rev bool,\n409\t) func(string, string) int {\n410\t\treturn func(a, b string) int {\n411\t\t\tif r := keyCmp(a, b); r != 0 {\n412\t\t\t\treturn r\n413\t\t\t}\n414\t\t\tr := strings.Compare(a, b)\n415\t\t\tif rev {\n416\t\t\t\treturn -r\n417\t\t\t}\n418\t\t\treturn r\n419\t\t}\n420\t}\n421\t\n422\tfunc buildKeyCmp(opts options) func(string, string) int {\n423\t\tif len(opts.keys) > 0 {\n424\t\t\treturn buildKeysCmp(opts)\n425\t\t}\n426\t\tcmp := buildModeCmp(opts.mode)\n427\t\tif opts.ignoreBlanks {\n428\t\t\treturn func(a, b string) int {\n429\t\t\t\treturn cmp(strings.TrimLeft(a, \" \\t\"), strings.TrimLeft(b, \" \\t\"))\n430\t\t\t}\n431\t\t}\n432\t\treturn cmp\n433\t}\n434\t\n435\tfunc buildModeCmp(mode sortMode) func(string, string) int {\n436\t\tswitch mode {\n437\t\tcase sortHumanNumeric:\n438\t\t\treturn cmpFloat(parseHumanNumeric)\n439\t\tcase sortMonth:\n440\t\t\treturn func(a, b string) int { return monthRank(a) - monthRank(b) }\n441\t\tcase sortVersion:\n442\t\t\treturn compareVersion\n443\t\tcase sortNumeric:\n444\t\t\treturn cmpFloat(parseNumeric)\n445\t\tdefault:\n446\t\t\treturn strings.Compare\n447\t\t}\n448\t}\n449\t\n450\tfunc dedup(lines []string, cmp func(string, string) int) []string {\n451\t\tif len(lines) == 0 {\n452\t\t\treturn lines\n453\t\t}\n454\t\tresult := []string{lines[0]}\n455\t\tfor _, line := range lines[1:] {\n456\t\t\tif cmp(line, result[len(result)-1]) != 0 {\n457\t\t\t\tresult = append(result, line)\n458\t\t\t}\n459\t\t}\n460\t\treturn result\n461\t}\n462\t\n463\tfunc writeLines(lines []string, w io.Writer) {\n464\t\tbw := bufio.NewWriter(w)\n465\t\tfor _, line := range lines {\n466\t\t\tfmt.Fprintln(bw, line)\n467\t\t}\n468\t\tbw.Flush()\n469\t}\n470\t"}]},"parent_tool_use_id":null,"session_id":"18b9508f-37b1-4fd5-9c1e-be53a20fcc64","uuid":"1b1e51e9-8fdf-4fb8-86da-709b3776f722","timestamp":"2026-05-20T23:24:55.321Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5384/cmd/sort/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: sort [OPTION]... [FILE]...\nWrite sorted concatenation of all FILE(s) to standard output.\n\nWith no FILE, or when FILE is -, read standard input.\n\nMandatory arguments to long options are mandatory for short options too.\nOrdering options:\n\n  -b, --ignore-leading-blanks  ignore leading blanks\n  -h, --human-numeric-sort     compare human readable numbers (e.g., 2K 1G)\n  -M, --month-sort             compare (unknown) < 'JAN' < ... < 'DEC'\n  -n, --numeric-sort           compare according to string numerical value\n  -V, --version-sort           natural sort of (version) numbers within text\n  -r, --reverse                reverse the result of comparisons\n\nOther options:\n\n  -c, --check, --check=diagnose-first  check for sorted input; do not sort\n  -C, --check=quiet, --check=silent  like -c, but do not report first bad line\n  -k, --key=KEYDEF             sort via a key; KEYDEF gives location and type\n  -o, --output=FILE            write result to FILE instead of standard output\n  -s, --stable                 stabilize sort by disabling last-resort comparison\n  -t, --field-separator=SEP    use SEP instead of non-blank to blank transition\n  -u, --unique                 with -c, check for strict ordering;\n                                 without -c, output only the first of an equal run\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `sort (go-unix-utils) dev\n`\n\ntype sortMode int\n\nconst (\n\tsortDefault sortMode = iota\n\tsortNumeric\n\tsortHumanNumeric\n\tsortMonth\n\tsortVersion\n)\n\ntype checkMode int\n\nconst (\n\tcheckNone checkMode = iota\n\tcheckDiagnose\n\tcheckQuiet\n)\n\ntype options struct {\n\treverse        bool\n\tunique         bool\n\tstable         bool\n\tignoreBlanks   bool\n\tcheck          checkMode\n\tmode           sortMode\n\toutputFile     string\n\tfieldSeparator string\n\tkeys           []keyDef\n}\n\nvar monthMap = map[string]int{\n\t\"JAN\": 1, \"FEB\": 2, \"MAR\": 3, \"APR\": 4,\n\t\"MAY\": 5, \"JUN\": 6, \"JUL\": 7, \"AUG\": 8,\n\t\"SEP\": 9, \"OCT\": 10, \"NOV\": 11, \"DEC\": 12,\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'sort --help' for more information.\\n\")\n\t\tos.Exit(2)\n\t}\n\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\tif opts.check != checkNone {\n\t\tos.Exit(runCheck(files, opts))\n\t}\n\n\tlines, err := readAllLines(files)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\tos.Exit(2)\n\t}\n\n\tlines = sortAndFilter(lines, opts)\n\n\tvar w io.Writer = os.Stdout\n\tif opts.outputFile != \"\" {\n\t\tf, err := os.Create(opts.outputFile)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\t\tos.Exit(2)\n\t\t}\n\t\tdefer f.Close()\n\t\tw = f\n\t}\n\twriteLines(lines, w)\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar files []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, &opts, args[i+1:])\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\textra, err := parseShortFlags(arg[1:], &opts, args[i+1:])\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + extra\n\t\t\tcontinue\n\t\t}\n\t\tfiles = append(files, arg)\n\t\ti++\n\t}\n\n\treturn opts, files, nil\n}\n\nfunc parseLongPrefix(flag string, opts *options) (int, bool, error) {\n\tif v, ok := strings.CutPrefix(flag, \"--output=\"); ok {\n\t\topts.outputFile = v\n\t\treturn 1, true, nil\n\t}\n\tif v, ok := strings.CutPrefix(flag, \"--field-separator=\"); ok {\n\t\tif len(v) != 1 {\n\t\t\treturn 0, true, fmt.Errorf(\"multi-character tab '%s'\", v)\n\t\t}\n\t\topts.fieldSeparator = v\n\t\treturn 1, true, nil\n\t}\n\tif v, ok := strings.CutPrefix(flag, \"--key=\"); ok {\n\t\tkey, err := parseKeyDef(v)\n\t\tif err != nil {\n\t\t\treturn 0, true, err\n\t\t}\n\t\topts.keys = append(opts.keys, key)\n\t\treturn 1, true, nil\n\t}\n\tif v, ok := strings.CutPrefix(flag, \"--check=\"); ok {\n\t\tswitch v {\n\t\tcase \"diagnose-first\":\n\t\t\topts.check = checkDiagnose\n\t\tcase \"quiet\", \"silent\":\n\t\t\topts.check = checkQuiet\n\t\tdefault:\n\t\t\treturn 0, true, fmt.Errorf(\"invalid argument '%s' for '--check'\", v)\n\t\t}\n\t\treturn 1, true, nil\n\t}\n\treturn 0, false, nil\n}\n\nfunc parseLongFlag(flag string, opts *options, remaining []string) (int, error) {\n\tif n, handled, err := parseLongPrefix(flag, opts); handled {\n\t\treturn n, err\n\t}\n\tswitch flag {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase \"--reverse\":\n\t\topts.reverse = true\n\tcase \"--unique\":\n\t\topts.unique = true\n\tcase \"--stable\":\n\t\topts.stable = true\n\tcase \"--ignore-leading-blanks\":\n\t\topts.ignoreBlanks = true\n\tcase \"--numeric-sort\":\n\t\topts.mode = sortNumeric\n\tcase \"--human-numeric-sort\":\n\t\topts.mode = sortHumanNumeric\n\tcase \"--month-sort\":\n\t\topts.mode = sortMonth\n\tcase \"--version-sort\":\n\t\topts.mode = sortVersion\n\tcase \"--check\":\n\t\topts.check = checkDiagnose\n\tcase \"--output\", \"--field-separator\", \"--key\":\n\t\treturn parseLongWithArg(flag, opts, remaining)\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n\treturn 1, nil\n}\n\nfunc parseLongWithArg(flag string, opts *options, remaining []string) (int, error) {\n\tif len(remaining) == 0 {\n\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t}\n\tswitch flag {\n\tcase \"--output\":\n\t\topts.outputFile = remaining[0]\n\tcase \"--field-separator\":\n\t\tif len(remaining[0]) != 1 {\n\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n\t\t}\n\t\topts.fieldSeparator = remaining[0]\n\tcase \"--key\":\n\t\tkey, err := parseKeyDef(remaining[0])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.keys = append(opts.keys, key)\n\t}\n\treturn 2, nil\n}\n\nfunc parseShortFlags(flags string, opts *options, remaining []string) (int, error) {\n\tfor idx := 0; idx < len(flags); idx++ {\n\t\tswitch flags[idx] {\n\t\tcase 'r':\n\t\t\topts.reverse = true\n\t\tcase 'u':\n\t\t\topts.unique = true\n\t\tcase 's':\n\t\t\topts.stable = true\n\t\tcase 'b':\n\t\t\topts.ignoreBlanks = true\n\t\tcase 'n':\n\t\t\topts.mode = sortNumeric\n\t\tcase 'h':\n\t\t\topts.mode = sortHumanNumeric\n\t\tcase 'M':\n\t\t\topts.mode = sortMonth\n\t\tcase 'V':\n\t\t\topts.mode = sortVersion\n\t\tcase 'c':\n\t\t\topts.check = checkDiagnose\n\t\tcase 'C':\n\t\t\topts.check = checkQuiet\n\t\tcase 'o':\n\t\t\trest := flags[idx+1:]\n\t\t\tif rest != \"\" {\n\t\t\t\topts.outputFile = rest\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(remaining) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'o'\")\n\t\t\t}\n\t\t\topts.outputFile = remaining[0]\n\t\t\treturn 1, nil\n\t\tcase 't':\n\t\t\treturn parseFieldSep(flags[idx+1:], remaining, opts)\n\t\tcase 'k':\n\t\t\treturn parseKeyArg(flags[idx+1:], remaining, opts)\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[idx])\n\t\t}\n\t}\n\treturn 0, nil\n}\n\nfunc parseFieldSep(rest string, remaining []string, opts *options) (int, error) {\n\tif rest != \"\" {\n\t\tif len(rest) != 1 {\n\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", rest)\n\t\t}\n\t\topts.fieldSeparator = rest\n\t\treturn 0, nil\n\t}\n\tif len(remaining) == 0 {\n\t\treturn 0, fmt.Errorf(\"option requires an argument -- 't'\")\n\t}\n\tif len(remaining[0]) != 1 {\n\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n\t}\n\topts.fieldSeparator = remaining[0]\n\treturn 1, nil\n}\n\nfunc parseKeyArg(rest string, remaining []string, opts *options) (int, error) {\n\tif rest != \"\" {\n\t\tkey, err := parseKeyDef(rest)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.keys = append(opts.keys, key)\n\t\treturn 0, nil\n\t}\n\tif len(remaining) == 0 {\n\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'k'\")\n\t}\n\tkey, err := parseKeyDef(remaining[0])\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\topts.keys = append(opts.keys, key)\n\treturn 1, nil\n}\n\nfunc readAllLines(files []string) ([]string, error) {\n\tvar lines []string\n\tfor _, file := range files {\n\t\tr, closer, err := openInput(file)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfileLines, err := readLines(r)\n\t\tif closer != nil {\n\t\t\tcloser.Close()\n\t\t}\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tlines = append(lines, fileLines...)\n\t}\n\treturn lines, nil\n}\n\nfunc openInput(name string) (io.Reader, io.Closer, error) {\n\tif name == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc readLines(r io.Reader) ([]string, error) {\n\tvar lines []string\n\tscanner := bufio.NewScanner(r)\n\tfor scanner.Scan() {\n\t\tlines = append(lines, scanner.Text())\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\treturn nil, err\n\t}\n\treturn lines, nil\n}\n\nfunc sortAndFilter(lines []string, opts options) []string {\n\tkeyCmp := buildKeyCmp(opts)\n\thasKeys := len(opts.keys) > 0\n\tsortCmp := buildSortCmp(keyCmp, opts, hasKeys)\n\n\tif opts.stable {\n\t\tslices.SortStableFunc(lines, sortCmp)\n\t} else {\n\t\tslices.SortFunc(lines, sortCmp)\n\t}\n\tif opts.unique {\n\t\tlines = dedup(lines, keyCmp)\n\t}\n\treturn lines\n}\n\nfunc buildSortCmp(\n\tkeyCmp func(string, string) int, opts options, hasKeys bool,\n) func(string, string) int {\n\tcmp := keyCmp\n\tif !opts.stable && (hasKeys || opts.mode != sortDefault) {\n\t\trev := opts.reverse && hasKeys\n\t\tcmp = withLastResort(keyCmp, rev)\n\t}\n\tif opts.reverse && !hasKeys {\n\t\tinner := cmp\n\t\tcmp = func(a, b string) int { return inner(b, a) }\n\t}\n\treturn cmp\n}\n\nfunc withLastResort(\n\tkeyCmp func(string, string) int, rev bool,\n) func(string, string) int {\n\treturn func(a, b string) int {\n\t\tif r := keyCmp(a, b); r != 0 {\n\t\t\treturn r\n\t\t}\n\t\tr := strings.Compare(a, b)\n\t\tif rev {\n\t\t\treturn -r\n\t\t}\n\t\treturn r\n\t}\n}\n\nfunc buildKeyCmp(opts options) func(string, string) int {\n\tif len(opts.keys) > 0 {\n\t\treturn buildKeysCmp(opts)\n\t}\n\tcmp := buildModeCmp(opts.mode)\n\tif opts.ignoreBlanks {\n\t\treturn func(a, b string) int {\n\t\t\treturn cmp(strings.TrimLeft(a, \" \\t\"), strings.TrimLeft(b, \" \\t\"))\n\t\t}\n\t}\n\treturn cmp\n}\n\nfunc buildModeCmp(mode sortMode) func(string, string) int {\n\tswitch mode {\n\tcase sortHumanNumeric:\n\t\treturn cmpFloat(parseHumanNumeric)\n\tcase sortMonth:\n\t\treturn func(a, b string) int { return monthRank(a) - monthRank(b) }\n\tcase sortVersion:\n\t\treturn compareVersion\n\tcase sortNumeric:\n\t\treturn cmpFloat(parseNumeric)\n\tdefault:\n\t\treturn strings.Compare\n\t}\n}\n\nfunc dedup(lines []string, cmp func(string, string) int) []string {\n\tif len(lines) == 0 {\n\t\treturn lines\n\t}\n\tresult := []string{lines[0]}\n\tfor _, line := range lines[1:] {\n\t\tif cmp(line, result[len(result)-1]) != 0 {\n\t\t\tresult = append(result, line)\n\t\t}\n\t}\n\treturn result\n}\n\nfunc writeLines(lines []string, w io.Writer) {\n\tbw := bufio.NewWriter(w)\n\tfor _, line := range lines {\n\t\tfmt.Fprintln(bw, line)\n\t}\n\tbw.Flush()\n}\n","numLines":470,"startLine":1,"totalLines":470}}}
