manNumeric(b))\n\tcase sortMonth:\n\t\treturn monthRank(a) - monthRank(b)\n\tcase sortVersion:\n\t\treturn compareVersion(a, b)\n\tdefault:\n\t\treturn strings.Compare(a, b)\n\t}\n}\n","numLines":175,"startLine":1,"totalLines":175}}}
