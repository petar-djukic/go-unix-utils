)\n71\t\tchar := 0\n72\t\tif i < len(s) && s[i] == '.' {\n73\t\t\ti++\n74\t\t\tj := i\n75\t\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n76\t\t\t\ti++\n77\t\t\t}\n78\t\t\tif i > j {\n79\t\t\t\tchar, _ = strconv.Atoi(s[j:i])\n80\t\t\t}\n81\t\t}\n82\t\treturn field, char, s[i:], nil\n83\t}\n84\t\n85\tfunc applyKeyOpts(k *keyDef, opts string) error {\n86\t\tfor _, c := range opts {\n87\t\t\tswitch c {\n88\t\t\tcase 'b':\n89\t\t\t\tk.blanks = true\n90\t\t\tcase 'd':\n91\t\t\t\tk.dictOrder = true\n92\t\t\tcase 'f':\n93\t\t\t\tk.foldCase = true\n94\t\t\tcase 'i':\n95\t\t\t\tk.ignorePrint = true\n96\t\t\tcase 'n':\n97\t\t\t\tk.mode = sortNumeric\n98\t\t\tcase 'h':\n99\t\t\t\tk.mode = sortHumanNumeric\n100\t\t\tcase 'M':\n101\t\t\t\tk.mode = sortMonth\n102\t\t\tcase 'V':\n103\t\t\t\tk.mode = sortVersion\n104\t\t\tcase 'r':\n105\t\t\t\tk.reverse = true\n106\t\t\tdefault:\n107\t\t\t\treturn fmt.Errorf(\"invalid option for key: %c\", c)\n108\t\t\t}\n109\t\t}\n110\t\treturn nil\n111\t}\n112\t\n113\tfunc resolveKeyOpts(k keyDef, opts options) keyDef {\n114\t\tif k.hasOpts {\n115\t\t\treturn k\n116\t\t}\n117\t\tk.mode = opts.mode\n118\t\tk.reverse = opts.reverse\n119\t\tk.blanks = opts.ignoreBlanks\n120\t\treturn k\n121\t}\n122\t\n123\tfunc buildKeysCmp(opts options) func(string, string) int {\n124\t\tresolved := make([]keyDef, len(opts.keys))\n125\t\tfor i, k := range opts.keys {\n126\t\t\tresolved[i] = resolveKeyOpts(k, opts)\n127\t\t}\n128\t\tsep := opts.fieldSeparator\n129\t\treturn func(a, b string) int {\n130\t\t\tfor _, k := range resolved {\n131\t\t\t\tka := extractKey(a, k, sep)\n132\t\t\t\tkb := extractKey(b, k, sep)\n133\t\t\t\tka = filterKey(ka, k)\n134\t\t\t\tkb = filterKey(kb, k)\n135\t\t\t\tr := modeCompare(ka, kb, k.mode)\n136\t\t\t\tif k.reverse {\n137\t\t\t\t\tr = -r\n138\t\t\t\t}\n139\t\t\t\tif r != 0 {\n140\t\t\t\t\treturn r\n141\t\t\t\t}\n142\t\t\t}\n143\t\t\treturn 0\n144\t\t}\n145\t}\n146\t\n147\tfunc extractKey(line string, k keyDef, sep string) stri