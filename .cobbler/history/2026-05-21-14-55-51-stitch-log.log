t\t\t\t\tnormalizeBinaryName,\n192\t\t\t\t\tnormalizeErrCase,\n193\t\t\t\t},\n194\t\t\t},\n195\t\t}\n196\t\n197\t\trefDir1 := t.TempDir()\n198\t\tos.WriteFile(filepath.Join(refDir1, \"existing\"), []byte{}, 0644)\n199\t\trefDir2 := t.TempDir()\n200\t\tos.WriteFile(filepath.Join(refDir2, \"existing\"), []byte{}, 0644)\n201\t\n202\t\ttests = append(tests,\n203\t\t\ttestutils.DiffTest{\n204\t\t\t\tName:    \"reference file short flag\",\n205\t\t\t\tArgs:    []string{\"-r\", \"existing\", \"rfile\"},\n206\t\t\t\tWorkDir: refDir1,\n207\t\t\t\tExpectedFiles: map[string][]byte{\n208\t\t\t\t\t\"rfile\": {},\n209\t\t\t\t},\n210\t\t\t},\n211\t\t\ttestutils.DiffTest{\n212\t\t\t\tName:    \"reference file long flag\",\n213\t\t\t\tArgs:    []string{\"--reference=existing\", \"rfile2\"},\n214\t\t\t\tWorkDir: refDir2,\n215\t\t\t\tExpectedFiles: map[string][]byte{\n216\t\t\t\t\t\"rfile2\": {},\n217\t\t\t\t},\n218\t\t\t},\n219\t\t)\n220\t\n221\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n222\t}\n223\t\n224\tfunc TestCreateNewFile(t *testing.T) {\n225\t\tbin := testutils.BuildBinary(t, \".\")\n226\t\tdir := t.TempDir()\n227\t\tpath := filepath.Join(dir, \"newfile\")\n228\t\n229\t\tcmd := exec.Command(bin, path)\n230\t\tif err := cmd.Run(); err != nil {\n231\t\t\tt.Fatalf(\"touch failed: %v\", err)\n232\t\t}\n233\t\n234\t\tif _, err := os.Stat(path); err != nil {\n235\t\t\tt.Fatalf(\"file not created: %v\", err)\n236\t\t}\n237\t}\n238\t\n239\tfunc TestNoCreateSkipsCreation(t *testing.T) {\n240\t\tbin := testutils.BuildBinary(t, \".\")\n241\t\tdir := t.TempDir()\n242\t\tpath := filepath.Join(dir, \"absent\")\n243\t\n244\t\tcmd := exec.Command(bin, \"-c\", path)\n245\t\tif err := cmd.Run(); err != nil {\n246\t\t\tt.Fatalf(\"touch -c failed: %v\", err)\n247\t\t}\n248\t\n249\t\tif _, err := os.Stat(path); !os.IsNotExist(err) {\n250\t\t\tt.Fatalf(\"expected file to not exist, got: %v\", err)\n251\t\t}\n252\t}\n253\t\n254\tfunc TestMultipleFiles(t *testing.T) {\n255\t\tbin := testutils.BuildBinary(t, \".\")\n256\t\tdir := t.TempDir()\n257\t\n258\t\tpaths := []string{\n259\t\t\tfilepath.Join(dir, \"a\"),\n260\t\t\tfilepath.Join(dir, \"b\"),\n261\t\t\tfilepath.Join(dir, \"c\"),\n262\t\t}\n263\t\n264\t\tcmd := exec.Command(bin, paths...)\n265\t\tif err := cmd.Run(); err != nil {\n266\t\t\tt.Fatalf(\"touch failed: %v\", err)\n267\t\t}\n268\t\n269\t\tfor _, p := range paths {\n270\t\t\tif _, err := os.Stat(p); err != nil {\n271\t\t\t\tt.Fatalf(\"file %s not created: %v\", p, err)\n272\t\t\t}\n273\t\t}\n274\t}\n275\t\n276\tfunc TestAccessOnlyPreservesModTime(t *testing.T) {\n277\t\tbin := testutils.BuildBinary(t, \".\")\n278\t\tdir := t.TempDir()\n279\t\tpath := filepath.Join(dir, \"testfile\")\n280\t\n281\t\tos.WriteFile(path, []byte{}, 0644)\n282\t\tpast := time.Date(2020, 1, 1, 0, 0, 0, 0, time.Local)\n283\t\tos.Chtimes(path, past, past)\n284\t\n285\t\tcmd := exec.Command(bin, \"-a\", path)\n286\t\tif err := cmd.Run(); err != nil {\n287\t\t\tt.Fatalf(\"touch -a failed: %v\", err)\n288\t\t}\n289\t\n290\t\tinfo, err := sys.Stat(path)\n291\t\tif err != nil {\n292\t\t\tt.Fatalf(\"stat failed: %v\", err)\n293\t\t}\n294\t\tif time.Since(info.AccessTime) > 5*time.Second {\n295\t\t\tt.Errorf(\"access time not updated: %v\", info.AccessTime)\n296\t\t}\n297\t\tif !info.ModTime.Equal(past) {\n298\t\t\tt.Errorf(\"modification time changed: got %v, want %v\", info.ModTime, past)\n299\t\t}\n300\t}\n301\t\n302\tfunc TestModOnlyPreservesAccessTime(t *testing.T) {\n303\t\tbin := testutils.BuildBinary(t, \".\")\n304\t\tdir := t.TempDir()\n305\t\tpath := filepath.Join(dir, \"testfile\")\n306\t\n307\t\tos.WriteFile(path, []byte{}, 0644)\n308\t\tpast := time.Date(2020, 1, 1, 0, 0, 0, 0, time.Local)\n309\t\tos.Chtimes(path, past, past)\n310\t\n311\t\tcmd := exec.Command(bin, \"-m\", path)\n312\t\tif err := cmd.Run(); err != nil {\n313\t\t\tt.Fatalf(\"touch -m failed: %v\", err)\n314\t\t}\n315\t\n316\t\tinfo, err := sys.Stat(path)\n317\t\tif err != nil {\n318\t\t\tt.Fatalf(\"stat failed: %v\", err)\n319\t\t}\n320\t\tif !info.AccessTime.Equal(past) {\n321\t\t\tt.Errorf(\"access time changed: got %v, want %v\", info.AccessTime, past)\n322\t\t}\n323\t\tif time.Since(info.ModTime) > 5*time.Second {\n324\t\t\tt.Errorf(\"modification time not updated: %v\", info.ModTime)\n325\t\t}\n326\t}\n327\t\n328\tfunc TestExplicitTimestamp(t *testing.T) {\n329\t\tbin := testutils.BuildBinary(t, \".\")\n330\t\tdir := t.TempDir()\n331\t\tpath := filepath.Join(dir, \"testfile\")\n332\t\n333\t\tcmd := exec.Command(bin, \"-t\", \"202401151030.00\", path)\n334\t\tif err := cmd.Run(); err != nil {\n335\t\t\tt.Fatalf(\"touch -t failed: %v\", err)\n336\t\t}\n337\t\n338\t\tinfo, err := sys.Stat(path)\n339\t\tif err != nil {\n340\t\t\tt.Fatalf(\"stat failed: %v\", err)\n341\t\t}\n342\t\twant := time.Date(2024, 1, 15, 10, 30, 0, 0, time.Local)\n343\t\tif !info.AccessTime.Equal(want) {\n344\t\t\tt.Errorf(\"access time: got %v, want %v\", info.AccessTime, want)\n345\t\t}\n346\t\tif !info.ModTime.Equal(want) {\n347\t\t\tt.Errorf(\"modification time: got %v, want %v\", info.ModTime, want)\n348\t\t}\n349\t}\n350\t\n351\tfunc TestExplicitTimestampAccessOnly(t *testing.T) {\n352\t\tbin := testutils.BuildBinary(t, \".\")\n353\t\tdir := t.TempDir()\n354\t\tpath := filepath.Join(dir, \"testfile\")\n355\t\n356\t\tos.WriteFile(path, []byte{}, 0644)\n357\t\tpast := time.Date(2020, 6, 15, 12, 0, 0, 0, time.Local)\n358\t\tos.Chtimes(path, past, past)\n359\t\n360\t\tcmd := exec.Command(bin, \"-a\", \"-t\", \"202401151030.00\", path)\n361\t\tif err := cmd.Run(); err != nil {\n362\t\t\tt.Fatalf(\"touch -a -t failed: %v\", err)\n363\t\t}\n364\t\n365\t\tinfo, err := sys.Stat(path)\n366\t\tif err != nil {\n367\t\t\tt.Fatalf(\"stat failed: %v\", err)\n368\t\t}\n369\t\twantAccess := time.Date(2024, 1, 15, 10, 30, 0, 0, time.Local)\n370\t\tif !info.AccessTime.Equal(wantAccess) {\n371\t\t\tt.Errorf(\"access time: got %v, want %v\", info.AccessTime, wantAccess)\n372\t\t}\n373\t\tif !info.ModTime.Equal(past) {\n374\t\t\tt.Errorf(\"modification time changed: got %v, want %v\", info.ModTime, past)\n375\t\t}\n376\t}\n377\t\n378\tfunc TestExplicitTimestampModOnly(t *testing.T) {\n379\t\tbin := testutils.BuildBinary(t, \".\")\n380\t\tdir := t.TempDir()\n381\t\tpath := filepath.Join(dir, \"testfile\")\n382\t\n383\t\tos.WriteFile(path, []byte{}, 0644)\n384\t\tpast := time.Date(2020, 6, 15, 12, 0, 0, 0, time.Local)\n385\t\tos.Chtimes(path, past, past)\n386\t\n387\t\tcmd := exec.Command(bin, \"-m\", \"-t\", \"202401151030.00\", path)\n388\t\tif err := cmd.Run(); err != nil {\n389\t\t\tt.Fatalf(\"touch -m -t failed: %v\", err)\n390\t\t}\n391\t\n392\t\tinfo, err := sys.Stat(path)\n393\t\tif err != nil {\n394\t\t\tt.Fatalf(\"stat failed: %v\", err)\n395\t\t}\n396\t\twantMod := time.Date(2024, 1, 15, 10, 30, 0, 0, time.Local)\n397\t\tif !info.AccessTime.Equal(past) {\n398\t\t\tt.Errorf(\"access time changed: got %v, want %v\", info.AccessTime, past)\n399\t\t}\n400\t\tif !info.ModTime.Equal(wantMod) {\n401\t\t\tt.Errorf(\"modification time: got %v, want %v\", info.ModTime, wantMod)\n402\t\t}\n403\t}\n404\t\n405\tfunc TestReferenceFile(t *testing.T) {\n406\t\tbin := testutils.BuildBinary(t, \".\")\n407\t\tdir := t.TempDir()\n408\t\tref := filepath.Join(dir, \"ref\")\n409\t\ttarget := filepath.Join(dir, \"target\")\n410\t\n411\t\tos.WriteFile(ref, []byte{}, 0644)\n412\t\trefTime := time.Date(2023, 6, 15, 14, 30, 0, 0, time.Local)\n413\t\tos.Chtimes(ref, refTime, refTime)\n414\t\n415\t\tcmd := exec.Command(bin, \"-r\", ref, target)\n416\t\tif err := cmd.Run(); err != nil {\n417\t\t\tt.Fatalf(\"touch -r failed: %v\", err)\n418\t\t}\n419\t\n420\t\tinfo, err := sys.Stat(target)\n421\t\tif err != nil {\n422\t\t\tt.Fatalf(\"stat failed: %v\", err)\n423\t\t}\n424\t\tif !info.ModTime.Equal(refTime) {\n425\t\t\tt.Errorf(\"mod time: got %v, want %v\", info.ModTime, refTime)\n426\t\t}\n427\t}\n428\t\n429\tfunc TestMissingReferenceFile(t *testing.T) {\n430\t\tbin := testutils.BuildBinary(t, \".\")\n431\t\tdir := t.TempDir()\n432\t\ttarget := filepath.Join(dir, \"target\")\n433\t\n434\t\tcmd := exec.Command(bin, \"-r\", filepath.Join(dir, \"nosuchref\"), target)\n435\t\tif err := cmd.Run(); err == nil {\n436\t\t\tt.Fatal(\"expected error for missing reference file\")\n437\t\t}\n438\t}\n439\t\n440\tfunc TestDateString(t *testing.T) {\n441\t\tbin := testutils.BuildBinary(t, \".\")\n442\t\tdir := t.TempDir()\n443\t\tpath := filepath.Join(dir, \"dfile\")\n444\t\n445\t\tcmd := exec.Command(bin, \"-d\", \"2024-01-15 10:30:00\", path)\n446\t\tif err := cmd.Run(); err != nil {\n447\t\t\tt.Fatalf(\"touch -d failed: %v\", err)\n448\t\t}\n449\t\n450\t\tinfo, err := sys.Stat(path)\n451\t\tif err != nil {\n452\t\t\tt.Fatalf(\"stat failed: %v\", err)\n453\t\t}\n454\t\twant := time.Date(2024, 1, 15, 10, 30, 0, 0, time.Local)\n455\t\tif !info.AccessTime.Equal(want) {\n456\t\t\tt.Errorf(\"access time: got %v, want %v\", info.AccessTime, want)\n457\t\t}\n458\t\tif !info.ModTime.Equal(want) {\n459\t\t\tt.Errorf(\"modification time: got %v, want %v\", info.ModTime, want)\n460\t\t}\n461\t}\n462\t\n463\tfunc TestNoDereferenceSymlink(t *testing.T) {\n464\t\tbin := testutils.BuildBinary(t, \".\")\n465\t\tdir := t.TempDir()\n466\t\ttarget := filepath.Join(dir, \"target\")\n467\t\tlink := filepath.Join(dir, \"link\")\n468\t\n469\t\tos.WriteFile(target, []byte{}, 0644)\n470\t\tpast := time.Date(2020, 1, 1, 0, 0, 0, 0, time.Local)\n471\t\tos.Chtimes(target, past, past)\n472\t\tos.Symlink(target, link)\n473\t\n474\t\tstamp := \"2024-06-15 12:00:00\"\n475\t\tcmd := exec.Command(bin, \"-h\", \"-d\", stamp, link)\n476\t\tif err := cmd.Run(); err != nil {\n477\t\t\tt.Fatalf(\"touch -h -d failed: %v\", err)\n478\t\t}\n479\t\n480\t\ttargetInfo, err := sys.Stat(target)\n481\t\tif err != nil {\n482\t\t\tt.Fatalf(\"stat target failed: %v\", err)\n483\t\t}\n484\t\tif !targetInfo.ModTime.Equal(past) {\n485\t\t\tt.Errorf(\"target mod time changed: got %v, want %v\", targetInfo