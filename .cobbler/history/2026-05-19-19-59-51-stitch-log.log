ardStderr},\n\t\t},\n\t\t// R3.2: --strict --status with malformed lines exits 1\n\t\t{\n\t\t\tName:      \"strict-status-malformed\",\n\t\t\tArgs:      []string{\"--strict\", \"--check\", \"--status\", malformedChecksum},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R3.2: --strict with all valid entries\n\t\t{\n\t\t\tName:      \"strict-multi-valid\",\n\t\t\tArgs:      []string{\"--strict\", \"--check\", multiChecksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t}","originalFile":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha512\"\n\t\"encoding/hex\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gsha512sum\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttmpDir := t.TempDir()\n\thelloFile := filepath.Join(tmpDir, \"hello.txt\")\n\tif err := os.WriteFile(helloFile, []byte(\"hello\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\temptyFile := filepath.Join(tmpDir, \"empty.txt\")\n\tif err := os.WriteFile(emptyFile, []byte{}, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tdiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n\n\thelloHash := sha512hex([]byte(\"hello\\n\"))\n\temptyHash := sha512hex([]byte{})\n\tfakeHash := strings.Repeat(\"0\", 128)\n\n\tvalidChecksum := filepath.Join(tmpDir, \"valid.sha512\")\n\twriteFile(t, validChecksum, fmt.Sprintf(\"%s  %s\\n\", helloHash, helloFile))\n\n\tmultiChecksum := filepath.Join(tmpDir, \"multi.sha512\")\n\twriteFile(t, multiChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", helloHash, helloFile, emptyHash, emptyFile))\n\n\tmismatchChecksum := filepath.Join(tmpDir, \"mismatch.sha512\")\n\twriteFile(t, mismatchChecksum, fmt.Sprintf(\"%s  %s\\n\", fakeHash, helloFile))\n\n\tmixedChecksum := filepath.Join(tmpDir, \"mixed.sha512\")\n\twriteFile(t, mixedChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", helloHash, helloFile, fakeHash, emptyFile))\n\n\tmalformedChecksum := filepath.Join(tmpDir, \"malformed.sha512\")\n\twriteFile(t, malformedChecksum, fmt.Sprintf(\"this is not a checksum\\n%s  %s\\n\", helloHash, helloFile))\n\n\tbsdChecksum := filepath.Join(tmpDir, \"bsd.sha512\")\n\twriteFile(t, bsdChecksum, fmt.Sprintf(\"SHA512 (%s) = %s\\n\", helloFile, helloHash))\n\n\ttests := []testutils.DiffTest{\n\t\t// R1.2: stdin with no arguments\n\t\t{\n\t\t\tName:  \"stdin-no-args\",\n\t\t\tStdin: []byte(\"abc\"),\n\t\t},\n\t\t// R1.2: stdin with explicit \"-\"\n\t\t{\n\t\t\tName:  \"stdin-dash\",\n\t\t\tArgs:  []string{\"-\"},\n\t\t\tStdin: []byte(\"abc\"),\n\t\t},\n\t\t// R1.1: single file, text mode (default)\n\t\t{\n\t\t\tName: \"single-file-text\",\n\t\t\tArgs: []string{helloFile},\n\t\t},\n\t\t// R1.1: single file, binary mode\n\t\t{\n\t\t\tName: \"single-file-binary\",\n\t\t\tArgs: []string{\"-b\", helloFile},\n\t\t},\n\t\t// R1.3: BSD tag format\n\t\t{\n\t\t\tName: \"tag-format\",\n\t\t\tArgs: []string{\"--tag\", helloFile},\n\t\t},\n\t\t// R1.3: tag with binary flag\n\t\t{\n\t\t\tName: \"tag-with-binary\",\n\t\t\tArgs: []string{\"--tag\", \"-b\", helloFile},\n\t\t},\n\t\t// R1.1: multiple files\n\t\t{\n\t\t\tName: \"multiple-files\",\n\t\t\tArgs: []string{helloFile, emptyFile},\n\t\t},\n\t\t// R1.2: empty stdin\n\t\t{\n\t\t\tName:  \"empty-stdin\",\n\t\t\tStdin: []byte{},\n\t\t},\n\t\t// R1.1: empty file\n\t\t{\n\t\t\tName: \"empty-file\",\n\t\t\tArgs: []string{emptyFile},\n\t\t},\n\t\t// R1.4: missing file exits 1, prints error to stderr\n\t\t{\n\t\t\tName:      \"missing-file\",\n\t\t\tArgs:      []string{filepath.Join(tmpDir, \"nonexistent.txt\")},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: [