tch flag {\n\tcase \"--format\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\topts.format = rest[0]\n\t\treturn 1, nil\n\tcase \"--printf\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\topts.printf = rest[0]\n\t\treturn 1, nil\n\tcase \"--dereference\":\n\t\topts.dereference = true\n\tcase \"--file-system\":\n\t\topts.fileSystem = true\n\tcase \"--terse\":\n\t\topts.terse = true\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n\treturn 0, nil\n}\n\nfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n\tfor i, ch := range flags {\n\t\tswitch ch {\n\t\tcase 'L':\n\t\t\topts.dereference = true\n\t\tcase 'f':\n\t\t\topts.fileSystem = true\n\t\tcase 't':\n\t\t\topts.terse = true\n\t\tcase 'c':\n\t\t\tremaining := flags[i+1:]\n\t\t\tif remaining != \"\" {\n\t\t\t\topts.format = remaining\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(rest) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'c'\")\n\t\t\t}\n\t\t\topts.format = rest[0]\n\t\t\treturn 1, nil\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", ch)\n\t\t}\n\t}\n\treturn 0, nil\n}\n","structuredPatch":[{"oldStart":225,"oldLines":10,"newStart":225,"newLines":9,"lines":[" }"," "," func terseFS(fs *syscall.Statfs_t, path string) string {","-  typeName := int8ToStr(fs.Fstypename[:])","   fsid := fsIDHex(fs.Fsid)","-  return fmt.Sprintf(\"%s %s %d %s %d %d %d %d %d %d %d\",","-    path, fsid, nameMax(), typeName,","+  return fmt.Sprintf(\"%s %s ? %x %d %d %d %d %d %d %d\",","+    path, fsid, fs.Type,","     fs.Bsize, fs.Bsize,","     fs.Blocks, fs.Bfree, fs.Bavail,","     fs.Files, fs.Ffree)"]}],"userModified":false,"replaceAll":false}}
