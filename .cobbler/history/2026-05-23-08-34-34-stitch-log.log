oin(dir, \"testfile\")\n318\t\n319\t\tos.WriteFile(path, []byte{}, 0644)\n320\t\tpast := time.Date(2020, 1, 1, 0, 0, 0, 0, time.Local)\n321\t\tos.Chtimes(path, past, past)\n322\t\n323\t\tcmd := exec.Command(bin, \"-m\", path)\n324\t\tif err := cmd.Run(); err != nil {\n325\t\t\tt.Fatalf(\"touch -m failed: %v\", err)\n326\t\t}\n327\t\n328\t\tinfo, err := sys.Stat(path)\n329\t\tif err != nil {\n330\t\t\tt.Fatalf(\"stat failed: %v\", err)\n331\t\t}\n332\t\tif !info.AccessTime.Equal(past) {\n333\t\t\tt.Errorf(\"access time changed: got %v, want %v\", info.AccessTime, past)\n334\t\t}\n335\t\tif time.Since(info.ModTime) > 5*time.Second {\n336\t\t\tt.Errorf(\"modification time not updated: %v\", info.ModTime)\n337\t\t}\n338\t}\n339\t\n340\tfunc TestExplicitTimestamp(t *testing.T) {\n341\t\tbin := testutils.BuildBinary(t, \".\")\n342\t\tdir := t.TempDir()\n343\t\tpath := filepath.Join(dir, \"testfile\")\n344\t\n345\t\tcmd := exec.Command(bin, \"-t\", \"202401151030.00\", path)\n346\t\tif err := cmd.Run(); err != nil {\n347\t\t\tt.Fatalf(\"touch -t failed: %v\", err)\n348\t\t}\n349\t\n350\t\tinfo, err := sys.Stat(path)\n351\t\tif err != nil {\n352\t\t\tt.Fatalf(\"stat failed: %v\", err)\n353\t\t}\n354\t\twant := time.Date(2024, 1, 15, 10, 30, 0, 0, time.Local)\n355\t\tif !info.AccessTime.Equal(want) {\n356\t\t\tt.Errorf(\"access time: got %v, want %v\", info.AccessTime, want)\n357\t\t}\n358\t\tif !info.ModTime.Equal(want) {\n359\t\t\tt.Errorf(\"modification time: got %v, want %v\", info.ModTime, want)\n360\t\t}\n361\t}\n362\t\n363\tfunc TestExplicitTimestampAccessOnly(t *testing.T) {\n364\t\tbin := testutils.BuildBinary(t, \".\")\n365\t\tdir := t.TempDir()\n366\t\tpath := filepath.Join(dir, \"testfile\")\n367\t\n368\t\tos.WriteFile(path, []byte{}, 0644)\n369\t\tpast := time.Date(2020, 6, 15, 12, 0, 0, 0, time.Local)\n370\t\tos.Chtimes(path, past, past)\n371\t\n372\t\tcmd := exec.Command(bin, \"-a\", \"-t\", \"202401151030.00\", path)\n373\t\tif err := cmd.Run(); err != nil {\