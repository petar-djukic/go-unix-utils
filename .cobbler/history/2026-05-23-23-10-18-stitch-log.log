"nohup: ignoring input and appending output to '%s'\\n\", path)\n\treturn f, nil\n}\n\nfunc redirectStderr(outFile *os.File) {\n\tif outFile == nil || !sys.IsTerminal(os.Stderr.Fd()) {\n\t\treturn\n\t}\n\tos.Stderr = outFile\n}\n\nfunc exitFromError(err error, command string) {\n\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\tos.Exit(exitErr.ExitCode())\n\t}\n\tif isNotFound(err) {\n\t\tfmt.Fprintf(os.Stderr, \"nohup: failed to run command '%s': No such file or directory\\n\", command)\n\t\tos.Exit(127)\n\t}\n\tfmt.Fprintf(os.Stderr, \"nohup: failed to run command '%s': %s\\n\", command, err)\n\tos.Exit(126)\n}\n\nfunc isNotFound(err error) bool {\n\t_, lookErr := exec.LookPath(os.Args[1])\n\treturn lookErr != nil\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":122,"cache_read_input_tokens":24620,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":122},"output_tokens":59,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fa4a6316-c705-4442-a3d7-cd7eb24466a9","uuid":"64ebbf2e-9aa0-4f02-8190-8264f961dd58"}
