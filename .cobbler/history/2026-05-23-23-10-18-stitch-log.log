{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019uShWp7sfrFA4749g6jUz7","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd094-nice R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"syscall\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst helpText = `Usage: nice [OPTION] [COMMAND [ARG]...]\n19\tRun COMMAND with an adjusted niceness, which affects process scheduling.\n20\tWith no COMMAND, print the current niceness.  Niceness values range from\n21\t-20 (most favorable to the process) to 19 (least favorable to the process).\n22\t\n23\tMandatory arguments to long options are mandatory for short options too.\n24\t  -n, --adjustment=N   add integer N to the niceness (default 10)\n25\t      --help           display this help and exit\n26\t      --version        output version information and exit\n27\t`\n28\t\n29\tconst versionText = `nice (go-unix-utils) dev\n30\t`\n31\t\n32\tfunc main() {\n33\t\tsys.InstallSIGPIPEHandler()\n34\t\tadjustment, command, cmdArgs, err := parseArgs(os.Args[1:])\n35\t\tif err != nil {\n36\t\t\tfmt.Fprintf(os.Stderr, \"nice: %s\\n\", err)\n37\t\t\tos.Exit(125)\n38\t\t}\n39\t\n40\t\tif command == \"\" {\n41\t\t\tprio, err := syscall.Getpriority(syscall.PRIO_PROCESS, 0)\n42\t\t\tif err != nil {\n43\t\t\t\tfmt.Fprintf(os.Stderr, \"nice: cannot get niceness: %s\\n\", err)\n44\t\t\t\tos.Exit(125)\n45\t\t\t}\n46\t\t\tfmt.Println(prio)\n47\t\t\tos.Exit(0)\n48\t\t}\n49\t\n50\t\tprio, err := syscall.Getpriority(syscall.PRIO_PROCESS, 0)\n51\t\tif err != nil {\n52\t\t\tfmt.Fprintf(os.Stderr, \"nice: cannot get niceness: %s\\n\", err)\n53\t\t\tos.Exit(125)\n54\t\t}\n55\t\n56\t\tnewPrio := min(max(prio+adjustment, -20), 19)\n57\t\n58\t\tif err := syscall.Setpriority(syscall.PRIO_PROCESS, 0, newPrio); err != nil {\n59\t\t\tfmt.Fprintf(os.Stderr, \"nice: cannot set niceness: %s\\n\", err)\n60\t\t\tos.Exit(125)\n61\t\t}\n62\t\n63\t\tbinary, err := exec.LookPath(command)\n64\t\tif err != nil {\n65\t\t\tfmt.Fprintf(os.Stderr, \"nice: '%s': No such file or directory\\n\", command)\n66\t\t\tos.Exit(127)\n67\t\t}\n68\t\n69\t\targv := append([]string{command}, cmdArgs...)\n70\t\texecErr := syscall.Exec(binary, argv, os.Environ())\n71\t\tif execErr != nil {\n72\t\t\tfmt.Fprintf(os.Stderr, \"nice: '%s': %s\\n\", command, execErr)\n73\t\t\tos.Exit(126)\n74\t\t}\n75\t}\n76\t\n77\tfunc parseArgs(args []string) (int, string, []string, error) {\n78\t\tadjustment := 10\n79\t\tadjustmentSet := false\n80\t\ti := 0\n81\t\tfor i < len(args) {\n82\t\t\targ := args[i]\n83\t\t\tif arg == \"--\" {\n84\t\t\t\ti++\n85\t\t\t\tbreak\n86\t\t\t}\n87\t\t\tif strings.HasPrefix(arg, \"--adjustment=\") {\n88\t\t\t\tval := arg[13:]\n89\t\t\t\tn, err := strconv.Atoi(val)\n90\t\t\t\tif err != nil {\n91\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment '%s'\", val)\n92\t\t\t\t}\n93\t\t\t\tadjustment = n\n94\t\t\t\tadjustmentSet = true\n95\t\t\t\ti++\n96\t\t\t\tcontinue\n97\t\t\t}\n98\t\t\tif arg == \"--adjustment\" {\n99\t\t\t\tif i+1 >= len(args) {\n100\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"option '--adjustment' requires an argument\")\n101\t\t\t\t}\n102\t\t\t\tn, err := strconv.Atoi(args[i+1])\n103\t\t\t\tif err != nil {\n104\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment '%s'\", args[i+1])\n105\t\t\t\t}\n106\t\t\t\tadjustment = n\n107\t\t\t\tadjustmentSet = true\n108\t\t\t\ti += 2\n109\t\t\t\tcontinue\n110\t\t\t}\n111\t\t\tif arg == \"--help\" {\n112\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n113\t\t\t\tos.Exit(0)\n114\t\t\t}\n115\t\t\tif arg == \"--version\" {\n116\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n117\t\t\t\tos.Exit(0)\n118\t\t\t}\n119\t\t\tif len(arg) > 1 && arg[0] == '-' && !strings.HasPrefix(arg, \"--\") {\n120\t\t\t\tif arg[1] == 'n' {\n121\t\t\t\t\trest := arg[2:]\n122\t\t\t\t\tif rest != \"\" {\n123\t\t\t\t\t\tn, err := strconv.Atoi(rest)\n124\t\t\t\t\t\tif err != nil {\n125\t\t\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment '%s'\", rest)\n126\t\t\t\t\t\t}\n127\t\t\t\t\t\tadjustment = n\n128\t\t\t\t\t\tadjustmentSet = true\n129\t\t\t\t\t\ti++\n130\t\t\t\t\t\tcontinue\n131\t\t\t\t\t}\n132\t\t\t\t\tif i+1 >= len(args) {\n133\t\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"option requires an argument -- 'n'\")\n134\t\t\t\t\t}\n135\t\t\t\t\tn, err := strconv.Atoi(args[i+1])\n136\t\t\t\t\tif err != nil {\n137\t\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment '%s'\", args[i+1])\n138\t\t\t\t\t}\n139\t\t\t\t\tadjustment = n\n140\t\t\t\t\tadjustmentSet = true\n141\t\t\t\t\ti += 2\n142\t\t\t\t\tcontinue\n143\t\t\t\t}\n144\t\t\t\t// GNU nice treats -N as --adjustment=N for numeric N\n145\t\t\t\tif n, err := strconv.Atoi(arg[1:]); err == nil {\n146\t\t\t\t\tadjustment = n\n147\t\t\t\t\tadjustmentSet = true\n148\t\t\t\t\ti++\n149\t\t\t\t\tcontinue\n150\t\t\t\t}\n151\t\t\t\tbreak\n152\t\t\t}\n153\t\t\tbreak\n154\t\t}\n155\t\t_ = adjustmentSet\n156\t\n157\t\tif i >= len(args) {\n158\t\t\treturn adjustment, \"\", nil, nil\n159\t\t}\n160\t\tcommand := args[i]\n161\t\tcmdArgs := args[i+1:]\n162\t\treturn adjustment, command, cmdArgs, nil\n163\t}\n164\t"}]},"parent_tool_use_id":null,"session_id":"fa4a6316-c705-4442-a3d7-cd7eb24466a9","uuid":"0dfa860f-467c-409c-8636-01afb29fe9c3","timestamp":"2026-05-24T03:10:29.794Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5567/cmd/nice/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd094-nice R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: nice [OPTION] [COMMAND [ARG]...]\nRun COMMAND with an adjusted niceness, which affects process scheduling.\nWith no COMMAND, print the current niceness.  Niceness values range from\n-20 (most favorable to the process) to 19 (least favorable to the process).\n\nMandatory arguments to long options are mandatory for short options too.\n  -n, --adjustment=N   add integer N to the niceness (default 10)\n      --help           display this help and exit\n      --version        output version information and exit\n`\n\nconst versionText = `nice (go-unix-utils) dev\n`\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tadjustment, command, cmdArgs, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: %s\\n\", err)\n\t\tos.Exit(125)\n\t}\n\n\tif command == \"\" {\n\t\tprio, err := syscall.Getpriority(syscall.PRIO_PROCESS, 0)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"nice: cannot get niceness: %s\\n\", err)\n\t\t\tos.Exit(125)\n\t\t}\n\t\tfmt.Println(prio)\n\t\tos.Exit(0)\n\t}\n\n\tprio, err := syscall.Getpriority(syscall.PRIO_PROCESS, 0)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: cannot get niceness: %s\\n\", err)\n\t\tos.Exit(125)\n\t}\n\n\tnewPrio := min(max(prio+adjustment, -20), 19)\n\n\tif err := syscall.Setpriority(syscall.PRIO_PROCESS, 0, newPrio); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: cannot set niceness: %s\\n\", err)\n\t\tos.Exit(125)\n\t}\n\n\tbinary, err := exec.LookPath(command)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: '%s': No such file or directory\\n\", command)\n\t\tos.Exit(127)\n\t}\n\n\targv := append([]string{command}, cmdArgs...)\n\texecErr := syscall.Exec(binary, argv, os.Environ())\n\tif execErr != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: '%s': %s\\n\", command, execErr)\n\t\tos.Exit(126)\n\t}\n}\n\nfunc parseArgs(args []string) (int, string, []string, error) {\n\tadjustment := 10\n\tadjustmentSet := false\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ti++\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--adjustment=\") {\n\t\t\tval := arg[13:]\n\t\t\tn, err := strconv.Atoi(val)\n\t\t\tif err != nil {\n\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment '%s'\", val)\n\t\t\t}\n\t\t\tadjustment = n\n\t\t\tadjustmentSet = true\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--adjustment\" {\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"option '--adjustment' requires an argument\")\n\t\t\t}\n\t\t\tn, err := strconv.Atoi(args[i+1])\n\t\t\tif err != nil {\n\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment '%s'\", args[i+1])\n\t\t\t}\n\t\t\tadjustment = n\n\t\t\tadjustmentSet = true\n\t\t\ti += 2\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--help\" {\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\t}\n\t\tif arg == \"--version\" {\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' && !strings.HasPrefix(arg, \"--\") {\n\t\t\tif arg[1] == 'n' {\n\t\t\t\trest := arg[2:]\n\t\t\t\tif rest != \"\" {\n\t\t\t\t\tn, err := strconv.Atoi(rest)\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment '%s'\", rest)\n\t\t\t\t\t}\n\t\t\t\t\tadjustment = n\n\t\t\t\t\tadjustmentSet = true\n\t\t\t\t\ti++\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif i+1 >= len(args) {\n\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"option requires an argument -- 'n'\")\n\t\t\t\t}\n\t\t\t\tn, err := strconv.Atoi(args[i+1])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment '%s'\", args[i+1])\n\t\t\t\t}\n\t\t\t\tadjustment = n\n\t\t\t\tadjustmentSet = true\n\t\t\t\ti += 2\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// GNU nice treats -N as --adjustment=N for numeric N\n\t\t\tif n, err := strconv.Atoi(arg[1:]); err == nil {\n\t\t\t\tadjustment = n\n\t\t\t\tadjustmentSet = true\n\t\t\t\ti++\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tbreak\n\t}\n\t_ = adjustmentSet\n\n\tif i >= len(args) {\n\t\treturn adjustment, \"\", nil, nil\n\t}\n\tcommand := args[i]\n\tcmdArgs := args[i+1:]\n\treturn adjustment, command, cmdArgs, nil\n}\n","numLines":164,"startLine":1,"totalLines":164}}}
