intf(os.Stderr, \"env: '%s': %s\\n\", args[0], err)\n\t\tos.Exit(126)\n\t}\n}\n\nfunc isNotFound(err error) bool {\n\treturn errors.Is(err, exec.ErrNotFound) || errors.Is(err, syscall.ENOENT)\n}\n","numLines":128,"startLine":1,"totalLines":128}}}
