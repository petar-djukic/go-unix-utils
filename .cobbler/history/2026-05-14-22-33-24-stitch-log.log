th.Join(dir, \"nodir\", \"file\")}},\n135\t\t\t{Name: \"s-missing-last\", Args: []string{\"-s\", filepath.Join(dir, \"nonexistent\")}},\n136\t\t\t// R1.5: -s combined with -e\n137\t\t\t{Name: \"s-e-existing\", Args: []string{\"-s\", \"-e\", filepath.Join(dir, \"file.txt\")}},\n138\t\t\t{\n139\t\t\t\tName:      \"s-e-missing\",\n140\t\t\t\tArgs:      []string{\"-s\", \"-e\", filepath.Join(dir, \"nonexistent\")},\n141\t\t\t\tExitCode:  1,\n142\t\t\t\tNormalize: errNorm,\n143\t\t\t},\n144\t\t\t// R1.5: -s combined with -m\n145\t\t\t{Name: \"s-m-missing\", Args: []string{\"-s\", \"-m\", filepath.Join(dir, \"x\", \"y\")}},\n146\t\t\t// R1.5: long forms\n147\t\t\t{Name: \"strip-long\", Args: []string{\"--strip\", filepath.Join(dir, \"link\")}},\n148\t\t\t{Name: \"no-symlinks-long\", Args: []string{\"--no-symlinks\", filepath.Join(dir, \"link\")}},\n149\t\t\t// R2.1: --relative-to\n150\t\t\t{\n151\t\t\t\tName: \"relative-to-parent\",\n152\t\t\t\tArgs: []string{\"--relative-to=\" + dir, filepath.Join(dir, \"subdir\")},\n153\t\t\t},\n154\t\t\t{\n155\t\t\t\tName: \"relative-to-subdir\",\n156\t\t\t\tArgs: []string{\"--relative-to=\" + filepath.Join(dir, \"subdir\"), filepath.Join(dir, \"file.txt\")},\n157\t\t\t},\n158\t\t\t{\n159\t\t\t\tName: \"relative-to-space\",\n160\t\t\t\tArgs: []string{\"--relative-to\", dir, filepath.Join(dir, \"file.txt\")},\n161\t\t\t},\n162\t\t\t// R2.2: --relative-base\n163\t\t\t{\n164\t\t\t\tName: \"relative-base-under\",\n165\t\t\t\tArgs: []string{\"--relative-base=\" + dir, filepath.Join(dir, \"subdir\")},\n166\t\t\t},\n167\t\t\t{\n168\t\t\t\tName: \"relative-base-outside\",\n169\t\t\t\tArgs: []string{\"--relative-base=\" + filepath.Join(dir, \"subdir\"), filepath.Join(dir, \"file.txt\")},\n170\t\t\t},\n171\t\t\t{\n172\t\t\t\tName: \"relative-base-exact\",\n173\t\t\t\tArgs: []string{\"--relative-base=\" + dir, dir},\n174\t\t\t},\n175\t\t\t// R2.3: --relative-to + --relative-base combined\n176\t\t\t{\n177\t\t\t\tName: \"rel-to-and-base-under\",\n1