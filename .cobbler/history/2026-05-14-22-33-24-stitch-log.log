ring{\"LC_ALL=C\"}},\n41\t\t\t// R1.4: -e is a recognized flag, not literal\n42\t\t\t{Name: \"e-flag\", Args: []string{\"-e\", \"hello\"}, Env: []string{\"LC_ALL=C\"}},\n43\t\t\t// R1.4: -E is a recognized flag, not literal\n44\t\t\t{Name: \"E-flag\", Args: []string{\"-E\", \"hello\"}, Env: []string{\"LC_ALL=C\"}},\n45\t\t\t// R1.4: combined recognized flags\n46\t\t\t{Name: \"nE-combined\", Args: []string{\"-nE\", \"hello\"}, Env: []string{\"LC_ALL=C\"}},\n47\t\t\t{Name: \"ne-combined\", Args: []string{\"-ne\", \"hello\"}, Env: []string{\"LC_ALL=C\"}},\n48\t\t\t{Name: \"nEe-combined\", Args: []string{\"-nEe\", \"hello\"}, Env: []string{\"LC_ALL=C\"}},\n49\t\t\t// R1.4: mixed valid/invalid chars in flag → literal\n50\t\t\t{Name: \"mixed-flag-invalid\", Args: []string{\"-nz\", \"hello\"}, Env: []string{\"LC_ALL=C\"}},\n51\t\t\t{Name: \"mixed-flag-invalid2\", Args: []string{\"-en!\", \"hello\"}, Env: []string{\"LC_ALL=C\"}},\n52\t\t\t// R1.4: flag-like args after non-flag are literal\n53\t\t\t{Name: \"flag-after-arg\", Args: []string{\"hello\", \"-n\"}, Env: []string{\"LC_ALL=C\"}},\n54\t\t\t// R1.4: multiple flag args before operands\n55\t\t\t{Name: \"multiple-flag-args\", Args: []string{\"-n\", \"-e\", \"hello\"}, Env: []string{\"LC_ALL=C\"}},\n56\t\t\t// R1.4: --help is literal (echo does not process it)\n57\t\t\t{Name: \"help-literal\", Args: []string{\"--help\"}, Env: []string{\"LC_ALL=C\"}},\n58\t\t\t// R1.4: --version is literal\n59\t\t\t{Name: \"version-literal\", Args: []string{\"--version\"}, Env: []string{\"LC_ALL=C\"}},\n60\t\t\t// R1.1: empty string argument\n61\t\t\t{Name: \"empty-string\", Args: []string{\"\"}, Env: []string{\"LC_ALL=C\"}},\n62\t\t\t// R1.1: multiple empty strings\n63\t\t\t{Name: \"multiple-empty\", Args: []string{\"\", \"\"}, Env: []string{\"LC_ALL=C\"}},\n64\t\t\t// R1.1: argument with spaces\n65\t\t\t{Name: \"arg-with-spaces\", Args: []string{\"hello world\"}, Env: []string{\"LC_ALL=C\"}},\n66\t\t\t// escape sequences with -e\n67\t\t\