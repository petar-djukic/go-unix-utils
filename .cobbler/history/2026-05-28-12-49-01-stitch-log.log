itError\n\tif errors.As(err, &exitErr) {\n\t\treturn exitErr.ExitCode(), stdoutBuf.Bytes(), stderrBuf.Bytes()\n\t}\n\n\treturn 100, nil, nil\n}\n\nfunc shouldShowOutput(exitCode int, stderrMode bool, stderr []byte) bool {\n\tif exitCode != 0 {\n\t\treturn true\n\t}\n\treturn stderrMode && len(stderr) > 0\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1193,"cache_read_input_tokens":24294,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1193},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"68705226-65db-4758-9362-c780b1b078e9","uuid":"41bedbe0-2f71-4f04-bd75-fb4f87c602ce"}
