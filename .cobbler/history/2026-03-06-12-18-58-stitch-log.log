→  # --- seq: two arguments ---\n   283→  - name: seq_two_args\n   284→    description: \"seq 2 5 prints lines 2 through 5.\"\n   285→    inputs:\n   286→      args: [\"2\", \"5\"]\n   287→      stdin: \"\"\n   288→      env: [\"LC_ALL=C\"]\n   289→    normalization: none\n   290→    expected:\n   291→      exit_code: 0\n   292→      stdout: \"2\\n3\\n4\\n5\\n\"\n   293→      stderr: \"\"\n   294→    traces:\n   295→      - prd019-seq R1.1\n   296→\n   297→  # --- seq: three arguments ---\n   298→  - name: seq_three_args\n   299→    description: \"seq 1 2 10 prints odd numbers 1 through 9.\"\n   300→    inputs:\n   301→      args: [\"1\", \"2\", \"10\"]\n   302→      stdin: \"\"\n   303→      env: [\"LC_ALL=C\"]\n   304→    normalization: none\n   305→    expected:\n   306→      exit_code: 0\n   307→      stdout: \"1\\n3\\n5\\n7\\n9\\n\"\n   308→      stderr: \"\"\n   309→    traces:\n   310→      - prd019-seq R1.1\n   311→      - prd019-seq R1.2\n   312→\n   313→  # --- seq: descending ---\n   314→  - name: seq_descending\n   315→    description: \"seq 5 -1 1 prints 5, 4, 3, 2, 1.\"\n   316→    inputs:\n   317→      args: [\"5\", \"-1\", \"1\"]\n   318→      stdin: \"\"\n   319→      env: [\"LC_ALL=C\"]\n   320→    normalization: none\n   321→    expected:\n   322→      exit_code: 0\n   323→      stdout: \"5\\n4\\n3\\n2\\n1\\n\"\n   324→      stderr: \"\"\n   325→    traces:\n   326→      - prd019-seq R1.2\n   327→\n   328→  # --- seq: first equals last ---\n   329→  - name: seq_first_equals_last\n   330→    description: \"seq 3 3 prints exactly one number.\"\n   331→    inputs:\n   332→      args: [\"3\", \"3\"]\n   333→      stdin: \"\"\n   334→      env: [\"LC_ALL=C\"]\n   335→    normalization: none\n   336→    expected:\n   337→      exit_code: 0\n   338→      stdout: \"3\\n\"\n   339→      stderr: \"\"\n   340→    traces:\n   341→      - prd019-seq R1.3\n   342→\n   343→  # --- seq: empty sequence ---\n   344→  - name: seq_empty_ascending\n   345→    descript