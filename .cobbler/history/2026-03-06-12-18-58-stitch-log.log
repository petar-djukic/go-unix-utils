{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QRNj2XRdYB2bax32KjLiaP","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package testutils provides a differential testing harness for comparing\n     5→// Go binaries against GNU reference binaries (prd001-testutils).\n     6→package testutils\n     7→\n     8→import (\n     9→\t\"bytes\"\n    10→\t\"os\"\n    11→\t\"os/exec\"\n    12→\t\"path/filepath\"\n    13→\t\"testing\"\n    14→)\n    15→\n    16→// NormalizeFunc transforms output bytes before comparison.\n    17→type NormalizeFunc = func([]byte) []byte\n    18→\n    19→// DiffTest defines a single differential test case.\n    20→type DiffTest struct {\n    21→\tName          string\n    22→\tArgs          []string\n    23→\tStdin         []byte\n    24→\tEnv           []string\n    25→\tWorkDir       string\n    26→\tExitCode      int\n    27→\tNormalize     []NormalizeFunc\n    28→\tExpectedFiles map[string][]byte\n    29→}\n    30→\n    31→// BuildBinary compiles the Go package at dir and returns the path to the binary.\n    32→func BuildBinary(t *testing.T, dir string) string {\n    33→\tt.Helper()\n    34→\tbin := filepath.Join(t.TempDir(), \"testbin\")\n    35→\tcmd := exec.Command(\"go\", \"build\", \"-o\", bin, dir)\n    36→\tout, err := cmd.CombinedOutput()\n    37→\tif err != nil {\n    38→\t\tt.Fatalf(\"build failed: %s\\n%s\", err, out)\n    39→\t}\n    40→\treturn bin\n    41→}\n    42→\n    43→// RunDiffTests runs each test case against both binaries and compares outputs.\n    44→func RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n    45→\tt.Helper()\n    46→\tfor _, tc := range tests {\n    47→\t\tt.Run(tc.Name, func(t *testing.T) {\n    48→\t\t\tt.Parallel()\n    49→\t\t\tgoOut, goErr, goExit := runBinary(goBinary, tc)\n    50→\t\t\trefOut, refErr, refExit := runBinary(refBinary, tc)\n    51→\n    52→\t\t\tfor _, n := range tc.Normalize {\n    53→\t\t\t\tgoOut = n(goOut)\n    54→\t\t\t\trefOut = n(refOut)\n    55→\t\t\t\tgoErr = n(goErr)\n    56→\t\t\t\trefErr = n(refErr)\n    57→\t\t\t}\n    58→\n    59→\t\t\tif goExit != refExit {\n    60→\t\t\t\tt.Errorf(\"exit code: go=%d ref=%d\", goExit, refExit)\n    61→\t\t\t}\n    62→\t\t\tif !bytes.Equal(goOut, refOut) {\n    63→\t\t\t\tt.Errorf(\"stdout differs:\\ngo:  %q\\nref: %q\", goOut, refOut)\n    64→\t\t\t}\n    65→\t\t\tif !bytes.Equal(goErr, refErr) {\n    66→\t\t\t\tt.Errorf(\"stderr differs:\\ngo:  %q\\nref: %q\", goErr, refErr)\n    67→\t\t\t}\n    68→\t\t})\n    69→\t}\n    70→}\n    71→\n    72→// ComposeNormalizers chains multiple NormalizeFuncs into one.\n    73→func ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n    74→\treturn func(b []byte) []byte {\n    75→\t\tfor _, fn := range fns {\n    76→\t\t\tb = fn(b)\n    77→\t\t}\n    78→\t\treturn b\n    79→\t}\n    80→}\n    81→\n    82→// TimestampNormalizer replaces common timestamp patterns with a placeholder.\n    83→var TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n    84→\treturn b // placeholder for utilities that need timestamp normalization\n    85→}\n    86→\n    87→func runBinary(bin string, tc DiffTest) (stdout, stderr []byte, exitCode int) {\n    88→\tcmd := exec.Command(bin, tc.Args...)\n    89→\tif tc.Stdin != nil {\n    90→\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n    91→\t}\n    92→\tcmd.Env = append(os.Environ(), tc.Env...)\n    93→\tif tc.WorkDir != \"\" {\n    94→\t\tcmd.Dir = tc.WorkDir\n    95→\t}\n    96→\tvar outBuf, errBuf bytes.Buffer\n    97→\tcmd.Stdout = &outBuf\n    98→\tcmd.Stderr = &errBuf\n    99→\terr := cmd.Run()\n   100→\tif err != nil {\n   101→\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n   102→\t\t\texitCode = exitErr.ExitCode()\n   103→\t\t}\n   104→\t}\n   105→\treturn outBuf.Bytes(), errBuf.Bytes(), exitCode\n   106→}\n   107→"}]},"parent_tool_use_id":null,"session_id":"930bb9c0-57e2-4c3f-8188-10a0cdccbab8","uuid":"5fe871a1-151b-40b5-b7d0-c6e7bf35eba9","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/344/pkg/testutils/diff.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides a differential testing harness for comparing\n// Go binaries against GNU reference binaries (prd001-testutils).\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// NormalizeFunc transforms output bytes before comparison.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest defines a single differential test case.\ntype DiffTest struct {\n\tName          string\n\tArgs          []string\n\tStdin         []byte\n\tEnv           []string\n\tWorkDir       string\n\tExitCode      int\n\tNormalize     []NormalizeFunc\n\tExpectedFiles map[string][]byte\n}\n\n// BuildBinary compiles the Go package at dir and returns the path to the binary.\nfunc BuildBinary(t *testing.T, dir string) string {\n\tt.Helper()\n\tbin := filepath.Join(t.TempDir(), \"testbin\")\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", bin, dir)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tt.Fatalf(\"build failed: %s\\n%s\", err, out)\n\t}\n\treturn bin\n}\n\n// RunDiffTests runs each test case against both binaries and compares outputs.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tgoOut, goErr, goExit := runBinary(goBinary, tc)\n\t\t\trefOut, refErr, refExit := runBinary(refBinary, tc)\n\n\t\t\tfor _, n := range tc.Normalize {\n\t\t\t\tgoOut = n(goOut)\n\t\t\t\trefOut = n(refOut)\n\t\t\t\tgoErr = n(goErr)\n\t\t\t\trefErr = n(refErr)\n\t\t\t}\n\n\t\t\tif goExit != refExit {\n\t\t\t\tt.Errorf(\"exit code: go=%d ref=%d\", goExit, refExit)\n\t\t\t}\n\t\t\tif !bytes.Equal(goOut, refOut) {\n\t\t\t\tt.Errorf(\"stdout differs:\\ngo:  %q\\nref: %q\", goOut, refOut)\n\t\t\t}\n\t\t\tif !bytes.Equal(goErr, refErr) {\n\t\t\t\tt.Errorf(\"stderr differs:\\ngo:  %q\\nref: %q\", goErr, refErr)\n\t\t\t}\n\t\t})\n\t}\n}\n\n// ComposeNormalizers chains multiple NormalizeFuncs into one.\nfunc ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n\treturn func(b []byte) []byte {\n\t\tfor _, fn := range fns {\n\t\t\tb = fn(b)\n\t\t}\n\t\treturn b\n\t}\n}\n\n// TimestampNormalizer replaces common timestamp patterns with a placeholder.\nvar TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n\treturn b // placeholder for utilities that need timestamp normalization\n}\n\nfunc runBinary(bin string, tc DiffTest) (stdout, stderr []byte, exitCode int) {\n\tcmd := exec.Command(bin, tc.Args...)\n\tif tc.Stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n\t}\n\tcmd.Env = append(os.Environ(), tc.Env...)\n\tif tc.WorkDir != \"\" {\n\t\tcmd.Dir = tc.WorkDir\n\t}\n\tvar outBuf, errBuf bytes.Buffer\n\tcmd.Stdout = &outBuf\n\tcmd.Stderr = &errBuf\n\terr := cmd.Run()\n\tif err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\texitCode = exitErr.ExitCode()\n\t\t}\n\t}\n\treturn outBuf.Bytes(), errBuf.Bytes(), exitCode\n}\n","numLines":107,"startLine":1,"totalLines":107}}}
