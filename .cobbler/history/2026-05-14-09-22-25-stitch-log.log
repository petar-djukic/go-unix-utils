nc exitWithError(msg string) {\n65\t\tfmt.Fprintf(os.Stderr, \"seq: %s\\n\", msg)\n66\t\tfmt.Fprintf(os.Stderr, \"Try 'seq --help' for more information.\\n\")\n67\t\tos.Exit(1)\n68\t}\n69\t\n70\tfunc parseArgs(args []string) (options, []string, error) {\n71\t\topts := options{separator: \"\\n\"}\n72\t\tvar operands []string\n73\t\ti := 0\n74\t\tfor i < len(args) {\n75\t\t\targ := args[i]\n76\t\t\tif arg == \"--\" {\n77\t\t\t\toperands = append(operands, args[i+1:]...)\n78\t\t\t\tbreak\n79\t\t\t}\n80\t\t\tif strings.HasPrefix(arg, \"--\") {\n81\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n82\t\t\t\tif err != nil {\n83\t\t\t\t\treturn opts, nil, err\n84\t\t\t\t}\n85\t\t\t\ti += n\n86\t\t\t\tcontinue\n87\t\t\t}\n88\t\t\tif len(arg) > 1 && arg[0] == '-' && !isNumStart(arg) {\n89\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n90\t\t\t\tif err != nil {\n91\t\t\t\t\treturn opts, nil, err\n92\t\t\t\t}\n93\t\t\t\ti += 1 + n\n94\t\t\t\tcontinue\n95\t\t\t}\n96\t\t\toperands = append(operands, arg)\n97\t\t\ti++\n98\t\t}\n99\t\tif len(operands) == 0 {\n100\t\t\treturn opts, nil, fmt.Errorf(\"missing operand\")\n101\t\t}\n102\t\tif len(operands) > 3 {\n103\t\t\treturn opts, nil, fmt.Errorf(\"extra operand '%s'\", operands[3])\n104\t\t}\n105\t\treturn opts, operands, nil\n106\t}\n107\t\n108\tfunc isNumStart(s string) bool {\n109\t\tif len(s) < 2 {\n110\t\t\treturn false\n111\t\t}\n112\t\tc := s[1]\n113\t\treturn c == '.' || (c >= '0' && c <= '9')\n114\t}\n115\t\n116\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n117\t\tswitch {\n118\t\tcase flag == \"--help\":\n119\t\t\tfmt.Fprint(os.Stdout, helpText)\n120\t\t\tos.Exit(0)\n121\t\t\treturn 0, nil\n122\t\tcase flag == \"--version\":\n123\t\t\tfmt.Fprint(os.Stdout, versionText)\n124\t\t\tos.Exit(0)\n125\t\t\treturn 0, nil\n126\t\tcase flag == \"--format\":\n127\t\t\tif len(remaining) < 2 {\n128\t\t\t\treturn 0, fmt.Errorf(\"option '--format' requires an argument\")\n129\t\t