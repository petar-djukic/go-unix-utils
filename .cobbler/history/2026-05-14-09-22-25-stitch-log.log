rands(args []string) (first, incr, last float64, err error) {\n190\t\tswitch len(args) {\n191\t\tcase 1:\n192\t\t\tlast, err = parseNumber(args[0])\n193\t\t\tif err != nil {\n194\t\t\t\treturn 0, 0, 0, err\n195\t\t\t}\n196\t\t\treturn 1, 1, last, nil\n197\t\tcase 2:\n198\t\t\tfirst, err = parseNumber(args[0])\n199\t\t\tif err != nil {\n200\t\t\t\treturn 0, 0, 0, err\n201\t\t\t}\n202\t\t\tlast, err = parseNumber(args[1])\n203\t\t\tif err != nil {\n204\t\t\t\treturn 0, 0, 0, err\n205\t\t\t}\n206\t\t\treturn first, 1, last, nil\n207\t\tdefault:\n208\t\t\tfirst, err = parseNumber(args[0])\n209\t\t\tif err != nil {\n210\t\t\t\treturn 0, 0, 0, err\n211\t\t\t}\n212\t\t\tincr, err = parseNumber(args[1])\n213\t\t\tif err != nil {\n214\t\t\t\treturn 0, 0, 0, err\n215\t\t\t}\n216\t\t\tlast, err = parseNumber(args[2])\n217\t\t\tif err != nil {\n218\t\t\t\treturn 0, 0, 0, err\n219\t\t\t}\n220\t\t\treturn first, incr, last, nil\n221\t\t}\n222\t}\n223\t\n224\tfunc parseNumber(s string) (float64, error) {\n225\t\tn, err := strconv.ParseFloat(s, 64)\n226\t\tif err != nil {\n227\t\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n228\t\t}\n229\t\tif math.IsNaN(n) || math.IsInf(n, 0) {\n230\t\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n231\t\t}\n232\t\treturn n, nil\n233\t}\n234\t\n235\tfunc validateFormat(format string) error {\n236\t\tcount := 0\n237\t\ti := 0\n238\t\tfor i < len(format) {\n239\t\t\tif format[i] != '%' {\n240\t\t\t\ti++\n241\t\t\t\tcontinue\n242\t\t\t}\n243\t\t\ti++\n244\t\t\tif i >= len(format) {\n245\t\t\t\tbreak\n246\t\t\t}\n247\t\t\tif format[i] == '%' {\n248\t\t\t\ti++\n249\t\t\t\tcontinue\n250\t\t\t}\n251\t\t\tfor i < len(format) && strings.ContainsRune(\"-+#0 '\", rune(format[i])) {\n252\t\t\t\ti++\n253\t\t\t}\n254\t\t\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n255\t\t\t\ti++\n256\t\t\t}\n257\t\t\tif i < len(format) && format[i] == '.' {\n258\t\t\t\ti++\n259\t\t\t\tfor i < len(format) && for