nd(r io.Reader, w io.Writer, n int64) error {\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tend := int64(len(data)) - n\n\tif end <= 0 {\n\t\treturn nil\n\t}\n\t_, err = w.Write(data[:end])\n\treturn err\n}\n","structuredPatch":[{"oldStart":266,"oldLines":19,"newStart":266,"newLines":12,"lines":["   return n, nil"," }"," ","-func processFile(opts options, name string) error {","-  r, closer, err := openInput(name)","-  if err != nil {","-    return err","-  }","-  if closer != nil {","-    defer closer.Close()","-  }","+func processInput(opts options, r io.Reader, w io.Writer) error {","   switch opts.mode {","   case modeBytes:","-    return headBytes(r, os.Stdout, opts.count)","+    return headBytes(r, w, opts.count)","   default:","-    return headLines(r, os.Stdout, opts.count)","+    return headLines(r, w, opts.count)","   }"," }"," "]}],"userModified":false,"replaceAll":false}}
