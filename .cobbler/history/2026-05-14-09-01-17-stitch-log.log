{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014WJMsThkvVxgzLB3KD3TZH","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst helpText = `Usage: head [OPTION]... [FILE]...\n19\tPrint the first 10 lines of each FILE to standard output.\n20\tWith more than one FILE, precede each with a header giving the file name.\n21\t\n22\tWith no FILE, or when FILE is -, read standard input.\n23\t\n24\tMandatory arguments to long options are mandatory for short options too.\n25\t  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n26\t                             with the leading '-', print all but the last\n27\t                             NUM bytes of each file\n28\t  -n, --lines=[-]NUM       output the first NUM lines instead of the first 10;\n29\t                             with the leading '-', output all but the last\n30\t                             NUM lines of each file\n31\t  -q, --quiet, --silent    never print headers giving file names\n32\t  -v, --verbose            always print headers giving file names\n33\t      --help        display this help and exit\n34\t      --version     output version information and exit\n35\t`\n36\t\n37\tconst versionText = `head (go-unix-utils) dev\n38\t`\n39\t\n40\ttype countMode int\n41\t\n42\tconst (\n43\t\tmodeLines countMode = iota\n44\t\tmodeBytes\n45\t)\n46\t\n47\ttype headerMode int\n48\t\n49\tconst (\n50\t\theaderAuto headerMode = iota\n51\t\theaderAlways\n52\t\theaderNever\n53\t)\n54\t\n55\ttype options struct {\n56\t\tmode   countMode\n57\t\tcount  int64\n58\t\theader headerMode\n59\t}\n60\t\n61\tfunc main() {\n62\t\tsys.InstallSIGPIPEHandler()\n63\t\n64\t\topts, files, err := parseArgs(os.Args[1:])\n65\t\tif err != nil {\n66\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n67\t\t\tfmt.Fprintf(os.Stderr, \"Try 'head --help' for more information.\\n\")\n68\t\t\tos.Exit(1)\n69\t\t}\n70\t\n71\t\tif len(files) == 0 {\n72\t\t\tfiles = []string{\"-\"}\n73\t\t}\n74\t\n75\t\tshowHeaders := opts.header == headerAlways ||\n76\t\t\t(opts.header == headerAuto && len(files) > 1)\n77\t\n78\t\texitCode := 0\n79\t\tfor i, file := range files {\n80\t\t\tif showHeaders {\n81\t\t\t\tprintHeader(file, i > 0)\n82\t\t\t}\n83\t\t\tif err := processFile(opts, file); err != nil {\n84\t\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n85\t\t\t\texitCode = 1\n86\t\t\t}\n87\t\t}\n88\t\tif exitCode != 0 {\n89\t\t\tos.Exit(exitCode)\n90\t\t}\n91\t}\n92\t\n93\tfunc printHeader(name string, needsBlank bool) {\n94\t\tif needsBlank {\n95\t\t\tfmt.Fprintln(os.Stdout)\n96\t\t}\n97\t\tfmt.Fprintf(os.Stdout, \"==> %s <==\\n\", name)\n98\t}\n99\t\n100\tfunc parseArgs(args []string) (options, []string, error) {\n101\t\topts := options{count: 10}\n102\t\tvar files []string\n103\t\n104\t\ti := 0\n105\t\tfor i < len(args) {\n106\t\t\targ := args[i]\n107\t\t\tif arg == \"--\" {\n108\t\t\t\tfiles = append(files, args[i+1:]...)\n109\t\t\t\tbreak\n110\t\t\t}\n111\t\t\tif strings.HasPrefix(arg, \"--\") {\n112\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n113\t\t\t\tif err != nil {\n114\t\t\t\t\treturn opts, nil, err\n115\t\t\t\t}\n116\t\t\t\ti += n\n117\t\t\t\tcontinue\n118\t\t\t}\n119\t\t\tif len(arg) > 1 && arg[0] == '-' {\n120\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n121\t\t\t\tif err != nil {\n122\t\t\t\t\treturn opts, nil, err\n123\t\t\t\t}\n124\t\t\t\ti += 1 + n\n125\t\t\t\tcontinue\n126\t\t\t}\n127\t\t\tfiles = append(files, arg)\n128\t\t\ti++\n129\t\t}\n130\t\n131\t\treturn opts, files, nil\n132\t}\n133\t\n134\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n135\t\tswitch {\n136\t\tcase flag == \"--help\":\n137\t\t\tfmt.Fprint(os.Stdout, helpText)\n138\t\t\tos.Exit(0)\n139\t\t\treturn 0, nil\n140\t\tcase flag == \"--version\":\n141\t\t\tfmt.Fprint(os.Stdout, versionText)\n142\t\t\tos.Exit(0)\n143\t\t\treturn 0, nil\n144\t\tcase flag == \"--lines\":\n145\t\t\tif len(remaining) < 2 {\n146\t\t\t\treturn 0, fmt.Errorf(\"option '--lines' requires an argument\")\n147\t\t\t}\n148\t\t\tcount, err := parseLineCount(remaining[1])\n149\t\t\tif err != nil {\n150\t\t\t\treturn 0, err\n151\t\t\t}\n152\t\t\topts.count = count\n153\t\t\topts.mode = modeLines\n154\t\t\treturn 2, nil\n155\t\tcase strings.HasPrefix(flag, \"--lines=\"):\n156\t\t\tcount, err := parseLineCount(flag[len(\"--lines=\"):])\n157\t\t\tif err != nil {\n158\t\t\t\treturn 0, err\n159\t\t\t}\n160\t\t\topts.count = count\n161\t\t\topts.mode = modeLines\n162\t\t\treturn 1, nil\n163\t\tcase flag == \"--bytes\":\n164\t\t\tif len(remaining) < 2 {\n165\t\t\t\treturn 0, fmt.Errorf(\"option '--bytes' requires an argument\")\n166\t\t\t}\n167\t\t\tcount, err := parseByteCount(remaining[1])\n168\t\t\tif err != nil {\n169\t\t\t\treturn 0, err\n170\t\t\t}\n171\t\t\topts.count = count\n172\t\t\topts.mode = modeBytes\n173\t\t\treturn 2, nil\n174\t\tcase strings.HasPrefix(flag, \"--bytes=\"):\n175\t\t\tcount, err := parseByteCount(flag[len(\"--bytes=\"):])\n176\t\t\tif err != nil {\n177\t\t\t\treturn 0, err\n178\t\t\t}\n179\t\t\topts.count = count\n180\t\t\topts.mode = modeBytes\n181\t\t\treturn 1, nil\n182\t\tcase flag == \"--quiet\" || flag == \"--silent\":\n183\t\t\topts.header = headerNever\n184\t\t\treturn 1, nil\n185\t\tcase flag == \"--verbose\":\n186\t\t\topts.header = headerAlways\n187\t\t\treturn 1, nil\n188\t\tdefault:\n189\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n190\t\t}\n191\t}\n192\t\n193\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n194\t\tconsumed := 0\n195\t\tfor j := 0; j < len(flags); j++ {\n196\t\t\tswitch flags[j] {\n197\t\t\tcase 'n':\n198\t\t\t\tvar val string\n199\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n200\t\t\t\t\tval = rest\n201\t\t\t\t} else if len(remaining) > consumed {\n202\t\t\t\t\tval = remaining[consumed]\n203\t\t\t\t\tconsumed++\n204\t\t\t\t} else {\n205\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'n'\")\n206\t\t\t\t}\n207\t\t\t\tcount, err := parseLineCount(val)\n208\t\t\t\tif err != nil {\n209\t\t\t\t\treturn 0, err\n210\t\t\t\t}\n211\t\t\t\topts.count = count\n212\t\t\t\topts.mode = modeLines\n213\t\t\t\treturn consumed, nil\n214\t\t\tcase 'c':\n215\t\t\t\tvar val string\n216\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n217\t\t\t\t\tval = rest\n218\t\t\t\t} else if len(remaining) > consumed {\n219\t\t\t\t\tval = remaining[consumed]\n220\t\t\t\t\tconsumed++\n221\t\t\t\t} else {\n222\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'c'\")\n223\t\t\t\t}\n224\t\t\t\tcount, err := parseByteCount(val)\n225\t\t\t\tif err != nil {\n226\t\t\t\t\treturn 0, err\n227\t\t\t\t}\n228\t\t\t\topts.count = count\n229\t\t\t\topts.mode = modeBytes\n230\t\t\t\treturn consumed, nil\n231\t\t\tcase 'q':\n232\t\t\t\topts.header = headerNever\n233\t\t\tcase 'v':\n234\t\t\t\topts.header = headerAlways\n235\t\t\tdefault:\n236\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n237\t\t\t}\n238\t\t}\n239\t\treturn consumed, nil\n240\t}\n241\t\n242\tfunc parseLineCount(s string) (int64, error) {\n243\t\tn, err := strconv.ParseInt(s, 10, 64)\n244\t\tif err != nil {\n245\t\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n246\t\t}\n247\t\treturn n, nil\n248\t}\n249\t\n250\tfunc parseByteCount(s string) (int64, error) {\n251\t\tn, err := sizeparse.ParseWithOptions(s, sizeparse.ParseOptions{AllowSign: true})\n252\t\tif err != nil {\n253\t\t\treturn 0, fmt.Errorf(\"invalid number of bytes: '%s'\", s)\n254\t\t}\n255\t\treturn n, nil\n256\t}\n257\t\n258\tfunc processFile(opts options, name string) error {\n259\t\tr, closer, err := openInput(name)\n260\t\tif err != nil {\n261\t\t\treturn err\n262\t\t}\n263\t\tif closer != nil {\n264\t\t\tdefer closer.Close()\n265\t\t}\n266\t\tswitch opts.mode {\n267\t\tcase modeBytes:\n268\t\t\treturn headBytes(r, os.Stdout, opts.count)\n269\t\tdefault:\n270\t\t\treturn headLines(r, os.Stdout, opts.count)\n271\t\t}\n272\t}\n273\t\n274\tfunc openInput(name string) (io.Reader, io.Closer, error) {\n275\t\tif name == \"-\" {\n276\t\t\treturn os.Stdin, nil, nil\n277\t\t}\n278\t\tf, err := os.Open(name)\n279\t\tif err != nil {\n280\t\t\treturn nil, nil, err\n281\t\t}\n282\t\treturn f, f, nil\n283\t}\n284\t\n285\tfunc headLines(r io.Reader, w io.Writer, count int64) error {\n286\t\tif count == 0 {\n287\t\t\treturn nil\n288\t\t}\n289\t\tif count < 0 {\n290\t\t\treturn headLinesFromEnd(r, w, -count)\n291\t\t}\n292\t\treturn headLinesFromStart(r, w, count)\n293\t}\n294\t\n295\tfunc headLinesFromStart(r io.Reader, w io.Writer, n int64) error {\n296\t\tbr := bufio.NewReader(r)\n297\t\tfor range n {\n298\t\t\tline, err := br.ReadBytes('\\n')\n299\t\t\tif len(line) > 0 {\n300\t\t\t\tif _, werr := w.Write(line); werr != nil {\n301\t\t\t\t\treturn werr\n302\t\t\t\t}\n303\t\t\t}\n304\t\t\tif err != nil {\n305\t\t\t\treturn nil\n306\t\t\t}\n307\t\t}\n308\t\treturn nil\n309\t}\n310\t\n311\tfunc headLinesFromEnd(r io.Reader, w io.Writer, n int64) error {\n312\t\tbr := bufio.NewReader(r)\n313\t\tvar lines [][]byte\n314\t\tfor {\n315\t\t\tline, err := br.ReadBytes('\\n')\n316\t\t\tif len(line) > 0 {\n317\t\t\t\tlines = append(lines, line)\n318\t\t\t}\n319\t\t\tif err != nil {\n320\t\t\t\tbreak\n321\t\t\t}\n322\t\t}\n323\t\tend := max(int64(len(lines))-n, 0)\n324\t\tfor i := range end {\n325\t\t\tif _, err := w.Write(lines[i]); err != nil {\n326\t\t\t\treturn err\n327\t\t\t}\n328\t\t}\n329\t\treturn nil\n330\t}\n331\t\n332\tfunc headBytes(r io.Reader, w io.Writer, count int64) error {\n333\t\tif count == 0 {\n334\t\t\treturn nil\n335\t\t}\n336\t\tif count < 0 {\n337\t\t\treturn headBytesFromEnd(r, w, -count)\n338\t\t}\n339\t\treturn headBytesFromStart(r, w, count)\n340\t}\n341\t\n342\tfunc headBytesFromStart(r io.Reader, w io.Writer, n int64) error {\n343\t\t_, err := io.CopyN(w, r, n)\n344\t\tif err == io.EOF {\n345\t\t\treturn nil\n346\t\t}\n347\t\treturn err\n348\t}\n349\t\n350\tfunc headBytesFromEnd(r io.Reader, w io.Writer, n int64) error {\n351\t\tdata, err := io.ReadAll(r)\n352\t\tif err != nil {\n353\t\t\treturn err\n354\t\t}\n355\t\tend := int64(len(data)) - n\n356\t\tif end <= 0 {\n357\t\t\treturn nil\n358\t\t}\n359\t\t_, err = w.Write(data[:end])\n360\t\treturn err\n361\t}\n362\t"}]},"parent_tool_use_id":null,"session_id":"ac5c514a-d7b4-4970-b2d6-f9c57484d14e","uuid":"67da6366-9ca5-4d79-9867-2bccb8f7cf35","timestamp":"2026-05-14T13:01:28.551Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5167/cmd/head/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: head [OPTION]... [FILE]...\nPrint the first 10 lines of each FILE to standard output.\nWith more than one FILE, precede each with a header giving the file name.\n\nWith no FILE, or when FILE is -, read standard input.\n\nMandatory arguments to long options are mandatory for short options too.\n  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n                             with the leading '-', print all but the last\n                             NUM bytes of each file\n  -n, --lines=[-]NUM       output the first NUM lines instead of the first 10;\n                             with the leading '-', output all but the last\n                             NUM lines of each file\n  -q, --quiet, --silent    never print headers giving file names\n  -v, --verbose            always print headers giving file names\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `head (go-unix-utils) dev\n`\n\ntype countMode int\n\nconst (\n\tmodeLines countMode = iota\n\tmodeBytes\n)\n\ntype headerMode int\n\nconst (\n\theaderAuto headerMode = iota\n\theaderAlways\n\theaderNever\n)\n\ntype options struct {\n\tmode   countMode\n\tcount  int64\n\theader headerMode\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'head --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\tshowHeaders := opts.header == headerAlways ||\n\t\t(opts.header == headerAuto && len(files) > 1)\n\n\texitCode := 0\n\tfor i, file := range files {\n\t\tif showHeaders {\n\t\t\tprintHeader(file, i > 0)\n\t\t}\n\t\tif err := processFile(opts, file); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc printHeader(name string, needsBlank bool) {\n\tif needsBlank {\n\t\tfmt.Fprintln(os.Stdout)\n\t}\n\tfmt.Fprintf(os.Stdout, \"==> %s <==\\n\", name)\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\topts := options{count: 10}\n\tvar files []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\tfiles = append(files, arg)\n\t\ti++\n\t}\n\n\treturn opts, files, nil\n}\n\nfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--lines\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--lines' requires an argument\")\n\t\t}\n\t\tcount, err := parseLineCount(remaining[1])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeLines\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--lines=\"):\n\t\tcount, err := parseLineCount(flag[len(\"--lines=\"):])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeLines\n\t\treturn 1, nil\n\tcase flag == \"--bytes\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--bytes' requires an argument\")\n\t\t}\n\t\tcount, err := parseByteCount(remaining[1])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeBytes\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--bytes=\"):\n\t\tcount, err := parseByteCount(flag[len(\"--bytes=\"):])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeBytes\n\t\treturn 1, nil\n\tcase flag == \"--quiet\" || flag == \"--silent\":\n\t\topts.header = headerNever\n\t\treturn 1, nil\n\tcase flag == \"--verbose\":\n\t\topts.header = headerAlways\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 'n':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'n'\")\n\t\t\t}\n\t\t\tcount, err := parseLineCount(val)\n\t\t\tif err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t\topts.count = count\n\t\t\topts.mode = modeLines\n\t\t\treturn consumed, nil\n\t\tcase 'c':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'c'\")\n\t\t\t}\n\t\t\tcount, err := parseByteCount(val)\n\t\t\tif err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t\topts.count = count\n\t\t\topts.mode = modeBytes\n\t\t\treturn consumed, nil\n\t\tcase 'q':\n\t\t\topts.header = headerNever\n\t\tcase 'v':\n\t\t\topts.header = headerAlways\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn consumed, nil\n}\n\nfunc parseLineCount(s string) (int64, error) {\n\tn, err := strconv.ParseInt(s, 10, 64)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc parseByteCount(s string) (int64, error) {\n\tn, err := sizeparse.ParseWithOptions(s, sizeparse.ParseOptions{AllowSign: true})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid number of bytes: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc processFile(opts options, name string) error {\n\tr, closer, err := openInput(name)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif closer != nil {\n\t\tdefer closer.Close()\n\t}\n\tswitch opts.mode {\n\tcase modeBytes:\n\t\treturn headBytes(r, os.Stdout, opts.count)\n\tdefault:\n\t\treturn headLines(r, os.Stdout, opts.count)\n\t}\n}\n\nfunc openInput(name string) (io.Reader, io.Closer, error) {\n\tif name == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc headLines(r io.Reader, w io.Writer, count int64) error {\n\tif count == 0 {\n\t\treturn nil\n\t}\n\tif count < 0 {\n\t\treturn headLinesFromEnd(r, w, -count)\n\t}\n\treturn headLinesFromStart(r, w, count)\n}\n\nfunc headLinesFromStart(r io.Reader, w io.Writer, n int64) error {\n\tbr := bufio.NewReader(r)\n\tfor range n {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tif _, werr := w.Write(line); werr != nil {\n\t\t\t\treturn werr\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn nil\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc headLinesFromEnd(r io.Reader, w io.Writer, n int64) error {\n\tbr := bufio.NewReader(r)\n\tvar lines [][]byte\n\tfor {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tlines = append(lines, line)\n\t\t}\n\t\tif err != nil {\n\t\t\tbreak\n\t\t}\n\t}\n\tend := max(int64(len(lines))-n, 0)\n\tfor i := range end {\n\t\tif _, err := w.Write(lines[i]); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc headBytes(r io.Reader, w io.Writer, count int64) error {\n\tif count == 0 {\n\t\treturn nil\n\t}\n\tif count < 0 {\n\t\treturn headBytesFromEnd(r, w, -count)\n\t}\n\treturn headBytesFromStart(r, w, count)\n}\n\nfunc headBytesFromStart(r io.Reader, w io.Writer, n int64) error {\n\t_, err := io.CopyN(w, r, n)\n\tif err == io.EOF {\n\t\treturn nil\n\t}\n\treturn err\n}\n\nfunc headBytesFromEnd(r io.Reader, w io.Writer, n int64) error {\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tend := int64(len(data)) - n\n\tif end <= 0 {\n\t\treturn nil\n\t}\n\t_, err = w.Write(data[:end])\n\treturn err\n}\n","numLines":362,"startLine":1,"totalLines":362}}}
