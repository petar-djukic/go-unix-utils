{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QdnAMC15vpeSj7CtjPNpQq","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd024-expand.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tfunc main() {\n19\t\tsys.InstallSIGPIPEHandler()\n20\t\tw := bufio.NewWriter(os.Stdout)\n21\t\tstops, files, err := parseArgs(os.Args[1:])\n22\t\tif err != nil {\n23\t\t\tfmt.Fprintf(os.Stderr, \"expand: %s\\n\", err)\n24\t\t\tos.Exit(1)\n25\t\t}\n26\t\texitCode := 0\n27\t\tif len(files) == 0 {\n28\t\t\texpand(os.Stdin, w, stops)\n29\t\t} else {\n30\t\t\tfor _, name := range files {\n31\t\t\t\tif name == \"-\" {\n32\t\t\t\t\texpand(os.Stdin, w, stops)\n33\t\t\t\t\tcontinue\n34\t\t\t\t}\n35\t\t\t\tf, err := os.Open(name)\n36\t\t\t\tif err != nil {\n37\t\t\t\t\tfmt.Fprintf(os.Stderr, \"expand: %v\\n\", err)\n38\t\t\t\t\texitCode = 1\n39\t\t\t\t\tcontinue\n40\t\t\t\t}\n41\t\t\t\texpand(f, w, stops)\n42\t\t\t\tf.Close()\n43\t\t\t}\n44\t\t}\n45\t\tif err := w.Flush(); err != nil {\n46\t\t\tos.Exit(1)\n47\t\t}\n48\t\tos.Exit(exitCode)\n49\t}\n50\t\n51\ttype tabStops struct {\n52\t\tinterval  int\n53\t\tpositions []int\n54\t}\n55\t\n56\tfunc parseArgs(args []string) (tabStops, []string, error) {\n57\t\tvar rawStops []string\n58\t\tvar files []string\n59\t\tfor i := 0; i < len(args); i++ {\n60\t\t\ta := args[i]\n61\t\t\tif a == \"--\" {\n62\t\t\t\tfiles = append(files, args[i+1:]...)\n63\t\t\t\tbreak\n64\t\t\t}\n65\t\t\tif a == \"-t\" || strings.HasPrefix(a, \"-t\") {\n66\t\t\t\tvar val string\n67\t\t\t\tif a == \"-t\" {\n68\t\t\t\t\tif i+1 >= len(args) {\n69\t\t\t\t\t\treturn tabStops{}, nil, fmt.Errorf(\"option requires an argument -- 't'\")\n70\t\t\t\t\t}\n71\t\t\t\t\ti++\n72\t\t\t\t\tval = args[i]\n73\t\t\t\t} else {\n74\t\t\t\t\tval = a[2:]\n75\t\t\t\t}\n76\t\t\t\trawStops = append(rawStops, val)\n77\t\t\t\tcontinue\n78\t\t\t}\n79\t\t\tif strings.HasPrefix(a, \"-\") && a != \"-\" {\n80\t\t\t\treturn tabStops{}, nil, fmt.Errorf(\"invalid option -- '%s'\", a[1:])\n81\t\t\t}\n82\t\t\tfiles = append(files, a)\n83\t\t}\n84\t\tif len(rawStops) == 0 {\n85\t\t\treturn tabStops{interval: 8}, files, nil\n86\t\t}\n87\t\tstops, err := parseTabStops(strings.Join(rawStops, \",\"))\n88\t\tif err != nil {\n89\t\t\treturn tabStops{}, nil, err\n90\t\t}\n91\t\treturn stops, files, nil\n92\t}\n93\t\n94\tfunc parseTabStops(val string) (tabStops, error) {\n95\t\tparts := strings.FieldsFunc(val, func(r rune) bool {\n96\t\t\treturn r == ',' || r == ' '\n97\t\t})\n98\t\tif len(parts) == 0 {\n99\t\t\treturn tabStops{}, fmt.Errorf(\"tab size contains invalid character(s): '%s'\", val)\n100\t\t}\n101\t\tif len(parts) == 1 {\n102\t\t\tn, err := strconv.Atoi(parts[0])\n103\t\t\tif err != nil || n <= 0 {\n104\t\t\t\treturn tabStops{}, fmt.Errorf(\"invalid tab size: '%s'\", parts[0])\n105\t\t\t}\n106\t\t\treturn tabStops{interval: n}, nil\n107\t\t}\n108\t\tpositions := make([]int, len(parts))\n109\t\tfor i, p := range parts {\n110\t\t\tn, err := strconv.Atoi(p)\n111\t\t\tif err != nil || n <= 0 {\n112\t\t\t\treturn tabStops{}, fmt.Errorf(\"invalid tab size: '%s'\", p)\n113\t\t\t}\n114\t\t\tif i > 0 && n <= positions[i-1] {\n115\t\t\t\treturn tabStops{}, fmt.Errorf(\"tab sizes must be ascending\")\n116\t\t\t}\n117\t\t\tpositions[i] = n\n118\t\t}\n119\t\treturn tabStops{positions: positions}, nil\n120\t}\n121\t\n122\tfunc expand(r io.Reader, w *bufio.Writer, stops tabStops) {\n123\t\tbr := bufio.NewReader(r)\n124\t\tcol := 1\n125\t\tfor {\n126\t\t\tb, err := br.ReadByte()\n127\t\t\tif err != nil {\n128\t\t\t\treturn\n129\t\t\t}\n130\t\t\tswitch b {\n131\t\t\tcase '\\t':\n132\t\t\t\tspaces := nextTabSpaces(col, stops)\n133\t\t\t\tfor range spaces {\n134\t\t\t\t\tw.WriteByte(' ')\n135\t\t\t\t}\n136\t\t\t\tcol += spaces\n137\t\t\tcase '\\n':\n138\t\t\t\tw.WriteByte('\\n')\n139\t\t\t\tcol = 1\n140\t\t\tdefault:\n141\t\t\t\tw.WriteByte(b)\n142\t\t\t\tcol++\n143\t\t\t}\n144\t\t}\n145\t}\n146\t\n147\tfunc nextTabSpaces(col int, stops tabStops) int {\n148\t\tif stops.positions == nil {\n149\t\t\treturn stops.interval - (col-1)%stops.interval\n150\t\t}\n151\t\tcolIdx := col - 1\n152\t\tfor _, p := range stops.positions {\n153\t\t\tif p > colIdx {\n154\t\t\t\treturn p - colIdx\n155\t\t\t}\n156\t\t}\n157\t\treturn 1\n158\t}\n159\t"}]},"parent_tool_use_id":null,"session_id":"e820f3b1-3321-4cfb-8454-052bc88a00f0","uuid":"4a217f8b-78aa-40e5-a8cd-54a79aabed7d","timestamp":"2026-05-15T14:23:52.888Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5272/cmd/expand/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd024-expand.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tw := bufio.NewWriter(os.Stdout)\n\tstops, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"expand: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\texitCode := 0\n\tif len(files) == 0 {\n\t\texpand(os.Stdin, w, stops)\n\t} else {\n\t\tfor _, name := range files {\n\t\t\tif name == \"-\" {\n\t\t\t\texpand(os.Stdin, w, stops)\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tf, err := os.Open(name)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"expand: %v\\n\", err)\n\t\t\t\texitCode = 1\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\texpand(f, w, stops)\n\t\t\tf.Close()\n\t\t}\n\t}\n\tif err := w.Flush(); err != nil {\n\t\tos.Exit(1)\n\t}\n\tos.Exit(exitCode)\n}\n\ntype tabStops struct {\n\tinterval  int\n\tpositions []int\n}\n\nfunc parseArgs(args []string) (tabStops, []string, error) {\n\tvar rawStops []string\n\tvar files []string\n\tfor i := 0; i < len(args); i++ {\n\t\ta := args[i]\n\t\tif a == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif a == \"-t\" || strings.HasPrefix(a, \"-t\") {\n\t\t\tvar val string\n\t\t\tif a == \"-t\" {\n\t\t\t\tif i+1 >= len(args) {\n\t\t\t\t\treturn tabStops{}, nil, fmt.Errorf(\"option requires an argument -- 't'\")\n\t\t\t\t}\n\t\t\t\ti++\n\t\t\t\tval = args[i]\n\t\t\t} else {\n\t\t\t\tval = a[2:]\n\t\t\t}\n\t\t\trawStops = append(rawStops, val)\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(a, \"-\") && a != \"-\" {\n\t\t\treturn tabStops{}, nil, fmt.Errorf(\"invalid option -- '%s'\", a[1:])\n\t\t}\n\t\tfiles = append(files, a)\n\t}\n\tif len(rawStops) == 0 {\n\t\treturn tabStops{interval: 8}, files, nil\n\t}\n\tstops, err := parseTabStops(strings.Join(rawStops, \",\"))\n\tif err != nil {\n\t\treturn tabStops{}, nil, err\n\t}\n\treturn stops, files, nil\n}\n\nfunc parseTabStops(val string) (tabStops, error) {\n\tparts := strings.FieldsFunc(val, func(r rune) bool {\n\t\treturn r == ',' || r == ' '\n\t})\n\tif len(parts) == 0 {\n\t\treturn tabStops{}, fmt.Errorf(\"tab size contains invalid character(s): '%s'\", val)\n\t}\n\tif len(parts) == 1 {\n\t\tn, err := strconv.Atoi(parts[0])\n\t\tif err != nil || n <= 0 {\n\t\t\treturn tabStops{}, fmt.Errorf(\"invalid tab size: '%s'\", parts[0])\n\t\t}\n\t\treturn tabStops{interval: n}, nil\n\t}\n\tpositions := make([]int, len(parts))\n\tfor i, p := range parts {\n\t\tn, err := strconv.Atoi(p)\n\t\tif err != nil || n <= 0 {\n\t\t\treturn tabStops{}, fmt.Errorf(\"invalid tab size: '%s'\", p)\n\t\t}\n\t\tif i > 0 && n <= positions[i-1] {\n\t\t\treturn tabStops{}, fmt.Errorf(\"tab sizes must be ascending\")\n\t\t}\n\t\tpositions[i] = n\n\t}\n\treturn tabStops{positions: positions}, nil\n}\n\nfunc expand(r io.Reader, w *bufio.Writer, stops tabStops) {\n\tbr := bufio.NewReader(r)\n\tcol := 1\n\tfor {\n\t\tb, err := br.ReadByte()\n\t\tif err != nil {\n\t\t\treturn\n\t\t}\n\t\tswitch b {\n\t\tcase '\\t':\n\t\t\tspaces := nextTabSpaces(col, stops)\n\t\t\tfor range spaces {\n\t\t\t\tw.WriteByte(' ')\n\t\t\t}\n\t\t\tcol += spaces\n\t\tcase '\\n':\n\t\t\tw.WriteByte('\\n')\n\t\t\tcol = 1\n\t\tdefault:\n\t\t\tw.WriteByte(b)\n\t\t\tcol++\n\t\t}\n\t}\n}\n\nfunc nextTabSpaces(col int, stops tabStops) int {\n\tif stops.positions == nil {\n\t\treturn stops.interval - (col-1)%stops.interval\n\t}\n\tcolIdx := col - 1\n\tfor _, p := range stops.positions {\n\t\tif p > colIdx {\n\t\t\treturn p - colIdx\n\t\t}\n\t}\n\treturn 1\n}\n","numLines":159,"startLine":1,"totalLines":159}}}
