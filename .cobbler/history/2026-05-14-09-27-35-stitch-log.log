nc exitWithError(msg string) {\n65\t\tfmt.Fprintf(os.Stderr, \"seq: %s\\n\", msg)\n66\t\tfmt.Fprintf(os.Stderr, \"Try 'seq --help' for more information.\\n\")\n67\t\tos.Exit(1)\n68\t}\n69\t\n70\tfunc parseArgs(args []string) (options, []string, error) {\n71\t\topts := options{separator: \"\\n\"}\n72\t\tvar operands []string\n73\t\ti := 0\n74\t\tfor i < len(args) {\n75\t\t\targ := args[i]\n76\t\t\tif arg == \"--\" {\n77\t\t\t\toperands = append(operands, args[i+1:]...)\n78\t\t\t\tbreak\n79\t\t\t}\n80\t\t\tif strings.HasPrefix(arg, \"--\") {\n81\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n82\t\t\t\tif err != nil {\n83\t\t\t\t\treturn opts, nil, err\n84\t\t\t\t}\n85\t\t\t\ti += n\n86\t\t\t\tcontinue\n87\t\t\t}\n88\t\t\tif len(arg) > 1 && arg[0] == '-' && !isNumStart(arg) {\n89\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n90\t\t\t\tif err != nil {\n91\t\t\t\t\treturn opts, nil, err\n92\t\t\t\t}\n93\t\t\t\ti += 1 + n\n94\t\t\t\tcontinue\n95\t\t\t}\n96\t\t\toperands = append(operands, arg)\n97\t\t\ti++\n98\t\t}\n99\t\tif len(operands) == 0 {\n100\t\t\treturn opts, nil, fmt.Errorf(\"missing operand\")\n101\t\t}\n102\t\tif len(operands) > 3 {\n103\t\t\treturn opts, nil, fmt.Errorf(\"extra operand '%s'\", operands[3])\n104\t\t}\n105\t\treturn opts, operands, nil\n106\t}\n107\t\n108\tfunc isNumStart(s string) bool {\n109\t\tif len(s) < 2 {\n110\t\t\treturn false\n111\t\t}\n112\t\tc := s[1]\n113\t\treturn c == '.' || (c >= '0' && c <= '9')\n114\t}\n115\t\n116\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n117\t\tswitch {\n118\t\tcase flag == \"--help\":\n119\t\t\tfmt.Fprint(os.Stdout, helpText)\n120\t\t\tos.Exit(0)\n121\t\t\treturn 0, nil\n122\t\tcase flag == \"--version\":\n123\t\t\tfmt.Fprint(os.Stdout, versionText)\n124\t\t\tos.Exit(0)\n125\t\t\treturn 0, nil\n126\t\tcase flag == \"--format\":\n127\t\t\tif len(remaining) < 2 {\n128\t\t\t\treturn 0, fmt.Errorf(\"option '--format' requires an argument\")\n129\t\t\t}\n130\t\t\topts.format = remaining[1]\n131\t\t\treturn 2, nil\n132\t\tcase strings.HasPrefix(flag, \"--format=\"):\n133\t\t\topts.format = flag[len(\"--format=\"):]\n134\t\t\treturn 1, nil\n135\t\tcase flag == \"--separator\":\n136\t\t\tif len(remaining) < 2 {\n137\t\t\t\treturn 0, fmt.Errorf(\"option '--separator' requires an argument\")\n138\t\t\t}\n139\t\t\topts.separator = remaining[1]\n140\t\t\treturn 2, nil\n141\t\tcase strings.HasPrefix(flag, \"--separator=\"):\n142\t\t\topts.separator = flag[len(\"--separator=\"):]\n143\t\t\treturn 1, nil\n144\t\tcase flag == \"--equal-width\":\n145\t\t\topts.equalWidth = true\n146\t\t\treturn 1, nil\n147\t\tdefault:\n148\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n149\t\t}\n150\t}\n151\t\n152\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n153\t\tconsumed := 0\n154\t\tfor j := 0; j < len(flags); j++ {\n155\t\t\tswitch flags[j] {\n156\t\t\tcase 'f':\n157\t\t\t\tvar val string\n158\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n159\t\t\t\t\tval = rest\n160\t\t\t\t} else if len(remaining) > consumed {\n161\t\t\t\t\tval = remaining[consumed]\n162\t\t\t\t\tconsumed++\n163\t\t\t\t} else {\n164\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'f'\")\n165\t\t\t\t}\n166\t\t\t\topts.format = val\n167\t\t\t\treturn consumed, nil\n168\t\t\tcase 's':\n169\t\t\t\tvar val string\n170\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n171\t\t\t\t\tval = rest\n172\t\t\t\t} else if len(remaining) > consumed {\n173\t\t\t\t\tval = remaining[consumed]\n174\t\t\t\t\tconsumed++\n175\t\t\t\t} else {\n176\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n177\t\t\t\t}\n178\t\t\t\topts.separator = val\n179\t\t\t\treturn consumed, nil\n180\t\t\tcase 'w':\n181\t\t\t\topts.equalWidth = true\n182\t\t\tdefault:\n183\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n184\t\t\t}\n185\t\t}\n186\t\treturn consumed, nil\n187\t}\n188\t\n189\tfunc parseOperands(args []string) (first, incr, last float64, err error) {\n190\t\tswitch len(args) {\n191\t\tcase 1:\n192\t\t\tlast, err = parseNumber(args[0])\n193\t\t\tif err != nil {\n194\t\t\t\treturn 0, 0, 0, err\n195\t\t\t}\n196\t\t\treturn 1, 1, last, nil\n197\t\tcase 2:\n198\t\t\tfirst, err = parseNumber(args[0])\n199\t\t\tif err != nil {\n200\t\t\t\treturn 0, 0, 0, err\n201\t\t\t}\n202\t\t\tlast, err = parseNumber(args[1])\n203\t\t\tif err != nil {\n204\t\t\t\treturn 0, 0, 0, err\n205\t\t\t}\n206\t\t\treturn first, 1, last, nil\n207\t\tdefault:\n208\t\t\tfirst, err = parseNumber(args[0])\n209\t\t\tif err != nil {\n210\t\t\t\treturn 0, 0, 0, err\n211\t\t\t}\n212\t\t\tincr, err = parseNumber(args[1])\n213\t\t\tif err != nil {\n214\t\t\t\treturn 0, 0, 0, err\n215\t\t\t}\n216\t\t\tlast, err = parseNumber(args[2])\n217\t\t\tif err != nil {\n218\t\t\t\treturn 0, 0, 0, err\n219\t\t\t}\n220\t\t\treturn first, incr, last, nil\n221\t\t}\n222\t}\n223\t\n224\tfunc parseNumber(s string) (float64, error) {\n225\t\tn, err := strconv.ParseFloat(s, 64)\n226\t\tif err != nil {\n227\t\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n228\t\t}\n229\t\tif math.IsNaN(n) || math.IsInf(n, 0) {\n230\t\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n231\t\t}\n232\t\treturn n, nil\n233\t}\n234\t\n235\tfunc validateFormat(format string) error {\n236\t\tcount := 0\n237\t\ti := 0\n238\t\tfor i < len(format) {\n239\t\t\tif format[i] != '%' {\n240\t\t\t\ti++\n241\t\t\t\tcontinue\n242\t\t\t}\n243\t\t\ti++\n244\t\t\tif i >= len(format) {\n245\t\t\t\tbreak\n246\t\t\t}\n247\t\t\tif format[i] == '%' {\n248\t\t\t\ti++\n249\t\t\t\tcontinue\n250\t\t\t}\n251\t\t\tconv, next, err := scanConversion(format, i)\n252\t\t\tif err != nil {\n253\t\t\t\treturn err\n254\t\t\t}\n255\t\t\ti = next\n256\t\t\tif strings.ContainsRune(\"aefgAEFG\", rune(conv)) {\n257\t\t\t\tcount++\n258\t\t\t} else {\n259\t\t\t\treturn fmt.Errorf(\"format '%s' has unknown %%%c directive\", format, conv)\n260\t\t\t}\n261\t\t}\n262\t\tif count == 0 {\n263\t\t\treturn fmt.Errorf(\"format '%s' has no %% directive\", format)\n264\t\t}\n265\t\tif count > 1 {\n266\t\t\treturn fmt.Errorf(\"format '%s' has too many %% directives\", format)\n267\t\t}\n268\t\treturn nil\n269\t}\n270\t\n271\tfunc scanConversion(format string, i int) (byte, int, error) {\n272\t\tfor i < len(format) && strings.ContainsRune(\"-+#0 '\", rune(format[i])) {\n273\t\t\ti++\n274\t\t}\n275\t\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n276\t\t\ti++\n277\t\t}\n278\t\tif i < len(format) && format[i] == '.' {\n279\t\t\ti++\n280\t\t\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n281\t\t\t\ti++\n282\t\t\t}\n283\t\t}\n284\t\tif i >= len(format) {\n285\t\t\treturn 0, i, fmt.Errorf(\"format '%s' has no %% directive\", format)\n286\t\t}\n287\t\tconv := format[i]\n288\t\treturn conv, i + 1, nil\n289\t}\n290\t\n291\tfunc printSequence(opts options, first, incr, last float64, rawArgs []string) {\n292\t\tw := bufio.NewWriter(os.Stdout)\n293\t\tdefer w.Flush()\n294\t\tformat := opts.format\n295\t\tif format == \"\" {\n296\t\t\tformat = defaultFormat(rawArgs)\n297\t\t\tif opts.equalWidth {\n298\t\t\t\tformat = equalWidthFormat(format, first, last)\n299\t\t\t}\n300\t\t}\n301\t\tstarted := false\n302\t\tfor i := 0; ; i++ {\n303\t\t\tval := first + float64(i)*incr\n304\t\t\tif !inRange(val, incr, last) {\n305\t\t\t\tbreak\n306\t\t\t}\n307\t\t\tif started {\n308\t\t\t\tfmt.Fprint(w, opts.separator)\n309\t\t\t}\n310\t\t\tfmt.Fprintf(w, format, val)\n311\t\t\tstarted = true\n312\t\t}\n313\t\tif started {\n314\t\t\tfmt.Fprintln(w)\n315\t\t}\n316\t}\n317\t\n318\tfunc equalWidthFormat(defFmt string, first, last float64) string {\n319\t\tw1 := len(fmt.Sprintf(defFmt, first))\n320\t\tw2 := len(fmt.Sprintf(defFmt, last))\n321\t\tmaxW := max(w1, w2)\n322\t\tprec := 0\n323\t\tif dot := strings.IndexByte(defFmt, '.'); dot >= 0 {\n324\t\t\tprec, _ = strconv.Atoi(defFmt[dot+1 : len(defFmt)-1])\n325\t\t}\n326\t\tif prec == 0 {\n327\t\t\treturn \"%0\" + strconv.Itoa(maxW) + \".0f\"\n328\t\t}\n329\t\treturn \"%0\" + strconv.Itoa(maxW) + \".\" + strconv.Itoa(prec) + \"f\"\n330\t}\n331\t\n332\tfunc inRange(val, incr, last float64) bool {\n333\t\tif incr >= 0 {\n334\t\t\treturn val <= last\n335\t\t}\n336\t\treturn val >= last\n337\t}\n338\t\n339\tfunc defaultFormat(rawArgs []string) string {\n340\t\tmaxPrec := 0\n341\t\tfor _, arg := range rawArgs {\n342\t\t\tp := argPrecision(arg)\n343\t\t\tif p > maxPrec {\n344\t\t\t\tmaxPrec = p\n345\t\t\t}\n346\t\t}\n347\t\tif maxPrec == 0 {\n348\t\t\treturn \"%.0f\"\n349\t\t}\n350\t\treturn \"%.\" + strconv.Itoa(maxPrec) + \"f\"\n351\t}\n352\t\n353\tfunc argPrecision(s string) int {\n354\t\tif len(s) > 0 && (s[0] == '-' || s[0] == '+') {\n355\t\t\ts = s[1:]\n356\t\t}\n357\t\tdot := strings.IndexByte(s, '.')\n358\t\tif dot < 0 {\n359\t\t\treturn 0\n360\t\t}\n361\t\treturn len(s) - dot - 1\n362\t}\n363\t"}]},"parent_tool_use_id":null,"session_id":"13f5bbc1-b2d8-4a91-bf97-10193c31abab","uuid":"ff9c05f9-2bd2-44ab-8b32-8f90c5ec3cda","timestamp":"2026-05-14T13:27:44.359Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5173/cmd/seq/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: seq [OPTION]... LAST\n  or:  seq [OPTION]... FIRST LAST\n  or:  seq [OPTION]... FIRST INCREMENT LAST\nPrint numbers from FIRST to LAST, in steps of INCREMENT.\n\nMandatory arguments to long options are mandatory for short options too.\n  -f, --format=FORMAT      use printf style floating-point FORMAT\n  -s, --separator=STRING   use STRING to separate numbers (default: \\n)\n  -w, --equal-width        equalize width by padding with leading zeroes\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `seq (go-unix-utils) dev\n`\n\ntype options struct {\n\tformat     string\n\tseparator  string\n\tequalWidth bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, operands, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\texitWithError(err.Error())\n\t}\n\tfirst, incr, last, err := parseOperands(operands)\n\tif err != nil {\n\t\texitWithError(err.Error())\n\t}\n\tif incr == 0 {\n\t\tstepStr := \"0\"\n\t\tif len(operands) == 3 {\n\t\t\tstepStr = operands[1]\n\t\t}\n\t\texitWithError(fmt.Sprintf(\"invalid Zero increment value: '%s'\", stepStr))\n\t}\n\tif opts.format != \"\" {\n\t\tif err := validateFormat(opts.format); err != nil {\n\t\t\texitWithError(err.Error())\n\t\t}\n\t}\n\tprintSequence(opts, first, incr, last, operands)\n}\n\nfunc exitWithError(msg string) {\n\tfmt.Fprintf(os.Stderr, \"seq: %s\\n\", msg)\n\tfmt.Fprintf(os.Stderr, \"Try 'seq --help' for more information.\\n\")\n\tos.Exit(1)\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\topts := options{separator: \"\\n\"}\n\tvar operands []string\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\toperands = append(operands, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' && !isNumStart(arg) {\n\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\toperands = append(operands, arg)\n\t\ti++\n\t}\n\tif len(operands) == 0 {\n\t\treturn opts, nil, fmt.Errorf(\"missing operand\")\n\t}\n\tif len(operands) > 3 {\n\t\treturn opts, nil, fmt.Errorf(\"extra operand '%s'\", operands[3])\n\t}\n\treturn opts, operands, nil\n}\n\nfunc isNumStart(s string) bool {\n\tif len(s) < 2 {\n\t\treturn false\n\t}\n\tc := s[1]\n\treturn c == '.' || (c >= '0' && c <= '9')\n}\n\nfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--format\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--format' requires an argument\")\n\t\t}\n\t\topts.format = remaining[1]\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--format=\"):\n\t\topts.format = flag[len(\"--format=\"):]\n\t\treturn 1, nil\n\tcase flag == \"--separator\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--separator' requires an argument\")\n\t\t}\n\t\topts.separator = remaining[1]\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--separator=\"):\n\t\topts.separator = flag[len(\"--separator=\"):]\n\t\treturn 1, nil\n\tcase flag == \"--equal-width\":\n\t\topts.equalWidth = true\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 'f':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'f'\")\n\t\t\t}\n\t\t\topts.format = val\n\t\t\treturn consumed, nil\n\t\tcase 's':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n\t\t\t}\n\t\t\topts.separator = val\n\t\t\treturn consumed, nil\n\t\tcase 'w':\n\t\t\topts.equalWidth = true\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn consumed, nil\n}\n\nfunc parseOperands(args []string) (first, incr, last float64, err error) {\n\tswitch len(args) {\n\tcase 1:\n\t\tlast, err = parseNumber(args[0])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\treturn 1, 1, last, nil\n\tcase 2:\n\t\tfirst, err = parseNumber(args[0])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\tlast, err = parseNumber(args[1])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\treturn first, 1, last, nil\n\tdefault:\n\t\tfirst, err = parseNumber(args[0])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\tincr, err = parseNumber(args[1])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\tlast, err = parseNumber(args[2])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\treturn first, incr, last, nil\n\t}\n}\n\nfunc parseNumber(s string) (float64, error) {\n\tn, err := strconv.ParseFloat(s, 64)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n\t}\n\tif math.IsNaN(n) || math.IsInf(n, 0) {\n\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc validateFormat(format string) error {\n\tcount := 0\n\ti := 0\n\tfor i < len(format) {\n\t\tif format[i] != '%' {\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\ti++\n\t\tif i >= len(format) {\n\t\t\tbreak\n\t\t}\n\t\tif format[i] == '%' {\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tconv, next, err := scanConversion(format, i)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ti = next\n\t\tif strings.ContainsRune(\"aefgAEFG\", rune(conv)) {\n\t\t\tcount++\n\t\t} else {\n\t\t\treturn fmt.Errorf(\"format '%s' has unknown %%%c directive\", format, conv)\n\t\t}\n\t}\n\tif count == 0 {\n\t\treturn fmt.Errorf(\"format '%s' has no %% directive\", format)\n\t}\n\tif count > 1 {\n\t\treturn fmt.Errorf(\"format '%s' has too many %% directives\", format)\n\t}\n\treturn nil\n}\n\nfunc scanConversion(format string, i int) (byte, int, error) {\n\tfor i < len(format) && strings.ContainsRune(\"-+#0 '\", rune(format[i])) {\n\t\ti++\n\t}\n\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n\t\ti++\n\t}\n\tif i < len(format) && format[i] == '.' {\n\t\ti++\n\t\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n\t\t\ti++\n\t\t}\n\t}\n\tif i >= len(format) {\n\t\treturn 0, i, fmt.Errorf(\"format '%s' has no %% directive\", format)\n\t}\n\tconv := format[i]\n\treturn conv, i + 1, nil\n}\n\nfunc printSequence(opts options, first, incr, last float64, rawArgs []string) {\n\tw := bufio.NewWriter(os.Stdout)\n\tdefer w.Flush()\n\tformat := opts.format\n\tif format == \"\" {\n\t\tformat = defaultFormat(rawArgs)\n\t\tif opts.equalWidth {\n\t\t\tformat = equalWidthFormat(format, first, last)\n\t\t}\n\t}\n\tstarted := false\n\tfor i := 0; ; i++ {\n\t\tval := first + float64(i)*incr\n\t\tif !inRange(val, incr, last) {\n\t\t\tbreak\n\t\t}\n\t\tif started {\n\t\t\tfmt.Fprint(w, opts.separator)\n\t\t}\n\t\tfmt.Fprintf(w, format, val)\n\t\tstarted = true\n\t}\n\tif started {\n\t\tfmt.Fprintln(w)\n\t}\n}\n\nfunc equalWidthFormat(defFmt string, first, last float64) string {\n\tw1 := len(fmt.Sprintf(defFmt, first))\n\tw2 := len(fmt.Sprintf(defFmt, last))\n\tmaxW := max(w1, w2)\n\tprec := 0\n\tif dot := strings.IndexByte(defFmt, '.'); dot >= 0 {\n\t\tprec, _ = strconv.Atoi(defFmt[dot+1 : len(defFmt)-1])\n\t}\n\tif prec == 0 {\n\t\treturn \"%0\" + strconv.Itoa(maxW) + \".0f\"\n\t}\n\treturn \"%0\" + strconv.Itoa(maxW) + \".\" + strconv.Itoa(prec) + \"f\"\n}\n\nfunc inRange(val, incr, last float64) bool {\n\tif incr >= 0 {\n\t\treturn val <= last\n\t}\n\treturn val >= last\n}\n\nfunc defaultFormat(rawArgs []string) string {\n\tmaxPrec := 0\n\tfor _, arg := range rawArgs {\n\t\tp := argPrecision(arg)\n\t\tif p > maxPrec {\n\t\t\tmaxPrec = p\n\t\t}\n\t}\n\tif maxPrec == 0 {\n\t\treturn \"%.0f\"\n\t}\n\treturn \"%.\" + strconv.Itoa(maxPrec) + \"f\"\n}\n\nfunc argPrecision(s string) int {\n\tif len(s) > 0 && (s[0] == '-' || s[0] == '+') {\n\t\ts = s[1:]\n\t}\n\tdot := strings.IndexByte(s, '.')\n\tif dot < 0 {\n\t\treturn 0\n\t}\n\treturn len(s) - dot - 1\n}\n","numLines":363,"startLine":1,"totalLines":363}}}
