ry 'nproc --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\n\tcount := runtime.NumCPU()\n\t_ = allFlag\n\n\tcount -= ignoreN\n\tif count < 1 {\n\t\tcount = 1\n\t}\n\n\tif _, err := fmt.Fprintln(os.Stdout, count); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseIgnore(val string, n *int) bool {\n\tv, err := strconv.Atoi(val)\n\tif err != nil || v < 0 {\n\t\tfmt.Fprintf(os.Stderr, \"nproc: invalid number: '%s'\\n\", val)\n\t\treturn false\n\t}\n\t*n = v\n\treturn true\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":262,"cache_read_input_tokens":24618,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":262},"output_tokens":26,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"de2710c8-66a4-43d6-bd6a-3c0768face89","uuid":"287a046d-6fec-4340-8241-15628c0da703"}
