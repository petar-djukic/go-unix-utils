{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TFn93TYHr4snBEfGbYdkmC","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"context\"\n9\t\t\"encoding/hex\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"os/exec\"\n14\t\t\"path/filepath\"\n15\t\t\"strings\"\n16\t\t\"testing\"\n17\t\t\"time\"\n18\t\n19\t\t\"golang.org/x/crypto/blake2b\"\n20\t\n21\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n22\t)\n23\t\n24\tfunc TestDiff(t *testing.T) {\n25\t\tgoBin := testutils.BuildBinary(t, \".\")\n26\t\trefBin, err := exec.LookPath(\"gb2sum\")\n27\t\tif err != nil {\n28\t\t\tt.Skip(\"reference binary not found\")\n29\t\t}\n30\t\n31\t\ttmpDir := t.TempDir()\n32\t\thelloFile := filepath.Join(tmpDir, \"hello.txt\")\n33\t\twriteFile(t, helloFile, \"hello\\n\")\n34\t\temptyFile := filepath.Join(tmpDir, \"empty.txt\")\n35\t\twriteFile(t, emptyFile, \"\")\n36\t\n37\t\tdiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n38\t\n39\t\thello512 := b2hex([]byte(\"hello\\n\"), 64)\n40\t\tempty512 := b2hex([]byte{}, 64)\n41\t\thello256 := b2hex([]byte(\"hello\\n\"), 32)\n42\t\tzeroHash := strings.Repeat(\"0\", 128)\n43\t\n44\t\tvalidChecksum := filepath.Join(tmpDir, \"valid.b2\")\n45\t\twriteFile(t, validChecksum, fmt.Sprintf(\"%s  %s\\n\", hello512, helloFile))\n46\t\n47\t\tmultiChecksum := filepath.Join(tmpDir, \"multi.b2\")\n48\t\twriteFile(t, multiChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", hello512, helloFile, empty512, emptyFile))\n49\t\n50\t\tmismatchChecksum := filepath.Join(tmpDir, \"mismatch.b2\")\n51\t\twriteFile(t, mismatchChecksum, fmt.Sprintf(\"%s  %s\\n\", zeroHash, helloFile))\n52\t\n53\t\tbsdChecksum := filepath.Join(tmpDir, \"bsd.b2\")\n54\t\twriteFile(t, bsdChecksum, fmt.Sprintf(\"BLAKE2b (%s) = %s\\n\", helloFile, hello512))\n55\t\n56\t\tmixedChecksum := filepath.Join(tmpDir, \"mixed.b2\")\n57\t\twriteFile(t, mixedChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", hello512, helloFile, zeroHash, emptyFile))\n58\t\n59\t\tmalformedChecksum := filepath.Join(tmpDir, \"malformed.b2\")\n60\t\twriteFile(t, malformedChecksum, fmt.Sprintf(\"this is not a checksum\\n%s  %s\\n\", hello512, helloFile))\n61\t\n62\t\tlen256Checksum := filepath.Join(tmpDir, \"len256.b2\")\n63\t\twriteFile(t, len256Checksum, fmt.Sprintf(\"%s  %s\\n\", hello256, helloFile))\n64\t\n65\t\tbsd256Checksum := filepath.Join(tmpDir, \"bsd256.b2\")\n66\t\twriteFile(t, bsd256Checksum, fmt.Sprintf(\"BLAKE2b-256 (%s) = %s\\n\", helloFile, hello256))\n67\t\n68\t\ttests := []testutils.DiffTest{\n69\t\t\t// R1.1: single file, text mode (default)\n70\t\t\t{\n71\t\t\t\tName: \"single-file-text\",\n72\t\t\t\tArgs: []string{helloFile},\n73\t\t\t},\n74\t\t\t// R1.1: single file, binary mode\n75\t\t\t{\n76\t\t\t\tName: \"single-file-binary\",\n77\t\t\t\tArgs: []string{\"-b\", helloFile},\n78\t\t\t},\n79\t\t\t// R1.2: stdin with no arguments\n80\t\t\t{\n81\t\t\t\tName:  \"stdin-no-args\",\n82\t\t\t\tStdin: []byte(\"abc\"),\n83\t\t\t},\n84\t\t\t// R1.2: stdin with explicit \"-\"\n85\t\t\t{\n86\t\t\t\tName:  \"stdin-dash\",\n87\t\t\t\tArgs:  []string{\"-\"},\n88\t\t\t\tStdin: []byte(\"abc\"),\n89\t\t\t},\n90\t\t\t// R1.3: BSD tag format\n91\t\t\t{\n92\t\t\t\tName: \"tag-format\",\n93\t\t\t\tArgs: []string{\"--tag\", helloFile},\n94\t\t\t},\n95\t\t\t// R1.4: missing file exits 1\n96\t\t\t{\n97\t\t\t\tName:      \"missing-file\",\n98\t\t\t\tArgs:      []string{filepath.Join(tmpDir, \"nonexistent.txt\")},\n99\t\t\t\tExitCode:  1,\n100\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n101\t\t\t},\n102\t\t\t// R1.4: missing file among valid files continues processing\n103\t\t\t{\n104\t\t\t\tName:      \"missing-among-valid\",\n105\t\t\t\tArgs:      []string{helloFile, filepath.Join(tmpDir, \"nonexistent.txt\"), emptyFile},\n106\t\t\t\tExitCode:  1,\n107\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n108\t\t\t},\n109\t\t\t// R2.1: --check with valid checksum file\n110\t\t\t{\n111\t\t\t\tName:      \"check-valid\",\n112\t\t\t\tArgs:      []string{\"--check\", validChecksum},\n113\t\t\t\tExitCode:  0,\n114\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n115\t\t\t},\n116\t\t\t// R2.1: --check with BSD tag format\n117\t\t\t{\n118\t\t\t\tName:      \"check-bsd-tag\",\n119\t\t\t\tArgs:      []string{\"--check\", bsdChecksum},\n120\t\t\t\tExitCode:  0,\n121\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n122\t\t\t},\n123\t\t\t// R2.2: --check with mismatched hash exits 1\n124\t\t\t{\n125\t\t\t\tName:      \"check-mismatch\",\n126\t\t\t\tArgs:      []string{\"--check\", mismatchChecksum},\n127\t\t\t\tExitCode:  1,\n128\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n129\t\t\t},\n130\t\t\t// R2.3: --check --warn with malformed lines\n131\t\t\t{\n132\t\t\t\tName:      \"check-warn-malformed\",\n133\t\t\t\tArgs:      []string{\"--check\", \"--warn\", malformedChecksum},\n134\t\t\t\tExitCode:  0,\n135\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n136\t\t\t},\n137\t\t\t// R2.3: --check --quiet suppresses OK lines\n138\t\t\t{\n139\t\t\t\tName:      \"check-quiet-all-ok\",\n140\t\t\t\tArgs:      []string{\"--check\", \"--quiet\", multiChecksum},\n141\t\t\t\tExitCode:  0,\n142\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n143\t\t\t},\n144\t\t\t// R2.3: --check --status suppresses all output\n145\t\t\t{\n146\t\t\t\tName:      \"check-status-ok\",\n147\t\t\t\tArgs:      []string{\"--check\", \"--status\", validChecksum},\n148\t\t\t\tExitCode:  0,\n149\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n150\t\t\t},\n151\t\t\t// R2.3: --check --status exits 1 on failure\n152\t\t\t{\n153\t\t\t\tName:      \"check-status-fail\",\n154\t\t\t\tArgs:      []string{\"--check\", \"--status\", mismatchChecksum},\n155\t\t\t\tExitCode:  1,\n156\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n157\t\t\t},\n158\t\n159\t\t\t// R3.1: binary mode with multiple files\n160\t\t\t{\n161\t\t\t\tName: \"binary-multiple-files\",\n162\t\t\t\tArgs: []string{\"-b\", helloFile, emptyFile},\n163\t\t\t},\n164\t\t\t// R3.1: text mode explicit\n165\t\t\t{\n166\t\t\t\tName: \"text-mode-explicit\",\n167\t\t\t\tArgs: []string{\"-t\", helloFile},\n168\t\t\t},\n169\t\n170\t\t\t// R3.2: --tag produces BSD tag format regardless of -b\n171\t\t\t{\n172\t\t\t\tName: \"tag-overrides-binary\",\n173\t\t\t\tArgs: []string{\"--tag\", \"-b\", helloFile},\n174\t\t\t},\n175\t\t\t// R3.2: --tag rejects explicit text mode\n176\t\t\t{\n177\t\t\t\tName:      \"tag-rejects-text\",\n178\t\t\t\tArgs:      []string{\"--tag\", \"-t\", helloFile},\n179\t\t\t\tExitCode:  1,\n180\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n181\t\t\t},\n182\t\t\t// R3.2: --tag with -b and multiple files\n183\t\t\t{\n184\t\t\t\tName: \"tag-binary-multiple\",\n185\t\t\t\tArgs: []string{\"--tag\", \"-b\", helloFile, emptyFile},\n186\t\t\t},\n187\t\n188\t\t\t// R3.3: --length=256 produces 64-char hex digest\n189\t\t\t{\n190\t\t\t\tName: \"length-256\",\n191\t\t\t\tArgs: []string{\"--length=256\", helloFile},\n192\t\t\t},\n193\t\t\t// R3.3: --length 256 (space-separated)\n194\t\t\t{\n195\t\t\t\tName: \"length-256-space\",\n196\t\t\t\tArgs: []string{\"--length\", \"256\", helloFile},\n197\t\t\t},\n198\t\t\t// R3.3: --length=256 with --tag uses BLAKE2b-256\n199\t\t\t{\n200\t\t\t\tName: \"length-256-tag\",\n201\t\t\t\tArgs: []string{\"--length=256\", \"--tag\", helloFile},\n202\t\t\t},\n203\t\t\t// R3.3: --length=128\n204\t\t\t{\n205\t\t\t\tName: \"length-128\",\n206\t\t\t\tArgs: []string{\"--length=128\", helloFile},\n207\t\t\t},\n208\t\t\t// R3.3: --length=512 (explicit default)\n209\t\t\t{\n210\t\t\t\tName: \"length-512-explicit\",\n211\t\t\t\tArgs: []string{\"--length=512\", helloFile},\n212\t\t\t},\n213\t\t\t// R3.3: invalid length (not multiple of 8) exits 1\n214\t\t\t{\n215\t\t\t\tName:      \"length-invalid-not-mult-8\",\n216\t\t\t\tArgs:      []string{\"--length=7\", helloFile},\n217\t\t\t\tExitCode:  1,\n218\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n219\t\t\t},\n220\t\t\t// R3.3: invalid length (zero) exits 1\n221\t\t\t{\n222\t\t\t\tName:      \"length-invalid-zero\",\n223\t\t\t\tArgs:      []string{\"--length=0\", helloFile},\n224\t\t\t\tExitCode:  1,\n225\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n226\t\t\t},\n227\t\t\t// R3.3: invalid length (exceeds 512) exits 1\n228\t\t\t{\n229\t\t\t\tName:      \"length-invalid-too-large\",\n230\t\t\t\tArgs:      []string{\"--length=520\", helloFile},\n231\t\t\t\tExitCode:  1,\n232\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n233\t\t\t},\n234\t\t\t// R3.3: invalid length (negative) exits 1\n235\t\t\t{\n236\t\t\t\tName:      \"length-invalid-negative\",\n237\t\t\t\tArgs:      []string{\"--length=-8\", helloFile},\n238\t\t\t\tExitCode:  1,\n239\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n240\t\t\t},\n241\t\t\t// R3.3: --length=256 with --check\n242\t\t\t{\n243\t\t\t\tName:      \"length-256-check\",\n244\t\t\t\tArgs:      []string{\"--length=256\", \"--check\", len256Checksum},\n245\t\t\t\tExitCode:  0,\n246\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n247\t\t\t},\n248\t\t\t// R3.3: --length=256 with --check BSD tag format\n249\t\t\t{\n250\t\t\t\tName:      \"length-256-check-bsd\",\n251\t\t\t\tArgs:      []string{\"--length=256\", \"--check\", bsd256Checksum},\n252\t\t\t\tExitCode:  0,\n253\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n254\t\t\t},\n255\t\n256\t\t\t// R4.1: exit 0 when all files processed successfully\n257\t\t\t{\n258\t\t\t\tName: \"exit-0-all-ok\",\n259\t\t\t\tArgs: []string{helloFile, emptyFile},\n260\t\t\t},\n261\t\t\t// R4.1: exit 0 when all verified digests match\n262\t\t\t{\n263\t\t\t\tName:      \"exit-0-check-all-match\",\n264\t\t\t\tArgs:      []string{\"--check\", multiChecksum},\n265\t\t\t\tExitCode:  0,\n266\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n267\t\t\t},\n268\t\n269\t\t\t// R4.2: exit 1 when any file cannot be opened\n270\t\t\t{\n271\t\t\t\tName:      \"exit-1-missing-file\",\n272\t\t\t\tArgs:      []string{filepath.Join(tmpDir, \"no-such-file.txt\")},\n273\t\t\t\tExitCode:  1,\n274\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n275\t\t\t},\n276\t\t\t// R4.2: exit 1 when any digest fails verification\n277\t\t\t{\n278\t\t\t\tName:      \"exit-1-check-fail\",\n279\t\t\t\tArgs:      []string{\"--check\", mismatchChecksum},\n280\t\t\t\tExitCode:  1,\n281\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n282\t\t\t},\n283\t\t\t// R4.2: exit 1 when checksum file is unreadable\n284\t\t\t{\n285\t\t\t\tName:      \"exit-1-check-unreadable\",\n286\t\t\t\tArgs:      []string{\"--check\", filepath.Join(tmpDir, \"nonexistent.b2\")},\n287\t\t\t\tExitCode:  1,\n288\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n289\t\t\t},\n290\t\t\t// R4.2: exit 1 mixed valid/invalid in check\n291\t\t\t{\n292\t\t\t\tName:      \"exit-1-check-mixed\",\n293\t\t\t\tArgs:      []string{\"--check\", mixedChecksum},\n294\t\t\t\tExitCode:  1,\n295\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n296\t\t\t},\n297\t\t}\n298\t\n299\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n300\t}\n301\t\n302\tfunc TestSIGPIPE(t *testing.T) {\n303\t\tgoBin := testutils.BuildBinary(t, \".\")\n304\t\tdir := t.TempDir()\n305\t\tlargePath := filepath.Join(dir, \"large.dat\")\n306\t\tif err := os.WriteFile(largePath, bytes.Repeat([]byte(\"x\\n\"), 500000), 0o644); err != nil {\n307\t\t\tt.Fatal(err)\n308\t\t}\n309\t\tt.Run(\"go\", func(t *testing.T) { testSIGPIPE(t, goBin, largePath) })\n310\t\tif refBin, err := exec.LookPath(\"gb2sum\"); err == nil {\n311\t\t\tt.Run(\"ref\", func(t *testing.T) { testSIGPIPE(t, refBin, largePath) })\n312\t\t}\n313\t}\n314\t\n315\tfunc testSIGPIPE(t *testing.T, bin, filePath string) {\n316\t\tt.Helper()\n317\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n318\t\tdefer cancel()\n319\t\tcmd := exec.CommandContext(ctx, bin, filePath)\n320\t\tstdout, err := cmd.StdoutPipe()\n321\t\tif err != nil {\n322\t\t\tt.Fatal(err)\n323\t\t}\n324\t\tif err := cmd.Start(); err != nil {\n325\t\t\tt.Fatal(err)\n326\t\t}\n327\t\tbuf := make([]byte, 1)\n328\t\tif _, err := io.ReadFull(stdout, buf); err != nil {\n329\t\t\tt.Fatal(err)\n330\t\t}\n331\t\tstdout.Close()\n332\t\terr = cmd.Wait()\n333\t\tif ctx.Err() == context.DeadlineExceeded {\n334\t\t\tt.Fatalf(\"%s timed out; SIGPIPE handler may not be installed\", bin)\n335\t\t}\n336\t\tif err != nil {\n337\t\t\tt.Fatalf(\"%s: expected exit 0 on SIGPIPE, got: %v\", bin, err)\n338\t\t}\n339\t}\n340\t\n341\tfunc b2hex(data []byte, size int) string {\n342\t\th, _ := blake2b.New(size, nil)\n343\t\th.Write(data)\n344\t\treturn hex.EncodeToString(h.Sum(nil))\n345\t}\n346\t\n347\tfunc writeFile(t *testing.T, path, content string) {\n348\t\tt.Helper()\n349\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n350\t\t\tt.Fatal(err)\n351\t\t}\n352\t}\n353\t"}]},"parent_tool_use_id":null,"session_id":"5201b03a-db3b-4801-9bf7-194da87787b8","uuid":"634e10e2-bab6-45bb-8eab-732238ebec7e","timestamp":"2026-05-23T11:27:17.663Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5512/cmd/b2sum/b2sum_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/hex\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"golang.org/x/crypto/blake2b\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gb2sum\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttmpDir := t.TempDir()\n\thelloFile := filepath.Join(tmpDir, \"hello.txt\")\n\twriteFile(t, helloFile, \"hello\\n\")\n\temptyFile := filepath.Join(tmpDir, \"empty.txt\")\n\twriteFile(t, emptyFile, \"\")\n\n\tdiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n\n\thello512 := b2hex([]byte(\"hello\\n\"), 64)\n\tempty512 := b2hex([]byte{}, 64)\n\thello256 := b2hex([]byte(\"hello\\n\"), 32)\n\tzeroHash := strings.Repeat(\"0\", 128)\n\n\tvalidChecksum := filepath.Join(tmpDir, \"valid.b2\")\n\twriteFile(t, validChecksum, fmt.Sprintf(\"%s  %s\\n\", hello512, helloFile))\n\n\tmultiChecksum := filepath.Join(tmpDir, \"multi.b2\")\n\twriteFile(t, multiChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", hello512, helloFile, empty512, emptyFile))\n\n\tmismatchChecksum := filepath.Join(tmpDir, \"mismatch.b2\")\n\twriteFile(t, mismatchChecksum, fmt.Sprintf(\"%s  %s\\n\", zeroHash, helloFile))\n\n\tbsdChecksum := filepath.Join(tmpDir, \"bsd.b2\")\n\twriteFile(t, bsdChecksum, fmt.Sprintf(\"BLAKE2b (%s) = %s\\n\", helloFile, hello512))\n\n\tmixedChecksum := filepath.Join(tmpDir, \"mixed.b2\")\n\twriteFile(t, mixedChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", hello512, helloFile, zeroHash, emptyFile))\n\n\tmalformedChecksum := filepath.Join(tmpDir, \"malformed.b2\")\n\twriteFile(t, malformedChecksum, fmt.Sprintf(\"this is not a checksum\\n%s  %s\\n\", hello512, helloFile))\n\n\tlen256Checksum := filepath.Join(tmpDir, \"len256.b2\")\n\twriteFile(t, len256Checksum, fmt.Sprintf(\"%s  %s\\n\", hello256, helloFile))\n\n\tbsd256Checksum := filepath.Join(tmpDir, \"bsd256.b2\")\n\twriteFile(t, bsd256Checksum, fmt.Sprintf(\"BLAKE2b-256 (%s) = %s\\n\", helloFile, hello256))\n\n\ttests := []testutils.DiffTest{\n\t\t// R1.1: single file, text mode (default)\n\t\t{\n\t\t\tName: \"single-file-text\",\n\t\t\tArgs: []string{helloFile},\n\t\t},\n\t\t// R1.1: single file, binary mode\n\t\t{\n\t\t\tName: \"single-file-binary\",\n\t\t\tArgs: []string{\"-b\", helloFile},\n\t\t},\n\t\t// R1.2: stdin with no arguments\n\t\t{\n\t\t\tName:  \"stdin-no-args\",\n\t\t\tStdin: []byte(\"abc\"),\n\t\t},\n\t\t// R1.2: stdin with explicit \"-\"\n\t\t{\n\t\t\tName:  \"stdin-dash\",\n\t\t\tArgs:  []string{\"-\"},\n\t\t\tStdin: []byte(\"abc\"),\n\t\t},\n\t\t// R1.3: BSD tag format\n\t\t{\n\t\t\tName: \"tag-format\",\n\t\t\tArgs: []string{\"--tag\", helloFile},\n\t\t},\n\t\t// R1.4: missing file exits 1\n\t\t{\n\t\t\tName:      \"missing-file\",\n\t\t\tArgs:      []string{filepath.Join(tmpDir, \"nonexistent.txt\")},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R1.4: missing file among valid files continues processing\n\t\t{\n\t\t\tName:      \"missing-among-valid\",\n\t\t\tArgs:      []string{helloFile, filepath.Join(tmpDir, \"nonexistent.txt\"), emptyFile},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R2.1: --check with valid checksum file\n\t\t{\n\t\t\tName:      \"check-valid\",\n\t\t\tArgs:      []string{\"--check\", validChecksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R2.1: --check with BSD tag format\n\t\t{\n\t\t\tName:      \"check-bsd-tag\",\n\t\t\tArgs:      []string{\"--check\", bsdChecksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R2.2: --check with mismatched hash exits 1\n\t\t{\n\t\t\tName:      \"check-mismatch\",\n\t\t\tArgs:      []string{\"--check\", mismatchChecksum},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R2.3: --check --warn with malformed lines\n\t\t{\n\t\t\tName:      \"check-warn-malformed\",\n\t\t\tArgs:      []string{\"--check\", \"--warn\", malformedChecksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R2.3: --check --quiet suppresses OK lines\n\t\t{\n\t\t\tName:      \"check-quiet-all-ok\",\n\t\t\tArgs:      []string{\"--check\", \"--quiet\", multiChecksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R2.3: --check --status suppresses all output\n\t\t{\n\t\t\tName:      \"check-status-ok\",\n\t\t\tArgs:      []string{\"--check\", \"--status\", validChecksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R2.3: --check --status exits 1 on failure\n\t\t{\n\t\t\tName:      \"check-status-fail\",\n\t\t\tArgs:      []string{\"--check\", \"--status\", mismatchChecksum},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\n\t\t// R3.1: binary mode with multiple files\n\t\t{\n\t\t\tName: \"binary-multiple-files\",\n\t\t\tArgs: []string{\"-b\", helloFile, emptyFile},\n\t\t},\n\t\t// R3.1: text mode explicit\n\t\t{\n\t\t\tName: \"text-mode-explicit\",\n\t\t\tArgs: []string{\"-t\", helloFile},\n\t\t},\n\n\t\t// R3.2: --tag produces BSD tag format regardless of -b\n\t\t{\n\t\t\tName: \"tag-overrides-binary\",\n\t\t\tArgs: []string{\"--tag\", \"-b\", helloFile},\n\t\t},\n\t\t// R3.2: --tag rejects explicit text mode\n\t\t{\n\t\t\tName:      \"tag-rejects-text\",\n\t\t\tArgs:      []string{\"--tag\", \"-t\", helloFile},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R3.2: --tag with -b and multiple files\n\t\t{\n\t\t\tName: \"tag-binary-multiple\",\n\t\t\tArgs: []string{\"--tag\", \"-b\", helloFile, emptyFile},\n\t\t},\n\n\t\t// R3.3: --length=256 produces 64-char hex digest\n\t\t{\n\t\t\tName: \"length-256\",\n\t\t\tArgs: []string{\"--length=256\", helloFile},\n\t\t},\n\t\t// R3.3: --length 256 (space-separated)\n\t\t{\n\t\t\tName: \"length-256-space\",\n\t\t\tArgs: []string{\"--length\", \"256\", helloFile},\n\t\t},\n\t\t// R3.3: --length=256 with --tag uses BLAKE2b-256\n\t\t{\n\t\t\tName: \"length-256-tag\",\n\t\t\tArgs: []string{\"--length=256\", \"--tag\", helloFile},\n\t\t},\n\t\t// R3.3: --length=128\n\t\t{\n\t\t\tName: \"length-128\",\n\t\t\tArgs: []string{\"--length=128\", helloFile},\n\t\t},\n\t\t// R3.3: --length=512 (explicit default)\n\t\t{\n\t\t\tName: \"length-512-explicit\",\n\t\t\tArgs: []string{\"--length=512\", helloFile},\n\t\t},\n\t\t// R3.3: invalid length (not multiple of 8) exits 1\n\t\t{\n\t\t\tName:      \"length-invalid-not-mult-8\",\n\t\t\tArgs:      []string{\"--length=7\", helloFile},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R3.3: invalid length (zero) exits 1\n\t\t{\n\t\t\tName:      \"length-invalid-zero\",\n\t\t\tArgs:      []string{\"--length=0\", helloFile},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R3.3: invalid length (exceeds 512) exits 1\n\t\t{\n\t\t\tName:      \"length-invalid-too-large\",\n\t\t\tArgs:      []string{\"--length=520\", helloFile},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R3.3: invalid length (negative) exits 1\n\t\t{\n\t\t\tName:      \"length-invalid-negative\",\n\t\t\tArgs:      []string{\"--length=-8\", helloFile},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R3.3: --length=256 with --check\n\t\t{\n\t\t\tName:      \"length-256-check\",\n\t\t\tArgs:      []string{\"--length=256\", \"--check\", len256Checksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R3.3: --length=256 with --check BSD tag format\n\t\t{\n\t\t\tName:      \"length-256-check-bsd\",\n\t\t\tArgs:      []string{\"--length=256\", \"--check\", bsd256Checksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\n\t\t// R4.1: exit 0 when all files processed successfully\n\t\t{\n\t\t\tName: \"exit-0-all-ok\",\n\t\t\tArgs: []string{helloFile, emptyFile},\n\t\t},\n\t\t// R4.1: exit 0 when all verified digests match\n\t\t{\n\t\t\tName:      \"exit-0-check-all-match\",\n\t\t\tArgs:      []string{\"--check\", multiChecksum},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\n\t\t// R4.2: exit 1 when any file cannot be opened\n\t\t{\n\t\t\tName:      \"exit-1-missing-file\",\n\t\t\tArgs:      []string{filepath.Join(tmpDir, \"no-such-file.txt\")},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R4.2: exit 1 when any digest fails verification\n\t\t{\n\t\t\tName:      \"exit-1-check-fail\",\n\t\t\tArgs:      []string{\"--check\", mismatchChecksum},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R4.2: exit 1 when checksum file is unreadable\n\t\t{\n\t\t\tName:      \"exit-1-check-unreadable\",\n\t\t\tArgs:      []string{\"--check\", filepath.Join(tmpDir, \"nonexistent.b2\")},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t\t// R4.2: exit 1 mixed valid/invalid in check\n\t\t{\n\t\t\tName:      \"exit-1-check-mixed\",\n\t\t\tArgs:      []string{\"--check\", mixedChecksum},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc TestSIGPIPE(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tdir := t.TempDir()\n\tlargePath := filepath.Join(dir, \"large.dat\")\n\tif err := os.WriteFile(largePath, bytes.Repeat([]byte(\"x\\n\"), 500000), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Run(\"go\", func(t *testing.T) { testSIGPIPE(t, goBin, largePath) })\n\tif refBin, err := exec.LookPath(\"gb2sum\"); err == nil {\n\t\tt.Run(\"ref\", func(t *testing.T) { testSIGPIPE(t, refBin, largePath) })\n\t}\n}\n\nfunc testSIGPIPE(t *testing.T, bin, filePath string) {\n\tt.Helper()\n\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\tdefer cancel()\n\tcmd := exec.CommandContext(ctx, bin, filePath)\n\tstdout, err := cmd.StdoutPipe()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := cmd.Start(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbuf := make([]byte, 1)\n\tif _, err := io.ReadFull(stdout, buf); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstdout.Close()\n\terr = cmd.Wait()\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatalf(\"%s timed out; SIGPIPE handler may not be installed\", bin)\n\t}\n\tif err != nil {\n\t\tt.Fatalf(\"%s: expected exit 0 on SIGPIPE, got: %v\", bin, err)\n\t}\n}\n\nfunc b2hex(data []byte, size int) string {\n\th, _ := blake2b.New(size, nil)\n\th.Write(data)\n\treturn hex.EncodeToString(h.Sum(nil))\n}\n\nfunc writeFile(t *testing.T, path, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n","numLines":353,"startLine":1,"totalLines":353}}}
