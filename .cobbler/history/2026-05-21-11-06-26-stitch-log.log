{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011tQXVxMF8gGL8N2iudNmYb","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"strconv\"\n11\t\t\"strings\"\n12\t\t\"syscall\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype options struct {\n19\t\tsignal         syscall.Signal\n20\t\tkillAfter      time.Duration\n21\t\tforeground     bool\n22\t\tpreserveStatus bool\n23\t\tduration       time.Duration\n24\t\tcmdArgs        []string\n25\t}\n26\t\n27\tfunc main() {\n28\t\tsys.InstallSIGPIPEHandler()\n29\t\n30\t\topts, exitCode := parseArgs(os.Args[1:])\n31\t\tif exitCode >= 0 {\n32\t\t\tos.Exit(exitCode)\n33\t\t}\n34\t\n35\t\tcmd := exec.Command(opts.cmdArgs[0], opts.cmdArgs[1:]...)\n36\t\tcmd.Stdin = os.Stdin\n37\t\tcmd.Stdout = os.Stdout\n38\t\tcmd.Stderr = os.Stderr\n39\t\tif !opts.foreground {\n40\t\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n41\t\t}\n42\t\n43\t\tif err := cmd.Start(); err != nil {\n44\t\t\tif isNotFound(err) {\n45\t\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", opts.cmdArgs[0], err)\n46\t\t\t\tos.Exit(127)\n47\t\t\t}\n48\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", opts.cmdArgs[0], err)\n49\t\t\tos.Exit(126)\n50\t\t}\n51\t\n52\t\tos.Exit(runWithTimeout(cmd, opts))\n53\t}\n54\t\n55\tfunc runWithTimeout(cmd *exec.Cmd, opts options) int {\n56\t\ttimedOut := false\n57\t\tvar timer *time.Timer\n58\t\tvar killTimer *time.Timer\n59\t\n60\t\tif opts.duration > 0 {\n61\t\t\ttimer = time.AfterFunc(opts.duration, func() {\n62\t\t\t\ttimedOut = true\n63\t\t\t\tsendSignal(cmd, opts.signal, opts.foreground)\n64\t\t\t\tif opts.signal == syscall.SIGKILL {\n65\t\t\t\t\t_ = syscall.Kill(os.Getpid(), syscall.SIGKILL)\n66\t\t\t\t}\n67\t\t\t\tif opts.killA