rgs, i, &opts)\n146\t\t\tif consumed < 0 {\n147\t\t\t\treturn opts, 125\n148\t\t\t}\n149\t\t\ti += consumed\n150\t\t}\n151\t\n152\t\tremaining := args[i:]\n153\t\tif len(remaining) < 2 {\n154\t\t\tfmt.Fprintf(os.Stderr, \"timeout: missing operand\\nTry 'timeout --help' for more information.\\n\")\n155\t\t\treturn opts, 125\n156\t\t}\n157\t\n158\t\tdur, err := parseDuration(remaining[0])\n159\t\tif err != nil {\n160\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", remaining[0])\n161\t\t\treturn opts, 125\n162\t\t}\n163\t\topts.duration = dur\n164\t\topts.cmdArgs = remaining[1:]\n165\t\treturn opts, -1\n166\t}\n167\t\n168\tfunc parseLongFlag(arg string, args []string, i int, opts *options) int {\n169\t\tswitch {\n170\t\tcase arg == \"--foreground\":\n171\t\t\topts.foreground = true\n172\t\t\treturn 1\n173\t\tcase arg == \"--preserve-status\":\n174\t\t\topts.preserveStatus = true\n175\t\t\treturn 1\n176\t\tcase arg == \"--signal\":\n177\t\t\treturn parseLongValue(\"--signal\", args, i, func(v string) int {\n178\t\t\t\treturn applySignal(v, opts)\n179\t\t\t})\n180\t\tcase strings.HasPrefix(arg, \"--signal=\"):\n181\t\t\treturn applySignal(arg[len(\"--signal=\"):], opts)\n182\t\tcase arg == \"--kill-after\":\n183\t\t\treturn parseLongValue(\"--kill-after\", args, i, func(v string) int {\n184\t\t\t\treturn applyKillAfter(v, opts)\n185\t\t\t})\n186\t\tcase strings.HasPrefix(arg, \"--kill-after=\"):\n187\t\t\treturn applyKillAfter(arg[len(\"--kill-after=\"):], opts)\n188\t\t}\n189\t\treturn 0\n190\t}\n191\t\n192\tfunc parseLongValue(name string, args []string, i int, apply func(string) int) int {\n193\t\tif i+1 >= len(args) {\n194\t\t\tfmt.Fprintf(os.Stderr, \"timeout: option %q requires an argument\\n\", name)\n195\t\t\treturn -1\n196\t\t}\n197\t\tresult := apply(args[i+1])\n198\t\tif result < 0 {\n199\t\t\treturn -1\n200\t\t}\n201\t\treturn 2\n202\t}\n203\t\n204\tfunc parseShortFlags(arg string, args []string, i int, opts *options) int {\n205\t\tflags