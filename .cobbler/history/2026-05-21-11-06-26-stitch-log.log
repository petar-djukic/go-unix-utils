{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PasPnHnxFq68vZjnftkxPX","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"strconv\"\n11\t\t\"strings\"\n12\t\t\"syscall\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tfunc main() {\n19\t\tsys.InstallSIGPIPEHandler()\n20\t\n21\t\targs := os.Args[1:]\n22\t\tif len(args) < 2 {\n23\t\t\tfmt.Fprintf(os.Stderr, \"timeout: missing operand\\nTry 'timeout --help' for more information.\\n\")\n24\t\t\tos.Exit(125)\n25\t\t}\n26\t\n27\t\tduration, err := parseDuration(args[0])\n28\t\tif err != nil {\n29\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", args[0])\n30\t\t\tos.Exit(125)\n31\t\t}\n32\t\n33\t\tcmdArgs := args[1:]\n34\t\tcmd := exec.Command(cmdArgs[0], cmdArgs[1:]...)\n35\t\tcmd.Stdin = os.Stdin\n36\t\tcmd.Stdout = os.Stdout\n37\t\tcmd.Stderr = os.Stderr\n38\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n39\t\n40\t\tif err := cmd.Start(); err != nil {\n41\t\t\tif isNotFound(err) {\n42\t\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", cmdArgs[0], err)\n43\t\t\t\tos.Exit(127)\n44\t\t\t}\n45\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", cmdArgs[0], err)\n46\t\t\tos.Exit(126)\n47\t\t}\n48\t\n49\t\ttimedOut := false\n50\t\tvar timer *time.Timer\n51\t\tif duration > 0 {\n52\t\t\ttimer = time.AfterFunc(duration, func() {\n53\t\t\t\ttimedOut = true\n54\t\t\t\t_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGTERM)\n55\t\t\t})\n56\t\t}\n57\t\n58\t\twaitErr := cmd.Wait()\n59\t\tif timer != nil {\n60\t\t\ttimer.Stop()\n61\t\t}\n62\t\n63\t\tif waitErr == nil {\n64\t\t\tos.Exit(0)\n65\t\t}\n66\t\n67\t\texitErr, ok := waitErr.(*exec.ExitError)\n68\t\tif !ok {\n69\t\t\tfmt.Fprintf(os.Stderr, \"timeout: %v\\n\", waitErr)\n70\t\t\tos.Exit(125)\n71\t\t}\n72\t\n73\t\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n74\t\tif !ok {\n75\t\t\tos.Exit(exitErr.ExitCode())\n76\t\t}\n77\t\n78\t\tif status.Signaled() {\n79\t\t\tsignum := int(status.Signal())\n80\t\t\tif timedOut && status.Signal() == syscall.SIGTERM {\n81\t\t\t\tos.Exit(124)\n82\t\t\t}\n83\t\t\tos.Exit(128 + signum)\n84\t\t}\n85\t\n86\t\tos.Exit(exitErr.ExitCode())\n87\t}\n88\t\n89\tfunc parseDuration(s string) (time.Duration, error) {\n90\t\tif s == \"\" {\n91\t\t\treturn 0, fmt.Errorf(\"empty duration\")\n92\t\t}\n93\t\n94\t\tmultiplier := time.Second\n95\t\tnumStr := s\n96\t\n97\t\tif len(s) > 0 {\n98\t\t\tlast := s[len(s)-1]\n99\t\t\tswitch last {\n100\t\t\tcase 's':\n101\t\t\t\tmultiplier = time.Second\n102\t\t\t\tnumStr = s[:len(s)-1]\n103\t\t\tcase 'm':\n104\t\t\t\tmultiplier = time.Minute\n105\t\t\t\tnumStr = s[:len(s)-1]\n106\t\t\tcase 'h':\n107\t\t\t\tmultiplier = time.Hour\n108\t\t\t\tnumStr = s[:len(s)-1]\n109\t\t\tcase 'd':\n110\t\t\t\tmultiplier = 24 * time.Hour\n111\t\t\t\tnumStr = s[:len(s)-1]\n112\t\t\t}\n113\t\t}\n114\t\n115\t\tif numStr == \"\" {\n116\t\t\tnumStr = \"1\"\n117\t\t}\n118\t\n119\t\tval, err := strconv.ParseFloat(numStr, 64)\n120\t\tif err != nil {\n121\t\t\treturn 0, err\n122\t\t}\n123\t\n124\t\tif val < 0 {\n125\t\t\treturn 0, fmt.Errorf(\"negative duration\")\n126\t\t}\n127\t\n128\t\treturn time.Duration(val * float64(multiplier)), nil\n129\t}\n130\t\n131\tfunc isNotFound(err error) bool {\n132\t\treturn strings.Contains(err.Error(), exec.ErrNotFound.Error())\n133\t}\n134\t"}]},"parent_tool_use_id":null,"session_id":"0257407e-6ee4-42e2-a7f2-a490be4c0a8c","uuid":"f9a3f8ba-b87a-4e81-b267-8d45cbfb1b61","timestamp":"2026-05-21T15:06:35.971Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5424/cmd/timeout/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\targs := os.Args[1:]\n\tif len(args) < 2 {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: missing operand\\nTry 'timeout --help' for more information.\\n\")\n\t\tos.Exit(125)\n\t}\n\n\tduration, err := parseDuration(args[0])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", args[0])\n\t\tos.Exit(125)\n\t}\n\n\tcmdArgs := args[1:]\n\tcmd := exec.Command(cmdArgs[0], cmdArgs[1:]...)\n\tcmd.Stdin = os.Stdin\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n\n\tif err := cmd.Start(); err != nil {\n\t\tif isNotFound(err) {\n\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", cmdArgs[0], err)\n\t\t\tos.Exit(127)\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", cmdArgs[0], err)\n\t\tos.Exit(126)\n\t}\n\n\ttimedOut := false\n\tvar timer *time.Timer\n\tif duration > 0 {\n\t\ttimer = time.AfterFunc(duration, func() {\n\t\t\ttimedOut = true\n\t\t\t_ = syscall.Kill(-cmd.Process.Pid, syscall.SIGTERM)\n\t\t})\n\t}\n\n\twaitErr := cmd.Wait()\n\tif timer != nil {\n\t\ttimer.Stop()\n\t}\n\n\tif waitErr == nil {\n\t\tos.Exit(0)\n\t}\n\n\texitErr, ok := waitErr.(*exec.ExitError)\n\tif !ok {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: %v\\n\", waitErr)\n\t\tos.Exit(125)\n\t}\n\n\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n\tif !ok {\n\t\tos.Exit(exitErr.ExitCode())\n\t}\n\n\tif status.Signaled() {\n\t\tsignum := int(status.Signal())\n\t\tif timedOut && status.Signal() == syscall.SIGTERM {\n\t\t\tos.Exit(124)\n\t\t}\n\t\tos.Exit(128 + signum)\n\t}\n\n\tos.Exit(exitErr.ExitCode())\n}\n\nfunc parseDuration(s string) (time.Duration, error) {\n\tif s == \"\" {\n\t\treturn 0, fmt.Errorf(\"empty duration\")\n\t}\n\n\tmultiplier := time.Second\n\tnumStr := s\n\n\tif len(s) > 0 {\n\t\tlast := s[len(s)-1]\n\t\tswitch last {\n\t\tcase 's':\n\t\t\tmultiplier = time.Second\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'm':\n\t\t\tmultiplier = time.Minute\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'h':\n\t\t\tmultiplier = time.Hour\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'd':\n\t\t\tmultiplier = 24 * time.Hour\n\t\t\tnumStr = s[:len(s)-1]\n\t\t}\n\t}\n\n\tif numStr == \"\" {\n\t\tnumStr = \"1\"\n\t}\n\n\tval, err := strconv.ParseFloat(numStr, 64)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\tif val < 0 {\n\t\treturn 0, fmt.Errorf(\"negative duration\")\n\t}\n\n\treturn time.Duration(val * float64(multiplier)), nil\n}\n\nfunc isNotFound(err error) bool {\n\treturn strings.Contains(err.Error(), exec.ErrNotFound.Error())\n}\n","numLines":134,"startLine":1,"totalLines":134}}}
