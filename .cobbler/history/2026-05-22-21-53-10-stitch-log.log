{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GhpSVvUzrpfk3RdYecv3aJ","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"context\"\n9\t\t\"crypto/sha1\"\n10\t\t\"encoding/hex\"\n11\t\t\"fmt\"\n12\t\t\"io\"\n13\t\t\"os\"\n14\t\t\"os/exec\"\n15\t\t\"path/filepath\"\n16\t\t\"testing\"\n17\t\t\"time\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n20\t)\n21\t\n22\tfunc TestDiff(t *testing.T) {\n23\t\tgoBin := testutils.BuildBinary(t, \".\")\n24\t\trefBin, err := exec.LookPath(\"gsha1sum\")\n25\t\tif err != nil {\n26\t\t\tt.Skip(\"reference binary not found\")\n27\t\t}\n28\t\n29\t\ttmpDir := t.TempDir()\n30\t\thelloFile := filepath.Join(tmpDir, \"hello.txt\")\n31\t\tif err := os.WriteFile(helloFile, []byte(\"hello\\n\"), 0o644); err != nil {\n32\t\t\tt.Fatal(err)\n33\t\t}\n34\t\temptyFile := filepath.Join(tmpDir, \"empty.txt\")\n35\t\tif err := os.WriteFile(emptyFile, []byte{}, 0o644); err != nil {\n36\t\t\tt.Fatal(err)\n37\t\t}\n38\t\n39\t\tdiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n40\t\n41\t\thelloHash := sha1hex([]byte(\"hello\\n\"))\n42\t\temptyHash := sha1hex([]byte{})\n43\t\n44\t\tvalidChecksum := filepath.Join(tmpDir, \"valid.sha1\")\n45\t\twriteFile(t, validChecksum, fmt.Sprintf(\"%s  %s\\n\", helloHash, helloFile))\n46\t\n47\t\tmultiChecksum := filepath.Join(tmpDir, \"multi.sha1\")\n48\t\twriteFile(t, multiChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", helloHash, helloFile, emptyHash, emptyFile))\n49\t\n50\t\tmismatchChecksum := filepath.Join(tmpDir, \"mismatch.sha1\")\n51\t\twriteFile(t, mismatchChecksum, fmt.Sprintf(\"%s  %s\\n\", \"0000000000000000000000000000000000000000\", helloFile))\n52\t\n53\t\tmixedChecksum := filepath.Join(tmpDir, \"mixed.sha1\")\n54\t\twriteFile(t, mixedChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", helloHash, helloFile, \"0000000000000000000000000000000000000000\", emptyFile))\n55\t\n56\t\tmalformedChecksum := filepath.Join(tmpDir, \"malformed.sha1\")\n57\t\twriteFile(t, malformedChecksum, fmt.Sprintf(\"this is not a checksum\\n%s  %s\\n\", helloHash, helloFile))\n58\t\n59\t\tbsdChecksum := filepath.Join(tmpDir, \"bsd.sha1\")\n60\t\twriteFile(t, bsdChecksum, fmt.Sprintf(\"SHA1 (%s) = %s\\n\", helloFile, helloHash))\n61\t\n62\t\ttests := []testutils.DiffTest{\n63\t\t\t// R1.2: stdin with no arguments\n64\t\t\t{\n65\t\t\t\tName:  \"stdin-no-args\",\n66\t\t\t\tStdin: []byte(\"abc\"),\n67\t\t\t},\n68\t\t\t// R1.2: stdin with explicit \"-\"\n69\t\t\t{\n70\t\t\t\tName:  \"stdin-dash\",\n71\t\t\t\tArgs:  []string{\"-\"},\n72\t\t\t\tStdin: []byte(\"abc\"),\n73\t\t\t},\n74\t\t\t// R1.1: single file, text mode (default)\n75\t\t\t{\n76\t\t\t\tName: \"single-file-text\",\n77\t\t\t\tArgs: []string{helloFile},\n78\t\t\t},\n79\t\t\t// R1.1: single file, binary mode\n80\t\t\t{\n81\t\t\t\tName: \"single-file-binary\",\n82\t\t\t\tArgs: []string{\"-b\", helloFile},\n83\t\t\t},\n84\t\t\t// R1.3: BSD tag format\n85\t\t\t{\n86\t\t\t\tName: \"tag-format\",\n87\t\t\t\tArgs: []string{\"--tag\", helloFile},\n88\t\t\t},\n89\t\t\t// R1.3: tag with binary flag (mode flag has no effect on tag)\n90\t\t\t{\n91\t\t\t\tName: \"tag-with-binary\",\n92\t\t\t\tArgs: []string{\"--tag\", \"-b\", helloFile},\n93\t\t\t},\n94\t\t\t// R1.1: multiple files\n95\t\t\t{\n96\t\t\t\tName: \"multiple-files\",\n97\t\t\t\tArgs: []string{helloFile, emptyFile},\n98\t\t\t},\n99\t\t\t// R1.2: empty stdin\n100\t\t\t{\n101\t\t\t\tName:  \"empty-stdin\",\n102\t\t\t\tStdin: []byte{},\n103\t\t\t},\n104\t\t\t// R1.1: empty file\n105\t\t\t{\n106\t\t\t\tName: \"empty-file\",\n107\t\t\t\tArgs: []string{emptyFile},\n108\t\t\t},\n109\t\t\t// R1.4: missing file exits 1, prints error to stderr\n110\t\t\t{\n111\t\t\t\tName:      \"missing-file\",\n112\t\t\t\tArgs:      []string{filepath.Join(tmpDir, \"nonexistent.txt\")},\n113\t\t\t\tExitCod