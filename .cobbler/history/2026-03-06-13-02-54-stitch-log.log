\n\\tb\\n\"\n   116→      env: [\"LC_ALL=C\"]\n   117→    normalization: none\n   118→    expected:\n   119→      exit_code: 0\n   120→      stdout: \"        a\\n        b\\n\"\n   121→      stderr: \"\"\n   122→    traces:\n   123→      - prd024-expand R1.4\n   124→\n   125→  # ---- unexpand ----\n   126→\n   127→  - name: unexpand_leading_spaces_to_tab\n   128→    description: Eight leading spaces convert to one tab.\n   129→    inputs:\n   130→      args: []\n   131→      stdin: \"        text\\n\"\n   132→      env: [\"LC_ALL=C\"]\n   133→    normalization: none\n   134→    expected:\n   135→      exit_code: 0\n   136→      stdout: \"\\ttext\\n\"\n   137→      stderr: \"\"\n   138→    traces:\n   139→      - prd025-unexpand R1.1\n   140→\n   141→  - name: unexpand_nonleading_spaces_unchanged\n   142→    description: Non-leading spaces are not converted in default mode.\n   143→    inputs:\n   144→      args: []\n   145→      stdin: \"a        b\\n\"\n   146→      env: [\"LC_ALL=C\"]\n   147→    normalization: none\n   148→    expected:\n   149→      exit_code: 0\n   150→      stdout: \"a        b\\n\"\n   151→      stderr: \"\"\n   152→    traces:\n   153→      - prd025-unexpand R1.2\n   154→\n   155→  - name: unexpand_all_mode\n   156→    description: -a converts non-leading space runs at tab stop boundaries.\n   157→    inputs:\n   158→      args: [\"-a\"]\n   159→      stdin: \"a        b\\n\"\n   160→      env: [\"LC_ALL=C\"]\n   161→    normalization: none\n   162→    expected:\n   163→      exit_code: 0\n   164→      stdout: \"a\\tb\\n\"\n   165→      stderr: \"\"\n   166→    traces:\n   167→      - prd025-unexpand R2.1\n   168→\n   169→  - name: unexpand_partial_spaces_preserved\n   170→    description: A run of spaces not reaching a tab stop is preserved.\n   171→    inputs:\n   172→      args: []\n   173→      stdin: \"   text\\n\"\n   174→      env: [\"LC_ALL=C\"]\n   175→    normalization: none\n   176→    expected:\n   177→      exit_code: 0\n   178