{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E3jXstVLSzRRtTDtphnJ35","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package main implements the unexpand utility (prd025-unexpand R1-R4).\n     5→// unexpand converts spaces to tabs, reading from files or stdin,\n     6→// with configurable tab stop positions via the -t flag.\n     7→package main\n     8→\n     9→import (\n    10→\t\"bufio\"\n    11→\t\"fmt\"\n    12→\t\"io\"\n    13→\t\"os\"\n    14→\t\"strconv\"\n    15→\t\"strings\"\n    16→\n    17→\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n    18→)\n    19→\n    20→// defaultTabStop is the default tab stop interval.\n    21→const defaultTabStop = 8\n    22→\n    23→func main() {\n    24→\t// R4.4: Handle SIGPIPE gracefully.\n    25→\tsys.InstallSIGPIPEHandler()\n    26→\n    27→\tvar tabStops []int\n    28→\tallMode := false\n    29→\tfirstOnlyExplicit := false\n    30→\n    31→\targs := os.Args[1:]\n    32→\tvar files []string\n    33→\n    34→\t// Manual flag parsing to match GNU unexpand behavior.\n    35→\ti := 0\n    36→\tfor i < len(args) {\n    37→\t\targ := args[i]\n    38→\t\tif arg == \"--\" {\n    39→\t\t\tfiles = append(files, args[i+1:]...)\n    40→\t\t\tbreak\n    41→\t\t}\n    42→\t\tif arg == \"--help\" {\n    43→\t\t\tfmt.Println(\"Usage: unexpand [OPTION]... [FILE]...\")\n    44→\t\t\tfmt.Println(\"Convert blanks in each FILE to tabs, writing to standard output.\")\n    45→\t\t\tfmt.Println()\n    46→\t\t\tfmt.Println(\"  -a, --all           convert all blanks, instead of just initial blanks\")\n    47→\t\t\tfmt.Println(\"      --first-only    convert only leading sequences of blanks (default)\")\n    48→\t\t\tfmt.Println(\"  -t, --tabs=N        have tabs N characters apart, not 8\")\n    49→\t\t\tfmt.Println(\"  -t, --tabs=LIST     use comma separated list of tab positions\")\n    50→\t\t\tfmt.Println(\"      --help          display this help and exit\")\n    51→\t\t\tfmt.Println(\"      --version       output version information and exit\")\n    52→\t\t\tos.Exit(0)\n    53→\t\t}\n    54→\t\tif arg == \"--version\" {\n    55→\t\t\tfmt.Println(\"unexpand (go-unix-utils) 0.1\")\n    56→\t\t\tos.Exit(0)\n    57→\t\t}\n    58→\t\tif arg == \"--all\" {\n    59→\t\t\tallMode = true\n    60→\t\t\ti++\n    61→\t\t\tcontinue\n    62→\t\t}\n    63→\t\tif arg == \"--first-only\" {\n    64→\t\t\tfirstOnlyExplicit = true\n    65→\t\t\ti++\n    66→\t\t\tcontinue\n    67→\t\t}\n    68→\t\tif strings.HasPrefix(arg, \"--tabs=\") {\n    69→\t\t\tval := arg[len(\"--tabs=\"):]\n    70→\t\t\ttabStops = parseTabStops(val)\n    71→\t\t\ti++\n    72→\t\t\tcontinue\n    73→\t\t}\n    74→\t\tif arg == \"--tabs\" {\n    75→\t\t\ti++\n    76→\t\t\tif i >= len(args) {\n    77→\t\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: option '--tabs' requires an argument\\n\")\n    78→\t\t\t\tos.Exit(1)\n    79→\t\t\t}\n    80→\t\t\ttabStops = parseTabStops(args[i])\n    81→\t\t\ti++\n    82→\t\t\tcontinue\n    83→\t\t}\n    84→\t\tif len(arg) == 0 || arg[0] != '-' || arg == \"-\" {\n    85→\t\t\tfiles = append(files, arg)\n    86→\t\t\ti++\n    87→\t\t\tcontinue\n    88→\t\t}\n    89→\n    90→\t\t// Parse short flags from the argument.\n    91→\t\tj := 1\n    92→\t\tfor j < len(arg) {\n    93→\t\t\tswitch arg[j] {\n    94→\t\t\tcase 'a':\n    95→\t\t\t\t// R2: -a converts all whitespace runs.\n    96→\t\t\t\tallMode = true\n    97→\t\t\t\tj++\n    98→\t\t\tcase 't':\n    99→\t\t\t\t// R3: -t sets tab stops and implies -a.\n   100→\t\t\t\tval := arg[j+1:]\n   101→\t\t\t\tif val == \"\" {\n   102→\t\t\t\t\ti++\n   103→\t\t\t\t\tif i >= len(args) {\n   104→\t\t\t\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: option requires an argument -- 't'\\n\")\n   105→\t\t\t\t\t\tos.Exit(1)\n   106→\t\t\t\t\t}\n   107→\t\t\t\t\tval = args[i]\n   108→\t\t\t\t}\n   109→\t\t\t\ttabStops = parseTabStops(val)\n   110→\t\t\t\tj = len(arg) // consumed rest of arg\n   111→\t\t\tdefault:\n   112→\t\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: invalid option -- '%c'\\n\", arg[j])\n   113→\t\t\t\tos.Exit(1)\n   114→\t\t\t}\n   115→\t\t}\n   116→\t\ti++\n   117→\t}\n   118→\n   119→\t// R3.3: -t implies -a.\n   120→\tif len(tabStops) > 0 && !firstOnlyExplicit {\n   121→\t\tallMode = true\n   122→\t}\n   123→\n   124→\t// Read stdin when no file arguments are given.\n   125→\tif len(files) == 0 {\n   126→\t\tfiles = []string{\"-\"}\n   127→\t}\n   128→\n   129→\t// Build effective tab stop configuration.\n   130→\tif len(tabStops) == 0 {\n   131→\t\ttabStops = []int{defaultTabStop}\n   132→\t}\n   133→\n   134→\texitCode := 0\n   135→\tw := bufio.NewWriter(os.Stdout)\n   136→\n   137→\tfor _, file := range files {\n   138→\t\tr, err := openInput(file)\n   139→\t\tif err != nil {\n   140→\t\t\t// R4.2: Print error to stderr, continue processing remaining files.\n   141→\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: %v\\n\", err)\n   142→\t\t\texitCode = 1\n   143→\t\t\tcontinue\n   144→\t\t}\n   145→\n   146→\t\tif err := unexpandInput(r, w, tabStops, allMode); err != nil {\n   147→\t\t\t// R4.3: Exit 1 on write error.\n   148→\t\t\tos.Exit(1)\n   149→\t\t}\n   150→\n   151→\t\tif closer, ok := r.(io.Closer); ok && file != \"-\" {\n   152→\t\t\t_ = closer.Close() // best-effort close\n   153→\t\t}\n   154→\t}\n   155→\n   156→\tif err := w.Flush(); err != nil {\n   157→\t\tos.Exit(1)\n   158→\t}\n   159→\n   160→\tos.Exit(exitCode)\n   161→}\n   162→\n   163→// openInput returns a reader for the named file, or stdin if name is \"-\".\n   164→func openInput(name string) (io.Reader, error) {\n   165→\tif name == \"-\" {\n   166→\t\treturn os.Stdin, nil\n   167→\t}\n   168→\treturn os.Open(name)\n   169→}\n   170→\n   171→// parseTabStops parses a tab stop specification: either a single number\n   172→// (uniform interval) or a comma-separated list of absolute positions.\n   173→func parseTabStops(s string) []int {\n   174→\tparts := strings.Split(s, \",\")\n   175→\tstops := make([]int, 0, len(parts))\n   176→\tfor _, p := range parts {\n   177→\t\tp = strings.TrimSpace(p)\n   178→\t\tn, err := strconv.Atoi(p)\n   179→\t\tif err != nil || n <= 0 {\n   180→\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: tab size contains invalid character(s): '%s'\\n\", s)\n   181→\t\t\tos.Exit(1)\n   182→\t\t}\n   183→\t\tstops = append(stops, n)\n   184→\t}\n   185→\treturn stops\n   186→}\n   187→\n   188→// nextTabStop returns the next tab stop column position given the current column\n   189→// (0-indexed) and the tab stop configuration.\n   190→// Single value means uniform interval; multiple values are absolute positions.\n   191→func nextTabStop(col int, stops []int) int {\n   192→\tif len(stops) == 1 {\n   193→\t\tinterval := stops[0]\n   194→\t\treturn col + (interval - col%interval)\n   195→\t}\n   196→\t// Absolute positions (1-indexed in spec, 0-indexed internally).\n   197→\tfor _, s := range stops {\n   198→\t\tpos := s - 1\n   199→\t\tif pos > col {\n   200→\t\t\treturn pos\n   201→\t\t}\n   202→\t}\n   203→\t// R3.2: Past the last explicit stop, no tab can be inserted.\n   204→\treturn -1\n   205→}\n   206→\n   207→// unexpandInput reads from r and writes tab-unexpanded output to w.\n   208→// R1: Default mode converts only leading whitespace.\n   209→// R2: allMode converts all whitespace runs throughout the line.\n   210→func unexpandInput(r io.Reader, w *bufio.Writer, stops []int, allMode bool) error {\n   211→\tbr := bufio.NewReader(r)\n   212→\tcol := 0\n   213→\tinLeading := true  // tracks whether we are still in leading whitespace\n   214→\tspaceRun := 0      // number of accumulated spaces\n   215→\tspaceStartCol := 0 // column where the current space run started\n   216→\n   217→\tflushSpaces := func() error {\n   218→\t\tfor range spaceRun {\n   219→\t\t\tif writeErr := w.WriteByte(' '); writeErr != nil {\n   220→\t\t\t\treturn writeErr\n   221→\t\t\t}\n   222→\t\t}\n   223→\t\tspaceRun = 0\n   224→\t\treturn nil\n   225→\t}\n   226→\n   227→\tconvertSpaces := func() error {\n   228→\t\t// Try to replace accumulated spaces with tabs where possible.\n   229→\t\tcurCol := spaceStartCol\n   230→\t\ttarget := curCol + spaceRun\n   231→\n   232→\t\tfor curCol < target {\n   233→\t\t\tnext := nextTabStop(curCol, stops)\n   234→\t\t\tif next == -1 || next > target {\n   235→\t\t\t\t// Can't reach next tab stop; emit remaining as spaces.\n   236→\t\t\t\tfor curCol < target {\n   237→\t\t\t\t\tif writeErr := w.WriteByte(' '); writeErr != nil {\n   238→\t\t\t\t\t\treturn writeErr\n   239→\t\t\t\t\t}\n   240→\t\t\t\t\tcurCol++\n   241→\t\t\t\t}\n   242→\t\t\t} else {\n   243→\t\t\t\t// We can reach this tab stop; emit a tab.\n   244→\t\t\t\tif writeErr := w.WriteByte('\\t'); writeErr != nil {\n   245→\t\t\t\t\treturn writeErr\n   246→\t\t\t\t}\n   247→\t\t\t\tcurCol = next\n   248→\t\t\t}\n   249→\t\t}\n   250→\t\tspaceRun = 0\n   251→\t\treturn nil\n   252→\t}\n   253→\n   254→\tfor {\n   255→\t\tb, err := br.ReadByte()\n   256→\t\tif err != nil {\n   257→\t\t\tif err == io.EOF {\n   258→\t\t\t\t// Flush any remaining spaces.\n   259→\t\t\t\tif spaceRun > 0 {\n   260→\t\t\t\t\tif allMode || inLeading {\n   261→\t\t\t\t\t\treturn convertSpaces()\n   262→\t\t\t\t\t}\n   263→\t\t\t\t\treturn flushSpaces()\n   264→\t\t\t\t}\n   265→\t\t\t\treturn nil\n   266→\t\t\t}\n   267→\t\t\treturn err\n   268→\t\t}\n   269→\n   270→\t\tswitch {\n   271→\t\tcase b == '\\n':\n   272→\t\t\t// Flush accumulated spaces before newline.\n   273→\t\t\tif spaceRun > 0 {\n   274→\t\t\t\tif allMode || inLeading {\n   275→\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n   276→\t\t\t\t\t\treturn writeErr\n   277→\t\t\t\t\t}\n   278→\t\t\t\t} else {\n   279→\t\t\t\t\tif writeErr := flushSpaces(); writeErr != nil {\n   280→\t\t\t\t\t\treturn writeErr\n   281→\t\t\t\t\t}\n   282→\t\t\t\t}\n   283→\t\t\t}\n   284→\t\t\tif writeErr := w.WriteByte('\\n'); writeErr != nil {\n   285→\t\t\t\treturn writeErr\n   286→\t\t\t}\n   287→\t\t\tcol = 0\n   288→\t\t\tinLeading = true\n   289→\n   290→\t\tcase b == ' ':\n   291→\t\t\tif allMode || inLeading {\n   292→\t\t\t\tif spaceRun == 0 {\n   293→\t\t\t\t\tspaceStartCol = col\n   294→\t\t\t\t}\n   295→\t\t\t\tspaceRun++\n   296→\t\t\t\tcol++\n   297→\t\t\t} else {\n   298→\t\t\t\tif writeErr := w.WriteByte(' '); writeErr != nil {\n   299→\t\t\t\t\treturn writeErr\n   300→\t\t\t\t}\n   301→\t\t\t\tcol++\n   302→\t\t\t}\n   303→\n   304→\t\tcase b == '\\t':\n   305→\t\t\t// R1.4: Existing tabs count toward column position.\n   306→\t\t\tif allMode || inLeading {\n   307→\t\t\t\t// Flush any accumulated spaces before the tab.\n   308→\t\t\t\tif spaceRun > 0 {\n   309→\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n   310→\t\t\t\t\t\treturn writeErr\n   311→\t\t\t\t\t}\n   312→\t\t\t\t}\n   313→\t\t\t\t// Write the tab and advance column.\n   314→\t\t\t\tif writeErr := w.WriteByte('\\t'); writeErr != nil {\n   315→\t\t\t\t\treturn writeErr\n   316→\t\t\t\t}\n   317→\t\t\t\tnext := nextTabStop(col, stops)\n   318→\t\t\t\tif next == -1 {\n   319→\t\t\t\t\t// Past last explicit stop; tab still advances by 1 in output.\n   320→\t\t\t\t\tcol++\n   321→\t\t\t\t} else {\n   322→\t\t\t\t\tcol = next\n   323→\t\t\t\t}\n   324→\t\t\t} else {\n   325→\t\t\t\tif writeErr := w.WriteByte('\\t'); writeErr != nil {\n   326→\t\t\t\t\treturn writeErr\n   327→\t\t\t\t}\n   328→\t\t\t\tnext := nextTabStop(col, stops)\n   329→\t\t\t\tif next == -1 {\n   330→\t\t\t\t\tcol++\n   331→\t\t\t\t} else {\n   332→\t\t\t\t\tcol = next\n   333→\t\t\t\t}\n   334→\t\t\t}\n   335→\n   336→\t\tdefault:\n   337→\t\t\t// Non-whitespace character.\n   338→\t\t\tif spaceRun > 0 {\n   339→\t\t\t\tif allMode || inLeading {\n   340→\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n   341→\t\t\t\t\t\treturn writeErr\n   342→\t\t\t\t\t}\n   343→\t\t\t\t} else {\n   344→\t\t\t\t\tif writeErr := flushSpaces(); writeErr != nil {\n   345→\t\t\t\t\t\treturn writeErr\n   346→\t\t\t\t\t}\n   347→\t\t\t\t}\n   348→\t\t\t}\n   349→\t\t\tif writeErr := w.WriteByte(b); writeErr != nil {\n   350→\t\t\t\treturn writeErr\n   351→\t\t\t}\n   352→\t\t\tcol++\n   353→\t\t\tinLeading = false\n   354→\t\t}\n   355→\t}\n   356→}\n   357→"}]},"parent_tool_use_id":null,"session_id":"a8da431a-575c-43a7-97e5-a163d19babfc","uuid":"a6210214-656e-4c02-aed3-2a5b8f4be7a4","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/352/cmd/unexpand/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements the unexpand utility (prd025-unexpand R1-R4).\n// unexpand converts spaces to tabs, reading from files or stdin,\n// with configurable tab stop positions via the -t flag.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\n// defaultTabStop is the default tab stop interval.\nconst defaultTabStop = 8\n\nfunc main() {\n\t// R4.4: Handle SIGPIPE gracefully.\n\tsys.InstallSIGPIPEHandler()\n\n\tvar tabStops []int\n\tallMode := false\n\tfirstOnlyExplicit := false\n\n\targs := os.Args[1:]\n\tvar files []string\n\n\t// Manual flag parsing to match GNU unexpand behavior.\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif arg == \"--help\" {\n\t\t\tfmt.Println(\"Usage: unexpand [OPTION]... [FILE]...\")\n\t\t\tfmt.Println(\"Convert blanks in each FILE to tabs, writing to standard output.\")\n\t\t\tfmt.Println()\n\t\t\tfmt.Println(\"  -a, --all           convert all blanks, instead of just initial blanks\")\n\t\t\tfmt.Println(\"      --first-only    convert only leading sequences of blanks (default)\")\n\t\t\tfmt.Println(\"  -t, --tabs=N        have tabs N characters apart, not 8\")\n\t\t\tfmt.Println(\"  -t, --tabs=LIST     use comma separated list of tab positions\")\n\t\t\tfmt.Println(\"      --help          display this help and exit\")\n\t\t\tfmt.Println(\"      --version       output version information and exit\")\n\t\t\tos.Exit(0)\n\t\t}\n\t\tif arg == \"--version\" {\n\t\t\tfmt.Println(\"unexpand (go-unix-utils) 0.1\")\n\t\t\tos.Exit(0)\n\t\t}\n\t\tif arg == \"--all\" {\n\t\t\tallMode = true\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--first-only\" {\n\t\t\tfirstOnlyExplicit = true\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--tabs=\") {\n\t\t\tval := arg[len(\"--tabs=\"):]\n\t\t\ttabStops = parseTabStops(val)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--tabs\" {\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: option '--tabs' requires an argument\\n\")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\ttabStops = parseTabStops(args[i])\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) == 0 || arg[0] != '-' || arg == \"-\" {\n\t\t\tfiles = append(files, arg)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\n\t\t// Parse short flags from the argument.\n\t\tj := 1\n\t\tfor j < len(arg) {\n\t\t\tswitch arg[j] {\n\t\t\tcase 'a':\n\t\t\t\t// R2: -a converts all whitespace runs.\n\t\t\t\tallMode = true\n\t\t\t\tj++\n\t\t\tcase 't':\n\t\t\t\t// R3: -t sets tab stops and implies -a.\n\t\t\t\tval := arg[j+1:]\n\t\t\t\tif val == \"\" {\n\t\t\t\t\ti++\n\t\t\t\t\tif i >= len(args) {\n\t\t\t\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: option requires an argument -- 't'\\n\")\n\t\t\t\t\t\tos.Exit(1)\n\t\t\t\t\t}\n\t\t\t\t\tval = args[i]\n\t\t\t\t}\n\t\t\t\ttabStops = parseTabStops(val)\n\t\t\t\tj = len(arg) // consumed rest of arg\n\t\t\tdefault:\n\t\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: invalid option -- '%c'\\n\", arg[j])\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t}\n\t\ti++\n\t}\n\n\t// R3.3: -t implies -a.\n\tif len(tabStops) > 0 && !firstOnlyExplicit {\n\t\tallMode = true\n\t}\n\n\t// Read stdin when no file arguments are given.\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\t// Build effective tab stop configuration.\n\tif len(tabStops) == 0 {\n\t\ttabStops = []int{defaultTabStop}\n\t}\n\n\texitCode := 0\n\tw := bufio.NewWriter(os.Stdout)\n\n\tfor _, file := range files {\n\t\tr, err := openInput(file)\n\t\tif err != nil {\n\t\t\t// R4.2: Print error to stderr, continue processing remaining files.\n\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: %v\\n\", err)\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\n\t\tif err := unexpandInput(r, w, tabStops, allMode); err != nil {\n\t\t\t// R4.3: Exit 1 on write error.\n\t\t\tos.Exit(1)\n\t\t}\n\n\t\tif closer, ok := r.(io.Closer); ok && file != \"-\" {\n\t\t\t_ = closer.Close() // best-effort close\n\t\t}\n\t}\n\n\tif err := w.Flush(); err != nil {\n\t\tos.Exit(1)\n\t}\n\n\tos.Exit(exitCode)\n}\n\n// openInput returns a reader for the named file, or stdin if name is \"-\".\nfunc openInput(name string) (io.Reader, error) {\n\tif name == \"-\" {\n\t\treturn os.Stdin, nil\n\t}\n\treturn os.Open(name)\n}\n\n// parseTabStops parses a tab stop specification: either a single number\n// (uniform interval) or a comma-separated list of absolute positions.\nfunc parseTabStops(s string) []int {\n\tparts := strings.Split(s, \",\")\n\tstops := make([]int, 0, len(parts))\n\tfor _, p := range parts {\n\t\tp = strings.TrimSpace(p)\n\t\tn, err := strconv.Atoi(p)\n\t\tif err != nil || n <= 0 {\n\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: tab size contains invalid character(s): '%s'\\n\", s)\n\t\t\tos.Exit(1)\n\t\t}\n\t\tstops = append(stops, n)\n\t}\n\treturn stops\n}\n\n// nextTabStop returns the next tab stop column position given the current column\n// (0-indexed) and the tab stop configuration.\n// Single value means uniform interval; multiple values are absolute positions.\nfunc nextTabStop(col int, stops []int) int {\n\tif len(stops) == 1 {\n\t\tinterval := stops[0]\n\t\treturn col + (interval - col%interval)\n\t}\n\t// Absolute positions (1-indexed in spec, 0-indexed internally).\n\tfor _, s := range stops {\n\t\tpos := s - 1\n\t\tif pos > col {\n\t\t\treturn pos\n\t\t}\n\t}\n\t// R3.2: Past the last explicit stop, no tab can be inserted.\n\treturn -1\n}\n\n// unexpandInput reads from r and writes tab-unexpanded output to w.\n// R1: Default mode converts only leading whitespace.\n// R2: allMode converts all whitespace runs throughout the line.\nfunc unexpandInput(r io.Reader, w *bufio.Writer, stops []int, allMode bool) error {\n\tbr := bufio.NewReader(r)\n\tcol := 0\n\tinLeading := true  // tracks whether we are still in leading whitespace\n\tspaceRun := 0      // number of accumulated spaces\n\tspaceStartCol := 0 // column where the current space run started\n\n\tflushSpaces := func() error {\n\t\tfor range spaceRun {\n\t\t\tif writeErr := w.WriteByte(' '); writeErr != nil {\n\t\t\t\treturn writeErr\n\t\t\t}\n\t\t}\n\t\tspaceRun = 0\n\t\treturn nil\n\t}\n\n\tconvertSpaces := func() error {\n\t\t// Try to replace accumulated spaces with tabs where possible.\n\t\tcurCol := spaceStartCol\n\t\ttarget := curCol + spaceRun\n\n\t\tfor curCol < target {\n\t\t\tnext := nextTabStop(curCol, stops)\n\t\t\tif next == -1 || next > target {\n\t\t\t\t// Can't reach next tab stop; emit remaining as spaces.\n\t\t\t\tfor curCol < target {\n\t\t\t\t\tif writeErr := w.WriteByte(' '); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t\tcurCol++\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\t// We can reach this tab stop; emit a tab.\n\t\t\t\tif writeErr := w.WriteByte('\\t'); writeErr != nil {\n\t\t\t\t\treturn writeErr\n\t\t\t\t}\n\t\t\t\tcurCol = next\n\t\t\t}\n\t\t}\n\t\tspaceRun = 0\n\t\treturn nil\n\t}\n\n\tfor {\n\t\tb, err := br.ReadByte()\n\t\tif err != nil {\n\t\t\tif err == io.EOF {\n\t\t\t\t// Flush any remaining spaces.\n\t\t\t\tif spaceRun > 0 {\n\t\t\t\t\tif allMode || inLeading {\n\t\t\t\t\t\treturn convertSpaces()\n\t\t\t\t\t}\n\t\t\t\t\treturn flushSpaces()\n\t\t\t\t}\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn err\n\t\t}\n\n\t\tswitch {\n\t\tcase b == '\\n':\n\t\t\t// Flush accumulated spaces before newline.\n\t\t\tif spaceRun > 0 {\n\t\t\t\tif allMode || inLeading {\n\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tif writeErr := flushSpaces(); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif writeErr := w.WriteByte('\\n'); writeErr != nil {\n\t\t\t\treturn writeErr\n\t\t\t}\n\t\t\tcol = 0\n\t\t\tinLeading = true\n\n\t\tcase b == ' ':\n\t\t\tif allMode || inLeading {\n\t\t\t\tif spaceRun == 0 {\n\t\t\t\t\tspaceStartCol = col\n\t\t\t\t}\n\t\t\t\tspaceRun++\n\t\t\t\tcol++\n\t\t\t} else {\n\t\t\t\tif writeErr := w.WriteByte(' '); writeErr != nil {\n\t\t\t\t\treturn writeErr\n\t\t\t\t}\n\t\t\t\tcol++\n\t\t\t}\n\n\t\tcase b == '\\t':\n\t\t\t// R1.4: Existing tabs count toward column position.\n\t\t\tif allMode || inLeading {\n\t\t\t\t// Flush any accumulated spaces before the tab.\n\t\t\t\tif spaceRun > 0 {\n\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t// Write the tab and advance column.\n\t\t\t\tif writeErr := w.WriteByte('\\t'); writeErr != nil {\n\t\t\t\t\treturn writeErr\n\t\t\t\t}\n\t\t\t\tnext := nextTabStop(col, stops)\n\t\t\t\tif next == -1 {\n\t\t\t\t\t// Past last explicit stop; tab still advances by 1 in output.\n\t\t\t\t\tcol++\n\t\t\t\t} else {\n\t\t\t\t\tcol = next\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif writeErr := w.WriteByte('\\t'); writeErr != nil {\n\t\t\t\t\treturn writeErr\n\t\t\t\t}\n\t\t\t\tnext := nextTabStop(col, stops)\n\t\t\t\tif next == -1 {\n\t\t\t\t\tcol++\n\t\t\t\t} else {\n\t\t\t\t\tcol = next\n\t\t\t\t}\n\t\t\t}\n\n\t\tdefault:\n\t\t\t// Non-whitespace character.\n\t\t\tif spaceRun > 0 {\n\t\t\t\tif allMode || inLeading {\n\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n\t\t\t\t\t\t