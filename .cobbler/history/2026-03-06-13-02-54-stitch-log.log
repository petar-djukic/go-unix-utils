ce.\n  - No normalization is applied; all outputs are compared byte-for-byte.\n\ntest_cases:\n\n  # ---- expand ----\n\n  - name: expand_default_single_tab\n    description: One tab at column 1 expands to 7 spaces (advancing to column 9).\n    inputs:\n      args: []\n      stdin: \"a\\tb\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a       b\\n\"\n      stderr: \"\"\n    traces:\n      - prd024-expand R1.1\n\n  - name: expand_multiple_tabs\n    description: Two consecutive tabs each advance to the next tab stop.\n    inputs:\n      args: []\n      stdin: \"\\t\\tx\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"                x\\n\"\n      stderr: \"\"\n    traces:\n      - prd024-expand R1.1\n      - prd024-expand R1.2\n\n  - name: expand_no_tabs\n    description: Input with no tabs passes through unchanged.\n    inputs:\n      args: []\n      stdin: \"hello world\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello world\\n\"\n      stderr: \"\"\n    traces:\n      - prd024-expand R1.3\n\n  - name: expand_tab_interval_4\n    description: -t 4 sets tab stops every 4 columns.\n    inputs:\n      args: [\"-t\", \"4\"]\n      stdin: \"a\\tb\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a   b\\n\"\n      stderr: \"\"\n    traces:\n      - prd024-expand R2.1\n\n  - name: expand_tab_list\n    description: \"-t 1,5,9 sets absolute tab stops at columns 1, 5, and 9.\"\n    inputs:\n      args: [\"-t\", \"1,5,9\"]\n      stdin: \"\\ta\\tb\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"    a   b\\n\"\n      stderr: \"\"\n    traces:\n      - prd024-expand R2.2\n\n  - name: expand_tab_past_last_stop\n    description: A tab at or past the last explicit stop is replaced by one space.\n    inputs:\n      args: [\"-t\", \"4\"]\n      stdin: \"12345678\\t9\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"12345678 9\\n\"\n      stderr: \"\"\n    traces:\n      - prd024-expand R2.2\n\n  - name: expand_multiline\n    description: Column counter resets to 1 at each newline.\n    inputs:\n      args: []\n      stdin: \"\\ta\\n\\tb\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"        a\\n        b\\n\"\n      stderr: \"\"\n    traces:\n      - prd024-expand R1.4\n\n  # ---- unexpand ----\n\n  - name: unexpand_leading_spaces_to_tab\n    description: Eight leading spaces convert to one tab.\n    inputs:\n      args: []\n      stdin: \"        text\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"\\ttext\\n\"\n      stderr: \"\"\n    traces:\n      - prd025-unexpand R1.1\n\n  - name: unexpand_nonleading_spaces_unchanged\n    description: Non-leading spaces are not converted in default mode.\n    inputs:\n      args: []\n      stdin: \"a        b\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a        b\\n\"\n      stderr: \"\"\n    traces:\n      - prd025-unexpand R1.2\n\n  - name: unexpand_all_mode\n    description: -a converts non-leading space runs at tab stop boundaries.\n    inputs:\n      args: [\"-a\"]\n      stdin: \"a        b\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a\\tb\\n\"\n      stderr: \"\"\n    traces:\n      - prd025-unexpand R2.1\n\n  - name: unexpand_partial_spaces_preserved\n    description: A run of spaces not reaching a tab stop is preserved.\n    inputs:\n      args: []\n      stdin: \"   text\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"   text\\n\