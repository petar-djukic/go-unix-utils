     text\"),\n\t\t\tEnv:   []string{\"LC_ALL=C\"},\n\t\t},\n\t\t// -a: single space between words not converted.\n\t\t{\n\t\t\tName:  \"unexpand_all_single_space\",\n\t\t\tArgs:  []string{\"-a\"},\n\t\t\tStdin: []byte(\"a b\\n\"),\n\t\t\tEnv:   []string{\"LC_ALL=C\"},\n\t\t},\n\t\t// R3.3: -t implies -a — non-leading spaces also converted.\n\t\t{\n\t\t\tName:  \"unexpand_t_implies_a\",\n\t\t\tArgs:  []string{\"-t\", \"4\"},\n\t\t\tStdin: []byte(\"a       b\\n\"),\n\t\t\tEnv:   []string{\"LC_ALL=C\"},\n\t\t},\n\t\t// Spaces only line.\n\t\t{\n\t\t\tName:  \"unexpand_spaces_only\",\n\t\t\tStdin: []byte(\"        \\n\"),\n\t\t\tEnv:   []string{\"LC_ALL=C\"},\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":339,"cache_read_input_tokens":54519,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":339},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"a8da431a-575c-43a7-97e5-a163d19babfc","uuid":"93924423-8706-4c32-9641-a7f2f8d3cb32"}
