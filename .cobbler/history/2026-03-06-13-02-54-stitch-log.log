es()\n\t\t\t\t}\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn err\n\t\t}\n\n\t\tswitch {\n\t\tcase b == '\\n':\n\t\t\t// Flush accumulated spaces before newline.\n\t\t\tif spaceRun > 0 {\n\t\t\t\tif allMode || inLeading {\n\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tif writeErr := flushSpaces(); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif writeErr := w.WriteByte('\\n'); writeErr != nil {\n\t\t\t\treturn writeErr\n\t\t\t}\n\t\t\tcol = 0\n\t\t\tinLeading = true\n\n\t\tcase b == ' ':\n\t\t\tif allMode || inLeading {\n\t\t\t\tif spaceRun == 0 {\n\t\t\t\t\tspaceStartCol = col\n\t\t\t\t}\n\t\t\t\tspaceRun++\n\t\t\t\tcol++\n\t\t\t} else {\n\t\t\t\tif writeErr := w.WriteByte(' '); writeErr != nil {\n\t\t\t\t\treturn writeErr\n\t\t\t\t}\n\t\t\t\tcol++\n\t\t\t}\n\n\t\tcase b == '\\t':\n\t\t\t// R1.4: Existing tabs count toward column position.\n\t\t\tif allMode || inLeading {\n\t\t\t\t// Flush any accumulated spaces before the tab.\n\t\t\t\tif spaceRun > 0 {\n\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\t// Write the tab and advance column.\n\t\t\t\tif writeErr := w.WriteByte('\\t'); writeErr != nil {\n\t\t\t\t\treturn writeErr\n\t\t\t\t}\n\t\t\t\tnext := nextTabStop(col, stops)\n\t\t\t\tif next == -1 {\n\t\t\t\t\t// Past last explicit stop; tab still advances by 1 in output.\n\t\t\t\t\tcol++\n\t\t\t\t} else {\n\t\t\t\t\tcol = next\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif writeErr := w.WriteByte('\\t'); writeErr != nil {\n\t\t\t\t\treturn writeErr\n\t\t\t\t}\n\t\t\t\tnext := nextTabStop(col, stops)\n\t\t\t\tif next == -1 {\n\t\t\t\t\tcol++\n\t\t\t\t} else {\n\t\t\t\t\tcol = next\n\t\t\t\t}\n\t\t\t}\n\n\t\tdefault:\n\t\t\t// Non-whitespace character.\n\t\t\tif spaceRun > 0 {\n\t\t\t\tif allMode || inLeading {\n\t\t\t\t\tif writeErr := convertSpaces(); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tif writeErr := flushSpaces(); writeErr != nil {\n\t\t\t\t\t\treturn writeErr\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\tif writeErr := w.WriteByte(b); writeErr != nil {\n\t\t\t\treturn writeErr\n\t\t\t}\n\t\t\tcol++\n\t\t\tinLeading = false\n\t\t}\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":246,"cache_read_input_tokens":51043,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":246},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"a8da431a-575c-43a7-97e5-a163d19babfc","uuid":"6d9ecbea-c165-41bc-b980-f66960f9f887"}
