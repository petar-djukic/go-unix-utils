{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017ueaUEcHV8MLTmYbAs7Ljm","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Tests for difftest.go: TimestampNormalizer, ComposeNormalizers, applyNormalizers.\n     5→// Implements: prd001-testutils (R4.2, R4.3, R4.4)\n     6→package testutils\n     7→\n     8→import (\n     9→\t\"bytes\"\n    10→\t\"strings\"\n    11→\t\"testing\"\n    12→)\n    13→\n    14→func TestTimestampNormalizer(t *testing.T) {\n    15→\ttests := []struct {\n    16→\t\tname  string\n    17→\t\tinput string\n    18→\t\twant  string\n    19→\t}{\n    20→\t\t{\n    21→\t\t\tname:  \"month-day-time pattern\",\n    22→\t\t\tinput: \"Feb 19 12:34:56\",\n    23→\t\t\twant:  \"<TIMESTAMP>\",\n    24→\t\t},\n    25→\t\t{\n    26→\t\t\tname:  \"ISO datetime pattern\",\n    27→\t\t\tinput: \"2026-02-19 12:34:56\",\n    28→\t\t\twant:  \"<TIMESTAMP>\",\n    29→\t\t},\n    30→\t\t{\n    31→\t\t\tname:  \"time-only pattern\",\n    32→\t\t\tinput: \"12:34:56\",\n    33→\t\t\twant:  \"<TIMESTAMP>\",\n    34→\t\t},\n    35→\t\t{\n    36→\t\t\tname:  \"month-day-time embedded in line\",\n    37→\t\t\tinput: \"prefix Feb 19 12:34:56 suffix\",\n    38→\t\t\twant:  \"prefix <TIMESTAMP> suffix\",\n    39→\t\t},\n    40→\t\t{\n    41→\t\t\tname:  \"ISO datetime embedded in line\",\n    42→\t\t\tinput: \"log: 2026-02-19 12:34:56 event\",\n    43→\t\t\twant:  \"log: <TIMESTAMP> event\",\n    44→\t\t},\n    45→\t\t{\n    46→\t\t\tname:  \"multiple timestamps in one line\",\n    47→\t\t\tinput: \"start 09:00:00 end 17:30:00\",\n    48→\t\t\twant:  \"start <TIMESTAMP> end <TIMESTAMP>\",\n    49→\t\t},\n    50→\t\t{\n    51→\t\t\tname:  \"no timestamps unchanged\",\n    52→\t\t\tinput: \"no timestamps here\",\n    53→\t\t\twant:  \"no timestamps here\",\n    54→\t\t},\n    55→\t\t{\n    56→\t\t\tname:  \"empty input\",\n    57→\t\t\tinput: \"\",\n    58→\t\t\twant:  \"\",\n    59→\t\t},\n    60→\t}\n    61→\n    62→\tfor _, tc := range tests {\n    63→\t\tt.Run(tc.name, func(t *testing.T) {\n    64→\t\t\tgot := string(TimestampNormalizer([]byte(tc.input)))\n    65→\t\t\tif got != tc.want {\n    66→\t\t\t\tt.Fatalf(\"TimestampNormalizer(%q)\\n  got:  %q\\n  want: %q\", tc.input, got, tc.want)\n    67→\t\t\t}\n    68→\t\t})\n    69→\t}\n    70→}\n    71→\n    72→func TestComposeNormalizers(t *testing.T) {\n    73→\tt.Run(\"chains functions in order\", func(t *testing.T) {\n    74→\t\tupper := func(b []byte) []byte {\n    75→\t\t\treturn []byte(strings.ToUpper(string(b)))\n    76→\t\t}\n    77→\t\taddSuffix := func(b []byte) []byte {\n    78→\t\t\treturn append(b, []byte(\"_DONE\")...)\n    79→\t\t}\n    80→\n    81→\t\tcomposed := ComposeNormalizers(upper, addSuffix)\n    82→\t\tgot := string(composed([]byte(\"hello\")))\n    83→\t\twant := \"HELLO_DONE\"\n    84→\t\tif got != want {\n    85→\t\t\tt.Fatalf(\"ComposeNormalizers result: got %q, want %q\", got, want)\n    86→\t\t}\n    87→\t})\n    88→\n    89→\tt.Run(\"single function\", func(t *testing.T) {\n    90→\t\tdouble := func(b []byte) []byte {\n    91→\t\t\treturn append(b, b...)\n    92→\t\t}\n    93→\t\tcomposed := ComposeNormalizers(double)\n    94→\t\tgot := string(composed([]byte(\"ab\")))\n    95→\t\twant := \"abab\"\n    96→\t\tif got != want {\n    97→\t\t\tt.Fatalf(\"ComposeNormalizers single: got %q, want %q\", got, want)\n    98→\t\t}\n    99→\t})\n   100→\n   101→\tt.Run(\"no functions returns input unchanged\", func(t *testing.T) {\n   102→\t\tcomposed := ComposeNormalizers()\n   103→\t\tinput := []byte(\"unchanged\")\n   104→\t\tgot := composed(input)\n   105→\t\tif !bytes.Equal(got, input) {\n   106→\t\t\tt.Fatalf(\"ComposeNormalizers empty: got %q, want %q\", got, input)\n   107→\t\t}\n   108→\t})\n   109→}\n   110→\n   111→func TestApplyNormalizers(t *testing.T) {\n   112→\tt.Run(\"nil normalizers returns input unchanged\", func(t *testing.T) {\n   113→\t\tinput := []byte(\"hello world\")\n   114→\t\tgot := applyNormalizers(input, nil)\n   115→\t\tif !bytes.Equal(got, input) {\n   116→\t\t\tt.Fatalf(\"expected unchanged input, got %q\", got)\n   117→\t\t}\n   118→\t})\n   119→\n   120→\tt.Run(\"empty normalizers returns input unchanged\", func(t *testing.T) {\n   121→\t\tinput := []byte(\"hello world\")\n   122→\t\tgot := applyNormalizers(input, []NormalizeFunc{})\n   123→\t\tif !bytes.Equal(got, input) {\n   124→\t\t\tt.Fatalf(\"expected unchanged input, got %q\", got)\n   125→\t\t}\n   126→\t})\n   127→\n   128→\tt.Run(\"applies normalizers in order\", func(t *testing.T) {\n   129→\t\t// First: replace \"a\" with \"b\", Second: replace \"b\" with \"c\"\n   130→\t\treplaceAB := func(b []byte) []byte {\n   131→\t\t\treturn bytes.ReplaceAll(b, []byte(\"a\"), []byte(\"b\"))\n   132→\t\t}\n   133→\t\treplaceBC := func(b []byte) []byte {\n   134→\t\t\treturn bytes.ReplaceAll(b, []byte(\"b\"), []byte(\"c\"))\n   135→\t\t}\n   136→\n   137→\t\tgot := string(applyNormalizers([]byte(\"abc\"), []NormalizeFunc{replaceAB, replaceBC}))\n   138→\t\t// \"abc\" -> replaceAB -> \"bbc\" -> replaceBC -> \"ccc\"\n   139→\t\twant := \"ccc\"\n   140→\t\tif got != want {\n   141→\t\t\tt.Fatalf(\"applyNormalizers chain: got %q, want %q\", got, want)\n   142→\t\t}\n   143→\t})\n   144→}\n   145→"}]},"parent_tool_use_id":null,"session_id":"e111a86a-32bb-4674-a797-2abfae58b6f8","uuid":"75fee1d3-e9dd-42ae-8587-fbda65238b2b","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/92/pkg/testutils/difftest_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Tests for difftest.go: TimestampNormalizer, ComposeNormalizers, applyNormalizers.\n// Implements: prd001-testutils (R4.2, R4.3, R4.4)\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestTimestampNormalizer(t *testing.T) {\n\ttests := []struct {\n\t\tname  string\n\t\tinput string\n\t\twant  string\n\t}{\n\t\t{\n\t\t\tname:  \"month-day-time pattern\",\n\t\t\tinput: \"Feb 19 12:34:56\",\n\t\t\twant:  \"<TIMESTAMP>\",\n\t\t},\n\t\t{\n\t\t\tname:  \"ISO datetime pattern\",\n\t\t\tinput: \"2026-02-19 12:34:56\",\n\t\t\twant:  \"<TIMESTAMP>\",\n\t\t},\n\t\t{\n\t\t\tname:  \"time-only pattern\",\n\t\t\tinput: \"12:34:56\",\n\t\t\twant:  \"<TIMESTAMP>\",\n\t\t},\n\t\t{\n\t\t\tname:  \"month-day-time embedded in line\",\n\t\t\tinput: \"prefix Feb 19 12:34:56 suffix\",\n\t\t\twant:  \"prefix <TIMESTAMP> suffix\",\n\t\t},\n\t\t{\n\t\t\tname:  \"ISO datetime embedded in line\",\n\t\t\tinput: \"log: 2026-02-19 12:34:56 event\",\n\t\t\twant:  \"log: <TIMESTAMP> event\",\n\t\t},\n\t\t{\n\t\t\tname:  \"multiple timestamps in one line\",\n\t\t\tinput: \"start 09:00:00 end 17:30:00\",\n\t\t\twant:  \"start <TIMESTAMP> end <TIMESTAMP>\",\n\t\t},\n\t\t{\n\t\t\tname:  \"no timestamps unchanged\",\n\t\t\tinput: \"no timestamps here\",\n\t\t\twant:  \"no timestamps here\",\n\t\t},\n\t\t{\n\t\t\tname:  \"empty input\",\n\t\t\tinput: \"\",\n\t\t\twant:  \"\",\n\t\t},\n\t}\n\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tgot := string(TimestampNormalizer([]byte(tc.input)))\n\t\t\tif got != tc.want {\n\t\t\t\tt.Fatalf(\"TimestampNormalizer(%q)\\n  got:  %q\\n  want: %q\", tc.input, got, tc.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestComposeNormalizers(t *testing.T) {\n\tt.Run(\"chains functions in order\", func(t *testing.T) {\n\t\tupper := func(b []byte) []byte {\n\t\t\treturn []byte(strings.ToUpper(string(b)))\n\t\t}\n\t\taddSuffix := func(b []byte) []byte {\n\t\t\treturn append(b, []byte(\"_DONE\")...)\n\t\t}\n\n\t\tcomposed := ComposeNormalizers(upper, addSuffix)\n\t\tgot := string(composed([]byte(\"hello\")))\n\t\twant := \"HELLO_DONE\"\n\t\tif got != want {\n\t\t\tt.Fatalf(\"ComposeNormalizers result: got %q, want %q\", got, want)\n\t\t}\n\t})\n\n\tt.Run(\"single function\", func(t *testing.T) {\n\t\tdouble := func(b []byte) []byte {\n\t\t\treturn append(b, b...)\n\t\t}\n\t\tcomposed := ComposeNormalizers(double)\n\t\tgot := string(composed([]byte(\"ab\")))\n\t\twant := \"abab\"\n\t\tif got != want {\n\t\t\tt.Fatalf(\"ComposeNormalizers single: got %q, want %q\", got, want)\n\t\t}\n\t})\n\n\tt.Run(\"no functions returns input unchanged\", func(t *testing.T) {\n\t\tcomposed := ComposeNormalizers()\n\t\tinput := []byte(\"unchanged\")\n\t\tgot := composed(input)\n\t\tif !bytes.Equal(got, input) {\n\t\t\tt.Fatalf(\"ComposeNormalizers empty: got %q, want %q\", got, input)\n\t\t}\n\t})\n}\n\nfunc TestApplyNormalizers(t *testing.T) {\n\tt.Run(\"nil normalizers returns input unchanged\", func(t *testing.T) {\n\t\tinput := []byte(\"hello world\")\n\t\tgot := applyNormalizers(input, nil)\n\t\tif !bytes.Equal(got, input) {\n\t\t\tt.Fatalf(\"expected unchanged input, got %q\", got)\n\t\t}\n\t})\n\n\tt.Run(\"empty normalizers returns input unchanged\", func(t *testing.T) {\n\t\tinput := []byte(\"hello world\")\n\t\tgot := applyNormalizers(input, []NormalizeFunc{})\n\t\tif !bytes.Equal(got, input) {\n\t\t\tt.Fatalf(\"expected unchanged input, got %q\", got)\n\t\t}\n\t})\n\n\tt.Run(\"applies normalizers in order\", func(t *testing.T) {\n\t\t// First: replace \"a\" with \"b\", Second: replace \"b\" with \"c\"\n\t\treplaceAB := func(b []byte) []byte {\n\t\t\treturn bytes.ReplaceAll(b, []byte(\"a\"), []byte(\"b\"))\n\t\t}\n\t\treplaceBC := func(b []byte) []byte {\n\t\t\treturn bytes.ReplaceAll(b, []byte(\"b\"), []byte(\"c\"))\n\t\t}\n\n\t\tgot := string(applyNormalizers([]byte(\"abc\"), []NormalizeFunc{replaceAB, replaceBC}))\n\t\t// \"abc\" -> replaceAB -> \"bbc\" -> replaceBC -> \"ccc\"\n\t\twant := \"ccc\"\n\t\tif got != want {\n\t\t\tt.Fatalf(\"applyNormalizers chain: got %q, want %q\", got, want)\n\t\t}\n\t})\n}\n","numLines":145,"startLine":1,"totalLines":145}}}
