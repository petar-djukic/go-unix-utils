{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DragvgA5muDcbZW2oWGkAR","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Tests for runner.go: buildEnv, setEnvVar, formatDivergence, truncateBytes,\n     5→// compareExpectedFiles.\n     6→// Implements: prd001-testutils (R2.6, R3.5, R5.1, R5.2)\n     7→package testutils\n     8→\n     9→import (\n    10→\t\"os\"\n    11→\t\"path/filepath\"\n    12→\t\"strings\"\n    13→\t\"testing\"\n    14→)\n    15→\n    16→func TestBuildEnv(t *testing.T) {\n    17→\ttests := []struct {\n    18→\t\tname    string\n    19→\t\ttestEnv []string\n    20→\t\tcheck   func(t *testing.T, env []string)\n    21→\t}{\n    22→\t\t{\n    23→\t\t\tname:    \"default sets LC_ALL=C\",\n    24→\t\t\ttestEnv: nil,\n    25→\t\t\tcheck: func(t *testing.T, env []string) {\n    26→\t\t\t\tt.Helper()\n    27→\t\t\t\tassertEnvContains(t, env, \"LC_ALL\", \"C\")\n    28→\t\t\t},\n    29→\t\t},\n    30→\t\t{\n    31→\t\t\tname:    \"caller variable is merged\",\n    32→\t\t\ttestEnv: []string{\"MY_CUSTOM_VAR=hello\"},\n    33→\t\t\tcheck: func(t *testing.T, env []string) {\n    34→\t\t\t\tt.Helper()\n    35→\t\t\t\tassertEnvContains(t, env, \"MY_CUSTOM_VAR\", \"hello\")\n    36→\t\t\t\t// LC_ALL=C should still be present\n    37→\t\t\t\tassertEnvContains(t, env, \"LC_ALL\", \"C\")\n    38→\t\t\t},\n    39→\t\t},\n    40→\t\t{\n    41→\t\t\tname:    \"caller overrides LC_ALL\",\n    42→\t\t\ttestEnv: []string{\"LC_ALL=en_US.UTF-8\"},\n    43→\t\t\tcheck: func(t *testing.T, env []string) {\n    44→\t\t\t\tt.Helper()\n    45→\t\t\t\tassertEnvContains(t, env, \"LC_ALL\", \"en_US.UTF-8\")\n    46→\t\t\t\t// Must not have duplicate LC_ALL entries\n    47→\t\t\t\tcount := countEnvKey(env, \"LC_ALL\")\n    48→\t\t\t\tif count != 1 {\n    49→\t\t\t\t\tt.Fatalf(\"expected exactly 1 LC_ALL entry, got %d\", count)\n    50→\t\t\t\t}\n    51→\t\t\t},\n    52→\t\t},\n    53→\t\t{\n    54→\t\t\tname:    \"override replaces rather than duplicates\",\n    55→\t\t\ttestEnv: []string{\"PATH=/custom/path\"},\n    56→\t\t\tcheck: func(t *testing.T, env []string) {\n    57→\t\t\t\tt.Helper()\n    58→\t\t\t\tassertEnvContains(t, env, \"PATH\", \"/custom/path\")\n    59→\t\t\t\tcount := countEnvKey(env, \"PATH\")\n    60→\t\t\t\tif count != 1 {\n    61→\t\t\t\t\tt.Fatalf(\"expected exactly 1 PATH entry, got %d\", count)\n    62→\t\t\t\t}\n    63→\t\t\t},\n    64→\t\t},\n    65→\t}\n    66→\n    67→\tfor _, tc := range tests {\n    68→\t\tt.Run(tc.name, func(t *testing.T) {\n    69→\t\t\tenv := buildEnv(tc.testEnv)\n    70→\t\t\ttc.check(t, env)\n    71→\t\t})\n    72→\t}\n    73→}\n    74→\n    75→func TestSetEnvVar(t *testing.T) {\n    76→\ttests := []struct {\n    77→\t\tname     string\n    78→\t\tinitial  []string\n    79→\t\tkey      string\n    80→\t\tvalue    string\n    81→\t\twantKey  string\n    82→\t\twantVal  string\n    83→\t\twantLen  int\n    84→\t}{\n    85→\t\t{\n    86→\t\t\tname:    \"add new variable to empty slice\",\n    87→\t\t\tinitial: []string{},\n    88→\t\t\tkey:     \"FOO\",\n    89→\t\t\tvalue:   \"bar\",\n    90→\t\t\twantKey: \"FOO\",\n    91→\t\t\twantVal: \"bar\",\n    92→\t\t\twantLen: 1,\n    93→\t\t},\n    94→\t\t{\n    95→\t\t\tname:    \"add new variable to existing slice\",\n    96→\t\t\tinitial: []string{\"A=1\", \"B=2\"},\n    97→\t\t\tkey:     \"C\",\n    98→\t\t\tvalue:   \"3\",\n    99→\t\t\twantKey: \"C\",\n   100→\t\t\twantVal: \"3\",\n   101→\t\t\twantLen: 3,\n   102→\t\t},\n   103→\t\t{\n   104→\t\t\tname:    \"override existing variable\",\n   105→\t\t\tinitial: []string{\"A=1\", \"B=2\", \"C=3\"},\n   106→\t\t\tkey:     \"B\",\n   107→\t\t\tvalue:   \"replaced\",\n   108→\t\t\twantKey: \"B\",\n   109→\t\t\twantVal: \"replaced\",\n   110→\t\t\twantLen: 3,\n   111→\t\t},\n   112→\t}\n   113→\n   114→\tfor _, tc := range tests {\n   115→\t\tt.Run(tc.name, func(t *testing.T) {\n   116→\t\t\tresult := setEnvVar(tc.initial, tc.key, tc.value)\n   117→\t\t\tif len(result) != tc.wantLen {\n   118→\t\t\t\tt.Fatalf(\"expected length %d, got %d\", tc.wantLen, len(result))\n   119→\t\t\t}\n   120→\t\t\tassertEnvContains(t, result, tc.wantKey, tc.wantVal)\n   121→\t\t})\n   122→\t}\n   123→}\n   124→\n   125→func TestFormatDivergence(t *testing.T) {\n   126→\ttc := DiffTest{\n   127→\t\tName:  \"test-case\",\n   128→\t\tArgs:  []string{\"-n\", \"file.txt\"},\n   129→\t\tStdin: []byte(\"input data\"),\n   130→\t}\n   131→\trefStdout := []byte(\"ref output\")\n   132→\tgoStdout := []byte(\"go output\")\n   133→\trefStderr := []byte(\"ref error\")\n   134→\tgoStderr := []byte(\"go error\")\n   135→\trefExit := 0\n   136→\tgoExit := 1\n   137→\n   138→\tmsg := formatDivergence(tc, refStdout, goStdout, refStderr, goStderr, refExit, goExit)\n   139→\n   140→\t// Verify all required fields are present in the divergence report (prd001-testutils R3.5)\n   141→\trequiredFields := []struct {\n   142→\t\tlabel string\n   143→\t\tvalue string\n   144→\t}{\n   145→\t\t{\"args\", \"-n\"},\n   146→\t\t{\"args\", \"file.txt\"},\n   147→\t\t{\"stdin\", \"input data\"},\n   148→\t\t{\"ref stdout\", \"ref output\"},\n   149→\t\t{\"go stdout\", \"go output\"},  // labeled \"go  stdout\" in format string\n   150→\t\t{\"ref stderr\", \"ref error\"},\n   151→\t\t{\"go stderr\", \"go error\"},   // labeled \"go  stderr\" in format string\n   152→\t\t{\"ref exit\", \"0\"},\n   153→\t\t{\"go exit\", \"1\"},            // labeled \"go  exit\" in format string\n   154→\t}\n   155→\tfor _, f := range requiredFields {\n   156→\t\tif !strings.Contains(msg, f.value) {\n   157→\t\t\tt.Fatalf(\"divergence message missing %s value %q\\nmessage: %s\", f.label, f.value, msg)\n   158→\t\t}\n   159→\t}\n   160→}\n   161→\n   162→func TestFormatDivergenceNilStdin(t *testing.T) {\n   163→\ttc := DiffTest{\n   164→\t\tName: \"nil-stdin\",\n   165→\t\tArgs: []string{},\n   166→\t}\n   167→\tmsg := formatDivergence(tc, []byte(\"a\"), []byte(\"b\"), nil, nil, 0, 0)\n   168→\tif !strings.Contains(msg, \"<nil>\") {\n   169→\t\tt.Fatalf(\"expected <nil> for nil stdin, got: %s\", msg)\n   170→\t}\n   171→}\n   172→\n   173→func TestTruncateBytes(t *testing.T) {\n   174→\ttests := []struct {\n   175→\t\tname   string\n   176→\t\tinput  []byte\n   177→\t\tmaxLen int\n   178→\t\twant   string\n   179→\t}{\n   180→\t\t{\n   181→\t\t\tname:   \"nil input returns <nil>\",\n   182→\t\t\tinput:  nil,\n   183→\t\t\tmaxLen: 256,\n   184→\t\t\twant:   \"<nil>\",\n   185→\t\t},\n   186→\t\t{\n   187→\t\t\tname:   \"short input returns full content\",\n   188→\t\t\tinput:  []byte(\"hello\"),\n   189→\t\t\tmaxLen: 256,\n   190→\t\t\twant:   `\"hello\"`,\n   191→\t\t},\n   192→\t\t{\n   193→\t\t\tname:   \"exact length returns full content\",\n   194→\t\t\tinput:  []byte(\"abc\"),\n   195→\t\t\tmaxLen: 3,\n   196→\t\t\twant:   `\"abc\"`,\n   197→\t\t},\n   198→\t\t{\n   199→\t\t\tname:   \"long input is truncated with byte count\",\n   200→\t\t\tinput:  []byte(\"abcdefghij\"),\n   201→\t\t\tmaxLen: 5,\n   202→\t\t\twant:   \"\", // checked below\n   203→\t\t},\n   204→\t}\n   205→\n   206→\tfor _, tc := range tests {\n   207→\t\tt.Run(tc.name, func(t *testing.T) {\n   208→\t\t\tgot := truncateBytes(tc.input, tc.maxLen)\n   209→\t\t\tif tc.name == \"long input is truncated with byte count\" {\n   210→\t\t\t\t// Must contain \"truncated\" and the total byte count\n   211→\t\t\t\tif !strings.Contains(got, \"truncated\") {\n   212→\t\t\t\t\tt.Fatalf(\"expected 'truncated' in output, got: %s\", got)\n   213→\t\t\t\t}\n   214→\t\t\t\tif !strings.Contains(got, \"10 bytes total\") {\n   215→\t\t\t\t\tt.Fatalf(\"expected '10 bytes total' in output, got: %s\", got)\n   216→\t\t\t\t}\n   217→\t\t\t\t// Must not contain the full input\n   218→\t\t\t\tif strings.Contains(got, \"abcdefghij\") {\n   219→\t\t\t\t\tt.Fatalf(\"expected truncated output, got full content: %s\", got)\n   220→\t\t\t\t}\n   221→\t\t\t\treturn\n   222→\t\t\t}\n   223→\t\t\tif got != tc.want {\n   224→\t\t\t\tt.Fatalf(\"expected %q, got %q\", tc.want, got)\n   225→\t\t\t}\n   226→\t\t})\n   227→\t}\n   228→}\n   229→\n   230→func TestCompareExpectedFiles(t *testing.T) {\n   231→\tt.Run(\"nil expected files does nothing\", func(t *testing.T) {\n   232→\t\t// Should not panic or fail\n   233→\t\tcompareExpectedFiles(t, nil, t.TempDir())\n   234→\t})\n   235→\n   236→\tt.Run(\"matching file content passes\", func(t *testing.T) {\n   237→\t\tdir := t.TempDir()\n   238→\t\tcontent := []byte(\"expected content\\n\")\n   239→\t\tif err := os.WriteFile(filepath.Join(dir, \"output.txt\"), content, 0644); err != nil {\n   240→\t\t\tt.Fatalf(\"setup: %v\", err)\n   241→\t\t}\n   242→\t\t// This should pass without calling t.Fatal\n   243→\t\tcompareExpectedFiles(t, map[string][]byte{\n   244→\t\t\t\"output.txt\": content,\n   245→\t\t}, dir)\n   246→\t})\n   247→\n   248→\tt.Run(\"mismatched file content fails\", func(t *testing.T) {\n   249→\t\tdir := t.TempDir()\n   250→\t\tif err := os.WriteFile(filepath.Join(dir, \"output.txt\"), []byte(\"actual\"), 0644); err != nil {\n   251→\t\t\tt.Fatalf(\"setup: %v\", err)\n   252→\t\t}\n   253→\n   254→\t\tmockT := &testing.T{}\n   255→\t\tdone := make(chan struct{})\n   256→\t\tgo func() {\n   257→\t\t\tdefer func() { close(done) }()\n   258→\t\t\tcompareExpectedFiles(mockT, map[string][]byte{\n   259→\t\t\t\t\"output.txt\": []byte(\"expected\"),\n   260→\t\t\t}, dir)\n   261→\t\t}()\n   262→\t\t<-done\n   263→\t\tif !mockT.Failed() {\n   264→\t\t\tt.Fatal(\"expected compareExpectedFiles to fail on content mismatch\")\n   265→\t\t}\n   266→\t})\n   267→\n   268→\tt.Run(\"missing file fails\", func(t *testing.T) {\n   269→\t\tdir := t.TempDir()\n   270→\n   271→\t\tmockT := &testing.T{}\n   272→\t\tdone := make(chan struct{})\n   273→\t\tgo func() {\n   274→\t\t\tdefer func() { close(done) }()\n   275→\t\t\tcompareExpectedFiles(mockT, map[string][]byte{\n   276→\t\t\t\t\"nonexistent.txt\": []byte(\"content\"),\n   277→\t\t\t}, dir)\n   278→\t\t}()\n   279→\t\t<-done\n   280→\t\tif !mockT.Failed() {\n   281→\t\t\tt.Fatal(\"expected compareExpectedFiles to fail on missing file\")\n   282→\t\t}\n   283→\t})\n   284→}\n   285→\n   286→// assertEnvContains checks that the env slice contains key=value.\n   287→func assertEnvContains(t *testing.T, env []string, key, value string) {\n   288→\tt.Helper()\n   289→\ttarget := key + \"=\" + value\n   290→\tfor _, e := range env {\n   291→\t\tif e == target {\n   292→\t\t\treturn\n   293→\t\t}\n   294→\t}\n   295→\tt.Fatalf(\"expected %s=%s in env, not found\", key, value)\n   296→}\n   297→\n   298→// countEnvKey counts how many entries in env start with key=.\n   299→func countEnvKey(env []string, key string) int {\n   300→\tprefix := key + \"=\"\n   301→\tcount := 0\n   302→\tfor _, e := range env {\n   303→\t\tif strings.HasPrefix(e, prefix) {\n   304→\t\t\tcount++\n   305→\t\t}\n   306→\t}\n   307→\treturn count\n   308→}\n   309→"}]},"parent_tool_use_id":null,"session_id":"e111a86a-32bb-4674-a797-2abfae58b6f8","uuid":"ac5d25c1-2e9f-4a70-bdde-efd20079f5e6","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/92/pkg/testutils/runner_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Tests for runner.go: buildEnv, setEnvVar, formatDivergence, truncateBytes,\n// compareExpectedFiles.\n// Implements: prd001-testutils (R2.6, R3.5, R5.1, R5.2)\npackage testutils\n\nimport (\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n)\n\nfunc TestBuildEnv(t *testing.T) {\n\ttests := []struct {\n\t\tname    string\n\t\ttestEnv []string\n\t\tcheck   func(t *testing.T, env []string)\n\t}{\n\t\t{\n\t\t\tname:    \"default sets LC_ALL=C\",\n\t\t\ttestEnv: nil,\n\t\t\tcheck: func(t *testing.T, env []string) {\n\t\t\t\tt.Helper()\n\t\t\t\tassertEnvContains(t, env, \"LC_ALL\", \"C\")\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tname:    \"caller variable is merged\",\n\t\t\ttestEnv: []string{\"MY_CUSTOM_VAR=hello\"},\n\t\t\tcheck: func(t *testing.T, env []string) {\n\t\t\t\tt.Helper()\n\t\t\t\tassertEnvContains(t, env, \"MY_CUSTOM_VAR\", \"hello\")\n\t\t\t\t// LC_ALL=C should still be present\n\t\t\t\tassertEnvContains(t, env, \"LC_ALL\", \"C\")\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tname:    \"caller overrides LC_ALL\",\n\t\t\ttestEnv: []string{\"LC_ALL=en_US.UTF-8\"},\n\t\t\tcheck: func(t *testing.T, env []string) {\n\t\t\t\tt.Helper()\n\t\t\t\tassertEnvContains(t, env, \"LC_ALL\", \"en_US.UTF-8\")\n\t\t\t\t// Must not have duplicate LC_ALL entries\n\t\t\t\tcount := countEnvKey(env, \"LC_ALL\")\n\t\t\t\tif count != 1 {\n\t\t\t\t\tt.Fatalf(\"expected exactly 1 LC_ALL entry, got %d\", count)\n\t\t\t\t}\n\t\t\t},\n\t\t},\n\t\t{\n\t\t\tname:    \"override replaces rather than duplicates\",\n\t\t\ttestEnv: []string{\"PATH=/custom/path\"},\n\t\t\tcheck: func(t *testing.T, env []string) {\n\t\t\t\tt.Helper()\n\t\t\t\tassertEnvContains(t, env, \"PATH\", \"/custom/path\")\n\t\t\t\tcount := countEnvKey(env, \"PATH\")\n\t\t\t\tif count != 1 {\n\t\t\t\t\tt.Fatalf(\"expected exactly 1 PATH entry, got %d\", count)\n\t\t\t\t}\n\t\t\t},\n\t\t},\n\t}\n\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tenv := buildEnv(tc.testEnv)\n\t\t\ttc.check(t, env)\n\t\t})\n\t}\n}\n\nfunc TestSetEnvVar(t *testing.T) {\n\ttests := []struct {\n\t\tname     string\n\t\tinitial  []string\n\t\tkey      string\n\t\tvalue    string\n\t\twantKey  string\n\t\twantVal  string\n\t\twantLen  int\n\t}{\n\t\t{\n\t\t\tname:    \"add new variable to empty slice\",\n\t\t\tinitial: []string{},\n\t\t\tkey:     \"FOO\",\n\t\t\tvalue:   \"bar\",\n\t\t\twantKey: \"FOO\",\n\t\t\twantVal: \"bar\",\n\t\t\twantLen: 1,\n\t\t},\n\t\t{\n\t\t\tname:    \"add new variable to existing slice\",\n\t\t\tinitial: []string{\"A=1\", \"B=2\"},\n\t\t\tkey:     \"C\",\n\t\t\tvalue:   \"3\",\n\t\t\twantKey: \"C\",\n\t\t\twantVal: \"3\",\n\t\t\twantLen: 3,\n\t\t},\n\t\t{\n\t\t\tname:    \"override existing variable\",\n\t\t\tinitial: []string{\"A=1\", \"B=2\", \"C=3\"},\n\t\t\tkey:     \"B\",\n\t\t\tvalue:   \"replaced\",\n\t\t\twantKey: \"B\",\n\t\t\twantVal: \"replaced\",\n\t\t\twantLen: 3,\n\t\t},\n\t}\n\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tresult := setEnvVar(tc.initial, tc.key, tc.value)\n\t\t\tif len(result) != tc.wantLen {\n\t\t\t\tt.Fatalf(\"expected length %d, got %d\", tc.wantLen, len(result))\n\t\t\t}\n\t\t\tassertEnvContains(t, result, tc.wantKey, tc.wantVal)\n\t\t})\n\t}\n}\n\nfunc TestFormatDivergence(t *testing.T) {\n\ttc := DiffTest{\n\t\tName:  \"test-case\",\n\t\tArgs:  []string{\"-n\", \"file.txt\"},\n\t\tStdin: []byte(\"input data\"),\n\t}\n\trefStdout := []byte(\"ref output\")\n\tgoStdout := []byte(\"go output\")\n\trefStderr := []byte(\"ref error\")\n\tgoStderr := []byte(\"go error\")\n\trefExit := 0\n\tgoExit := 1\n\n\tmsg := formatDivergence(tc, refStdout, goStdout, refStderr, goStderr, refExit, goExit)\n\n\t// Verify all required fields are present in the divergence report (prd001-testutils R3.5)\n\trequiredFields := []struct {\n\t\tlabel string\n\t\tvalue string\n\t}{\n\t\t{\"args\", \"-n\"},\n\t\t{\"args\", \"file.txt\"},\n\t\t{\"stdin\", \"input data\"},\n\t\t{\"ref stdout\", \"ref output\"},\n\t\t{\"go stdout\", \"go output\"},  // labeled \"go  stdout\" in format string\n\t\t{\"ref stderr\", \"ref error\"},\n\t\t{\"go stderr\", \"go error\"},   // labeled \"go  stderr\" in format string\n\t\t{\"ref exit\", \"0\"},\n\t\t{\"go exit\", \"1\"},            // labeled \"go  exit\" in format string\n\t}\n\tfor _, f := range requiredFields {\n\t\tif !strings.Contains(msg, f.value) {\n\t\t\tt.Fatalf(\"divergence message missing %s value %q\\nmessage: %s\", f.label, f.value, msg)\n\t\t}\n\t}\n}\n\nfunc TestFormatDivergenceNilStdin(t *testing.T) {\n\ttc := DiffTest{\n\t\tName: \"nil-stdin\",\n\t\tArgs: []string{},\n\t}\n\tmsg := formatDivergence(tc, []byte(\"a\"), []byte(\"b\"), nil, nil, 0, 0)\n\tif !strings.Contains(msg, \"<nil>\") {\n\t\tt.Fatalf(\"expected <nil> for nil stdin, got: %s\", msg)\n\t}\n}\n\nfunc TestTruncateBytes(t *testing.T) {\n\ttests := []struct {\n\t\tname   string\n\t\tinput  []byte\n\t\tmaxLen int\n\t\twant   string\n\t}{\n\t\t{\n\t\t\tname:   \"nil input returns <nil>\",\n\t\t\tinput:  nil,\n\t\t\tmaxLen: 256,\n\t\t\twant:   \"<nil>\",\n\t\t},\n\t\t{\n\t\t\tname:   \"short input returns full content\",\n\t\t\tinput:  []byte(\"hello\"),\n\t\t\tmaxLen: 256,\n\t\t\twant:   `\"hello\"`,\n\t\t},\n\t\t{\n\t\t\tname:   \"exact length returns full content\",\n\t\t\tinput:  []byte(\"abc\"),\n\t\t\tmaxLen: 3,\n\t\t\twant:   `\"abc\"`,\n\t\t},\n\t\t{\n\t\t\tname:   \"long input is truncated with byte count\",\n\t\t\tinput:  []byte(\"abcdefghij\"),\n\t\t\tmaxLen: 5,\n\t\t\twant:   \"\", // checked below\n\t\t},\n\t}\n\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tgot := truncateBytes(tc.input, tc.maxLen)\n\t\t\tif tc.name == \"long input is truncated with byte count\" {\n\t\t\t\t// Must contain \"truncated\" and the total byte count\n\t\t\t\tif !strings.Contains(got, \"truncated\") {\n\t\t\t\t\tt.Fatalf(\"expected 'truncated' in output, got: %s\", got)\n\t\t\t\t}\n\t\t\t\tif !strings.Contains(got, \"10 bytes total\") {\n\t\t\t\t\tt.Fatalf(\"expected '10 bytes total' in output, got: %s\", got)\n\t\t\t\t}\n\t\t\t\t// Must not contain the full input\n\t\t\t\tif strings.Contains(got, \"abcdefghij\") {\n\t\t\t\t\tt.Fatalf(\"expected truncated output, got full content: %s\", got)\n\t\t\t\t}\n\t\t\t\treturn\n\t\t\t}\n\t\t\tif got != tc.want {\n\t\t\t\tt.Fatalf(\"expected %q, got %q\", tc.want, got)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestCompareExpectedFiles(t *testing.T) {\n\tt.Run(\"nil expected files does nothing\", func(t *testing.T) {\n\t\t// Should not panic or fail\n\t\tcompareExpectedFiles(t, nil, t.TempDir())\n\t})\n\n\tt.Run(\"matching file content passes\", func(t *testing.T) {\n\t\tdir := t.TempDir()\n\t\tcontent := []byte(\"expected content\\n\")\n\t\tif err := os.WriteFile(filepath.Join(dir, \"output.txt\"), content, 0644); err != nil {\n\t\t\tt.Fatalf(\"setup: %v\", err)\n\t\t}\n\t\t// This should pass without calling t.Fatal\n\t\tcompareExpectedFiles(t, map[string][]byte{\n\t\t\t\"output.txt\": content,\n\t\t}, dir)\n\t})\n\n\tt.Run(\"mismatched file content fails\", func(t *testing.T) {\n\t\tdir := t.TempDir()\n\t\tif err := os.WriteFile(filepath.Join(dir, \"output.txt\"), []byte(\"actual\"), 0644); err != nil {\n\t\t\tt.Fatalf(\"setup: %v\", err)\n\t\t}\n\n\t\tmockT := &testing.T{}\n\t\tdone := make(chan struct{})\n\t\tgo func() {\n\t\t\tdefer func() { close(done) }()\n\t\t\tcompareExpectedFiles(mockT, map[string][]byte{\n\t\t\t\t\"output.txt\": []byte(\"expected\"),\n\t\t\t}, dir)\n\t\t}()\n\t\t<-done\n\t\tif !mockT.Failed() {\n\t\t\tt.Fatal(\"expected compareExpectedFiles to fail on content mismatch\")\n\t\t}\n\t})\n\n\tt.Run(\"missing file fails\", func(t *testing.T) {\n\t\tdir := t.TempDir()\n\n\t\tmockT := &testing.T{}\n\t\tdone := make(chan struct{})\n\t\tgo func() {\n\t\t\tdefer func() { close(done) }()\n\t\t\tcompareExpectedFiles(mockT, map[string][]byte{\n\t\t\t\t\"nonexistent.txt\": []byte(\"content\"),\n\t\t\t}, dir)\n\t\t}()\n\t\t<-done\n\t\tif !mockT.Failed() {\n\t\t\tt.Fatal(\"expected compareExpectedFiles to fail on missing file\")\n\t\t}\n\t})\n}\n\n// assertEnvContains checks that the env slice contains key=value.\nfunc assertEnvContains(t *testing.T, env []string, key, value string) {\n\tt.Helper()\n\ttarget := key + \"=\" + value\n\tfor _, e := range env {\n\t\tif e == target {\n\t\t\treturn\n\t\t}\n\t}\n\tt.Fatalf(\"expected %s=%s in env, not found\", key, value)\n}\n\n// countEnvKey counts how many entries in env start with key=.\nfunc countEnvKey(env []string, key string) int {\n\tprefix := key + \"=\"\n\tcount := 0\n\tfor _, e := range env {\n\t\tif strings.HasPrefix(e, prefix) {\n\t\t\tcount++\n\t\t}\n\t}\n\treturn count\n}\n","numLines":309,"startLine":1,"totalLines":309}}}
