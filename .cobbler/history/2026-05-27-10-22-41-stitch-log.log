{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KDF4HSTX82Rft2jtQomB43","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd097-who R1.1, R1.2, R1.3, R1.4.\n5\tpackage main\n6\t\n7\t/*\n8\t#include <utmpx.h>\n9\t#include <unistd.h>\n10\t#include <stdlib.h>\n11\t*/\n12\timport \"C\"\n13\t\n14\timport (\n15\t\t\"fmt\"\n16\t\t\"os\"\n17\t\t\"strings\"\n18\t\t\"time\"\n19\t\t\"unsafe\"\n20\t\n21\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n22\t)\n23\t\n24\tconst helpText = `Usage: who [OPTION]... [ FILE | ARG1 ARG2 ]\n25\tPrint information about users who are currently logged in.\n26\t\n27\t      --help     display this help and exit\n28\t      --version  output version information and exit\n29\t\n30\tIf FILE is not specified, use /var/run/utmpx.  /var/log/wtmp as FILE is common.\n31\tIf ARG1 ARG2 given, -m presumed: 'am i' or 'mom likes' are usual.\n32\t`\n33\t\n34\tconst versionText = `who (go-unix-utils) dev\n35\t`\n36\t\n37\ttype whoEntry struct {\n38\t\tuser string\n39\t\tline string\n40\t\ttime time.Time\n41\t\thost string\n42\t}\n43\t\n44\tfunc main() {\n45\t\tsys.InstallSIGPIPEHandler()\n46\t\targs, amI := parseArgs(os.Args[1:])\n47\t\n48\t\tif len(args) == 1 {\n49\t\t\tif err := setUtmpxFile(args[0]); err != nil {\n50\t\t\t\tfmt.Fprintf(os.Stderr, \"who: %s: %v\\n\", args[0], err)\n51\t\t\t\tos.Exit(1)\n52\t\t\t}\n53\t\t}\n54\t\n55\t\tentries := readEntries(amI)\n56\t\tfor _, e := range entries {\n57\t\t\tif err := printEntry(e); err != nil {\n58\t\t\t\tos.Exit(1)\n59\t\t\t}\n60\t\t}\n61\t}\n62\t\n63\tfunc setUtmpxFile(path string) error {\n64\t\tf, err := os.Open(path)\n65\t\tif err != nil {\n66\t\t\tif pe, ok := err.(*os.PathError); ok {\n67\t\t\t\treturn pe.Err\n68\t\t\t}\n69\t\t\treturn err\n70\t\t}\n71\t\tf.Close()\n72\t\tcpath := C.CString(path)\n73\t\tC.utmpxname(cpath)\n74\t\tC.free(unsafe.Pointer(cpath))\n75\t\treturn nil\n76\t}\n77\t\n78\tfunc readEntries(amI bool) []whoEntry {\n79\t\tvar myLine string\n80\t\tif amI {\n81\t\t\tmyLine = currentLine()\n82\t\t\tif myLine == \"\" {\n83\t\t\t\treturn nil\n84\t\t\t}\n85\t\t}\n86\t\n87\t\tC.setutxent()\n88\t\tdefer C.endutxent()\n89\t\n90\t\tvar entries []whoEntry\n91\t\tfor {\n92\t\t\tentry := C.getutxent()\n93\t\t\tif entry == nil {\n94\t\t\t\tbreak\n95\t\t\t}\n96\t\t\tif entry.ut_type != C.USER_PROCESS {\n97\t\t\t\tcontinue\n98\t\t\t}\n99\t\t\tline := C.GoString(&entry.ut_line[0])\n100\t\t\tif amI && line != myLine {\n101\t\t\t\tcontinue\n102\t\t\t}\n103\t\t\tentries = append(entries, whoEntry{\n104\t\t\t\tuser: C.GoString(&entry.ut_user[0]),\n105\t\t\t\tline: line,\n106\t\t\t\ttime: time.Unix(int64(entry.ut_tv.tv_sec), 0),\n107\t\t\t\thost: C.GoString(&entry.ut_host[0]),\n108\t\t\t})\n109\t\t}\n110\t\treturn entries\n111\t}\n112\t\n113\tfunc currentLine() string {\n114\t\ttty := C.ttyname(C.int(os.Stdin.Fd()))\n115\t\tif tty == nil {\n116\t\t\treturn \"\"\n117\t\t}\n118\t\treturn strings.TrimPrefix(C.GoString(tty), \"/dev/\")\n119\t}\n120\t\n121\tfunc printEntry(e whoEntry) error {\n122\t\ttimeStr := e.time.Format(\"2006-01-02 15:04\")\n123\t\tvar line string\n124\t\tif e.host != \"\" {\n125\t\t\tline = fmt.Sprintf(\"%-8s %-12s %s (%s)\", e.user, e.line, timeStr, e.host)\n126\t\t} else {\n127\t\t\tline = fmt.Sprintf(\"%-8s %-12s %s\", e.user, e.line, timeStr)\n128\t\t}\n129\t\t_, err := fmt.Fprintln(os.Stdout, line)\n130\t\treturn err\n131\t}\n132\t\n133\tfunc parseArgs(args []string) ([]string, bool) {\n134\t\tvar remaining []string\n135\t\tendOfFlags := false\n136\t\tfor _, arg := range args {\n137\t\t\tif endOfFlags {\n138\t\t\t\tremaining = append(remaining, arg)\n139\t\t\t\tcontinue\n140\t\t\t}\n141\t\t\tswitch {\n142\t\t\tcase arg == \"--help\":\n143\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n144\t\t\t\tos.Exit(0)\n145\t\t\tcase arg == \"--version\":\n146\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n147\t\t\t\tos.Exit(0)\n148\t\t\tcase arg == \"--\":\n149\t\t\t\tendOfFlags = true\n150\t\t\tcase strings.HasPrefix(arg, \"--\"):\n151\t\t\t\tfmt.Fprintf(os.Stderr, \"who: unrecognized option '%s'\\n\", arg)\n152\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'who --help' for more information.\")\n153\t\t\t\tos.Exit(1)\n154\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n155\t\t\t\tfmt.Fprintf(os.Stderr, \"who: invalid option -- '%c'\\n\", arg[1])\n156\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'who --help' for more information.\")\n157\t\t\t\tos.Exit(1)\n158\t\t\tdefault:\n159\t\t\t\tremaining = append(remaining, arg)\n160\t\t\t}\n161\t\t}\n162\t\tif len(remaining) == 2 {\n163\t\t\treturn nil, true\n164\t\t}\n165\t\tif len(remaining) > 2 {\n166\t\t\tfmt.Fprintf(os.Stderr, \"who: extra operand '%s'\\n\", remaining[2])\n167\t\t\tfmt.Fprintln(os.Stderr, \"Try 'who --help' for more information.\")\n168\t\t\tos.Exit(1)\n169\t\t}\n170\t\treturn remaining, false\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"44efa1bf-5dfc-4bcb-b29a-a970794915e8","uuid":"e0bff941-698e-4c0c-98bf-ddf0263aace8","timestamp":"2026-05-27T14:23:53.565Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5582/cmd/who/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd097-who R1.1, R1.2, R1.3, R1.4.\npackage main\n\n/*\n#include <utmpx.h>\n#include <unistd.h>\n#include <stdlib.h>\n*/\nimport \"C\"\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n\t\"time\"\n\t\"unsafe\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: who [OPTION]... [ FILE | ARG1 ARG2 ]\nPrint information about users who are currently logged in.\n\n      --help     display this help and exit\n      --version  output version information and exit\n\nIf FILE is not specified, use /var/run/utmpx.  /var/log/wtmp as FILE is common.\nIf ARG1 ARG2 given, -m presumed: 'am i' or 'mom likes' are usual.\n`\n\nconst versionText = `who (go-unix-utils) dev\n`\n\ntype whoEntry struct {\n\tuser string\n\tline string\n\ttime time.Time\n\thost string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\targs, amI := parseArgs(os.Args[1:])\n\n\tif len(args) == 1 {\n\t\tif err := setUtmpxFile(args[0]); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"who: %s: %v\\n\", args[0], err)\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\n\tentries := readEntries(amI)\n\tfor _, e := range entries {\n\t\tif err := printEntry(e); err != nil {\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n}\n\nfunc setUtmpxFile(path string) error {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\tif pe, ok := err.(*os.PathError); ok {\n\t\t\treturn pe.Err\n\t\t}\n\t\treturn err\n\t}\n\tf.Close()\n\tcpath := C.CString(path)\n\tC.utmpxname(cpath)\n\tC.free(unsafe.Pointer(cpath))\n\treturn nil\n}\n\nfunc readEntries(amI bool) []whoEntry {\n\tvar myLine string\n\tif amI {\n\t\tmyLine = currentLine()\n\t\tif myLine == \"\" {\n\t\t\treturn nil\n\t\t}\n\t}\n\n\tC.setutxent()\n\tdefer C.endutxent()\n\n\tvar entries []whoEntry\n\tfor {\n\t\tentry := C.getutxent()\n\t\tif entry == nil {\n\t\t\tbreak\n\t\t}\n\t\tif entry.ut_type != C.USER_PROCESS {\n\t\t\tcontinue\n\t\t}\n\t\tline := C.GoString(&entry.ut_line[0])\n\t\tif amI && line != myLine {\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, whoEntry{\n\t\t\tuser: C.GoString(&entry.ut_user[0]),\n\t\t\tline: line,\n\t\t\ttime: time.Unix(int64(entry.ut_tv.tv_sec), 0),\n\t\t\thost: C.GoString(&entry.ut_host[0]),\n\t\t})\n\t}\n\treturn entries\n}\n\nfunc currentLine() string {\n\ttty := C.ttyname(C.int(os.Stdin.Fd()))\n\tif tty == nil {\n\t\treturn \"\"\n\t}\n\treturn strings.TrimPrefix(C.GoString(tty), \"/dev/\")\n}\n\nfunc printEntry(e whoEntry) error {\n\ttimeStr := e.time.Format(\"2006-01-02 15:04\")\n\tvar line string\n\tif e.host != \"\" {\n\t\tline = fmt.Sprintf(\"%-8s %-12s %s (%s)\", e.user, e.line, timeStr, e.host)\n\t} else {\n\t\tline = fmt.Sprintf(\"%-8s %-12s %s\", e.user, e.line, timeStr)\n\t}\n\t_, err := fmt.Fprintln(os.Stdout, line)\n\treturn err\n}\n\nfunc parseArgs(args []string) ([]string, bool) {\n\tvar remaining []string\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tremaining = append(remaining, arg)\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\tendOfFlags = true\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"who: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'who --help' for more information.\")\n\t\t\tos.Exit(1)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tfmt.Fprintf(os.Stderr, \"who: invalid option -- '%c'\\n\", arg[1])\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'who --help' for more information.\")\n\t\t\tos.Exit(1)\n\t\tdefault:\n\t\t\tremaining = append(remaining, arg)\n\t\t}\n\t}\n\tif len(remaining) == 2 {\n\t\treturn nil, true\n\t}\n\tif len(remaining) > 2 {\n\t\tfmt.Fprintf(os.Stderr, \"who: extra operand '%s'\\n\", remaining[2])\n\t\tfmt.Fprintln(os.Stderr, \"Try 'who --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\treturn remaining, false\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
