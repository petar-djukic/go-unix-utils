return assignPositional(opts, positional)\n78\t}\n79\t\n80\tfunc assignPositional(opts options, pos []string) (options, string, error) {\n81\t\tfile := \"-\"\n82\t\tif len(pos) >= 1 {\n83\t\t\tfile = pos[0]\n84\t\t}\n85\t\tif len(pos) >= 2 {\n86\t\t\topts.prefix = pos[1]\n87\t\t}\n88\t\tif len(pos) > 2 {\n89\t\t\treturn opts, \"\", fmt.Errorf(\"extra operand '%s'\", pos[2])\n90\t\t}\n91\t\treturn opts, file, nil\n92\t}\n93\t\n94\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n95\t\tswitch {\n96\t\tcase flag == \"--lines\":\n97\t\t\tif len(remaining) < 2 {\n98\t\t\t\treturn 0, fmt.Errorf(\"option '--lines' requires an argument\")\n99\t\t\t}\n100\t\t\tn, err := parseLineCount(remaining[1])\n101\t\t\tif err != nil {\n102\t\t\t\treturn 0, err\n103\t\t\t}\n104\t\t\topts.lines = n\n105\t\t\treturn 2, nil\n106\t\tcase strings.HasPrefix(flag, \"--lines=\"):\n107\t\t\tn, err := parseLineCount(flag[len(\"--lines=\"):])\n108\t\t\tif err != nil {\n109\t\t\t\treturn 0, err\n110\t\t\t}\n111\t\t\topts.lines = n\n112\t\t\treturn 1, nil\n113\t\tdefault:\n114\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n115\t\t}\n116\t}\n117\t\n118\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n119\t\tconsumed := 0\n120\t\tfor j := 0; j < len(flags); j++ {\n121\t\t\tswitch flags[j] {\n122\t\t\tcase 'l':\n123\t\t\t\tval, extra, err := extractFlagValue(flags[j+1:], remaining, consumed, 'l')\n124\t\t\t\tif err != nil {\n125\t\t\t\t\treturn 0, err\n126\t\t\t\t}\n127\t\t\t\tn, err := parseLineCount(val)\n128\t\t\t\tif err != nil {\n129\t\t\t\t\treturn 0, err\n130\t\t\t\t}\n131\t\t\t\topts.lines = n\n132\t\t\t\treturn consumed + extra, nil\n133\t\t\tdefault:\n134\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n135\t\t\t}\n136\t\t}\n137\t\treturn consumed, nil\n138\t}\n139\t\n140\tfunc extractFlagValue(rest string, remaining []string, consumed int, flag byte) (string, int, error) {\n141\t\tif res