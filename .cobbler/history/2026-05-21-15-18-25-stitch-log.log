{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B3TXKNUft16fNSqAiD9Q47","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"bytes\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\ttype splitMode int\n20\t\n21\tconst (\n22\t\tmodeLines splitMode = iota\n23\t\tmodeBytes\n24\t\tmodeLineBytes\n25\t\tmodeChunks\n26\t)\n27\t\n28\ttype options struct {\n29\t\tmode      splitMode\n30\t\tmodeSet   bool\n31\t\tlines     int\n32\t\tbytesVal  int64\n33\t\tlineBytes int64\n34\t\tchunks    string\n35\t\tprefix    string\n36\t}\n37\t\n38\tfunc main() {\n39\t\tsys.InstallSIGPIPEHandler()\n40\t\n41\t\topts, file, err := parseArgs(os.Args[1:])\n42\t\tif err != nil {\n43\t\t\tfmt.Fprintf(os.Stderr, \"split: %s\\n\", err)\n44\t\t\tos.Exit(1)\n45\t\t}\n46\t\n47\t\tr, closer, err := openInput(file)\n48\t\tif err != nil {\n49\t\t\tfmt.Fprintf(os.Stderr, \"split: %s\\n\", err)\n50\t\t\tos.Exit(1)\n51\t\t}\n52\t\tif closer != nil {\n53\t\t\tdefer closer.Close()\n54\t\t}\n55\t\n56\t\tif err := run(r, opts); err != nil {\n57\t\t\tfmt.Fprintf(os.Stderr, \"split: %s\\n\", err)\n58\t\t\tos.Exit(1)\n59\t\t}\n60\t}\n61\t\n62\tfunc parseArgs(args []string) (options, string, error) {\n63\t\topts := options{lines: 1000, prefix: \"x\"}\n64\t\tvar positional []string\n65\t\n66\t\ti := 0\n67\t\tfor i < len(args) {\n68\t\t\targ := args[i]\n69\t\t\tif arg == \"--\" {\n70\t\t\t\tpositional = append(positional, args[i+1:]...)\n71\t\t\t\tbreak\n72\t\t\t}\n73\t\t\tif strings.HasPrefix(arg, \"--\") {\n74\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n75\t\t\t\tif err != nil {\n76\t\t\t\t\treturn opts, \"\", err\n77\t\t\t\t}\n78\t\t\t\ti += n\n79\t\t\t\tcontinue\n80\t\t\t}\n81\t\t\tif len(arg) > 1 && arg[0] == '-' {\n82\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n83\t\t\t\tif err != nil {\n84\t\t\t\t\treturn opts, \"\", err\n85\t\t\t\t}\n86\t\t\t\ti += 1 + n\n87\t\t\t\tcontinue\n88\t\t\t}\n89\t\t\tpositional = append(positional, arg)\n90\t\t\ti++\n91\t\t}\n92\t\n93\t\treturn assignPositional(opts, positional)\n94\t}\n95\t\n96\tfunc assignPositional(opts options, pos []string) (options, string, error) {\n97\t\tfile := \"-\"\n98\t\tif len(pos) >= 1 {\n99\t\t\tfile = pos[0]\n100\t\t}\n101\t\tif len(pos) >= 2 {\n102\t\t\topts.prefix = pos[1]\n103\t\t}\n104\t\tif len(pos) > 2 {\n105\t\t\treturn opts, \"\", fmt.Errorf(\"extra operand '%s'\", pos[2])\n106\t\t}\n107\t\treturn opts, file, nil\n108\t}\n109\t\n110\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n111\t\tswitch {\n112\t\tcase flag == \"--lines\" || strings.HasPrefix(flag, \"--lines=\"):\n113\t\t\tval, n, err := longOptValue(flag, \"--lines\", remaining)\n114\t\t\tif err != nil {\n115\t\t\t\treturn 0, err\n116\t\t\t}\n117\t\t\treturn n, setLineMode(opts, val)\n118\t\tcase flag == \"--bytes\" || strings.HasPrefix(flag, \"--bytes=\"):\n119\t\t\tval, n, err := longOptValue(flag, \"--bytes\", remaining)\n120\t\t\tif err != nil {\n121\t\t\t\treturn 0, err\n122\t\t\t}\n123\t\t\treturn n, setBytesMode(opts, val)\n124\t\tcase flag == \"--line-bytes\" || strings.HasPrefix(flag, \"--line-bytes=\"):\n125\t\t\tval, n, err := longOptValue(flag, \"--line-bytes\", remaining)\n126\t\t\tif err != nil {\n127\t\t\t\treturn 0, err\n128\t\t\t}\n129\t\t\treturn n, setLineBytesMode(opts, val)\n130\t\tcase flag == \"--number\" || strings.HasPrefix(flag, \"--number=\"):\n131\t\t\tval, n, err := longOptValue(flag, \"--number\", remaining)\n132\t\t\tif err != nil {\n133\t\t\t\treturn 0, err\n134\t\t\t}\n135\t\t\treturn n, setChunksMode(opts, val)\n136\t\tdefault:\n137\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n138\t\t}\n139\t}\n140\t\n141\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n142\t\tconsumed := 0\n143\t\tfor j := 0; j < len(flags); j++ {\n144\t\t\tsetter, ok := shortFlagSetter(flags[j])\n145\t\t\tif !ok {\n146\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n147\t\t\t}\n148\t\t\tval, extra, err := extractFlagValue(flags[j+1:], remaining, consumed, flags[j])\n149\t\t\tif err != nil {\n150\t\t\t\treturn 0, err\n151\t\t\t}\n152\t\t\tif err := setter(opts, val); err != nil {\n153\t\t\t\treturn 0, err\n154\t\t\t}\n155\t\t\treturn consumed + extra, nil\n156\t\t}\n157\t\treturn consumed, nil\n158\t}\n159\t\n160\tfunc shortFlagSetter(ch byte) (func(*options, string) error, bool) {\n161\t\tswitch ch {\n162\t\tcase 'l':\n163\t\t\treturn setLineMode, true\n164\t\tcase 'b':\n165\t\t\treturn setBytesMode, true\n166\t\tcase 'C':\n167\t\t\treturn setLineBytesMode, true\n168\t\tcase 'n':\n169\t\t\treturn setChunksMode, true\n170\t\tdefault:\n171\t\t\treturn nil, false\n172\t\t}\n173\t}\n174\t\n175\tfunc extractFlagValue(rest string, remaining []string, consumed int, flag byte) (string, int, error) {\n176\t\tif rest != \"\" {\n177\t\t\treturn rest, 0, nil\n178\t\t}\n179\t\tif len(remaining) > consumed {\n180\t\t\treturn remaining[consumed], 1, nil\n181\t\t}\n182\t\treturn \"\", 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n183\t}\n184\t\n185\tfunc parseLineCount(s string) (int, error) {\n186\t\tn, err := strconv.Atoi(s)\n187\t\tif err != nil || n <= 0 {\n188\t\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n189\t\t}\n190\t\treturn n, nil\n191\t}\n192\t\n193\tfunc openInput(name string) (io.Reader, io.Closer, error) {\n194\t\tif name == \"-\" {\n195\t\t\treturn os.Stdin, nil, nil\n196\t\t}\n197\t\tf, err := os.Open(name)\n198\t\tif err != nil {\n199\t\t\treturn nil, nil, err\n200\t\t}\n201\t\treturn f, f, nil\n202\t}\n203\t\n204\tfunc splitLines(r io.Reader, prefix string, linesPerPiece int) error {\n205\t\tbr := bufio.NewReader(r)\n206\t\tlineCount := 0\n207\t\tpieceIndex := 0\n208\t\tvar w *os.File\n209\t\n210\t\tfor {\n211\t\t\tline, readErr := br.ReadBytes('\\n')\n212\t\t\tif len(line) > 0 {\n213\t\t\t\tif lineCount%linesPerPiece == 0 {\n214\t\t\t\t\tif w != nil {\n215\t\t\t\t\t\tw.Close()\n216\t\t\t\t\t}\n217\t\t\t\t\tvar err error\n218\t\t\t\t\tw, err = openPiece(prefix, pieceIndex)\n219\t\t\t\t\tif err != nil {\n220\t\t\t\t\t\treturn err\n221\t\t\t\t\t}\n222\t\t\t\t\tpieceIndex++\n223\t\t\t\t}\n224\t\t\t\tif _, err := w.Write(line); err != nil {\n225\t\t\t\t\tw.Close()\n226\t\t\t\t\treturn err\n227\t\t\t\t}\n228\t\t\t\tlineCount++\n229\t\t\t}\n230\t\t\tif readErr != nil {\n231\t\t\t\tif w != nil {\n232\t\t\t\t\tw.Close()\n233\t\t\t\t}\n234\t\t\t\tif readErr != io.EOF {\n235\t\t\t\t\treturn readErr\n236\t\t\t\t}\n237\t\t\t\treturn nil\n238\t\t\t}\n239\t\t}\n240\t}\n241\t\n242\tfunc openPiece(prefix string, index int) (*os.File, error) {\n243\t\tsuffix, err := alphabeticSuffix(index, 2)\n244\t\tif err != nil {\n245\t\t\treturn nil, err\n246\t\t}\n247\t\treturn os.Create(prefix + suffix)\n248\t}\n249\t\n250\tfunc alphabeticSuffix(index, length int) (string, error) {\n251\t\tmaxPieces := 1\n252\t\tfor range length {\n253\t\t\tmaxPieces *= 26\n254\t\t}\n255\t\tif index >= maxPieces {\n256\t\t\treturn \"\", fmt.Errorf(\"output file suffixes exhausted\")\n257\t\t}\n258\t\tbuf := make([]byte, length)\n259\t\tfor i := length - 1; i >= 0; i-- {\n260\t\t\tbuf[i] = 'a' + byte(index%26)\n261\t\t\tindex /= 26\n262\t\t}\n263\t\treturn string(buf), nil\n264\t}\n265\t\n266\tfunc run(r io.Reader, opts options) error {\n267\t\tswitch opts.mode {\n268\t\tcase modeBytes:\n269\t\t\treturn splitBytes(r, opts.prefix, opts.bytesVal)\n270\t\tcase modeLineBytes:\n271\t\t\treturn splitLineBytes(r, opts.prefix, opts.lineBytes)\n272\t\tcase modeChunks:\n273\t\t\treturn splitChunks(r, opts.prefix, opts.chunks)\n274\t\tdefault:\n275\t\t\treturn splitLines(r, opts.prefix, opts.lines)\n276\t\t}\n277\t}\n278\t\n279\tfunc setMode(opts *options, mode splitMode) error {\n280\t\tif opts.modeSet && opts.mode != mode {\n281\t\t\treturn fmt.Errorf(\"cannot split in more than one way\")\n282\t\t}\n283\t\topts.mode = mode\n284\t\topts.modeSet = true\n285\t\treturn nil\n286\t}\n287\t\n288\tfunc setLineMode(opts *options, val string) error {\n289\t\tn, err := parseLineCount(val)\n290\t\tif err != nil {\n291\t\t\treturn err\n292\t\t}\n293\t\tif err := setMode(opts, modeLines); err != nil {\n294\t\t\treturn err\n295\t\t}\n296\t\topts.lines = n\n297\t\treturn nil\n298\t}\n299\t\n300\tfunc setBytesMode(opts *options, val string) error {\n301\t\tn, err := parseByteCount(val)\n302\t\tif err != nil {\n303\t\t\treturn err\n304\t\t}\n305\t\tif err := setMode(opts, modeBytes); err != nil {\n306\t\t\treturn err\n307\t\t}\n308\t\topts.bytesVal = n\n309\t\treturn nil\n310\t}\n311\t\n312\tfunc setLineBytesMode(opts *options, val string) error {\n313\t\tn, err := parseByteCount(val)\n314\t\tif err != nil {\n315\t\t\treturn err\n316\t\t}\n317\t\tif err := setMode(opts, modeLineBytes); err != nil {\n318\t\t\treturn err\n319\t\t}\n320\t\topts.lineBytes = n\n321\t\treturn nil\n322\t}\n323\t\n324\tfunc setChunksMode(opts *options, val string) error {\n325\t\tif err := setMode(opts, modeChunks); err != nil {\n326\t\t\treturn err\n327\t\t}\n328\t\topts.chunks = val\n329\t\treturn nil\n330\t}\n331\t\n332\tfunc longOptValue(flag, name string, remaining []string) (string, int, error) {\n333\t\tif strings.HasPrefix(flag, name+\"=\") {\n334\t\t\treturn flag[len(name)+1:], 1, nil\n335\t\t}\n336\t\tif len(remaining) < 2 {\n337\t\t\treturn \"\", 0, fmt.Errorf(\"option '%s' requires an argument\", name)\n338\t\t}\n339\t\treturn remaining[1], 2, nil\n340\t}\n341\t\n342\tfunc parseByteCount(s string) (int64, error) {\n343\t\tn, err := sizeparse.Parse(s)\n344\t\tif err != nil || n <= 0 {\n345\t\t\treturn 0, fmt.Errorf(\"invalid number of bytes: '%s'\", s)\n346\t\t}\n347\t\treturn n, nil\n348\t}\n349\t\n350\tfunc splitBytes(r io.Reader, prefix string, size int64) error {\n351\t\tpieceIndex := 0\n352\t\tfor {\n353\t\t\tw, err := openPiece(prefix, pieceIndex)\n354\t\t\tif err != nil {\n355\t\t\t\treturn err\n356\t\t\t}\n357\t\t\twritten, copyErr := io.CopyN(w, r, size)\n358\t\t\tw.Close()\n359\t\t\tif written == 0 {\n360\t\t\t\tos.Remove(w.Name())\n361\t\t\t}\n362\t\t\tif copyErr != nil {\n363\t\t\t\tif copyErr == io.EOF {\n364\t\t\t\t\treturn nil\n365\t\t\t\t}\n366\t\t\t\treturn copyErr\n367\t\t\t}\n368\t\t\tpieceIndex++\n369\t\t}\n370\t}\n371\t\n372\tfunc splitLineBytes(r io.Reader, prefix string, maxBytes int64) error {\n373\t\tsz := int(maxBytes)\n374\t\tbr := bufio.NewReaderSize(r, sz)\n375\t\tpieceIndex := 0\n376\t\n377\t\tfor {\n378\t\t\tdata, err := readLineBytesChunk(br, sz)\n379\t\t\tif len(data) > 0 {\n380\t\t\t\tif werr := writePiece(prefix, pieceIndex, data); werr != nil {\n381\t\t\t\t\treturn werr\n382\t\t\t\t}\n383\t\t\t\tpieceIndex++\n384\t\t\t}\n385\t\t\tif err != nil {\n386\t\t\t\tif err == io.EOF {\n387\t\t\t\t\treturn nil\n388\t\t\t\t}\n389\t\t\t\treturn err\n390\t\t\t}\n391\t\t}\n392\t}\n393\t\n394\tfunc readLineBytesChunk(br *bufio.Reader, sz int) ([]byte, error) {\n395\t\tbuf, _ := br.Peek(sz)\n396\t\tif len(buf) == 0 {\n397\t\t\treturn nil, io.EOF\n398\t\t}\n399\t\twriteLen := len(buf)\n400\t\tif len(buf) >= sz {\n401\t\t\tif lastNL := bytes.LastIndexByte(buf, '\\n'); lastNL >= 0 {\n402\t\t\t\twriteLen = lastNL + 1\n403\t\t\t}\n404\t\t}\n405\t\tdata := make([]byte, writeLen)\n406\t\t_, err := br.Read(data)\n407\t\treturn data, err\n408\t}\n409\t\n410\tfunc splitChunks(r io.Reader, prefix string, spec string) error {\n411\t\tmode, n, err := parseChunkSpec(spec)\n412\t\tif err != nil {\n413\t\t\treturn err\n414\t\t}\n415\t\tdata, err := io.ReadAll(r)\n416\t\tif err != nil {\n417\t\t\treturn err\n418\t\t}\n419\t\tswitch mode {\n420\t\tcase \"\":\n421\t\t\treturn splitByteChunks(data, prefix, n)\n422\t\tcase \"l\":\n423\t\t\treturn splitLineChunks(data, prefix, n)\n424\t\tcase \"r\":\n425\t\t\treturn splitRoundRobin(data, prefix, n)\n426\t\tdefault:\n427\t\t\treturn fmt.Errorf(\"invalid number of chunks: '%s'\", spec)\n428\t\t}\n429\t}\n430\t\n431\tfunc parseChunkSpec(spec string) (string, int, error) {\n432\t\tnumStr := spec\n433\t\tmode := \"\"\n434\t\tif strings.HasPrefix(spec, \"l/\") {\n435\t\t\tmode = \"l\"\n436\t\t\tnumStr = spec[2:]\n437\t\t} else if strings.HasPrefix(spec, \"r/\") {\n438\t\t\tmode = \"r\"\n439\t\t\tnumStr = spec[2:]\n440\t\t}\n441\t\tn, err := strconv.Atoi(numStr)\n442\t\tif err != nil || n <= 0 {\n443\t\t\treturn \"\", 0, fmt.Errorf(\"invalid number of chunks: '%s'\", spec)\n444\t\t}\n445\t\treturn mode, n, nil\n446\t}\n447\t\n448\tfunc splitByteChunks(data []byte, prefix string, n int) error {\n449\t\ttotal := len(data)\n450\t\tbaseSize := total / n\n451\t\tremainder := total % n\n452\t\toffset := 0\n453\t\tfor i := range n {\n454\t\t\tsize := baseSize\n455\t\t\tif i < remainder {\n456\t\t\t\tsize++\n457\t\t\t}\n458\t\t\tif err := writePiece(prefix, i, data[offset:offset+size]); err != nil {\n459\t\t\t\treturn err\n460\t\t\t}\n461\t\t\toffset += size\n462\t\t}\n463\t\treturn nil\n464\t}\n465\t\n466\tfunc splitLineChunks(data []byte, prefix string, n int) error {\n467\t\ttotal := int64(len(data))\n468\t\toffset := int64(0)\n469\t\tfor i := range n {\n470\t\t\ttarget := total * int64(i+1) / int64(n)\n471\t\t\tend := offset\n472\t\t\tif target > offset {\n473\t\t\t\tend = findLineEnd(data, target)\n474\t\t\t}\n475\t\t\tif err := writePiece(prefix, i, data[offset:end]); err != nil {\n476\t\t\t\treturn err\n477\t\t\t}\n478\t\t\toffset = end\n479\t\t}\n480\t\treturn nil\n481\t}\n482\t\n483\tfunc findLineEnd(data []byte, pos int64) int64 {\n484\t\tif pos <= 0 {\n485\t\t\treturn 0\n486\t\t}\n487\t\tif pos >= int64(len(data)) {\n488\t\t\treturn int64(len(data))\n489\t\t}\n490\t\tif data[pos-1] == '\\n' {\n491\t\t\treturn pos\n492\t\t}\n493\t\tidx := bytes.IndexByte(data[pos:], '\\n')\n494\t\tif idx < 0 {\n495\t\t\treturn int64(len(data))\n496\t\t}\n497\t\treturn pos + int64(idx) + 1\n498\t}\n499\t\n500\tfunc splitRoundRobin(data []byte, prefix string, n int) error {\n501\t\tlines := splitIntoLines(data)\n502\t\tbufs := make([]bytes.Buffer, n)\n503\t\tfor i, line := range lines {\n504\t\t\tbufs[i%n].Write(line)\n505\t\t}\n506\t\tfor i := range n {\n507\t\t\tif err := writePiece(prefix, i, bufs[i].Bytes()); err != nil {\n508\t\t\t\treturn err\n509\t\t\t}\n510\t\t}\n511\t\treturn nil\n512\t}\n513\t\n514\tfunc writePiece(prefix string, index int, data []byte) error {\n515\t\tw, err := openPiece(prefix, index)\n516\t\tif err != nil {\n517\t\t\treturn err\n518\t\t}\n519\t\tif len(data) > 0 {\n520\t\t\tif _, err := w.Write(data); err != nil {\n521\t\t\t\tw.Close()\n522\t\t\t\treturn err\n523\t\t\t}\n524\t\t}\n525\t\treturn w.Close()\n526\t}\n527\t\n528\tfunc splitIntoLines(data []byte) [][]byte {\n529\t\tvar lines [][]byte\n530\t\tfor len(data) > 0 {\n531\t\t\tidx := bytes.IndexByte(data, '\\n')\n532\t\t\tif idx < 0 {\n533\t\t\t\tlines = append(lines, data)\n534\t\t\t\tbreak\n535\t\t\t}\n536\t\t\tlines = append(lines, data[:idx+1])\n537\t\t\tdata = data[idx+1:]\n538\t\t}\n539\t\treturn lines\n540\t}\n541\t"}]},"parent_tool_use_id":null,"session_id":"431212cc-5f46-430d-83fa-488d00daeb00","uuid":"9a2e33c9-e98e-4893-a649-f50f0fcbc917","timestamp":"2026-05-21T19:33:08.568Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5445/cmd/split/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype splitMode int\n\nconst (\n\tmodeLines splitMode = iota\n\tmodeBytes\n\tmodeLineBytes\n\tmodeChunks\n)\n\ntype options struct {\n\tmode      splitMode\n\tmodeSet   bool\n\tlines     int\n\tbytesVal  int64\n\tlineBytes int64\n\tchunks    string\n\tprefix    string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, file, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"split: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tr, closer, err := openInput(file)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"split: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\tif closer != nil {\n\t\tdefer closer.Close()\n\t}\n\n\tif err := run(r, opts); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"split: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) (options, string, error) {\n\topts := options{lines: 1000, prefix: \"x\"}\n\tvar positional []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tpositional = append(positional, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, \"\", err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, \"\", err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\tpositional = append(positional, arg)\n\t\ti++\n\t}\n\n\treturn assignPositional(opts, positional)\n}\n\nfunc assignPositional(opts options, pos []string) (options, string, error) {\n\tfile := \"-\"\n\tif len(pos) >= 1 {\n\t\tfile = pos[0]\n\t}\n\tif len(pos) >= 2 {\n\t\topts.prefix = pos[1]\n\t}\n\tif len(pos) > 2 {\n\t\treturn opts, \"\", fmt.Errorf(\"extra operand '%s'\", pos[2])\n\t}\n\treturn opts, file, nil\n}\n\nfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--lines\" || strings.HasPrefix(flag, \"--lines=\"):\n\t\tval, n, err := longOptValue(flag, \"--lines\", remaining)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\treturn n, setLineMode(opts, val)\n\tcase flag == \"--bytes\" || strings.HasPrefix(flag, \"--bytes=\"):\n\t\tval, n, err := longOptValue(flag, \"--bytes\", remaining)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\treturn n, setBytesMode(opts, val)\n\tcase flag == \"--line-bytes\" || strings.HasPrefix(flag, \"--line-bytes=\"):\n\t\tval, n, err := longOptValue(flag, \"--line-bytes\", remaining)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\treturn n, setLineBytesMode(opts, val)\n\tcase flag == \"--number\" || strings.HasPrefix(flag, \"--number=\"):\n\t\tval, n, err := longOptValue(flag, \"--number\", remaining)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\treturn n, setChunksMode(opts, val)\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := 0; j < len(flags); j++ {\n\t\tsetter, ok := shortFlagSetter(flags[j])\n\t\tif !ok {\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t\tval, extra, err := extractFlagValue(flags[j+1:], remaining, consumed, flags[j])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\tif err := setter(opts, val); err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\treturn consumed + extra, nil\n\t}\n\treturn consumed, nil\n}\n\nfunc shortFlagSetter(ch byte) (func(*options, string) error, bool) {\n\tswitch ch {\n\tcase 'l':\n\t\treturn setLineMode, true\n\tcase 'b':\n\t\treturn setBytesMode, true\n\tcase 'C':\n\t\treturn setLineBytesMode, true\n\tcase 'n':\n\t\treturn setChunksMode, true\n\tdefault:\n\t\treturn nil, false\n\t}\n}\n\nfunc extractFlagValue(rest string, remaining []string, consumed int, flag byte) (string, int, error) {\n\tif rest != \"\" {\n\t\treturn rest, 0, nil\n\t}\n\tif len(remaining) > consumed {\n\t\treturn remaining[consumed], 1, nil\n\t}\n\treturn \"\", 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n}\n\nfunc parseLineCount(s string) (int, error) {\n\tn, err := strconv.Atoi(s)\n\tif err != nil || n <= 0 {\n\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc openInput(name string) (io.Reader, io.Closer, error) {\n\tif name == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc splitLines(r io.Reader, prefix string, linesPerPiece int) error {\n\tbr := bufio.NewReader(r)\n\tlineCount := 0\n\tpieceIndex := 0\n\tvar w *os.File\n\n\tfor {\n\t\tline, readErr := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tif lineCount%linesPerPiece == 0 {\n\t\t\t\tif w != nil {\n\t\t\t\t\tw.Close()\n\t\t\t\t}\n\t\t\t\tvar err error\n\t\t\t\tw, err = openPiece(prefix, pieceIndex)\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn err\n\t\t\t\t}\n\t\t\t\tpieceIndex++\n\t\t\t}\n\t\t\tif _, err := w.Write(line); err != nil {\n\t\t\t\tw.Close()\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tlineCount++\n\t\t}\n\t\tif readErr != nil {\n\t\t\tif w != nil {\n\t\t\t\tw.Close()\n\t\t\t}\n\t\t\tif readErr != io.EOF {\n\t\t\t\treturn readErr\n\t\t\t}\n\t\t\treturn nil\n\t\t}\n\t}\n}\n\nfunc openPiece(prefix string, index int) (*os.File, error) {\n\tsuffix, err := alphabeticSuffix(index, 2)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn os.Create(prefix + suffix)\n}\n\nfunc alphabeticSuffix(index, length int) (string, error) {\n\tmaxPieces := 1\n\tfor range length {\n\t\tmaxPieces *= 26\n\t}\n\tif index >= maxPieces {\n\t\treturn \"\", fmt.Errorf(\"output file suffixes exhausted\")\n\t}\n\tbuf := make([]byte, length)\n\tfor i := length - 1; i >= 0; i-- {\n\t\tbuf[i] = 'a' + byte(index%26)\n\t\tindex /= 26\n\t}\n\treturn string(buf), nil\n}\n\nfunc run(r io.Reader, opts options) error {\n\tswitch opts.mode {\n\tcase modeBytes:\n\t\treturn splitBytes(r, opts.prefix, opts.bytesVal)\n\tcase modeLineBytes:\n\t\treturn splitLineBytes(r, opts.prefix, opts.lineBytes)\n\tcase modeChunks:\n\t\treturn splitChunks(r, opts.prefix, opts.chunks)\n\tdefault:\n\t\treturn splitLines(r, opts.prefix, opts.lines)\n\t}\n}\n\nfunc setMode(opts *options, mode splitMode) error {\n\tif opts.modeSet && opts.mode != mode {\n\t\treturn fmt.Errorf(\"cannot split in more than one way\")\n\t}\n\topts.mode = mode\n\topts.modeSet = true\n\treturn nil\n}\n\nfunc setLineMode(opts *options, val string) error {\n\tn, err := parseLineCount(val)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := setMode(opts, modeLines); err != nil {\n\t\treturn err\n\t}\n\topts.lines = n\n\treturn nil\n}\n\nfunc setBytesMode(opts *options, val string) error {\n\tn, err := parseByteCount(val)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := setMode(opts, modeBytes); err != nil {\n\t\treturn err\n\t}\n\topts.bytesVal = n\n\treturn nil\n}\n\nfunc setLineBytesMode(opts *options, val string) error {\n\tn, err := parseByteCount(val)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := setMode(opts, modeLineBytes); err != nil {\n\t\treturn err\n\t}\n\topts.lineBytes = n\n\treturn nil\n}\n\nfunc setChunksMode(opts *options, val string) error {\n\tif err := setMode(opts, modeChunks); err != nil {\n\t\treturn err\n\t}\n\topts.chunks = val\n\treturn nil\n}\n\nfunc longOptValue(flag, name string, remaining []string) (string, int, error) {\n\tif strings.HasPrefix(flag, name+\"=\") {\n\t\treturn flag[len(name)+1:], 1, nil\n\t}\n\tif len(remaining) < 2 {\n\t\treturn \"\", 0, fmt.Errorf(\"option '%s' requires an argument\", name)\n\t}\n\treturn remaining[1], 2, nil\n}\n\nfunc parseByteCount(s string) (int64, error) {\n\tn, err := sizeparse.Parse(s)\n\tif err != nil || n <= 0 {\n\t\treturn 0, fmt.Errorf(\"invalid number of bytes: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc splitBytes(r io.Reader, prefix string, size int64) error {\n\tpieceIndex := 0\n\tfor {\n\t\tw, err := openPiece(prefix, pieceIndex)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\twritten, copyErr := io.CopyN(w, r, size)\n\t\tw.Close()\n\t\tif written == 0 {\n\t\t\tos.Remove(w.Name())\n\t\t}\n\t\tif copyErr != nil {\n\t\t\tif copyErr == io.EOF {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn copyErr\n\t\t}\n\t\tpieceIndex++\n\t}\n}\n\nfunc splitLineBytes(r io.Reader, prefix string, maxBytes int64) error {\n\tsz := int(maxBytes)\n\tbr := bufio.NewReaderSize(r, sz)\n\tpieceIndex := 0\n\n\tfor {\n\t\tdata, err := readLineBytesChunk(br, sz)\n\t\tif len(data) > 0 {\n\t\t\tif werr := writePiece(prefix, pieceIndex, data); werr != nil {\n\t\t\t\treturn werr\n\t\t\t}\n\t\t\tpieceIndex++\n\t\t}\n\t\tif err != nil {\n\t\t\tif err == io.EOF {\n\t\t\t\treturn nil\n\t\t\t}\n\t\t\treturn err\n\t\t}\n\t}\n}\n\nfunc readLineBytesChunk(br *bufio.Reader, sz int) ([]byte, error) {\n\tbuf, _ := br.Peek(sz)\n\tif len(buf) == 0 {\n\t\treturn nil, io.EOF\n\t}\n\twriteLen := len(buf)\n\tif len(buf) >= sz {\n\t\tif lastNL := bytes.LastIndexByte(buf, '\\n'); lastNL >= 0 {\n\t\t\twriteLen = lastNL + 1\n\t\t}\n\t}\n\tdata := make([]byte, writeLen)\n\t_, err := br.Read(data)\n\treturn data, err\n}\n\nfunc splitChunks(r io.Reader, prefix string, spec string) error {\n\tmode, n, err := parseChunkSpec(spec)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tswitch mode {\n\tcase \"\":\n\t\treturn splitByteChunks(data, prefix, n)\n\tcase \"l\":\n\t\treturn splitLineChunks(data, prefix, n)\n\tcase \"r\":\n\t\treturn splitRoundRobin(data, prefix, n)\n\tdefault:\n\t\treturn fmt.Errorf(\"invalid number of chunks: '%s'\", spec)\n\t}\n}\n\nfunc parseChunkSpec(spec string) (string, int, error) {\n\tnumStr := spec\n\tmode := \"\"\n\tif strings.HasPrefix(spec, \"l/\") {\n\t\tmode = \"l\"\n\t\tnumStr = spec[2:]\n\t} else if strings.HasPrefix(spec, \"r/\") {\n\t\tmode = \"r\"\n\t\tnumStr = spec[2:]\n\t}\n\tn, err := strconv.Atoi(numStr)\n\tif err != nil || n <= 0 {\n\t\treturn \"\", 0, fmt.Errorf(\"invalid number of chunks: '%s'\", spec)\n\t}\n