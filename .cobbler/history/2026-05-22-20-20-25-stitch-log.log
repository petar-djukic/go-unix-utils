ceeded {\n\t\tt.Fatal(\"sha224sum timed out; SIGPIPE handler may not be installed\")\n\t}\n\tif err != nil {\n\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n\t}\n}\n\nfunc sha224hex(data []byte) string {\n\tsum := sha256.Sum224(data)\n\treturn hex.EncodeToString(sum[:])\n}\n\nfunc writeFile(t *testing.T, path, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":145,"cache_read_input_tokens":28703,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":145},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"287270df-13f2-4c33-a85e-aa914a3be279","uuid":"09cc4ada-5442-4156-9a73-1e31d29dbdf6"}
