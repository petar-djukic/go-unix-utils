{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01S2zRsn5avXFfPjHzYh3hVD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GDmma3FW7eNpVD3ZhxhSCE","name":"Write","input":{"file_path":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5091/pkg/format/columns.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage format\n\nimport (\n\t\"strings\"\n\t\"unicode/utf8\"\n)\n\nconst columnGap = 2\n\n// PadRight pads s with trailing spaces to the given width.\n// R1.2: returns s unchanged if display width >= width.\nfunc PadRight(s string, width int) string {\n\tn := utf8.RuneCountInString(s)\n\tif n >= width {\n\t\treturn s\n\t}\n\treturn s + strings.Repeat(\" \", width-n)\n}\n\n// PadLeft pads s with leading spaces to the given width.\n// R1.2: returns s unchanged if display width >= width.\nfunc PadLeft(s string, width int) string {\n\tn := utf8.RuneCountInString(s)\n\tif n >= width {\n\t\treturn s\n\t}\n\treturn strings.Repeat(\" \", width-n) + s\n}\n\n// Columns arranges entries into a grid of rows and columns that fits within\n// termWidth characters. R1.1: uses the longest entry in each column to\n// determine column width. R1.3: uses rune count for display width.\nfunc Columns(entries []string, termWidth int) [][]string {\n\tif len(entries) == 0 {\n\t\treturn nil\n\t}\n\tnumCols := findMaxColumns(entries, termWidth)\n\treturn buildGrid(entries, numCols)\n}\n\n// findMaxColumns determines the maximum number of columns that fit within\n// termWidth, using per-column widths (longest entry in each column).\nfunc findMaxColumns(entries []string, termWidth int) int {\n\tn := len(entries)\n\tfor cols := n; cols > 1; cols-- {\n\t\tif gridFits(entries, cols, termWidth) {\n\t\t\treturn cols\n\t\t}\n\t}\n\treturn 1\n}\n\n// gridFits checks whether entries arranged in the given number of columns\n// fit within termWidth, accounting for per-column widths and gaps.\nfunc gridFits(entries []string, cols, termWidth int) bool {\n\trows := (len(entries) + cols - 1) / cols\n\ttotal := 0\n\tfor c := 0; c < cols; c++ {\n\t\tcolWidth := columnWidth(entries, c, rows)\n\t\tif c < cols-1 {\n\t\t\ttotal += colWidth + columnGap\n\t\t} else {\n\t\t\ttotal += colWidth\n\t\t}\n\t\tif total > termWidth {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\n// columnWidth returns the display width of the widest entry in column c,\n// where entries are laid out column-first with the given number of rows.\nfunc columnWidth(entries []string, col, rows int) int {\n\tmaxW := 0\n\tfor row := 0; row < rows; row++ {\n\t\tidx := col*rows + row\n\t\tif idx >= len(entries) {\n\t\t\tbreak\n\t\t}\n\t\tw := utf8.RuneCountInString(entries[idx])\n\t\tif w > maxW {\n\t\t\tmaxW = w\n\t\t}\n\t}\n\treturn maxW\n}\n\n// buildGrid arranges entries into a [][]string grid with the given number of\n// columns, filling column-first (down then across).\nfunc buildGrid(entries []string, cols int) [][]string {\n\trows := (len(entries) + cols - 1) / cols\n\tgrid := make([][]string, rows)\n\tfor r := 0; r < rows; r++ {\n\t\trow := make([]string, 0, cols)\n\t\tfor c := 0; c < cols; c++ {\n\t\t\tidx := c*rows + r\n\t\t\tif idx >= len(entries) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\trow = append(row, entries[idx])\n\t\t}\n\t\tgrid[r] = row\n\t}\n\treturn grid\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3153,"cache_read_input_tokens":162676,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3153},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"a7dd0407-b16e-4926-88d1-590dd91fb102","uuid":"98ffdfa2-c893-4b5d-9739-9b56864da29c"}
