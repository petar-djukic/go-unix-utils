have their own rules, while \"never\" just suppresses it entirely.\n\nThe key insight is that `shouldShowTotal` needs to check the original number of files requested, not the count of successfully processed results. I'll update it to use the input file count instead of the results length.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":404,"cache_read_input_tokens":40641,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":404},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e527becd-86c8-4146-8648-fb7cdc0490d0","uuid":"48af8019-e560-4a50-b989-b6e8a0a80b80"}
