{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CX7VRp8PfqkDAj2Ps3nB5y","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"strings\"\n12\t\t\"unicode\"\n13\t\t\"unicode/utf8\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype options struct {\n19\t\tprintLines bool\n20\t\tprintWords bool\n21\t\tprintBytes bool\n22\t\tprintChars bool\n23\t\tprintMax   bool\n24\t\ttotalMode  string\n25\t\tfiles0From string\n26\t}\n27\t\n28\ttype counts struct {\n29\t\tlines   int64\n30\t\twords   int64\n31\t\tbytes   int64\n32\t\tchars   int64\n33\t\tmaxLine int64\n34\t}\n35\t\n36\tfunc main() {\n37\t\tsys.InstallSIGPIPEHandler()\n38\t\topts, files := parseArgs(os.Args[1:])\n39\t\texitCode := run(opts, files, os.Stdout, os.Stderr)\n40\t\tos.Exit(exitCode)\n41\t}\n42\t\n43\tfunc run(opts options, files []string, stdout io.Writer, stderr io.Writer) int {\n44\t\tif noFlagsSet(opts) {\n45\t\t\topts.printLines = true\n46\t\t\topts.printWords = true\n47\t\t\topts.printBytes = true\n48\t\t}\n49\t\tif opts.totalMode == \"\" {\n50\t\t\topts.totalMode = \"auto\"\n51\t\t}\n52\t\n53\t\tif opts.files0From != \"\" {\n54\t\t\textra, err := readFiles0From(opts.files0From)\n55\t\t\tif err != nil {\n56\t\t\t\tfmt.Fprintf(stderr, \"wc: %s\\n\", err)\n57\t\t\t\treturn 1\n58\t\t\t}\n59\t\t\tfiles = append(files, extra...)\n60\t\t}\n61\t\n62\t\tif len(files) == 0 {\n63\t\t\tfiles = []string{\"\"}\n64\t\t}\n65\t\n66\t\twidth := 1\n67\t\tif opts.totalMode != \"only\" && opts.files0From != \"-\" {\n68\t\t\twidth = computeWidth(files, countColumns(opts))\n69\t\t}\n70\t\tresults, names, hadError := processFiles(files, stderr)\n71\t\tprintResults(stdout, opts, results, names, width)\n72\t\tif hadError {\n73\t\t\treturn 1\n74\t\t}\n75\t\treturn 0\n76\t}\n77\t\n78\tfunc noFlagsSet(opts options) bool {\n79\t\treturn !opts.printLines && !opts.printWords &&\n80\t\t\t!opts.printBytes && !opts.printChars && !opts.printMax\n81\t}\n82\t\n83\tfunc processFiles(files []string, stderr io.Writer) ([]counts, []string, bool) {\n84\t\tresults := make([]counts, 0, len(files))\n85\t\tnames := make([]string, 0, len(files))\n86\t\thadError := false\n87\t\n88\t\tfor _, f := range files {\n89\t\t\tc, err := countFile(f)\n90\t\t\tif err != nil {\n91\t\t\t\tfmt.Fprintf(stderr, \"wc: %s\\n\", err)\n92\t\t\t\thadError = true\n93\t\t\t\tcontinue\n94\t\t\t}\n95\t\t\tresults = append(results, c)\n96\t\t\tif f == \"\" {\n97\t\t\t\tnames = append(names, \"\")\n98\t\t\t} else {\n99\t\t\t\tnames = append(names, f)\n100\t\t\t}\n101\t\t}\n102\t\treturn results, names, hadError\n103\t}\n104\t\n105\tfunc countFile(name string) (counts, error) {\n106\t\tvar r io.Reader\n107\t\tif name == \"-\" || name == \"\" {\n108\t\t\tr = os.Stdin\n109\t\t} else {\n110\t\t\tf, err := os.Open(name)\n111\t\t\tif err != nil {\n112\t\t\t\treturn counts{}, fmt.Errorf(\"%s: %s\", name, err.(*os.PathError).Err)\n113\t\t\t}\n114\t\t\tdefer f.Close()\n115\t\t\tr = f\n116\t\t}\n117\t\treturn countReader(r)\n118\t}\n119\t\n120\tfunc countReader(r io.Reader) (counts, error) {\n121\t\tvar c counts\n122\t\tbr := bufio.NewReader(r)\n123\t\tinWord := false\n124\t\tlineLen := int64(0)\n125\t\n126\t\tbuf := make([]byte, 32*1024)\n127\t\tfor {\n128\t\t\tn, err := br.Read(buf)\n129\t\t\tc.bytes += int64(n)\n130\t\t\tprocessChunk(buf[:n], &c, &inWord, &lineLen)\n131\t\t\tif err == io.EOF {\n132\t\t\t\tbreak\n133\t\t\t}\n134\t\t\tif err != nil {\n135\t\t\t\treturn c, err\n136\t\t\t}\n137\t\t}\n138\t\n139\t\tif lineLen > c.maxLine {\n140\t\t\tc.maxLine = lineLen\n141\t\t}\n142\t\treturn c, nil\n143\t}\n144\t\n145\tfunc processChunk(data []byte, c *counts, inWord *bool, lineLen *int64) {\n146\t\ti := 0\n147\t\tfor i < len(data) {\n148\t\t\tr, size := utf8.DecodeRune(data[i:])\n149\t\t\tif r == utf8.RuneError && size == 1 {\n150\t\t\t\tc.chars++\n151\t\t\t\tprocessInvalidByte(data[i], c, inWord, lineLen)\n152\t\t\t\ti++\n153\t\t\t\tcontinue\n154\t\t\t}\n155\t\t\tc.chars++\n156\t\t\tif r == '\\n' {\n157\t\t\t\tc.lines++\n158\t\t\t\thandleNewline(c, inWord, lineLen)\n159\t\t\t} else if r == '\\t' {\n160\t\t\t\thandleTab(inWord, lineLen)\n161\t\t\t} else if r == '\\r' || r == '\\f' {\n162\t\t\t\t*inWord = false\n163\t\t\t\thandleReturn(c, lineLen)\n164\t\t\t} else if unicode.IsSpace(r) {\n165\t\t\t\t*inWord = false\n166\t\t\t\tif isPrintable(r) {\n167\t\t\t\t\t*lineLen++\n168\t\t\t\t}\n169\t\t\t} else {\n170\t\t\t\tif !*inWord {\n171\t\t\t\t\tc.words++\n172\t\t\t\t\t*inWord = true\n173\t\t\t\t}\n174\t\t\t\tif isPrintable(r) {\n175\t\t\t\t\t*lineLen++\n176\t\t\t\t}\n177\t\t\t}\n178\t\t\ti += size\n179\t\t}\n180\t}\n181\t\n182\tfunc processInvalidByte(b byte, c *counts, inWord *bool, lineLen *int64) {\n183\t\tswitch b {\n184\t\tcase '\\n':\n185\t\t\tc.lines++\n186\t\t\thandleNewline(c, inWord, lineLen)\n187\t\tcase '\\t':\n188\t\t\thandleTab(inWord, lineLen)\n189\t\tcase '\\r', '\\f':\n190\t\t\t*inWord = false\n191\t\t\thandleReturn(c, lineLen)\n192\t\tcase ' ', '\\v':\n193\t\t\t*inWord = false\n194\t\tdefault:\n195\t\t\tif !*inWord {\n196\t\t\t\tc.words++\n197\t\t\t\t*inWord = true\n198\t\t\t}\n199\t\t}\n200\t}\n201\t\n202\tfunc handleNewline(c *counts, inWord *bool, lineLen *int64) {\n203\t\t*inWord = false\n204\t\tif *lineLen > c.maxLine {\n205\t\t\tc.maxLine = *lineLen\n206\t\t}\n207\t\t*lineLen = 0\n208\t}\n209\t\n210\tfunc handleReturn(c *counts, lineLen *int64) {\n211\t\tif *lineLen > c.maxLine {\n212\t\t\tc.maxLine = *lineLen\n213\t\t}\n214\t\t*lineLen = 0\n215\t}\n216\t\n217\tfunc handleTab(inWord *bool, lineLen *int64) {\n218\t\t*inWord = false\n219\t\t*lineLen = (*lineLen/8 + 1) * 8\n220\t}\n221\t\n222\tfunc isPrintable(r rune) bool {\n223\t\treturn r >= 0x20 && r <= 0x7E\n224\t}\n225\t\n226\tfunc printResults(w io.Writer, opts options, results []counts, names []string, width int) {\n227\t\ttotal := sumCounts(results)\n228\t\tshowTotal := shouldShowTotal(opts.totalMode, len(results))\n229\t\n230\t\tif opts.totalMode != \"only\" {\n231\t\t\tfor i, c := range results {\n232\t\t\t\tprintLine(w, opts, c, names[i], width)\n233\t\t\t}\n234\t\t}\n235\t\tif showTotal {\n236\t\t\tlabel := \"total\"\n237\t\t\tif opts.totalMode == \"only\" {\n238\t\t\t\tlabel = \"\"\n239\t\t\t}\n240\t\t\tprintLine(w, opts, total, label, width)\n241\t\t}\n242\t}\n243\t\n244\tfunc sumCounts(results []counts) counts {\n245\t\tvar total counts\n246\t\tfor _, c := range results {\n247\t\t\ttotal.lines += c.lines\n248\t\t\ttotal.words += c.words\n249\t\t\ttotal.bytes += c.bytes\n250\t\t\ttotal.chars += c.chars\n251\t\t\tif c.maxLine > total.maxLine {\n252\t\t\t\ttotal.maxLine = c.maxLine\n253\t\t\t}\n254\t\t}\n255\t\treturn total\n256\t}\n257\t\n258\tfunc shouldShowTotal(mode string, n int) bool {\n259\t\tswitch mode {\n260\t\tcase \"always\":\n261\t\t\treturn true\n262\t\tcase \"only\":\n263\t\t\treturn true\n264\t\tcase \"never\":\n265\t\t\treturn false\n266\t\tdefault:\n267\t\t\treturn n > 1\n268\t\t}\n269\t}\n270\t\n271\tfunc countColumns(opts options) int {\n272\t\tn := 0\n273\t\tif opts.printLines {\n274\t\t\tn++\n275\t\t}\n276\t\tif opts.printWords {\n277\t\t\tn++\n278\t\t}\n279\t\tif opts.printChars {\n280\t\t\tn++\n281\t\t}\n282\t\tif opts.printBytes {\n283\t\t\tn++\n284\t\t}\n285\t\tif opts.printMax {\n286\t\t\tn++\n287\t\t}\n288\t\treturn n\n289\t}\n290\t\n291\tfunc computeWidth(files []string, numColumns int) int {\n292\t\ttotalSize := int64(0)\n293\t\thasRegular := false\n294\t\tfor _, f := range files {\n295\t\t\tif f == \"-\" || f == \"\" {\n296\t\t\t\tcontinue\n297\t\t\t}\n298\t\t\tinfo, err := os.Stat(f)\n299\t\t\tif err != nil || !info.Mode().IsRegular() {\n300\t\t\t\tcontinue\n301\t\t\t}\n302\t\t\ttotalSize += info.Size()\n303\t\t\thasRegular = true\n304\t\t}\n305\t\tminWidth := 1\n306\t\tif numColumns > 1 && !hasRegular {\n307\t\t\tminWidth = 7\n308\t\t}\n309\t\tif hasRegular {\n310\t\t\treturn max(len(fmt.Sprintf(\"%d\", totalSize)), minWidth)\n311\t\t}\n312\t\treturn minWidth\n313\t}\n314\t\n315\tfunc printLine(w io.Writer, opts options, c counts, name string, width int) {\n316\t\tfields := collectFields(opts, c, width)\n317\t\tline := strings.Join(fields, \" \")\n318\t\tif name != \"\" {\n319\t\t\tline += \" \" + name\n320\t\t}\n321\t\tfmt.Fprintln(w, line)\n322\t}\n323\t\n324\tfunc collectFields(opts options, c counts, width int) []string {\n325\t\tfields := make([]string, 0, 5)\n326\t\tif opts.printLines {\n327\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.lines))\n328\t\t}\n329\t\tif opts.printWords {\n330\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.words))\n331\t\t}\n332\t\tif opts.printChars {\n333\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.chars))\n334\t\t}\n335\t\tif opts.printBytes {\n336\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.bytes))\n337\t\t}\n338\t\tif opts.printMax {\n339\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.maxLine))\n340\t\t}\n341\t\treturn fields\n342\t}\n343\t\n344\tfunc readFiles0From(path string) ([]string, error) {\n345\t\tvar r io.Reader\n346\t\tif path == \"-\" {\n347\t\t\tr = os.Stdin\n348\t\t} else {\n349\t\t\tf, err := os.Open(path)\n350\t\t\tif err != nil {\n351\t\t\t\treturn nil, err\n352\t\t\t}\n353\t\t\tdefer f.Close()\n354\t\t\tr = f\n355\t\t}\n356\t\tdata, err := io.ReadAll(r)\n357\t\tif err != nil {\n358\t\t\treturn nil, err\n359\t\t}\n360\t\tif len(data) == 0 {\n361\t\t\treturn nil, nil\n362\t\t}\n363\t\tparts := strings.Split(string(data), \"\\x00\")\n364\t\tif parts[len(parts)-1] == \"\" {\n365\t\t\tparts = parts[:len(parts)-1]\n366\t\t}\n367\t\treturn parts, nil\n368\t}\n369\t\n370\tfunc parseArgs(args []string) (options, []string) {\n371\t\tvar opts options\n372\t\tvar files []string\n373\t\ti := 0\n374\t\tfor i < len(args) {\n375\t\t\targ := args[i]\n376\t\t\tif arg == \"--