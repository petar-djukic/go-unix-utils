\tfor scanner.Scan() {\n216\t\t\tlines = append(lines, scanner.Text())\n217\t\t}\n218\t\tif err := scanner.Err(); err != nil {\n219\t\t\treturn err\n220\t\t}\n221\t\tw := bufio.NewWriter(os.Stdout)\n222\t\tvar werr error\n223\t\tif flagPrefix != \"\" {\n224\t\t\twerr = formatWithPrefix(w, lines)\n225\t\t} else {\n226\t\t\twerr = writeFormatted(w, lines)\n227\t\t}\n228\t\tif werr != nil {\n229\t\t\treturn werr\n230\t\t}\n231\t\treturn w.Flush()\n232\t}\n233\t\n234\tfunc writeFormatted(w *bufio.Writer, lines []string) error {\n235\t\tblocks := groupParagraphs(lines)\n236\t\tfor _, block := range blocks {\n237\t\t\tif len(block) == 0 {\n238\t\t\t\tif _, err := w.WriteString(\"\\n\"); err != nil {\n239\t\t\t\t\treturn err\n240\t\t\t\t}\n241\t\t\t\tcontinue\n242\t\t\t}\n243\t\t\tif err := formatParagraph(w, block); err != nil {\n244\t\t\t\treturn err\n245\t\t\t}\n246\t\t}\n247\t\treturn nil\n248\t}\n249\t\n250\tfunc groupParagraphs(lines []string) [][]string {\n251\t\tvar result [][]string\n252\t\tvar current []string\n253\t\tfor _, line := range lines {\n254\t\t\tif strings.TrimSpace(line) == \"\" {\n255\t\t\t\tif len(current) > 0 {\n256\t\t\t\t\tresult = append(result, current)\n257\t\t\t\t\tcurrent = nil\n258\t\t\t\t}\n259\t\t\t\tresult = append(result, nil)\n260\t\t\t\tcontinue\n261\t\t\t}\n262\t\t\tcurrent = append(current, line)\n263\t\t}\n264\t\tif len(current) > 0 {\n265\t\t\tresult = append(result, current)\n266\t\t}\n267\t\treturn result\n268\t}\n269\t\n270\tfunc formatParagraph(w *bufio.Writer, lines []string) error {\n271\t\tif flagSplit {\n272\t\t\treturn writeSplitOnly(w, lines)\n273\t\t}\n274\t\tif len(lines) == 1 && len(lines[0]) <= flagWidth {\n275\t\t\tif flagUniform {\n276\t\t\t\tlines[0] = normalizeUniform(lines[0])\n277\t\t\t}\n278\t\t\treturn writeLines(w, lines)\n279\t\t}\n280\t\tfirstIndent, bodyIndent := getIndents(lines)\n281\t\twords := extractWords(lines)\n282\t\tif len(words) == 0 {\n283\t\t\treturn nil\n284\t\t}\n285\t\tfilled := fillLines(words, firstIndent, bodyIndent, flagGoal, flagWidth)\n286\t\treturn writeLines(w, filled)\n287\t}\n288\t\n289\tfunc getIndents(lines []string) (string, string) {\n290\t\tfirst := extractIndent(lines[0])\n291\t\tif len(lines) > 1 {\n292\t\t\treturn first, extractIndent(lines[1])\n293\t\t}\n294\t\treturn first, first\n295\t}\n296\t\n297\tfunc extractIndent(s string) string {\n298\t\ttrimmed := strings.TrimLeft(s, \" \\t\")\n299\t\treturn s[:len(s)-len(trimmed)]\n300\t}\n301\t\n302\tfunc extractWords(lines []string) []string {\n303\t\tvar words []string\n304\t\tfor _, line := range lines {\n305\t\t\twords = append(words, strings.Fields(line)...)\n306\t\t}\n307\t\treturn words\n308\t}\n309\t\n310\tfunc fillLines(words []string, firstIndent, bodyIndent string, goal, max int) []string {\n311\t\tif len(words) == 0 {\n312\t\t\treturn nil\n313\t\t}\n314\t\tif goal > max {\n315\t\t\tgoal = max\n316\t\t}\n317\t\tvar result []string\n318\t\tline := firstIndent + words[0]\n319\t\tfor i := 1; i < len(words); i++ {\n320\t\t\tsep := wordSep(words[i-1])\n321\t\t\ttrial := line + sep + words[i]\n322\t\t\tif len(trial) > max || pastGoal(len(line), len(trial), goal) {\n323\t\t\t\tresult = append(result, line)\n324\t\t\t\tline = bodyIndent + words[i]\n325\t\t\t} else {\n326\t\t\t\tline = trial\n327\t\t\t}\n328\t\t}\n329\t\treturn append(result, line)\n330\t}\n331\t\n332\tfunc pastGoal(lineLen, trialLen, goal int) bool {\n333\t\tif trialLen <= goal {\n334\t\t\treturn false\n335\t\t}\n336\t\tover := trialLen - goal\n337\t\tunder := goal - lineLen\n338\t\tif under <= 0 {\n339\t\t\treturn true\n340\t\t}\n341\t\treturn over > under\n342\t}\n343\t\n344\tfunc wordSep(prev string) string {\n345\t\tif endsWithSentence(prev) {\n346\t\t\treturn \"  \"\n347\t\t}\n348\t\treturn \" \"\n349\t}\n350\t\n351\tfunc endsWithSentence(word string) bool {\n352\t\tif len(word) == 0 {\n353\t\t\treturn false\n354\t\t}\n355\t\tlast := word[len(word)-1]\n356\t\treturn last == '.' || last == '!' || last == '?'\n357\t}\n358\t\n359\tfunc normalizeUniform(line string) string {\n360\t\tindent := extractIndent(line)\n361\t\trest := line[len(indent):]\n362\t\tif len(strings.TrimSpace(rest)) == 0 {\n363\t\t\treturn line\n364\t\t}\n365\t\tvar b strings.Builder\n366\t\tb.WriteString(indent)\n367\t\ti := 0\n368\t\tfor i < len(rest) && (rest[i] == ' ' || rest[i] == '\\t') {\n369\t\t\ti++\n370\t\t}\n371\t\tfor i < len(rest) {\n372\t\t\tws := i\n373\t\t\tfor i < len(rest) && rest[i] != ' ' && rest[i] != '\\t' {\n374\t\t\t\ti++\n375\t\t\t}\n376\t\t\tword := rest[ws:i]\n377\t\t\tb.WriteString(word)\n378\t\t\tif i >= len(rest) {\n379\t\t\t\tbreak\n380\t\t\t}\n381\t\t\tspaceCount := 0\n382\t\t\tfor i < len(rest) && (rest[i] == ' ' || rest[i] == '\\t') {\n383\t\t\t\tspaceCount++\n384\t\t\t\ti++\n385\t\t\t}\n386\t\t\tif i < len(rest) {\n387\t\t\t\tif spaceCount > 1 && endsWithSentence(word) {\n388\t\t\t\t\tb.WriteString(\"  \")\n389\t\t\t\t} else {\n390\t\t\t\t\tb.WriteString(\" \")\n391\t\t\t\t}\n392\t\t\t}\n393\t\t}\n394\t\treturn b.String()\n395\t}\n396\t\n397\tfunc writeLines(w *bufio.Writer, lines []string) error {\n398\t\tfor _, line := range lines {\n399\t\t\tif _, err := w.WriteString(line); err != nil {\n400\t\t\t\treturn err\n401\t\t\t}\n402\t\t\tif err := w.WriteByte('\\n'); err != nil {\n403\t\t\t\treturn err\n404\t\t\t}\n405\t\t}\n406\t\treturn nil\n407\t}\n408\t\n409\tfunc writeSplitOnly(w *bufio.Writer, lines []string) error {\n410\t\tfor _, line := range lines {\n411\t\t\tif flagUniform {\n412\t\t\t\tline = normalizeUniform(line)\n413\t\t\t}\n414\t\t\tif len(line) <= flagWidth {\n415\t\t\t\tif _, err := w.WriteString(line); err != nil {\n416\t\t\t\t\treturn err\n417\t\t\t\t}\n418\t\t\t\tif err := w.WriteByte('\\n'); err != nil {\n419\t\t\t\t\treturn err\n420\t\t\t\t}\n421\t\t\t\tcontinue\n422\t\t\t}\n423\t\t\tindent := extractIndent(line)\n424\t\t\twords := strings.Fields(line)\n425\t\t\tfilled := fillLines(words, indent, indent, flagGoal, flagWidth)\n426\t\t\tif err := writeLines(w, filled); err != nil {\n427\t\t\t\treturn err\n428\t\t\t}\n429\t\t}\n430\t\treturn nil\n431\t}\n432\t\n433\tfunc formatWithPrefix(w *bufio.Writer, allLines []string) error {\n434\t\tvar group []string\n435\t\tvar groupWS string\n436\t\tfor _, line := range allLines {\n437\t\t\tws, stripped, has := stripPrefix(line)\n438\t\t\tif has {\n439\t\t\t\tif len(group) == 0 {\n440\t\t\t\t\tgroupWS = ws\n441\t\t\t\t}\n442\t\t\t\tgroup = append(group, stripped)\n443\t\t\t\tcontinue\n444\t\t\t}\n445\t\t\tif err := flushPrefixGroup(w, group, groupWS); err != nil {\n446\t\t\t\treturn err\n447\t\t\t}\n448\t\t\tgroup = nil\n449\t\t\tgroupWS = \"\"\n450\t\t\tif _, err := w.WriteString(line); err != nil {\n451\t\t\t\treturn err\n452\t\t\t}\n453\t\t\tif err := w.WriteByte('\\n'); err != nil {\n454\t\t\t\treturn err\n455\t\t\t}\n456\t\t}\n457\t\treturn flushPrefixGroup(w, group, groupWS)\n458\t}\n459\t\n460\tfunc flushPrefixGroup(w *bufio.Writer, lines []string, leadingWS string) error {\n461\t\tif len(lines) == 0 {\n462\t\t\treturn nil\n463\t\t}\n464\t\tblocks := groupParagraphs(lines)\n465\t\tfor _, block := range blocks {\n466\t\t\tif err := writePrefixBlock(w, block, leadingWS); err != nil {\n467\t\t\t\treturn err\n468\t\t\t}\n469\t\t}\n470\t\treturn nil\n471\t}\n472\t\n473\tfunc writePrefixBlock(w *bufio.Writer, block []string, leadingWS string) error {\n474\t\tfullPrefix := leadingWS + flagPrefix\n475\t\tif len(block) == 0 {\n476\t\t\t_, err := w.WriteString(fullPrefix + \"\\n\")\n477\t\t\treturn err\n478\t\t}\n479\t\tfirstIndent, bodyIndent := getIndents(block)\n480\t\twords := extractWords(block)\n481\t\tif len(words) == 0 {\n482\t\t\treturn nil\n483\t\t}\n484\t\tpLen := len(fullPrefix)\n485\t\tfilled := fillLines(words, firstIndent, bodyIndent,\n486\t\t\tmax(1, flagGoal-pLen), max(1, flagWidth-pLen))\n487\t\tfor _, fl := range filled {\n488\t\t\tif _, err := w.WriteString(fullPrefix + fl + \"\\n\"); err != nil {\n489\t\t\t\treturn err\n490\t\t\t}\n491\t\t}\n492\t\treturn nil\n493\t}\n494\t\n495\tfunc stripPrefix(line string) (string, string, bool) {\n496\t\ttrimmed := strings.TrimLeft(line, \" \\t\")\n497\t\tif strings.HasPrefix(trimmed, flagPrefix) {\n498\t\t\tws := line[:len(line)-len(trimmed)]\n499\t\t\treturn ws, trimmed[len(flagPrefix):], true\n500\t\t}\n501\t\treturn \"\", line, false\n502\t}\n503\t\n504\tfunc formatErr(err error) string {\n505\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n506\t\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n507\t\t}\n508\t\treturn err.Error()\n509\t}\n510\t"}]},"parent_tool_use_id":null,"session_id":"bcc96e82-fad5-44af-be06-67ed4832116e","uuid":"739c55bc-3ff2-45f9-8dfe-9967ae761dad","timestamp":"2026-05-29T17:50:03.644Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5659/cmd/fmt/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/fmt implements srd070-fmt: simple text formatter that reformats\n// paragraphs to fit within a specified line width.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar (\n\tflagWidth   int\n\tflagGoal    int\n\tflagSplit   bool\n\tflagTagged  bool\n\tflagPrefix  string\n\tflagUniform bool\n)\n\nfunc init() {\n\tflagWidth = 75\n\tflagGoal = 0\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\targs := parseFlags(os.Args[1:])\n\tif len(args) == 0 {\n\t\targs = []string{\"-\"}\n\t}\n\n\tif flagGoal == 0 {\n\t\tflagGoal = flagWidth * 93 / 100\n\t}\n\n\texitCode := 0\n\tfor _, name := range args {\n\t\tif err := fmtFile(name); err != nil {\n\t\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\t\tos.Exit(0)\n\t\t\t}\n\t\t\tfmt.Fprintf(os.Stderr, \"fmt: %s\\n\", formatErr(err))\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc parseFlags(args []string) []string {\n\tvar files []string\n\tendOfFlags := false\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif endOfFlags || arg == \"\" || arg == \"-\" || arg[0] != '-' {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 2 && arg[:2] == \"--\" {\n\t\t\ti = parseLongFlag(args, i)\n\t\t\tcontinue\n\t\t}\n\t\ti = parseShortFlags(args, i)\n\t}\n\treturn files\n}\n\nfunc parseLongFlag(args []string, i int) int {\n\targ := args[i]\n\tswitch {\n\tcase matchLong(arg, \"--width\"):\n\t\tflagWidth = parseLongIntArg(arg, \"--width\")\n\tcase matchLong(arg, \"--goal\"):\n\t\tflagGoal = parseLongIntArg(arg, \"--goal\")\n\tcase arg == \"--split-only\":\n\t\tflagSplit = true\n\tcase arg == \"--tagged-paragraph\":\n\t\tflagTagged = true\n\tcase matchLong(arg, \"--prefix\"):\n\t\tflagPrefix = parseLongStrArg(arg, \"--prefix\")\n\tcase arg == \"--uniform-spacing\":\n\t\tflagUniform = true\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"fmt: unrecognized option '%s'\\n\", arg)\n\t\tos.Exit(1)\n\t}\n\treturn i\n}\n\nfunc matchLong(arg, name string) bool {\n\treturn arg == name || (len(arg) > len(name) && arg[:len(name)+1] == name+\"=\")\n}\n\nfunc parseLongIntArg(arg, name string) int {\n\teq := len(name) + 1\n\tif len(arg) <= len(name) || arg[len(name)] != '=' {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: option '%s' requires an argument\\n\", name)\n\t\tos.Exit(1)\n\t}\n\tv, err := strconv.Atoi(arg[eq:])\n\tif err != nil || v < 0 {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", arg[eq:])\n\t\tos.Exit(1)\n\t}\n\treturn v\n}\n\nfunc parseLongStrArg(arg, name string) string {\n\teq := len(name) + 1\n\tif len(arg) <= len(name) || arg[len(name)] != '=' {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: option '%s' requires an argument\\n\", name)\n\t\tos.Exit(1)\n\t}\n\treturn arg[eq:]\n}\n\nfunc parseShortFlags(args []string, i int) int {\n\targ := args[i]\n\tfor j := 1; j < len(arg); j++ {\n\t\tc := arg[j]\n\t\tswitch c {\n\t\tcase 'w':\n\t\t\tflagWidth = consumeIntArg(args, arg, &i, j)\n\t\t\treturn i\n\t\tcase 'g':\n\t\t\tflagGoal = consumeIntArg(args, arg, &i, j)\n\t\t\treturn i\n\t\tcase 'p':\n\t\t\tflagPrefix = consumeStrArg(args, arg, &i, j)\n\t\t\treturn i\n\t\tcase 's':\n\t\t\tflagSplit = true\n\t\tcase 't':\n\t\t\tflagTagged = true\n\t\tcase 'u':\n\t\t\tflagUniform = true\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid option -- '%c'\\n\", c)\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\treturn i\n}\n\nfunc consumeIntArg(args []string, arg string, i *int, j int) int {\n\trest := arg[j+1:]\n\tif rest != \"\" {\n\t\tv, err := strconv.Atoi(rest)\n\t\tif err != nil || v < 0 {\n\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", rest)\n\t\t\tos.Exit(1)\n\t\t}\n\t\treturn v\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n\t\tos.Exit(1)\n\t}\n\tv, err := strconv.Atoi(args[*i])\n\tif err != nil || v < 0 {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", args[*i])\n\t\tos.Exit(1)\n\t}\n\treturn v\n}\n\nfunc consumeStrArg(args []string, arg string, i *int, j int) string {\n\trest := arg[j+1:]\n\tif rest != \"\" {\n\t\treturn rest\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n\t\tos.Exit(1)\n\t}\n\treturn args[*i]\n}\n\nfunc fmtFile(name string) error {\n\tvar r io.Reader\n\tif name == \"-\" {\n\t\tr = os.Stdin\n\t} else {\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tdefer f.Close()\n\t\tr = f\n\t}\n\treturn formatInput(r)\n}\n\nfunc formatInput(r io.Reader) error {\n\tscanner := bufio.NewScanner(r)\n\tvar lines []string\n\tfor scanner.Scan() {\n\t\tlines = append(lines, scanner.Text())\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\treturn err\n\t}\n\tw := bufio.NewWriter(os.Stdout)\n\tvar werr error\n\tif flagPrefix != \"\" {\n\t\twerr = formatWithPrefix(w, lines)\n\t} else {\n\t\twerr = writeFormatted(w, lines)\n\t}\n\tif werr != nil {\n\t\treturn werr\n\t}\n\treturn w.Flush()\n}\n\nfunc writeFormatted(w *bufio.Writer, lines []string) error {\n\tblocks := groupParagraphs(lines)\n\tfor _, block := range blocks {\n\t\tif len(block) == 0 {\n\t\t\tif _, err := w.WriteString(\"\\n\"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif err := formatParagraph(w, block); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc groupParagraphs(lines []string) [][]string {\n\tvar result [][]string\n\tvar current []string\n\tfor _, line := range lines {\n\t\tif strings.TrimSpace(line) == \"\" {\n\t\t\tif len(current) > 0 {\n\t\t\t\tresult = append(result, current)\n\t\t\t\tcurrent = nil\n\t\t\t}\n\t\t\tresult = append(result, nil)\n\t\t\tcontinue\n\t\t}\n\t\tcurrent = append(current, line)\n\t}\n\tif len(current) > 0 {\n\t\tresult = append(result, current)\n\t}\n\treturn result\n}\n\nfunc formatParagraph(w *bufio.Writer, lines []string) error {\n\tif flagSplit {\n\t\treturn writeSplitOnly(w, lines)\n\t}\n\tif len(lines) == 1 && len(lines[0]) <= flagWidth {\n\t\tif flagUniform {\n\t\t\tlines[0] = normalizeUniform(lines[0])\n\t\t}\n\t\treturn writeLines(w, lines)\n\t}\n\tfirstIndent, bodyIndent := getIndents(lines)\n\twords := extractWords(lines)\n\tif len(words) == 0 {\n\t\treturn nil\n\t}\n\tfilled := fillLines(words, firstIndent, bodyIndent, flagGoal, flagWidth)\n\treturn writeLines(w, filled)\n}\n\nfunc getIndents(lines []string) (string, string) {\n\tfirst := extractIndent(lines[0])\n\tif len(lines) > 1 {\n\t\treturn first, extractIndent(lines[1])\n\t}\n\treturn first, first\n}\n\nfunc extractIndent(s string) string {\n\ttrimmed := strings.TrimLeft(s, \" \\t\")\n\treturn s[:len(s)-len(trimmed)]\n}\n\nfunc extractWords(lines []string) []string {\n\tvar words []string\n\tfor _, line := range lines {\n\t\twords = append(words, strings.Fields(line)...)\n\t}\n\treturn words\n}\n\nfunc fillLines(words []string, firstIndent, bodyIndent string, goal, max int) []string {\n\tif len(words) == 0 {\n\t\treturn nil\n\t}\n\tif goal > max {\n\t\tgoal = max\n\t}\n\tvar result []string\n\tline := firstIndent + words[0]\n\tfor i := 1; i < len(words); i++ {\n\t\tsep := wordSep(words[i-1])\n\t\ttrial := line + sep + words[i]\n\t\tif len(trial) > max || pastGoal(len(line), len(trial), goal) {\n\t\t\tresult = append(result, line)\n\t\t\tline = bodyIndent + words[i]\n\t\t} else {\n\t\t\tline = trial\n\t\t}\n\t}\n\treturn append(result, line)\n}\n\nfunc pastGoal(lineLen, trialLen, goal int) bool {\n\tif trialLen <= goal {\n\t\treturn false\n\t}\n\tover := trialLen - goal\n\tunder := goal - lineLen\n\tif under <= 0 {\n\t\treturn true\n\t}\n\treturn over > under\n}\n\nfunc wordSep(prev string) string {\n\tif endsWithSentence(prev) {\n\t\treturn \"  \"\n\t}\n\treturn \" \"\n}\n\nfunc endsWithSentence(word string) bool {\n\tif len(word) == 0 {\n\t\treturn false\n\t}\n\tlast := word[len(word)-1]\n\treturn last == '.' || last == '!' || last == '?'\n}\n\nfunc normalizeUniform(line string) string {\n\tindent := extractIndent(line)\n\trest := line[len(indent):]\n\tif len(strings.TrimSpace(rest)) == 0 {\n\t\treturn line\n\t}\n\tvar b strings.Builder\n\tb.WriteString(indent)\n\ti := 0\n\tfor i < len(rest) && (rest[i] == ' ' || rest[i] == '\\t') {\n\t\ti++\n\t}\n\tfor i < len(rest) {\n\t\tws := i\n\t\tfor i < len(rest) && rest[i] != ' ' && rest[i] != '\\t' {\n\t\t\ti++\n\t\t}\n\t\tword := rest[ws:i]\n\t\tb.WriteString(word)\n\t\tif i >= len(rest) {\n\t\t\tbreak\n\t\t}\n\t\tspaceCount := 0\n\t\tfor i < len(rest) && (rest[i] == ' ' || rest[i] == '\\t') {\n\t\t\tspaceCount++\n\t\t\ti++\n\t\t}\n\t\tif i < len(rest) {\n\t\t\tif spaceCount > 1 && endsWithSentence(word) {\n\t\t\t\tb.WriteString(\"  \")\n\t\t\t} else {\n\t\t\t\tb.WriteString(\" \")\n\t\t\t}\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc writeLines(w *bufio.Writer, lines []string) error {\n\tfor _, line := range lines {\n\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc writeSplitOnly(w *bufio.Writer, lines []string) error {\n\tfor _, line := range lines {\n\t\tif flagUniform {\n\t\t\tline = normalizeUniform(line)\n\t\t}\n\t\tif len(line) <= flagWidth {\n\t\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tindent := extractIndent(line)\n\t\twords := strings.Fields(line)\n\t\tfilled := fillLines(words, indent, indent, flagGoal, flagWidth)\n\t\tif err := writeLines(w, filled); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc formatWithPrefix(w *bufio.Writer, allLines []string) error {\n\tvar group []string\n\tvar groupWS string\n\tfor _, line := range allLines {\n\t\tws, stripped, has := stripPrefix(line)\n\t\tif has {\n\t\t\tif len(group) == 0 {\n\t\t\t\tgroupWS = ws\n\t\t\t}\n\t\t\tgroup = append(group, stripped)\n\t\t\tcontinue\n\t\t}\n\t\tif err := flushPrefixGroup(w, group, groupWS); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tgroup = nil\n\t\tgroupWS = \"\"\n\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn flushPrefixGroup(w, group, groupWS)\n}\n\nfunc flushPrefixGroup(w *bufio.Writer, lines []string, leadingWS string) error {\n\tif len(lines) == 0 {\n\t\treturn nil\n\t}\n\tblocks := groupParagraphs(lines)\n\tfor _, block := range blocks {\n\t\tif err := writePrefixBlock(w, block, leadingWS); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc writePrefixBlock(w *bufio.Writer, block []string, leadingWS string) error {\n\tfullPrefix := leadingWS + flagPrefix\n\tif len(block) == 0 {\n\t\t_, err := w.WriteString(fullPrefix + \"\\n\")\n\t\treturn err\n\t}\n\tfirstIndent, bodyIndent := getIndents(block)\n\twords := extractWords(block)\n\tif len(words) == 0 {\n\t\treturn nil\n\t}\n\tpLen := len(fullPrefix)\n\tfilled := fillLines(words, firstIndent, bodyIndent,\n\t\tmax(1, flagGoal-pLen), max(1, flagWidth-pLen))\n\tfor _, fl := range filled {\n\t\tif _, err := w.WriteString(fullPrefix + fl + \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc stripPrefix(line string) (string, string, bool) {\n\ttrimmed := strings.TrimLeft(line, \" \\t\")\n\tif strings.HasPrefix(trimmed, flagPrefix) {\n\t\tws := line[:len(line)-len(trimmed)]\n\t\treturn ws, trimmed[len(flagPrefix):], true\n\t}\n\treturn \"\", line, false\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n","numLines":510,"startLine":1,"totalLines":510}}}
