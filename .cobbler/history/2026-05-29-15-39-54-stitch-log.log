{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TSQhRtaKGWMzv73K8ehd3p","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd023-fold R1.1-R1.4, R2.1-R2.3, R3.1-R3.4, R4.1-R4.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"syscall\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tfunc main() {\n20\t\tsys.InstallSIGPIPEHandler()\n21\t\tos.Exit(run(os.Args[1:]))\n22\t}\n23\t\n24\ttype options struct {\n25\t\twidth     int\n26\t\tbyteMode  bool\n27\t\tspaceMode bool\n28\t}\n29\t\n30\tfunc defaultOptions() options {\n31\t\treturn options{\n32\t\t\twidth: 80,\n33\t\t}\n34\t}\n35\t\n36\tfunc run(args []string) int {\n37\t\topts, files, err := parseArgs(args)\n38\t\tif err != nil {\n39\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n40\t\t\treturn 1\n41\t\t}\n42\t\tif len(files) == 0 {\n43\t\t\tfiles = []string{\"-\"}\n44\t\t}\n45\t\tw := bufio.NewWriter(os.Stdout)\n46\t\texitCode := 0\n47\t\tfor _, f := range files {\n48\t\t\tif err := processFile(f, opts, w); err != nil {\n49\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n50\t\t\t\t\tos.Exit(0)\n51\t\t\t\t}\n52\t\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n53\t\t\t\texitCode = 1\n54\t\t\t}\n55\t\t}\n56\t\tif err := w.Flush(); err != nil {\n57\t\t\tif errors.Is(err, syscall.EPIPE) {\n58\t\t\t\tos.Exit(0)\n59\t\t\t}\n60\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n61\t\t\texitCode = 1\n62\t\t}\n63\t\treturn exitCode\n64\t}\n65\t\n66\tfunc parseArgs(args []string) (options, []string, error) {\n67\t\topts := defaultOptions()\n68\t\tvar files []string\n69\t\ti := 0\n70\t\tfor i < len(args) {\n71\t\t\targ := args[i]\n72\t\t\tif arg == \"--\" {\n73\t\t\t\tfiles = append(files, args[i+1:]...)\n74\t\t\t\tbreak\n75\t\t\t}\n76\t\t\tif arg == \"-\" {\n77\t\t\t\tfiles = append(files, arg)\n78\t\t\t\ti++\n79\t\t\t\tcontinue\n80\t\t\t}\n81\t\t\tif len(arg) > 1 && arg[0] == '-' {\n82\t\t\t\tconsumed, err := parseFlag(arg, args[i+1:], &opts)\n83\t\t\t\tif err != nil {\n84\t\t\t\t\treturn opts, nil, err\n85\t\t\t\t}\n86\t\t\t\ti += 1 + consumed\n87\t\t\t\tcontinue\n88\t\t\t}\n89\t\t\tfiles = append(files, arg)\n90\t\t\ti++\n91\t\t}\n92\t\treturn opts, files, nil\n93\t}\n94\t\n95\tfunc parseFlag(arg string, remaining []string, opts *options) (int, error) {\n96\t\tflag := arg[1:]\n97\t\ti := 0\n98\t\tfor i < len(flag) {\n99\t\t\tswitch flag[i] {\n100\t\t\tcase 'b':\n101\t\t\t\topts.byteMode = true\n102\t\t\t\ti++\n103\t\t\tcase 's':\n104\t\t\t\topts.spaceMode = true\n105\t\t\t\ti++\n106\t\t\tcase 'w':\n107\t\t\t\treturn setWidth(flag[i+1:], remaining, opts)\n108\t\t\tdefault:\n109\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flag[i])\n110\t\t\t}\n111\t\t}\n112\t\treturn 0, nil\n113\t}\n114\t\n115\tfunc setWidth(val string, remaining []string, opts *options) (int, error) {\n116\t\tif val == \"\" {\n117\t\t\tif len(remaining) > 0 {\n118\t\t\t\tval = remaining[0]\n119\t\t\t} else {\n120\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'w'\")\n121\t\t\t}\n122\t\t\tn, err := strconv.Atoi(val)\n123\t\t\tif err != nil || n <= 0 {\n124\t\t\t\treturn 0, fmt.Errorf(\"invalid number of columns: '%s'\", val)\n125\t\t\t}\n126\t\t\topts.width = n\n127\t\t\treturn 1, nil\n128\t\t}\n129\t\tn, err := strconv.Atoi(val)\n130\t\tif err != nil || n <= 0 {\n131\t\t\treturn 0, fmt.Errorf(\"invalid number of columns: '%s'\", val)\n132\t\t}\n133\t\topts.width = n\n134\t\treturn 0, nil\n135\t}\n136\t\n137\tfunc processFile(path string, opts options, w *bufio.Writer) error {\n138\t\tvar r io.Reader\n139\t\tif path == \"-\" {\n140\t\t\tr = os.Stdin\n141\t\t} else {\n142\t\t\tf, err := os.Open(path)\n143\t\t\tif err != nil {\n144\t\t\t\treturn err\n145\t\t\t}\n146\t\t\tdefer f.Close()\n147\t\t\tr = f\n148\t\t}\n149\t\treturn processInput(r, opts