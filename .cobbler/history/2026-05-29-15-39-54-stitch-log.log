n222\t\t\t\tstart = i + 1\n223\t\t\t\tcol = 0\n224\t\t\t\tlastSpace = -1\n225\t\t\t\tcontinue\n226\t\t\t}\n227\t\t\tnextCol := advanceColumn(col, b)\n228\t\t\tif nextCol > width {\n229\t\t\t\tbreakPos := i\n230\t\t\t\tif opts.spaceMode && lastSpace >= start {\n231\t\t\t\t\tbreakPos = lastSpace + 1\n232\t\t\t\t}\n233\t\t\t\tif _, err := w.Write(line[start:breakPos]); err != nil {\n234\t\t\t\t\treturn err\n235\t\t\t\t}\n236\t\t\t\tif err := w.WriteByte('\\n'); err != nil {\n237\t\t\t\t\treturn err\n238\t\t\t\t}\n239\t\t\t\tstart = breakPos\n240\t\t\t\tcol = recalcColumn(line[start:i+1], 0)\n241\t\t\t\tlastSpace = -1\n242\t\t\t\tfor j := start; j <= i; j++ {\n243\t\t\t\t\tif line[j] == ' ' || line[j] == '\\t' {\n244\t\t\t\t\t\tlastSpace = j\n245\t\t\t\t\t}\n246\t\t\t\t}\n247\t\t\t\tcontinue\n248\t\t\t}\n249\t\t\tif b == ' ' || b == '\\t' {\n250\t\t\t\tlastSpace = i\n251\t\t\t}\n252\t\t\tcol = nextCol\n253\t\t}\n254\t\tif start < len(line) {\n255\t\t\tif _, err := w.Write(line[start:]); err != nil {\n256\t\t\t\treturn err\n257\t\t\t}\n258\t\t}\n259\t\treturn nil\n260\t}\n261\t\n262\tfunc advanceColumn(col int, b byte) int {\n263\t\tif b == '\\t' {\n264\t\t\treturn col + 8 - (col % 8)\n265\t\t}\n266\t\tif b == '\\b' {\n267\t\t\tif col > 0 {\n268\t\t\t\treturn col - 1\n269\t\t\t}\n270\t\t\treturn 0\n271\t\t}\n272\t\tif b == '\\r' {\n273\t\t\treturn 0\n274\t\t}\n275\t\treturn col + 1\n276\t}\n277\t\n278\tfunc recalcColumn(data []byte, startCol int) int {\n279\t\tcol := startCol\n280\t\tfor _, b := range data {\n281\t\t\tcol = advanceColumn(col, b)\n282\t\t}\n283\t\treturn col\n284\t}\n285\t\n286\tfunc breakAtSpace(line []byte, width int) []byte {\n287\t\tif width > len(line) {\n288\t\t\twidth = len(line)\n289\t\t}\n290\t\tseg := line[:width]\n291\t\tfor i := len(seg) - 1; i >= 0; i-- {\n292\t\t\tif seg[i] == ' ' || seg[i] == '\\t' {\n293\t\t\t\treturn seg[:i+1]\n294\t\t\t}\n295\t\t}\n296\t\treturn seg\n297\t}\n298\t\n299\tfunc endsWithNewline(line []byte) bool {\n300\t\tre