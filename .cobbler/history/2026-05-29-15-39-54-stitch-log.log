{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019z3umeRwmHbxm5jyfZn7P8","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/fmt implements srd070-fmt: simple text formatter that reformats\n5\t// paragraphs to fit within a specified line width.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"bufio\"\n10\t\t\"errors\"\n11\t\t\"fmt\"\n12\t\t\"io\"\n13\t\t\"os\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"syscall\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n19\t)\n20\t\n21\tvar (\n22\t\tflagWidth   int\n23\t\tflagGoal    int\n24\t\tflagSplit   bool\n25\t\tflagTagged  bool\n26\t\tflagPrefix  string\n27\t\tflagUniform bool\n28\t)\n29\t\n30\tfunc init() {\n31\t\tflagWidth = 75\n32\t\tflagGoal = 0\n33\t}\n34\t\n35\tfunc main() {\n36\t\tsys.InstallSIGPIPEHandler()\n37\t\n38\t\targs := parseFlags(os.Args[1:])\n39\t\tif len(args) == 0 {\n40\t\t\targs = []string{\"-\"}\n41\t\t}\n42\t\n43\t\tif flagGoal == 0 {\n44\t\t\tflagGoal = flagWidth * 93 / 100\n45\t\t}\n46\t\n47\t\texitCode := 0\n48\t\tfor _, name := range args {\n49\t\t\tif err := fmtFile(name); err != nil {\n50\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n51\t\t\t\t\tos.Exit(0)\n52\t\t\t\t}\n53\t\t\t\tfmt.Fprintf(os.Stderr, \"fmt: %s\\n\", formatErr(err))\n54\t\t\t\texitCode = 1\n55\t\t\t}\n56\t\t}\n57\t\tif exitCode != 0 {\n58\t\t\tos.Exit(exitCode)\n59\t\t}\n60\t}\n61\t\n62\tfunc parseFlags(args []string) []string {\n63\t\tvar files []string\n64\t\tendOfFlags := false\n65\t\tfor i := 0; i < len(args); i++ {\n66\t\t\targ := args[i]\n67\t\t\tif endOfFlags || arg == \"\" || arg == \"-\" || arg[0] != '-' {\n68\t\t\t\tfiles = append(files, arg)\n69\t\t\t\tcontinue\n70\t\t\t}\n71\t\t\tif arg == \"--\" {\n72\t\t\t\tendOfFlags = true\n73\t\t\t\tcontinue\n74\t\t\t}\n75\t\t\tif len(arg) > 2 && arg[:2] == \"--\" {\n76\t\t\t\ti = parseLongFlag(args, i)\n77\t\t\t\tcontinue\n78\t\t\t}\n79\t\t\ti = parseShortFlags(args, i)\n80\t\t}\n81\t\treturn files\n82\t}\n83\t\n84\tfunc parseLongFlag(args []string, i int) int {\n85\t\targ := args[i]\n86\t\tswitch {\n87\t\tcase matchLong(arg, \"--width\"):\n88\t\t\tflagWidth = parseLongIntArg(arg, \"--width\")\n89\t\tcase matchLong(arg, \"--goal\"):\n90\t\t\tflagGoal = parseLongIntArg(arg, \"--goal\")\n91\t\tcase arg == \"--split-only\":\n92\t\t\tflagSplit = true\n93\t\tcase arg == \"--tagged-paragraph\":\n94\t\t\tflagTagged = true\n95\t\tcase matchLong(arg, \"--prefix\"):\n96\t\t\tflagPrefix = parseLongStrArg(arg, \"--prefix\")\n97\t\tcase arg == \"--uniform-spacing\":\n98\t\t\tflagUniform = true\n99\t\tdefault:\n100\t\t\tfmt.Fprintf(os.Stderr, \"fmt: unrecognized option '%s'\\n\", arg)\n101\t\t\tos.Exit(1)\n102\t\t}\n103\t\treturn i\n104\t}\n105\t\n106\tfunc matchLong(arg, name string) bool {\n107\t\treturn arg == name || (len(arg) > len(name) && arg[:len(name)+1] == name+\"=\")\n108\t}\n109\t\n110\tfunc parseLongIntArg(arg, name string) int {\n111\t\teq := len(name) + 1\n112\t\tif len(arg) <= len(name) || arg[len(name)] != '=' {\n113\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option '%s' requires an argument\\n\", name)\n114\t\t\tos.Exit(1)\n115\t\t}\n116\t\tv, err := strconv.Atoi(arg[eq:])\n117\t\tif err != nil || v < 0 {\n118\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", arg[eq:])\n119\t\t\tos.Exit(1)\n120\t\t}\n121\t\treturn v\n122\t}\n123\t\n124\tfunc parseLongStrArg(arg, name string) string {\n125\t\teq := len(name) + 1\n126\t\tif len(arg) <= len(name) || arg[len(name)] != '=' {\n127\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option '%s' requires an argument\\n\", name)\n128\t\t\tos.Exit(1)\n129\t\t}\n130\t\treturn arg[eq:]\n131\t}\n132\t\n133\tfunc parseShortFlags(args []string, i int) int {\n134\t\targ := args[i]\n135\t\tfor j := 1; j < len(arg); j++ {\n136\t\t\tc := arg[j]\n137\t\t\tswitch c {\n138\t\t\tcase 'w':\n139\t\t\t\tflagWidth = consumeIntArg(args, arg, &i, j)\n140\t\t\t\treturn i\n141\t\t\tcase 'g':\n142\t\t\t\tflagGoal = consumeIntArg(args, arg, &i, j)\n143\t\t\t\treturn i\n144\t\t\tcase 'p':\n145\t\t\t\tflagPrefix = consumeStrArg(args, arg, &i, j)\n146\t\t\t\treturn i\n147\t\t\tcase 's':\n148\t\t\t\tflagSplit = true\n149\t\t\tcase 't':\n150\t\t\t\tflagTagged = true\n151\t\t\tcase 'u':\n152\t\t\t\tflagUniform = true\n153\t\t\tdefault:\n154\t\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid option -- '%c'\\n\", c)\n155\t\t\t\tos.Exit(1)\n156\t\t\t}\n157\t\t}\n158\t\treturn i\n159\t}\n160\t\n161\tfunc consumeIntArg(args []string, arg string, i *int, j int) int {\n162\t\trest := arg[j+1:]\n163\t\tif rest != \"\" {\n164\t\t\tv, err := strconv.Atoi(rest)\n165\t\t\tif err != nil || v < 0 {\n166\t\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", rest)\n167\t\t\t\tos.Exit(1)\n168\t\t\t}\n169\t\t\treturn v\n170\t\t}\n171\t\t*i++\n172\t\tif *i >= len(args) {\n173\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n174\t\t\tos.Exit(1)\n175\t\t}\n176\t\tv, err := strconv.Atoi(args[*i])\n177\t\tif err != nil || v < 0 {\n178\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", args[*i])\n179\t\t\tos.Exit(1)\n180\t\t}\n181\t\treturn v\n182\t}\n183\t\n184\tfunc consumeStrArg(args []string, arg string, i *int, j int) string {\n185\t\trest := arg[j+1:]\n186\t\tif rest != \"\" {\n187\t\t\treturn rest\n188\t\t}\n189\t\t*i++\n190\t\tif *i >= len(args) {\n191\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n192\t\t\tos.Exit(1)\n193\t\t}\n194\t\treturn args[*i]\n195\t}\n196\t\n197\tfunc fmtFile(name string) error {\n198\t\tvar r io.Reader\n199\t\tif name == \"-\" {\n200\t\t\tr = os.Stdin\n201\t\t} else {\n202\t\t\tf, err := os.Open(name)\n203\t\t\tif err != nil {\n204\t\t\t\treturn err\n205\t\t\t}\n206\t\t\tdefer f.Close()\n207\t\t\tr = f\n208\t\t}\n209\t\treturn formatInput(r)\n210\t}\n211\t\n212\tfunc formatInput(r io.Reader) error {\n213\t\tscanner := bufio.NewScanner(r)\n214\t\tvar lines []string\n215\t\tfor scanner.Scan() {\n216\t\t\tlines = append(lines, scanner.Text())\n217\t\t}\n218\t\tif err := scanner.Err(); err != nil {\n219\t\t\treturn err\n220\t\t}\n221\t\tw := bufio.NewWriter(os.Stdout)\n222\t\tvar werr error\n223\t\tif flagPrefix != \"\" {\n224\t\t\twerr = formatWithPrefix(w, lines)\n225\t\t} else {\n226\t\t\twerr = writeFormatted(w, lines)\n227\t\t}\n228\t\tif werr != nil {\n229\t\t\treturn werr\n230\t\t}\n231\t\treturn w.Flush()\n232\t}\n233\t\n234\tfunc writeFormatted(w *bufio.Writer, lines []string) error {\n235\t\tblocks := groupParagraphs(lines)\n236\t\tfor _, block := range blocks {\n237\t\t\tif len(block) == 0 {\n238\t\t\t\tif _, err := w.WriteString(\"\\n\"); err != nil {\n239\t\t\t\t\treturn err\n240\t\t\t\t}\n241\t\t\t\tcontinue\n242\t\t\t}\n243\t\t\tif err := formatParagraph(w, block); err != nil {\n244\t\t\t\treturn err\n245\t\t\t}\n246\t\t}\n247\t\treturn nil\n248\t}\n249\t\n250\tfunc groupParagraphs(lines []string) [][]string {\n251\t\tvar result [][]string\n252\t\tvar current []string\n253\t\tfor _, line := range lines {\n254\t\t\tif strings.TrimSpace(line) == \"\" {\n255\t\t\t\tif len(current) > 0 {\n256\t\t\t\t\tresult = append(result, current)\n257\t\t\t\t\tcurrent = nil\n258\t\t\t\t}\n259\t\t\t\tresult = append(result, nil)\n260\t\t\t\tcontinue\n261\t\t\t}\n262\t\t\tcurrent = append(current, line)\n263\t\t}\n264\t\tif len(current) > 0 {\n265\t\t\tresult = append(result, current)\n266\t\t}\n267\t\treturn result\n268\t}\n269\t\n270\tfunc formatParagraph(w *bufio.Writer, lines []string) error {\n271\t\tif flagSplit {\n272\t\t\treturn writeSplitOnly(w, lines)\n273\t\t}\n274\t\tif len(lines) == 1 && len(lines[0]) <= flagWidth {\n275\t\t\tif flagUniform {\n276\t\t\t\tlines[0] = normalizeUniform(lines[0])\n277\t\t\t}\n278\t\t\treturn writeLines(w, lines)\n279\t\t}\n280\t\tfirstIndent, bodyIndent := getIndents(lines)\n281\t\twords := extractWords(lines)\n282\t\tif len(words) == 0 {\n283\t\t\treturn nil\n284\t\t}\n285\t\tfilled := fillLines(words, firstIndent, bodyIndent, flagGoal, flagWidth)\n286\t\treturn writeLines(w, filled)\n287\t}\n288\t\n289\tfunc getIndents(lines []string) (string, string) {\n290\t\tfirst := extractIndent(lines[0])\n291\t\tif len(lines) > 1 {\n292\t\t\treturn first, extractIndent(lines[1])\n293\t\t}\n294\t\treturn first, first\n295\t}\n296\t\n297\tfunc extractIndent(s string) string {\n298\t\ttrimmed := strings.TrimLeft(s, \" \\t\")\n299\t\treturn s[:len(s)-len(trimmed)]\n300\t}\n301\t\n302\tfunc extractWords(lines []string) []string {\n303\t\tvar words []string\n304\t\tfor _, line := range lines {\n305\t\t\twords = append(words, strings.Fields(line)...)\n306\t\t}\n307\t\treturn words\n308\t}\n309\t\n310\tfunc fillLines(words []string, firstIndent, bodyIndent string, goal, max int) []string {\n311\t\tif len(words) == 0 {\n312\t\t\treturn nil\n313\t\t}\n314\t\tif goal > max {\n315\t\t\tgoal = max\n316\t\t}\n317\t\tvar result []string\n318\t\tline := firstIndent + words[0]\n319\t\tfor i := 1; i < len(words); i++ {\n320\t\t\tsep := wordSep(words[i-1])\n321\t\t\ttrial := line + sep + words[i]\n322\t\t\tif len(trial) > max || pastGoal(len(line), len(trial), goal) {\n323\t\t\t\tresult = append(result, line)\n324\t\t\t\tline = bodyIndent + words[i]\n325\t\t\t} else {\n326\t\t\t\tline = trial\n327\t\t\t}\n328\t\t}\n329\t\treturn append(result, line)\n330\t}\n331\t\n332\tfunc pastGoal(lineLen, trialLen, goal int) bool {\n333\t\tif trialLen <= goal {\n334\t\t\treturn false\n335\t\t}\n336\t\tover := trialLen - goal\n337\t\tunder := goal - lineLen\n338\t\tif under <= 0 {\n339\t\t\treturn true\n340\t\t}\n341\t\treturn over > under\n342\t}\n343\t\n344\tfunc wordSep(prev string) string {\n345\t\tif endsWithSentence(prev) {\n346\t\t\treturn \"  \"\n347\t\t}\n348\t\treturn \" \"\n349\t}\n350\t\n351\tfunc endsWithSentence(word string) bool {\n352\t\tif len(word) == 0 {\n353\t\t\treturn false\n354\t\t}\n355\t\tlast := word[len(word)-1]\n356\t\treturn last == '.' || last == '!' || last == '?'\n357\