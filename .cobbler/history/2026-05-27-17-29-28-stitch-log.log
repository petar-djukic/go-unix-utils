{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tib6RvwFdNm5HAqAW63PoD","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd106-df R1.1-R1.5, R2.1-R2.3, R3.1-R3.7.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"math\"\n10\t\t\"os\"\n11\t\t\"slices\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\t\"syscall\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n17\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n18\t\t\"golang.org/x/sys/unix\"\n19\t)\n20\t\n21\ttype sizeMode int\n22\t\n23\tconst (\n24\t\tmodeDefault sizeMode = iota\n25\t\tmodeHuman\n26\t\tmodeSI\n27\t)\n28\t\n29\ttype options struct {\n30\t\tsizeMode     sizeMode\n31\t\tshowType     bool\n32\t\tshowInodes   bool\n33\t\tshowAll      bool\n34\t\tlocalOnly    bool\n35\t\tincludeTypes []string\n36\t\texcludeTypes []string\n37\t\toutputFields []string\n38\t\toutputMode   bool\n39\t}\n40\t\n41\ttype fsEntry struct {\n42\t\tfilesystem      string\n43\t\tfsType          string\n44\t\tblocks1K        int64\n45\t\tused            int64\n46\t\tavailable       int64\n47\t\tsizeBytes       int64\n48\t\tusedBytes       int64\n49\t\tavailBytes      int64\n50\t\tusePercent      string\n51\t\tinodes          int64\n52\t\tinodesUsed      int64\n53\t\tinodesFree      int64\n54\t\tinodeUsePercent string\n55\t\tmountedOn       string\n56\t\tfile            string\n57\t}\n58\t\n59\tvar humanSuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n60\t\n61\tfunc main() {\n62\t\tsys.InstallSIGPIPEHandler()\n63\t\tos.Exit(run(os.Args[1:]))\n64\t}\n65\t\n66\tfunc run(args []string) int {\n67\t\topts, files := parseArgs(args)\n68\t\tif msg := validateOpts(opts); msg != \"\" {\n69\t\t\tfmt.Fprintln(os.Stderr, msg)\n70\t\t\treturn 1\n71\t\t}\n72\t\tif len(files) == 0 {\n73\t\t\treturn listAll(opts)\n74\t\t}\n75\t\treturn listPaths(files, opts)\n76\t}\n77\t\n78\tfunc validateOpts(opts options) string {\n79\t\tif opts.outputMode && opts.showInodes {\n80\t\t\treturn \"df: options -i and --output are mutually exclusive\\n\" +\n81\t\t\t\t\"Try 'df --help' for more information.\"\n82\t\t}\n83\t\tif opts.outputMode && opts.showType {\n84\t\t\treturn \"df: options -T and --output are mutually exclusive\\n\" +\n85\t\t\t\t\"Try 'df --help' for more information.\"\n86\t\t}\n87\t\tfor _, t := range opts.includeTypes {\n88\t\t\tif slices.Contains(opts.excludeTypes, t) {\n89\t\t\t\treturn fmt.Sprintf(\"df: file system type '%s' both selected and excluded\", t)\n90\t\t\t}\n91\t\t}\n92\t\treturn \"\"\n93\t}\n94\t\n95\tfunc parseArgs(args []string) (options, []string) {\n96\t\tvar opts options\n97\t\tvar files []string\n98\t\tendOfFlags := false\n99\t\tfor i := 0; i < len(args); i++ {\n100\t\t\targ := args[i]\n101\t\t\tif endOfFlags {\n102\t\t\t\tfiles = append(files, arg)\n103\t\t\t\tcontinue\n104\t\t\t}\n105\t\t\tif arg == \"--\" {\n106\t\t\t\tendOfFlags = true\n107\t\t\t\tcontinue\n108\t\t\t}\n109\t\t\tconsumed, skip := parseFlag(&opts, arg, args, i)\n110\t\t\tif consumed {\n111\t\t\t\ti += skip\n112\t\t\t} else {\n113\t\t\t\tfiles = append(files, arg)\n114\t\t\t}\n115\t\t}\n116\t\treturn opts, files\n117\t}\n118\t\n119\tfunc parseFlag(opts *options, arg string, args []string, i int) (bool, int) {\n120\t\tswitch {\n121\t\tcase arg == \"-h\" || arg == \"--human-readable\":\n122\t\t\topts.sizeMode = modeHuman\n123\t\tcase arg == \"-H\" || arg == \"--si\":\n124\t\t\topts.sizeMode = modeSI\n125\t\tcase arg == \"-T\" || arg == \"--print-type\":\n126\t\t\topts.showType = true\n127\t\tcase arg == \"-i\" || arg == \"--inodes\":\n128\t\t\topts.showInodes = true\n129\t\tcase arg == \"-a\" || arg == \"--all\":\n130\t\t\topts.showAll = true\n131\t\tcase arg == \"-l\" || arg == \"--local\":\n132\t\t\topts.localOnly = true\n133\t\tcase arg == \"-t\" && i+1 < len(args):\n134\t\t\topts.includeTypes = append(opts.includeTypes, args[i+1])\n135\t\t\treturn true, 1\n136\t\tcase strings.HasPrefix(arg, \"--type=\"):\n137\t\t\topts.includeTypes = append(opts.includeTypes, arg[7:])\n138\t\tcase arg == \"-x\" && i+1 < len(args):\n139\t\t\topts.excludeTypes = append(opts.excludeTypes, args[i+1])\n140\t\t\treturn true, 1\n141\t\tcase strings.HasPrefix(arg, \"--exclude-type=\"):\n142\t\t\topts.excludeTypes = append(opts.excludeTypes, arg[15:])\n143\t\tcase arg == \"--output\":\n144\t\t\topts.outputMode = true\n145\t\t\topts.outputFields = allOutputFields()\n146\t\tcase strings.HasPrefix(arg, \"--output=\"):\n147\t\t\topts.outputMode = true\n148\t\t\topts.outputFields = strings.Split(arg[9:], \",\")\n149\t\tdefault:\n150\t\t\treturn false, 0\n151\t\t}\n152\t\treturn true, 0\n153\t}\n154\t\n155\tfunc listAll(opts options) int {\n156\t\tstats, err := getAllMounts()\n157\t\tif err != nil {\n158\t\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n159\t\t\treturn 1\n160\t\t}\n161\t\tentries := filterAndDedup(stats, opts)\n162\t\tprintTable(entries, opts)\n163\t\treturn 0\n164\t}\n165\t\n166\tfunc listPaths(paths []string, opts options) int {\n167\t\tstats, err := getAllMounts()\n168\t\tif err != nil {\n169\t\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n170\t\t\treturn 1\n171\t\t}\n172\t\tdevMap := buildDevMap(stats)\n173\t\texitCode := 0\n174\t\tentries := make([]fsEntry, 0, len(paths))\n175\t\tfor _, path := range paths {\n176\t\t\tentry, err := entryForPath(path, devMap)\n177\t\t\tif err != nil {\n178\t\t\t\tfmt.Fprintf(os.Stderr, \"df: %s: %s\\n\", path, capitalizeErr(err))\n179\t\t\t\texitCode = 1\n180\t\t\t\tcontinue\n181\t\t\t}\n182\t\t\tif !matchesTypeFilter(entry.fsType, opts) {\n183\t\t\t\tcontinue\n184\t\t\t}\n185\t\t\tentry.file = path\n186\t\t\tentries = append(entries, entry)\n187\t\t}\n188\t\tif len(entries) > 0 {\n189\t\t\tprintTable(entries, opts)\n190\t\t}\n191\t\treturn exitCode\n192\t}\n193\t\n194\tfunc capitalizeErr(err error) string {\n195\t\ts := err.Error()\n196\t\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n197\t\t\treturn strings.ToUpper(s[:1]) + s[1:]\n198\t\t}\n199\t\treturn s\n200\t}\n201\t\n202\tfunc getAllMounts() ([]unix.Statfs_t, error) {\n203\t\tn, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)\n204\t\tif err != nil {\n205\t\t\treturn nil, err\n206\t\t}\n207\t\tbuf := make([]unix.Statfs_t, n)\n208\t\tn, err = unix.Getfsstat(buf, unix.MNT_NOWAIT)\n209\t\tif err != nil {\n210\t\t\treturn nil, err\n211\t\t}\n212\t\treturn buf[:n], nil\n213\t}\n214\t\n215\tfunc isDummyType(t string) bool {\n216\t\treturn t == \"devfs\" || t == \"autofs\"\n217\t}\n218\t\n219\tfunc matchesTypeFilter(fsType string, opts options) bool {\n220\t\tif len(opts.includeTypes) > 0 && !slices.Contains(opts.includeTypes, fsType) {\n221\t\t\treturn false\n222\t\t}\n223\t\treturn !slices.Contains(opts.excludeTypes, fsType)\n224\t}\n225\t\n226\tfunc filterAndDedup(stats []unix.Statfs_t, opts options) []fsEntry {\n227\t\tseen := make(map[int32]bool)\n228\t\tentries := make([]fsEntry, 0, len(stats))\n229\t\tfor _, s := range stats {\n230\t\t\tfsType := cstring(s.Fstypename[:])\n231\t\t\tif !opts.showAll {\n232\t\t\t\tif isDummyType(fsType) {\n233\t\t\t\t\tcontinue\n234\t\t\t\t}\n235\t\t\t\tif s.Blocks == 0 {\n236\t\t\t\t\tcontinue\n237\t\t\t\t}\n238\t\t\t}\n239\t\t\tif opts.localOnly && s.Flags&unix.MNT_LOCAL == 0 {\n240\t\t\t\tcontinue\n241\t\t\t}\n242\t\t\tif !matchesTypeFilter(fsType, opts) {\n243\t\t\t\tcontinue\n244\t\t\t}\n245\t\t\tdev, ok := mountDev(cstring(s.Mntonname[:]))\n246\t\t\tif !ok {\n247\t\t\t\tcontinue\n248\t\t\t}\n249\t\t\tif seen[dev] {\n250\t\t\t\tcontinue\n251\t\t\t}\n252\t\t\tseen[dev] = true\n253\t\t\tentry := buildEntry(s)\n254\t\t\tentry.file = \"-\"\n255\t\t\tentries = append(entries, entry)\n256\t\t}\n257\t\treturn entries\n258\t}\n259\t\n260\tfunc buildDevMap(stats []unix.Statfs_t) map[int32]string {\n261\t\tm := make(map[int32]string, len(stats))\n262\t\tfor _, s := range stats {\n263\t\t\tmount := cstring(s.Mntonname[:])\n264\t\t\tdev, ok := mountDev(mount)\n265\t\t\tif !ok {\n266\t\t\t\tcontinue\n267\t\t\t}\n268\t\t\tif _, exists := m[dev]; !exists {\n269\t\t\t\tm[dev] = mount\n270\t\t\t}\n271\t\t}\n272\t\treturn m\n273\t}\n274\t\n275\tfunc entryForPath(path string, devMap map[int32]string) (fsEntry, error) {\n276\t\tvar info syscall.Stat_t\n277\t\tif err := syscall.Stat(path, &info); err != nil {\n278\t\t\treturn fsEntry{}, err\n279\t\t}\n280\t\ttarget := path\n281\t\tif mount, ok := devMap[info.Dev]; ok {\n282\t\t\ttarget = mount\n283\t\t}\n284\t\tvar stat unix.Statfs_t\n285\t\tif err := unix.Statfs(target, &stat); err != nil {\n286\t\t\treturn fsEntry{}, err\n287\t\t}\n288\t\treturn buildEntry(stat), nil\n289\t}\n290\t\n291\tfunc mountDev(mount string) (int32, bool) {\n292\t\tvar info syscall.Stat_t\n293\t\tif err := syscall.Stat(mount, &info); err != nil {\n294\t\t\treturn 0, false\n295\t\t}\n296\t\treturn info.Dev, true\n297\t}\n298\t\n299\tfunc buildEntry(stat unix.Statfs_t) fsEntry {\n300\t\tbsize := uint64(stat.Bsize)\n301\t\ttotalBytes := int64(stat.Blocks * bsize)\n302\t\tfreeBytes := int64(stat.Bfree * bsize)\n303\t\tavailBytes := int64(stat.Bavail * bsize)\n304\t\ttotal := totalBytes / 1024\n305\t\tfree := freeBytes / 1024\n306\t\tavail := availBytes / 1024\n307\t\tinodes := int64(stat.Files)\n308\t\tinodesFree := int64(stat.Ffree)\n309\t\treturn fsEntry{\n310\t\t\tfilesystem:      cstring(stat.Mntfromname[:]),\n311\t\t\tfsType:          cstring(stat.Fstypename[:]),\n312\t\t\tblocks1K:        total,\n313\t\t\tused:            total - free,\n314\t\t\tavailable:       avail,\n315\t\t\tsizeBytes:       totalBytes,\n316\t\t\tusedBytes:       totalBytes - freeBytes,\n317\t\t\tavailBytes:      availBytes,\n318\t\t\tusePercent:      computeUsePercent(total, avail),\n319\t\t\tinodes:          inodes,\n320\t\t\tinodesUsed:      inodes - inodesFree,\n321\t\t\tinodesFree:      inodesFree,\n322\t\t\tinodeUsePercent: computeUsePercent(inodes, inodesFree),\n323\t\t\tmountedOn:       cstring(stat.Mntonname[:]),\n324\t\t}\n325\t}\n326\t\n327\tfunc computeUsePercent(total, avail int64) string {\n328\t\tif total == 0 {\n329\t\t\treturn \"-\"\n330\t\t}\n331\t\tused := total - avail\n332\t\tif used <= 0 {\n333\t\t\treturn \"0%\"\n334\t\t}\n335\t\tpct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n336\t\treturn strconv.FormatInt(pct, 10) + \"%\"\n337\t}\n338\t\n339\tfunc humanSize(bytes int64, base float64) string {\n340\t\tif bytes == 0 {\n341\t\t\treturn \"0\"\n342\t\t}\n343\t\tval := float64(bytes)\n344\t\tidx := 0\n345\t\tfor idx < len(humanSuffixes)-1 && val >= base {\n346\t\t\tval /= base\n347\t\t\tidx++\n348\t\t}\n349\t\treturn formatHuman(val, humanSuffixes[idx])\n350\t}\n351\t\n352\tfunc formatHuman(val float64, suffix string) string {\n353\t\tif suffix == \"\" {\n354\t\t\treturn strconv.FormatInt(int64(math.Ceil(val)), 10)\n355\t\t}\n356\t\tceiled := math.Ceil(val*10) / 10\n357\t\tif ceiled < 10 {\n358\t\t\treturn fmt.Sprintf(\"%.1f%s\", ceiled, suffix)\n359\t\t}\n360\t\treturn fmt.Sprintf(\"%d%s\", int64(math.Ceil(val)), suffix)\n361\t}\n362\t\n363\tfunc formatSize(blocks1K, sizeBytes int64, mode sizeMode) string {\n364\t\tswitch mode {\n365\t\tcase modeHuman:\n366\t\t\treturn humanSize(sizeBytes, 1024)\n367\t\tcase modeSI:\n368\t\t\treturn humanSize(sizeBytes, 1000)\n369\t\tdefault:\n370\t\t\treturn strconv.FormatInt(blocks1K, 10)\n371\t\t}\n372\t}\n373\t\n374\tfunc formatInodeField(count int64, mode sizeMode) string {\n375\t\tswitch mode {\n376\t\tcase modeHuman:\n377\t\t\treturn humanSize(count, 1024)\n378\t\tcase modeSI:\n379\t\t\treturn humanSize(count, 1000)\n380\t\tdefault:\n381\t\t\treturn strconv.FormatInt(count, 10)\n382\t\t}\n383\t}\n384\t\n385\tfunc getHeaders(opts options) []string {\n386\t\tvar h []string\n387\t\th = append(h, \"Filesystem\")\n388\t\tif opts.showType {\n389\t\t\th = append(h, \"Type\")\n390\t\t}\n391\t\tif opts.showInodes {\n392\t\t\th = append(h, \"Inodes\", \"IUsed\", \"IFree\", \"IUse%\")\n393\t\t} else if opts.sizeMode != modeDefault {\n394\t\t\th = append(h, \"Size\", \"Used\", \"Avail\", \"Use%\")\n395\t\t} else {\n396\t\t\th = append(h, \"1K-blocks\", \"Used\", \"Available\", \"Use%\")\n397\t\t}\n398\t\th = append(h, \"Mounted on\")\n399\t\treturn h\n400\t}\n401\t\n402\tfunc getAlignment(opts options) []bool {\n403\t\tvar a []bool\n404\t\ta = append(a, false)\n405\t\tif opts.showType {\n406\t\t\ta = append(a, false)\n407\t\t}\n408\t\ta = append(a, true, true, true, true)\n409\t\ta = append(a, false)\n410\t\treturn a\n411\t}\n412\t\n413\tfunc entryStrings(e fsEntry, opts options) []string {\n414\t\tvar cols []string\n415\t\tcols = append(cols, e.filesystem)\n416\t\tif opts.showType {\n417\t\t\tcols = append(cols, e.fsType)\n418\t\t}\n419\t\tif opts.showInodes {\n420\t\t\tcols = append(cols,\n421\t\t\t\tstrconv.FormatInt(e.inodes, 10),\n422\t\t\t\tstrconv.FormatInt(e.inodesUsed, 10),\n423\t\t\t\tstrconv.FormatInt(e.inodesFree, 10),\n424\t\t\t\te.inodeUsePercent,\n425\t\t\t)\n426\t\t} else {\n427\t\t\tcols = append(cols,\n428\t\t\t\tformatSize(e.blocks1K, e.sizeBytes, opts.sizeMode),\n429\t\t\t\tformatSize(e.used, e.usedBytes, opts.sizeMode),\n430\t\t\t\tformatSize(e.available, e.availBytes, opts.sizeMode),\n431\t\t\t\te.usePercent,\n432\t\t\t)\n433\t\t}\n434\t\tcols = append(cols, e.mountedOn)\n435\t\treturn cols\n436\t}\n437\t\n438\tfunc computeWidths(entries []fsEntry, opts options) []int {\n439\t\th := getHeaders(opts)\n440\t\tw := make([]int, len(h))\n441\t\tfor i, s := range h {\n442\t\t\tw[i] = len(s)\n443\t\t}\n444\t\tfor _, e := range entries {\n445\t\t\tcols := entryStrings(e, opts)\n446\t\t\tfor i := range w {\n447\t\t\t\tif len(cols[i]) > w[i] {\n448\t\t\t\t\tw[i] = len(cols[i])\n449\t\t\t\t}\n450\t\t\t}\n451\t\t}\n452\t\tstart := 1\n453\t\tif opts.showType {\n454\t\t\tstart = 2\n455\t\t}\n456\t\tfor i := start; i < start+3 && i < len(w); i++ {\n457\t\t\tif w[i] < 5 {\n458\t\t\t\tw[i] = 5\n459\t\t\t}\n460\t\t}\n461\t\treturn w\n462\t}\n463\t\n464\tfunc printTable(entries []fsEntry, opts options) {\n465\t\tif opts.outputMode {\n466\t\t\tprintOutputTable(entries, opts)\n467\t\t\treturn\n468\t\t}\n469\t\tw := computeWidths(entries, opts)\n470\t\talign := getAlignment(opts)\n471\t\tprintLine(getHeaders(opts), w, align)\n472\t\tfor _, e := range entries {\n473\t\t\tprintLine(entryStrings(e, opts), w, align)\n474\t\t}\n475\t}\n476\t\n477\tfunc allOutputFields() []string {\n478\t\treturn []string{\n479\t\t\t\"source\", \"fstype\", \"itotal\", \"iused\", \"iavail\", \"ipcent\",\n480\t\t\t\"size\", \"used\", \"avail\", \"pcent\", \"file\", \"target\",\n481\t\t}\n482\t}\n483\t\n484\tfunc outputHeader(field string, mode sizeMode) string {\n485\t\tswitch field {\n486\t\tcase \"source\":\n487\t\t\treturn \"Filesystem\"\n488\t\tcase \"fstype\":\n489\t\t\treturn \"Type\"\n490\t\tcase \"itotal\":\n491\t\t\treturn \"Inodes\"\n492\t\tcase \"iused\":\n493\t\t\treturn \"IUsed\"\n494\t\tcase \"iavail\":\n495\t\t\treturn \"IFree\"\n496\t\tcase \"ipcent\":\n497\t\t\treturn \"IUse%\"\n498\t\tcase \"size\":\n499\t\t\tif mode != modeDefault {\n500\t\t\t\treturn \"Size\"\n501\t\t\t}\n502\t\t\treturn \"1K-blocks\"\n503\t\tcase \"used\":\n504\t\t\treturn \"Used\"\n505\t\tcase \"avail\":\n506\t\t\treturn \"Avail\"\n507\t\tcase \"pcent\":\n508\t\t\treturn \"Use%\"\n509\t\tcase \"file\":\n510\t\t\treturn \"File\"\n511\t\tcase \"target\":\n512\t\t\treturn \"Mounted on\"\n513\t\t}\n514\t\treturn field\n515\t}\n516\t\n517\tfunc outputRightAlign(field string) bool {\n518\t\tswitch field {\n519\t\tcase \"source\", \"fstype\", \"file\", \"target\":\n520\t\t\treturn false\n521\t\tdefault:\n522\t\t\treturn true\n523\t\t}\n524\t}\n525\t\n526\tfunc outputValue(e fsEntry, field string, opts options) string {\n527\t\tswitch field {\n528\t\tcase \"source\":\n529\t\t\treturn e.filesystem\n530\t\tcase \"fstype\":\n531\t\t\treturn e.fsType\n532\t\tcase \"itotal\":\n533\t\t\treturn formatInodeField(e.inodes, opts.sizeMode)\n534\t\tcase \"iused\":\n535\t\t\treturn formatInodeField(e.inodesUsed, opts.sizeMode)\n536\t\tcase \"iavail\":\n537\t\t\treturn formatInodeField(e.inodesFree, opts.sizeMode)\n538\t\tcase \"ipcent\":\n539\t\t\treturn e.inodeUsePercent\n540\t\tcase \"size\":\n541\t\t\treturn formatSize(e.blocks1K, e.sizeBytes, opts.sizeMode)\n542\t\tcase \"used\":\n543\t\t\treturn formatSize(e.used, e.usedBytes, opts.sizeMode)\n544\t\tcase \"avail\":\n545\t\t\treturn formatSize(e.available, e.availBytes, opts.sizeMode)\n546\t\tcase \"pcent\":\n547\t\t\treturn e.usePercent\n548\t\tcase \"file\":\n549\t\t\treturn e.file\n550\t\tcase \"target\":\n551\t\t\treturn e.mountedOn\n552\t\t}\n553\t\treturn \"\"\n554\t}\n555\t\n556\tfunc getOutputHeaders(fields []string, mode sizeMode) []string {\n557\t\th := make([]string, len(fields))\n558\t\tfor i, f := range fields {\n559\t\t\th[i] = outputHeader(f, mode)\n560\t\t}\n561\t\treturn h\n562\t}\n563\t\n564\tfunc getOutputAlignment(fields []string) []bool {\n565\t\ta := make([]bool, len(fields))\n566\t\tfor i, f := range fields {\n567\t\t\ta[i] = outputRightAlign(f)\n568\t\t}\n569\t\treturn a\n570\t}\n571\t\n572\tfunc getOutputValues(e fsEntry, fields []string, opts options) []string {\n573\t\tvals := make([]string, len(fields))\n574\t\tfor i, f := range fields {\n575\t\t\tvals[i] = outputValue(e, f, opts)\n576\t\t}\n577\t\treturn vals\n578\t}\n579\t\n580\tfunc computeRowWidths(headers []string, rows [][]string) []int {\n581\t\tw := make([]int, len(headers))\n582\t\tfor i, h := range headers {\n583\t\t\tw[i] = len(h)\n584\t\t}\n585\t\tfor _, row := range rows {\n586\t\t\tfor i, col := range row {\n587\t\t\t\tif len(col) > w[i] {\n588\t\t\t\t\tw[i] = len(col)\n589\t\t\t\t}\n590\t\t\t}\n591\t\t}\n592\t\treturn w\n593\t}\n594\t\n595\tfunc printOutputTable(entries []fsEntry, opts options) {\n596\t\tfields := opts.outputFields\n597\t\theaders := getOutputHeaders(fields, opts.sizeMode)\n598\t\talign := getOutputAlignment(fields)\n599\t\trows := make([][]string, len(entries))\n600\t\tfor i, e := range entries {\n601\t\t\trows[i] = getOutputValues(e, fields, opts)\n602\t\t}\n603\t\tw := computeRowWidths(headers, rows)\n604\t\tprintLine(headers, w, align)\n605\t\tfor _, row := range rows {\n606\t\t\tprintLine(row, w, align)\n607\t\t}\n608\t}\n609\t\n610\tfunc printLine(cols []string, w []int, rightAlign []bool) {\n611\t\tparts := make([]string, len(cols))\n612\t\tfor i, col := range cols {\n613\t\t\tif i == len(cols)-1 {\n614\t\t\t\tparts[i] = col\n615\t\t\t} else if rightAlign[i] {\n616\t\t\t\tparts[i] = format.PadLeft(col, w[i])\n617\t\t\t} else {\n618\t\t\t\tparts[i] = format.PadRight(col, w[i])\n619\t\t\t}\n620\t\t}\n621\t\tfmt.Println(strings.Join(parts, \" \"))\n622\t}\n623\t\n624\tfunc cstring(b []byte) string {\n625\t\tfor i, v := range b {\n626\t\t\tif v == 0 {\n627\t\t\t\treturn string(b[:i])\n628\t\t\t}\n629\t\t}\n630\t\treturn string(b)\n631\t}\n632\t"}]},"parent_tool_use_id":null,"session_id":"5c91562a-19ba-463f-8bcb-e79526653860","uuid":"932b6d94-af95-4cb3-b1ff-e7cdb85532b9","timestamp":"2026-05-27T21:29:51.295Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5617/cmd/df/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd106-df R1.1-R1.5, R2.1-R2.3, R3.1-R3.7.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"slices\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n\t\"golang.org/x/sys/unix\"\n)\n\ntype sizeMode int\n\nconst (\n\tmodeDefault sizeMode = iota\n\tmodeHuman\n\tmodeSI\n)\n\ntype options struct {\n\tsizeMode     sizeMode\n\tshowType     bool\n\tshowInodes   bool\n\tshowAll      bool\n\tlocalOnly    bool\n\tincludeTypes []string\n\texcludeTypes []string\n\toutputFields []string\n\toutputMode   bool\n}\n\ntype fsEntry struct {\n\tfilesystem      string\n\tfsType          string\n\tblocks1K        int64\n\tused            int64\n\tavailable       int64\n\tsizeBytes       int64\n\tusedBytes       int64\n\tavailBytes      int64\n\tusePercent      string\n\tinodes          int64\n\tinodesUsed      int64\n\tinodesFree      int64\n\tinodeUsePercent string\n\tmountedOn       string\n\tfile            string\n}\n\nvar humanSuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run(os.Args[1:]))\n}\n\nfunc run(args []string) int {\n\topts, files := parseArgs(args)\n\tif msg := validateOpts(opts); msg != \"\" {\n\t\tfmt.Fprintln(os.Stderr, msg)\n\t\treturn 1\n\t}\n\tif len(files) == 0 {\n\t\treturn listAll(opts)\n\t}\n\treturn listPaths(files, opts)\n}\n\nfunc validateOpts(opts options) string {\n\tif opts.outputMode && opts.showInodes {\n\t\treturn \"df: options -i and --output are mutually exclusive\\n\" +\n\t\t\t\"Try 'df --help' for more information.\"\n\t}\n\tif opts.outputMode && opts.showType {\n\t\treturn \"df: options -T and --output are mutually exclusive\\n\" +\n\t\t\t\"Try 'df --help' for more information.\"\n\t}\n\tfor _, t := range opts.includeTypes {\n\t\tif slices.Contains(opts.excludeTypes, t) {\n\t\t\treturn fmt.Sprintf(\"df: file system type '%s' both selected and excluded\", t)\n\t\t}\n\t}\n\treturn \"\"\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar files []string\n\tendOfFlags := false\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif endOfFlags {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tconsumed, skip := parseFlag(&opts, arg, args, i)\n\t\tif consumed {\n\t\t\ti += skip\n\t\t} else {\n\t\t\tfiles = append(files, arg)\n\t\t}\n\t}\n\treturn opts, files\n}\n\nfunc parseFlag(opts *options, arg string, args []string, i int) (bool, int) {\n\tswitch {\n\tcase arg == \"-h\" || arg == \"--human-readable\":\n\t\topts.sizeMode = modeHuman\n\tcase arg == \"-H\" || arg == \"--si\":\n\t\topts.sizeMode = modeSI\n\tcase arg == \"-T\" || arg == \"--print-type\":\n\t\topts.showType = true\n\tcase arg == \"-i\" || arg == \"--inodes\":\n\t\topts.showInodes = true\n\tcase arg == \"-a\" || arg == \"--all\":\n\t\topts.showAll = true\n\tcase arg == \"-l\" || arg == \"--local\":\n\t\topts.localOnly = true\n\tcase arg == \"-t\" && i+1 < len(args):\n\t\topts.includeTypes = append(opts.includeTypes, args[i+1])\n\t\treturn true, 1\n\tcase strings.HasPrefix(arg, \"--type=\"):\n\t\topts.includeTypes = append(opts.includeTypes, arg[7:])\n\tcase arg == \"-x\" && i+1 < len(args):\n\t\topts.excludeTypes = append(opts.excludeTypes, args[i+1])\n\t\treturn true, 1\n\tcase strings.HasPrefix(arg, \"--exclude-type=\"):\n\t\topts.excludeTypes = append(opts.excludeTypes, arg[15:])\n\tcase arg == \"--output\":\n\t\topts.outputMode = true\n\t\topts.outputFields = allOutputFields()\n\tcase strings.HasPrefix(arg, \"--output=\"):\n\t\topts.outputMode = true\n\t\topts.outputFields = strings.Split(arg[9:], \",\")\n\tdefault:\n\t\treturn false, 0\n\t}\n\treturn true, 0\n}\n\nfunc listAll(opts options) int {\n\tstats, err := getAllMounts()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n\t\treturn 1\n\t}\n\tentries := filterAndDedup(stats, opts)\n\tprintTable(entries, opts)\n\treturn 0\n}\n\nfunc listPaths(paths []string, opts options) int {\n\tstats, err := getAllMounts()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n\t\treturn 1\n\t}\n\tdevMap := buildDevMap(stats)\n\texitCode := 0\n\tentries := make([]fsEntry, 0, len(paths))\n\tfor _, path := range paths {\n\t\tentry, err := entryForPath(path, devMap)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"df: %s: %s\\n\", path, capitalizeErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif !matchesTypeFilter(entry.fsType, opts) {\n\t\t\tcontinue\n\t\t}\n\t\tentry.file = path\n\t\tentries = append(entries, entry)\n\t}\n\tif len(entries) > 0 {\n\t\tprintTable(entries, opts)\n\t}\n\treturn exitCode\n}\n\nfunc capitalizeErr(err error) string {\n\ts := err.Error()\n\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n\t\treturn strings.ToUpper(s[:1]) + s[1:]\n\t}\n\treturn s\n}\n\nfunc getAllMounts() ([]unix.Statfs_t, error) {\n\tn, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tbuf := make([]unix.Statfs_t, n)\n\tn, err = unix.Getfsstat(buf, unix.MNT_NOWAIT)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn buf[:n], nil\n}\n\nfunc isDummyType(t string) bool {\n\treturn t == \"devfs\" || t == \"autofs\"\n}\n\nfunc matchesTypeFilter(fsType string, opts options) bool {\n\tif len(opts.includeTypes) > 0 && !slices.Contains(opts.includeTypes, fsType) {\n\t\treturn false\n\t}\n\treturn !slices.Contains(opts.excludeTypes, fsType)\n}\n\nfunc filterAndDedup(stats []unix.Statfs_t, opts options) []fsEntry {\n\tseen := make(map[int32]bool)\n\tentries := make([]fsEntry, 0, len(stats))\n\tfor _, s := range stats {\n\t\tfsType := cstring(s.Fstypename[:])\n\t\tif !opts.showAll {\n\t\t\tif isDummyType(fsType) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif s.Blocks == 0 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif opts.localOnly && s.Flags&unix.MNT_LOCAL == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tif !matchesTypeFilter(fsType, opts) {\n\t\t\tcontinue\n\t\t}\n\t\tdev, ok := mountDev(cstring(s.Mntonname[:]))\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[dev] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[dev] = true\n\t\tentry := buildEntry(s)\n\t\tentry.file = \"-\"\n\t\tentries = append(entries, entry)\n\t}\n\treturn entries\n}\n\nfunc buildDevMap(stats []unix.Statfs_t) map[int32]string {\n\tm := make(map[int32]string, len(stats))\n\tfor _, s := range stats {\n\t\tmount := cstring(s.Mntonname[:])\n\t\tdev, ok := mountDev(mount)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif _, exists := m[dev]; !exists {\n\t\t\tm[dev] = mount\n\t\t}\n\t}\n\treturn m\n}\n\nfunc entryForPath(path string, devMap map[int32]string) (fsEntry, error) {\n\tvar info syscall.Stat_t\n\tif err := syscall.Stat(path, &info); err != nil {\n\t\treturn fsEntry{}, err\n\t}\n\ttarget := path\n\tif mount, ok := devMap[info.Dev]; ok {\n\t\ttarget = mount\n\t}\n\tvar stat unix.Statfs_t\n\tif err := unix.Statfs(target, &stat); err != nil {\n\t\treturn fsEntry{}, err\n\t}\n\treturn buildEntry(stat), nil\n}\n\nfunc mountDev(mount string) (int32, bool) {\n\tvar info syscall.Stat_t\n\tif err := syscall.Stat(mount, &info); err != nil {\n\t\treturn 0, false\n\t}\n\treturn info.Dev, true\n}\n\nfunc buildEntry(stat unix.Statfs_t) fsEntry {\n\tbsize := uint64(stat.Bsize)\n\ttotalBytes := int64(stat.Blocks * bsize)\n\tfreeBytes := int64(stat.Bfree * bsize)\n\tavailBytes := int64(stat.Bavail * bsize)\n\ttotal := totalBytes / 1024\n\tfree := freeBytes / 1024\n\tavail := availBytes / 1024\n\tinodes := int64(stat.Files)\n\tinodesFree := int64(stat.Ffree)\n\treturn fsEntry{\n\t\tfilesystem:      cstring(stat.Mntfromname[:]),\n\t\tfsType:          cstring(stat.Fstypename[:]),\n\t\tblocks1K:        total,\n\t\tused:            total - free,\n\t\tavailable:       avail,\n\t\tsizeBytes:       totalBytes,\n\t\tusedBytes:       totalBytes - freeBytes,\n\t\tavailBytes:      availBytes,\n\t\tusePercent:      computeUsePercent(total, avail),\n\t\tinodes:          inodes,\n\t\tinodesUsed:      inodes - inodesFree,\n\t\tinodesFree:      inodesFree,\n\t\tinodeUsePercent: computeUsePercent(inodes, inodesFree),\n\t\tmountedOn:       cstring(stat.Mntonname[:]),\n\t}\n}\n\nfunc computeUsePercent(total, avail int64) string {\n\tif total == 0 {\n\t\treturn \"-\"\n\t}\n\tused := total - avail\n\tif used <= 0 {\n\t\treturn \"0%\"\n\t}\n\tpct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n\treturn strconv.FormatInt(pct, 10) + \"%\"\n}\n\nfunc humanSize(bytes int64, base float64) string {\n\tif bytes == 0 {\n\t\treturn \"0\"\n\t}\n\tval := float64(bytes)\n\tidx := 0\n\tfor idx < len(humanSuffixes)-1 && val >= base {\n\t\tval /= base\n\t\tidx++\n\t}\n\treturn formatHuman(val, humanSuffixes[idx])\n}\n\nfunc formatHuman(val float64, suffix string) string {\n\tif suffix == \"\" {\n\t\treturn strconv.FormatInt(int64(math.Ceil(val)), 10)\n\t}\n\tceiled := math.Ceil(val*10) / 10\n\tif ceiled < 10 {\n\t\treturn fmt.Sprintf(\"%.1f%s\", ceiled, suffix)\n\t}\n\treturn fmt.Sprintf(\"%d%s\", int64(math.Ceil(val)), suffix)\n}\n\nfunc formatSize(blocks1K, sizeBytes int64, mode sizeMode) string {\n\tswitch mode {\n\tcase modeHuman:\n\t\treturn humanSize(sizeBytes, 1024)\n\tcase modeSI:\n\t\treturn humanSize(sizeBytes, 1000)\n\tdefault:\n\t\treturn strconv.FormatInt(blocks1K, 10)\n\t}\n}\n\nfunc formatInodeField(count int64, mode sizeMode) string {\n\tswitch mode {\n\tcase modeHuman:\n\t\treturn humanSize(count, 1024)\n\tcase modeSI:\n\t\treturn humanSize(count, 1000)\n\tdefault:\n\t\treturn strconv.FormatInt(count, 10)\n\t}\n}\n\nfunc getHeaders(opts options) []string {\n\tvar h []string\n\th = append(h, \"Filesystem\")\n\tif opts.showType {\n\t\th = append(h, \"Type\")\n\t}\n\tif opts.showInodes {\n\t\th = append(h, \"Inodes\", \"IUsed\", \"IFree\", \"IUse%\")\n\t} else if opts.sizeMode != modeDefault {\n\t\th = append(h, \"Size\", \"Used\", \"Avail\", \"Use%\")\n\t} else {\n\t\th = append(h, \"1K-blocks\", \"Used\", \"Available\", \"Use%\")\n\t}\n\th = append(h, \"Mounted on\")\n\treturn h\n}\n\nfunc getAlignment(opts options) []bool {\n\tvar a []bool\n\ta = append(a, false)\n\tif opts.showType {\n\t\ta = append(a, false)\n\t}\n\ta = append(a, true, true, true, true)\n\ta = append(a, false)\n\treturn a\n}\n\nfunc entryStrings(e fsEntry, opts options) []string {\n\tvar cols []string\n\tcols = append(cols, e.filesystem)\n\tif opts.showType {\n\t\tcols = append(cols, e.fsType)\n\t}\n\tif opts.showInodes {\n\t\tcols = append(cols,\n\t\t\tstrconv.FormatInt(e.inodes, 10),\n\t\t\tstrconv.FormatInt(e.inodesUsed, 10),\n\t\t\tstrconv.FormatInt(e.inodesFree, 10),\n\t\t\te.inodeUsePercent,\n\t\t)\n\t} else {\n\t\tcols = append(cols,\n\t\t\tformatSize(e.blocks1K, e.sizeBytes, opts.sizeMode),\n\t\t\tformatSize(e.used, e.usedBytes, opts.sizeMode),\n\t\t\tformatSize(e.available, e.availBytes, opts.sizeMode),\n\t\t\te.usePercent,\n\t\t)\n\t}\n\tcols = append(cols, e.mountedOn)\n\treturn cols\n}\n\nfunc computeWidths(entries []fsEntry, opts options) []int {\n\th := getHeaders(opts)\n\tw := make([]int, len(h))\n\tfor i, s := range h {\n\t\tw[i] = len(s)\n\t}\n\tfor _, e := range entries {\n\t\tcols := entryStrings(e, opts)\n\t\tfor i := range w {\n\t\t\tif len(cols[i]) > w[i] {\n\t\t\t\tw[i] = len(cols[i])\n\t\t\t}\n\t\t}\n\t}\n\tstart := 1\n\tif opts.showType {\n\t\tstart = 2\n\t}\n\tfor i := start; i < start+3 && i < len(w); i++ {\n\t\tif w[i] < 5 {\n\t\t\tw[i] = 5\n\t\t}\n\t}\n\treturn w\n}\n\nfunc printTable(entries []fsEntry, opts options) {\n\tif opts.outputMode {\n\t\tprintOutputTable(entries, opts)\n\t\treturn\n\t}\n\tw := computeWidths(entries, opts)\n\talign := getAlignment(opts)\n\tprintLine(getHeaders(opts), w, align)\n\tfor _, e := range entries {\n\t\tprintLine(entryStrings(e, opts), w, align)\n\t}\n}\n\nfunc allOutputFields() []string {\n\treturn []string{\n\t\t\"source\", \"fstype\", \"itotal\", \"iused\", \"iavail\", \"ipcent\",\n\t\t\"size\", \"used\", \"avail\", \"pcent\", \"file\", \"target\",\n\t}\n}\n\nfunc outputHeader(field string, mode sizeMode) string {\n\tswitch field {\n\tcase \"source\":\n\t\treturn \"Filesystem\"\n\tcase \"fstype\":\n\t\treturn \"Type\"\n\tcase \"itotal\":\n\t\treturn \"Inodes\"\n\tcase \"iused\":\n\t\treturn \"IUsed\"\n\tcase \"iavail\":\n\t\treturn \"IFree\"\n\tcase \"ipcent\":\n\t\treturn \"IUse%\"\n\tcase \"size\":\n\t\tif mode != modeDefault {\n\t\t\treturn \"Size\"\n\t\t}\n\t\treturn \"1K-blocks\"\n\tcase \"used\":\n\t\treturn \"Used\"\n\tcase \"avail\":\n\t\treturn \"Avail\"\n\tcase \"pcent\":\n\t\treturn \"Use%\"\n\tcase \"file\":\n\t\treturn \"File\"\n\tcase \"target\":\n\t\treturn \"Mounted on\"\n\t}\n\treturn field\n}\n\nfunc outputRightAlign(field string) bool {\n\tswitch field {\n\tcase \"source\", \"fstype\", \"file\", \"target\":\n\t\treturn false\n\tdefault:\n\t\treturn true\n\t}\n}\n\nfunc outputValue(e fsEntry, field string, opts options) string {\n\tswitch field {\n\tcase \"source\":\n\t\treturn e.filesystem\n\tcase \"fstype\":\n\t\treturn e.fsType\n\tcase \"itotal\":\n\t\treturn formatInodeField(e.inodes, opts.sizeMode)\n\tcase \"iused\":\n\t\treturn formatInodeField(e.inodesUsed, opts.sizeMode)\n\tcase \"iavail\":\n\t\treturn formatInodeField(e.inodesFree, opts.sizeMode)\n\tcase \"ipcent\":\n\t\treturn e.inodeUsePercent\n\tcase \"size\":\n\t\treturn formatSize(e.blocks1K, e.sizeBytes, opts.sizeMode)\n\tcase \"used\":\n\t\treturn formatSize(e.used, e.usedBytes, opts.sizeMode)\n\tcase \"avail\":\n\t\treturn formatSize(e.available, e.availBytes, opts.sizeMode)\n\tcase \"pcent\":\n\t\treturn e.usePercent\n\tcase \"file\":\n\t\treturn e.file\n\tcase \"target\":\n\t\treturn e.mountedOn\n\t}\n\treturn \"\"\n}\n\nfunc getOutputHeaders(fields []string, mode sizeMode) []string {\n\th := make([]string, len(fields))\n\tfor i, f := range fields {\n\t\th[i] = outputHeader(f, mode)\n\t}\n\treturn h\n}\n\nfunc getOutputAlignment(fields []string) []bool {\n\ta := make([]bool, len(fields))\n\tfor i, f := range fields {\n\t\ta[i] = outputRightAlign(f)\n\t}\n\treturn a\n}\n\nfunc getOutputValues(e fsEntry, fields []string, opts options) []string {\n\tvals := make([]string, len(fields))\n\tfor i, f := range fields {\n\t\tvals[i] = outputValue(e, f, opts)\n\t}\n\treturn vals\n}\n\nfunc computeRowWidths(headers []string, rows [][]string) []int {\n\tw := make([]int, len(headers))\n\tfor i, h := range headers {\n\t\tw[i] = len(h)\n\t}\n\tfor _, row := range rows {\n\t\tfor i, col := range row {\n\t\t\tif len(col) > w[i] {\n\t\t\t\tw[i] = len(col)\n\t\t\t}\n\t\t}\n\t}\n\treturn w\n}\n\nfunc printOutputTable(entries []fsEntry, opts options) {\n\tfields := opts.outputFields\n\theaders := getOutputHeaders(fields, opts.sizeMode)\n\talign := getOutputAlignment(fields)\n\trows := make([][]string, len(entries))\n\tfor i, e := range entries {\n\t\trows[i] = getOutputValues(e, fields, opts)\n\t}\n\tw := computeRowWidths(headers, rows)\n\tprintLine(headers, w, align)\n\tfor _, row := range rows {\n\t\tprintLine(row, w, align)\n\t}\n}\n\nfunc printLine(cols []string, w []int, rightAlign []bool) {\n\tparts := make([]string, len(cols))\n\tfor i, col := range cols {\n\t\tif i == len(cols)-1 {\n\t\t\tparts[i] = col\n\t\t} else if rightAlign[i] {\n\t\t\tparts[i] = format.PadLeft(col, w[i])\n\t\t} else {\n\t\t\tparts[i] = format.PadRight(col, w[i])\n\t\t}\n\t}\n\tfmt.Println(strings.Join(parts, \" \"))\n}\n\nfunc cstring(b []byte) string {\n\tfor i, v := range b {\n\t\tif v == 0 {\n\t\t\treturn string(b[:i])\n\t\t}\n\t}\n\treturn string(b)\n}\n","numLines":632,"startLine":1,"totalLines":632}}}
