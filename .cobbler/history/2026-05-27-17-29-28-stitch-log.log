{Name: \"type-human\", Args: []string{\"-T\", \"-h\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n86\t\t\t// R3.2: inode display\n87\t\t\t{Name: \"inodes\", Args: []string{\"-i\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n88\t\t\t// R3.2: long flag form\n89\t\t\t{Name: \"inodes-long\", Args: []string{\"--inodes\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n90\t\t\t// R3.2+R3.1: inode display with type column\n91\t\t\t{Name: \"inodes-type\", Args: []string{\"-i\", \"-T\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n92\t\t\t// R3.3: include pseudo-filesystems with file argument\n93\t\t\t{Name: \"all-with-file\", Args: []string{\"-a\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n94\t\t\t// R3.4: local filesystems only\n95\t\t\t{Name: \"local-only\", Args: []string{\"-l\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n96\t\t\t// R3.4: long flag form\n97\t\t\t{Name: \"local-only-long\", Args: []string{\"--local\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n98\t\t\t// R3.4: local with type display\n99\t\t\t{Name: \"local-type\", Args: []string{\"-l\", \"-T\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n100\t\t\t// R3.5: include only apfs filesystems\n101\t\t\t{Name: \"type-filter\", Args: []string{\"-t\", \"apfs\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n102\t\t\t// R3.5: long flag form\n103\t\t\t{Name: \"type-filter-long\", Args: []string{\"--type=apfs\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n104\t\t\t// R3.6: exclude devfs filesystems\n105\t\t\t{Name: \"exclude-type\", Args: []string{\"-x\", \"devfs\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n106\t\t\t// R3.6: long flag form\n107\t\t\t{Name: \"exclude-type-long\", Args: []string{\"--exclude-type=devfs\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n108\t\t\t// R3.5+R3.6: same type both selected and excluded is an error\n109\t\t\t{\n110\t\t\t\tName:      \"type-include-exclude\",\n111\t\t\t\tArgs:      []string{\"-t\", \"apfs\", \"-x\", \"apfs\", \"/\"},\n112\t\t\t\tExitCode:  1,\n113\t\t\t\tEnv:       []string{\"LC_ALL=C\"},\n114\t\t\t\tNormalize: errNorm,\n115\t\t\t},\n116\t\t\t// R3.5: type filter with type display\n117\t\t\t{Name: \"type-filter-display\", Args: []string{\"-t\", \"apfs\", \"-T\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n118\t\t\t// R3.7: output column selection\n119\t\t\t{Name: \"output-columns\", Args: []string{\"--output=source,size,used,avail,pcent,target\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n120\t\t\t// R3.7: bare --output (all fields)\n121\t\t\t{Name: \"output-all\", Args: []string{\"--output\", \"/\"}, Env: []string{\"LC_ALL=C\"}},\n122\t\t\t// R3.7: --output incompatible with -i\n123\t\t\t{\n124\t\t\t\tName:      \"output-inodes-exclusive\",\n125\t\t\t\tArgs:      []string{\"--output\", \"-i\", \"/\"},\n126\t\t\t\tExitCode:  1,\n127\t\t\t\tEnv:       []string{\"LC_ALL=C\"},\n128\t\t\t\tNormalize: exclusiveNorm,\n129\t\t\t},\n130\t\t\t// R3.7: --output incompatible with -T\n131\t\t\t{\n132\t\t\t\tName:      \"output-type-exclusive\",\n133\t\t\t\tArgs:      []string{\"--output\", \"-T\", \"/\"},\n134\t\t\t\tExitCode:  1,\n135\t\t\t\tEnv:       []string{\"LC_ALL=C\"},\n136\t\t\t\tNormalize: exclusiveNorm,\n137\t\t\t},\n138\t\t}\n139\t\n140\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n141\t}\n142\t\n143\t// R4.3: SIGPIPE handler exits cleanly when stdout consumer closes early.\n144\tfunc TestSIGPIPE(t *testing.T) {\n145\t\tgoBin := testutils.BuildBinary(t, \".\")\n146\t\n147\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n148\t\tdefer cancel()\n149\t\tcmd := exec.CommandContext(ctx, goBin, \"-a\")\n150\t\tstdout, err := cmd.StdoutPipe()\n151\t\tif err != nil {\n152\t\t\tt.Fatal(err)\n153\t\t}\n154\t\tif err := cmd.Start(); err != nil {\n155\t\t\tt.Fatal(err)\n156\t\t}\n157\t\tbuf := make([]byte, 1)\n158\t\tif _, err := io.ReadFull(stdout, buf); err != nil {\n159\t\t\tt.Fatal(err)\n160\t\t}\n161\t\tstdout.Close()\n162\t\terr = cmd.Wait()\n163\t\tif ctx.Err() == context.DeadlineExceeded {\n164\t\t\tt.Fatal(\"df timed out; SIGPIPE handler may not be installed\")\n165\t\t