,\n55\t\t\t\tQuiet:  opts.quiet,\n56\t\t\t\tStatus: opts.status,\n57\t\t\t}\n58\t\t\texitCode := 0\n59\t\t\tfor _, f := range files {\n60\t\t\t\tok, err := hashutil.VerifyChecksums(f, cfg, checkOpts, stdout, os.Stderr)\n61\t\t\t\tif err != nil {\n62\t\t\t\t\tfmt.Fprintf(os.Stderr, \"sha256sum: %s\\n\", err)\n63\t\t\t\t\texitCode = 1\n64\t\t\t\t} else if !ok {\n65\t\t\t\t\texitCode = 1\n66\t\t\t\t}\n67\t\t\t}\n68\t\t\tos.Exit(exitCode)\n69\t\t}\n70\t\tos.Exit(hashutil.DigestFiles(files, cfg, opts.binary, opts.tag, stdout, os.Stderr))\n71\t}\n72\t\n73\ttype nulWriter struct {\n74\t\tw io.Writer\n75\t}\n76\t\n77\tfunc (n *nulWriter) Write(p []byte) (int, error) {\n78\t\treplaced := bytes.ReplaceAll(p, []byte{'\\n'}, []byte{0})\n79\t\tnn, err := n.w.Write(replaced)\n80\t\tif nn > len(p) {\n81\t\t\tnn = len(p)\n82\t\t}\n83\t\treturn nn, err\n84\t}\n85\t\n86\ttype options struct {\n87\t\tbinary bool\n88\t\ttag    bool\n89\t\tcheck  bool\n90\t\twarn   bool\n91\t\tquiet  bool\n92\t\tstatus bool\n93\t\tzero   bool\n94\t}\n95\t\n96\tfunc parseArgs(args []string) (options, []string) {\n97\t\tvar opts options\n98\t\tvar files []string\n99\t\ti := 0\n100\t\tfor i < len(args) {\n101\t\t\targ := args[i]\n102\t\t\tif arg == \"--\" {\n103\t\t\t\tfiles = append(files, args[i+1:]...)\n104\t\t\t\tbreak\n105\t\t\t}\n106\t\t\tif handled, advance := parseLongFlag(arg, &opts); handled {\n107\t\t\t\ti += advance\n108\t\t\t\tcontinue\n109\t\t\t}\n110\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n111\t\t\t\tfiles = append(files, arg)\n112\t\t\t\ti++\n113\t\t\t\tcontinue\n114\t\t\t}\n115\t\t\ti += parseShortFlags(arg[1:], &opts)\n116\t\t}\n117\t\treturn opts, files\n118\t}\n119\t\n120\tfunc parseLongFlag(arg string, opts *options) (bool, int) {\n121\t\tif !strings.HasPrefix(arg, \"--\") {\n122\t\t\treturn false, 0\n123\t\t}\n124\t\tswitch arg {\n125\t\tcase \"--help\":\n126\t\t\tfmt.Fprint(os.Stdout, helpText)\n127\t\t\tos.Exit(0)\n128\t\t\treturn true, 1\n129\t\tcase \"--version\"