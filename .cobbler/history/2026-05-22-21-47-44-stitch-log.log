{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UM5JhpcdAbSe6RteoRFbyV","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"os\"\n10\t\n11\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n12\t)\n13\t\n14\tvar crcTable [256]uint32\n15\t\n16\tfunc init() {\n17\t\tconst poly = 0x04C11DB7\n18\t\tfor i := range 256 {\n19\t\t\tc := uint32(i) << 24\n20\t\t\tfor range 8 {\n21\t\t\t\tif c&0x80000000 != 0 {\n22\t\t\t\t\tc = (c << 1) ^ poly\n23\t\t\t\t} else {\n24\t\t\t\t\tc <<= 1\n25\t\t\t\t}\n26\t\t\t}\n27\t\t\tcrcTable[i] = c\n28\t\t}\n29\t}\n30\t\n31\tfunc main() {\n32\t\tsys.InstallSIGPIPEHandler()\n33\t\tfiles := os.Args[1:]\n34\t\texitCode := 0\n35\t\tif len(files) == 0 {\n36\t\t\tif err := processStdin(os.Stdout); err != nil {\n37\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n38\t\t\t\texitCode = 1\n39\t\t\t}\n40\t\t} else {\n41\t\t\tfor _, file := range files {\n42\t\t\t\tif err := processFile(file, os.Stdout); err != nil {\n43\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n44\t\t\t\t\texitCode = 1\n45\t\t\t\t}\n46\t\t\t}\n47\t\t}\n48\t\tos.Exit(exitCode)\n49\t}\n50\t\n51\tfunc processStdin(stdout io.Writer) error {\n52\t\tcrc, size, err := computeCRC(os.Stdin)\n53\t\tif err != nil {\n54\t\t\treturn err\n55\t\t}\n56\t\tfmt.Fprintf(stdout, \"%d %d\\n\", crc, size)\n57\t\treturn nil\n58\t}\n59\t\n60\tfunc processFile(file string, stdout io.Writer) error {\n61\t\tr, err := openInput(file)\n62\t\tif err != nil {\n63\t\t\treturn err\n64\t\t}\n65\t\tdefer r.Close()\n66\t\tcrc, size, err := computeCRC(r)\n67\t\tif err != nil {\n68\t\t\treturn err\n69\t\t}\n70\t\tfmt.Fprintf(stdout, \"%d %d %s\\n\", crc, size, file)\n71\t\treturn nil\n72\t}\n73\t\n74\tfunc computeCRC(r io.Reader) (uint32, int64, error) {\n75\t\tvar crc uint32\n76\t\tvar size int64\n77\t\tbuf := make([]byte, 32*10