e flag == \"--format\":\n130\t\t\tif len(remaining) < 2 {\n131\t\t\t\treturn 0, fmt.Errorf(\"option '--format' requires an argument\")\n132\t\t\t}\n133\t\t\topts.format = remaining[1]\n134\t\t\treturn 2, nil\n135\t\tcase strings.HasPrefix(flag, \"--format=\"):\n136\t\t\topts.format = flag[len(\"--format=\"):]\n137\t\t\treturn 1, nil\n138\t\tcase flag == \"--separator\":\n139\t\t\tif len(remaining) < 2 {\n140\t\t\t\treturn 0, fmt.Errorf(\"option '--separator' requires an argument\")\n141\t\t\t}\n142\t\t\topts.separator = remaining[1]\n143\t\t\treturn 2, nil\n144\t\tcase strings.HasPrefix(flag, \"--separator=\"):\n145\t\t\topts.separator = flag[len(\"--separator=\"):]\n146\t\t\treturn 1, nil\n147\t\tcase flag == \"--equal-width\":\n148\t\t\topts.equalWidth = true\n149\t\t\treturn 1, nil\n150\t\tdefault:\n151\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n152\t\t}\n153\t}\n154\t\n155\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n156\t\tconsumed := 0\n157\t\tfor j := 0; j < len(flags); j++ {\n158\t\t\tswitch flags[j] {\n159\t\t\tcase 'f':\n160\t\t\t\tvar val string\n161\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n162\t\t\t\t\tval = rest\n163\t\t\t\t} else if len(remaining) > consumed {\n164\t\t\t\t\tval = remaining[consumed]\n165\t\t\t\t\tconsumed++\n166\t\t\t\t} else {\n167\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'f'\")\n168\t\t\t\t}\n169\t\t\t\topts.format = val\n170\t\t\t\treturn consumed, nil\n171\t\t\tcase 's':\n172\t\t\t\tvar val string\n173\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n174\t\t\t\t\tval = rest\n175\t\t\t\t} else if len(remaining) > consumed {\n176\t\t\t\t\tval = remaining[consumed]\n177\t\t\t\t\tconsumed++\n178\t\t\t\t} else {\n179\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n180\t\t\t\t}\n181\t\t\t\topts.separator = val\n182\t\t\t\treturn consumed, nil\n183\t\t\tcase 'w':\n184\t\t\t\topts.equalWidth = true\n185\t\t\tdefault:\n186\t\t\t\tr