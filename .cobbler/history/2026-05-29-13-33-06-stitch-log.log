rocessFile(f, opts, state, w); err != nil {\n79\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n80\t\t\t\t\tos.Exit(0)\n81\t\t\t\t}\n82\t\t\t\tfmt.Fprintf(os.Stderr, \"nl: %s\\n\", err)\n83\t\t\t\texitCode = 1\n84\t\t\t}\n85\t\t}\n86\t\tif err := w.Flush(); err != nil {\n87\t\t\tif errors.Is(err, syscall.EPIPE) {\n88\t\t\t\tos.Exit(0)\n89\t\t\t}\n90\t\t\tfmt.Fprintf(os.Stderr, \"nl: %s\\n\", err)\n91\t\t\texitCode = 1\n92\t\t}\n93\t\treturn exitCode\n94\t}\n95\t\n96\tfunc parseArgs(args []string) (options, []string, error) {\n97\t\topts := defaultOptions()\n98\t\tvar files []string\n99\t\ti := 0\n100\t\tfor i < len(args) {\n101\t\t\targ := args[i]\n102\t\t\tif arg == \"--\" {\n103\t\t\t\tfiles = append(files, args[i+1:]...)\n104\t\t\t\tbreak\n105\t\t\t}\n106\t\t\tif arg == \"-\" {\n107\t\t\t\tfiles = append(files, arg)\n108\t\t\t\ti++\n109\t\t\t\tcontinue\n110\t\t\t}\n111\t\t\tif len(arg) > 1 && arg[0] == '-' {\n112\t\t\t\tconsumed, err := parseFlag(arg, args[i+1:], &opts)\n113\t\t\t\tif err != nil {\n114\t\t\t\t\treturn opts, nil, err\n115\t\t\t\t}\n116\t\t\t\ti += 1 + consumed\n117\t\t\t\tcontinue\n118\t\t\t}\n119\t\t\tfiles = append(files, arg)\n120\t\t\ti++\n121\t\t}\n122\t\treturn opts, files, nil\n123\t}\n124\t\n125\tfunc parseFlag(arg string, remaining []string, opts *options) (int, error) {\n126\t\tflag := arg[1:]\n127\t\tswitch {\n128\t\tcase flag == \"p\":\n129\t\t\topts.noReset = true\n130\t\t\treturn 0, nil\n131\t\tcase strings.HasPrefix(flag, \"b\"):\n132\t\t\treturn setStyle(flag[1:], remaining, &opts.bodyStyle, 'b')\n133\t\tcase strings.HasPrefix(flag, \"h\"):\n134\t\t\treturn setStyle(flag[1:], remaining, &opts.headerStyle, 'h')\n135\t\tcase strings.HasPrefix(flag, \"f\"):\n136\t\t\treturn setStyle(flag[1:], remaining, &opts.footerStyle, 'f')\n137\t\tcase strings.HasPrefix(flag, \"n\"):\n138\t\t\treturn setStringOpt(flag[1:], remaining, &opts.numberFormat, 'n')\n139\t\tcase strings.HasPrefix(flag, \"s\"):\n140\t\t\treturn setStringOpt(flag[1:], remaining,