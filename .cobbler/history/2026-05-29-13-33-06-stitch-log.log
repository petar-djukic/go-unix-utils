\t\t}\n197\t\treturn 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n198\t}\n199\t\n200\tfunc processFile(path string, opts options, state *nlState, w *bufio.Writer) error {\n201\t\tvar r io.Reader\n202\t\tif path == \"-\" {\n203\t\t\tr = os.Stdin\n204\t\t} else {\n205\t\t\tf, err := os.Open(path)\n206\t\t\tif err != nil {\n207\t\t\t\treturn err\n208\t\t\t}\n209\t\t\tdefer f.Close()\n210\t\t\tr = f\n211\t\t}\n212\t\treturn processInput(r, opts, state, w)\n213\t}\n214\t\n215\tfunc sectionStyle(section string, opts options) string {\n216\t\tswitch section {\n217\t\tcase \"header\":\n218\t\t\treturn opts.headerStyle\n219\t\tcase \"footer\":\n220\t\t\treturn opts.footerStyle\n221\t\tdefault:\n222\t\t\treturn opts.bodyStyle\n223\t\t}\n224\t}\n225\t\n226\tfunc shouldNumber(style string, line string, blankCount int, joinBlankCount int) bool {\n227\t\tempty := line == \"\"\n228\t\tswitch {\n229\t\tcase style == \"a\":\n230\t\t\tif !empty {\n231\t\t\t\treturn true\n232\t\t\t}\n233\t\t\treturn blankCount >= joinBlankCount\n234\t\tcase style == \"t\":\n235\t\t\treturn !empty\n236\t\tcase style == \"n\":\n237\t\t\treturn false\n238\t\tcase strings.HasPrefix(style, \"p\"):\n239\t\t\tif empty {\n240\t\t\t\treturn false\n241\t\t\t}\n242\t\t\tre, err := regexp.Compile(style[1:])\n243\t\t\tif err != nil {\n244\t\t\t\treturn false\n245\t\t\t}\n246\t\t\treturn re.MatchString(line)\n247\t\t}\n248\t\treturn false\n249\t}\n250\t\n251\tfunc formatNumber(num int, width int, format string) string {\n252\t\tswitch format {\n253\t\tcase \"ln\":\n254\t\t\treturn fmt.Sprintf(\"%-*d\", width, num)\n255\t\tcase \"rz\":\n256\t\t\treturn fmt.Sprintf(\"%0*d\", width, num)\n257\t\tdefault:\n258\t\t\treturn fmt.Sprintf(\"%*d\", width, num)\n259\t\t}\n260\t}\n261\t\n262\tfunc processInput(r io.Reader, opts options, state *nlState, w *bufio.Writer) error {\n263\t\tscanner := bufio.NewScanner(r)\n264\t\n265\t\theaderDelim := opts.delimiter + opts.delimiter + opts.delimiter\n266\t\tbodyDelim := opts.delimiter + opts.delimiter\n267\t\tfooterDelim := opts.delimiter\n268\t\n269\t\tfor scanner.Scan() {\n270\t\t\tline := scanner.Text()\n271\t\n272\t\t\tif line == headerDelim {\n273\t\t\t\tstate.section = \"header\"\n274\t\t\t\tif !opts.noReset {\n275\t\t\t\t\tstate.lineNum = opts.startNum\n276\t\t\t\t}\n277\t\t\t\tstate.blankCount = 0\n278\t\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n279\t\t\t\t\treturn err\n280\t\t\t\t}\n281\t\t\t\tcontinue\n282\t\t\t}\n283\t\t\tif line == bodyDelim {\n284\t\t\t\tstate.section = \"body\"\n285\t\t\t\tif !opts.noReset {\n286\t\t\t\t\tstate.lineNum = opts.startNum\n287\t\t\t\t}\n288\t\t\t\tstate.blankCount = 0\n289\t\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n290\t\t\t\t\treturn err\n291\t\t\t\t}\n292\t\t\t\tcontinue\n293\t\t\t}\n294\t\t\tif line == footerDelim {\n295\t\t\t\tstate.section = \"footer\"\n296\t\t\t\tif !opts.noReset {\n297\t\t\t\t\tstate.lineNum = opts.startNum\n298\t\t\t\t}\n299\t\t\t\tstate.blankCount = 0\n300\t\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n301\t\t\t\t\treturn err\n302\t\t\t\t}\n303\t\t\t\tcontinue\n304\t\t\t}\n305\t\n306\t\t\tstyle := sectionStyle(state.section, opts)\n307\t\n308\t\t\tif line == \"\" {\n309\t\t\t\tstate.blankCount++\n310\t\t\t} else {\n311\t\t\t\tstate.blankCount = 0\n312\t\t\t}\n313\t\n314\t\t\tif shouldNumber(style, line, state.blankCount, opts.joinBlankCount) {\n315\t\t\t\tnumStr := formatNumber(state.lineNum, opts.width, opts.numberFormat)\n316\t\t\t\tif _, err := fmt.Fprintf(w, \"%s%s%s\\n\", numStr, opts.separator, line); err != nil {\n317\t\t\t\t\treturn err\n318\t\t\t\t}\n319\t\t\t\tstate.lineNum += opts.increment\n320\t\t\t\tif line == \"\" {\n321\t\t\t\t\tstate.blankCount = 0\n322\t\t\t\t}\n323\t\t\t} else {\n324\t\t\t\tpad := strings.Repeat(\" \", opts.width+len(opts.separator))\n325\t\t\t\tif _, err := fmt.Fprintf(w, \"%s%s\\n\", pad, line); err != nil {\n326\t\t\t\t\treturn err\n327\t\t\t\t}\n328\t\t\t}\n329\t\t}\n330\t\n331\t\