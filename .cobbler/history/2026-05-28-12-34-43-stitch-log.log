{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JKtgWA7JasNwmcJJT61BbK","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"context\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"os/exec\"\n13\t\t\"path/filepath\"\n14\t\t\"regexp\"\n15\t\t\"strings\"\n16\t\t\"testing\"\n17\t\t\"time\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n20\t)\n21\t\n22\tvar stderrNorm = regexp.MustCompile(`^g?tsort:`)\n23\t\n24\tfunc normStderr(b []byte) []byte {\n25\t\tvar out []byte\n26\t\tfor line := range bytes.SplitSeq(b, []byte(\"\\n\")) {\n27\t\t\tif len(out) > 0 {\n28\t\t\t\tout = append(out, '\\n')\n29\t\t\t}\n30\t\t\tout = append(out, stderrNorm.ReplaceAll(line, []byte(\"PROG:\"))...)\n31\t\t}\n32\t\treturn out\n33\t}\n34\t\n35\tfunc TestDiff(t *testing.T) {\n36\t\tif _, err := os.Stat(filepath.Join(\".\", \"main.go\")); os.IsNotExist(err) {\n37\t\t\tt.Skip(\"cmd/tsort not yet generated\")\n38\t\t}\n39\t\tgoBin := testutils.BuildBinary(t, \".\")\n40\t\trefBin, err := exec.LookPath(\"gtsort\")\n41\t\tif err != nil {\n42\t\t\tt.Skip(\"reference binary not found\")\n43\t\t}\n44\t\n45\t\tdir := t.TempDir()\n46\t\twriteFile(t, dir, \"simple_pairs.txt\", \"a b b c\\n\")\n47\t\twriteFile(t, dir, \"cycle.txt\", \"a b b a\\n\")\n48\t\twriteFile(t, dir, \"multiline.txt\", \"a b\\nb c\\nc d\\n\")\n49\t\twriteFile(t, dir, \"diamond.txt\", \"a b a c b d c d\\n\")\n50\t\twriteFile(t, dir, \"lone_nodes.txt\", \"a a\\nb b\\n\")\n51\t\twriteFile(t, dir, \"empty.txt\", \"\")\n52\t\twriteFile(t, dir, \"odd_tokens.txt\", \"a b c\\n\")\n53\t\twriteFile(t, dir, \"complex_cycle.txt\", \"a b b c c a d e\\n\")\n54\t\n55\t\tenv := []string{\"LC_ALL=C\"}\n56\t\n57\t\ttests := []testutils.DiffTest{\n58\t\t\t// R1.1, R2.1: basic topological sorting from stdin\n59\t\t\t{\n60\t\t\t\tName:  \"r1_1_basic_pair\",\n61\t\t\t\tStdin: []byte(\"a b\\n\"),\n62\t\t\t\tEnv:   env,\n63\t\t\t},\n64\t\t\t{\n65\t\t\t\tName:  \"r1_1_chain\",\n66\t\t\t\tStdin: []byte(\"a b b c\\n\"),\n67\t\t\t\tEnv:   env,\n68\t\t\t},\n69\t\t\t{\n70\t\t\t\tName:  \"r1_1_diamond\",\n71\t\t\t\tStdin: []byte(\"a b a c b d c d\\n\"),\n72\t\t\t\tEnv:   env,\n73\t\t\t},\n74\t\t\t{\n75\t\t\t\tName:  \"r1_1_multiline_pairs\",\n76\t\t\t\tStdin: []byte(\"a b\\nb c\\nc d\\n\"),\n77\t\t\t\tEnv:   env,\n78\t\t\t},\n79\t\t\t{\n80\t\t\t\tName:  \"r1_1_lone_nodes\",\n81\t\t\t\tStdin: []byte(\"a a\\nb b\\n\"),\n82\t\t\t\tEnv:   env,\n83\t\t\t},\n84\t\t\t{\n85\t\t\t\tName:  \"r1_1_self_pair\",\n86\t\t\t\tStdin: []byte(\"x x\\n\"),\n87\t\t\t\tEnv:   env,\n88\t\t\t},\n89\t\t\t{\n90\t\t\t\tName:  \"r1_1_empty_input\",\n91\t\t\t\tStdin: []byte(\"\"),\n92\t\t\t\tEnv:   env,\n93\t\t\t},\n94\t\t\t{\n95\t\t\t\tName:  \"r1_1_multiple_spaces\",\n96\t\t\t\tStdin: []byte(\"a  b  b  c\\n\"),\n97\t\t\t\tEnv:   env,\n98\t\t\t},\n99\t\t\t{\n100\t\t\t\tName:  \"r1_1_tabs_between_tokens\",\n101\t\t\t\tStdin: []byte(\"a\\tb\\tb\\tc\\n\"),\n102\t\t\t\tEnv:   env,\n103\t\t\t},\n104\t\t\t{\n105\t\t\t\tName:  \"r1_1_blank_lines\",\n106\t\t\t\tStdin: []byte(\"a b\\n\\nb c\\n\"),\n107\t\t\t\tEnv:   env,\n108\t\t\t},\n109\t\t\t{\n110\t\t\t\tName:  \"r1_1_many_nodes\",\n111\t\t\t\tStdin: []byte(\"a b b c c d d e e f f g\\n\"),\n112\t\t\t\tEnv:   env,\n113\t\t\t},\n114\t\t\t{\n115\t\t\t\tName:  \"r1_1_duplicate_pairs\",\n116\t\t\t\tStdin: []byte(\"a b a b b c\\n\"),\n117\t\t\t\tEnv:   env,\n118\t\t\t},\n119\t\t\t// R1.2, R2.2: cycle detection\n120\t\t\t{\n121\t\t\t\tName:      \"r1_2_simple_cycle\",\n122\t\t\t\tStdin:     []byte(\"a b b a\\n\"),\n123\t\t\t\tEnv:       env,\n124\t\t\t\tNormalize: []testutils.NormalizeFunc{normStderr},\n125\t\t\t},\n126\t\t\t{\n127\t\t\t\tName:      \"r1_2_three_node_cycle\",\n128\t\t\t\tStdin:     []byte(\"a b b c c a\\n\"),\n129\t\t\t\tEnv:       env,\n130\t\t\t\tNormalize: []testutils.NormalizeFunc{normStderr},\n131\t\t\t