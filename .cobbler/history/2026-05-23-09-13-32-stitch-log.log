{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KUEMjQ681qnEcc4fRjCA92","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd082-stat R1.1, R2.1-R2.3, R3.1, R4.1-R4.2, R5.1, R6.1, R7.1-R7.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"os/user\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"syscall\"\n14\t\t\"time\"\n15\t\t\"unicode\"\n16\t\n17\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n18\t)\n19\t\n20\tconst helpText = `Usage: stat [OPTION]... FILE...\n21\tDisplay file or file system status.\n22\t\n23\tMandatory arguments to long options are mandatory for short options too.\n24\t  -L, --dereference     follow links\n25\t  -f, --file-system     display file system status instead of file status\n26\t  -c  --format=FORMAT   use the specified FORMAT instead of the default;\n27\t                          output a newline after each use of FORMAT\n28\t      --printf=FORMAT   like --format, but interpret backslash escapes,\n29\t                          and do not output a mandatory trailing newline;\n30\t                          if you want a newline, include \\n in FORMAT\n31\t  -t, --terse           print the information in terse form\n32\t      --help     display this help and exit\n33\t      --version  output version information and exit\n34\t`\n35\t\n36\tconst versionText = `stat (go-unix-utils) dev\n37\t`\n38\t\n39\ttype options struct {\n40\t\tdereference bool\n41\t\tfileSystem  bool\n42\t\tformat      string\n43\t\tprintf      string\n44\t\tterse       bool\n45\t}\n46\t\n47\tfunc main() {\n48\t\tsys.InstallSIGPIPEHandler()\n49\t\topts, files, err := parseArgs(os.Args[1:])\n50\t\tif err != nil {\n51\t\t\tfmt.Fprintf(os.Stderr, \"stat: %s\\n\", err)\n52\t\t\tfmt.Fprintf(os.Stderr, \"Try 'stat --help' for more information.\\n\")\n53\t\t\tos.Exit(1)\n54\t\t}\n55\t\tif len(files) == 0 {\n56\t\t\tfmt.Fprintf(os.Stderr, \"stat: missing operand\\n\")\n57\t\t\tfmt.Fprintf(os.Stderr, \"Try 'stat --help' for more information.\\n\")\n58\t\t\tos.Exit(1)\n59\t\t}\n60\t\tos.Exit(run(opts, files))\n61\t}\n62\t\n63\tfunc run(opts options, files []string) int {\n64\t\texitCode := 0\n65\t\tfor _, path := range files {\n66\t\t\tif err := statPath(opts, path); err != nil {\n67\t\t\t\tfmt.Fprintf(os.Stderr, \"%s\\n\", err)\n68\t\t\t\texitCode = 1\n69\t\t\t}\n70\t\t}\n71\t\treturn exitCode\n72\t}\n73\t\n74\tfunc statPath(opts options, path string) error {\n75\t\tif opts.fileSystem {\n76\t\t\treturn statFS(opts, path)\n77\t\t}\n78\t\treturn statFile(opts, path)\n79\t}\n80\t\n81\tfunc statFile(opts options, path string) error {\n82\t\tvar fi *sys.FileInfo\n83\t\tvar err error\n84\t\tif opts.dereference {\n85\t\t\tfi, err = sys.Stat(path)\n86\t\t} else {\n87\t\t\tfi, err = sys.Lstat(path)\n88\t\t}\n89\t\tif err != nil {\n90\t\t\treturn fmtError(path, err)\n91\t\t}\n92\t\toutput := fileOutput(opts, fi, path)\n93\t\tfmt.Fprint(os.Stdout, output)\n94\t\treturn nil\n95\t}\n96\t\n97\tfunc fileOutput(opts options, fi *sys.FileInfo, path string) string {\n98\t\tif opts.printf != \"\" {\n99\t\t\treturn expandFormat(fi, path, opts.printf, false)\n100\t\t}\n101\t\tif opts.format != \"\" {\n102\t\t\treturn expandFormat(fi, path, opts.format, false) + \"\\n\"\n103\t\t}\n104\t\tif opts.terse {\n105\t\t\treturn terseFile(fi, path) + \"\\n\"\n106\t\t}\n107\t\treturn defaultFile(fi, path)\n108\t}\n109\t\n110\tfunc statFS(opts options, path string) error {\n111\t\tvar fs syscall.Statfs_t\n112\t\tif err := syscall.Statfs(path, &fs); err != nil {\n113\t\t\treturn fmtError(path, err)\n114\t\t}\n115\t\toutput := fsOutput(opts, &fs, path)\n116\t\tfmt.Fprint(os.Stdout, output)\n117\t\treturn nil\n118\t}\n119\t\n120\tfunc fsOutput(opts options, fs *syscall.Statfs_t, path string) string {\n121\t\tif opts.printf != \"\" {\n122\t\t\treturn expandFsFormat(fs, path, opts.printf, false)\n123\t\t}\n124\t\tif opts.format != \"\" {\n125\t\t\treturn expandFsFormat(fs, path, opts.format, false) + \"\\n\"\n126\t\t}\n127\t\tif opts.terse {\n128\t\t\treturn terseFS(fs, path) + \"\\n\"\n129\t\t}\n130\t\treturn defaultFS(fs, path)\n131\t}\n132\t\n133\tfunc fmtError(path string, err error) error {\n134\t\tmsg := err.Error()\n135\t\tif pe, ok := err.(*os.PathError); ok {\n136\t\t\tmsg = pe.Err.Error()\n137\t\t}\n138\t\tif len(msg) > 0 && unicode.IsLower(rune(msg[0])) {\n139\t\t\tmsg = string(unicode.ToUpper(rune(msg[0]))) + msg[1:]\n140\t\t}\n141\t\treturn fmt.Errorf(\"stat: cannot stat '%s': %s\", path, msg)\n142\t}\n143\t\n144\tfunc defaultFile(fi *sys.FileInfo, path string) string {\n145\t\tvar b strings.Builder\n146\t\trawMode := rawModeFromInfo(fi)\n147\t\twriteFileLine(&b, fi, path)\n148\t\twriteSizeLine(&b, fi)\n149\t\twriteDeviceLine(&b, fi, rawMode)\n150\t\twriteAccessLine(&b, fi, rawMode)\n151\t\twriteTimestamps(&b, fi)\n152\t\treturn b.String()\n153\t}\n154\t\n155\tfunc writeFileLine(b *strings.Builder, fi *sys.FileInfo, path string) {\n156\t\tif fi.Mode&os.ModeSymlink != 0 {\n157\t\t\ttarget, err := os.Readlink(path)\n158\t\t\tif err != nil {\n159\t\t\t\tfmt.Fprintf(b, \"  File: %s\\n\", path)\n160\t\t\t} else {\n161\t\t\t\tfmt.Fprintf(b, \"  File: %s -> %s\\n\", path, target)\n162\t\t\t}\n163\t\t} else {\n164\t\t\tfmt.Fprintf(b, \"  File: %s\\n\", path)\n165\t\t}\n166\t}\n167\t\n168\tfunc writeSizeLine(b *strings.Builder, fi *sys.FileInfo) {\n169\t\tfmt.Fprintf(b, \"  Size: %-10d\\tBlocks: %-10d IO Block: %-6d %s\\n\",\n170\t\t\tfi.Size, fi.Blocks, fi.Blksize, fileTypeStrSize(fi.Mode, fi.Size))\n171\t}\n172\t\n173\tfunc writeDeviceLine(b *strings.Builder, fi *sys.FileInfo, rawMode uint16) {\n174\t\tmaj := major(fi.Dev)\n175\t\tmin := minor(fi.Dev)\n176\t\tif fi.Mode&(os.ModeDevice|os.ModeCharDevice) != 0 {\n177\t\t\trMaj := major(fi.Rdev)\n178\t\t\trMin := minor(fi.Rdev)\n179\t\t\tfmt.Fprintf(b, \"Device: %d,%d\\tInode: %-10d  Links: %-5d Device type: %d,%d\\n\",\n180\t\t\t\tmaj, min, fi.Ino, fi.Nlink, rMaj, rMin)\n181\t\t} else {\n182\t\t\tfmt.Fprintf(b, \"Device: %d,%d\\tInode: %-10d  Links: %d\\n\",\n183\t\t\t\tmaj, min, fi.Ino, fi.Nlink)\n184\t\t}\n185\t\t_ = rawMode\n186\t}\n187\t\n188\tfunc writeAccessLine(b *strings.Builder, fi *sys.FileInfo, rawMode uint16) {\n189\t\toctal := rawMode & 07777\n190\t\tperm := permString(fi.Mode)\n191\t\tuname := lookupUser(fi.Uid)\n192\t\tgname := lookupGroup(fi.Gid)\n193\t\tfmt.Fprintf(b, \"Access: (%04o/%s)  Uid: (%5d/%8s)   Gid: (%5d/%8s)\\n\",\n194\t\t\toctal, perm, fi.Uid, uname, fi.Gid, gname)\n195\t}\n196\t\n197\tfunc writeTimestamps(b *strings.Builder, fi *sys.FileInfo) {\n198\t\tbirth := birthTime(fi)\n199\t\tfmt.Fprintf(b, \"Access: %s\\n\", formatTime(fi.AccessTime))\n200\t\tfmt.Fprintf(b, \"Modify: %s\\n\", formatTime(fi.ModTime))\n201\t\tfmt.Fprintf(b, \"Change: %s\\n\", formatTime(fi.ChangeTime))\n202\t\tfmt.Fprintf(b, \" Birth: %s\\n\", formatTime(birth))\n203\t}\n204\t\n205\tfunc terseFile(fi *sys.FileInfo, path string) string {\n206\t\trawMode := rawModeFromInfo(fi)\n207\t\tbirth := birthTime(fi)\n208\t\treturn fmt.Sprintf(\"%s %d %d %x %d %d %x %d %d %x %x %d %d %d %d %d\",\n209\t\t\tpath, fi.Size, fi.Blocks, rawMode,\n210\t\t\tfi.Uid, fi.Gid, fi.Dev, fi.Ino, fi.Nlink,\n211\t\t\tmajor(fi.Rdev), minor(fi.Rdev),\n212\t\t\tfi.AccessTime.Unix(), fi.ModTime.Unix(),\n213\t\t\tfi.ChangeTime.Unix(), birth.Unix(),\n214\t\t\tfi.Blksize)\n215\t}\n216\t\n217\tfunc defaultFS(fs *syscall.Statfs_t, path string) string {\n218\t\tvar b strings.Builder\n219\t\ttypeName := int8ToStr(fs.Fstypename[:])\n220\t\tfsid := fsIDHex(fs.Fsid)\n221\t\tfmt.Fprintf(&b, \"  File: \\\"%s\\\"\\n\", path)\n222\t\tfmt.Fprintf(&b, \"    ID: %s Namelen: %-7s Type: %s\\n\",\n223\t\t\tfsid, \"?\", typeName)\n224\t\tfmt.Fprintf(&b, \"Block size: %-10d Fundamental block size: %d\\n\",\n225\t\t\tfs.Bsize, fs.Bsize)\n226\t\tfmt.Fprintf(&b, \"Blocks: Total: %-10d Free: %-10d Available: %d\\n\",\n227\t\t\tfs.Blocks, fs.Bfree, fs.Bavail)\n228\t\tfmt.Fprintf(&b, \"Inodes: Total: %-10d Free: %d\\n\",\n229\t\t\tfs.Files, fs.Ffree)\n230\t\treturn b.String()\n231\t}\n232\t\n233\tfunc terseFS(fs *syscall.Statfs_t, path string) string {\n234\t\tfsid := fsIDHex(fs.Fsid)\n235\t\treturn fmt.Sprintf(\"%s %s ? %x %d %d %d %d %d %d %d\",\n236\t\t\tpath, fsid, fs.Type,\n237\t\t\tfs.Bsize, fs.Bsize,\n238\t\t\tfs.Blocks, fs.Bfree, fs.Bavail,\n239\t\t\tfs.Files, fs.Ffree)\n240\t}\n241\t\n242\tfunc expandFormat(fi *sys.FileInfo, path, format string, _ bool) string {\n243\t\tvar b strings.Builder\n244\t\ti := 0\n245\t\tfor i < len(format) {\n246\t\t\tif format[i] == '\\\\' {\n247\t\t\t\tch, adv := parseEscape(format[i:])\n248\t\t\t\tb.WriteString(ch)\n249\t\t\t\ti += adv\n250\t\t\t} else if format[i] == '%' {\n251\t\t\t\tval, adv := parseFileDirective(fi, path, format[i:])\n252\t\t\t\tb.WriteString(val)\n253\t\t\t\ti += adv\n254\t\t\t} else {\n255\t\t\t\tb.WriteByte(format[i])\n256\t\t\t\ti++\n257\t\t\t}\n258\t\t}\n259\t\treturn b.String()\n260\t}\n261\t\n262\tfunc expandFsFormat(fs *syscall.Statfs_t, path, format string, _ bool) string {\n263\t\tvar b strings.Builder\n264\t\ti := 0\n265\t\tfor i < len(format) {\n266\t\t\tif format[i] == '\\\\' {\n267\t\t\t\tch, adv := parseEscape(format[i:])\n268\t\t\t\tb.WriteString(ch)\n269\t\t\t\ti += adv\n270\t\t\t} else if format[i] == '%' {\n271\t\t\t\tval, adv := parseFsDirective(fs, path, format[i:])\n272\t\t\t\tb.WriteString(val)\n273\t\t\t\ti += adv\n274\t\t\t} else {\n275\t\t\t\tb.WriteByte(format[i])\n276\t\t\t\ti++\n277\t\t\t}\n278\t\t}\n279\t\treturn b.String()\n280\t}\n281\t\n282\tfunc parseFileDirective(fi *sys.FileInfo, path, s string) (string, int) {\n283\t\tif len(s) < 2 {\n284\t\t\treturn \"%\", 1\n285\t\t}\n286\t\tif s[1] == '%' {\n287\t\t\treturn \"%\", 2\n288\t\t}\n289\t\tflags, width, prec, dir, adv := parseModifiers(s[1:])\n290\t\tval := fileDirectiveValue(fi, path, dir)\n291\t\tformatted := applyModifiers(val, flags, width, prec)\n292\t\treturn formatted, 1 + adv\n293\t}\n294\t\n295\tfunc parseFsDirective(fs *syscall.Statfs_t, path, s string) (string, int) {\n296\t\tif len(s) < 2 {\n297\t\t\treturn \"%\", 1\n298\t\t}\n299\t\tif s[1] == '%' {\n300\t\t\treturn \"%\", 2\n301\t\t}\n302\t\tflags, width, prec, dir, adv := parseModifiers(s[1:])\n303\t\tval := fsDirectiveValue(fs, path, dir)\n304\t\tformatted := applyModifiers(val, flags, width, prec)\n305\t\treturn formatted, 1 + adv\n306\t}\n307\t\n308\tfunc parseModifiers(s string) (string, int, int, byte, int) {\n309\t\ti := 0\n310\t\tvar flags string\n311\t\tfor i < len(s) && (s[i] == '-' || s[i] == '+' || s[i] == ' ' || s[i] == '0' || s[i] == '#') {\n312\t\t\tflags += string(s[i])\n313\t\t\ti++\n314\t\t}\n315\t\twidth := 0\n316\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n317\t\t\twidth = width*10 + int(s[i]-'0')\n318\t\t\ti++\n319\t\t}\n320\t\tprec := -1\n321\t\tif i < len(s) && s[i] == '.' {\n322\t\t\ti++\n323\t\t\tprec = 0\n324\t\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n325\t\t\t\tprec = prec*10 + int(s[i]-'0')\n326\t\t\t\ti++\n327\t\t\t}\n328\t\t}\n329\t\tif i >= len(s) {\n330\t\t\treturn flags, width, prec, 0, i\n331\t\t}\n332\t\treturn flags, width, prec, s[i], i + 1\n333\t}\n334\t\n335\tfunc applyModifiers(val string, flags string, width int, prec int) string {\n336\t\tif width == 0 && prec < 0 && flags == \"\" {\n337\t\t\treturn val\n338\t\t}\n339\t\tfmtStr := \"%\" + flags\n340\t\tif width > 0 {\n341\t\t\tfmtStr += strconv.Itoa(width)\n342\t\t}\n343\t\tif prec >= 0 {\n344\t\t\tfmtStr += \".\" + strconv.Itoa(prec)\n345\t\t}\n346\t\tfmtStr += \"s\"\n347\t\treturn fmt.Sprintf(fmtStr, val)\n348\t}\n349\t\n350\tfunc fileDirectiveValue(fi *sys.FileInfo, path string, dir byte) string {\n351\t\trawMode := rawModeFromInfo(fi)\n352\t\tswitch dir {\n353\t\tcase 'a':\n354\t\t\treturn fmt.Sprintf(\"%o\", rawMode&07777)\n355\t\tcase 'A':\n356\t\t\treturn permString(fi.Mode)\n357\t\tcase 'b':\n358\t\t\treturn fmt.Sprintf(\"%d\", fi.Blocks)\n359\t\tcase 'B':\n360\t\t\treturn \"512\"\n361\t\tcase 'd':\n362\t\t\treturn fmt.Sprintf(\"%d\", fi.Dev)\n363\t\tcase 'D':\n364\t\t\treturn fmt.Sprintf(\"%x\", fi.Dev)\n365\t\tcase 'f':\n366\t\t\treturn fmt.Sprintf(\"%x\", rawMode)\n367\t\tcase 'F':\n368\t\t\treturn fileTypeStrSize(fi.Mode, fi.Size)\n369\t\tcase 'g':\n370\t\t\treturn fmt.Sprintf(\"%d\", fi.Gid)\n371\t\tcase 'G':\n372\t\t\treturn lookupGroup(fi.Gid)\n373\t\tcase 'h':\n374\t\t\treturn fmt.Sprintf(\"%d\", fi.Nlink)\n375\t\tcase 'i':\n376\t\t\treturn fmt.Sprintf(\"%d\", fi.Ino)\n377\t\tcase 'm':\n378\t\t\treturn mountPoint(path)\n379\t\tcase 'n':\n380\t\t\treturn path\n381\t\tcase 'N':\n382\t\t\treturn quotedName(fi, path)\n383\t\tcase 'o':\n384\t\t\treturn fmt.Sprintf(\"%d\", fi.Blksize)\n385\t\tcase 's':\n386\t\t\treturn fmt.Sprintf(\"%d\", fi.Size)\n387\t\tcase 't':\n388\t\t\treturn fmt.Sprintf(\"%x\", major(fi.Rdev))\n389\t\tcase 'T':\n390\t\t\treturn fmt.Sprintf(\"%x\", minor(fi.Rdev))\n391\t\tcase 'u':\n392\t\t\treturn fmt.Sprintf(\"%d\", fi.Uid)\n393\t\tcase 'U':\n394\t\t\treturn lookupUser(fi.Uid)\n395\t\tdefault:\n396\t\t\treturn fileTimeDirective(fi, dir)\n397\t\t}\n398\t}\n399\t\n400\tfunc fileTimeDirective(fi *sys.FileInfo, dir byte) string {\n401\t\tbirth := birthTime(fi)\n402\t\tswitch dir {\n403\t\tcase 'w':\n404\t\t\treturn formatTimeBirth(birth)\n405\t\tcase 'W':\n406\t\t\treturn epochBirth(birth)\n407\t\tcase 'x':\n408\t\t\treturn formatTime(fi.AccessTime)\n409\t\tcase 'X':\n410\t\t\treturn fmt.Sprintf(\"%d\", fi.AccessTime.Unix())\n411\t\tcase 'y':\n412\t\t\treturn formatTime(fi.ModTime)\n413\t\tcase 'Y':\n414\t\t\treturn fmt.Sprintf(\"%d\", fi.ModTime.Unix())\n415\t\tcase 'z':\n416\t\t\treturn formatTime(fi.ChangeTime)\n417\t\tcase 'Z':\n418\t\t\treturn fmt.Sprintf(\"%d\", fi.ChangeTime.Unix())\n419\t\tdefault:\n420\t\t\treturn \"%\" + string(dir)\n421\t\t}\n422\t}\n423\t\n424\tfunc fsDirectiveValue(fs *syscall.Statfs_t, path string, dir byte) string {\n425\t\tswitch dir {\n426\t\tcase 'a':\n427\t\t\treturn fmt.Sprintf(\"%d\", fs.Bavail)\n428\t\tcase 'b':\n429\t\t\treturn fmt.Sprintf(\"%d\", fs.Blocks)\n430\t\tcase 'c':\n431\t\t\treturn fmt.Sprintf(\"%d\", fs.Files)\n432\t\tcase 'd':\n433\t\t\treturn fmt.Sprintf(\"%d\", fs.Ffree)\n434\t\tcase 'f':\n435\t\t\treturn fmt.Sprintf(\"%d\", fs.Bfree)\n436\t\tcase 'i':\n437\t\t\treturn fsIDHex(fs.Fsid)\n438\t\tcase 'l':\n439\t\t\treturn \"?\"\n440\t\tcase 'n':\n441\t\t\treturn path\n442\t\tcase 's':\n443\t\t\treturn fmt.Sprintf(\"%d\", fs.Bsize)\n444\t\tcase 'S':\n445\t\t\treturn fmt.Sprintf(\"%d\", fs.Bsize)\n446\t\tcase 't':\n447\t\t\treturn fmt.Sprintf(\"%x\", fs.Type)\n448\t\tcase 'T':\n449\t\t\treturn int8ToStr(fs.Fstypename[:])\n450\t\tdefault:\n451\t\t\treturn \"%\" + string(dir)\n452\t\t}\n453\t}\n454\t\n455\tfunc parseEscape(s string) (string, int) {\n456\t\tif len(s) < 2 {\n457\t\t\treturn \"\\\\\", 1\n458\t\t}\n459\t\tswitch s[1] {\n460\t\tcase 'n':\n461\t\t\treturn \"\\n\", 2\n462\t\tcase 't':\n463\t\t\treturn \"\\t\", 2\n464\t\tcase 'r':\n465\t\t\treturn \"\\r\", 2\n466\t\tcase '\\\\':\n467\t\t\treturn \"\\\\\", 2\n468\t\tcase 'a':\n469\t\t\treturn \"\\a\", 2\n470\t\tcase 'b':\n471\t\t\treturn \"\\b\", 2\n472\t\tcase 'f':\n473\t\t\treturn \"\\f\", 2\n474\t\tcase 'v':\n475\t\t\treturn \"\\v\", 2\n476\t\tcase '0':\n477\t\t\treturn parseOctalEscape(s)\n478\t\tcase 'x':\n479\t\t\treturn parseHexEscape(s)\n480\t\tdefault:\n481\t\t\treturn string(s[:2]), 2\n482\t\t}\n483\t}\n484\t\n485\tfunc parseOctalEscape(s string) (string, int) {\n486\t\tn := 2\n487\t\tval := 0\n488\t\tfor n < len(s) && n < 5 && s[n] >= '0' && s[n] <= '7' {\n489\t\t\tval = val*8 + int(s[n]-'0')\n490\t\t\tn++\n491\t\t}\n492\t\tif n == 2 {\n493\t\t\treturn \"\\x00\", 2\n494\t\t}\n495\t\treturn string(rune(val)), n\n496\t}\n497\t\n498\tfunc parseHexEscape(s string) (string, int) {\n499\t\tn := 2\n500\t\tval := 0\n501\t\tfor n < len(s) && n < 4 {\n502\t\t\tc := s[n]\n503\t\t\tif c >= '0' && c <= '9' {\n504\t\t\t\tval = val*16 + int(c-'0')\n505\t\t\t} else if c >= 'a' && c <= 'f' {\n506\t\t\t\tval = val*16 + int(c-'a') + 10\n507\t\t\t} else if c >= 'A' && c <= 'F' {\n508\t\t\t\tval = val*16 + int(c-'A') + 10\n509\t\t\t} else {\n510\t\t\t\tbreak\n511\t\t\t}\n512\t\t\tn++\n513\t\t}\n514\t\tif n == 2 {\n515\t\t\treturn \"\\\\x\", 2\n516\t\t}\n517\t\treturn string(rune(val)), n\n518\t}\n519\t\n520\tfunc fileTypeStrSize(mode os.FileMode, size int64) string {\n521\t\tif mode.IsRegular() && size == 0 {\n522\t\t\treturn \"regular empty file\"\n523\t\t}\n524\t\treturn fileTypeStr(mode)\n525\t}\n526\t\n527\tfunc fileTypeStr(mode os.FileMode) string {\n528\t\tswitch {\n529\t\tcase mode.IsRegular():\n530\t\t\treturn \"regular file\"\n531\t\tcase mode.IsDir():\n532\t\t\treturn \"directory\"\n533\t\tcase mode&os.ModeSymlink != 0:\n534\t\t\treturn \"symbolic link\"\n535\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n536\t\t\treturn \"character special file\"\n537\t\tcase mode&os.ModeDevice != 0:\n538\t\t\treturn \"block special file\"\n539\t\tcase mode&os.ModeNamedPipe != 0:\n540\t\t\treturn \"fifo\"\n541\t\tcase mode&os.ModeSocket != 0:\n542\t\t\treturn \"socket\"\n543\t\tdefault:\n544\t\t\treturn \"weird file\"\n545\t\t}\n546\t}\n547\t\n548\tfunc permString(mode os.FileMode) string {\n549\t\tvar buf [10]byte\n550\t\tbuf[0] = fileTypeChar(mode)\n551\t\tconst rwx = \"rwx\"\n552\t\tperm := mode.Perm()\n553\t\tfor i := range 9 {\n554\t\t\tif perm&(1<<uint(8-i)) != 0 {\n555\t\t\t\tbuf[1+i] = rwx[i%3]\n556\t\t\t} else {\n557\t\t\t\tbuf[1+i] = '-'\n558\t\t\t}\n559\t\t}\n560\t\tapplySpecialBits(mode, &buf)\n561\t\treturn string(buf[:])\n562\t}\n563\t\n564\tfunc fileTypeChar(mode os.FileMode) byte {\n565\t\tswitch {\n566\t\tcase mode.IsRegular():\n567\t\t\treturn '-'\n568\t\tcase mode.IsDir():\n569\t\t\treturn 'd'\n570\t\tcase mode&os.ModeSymlink != 0:\n571\t\t\treturn 'l'\n572\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n573\t\t\treturn 'c'\n574\t\tcase mode&os.ModeDevice != 0:\n575\t\t\treturn 'b'\n576\t\tcase mode&os.ModeNamedPipe != 0:\n577\t\t\treturn 'p'\n578\t\tcase mode&os.ModeSocket != 0:\n579\t\t\treturn 's'\n580\t\tdefault:\n581\t\t\treturn '?'\n582\t\t}\n583\t}\n584\t\n585\tfunc applySpecialBits(mode os.FileMode, buf *[10]byte) {\n586\t\tif mode&os.ModeSetuid != 0 {\n587\t\t\tif buf[3] == 'x' {\n588\t\t\t\tbuf[3] = 's'\n589\t\t\t} else {\n590\t\t\t\tbuf[3] = 'S'\n591\t\t\t}\n592\t\t}\n593\t\tif mode&os.ModeSetgid != 0 {\n594\t\t\tif buf[6] == 'x' {\n595\t\t\t\tbuf[6] = 's'\n596\t\t\t} else {\n597\t\t\t\tbuf[6] = 'S'\n598\t\t\t}\n599\t\t}\n600\t\tif mode&os.ModeSticky != 0 {\n601\t\t\tif buf[9] == 'x' {\n602\t\t\t\tbuf[9] = 't'\n603\t\t\t} else {\n604\t\t\t\tbuf[9] = 'T'\n605\t\t\t}\n606\t\t}\n607\t}\n608\t\n609\tfunc formatTime(t time.Time) string {\n610\t\treturn t.Format(\"2006-01-02 15:04:05.000000000 -0700\")\n611\t}\n612\t\n613\tfunc formatTimeBirth(t time.Time) string {\n614\t\tif t.IsZero() {\n615\t\t\treturn \"-\"\n616\t\t}\n617\t\treturn formatTime(t)\n618\t}\n619\t\n620\tfunc epochBirth(t time.Time) string {\n621\t\tif t.IsZero() {\n622\t\t\treturn \"0\"\n623\t\t}\n624\t\treturn fmt.Sprintf(\"%d\", t.Unix())\n625\t}\n626\t\n627\tfunc birthTime(fi *sys.FileInfo) time.Time {\n628\t\tif fi.Info == nil {\n629\t\t\treturn time.Time{}\n630\t\t}\n631\t\tstat, ok := fi.Info.Sys().(*syscall.Stat_t)\n632\t\tif !ok {\n633\t\t\treturn time.Time{}\n634\t\t}\n635\t\treturn time.Unix(stat.Birthtimespec.Sec, stat.Birthtimespec.Nsec)\n636\t}\n637\t\n638\tfunc rawModeFromInfo(fi *sys.FileInfo) uint16 {\n639\t\tif fi.Info == nil {\n640\t\t\treturn 0\n641\t\t}\n642\t\tstat, ok := fi.Info.Sys().(*syscall.Stat_t)\n643\t\tif !ok {\n644\t\t\treturn 0\n645\t\t}\n646\t\treturn stat.Mode\n647\t}\n648\t\n649\tfunc lookupUser(uid uint32) string {\n650\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n651\t\tif err != nil {\n652\t\t\treturn strconv.Itoa(int(uid))\n653\t\t}\n654\t\treturn u.Username\n655\t}\n656\t\n657\tfunc lookupGroup(gid uint32) string {\n658\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n659\t\tif err != nil {\n660\t\t\treturn strconv.Itoa(int(gid))\n661\t\t}\n662\t\treturn g.Name\n663\t}\n664\t\n665\tfunc major(dev uint64) uint64 {\n666\t\treturn (dev >> 24) & 0xff\n667\t}\n668\t\n669\tfunc minor(dev uint64) uint64 {\n670\t\treturn dev & 0xffffff\n671\t}\n672\t\n673\tfunc quoteFile(name string) string {\n674\t\treturn \"'\" + name + \"'\"\n675\t}\n676\t\n677\tfunc quotedName(fi *sys.FileInfo, path string) string {\n678\t\tif fi.Mode&os.ModeSymlink != 0 {\n679\t\t\ttarget, err := os.Readlink(path)\n680\t\t\tif err != nil {\n681\t\t\t\treturn quoteFile(path)\n682\t\t\t}\n683\t\t\treturn quoteFile(path) + \" -> \" + quoteFile(target)\n684\t\t}\n685\t\treturn quoteFile(path)\n686\t}\n687\t\n688\tfunc mountPoint(path string) string {\n689\t\tvar fs syscall.Statfs_t\n690\t\tif err := syscall.Statfs(path, &fs); err != nil {\n691\t\t\treturn \"?\"\n692\t\t}\n693\t\tmp := int8ToStr(fs.Mntonname[:])\n694\t\tif mp == \"/System/Volumes/Data\" {\n695\t\t\treturn \"/\"\n696\t\t}\n697\t\treturn mp\n698\t}\n699\t\n700\tfunc int8ToStr(arr []int8) string {\n701\t\tbuf := make([]byte, 0, len(arr))\n702\t\tfor _, v := range arr {\n703\t\t\tif v == 0 {\n704\t\t\t\tbreak\n705\t\t\t}\n706\t\t\tbuf = append(buf, byte(v))\n707\t\t}\n708\t\treturn string(buf)\n709\t}\n710\t\n711\tfunc fsIDHex(fsid syscall.Fsid) string {\n712\t\treturn fmt.Sprintf(\"%x\", uint64(uint32(fsid.Val[0]))<<32|uint64(uint32(fsid.Val[1])))\n713\t}\n714\t\n715\tfunc parseArgs(args []string) (options, []string, error) {\n716\t\tvar opts options\n717\t\tvar files []string\n718\t\tendFlags := false\n719\t\tfor i := 0; i < len(args); i++ {\n720\t\t\targ := args[i]\n721\t\t\tif endFlags || !strings.HasPrefix(arg, \"-\") {\n722\t\t\t\tfiles = append(files, arg)\n723\t\t\t\tcontinue\n724\t\t\t}\n725\t\t\tif arg == \"--\" {\n726\t\t\t\tendFlags = true\n727\t\t\t\tcontinue\n728\t\t\t}\n729\t\t\tif strings.HasPrefix(arg, \"--\") {\n730\t\t\t\tadv, err := parseLongFlag(arg, args[i+1:], &opts)\n731\t\t\t\tif err != nil {\n732\t\t\t\t\treturn options{}, nil, err\n733\t\t\t\t}\n734\t\t\t\ti += adv\n735\t\t\t\tcontinue\n736\t\t\t}\n737\t\t\tadv, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n738\t\t\tif err != nil {\n739\t\t\t\treturn options{}, nil, err\n740\t\t\t}\n741\t\t\ti += adv\n742\t\t}\n743\t\treturn opts, files, nil\n744\t}\n745\t\n746\tfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n747\t\tif strings.HasPrefix(flag, \"--format=\") {\n748\t\t\topts.format = flag[len(\"--format=\"):]\n749\t\t\treturn 0, nil\n750\t\t}\n751\t\tif strings.HasPrefix(flag, \"--printf=\") {\n752\t\t\topts.printf = flag[len(\"--printf=\"):]\n753\t\t\treturn 0, nil\n754\t\t}\n755\t\tswitch flag {\n756\t\tcase \"--format\":\n757\t\t\tif len(rest) == 0 {\n758\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n759\t\t\t}\n760\t\t\topts.format = rest[0]\n761\t\t\treturn 1, nil\n762\t\tcase \"--printf\":\n763\t\t\tif len(rest) == 0 {\n764\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n765\t\t\t}\n766\t\t\topts.printf = rest[0]\n767\t\t\treturn 1, nil\n768\t\tcase \"--dereference\":\n769\t\t\topts.dereference = true\n770\t\tcase \"--file-system\":\n771\t\t\topts.fileSystem = true\n772\t\tcase \"--terse\":\n773\t\t\topts.terse = true\n774\t\tcase \"--help\":\n775\t\t\tfmt.Fprint(os.Stdout, helpText)\n776\t\t\tos.Exit(0)\n777\t\tcase \"--version\":\n778\t\t\tfmt.Fprint(os.Stdout, versionText)\n779\t\t\tos.Exit(0)\n780\t\tdefault:\n781\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n782\t\t}\n783\t\treturn 0, nil\n784\t}\n785\t\n786\tfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n787\t\tfor i, ch := range flags {\n788\t\t\tswitch ch {\n789\t\t\tcase 'L':\n790\t\t\t\topts.dereference = true\n791\t\t\tcase 'f':\n792\t\t\t\topts.fileSystem = true\n793\t\t\tcase 't':\n794\t\t\t\topts.terse = true\n795\t\t\tcase 'c':\n796\t\t\t\tremaining := flags[i+1:]\n797\t\t\t\tif remaining != \"\" {\n798\t\t\t\t\topts.format = remaining\n799\t\t\t\t\treturn 0, nil\n800\t\t\t\t}\n801\t\t\t\tif len(rest) == 0 {\n802\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'c'\")\n803\t\t\t\t}\n804\t\t\t\topts.format = rest[0]\n805\t\t\t\treturn 1, nil\n806\t\t\tdefault:\n807\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", ch)\n808\t\t\t}\n809\t\t}\n810\t\treturn 0, nil\n811\t}\n812\t"}]},"parent_tool_use_id":null,"session_id":"46a0605e-dc67-44c4-85eb-31ea77dca33c","uuid":"b839d5ee-ff84-4c97-bf59-8233ba652072","timestamp":"2026-05-23T13:14:48.445Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5533/cmd/stat/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd082-stat R1.1, R2.1-R2.3, R3.1, R4.1-R4.2, R5.1, R6.1, R7.1-R7.3.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\t\"unicode\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: stat [OPTION]... FILE...\nDisplay file or file system status.\n\nMandatory arguments to long options are mandatory for short options too.\n  -L, --dereference     follow links\n  -f, --file-system     display file system status instead of file status\n  -c  --format=FORMAT   use the specified FORMAT instead of the default;\n                          output a newline after each use of FORMAT\n      --printf=FORMAT   like --format, but interpret backslash escapes,\n                          and do not output a mandatory trailing newline;\n                          if you want a newline, include \\n in FORMAT\n  -t, --terse           print the information in terse form\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `stat (go-unix-utils) dev\n`\n\ntype options struct {\n\tdereference bool\n\tfileSystem  bool\n\tformat      string\n\tprintf      string\n\tterse       bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"stat: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'stat --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\tif len(files) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"stat: missing operand\\n\")\n\t\tfmt.Fprintf(os.Stderr, \"Try 'stat --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\tos.Exit(run(opts, files))\n}\n\nfunc run(opts options, files []string) int {\n\texitCode := 0\n\tfor _, path := range files {\n\t\tif err := statPath(opts, path); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"%s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc statPath(opts options, path string) error {\n\tif opts.fileSystem {\n\t\treturn statFS(opts, path)\n\t}\n\treturn statFile(opts, path)\n}\n\nfunc statFile(opts options, path string) error {\n\tvar fi *sys.FileInfo\n\tvar err error\n\tif opts.dereference {\n\t\tfi, err = sys.Stat(path)\n\t} else {\n\t\tfi, err = sys.Lstat(path)\n\t}\n\tif err != nil {\n\t\treturn fmtError(path, err)\n\t}\n\toutput := fileOutput(opts, fi, path)\n\tfmt.Fprint(os.Stdout, output)\n\treturn nil\n}\n\nfunc fileOutput(opts options, fi *sys.FileInfo, path string) string {\n\tif opts.printf != \"\" {\n\t\treturn expandFormat(fi, path, opts.printf, false)\n\t}\n\tif opts.format != \"\" {\n\t\treturn expandFormat(fi, path, opts.format, false) + \"\\n\"\n\t}\n\tif opts.terse {\n\t\treturn terseFile(fi, path) + \"\\n\"\n\t}\n\treturn defaultFile(fi, path)\n}\n\nfunc statFS(opts options, path string) error {\n\tvar fs syscall.Statfs_t\n\tif err := syscall.Statfs(path, &fs); err != nil {\n\t\treturn fmtError(path, err)\n\t}\n\toutput := fsOutput(opts, &fs, path)\n\tfmt.Fprint(os.Stdout, output)\n\treturn nil\n}\n\nfunc fsOutput(opts options, fs *syscall.Statfs_t, path string) string {\n\tif opts.printf != \"\" {\n\t\treturn expandFsFormat(fs, path, opts.printf, false)\n\t}\n\tif opts.format != \"\" {\n\t\treturn expandFsFormat(fs, path, opts.format, false) + \"\\n\"\n\t}\n\tif opts.terse {\n\t\treturn terseFS(fs, path) + \"\\n\"\n\t}\n\treturn defaultFS(fs, path)\n}\n\nfunc fmtError(path string, err error) error {\n\tmsg := err.Error()\n\tif pe, ok := err.(*os.PathError); ok {\n\t\tmsg = pe.Err.Error()\n\t}\n\tif len(msg) > 0 && unicode.IsLower(rune(msg[0])) {\n\t\tmsg = string(unicode.ToUpper(rune(msg[0]))) + msg[1:]\n\t}\n\treturn fmt.Errorf(\"stat: cannot stat '%s': %s\", path, msg)\n}\n\nfunc defaultFile(fi *sys.FileInfo, path string) string {\n\tvar b strings.Builder\n\trawMode := rawModeFromInfo(fi)\n\twriteFileLine(&b, fi, path)\n\twriteSizeLine(&b, fi)\n\twriteDeviceLine(&b, fi, rawMode)\n\twriteAccessLine(&b, fi, rawMode)\n\twriteTimestamps(&b, fi)\n\treturn b.String()\n}\n\nfunc writeFileLine(b *strings.Builder, fi *sys.FileInfo, path string) {\n\tif fi.Mode&os.ModeSymlink != 0 {\n\t\ttarget, err := os.Readlink(path)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(b, \"  File: %s\\n\", path)\n\t\t} else {\n\t\t\tfmt.Fprintf(b, \"  File: %s -> %s\\n\", path, target)\n\t\t}\n\t} else {\n\t\tfmt.Fprintf(b, \"  File: %s\\n\", path)\n\t}\n}\n\nfunc writeSizeLine(b *strings.Builder, fi *sys.FileInfo) {\n\tfmt.Fprintf(b, \"  Size: %-10d\\tBlocks: %-10d IO Block: %-6d %s\\n\",\n\t\tfi.Size, fi.Blocks, fi.Blksize, fileTypeStrSize(fi.Mode, fi.Size))\n}\n\nfunc writeDeviceLine(b *strings.Builder, fi *sys.FileInfo, rawMode uint16) {\n\tmaj := major(fi.Dev)\n\tmin := minor(fi.Dev)\n\tif fi.Mode&(os.ModeDevice|os.ModeCharDevice) != 0 {\n\t\trMaj := major(fi.Rdev)\n\t\trMin := minor(fi.Rdev)\n\t\tfmt.Fprintf(b, \"Device: %d,%d\\tInode: %-10d  Links: %-5d Device type: %d,%d\\n\",\n\t\t\tmaj, min, fi.Ino, fi.Nlink, rMaj, rMin)\n\t} else {\n\t\tfmt.Fprintf(b, \"Device: %d,%d\\tInode: %-10d  Links: %d\\n\",\n\t\t\tmaj, min, fi.Ino, fi.Nlink)\n\t}\n\t_ = rawMode\n}\n\nfunc writeAccessLine(b *strings.Builder, fi *sys.FileInfo, rawMode uint16) {\n\toctal := rawMode & 07777\n\tperm := permString(fi.Mode)\n\tuname := lookupUser(fi.Uid)\n\tgname := lookupGroup(fi.Gid)\n\tfmt.Fprintf(b, \"Access: (%04o/%s)  Uid: (%5d/%8s)   Gid: (%5d/%8s)\\n\",\n\t\toctal, perm, fi.Uid, uname, fi.Gid, gname)\n}\n\nfunc writeTimestamps(b *strings.Builder, fi *sys.FileInfo) {\n\tbirth := birthTime(fi)\n\tfmt.Fprintf(b, \"Access: %s\\n\", formatTime(fi.AccessTime))\n\tfmt.Fprintf(b, \"Modify: %s\\n\", formatTime(fi.ModTime))\n\tfmt.Fprintf(b, \"Change: %s\\n\", formatTime(fi.ChangeTime))\n\tfmt.Fprintf(b, \" Birth: %s\\n\", formatTime(birth))\n}\n\nfunc terseFile(fi *sys.FileInfo, path string) string {\n\trawMode := rawModeFromInfo(fi)\n\tbirth := birthTime(fi)\n\treturn fmt.Sprintf(\"%s %d %d %x %d %d %x %d %d %x %x %d %d %d %d %d\",\n\t\tpath, fi.Size, fi.Blocks, rawMode,\n\t\tfi.Uid, fi.Gid, fi.Dev, fi.Ino, fi.Nlink,\n\t\tmajor(fi.Rdev), minor(fi.Rdev),\n\t\tfi.AccessTime.Unix(), fi.ModTime.Unix(),\n\t\tfi.ChangeTime.Unix(), birth.Unix(),\n\t\tfi.Blksize)\n}\n\nfunc defaultFS(fs *syscall.Statfs_t, path string) string {\n\tvar b strings.Builder\n\ttypeName := int8ToStr(fs.Fstypename[:])\n\tfsid := fsIDHex(fs.Fsid)\n\tfmt.Fprintf(&b, \"  File: \\\"%s\\\"\\n\", path)\n\tfmt.Fprintf(&b, \"    ID: %s Namelen: %-7s Type: %s\\n\",\n\t\tfsid, \"?\", typeName)\n\tfmt.Fprintf(&b, \"Block size: %-10d Fundamental block size: %d\\n\",\n\t\tfs.Bsize, fs.Bsize)\n\tfmt.Fprintf(&b, \"Blocks: Total: %-10d Free: %-10d Available: %d\\n\",\n\t\tfs.Blocks, fs.Bfree, fs.Bavail)\n\tfmt.Fprintf(&b, \"Inodes: Total: %-10d Free: %d\\n\",\n\t\tfs.Files, fs.Ffree)\n\treturn b.String()\n}\n\nfunc terseFS(fs *syscall.Statfs_t, path string) string {\n\tfsid := fsIDHex(fs.Fsid)\n\treturn fmt.Sprintf(\"%s %s ? %x %d %d %d %d %d %d %d\",\n\t\tpath, fsid, fs.Type,\n\t\tfs.Bsize, fs.Bsize,\n\t\tfs.Blocks, fs.Bfree, fs.Bavail,\n\t\tfs.Files, fs.Ffree)\n}\n\nfunc expandFormat(fi *sys.FileInfo, path, format string, _ bool) string {\n\tvar b strings.Builder\n\ti := 0\n\tfor i < len(format) {\n\t\tif format[i] == '\\\\' {\n\t\t\tch, adv := parseEscape(format[i:])\n\t\t\tb.WriteString(ch)\n\t\t\ti += adv\n\t\t} else if format[i] == '%' {\n\t\t\tval, adv := parseFileDirective(fi, path, format[i:])\n\t\t\tb.WriteString(val)\n\t\t\ti += adv\n\t\t} else {\n\t\t\tb.WriteByte(format[i])\n\t\t\ti++\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc expandFsFormat(fs *syscall.Statfs_t, path, format string, _ bool) string {\n\tvar b strings.Builder\n\ti := 0\n\tfor i < len(format) {\n\t\tif format[i] == '\\\\' {\n\t\t\tch, adv := parseEscape(format[i:])\n\t\t\tb.WriteString(ch)\n\t\t\ti += adv\n\t\t} else if format[i] == '%' {\n\t\t\tval, adv := parseFsDirective(fs, path, format[i:])\n\t\t\tb.WriteString(val)\n\t\t\ti += adv\n\t\t} else {\n\t\t\tb.WriteByte(format[i])\n\t\t\ti++\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc parseFileDirective(fi *sys.FileInfo, path, s string) (string, int) {\n\tif len(s) < 2 {\n\t\treturn \"%\", 1\n\t}\n\tif s[1] == '%' {\n\t\treturn \"%\", 2\n\t}\n\tflags, width, prec, dir, adv := parseModifiers(s[1:])\n\tval := fileDirectiveValue(fi, path, dir)\n\tformatted := applyModifiers(val, flags, width, prec)\n\treturn formatted, 1 + adv\n}\n\nfunc parseFsDirective(fs *syscall.Statfs_t, path, s string) (string, int) {\n\tif len(s) < 2 {\n\t\treturn \"%\", 1\n\t}\n\tif s[1] == '%' {\n\t\treturn \"%\", 2\n\t}\n\tflags, width, prec, dir, adv := parseModifiers(s[1:])\n\tval := fsDirectiveValue(fs, path, dir)\n\tformatted := applyModifiers(val, flags, width, prec)\n\treturn formatted, 1 + adv\n}\n\nfunc parseModifiers(s string) (string, int, int, byte, int) {\n\ti := 0\n\tvar flags string\n\tfor i < len(s) && (s[i] == '-' || s[i] == '+' || s[i] == ' ' || s[i] == '0' || s[i] == '#') {\n\t\tflags += string(s[i])\n\t\ti++\n\t}\n\twidth := 0\n\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n\t\twidth = width*10 + int(s[i]-'0')\n\t\ti++\n\t}\n\tprec := -1\n\tif i < len(s) && s[i] == '.' {\n\t\ti++\n\t\tprec = 0\n\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n\t\t\tprec = prec*10 + int(s[i]-'0')\n\t\t\ti++\n\t\t}\n\t}\n\tif i >= len(s) {\n\t\treturn flags, width, prec, 0, i\n\t}\n\treturn flags, width, prec, s[i], i + 1\n}\n\nfunc applyModifiers(val string, flags string, width int, prec int) string {\n\tif width == 0 && prec < 0 && flags == \"\" {\n\t\treturn val\n\t}\n\tfmtStr := \"%\" + flags\n\tif width > 0 {\n\t\tfmtStr += strconv.Itoa(width)\n\t}\n\tif prec >= 0 {\n\t\tfmtStr += \".\" + strconv.Itoa(prec)\n\t}\n\tfmtStr += \"s\"\n\treturn fmt.Sprintf(fmtStr, val)\n}\n\nfunc fileDirectiveValue(fi *sys.FileInfo, path string, dir byte) string {\n\trawMode := rawModeFromInfo(fi)\n\tswitch dir {\n\tcase 'a':\n\t\treturn fmt.Sprintf(\"%o\", rawMode&07777)\n\tcase 'A':\n\t\treturn permString(fi.Mode)\n\tcase 'b':\n\t\treturn fmt.Sprintf(\"%d\", fi.Blocks)\n\tcase 'B':\n\t\treturn \"512\"\n\tcase 'd':\n\t\treturn fmt.Sprintf(\"%d\", fi.Dev)\n\tcase 'D':\n\t\treturn fmt.Sprintf(\"%x\", fi.Dev)\n\tcase 'f':\n\t\treturn fmt.Sprintf(\"%x\", rawMode)\n\tcase 'F':\n\t\treturn fileTypeStrSize(fi.Mode, fi.Size)\n\tcase 'g':\n\t\treturn fmt.Sprintf(\"%d\", fi.Gid)\n\tcase 'G':\n\t\treturn lookupGroup(fi.Gid)\n\tcase 'h':\n\t\treturn fmt.Sprintf(\"%d\", fi.Nlink)\n\tcase 'i':\n\t\treturn fmt.Sprintf(\"%d\", fi.Ino)\n\tcase 'm':\n\t\treturn mountPoint(path)\n\tcase 'n':\n\t\treturn path\n\tcase 'N':\n\t\treturn quotedName(fi, path)\n\tcase 'o':\n\t\treturn fmt.Sprintf(\"%d\", fi.Blksize)\n\tcase 's':\n\t\treturn fmt.Sprintf(\"%d\", fi.Size)\n\tcase 't':\n\t\treturn fmt.Sprintf(\"%x\", major(fi.Rdev))\n\tcase 'T':\n\t\treturn fmt.Sprintf(\"%x\", minor(fi.Rdev))\n\tcase 'u':\n\t\treturn fmt.Sprintf(\"%d\", fi.Uid)\n\tcase 'U':\n\t\treturn lookupUser(fi.Uid)\n\tdefault:\n\t\treturn fileTimeDirective(fi, dir)\n\t}\n}\n\nfunc fileTimeDirective(fi *sys.FileInfo, dir byte) string {\n\tbirth := birthTime(fi)\n\tswitch dir {\n\tcase 'w':\n\t\treturn formatTimeBirth(birth)\n\tcase 'W':\n\t\treturn epochBirth(birth)\n\tcase 'x':\n\t\treturn formatTime(fi.AccessTime)\n\tcase 'X':\n\t\treturn fmt.Sprintf(\"%d\", fi.AccessTime.Unix())\n\tcase 'y':\n\t\treturn formatTime(fi.ModTime)\n\tcase 'Y':\n\t\treturn fmt.Sprintf(\"%d\", fi.ModTime.Unix())\n\tcase 'z':\n\t\treturn formatTime(fi.ChangeTime)\n\tcase 'Z':\n\t\treturn fmt.Sprintf(\"%d\", fi.ChangeTime.Unix())\n\tdefault:\n\t\treturn \"%\" + string(dir)\n\t}\n}\n\nfunc fsDirectiveValue(fs *syscall.Statfs_t, path string, dir byte) string {\n\tswitch dir {\n\tcase 'a':\n\t\treturn fmt.Sprintf(\"%d\", fs.Bavail)\n\tcase 'b':\n\t\treturn fmt.Sprintf(\"%d\", fs.Blocks)\n\tcase 'c':\n\t\treturn fmt.Sprintf(\"%d\", fs.Files)\n\tcase 'd':\n\t\treturn fmt.Sprintf(\"%d\", fs.Ffree)\n\tcase 'f':\n\t\treturn fmt.Sprintf(\"%d\", fs.Bfree)\n\tcase 'i':\n\t\treturn fsIDHex(fs.Fsid)\n\tcase 'l':\n\t\treturn \"?\"\n\tcase 'n':\n\t\treturn path\n\tcase 's':\n\t\treturn fmt.Sprintf(\"%d\", fs.Bsize)\n\tcase 'S':\n\t\treturn fmt.Sprintf(\"%d\", fs.Bsize)\n\tcase 't':\n\t\treturn fmt.Sprintf(\"%x\", fs.Type)\n\tcase 'T':\n\t\treturn int8ToStr(fs.Fstypename[:])\n\tdefault:\n\t\treturn \"%\" + string(dir)\n\t}\n}\n\nfunc parseEscape(s string) (string, int) {\n\tif len(s) < 2 {\n\t\treturn \"\\\\\", 1\n\t}\n\tswitch s[1] {\n\tcase 'n':\n\t\treturn \"\\n\", 2\n\tcase 't':\n\t\treturn \"\\t\", 2\n\tcase 'r':\n\t\treturn \"\\r\", 2\n\tcase '\\\\':\n\t\treturn \"\\\\\", 2\n\tcase 'a':\n\t\treturn \"\\a\", 2\n\tcase 'b':\n\t\treturn \"\\b\", 2\n\tcase 'f':\n\t\treturn \"\\f\", 2\n\tcase 'v':\n\t\treturn \"\\v\", 2\n\tcase '0':\n\t\treturn parseOctalEscape(s)\n\tcase 'x':\n\t\treturn parseHexEscape(s)\n\tdefault:\n\t\treturn string(s[:2]), 2\n\t}\n}\n\nfunc parseOctalEscape(s string) (string, int) {\n\tn := 2\n\tval := 0\n\tfor n < len(s) && n < 5 && s[n] >= '0' && s[n] <= '7' {\n\t\tval = val*8 + int(s[n]-'0')\n\t\tn++\n\t}\n\tif n == 2 {\n\t\treturn \"\\x00\", 2\n\t}\n\treturn string(rune(val)), n\n}\n\nfunc parseHexEscape(s string) (string, int) {\n\tn := 2\n\tval := 0\n\tfor n < len(s) && n < 4 {\n\t\tc := s[n]\n\t\tif c >= '0' && c <= '9' {\n\t\t\tval = val*16 + int(c-'0')\n\t\t} else if c >= 'a' && c <= 'f' {\n\t\t\tval = val*16 + int(c-'a') + 10\n\t\t} else if c >= 'A' && c <= 'F' {\n\t\t\tval = val*16 + int(c-'A') + 10\n\t\t} else {\n\t\t\tbreak\n\t\t}\n\t\tn++\n\t}\n\tif n == 2 {\n\t\treturn \"\\\\x\", 2\n\t}\n\treturn string(rune(val)), n\n}\n\nfunc fileTypeStrSize(mode os.FileMode, size int64) string {\n\tif mode.IsRegular() && size == 0 {\n\t\treturn \"regular empty file\"\n\t}\n\treturn fileTypeStr(mode)\n}\n\nfunc fileTypeStr(mode os.FileMode) string {\n\tswitch {\n\tcase mode.IsRegular():\n\t\treturn \"regular file\"\n\tcase mode.IsDir():\n\t\treturn \"directory\"\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn \"symbolic link\"\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn \"character special file\"\n\tcase mode&os.ModeDevice != 0:\n\t\treturn \"block special file\"\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn \"fifo\"\n\tcase mode&os.ModeSocket != 0:\n\t\treturn \"socket\"\n\tdefault:\n\t\treturn \"weird file\"\n\t}\n}\n\nfunc permString(mode os.FileMode) string {\n\tvar buf [10]byte\n\tbuf[0] = fileTypeChar(mode)\n\tconst rwx = \"rwx\"\n\tperm := mode.Perm()\n\tfor i := range 9 {\n\t\tif perm&(1<<uint(8-i)) != 0 {\n\t\t\tbuf[1+i] = rwx[i%3]\n\t\t} else {\n\t\t\tbuf[1+i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(mode, &buf)\n\treturn string(buf[:])\n}\n\nfunc fileTypeChar(mode os.FileMode) byte {\n\tswitch {\n\tcase mode.IsRegular():\n\t\treturn '-'\n\tcase mode.IsDir():\n\t\treturn 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn 'l'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\treturn 'b'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\treturn 's'\n\tdefault:\n\t\treturn '?'\n\t}\n}\n\nfunc applySpecialBits(mode os.FileMode, buf *[10]byte) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif buf[3] == 'x' {\n\t\t\tbuf[3] = 's'\n\t\t} else {\n\t\t\tbuf[3] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif buf[6] == 'x' {\n\t\t\tbuf[6] = 's'\n\t\t} else {\n\t\t\tbuf[6] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif buf[9] == 'x' {\n\t\t\tbuf[9] = 't'\n\t\t} else {\n\t\t\tbuf[9] = 'T'\n\t\t}\n\t}\n}\n\nfunc formatTime(t time.Time) string {\n\treturn t.Format(\"2006-01-02 15:04:05.000000000 -0700\")\n}\n\nfunc formatTimeBirth(t time.Time) string {\n\tif t.IsZero() {\n\t\treturn \"-\"\n\t}\n\treturn formatTime(t)\n}\n\nfunc epochBirth(t time.Time) string {\n\tif t.IsZero() {\n\t\treturn \"0\"\n\t}\n\treturn fmt.Sprintf(\"%d\", t.Unix())\n}\n\nfunc birthTime(fi *sys.FileInfo) time.Time {\n\tif fi.Info == nil {\n\t\treturn time.Time{}\n\t}\n\tstat, ok := fi.Info.Sys().(*syscall.Stat_t)\n\tif !ok {\n\t\treturn time.Time{}\n\t}\n\treturn time.Unix(stat.Birthtimespec.Sec, stat.Birthtimespec.Nsec)\n}\n\nfunc rawModeFromInfo(fi *sys.FileInfo) uint16 {\n\tif fi.Info == nil {\n\t\treturn 0\n\t}\n\tstat, ok := fi.Info.Sys().(*syscall.Stat_t)\n\tif !ok {\n\t\treturn 0\n\t}\n\treturn stat.Mode\n}\n\nfunc lookupUser(uid uint32) string {\n\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n\tif err != nil {\n\t\treturn strconv.Itoa(int(uid))\n\t}\n\treturn u.Username\n}\n\nfunc lookupGroup(gid uint32) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n\tif err != nil {\n\t\treturn strconv.Itoa(int(gid))\n\t}\n\treturn g.Name\n}\n\nfunc major(dev uint64) uint64 {\n\treturn (dev >> 24) & 0xff\n}\n\nfunc minor(dev uint64) uint64 {\n\treturn dev & 0xffffff\n}\n\nfunc quoteFile(name string) string {\n\treturn \"'\" + name + \"'\"\n}\n\nfunc quotedName(fi *sys.FileInfo, path string) string {\n\tif fi.Mode&os.ModeSymlink != 0 {\n\t\ttarget, err := os.Readlink(path)\n\t\tif err != nil {\n\t\t\treturn quoteFile(path)\n\t\t}\n\t\treturn quoteFile(path) + \" -> \" + quoteFile(target)\n\t}\n\treturn quoteFile(path)\n}\n\nfunc mountPoint(path string) string {\n\tvar fs syscall.Statfs_t\n\tif err := syscall.Statfs(path, &fs); err != nil {\n\t\treturn \"?\"\n\t}\n\tmp := int8ToStr(fs.Mntonname[:])\n\tif mp == \"/System/Volumes/Data\" {\n\t\treturn \"/\"\n\t}\n\treturn mp\n}\n\nfunc int8ToStr(arr []int8) string {\n\tbuf := make([]byte, 0, len(arr))\n\tfor _, v := range arr {\n\t\tif v == 0 {\n\t\t\tbreak\n\t\t}\n\t\tbuf = append(buf, byte(v))\n\t}\n\treturn string(buf)\n}\n\nfunc fsIDHex(fsid syscall.Fsid) string {\n\treturn fmt.Sprintf(\"%x\", uint64(uint32(fsid.Val[0]))<<32|uint64(uint32(fsid.Val[1])))\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar files []string\n\tendFlags := false\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif endFlags || !strings.HasPrefix(arg, \"-\") {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tadv, err := parseLongFlag(arg, args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn options{}, nil, err\n\t\t\t}\n\t\t\ti += adv\n\t\t\tcontinue\n\t\t}\n\t\tadv, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\tif err != nil {\n\t\t\treturn options{}, nil, err\n\t\t}\n\t\ti += adv\n\t}\n\treturn opts, files, nil\n}\n\nfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n\tif strings.HasPrefix(flag, \"--format=\") {\n\t\topts.format = flag[len(\"--format=\"):]\n\t\treturn 0, nil\n\t}\n\tif strings.HasPrefix(flag, \"--printf=\") {\n\t\topts.printf = flag[len(\"--printf=\"):]\n\t\treturn 0, nil\n\t}\n\tswitch flag {\n\tcase \"--format\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\topts.format = rest[0]\n\t\treturn 1, nil\n\tcase \"--printf\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\topts.printf = rest[0]\n\t\treturn 1, nil\n\tcase \"--dereference\":\n\t\topts.dereference = true\n\tcase \"--file-system\":\n\t\topts.fileSystem = true\n\tcase \"--terse\":\n\t\topts.terse = true\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n\treturn 0, nil\n}\n\nfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n\tfor i, ch := range flags {\n\t\tswitch ch {\n\t\tcase 'L':\n\t\t\topts.dereference = true\n\t\tcase 'f':\n\t\t\topts.fileSystem = true\n\t\tcase 't':\n\t\t\topts.terse = true\n\t\tcase 'c':\n\t\t\tremaining := flags[i+1:]\n\t\t\tif remaining != \"\" {\n\t\t\t\topts.format = remaining\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(rest) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'c'\")\n\t\t\t}\n\t\t\topts.format = rest[0]\n\t\t\treturn 1, nil\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", ch)\n\t\t}\n\t}\n\treturn 0, nil\n}\n","numLines":812,"startLine":1,"totalLines":812}}}
