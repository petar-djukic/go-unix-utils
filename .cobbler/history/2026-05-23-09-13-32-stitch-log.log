me: \"terse-link\",\n\t\t\tArgs: []string{\"-t\", link},\n\t\t},\n\t\t{\n\t\t\tName: \"fs-default\",\n\t\t\tArgs:      []string{\"-f\", tmpDir},\n\t\t\tNormalize: normFS,\n\t\t},\n\t\t{\n\t\t\tName: \"fs-format\",\n\t\t\tArgs:      []string{\"-f\", \"-c\", \"%T %a %b %c %d %f\", tmpDir},\n\t\t\tNormalize: normFS,\n\t\t},\n\t\t{\n\t\t\tName: \"fs-terse\",\n\t\t\tArgs:      []string{\"-f\", \"-t\", tmpDir},\n\t\t\tNormalize: normFS,\n\t\t},\n\t\t{\n\t\t\tName:      \"nonexistent\",\n\t\t\tArgs:      []string{filepath.Join(tmpDir, \"nonexistent\")},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: normErr,\n\t\t},\n\t\t{\n\t\t\tName:      \"mixed-error\",\n\t\t\tArgs:      []string{tmpFile, filepath.Join(tmpDir, \"nonexistent\"), emptyFile},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: normErr,\n\t\t},\n\t\t{\n\t\t\tName:      \"invalid-flag\",\n\t\t\tArgs:      []string{\"-Z\"},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: normErr,\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n","numLines":196,"startLine":1,"totalLines":196}}}
