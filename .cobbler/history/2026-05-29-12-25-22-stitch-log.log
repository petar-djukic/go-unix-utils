{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CHEx5RbFeSXqwFLFTs47Mr","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd004-ts R1.1, R1.2, R1.3, R1.4, R1.5, R1.6, R2.1, R2.2, R2.3, R2.4, R3.1, R3.2, R3.3, R3.4, R4.1, R4.2, R4.3, R5.1, R5.2, R5.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst defaultFormat = \"%b %d %H:%M:%S\"\n19\tconst defaultIncrementalFormat = \"%H:%M:%S\"\n20\t\n21\tfunc main() {\n22\t\tsys.InstallSIGPIPEHandler()\n23\t\tos.Exit(run())\n24\t}\n25\t\n26\ttype config struct {\n27\t\tformat      string\n28\t\tincremental bool\n29\t\tsinceStart  bool\n30\t\tmonotonic   bool\n31\t}\n32\t\n33\tfunc run() int {\n34\t\tcfg, err := parseArgs(os.Args[1:])\n35\t\tif err != nil {\n36\t\t\tfmt.Fprintln(os.Stderr, err)\n37\t\t\treturn 1\n38\t\t}\n39\t\n40\t\tvar gmt *time.Location\n41\t\tif cfg.incremental || cfg.sinceStart {\n42\t\t\tgmt = time.FixedZone(\"GMT\", 0)\n43\t\t}\n44\t\n45\t\tstartTime := time.Now()\n46\t\tprevTime := startTime\n47\t\treader := bufio.NewReader(os.Stdin)\n48\t\tfor {\n49\t\t\tline, readErr := reader.ReadString('\\n')\n50\t\t\tif len(line) > 0 {\n51\t\t\t\tnow := time.Now()\n52\t\t\t\tvar ts string\n53\t\t\t\tif cfg.incremental {\n54\t\t\t\t\tdelta := now.Sub(prevTime)\n55\t\t\t\t\tprevTime = now\n56\t\t\t\t\tepoch := time.Unix(0, 0).In(gmt).Add(delta)\n57\t\t\t\t\tts = formatTime(epoch, cfg.format)\n58\t\t\t\t} else if cfg.sinceStart {\n59\t\t\t\t\tdelta := now.Sub(startTime)\n60\t\t\t\t\tepoch := time.Unix(0, 0).In(gmt).Add(delta)\n61\t\t\t\t\tts = formatTime(epoch, cfg.format)\n62\t\t\t\t} else {\n63\t\t\t\t\tts = formatTime(now, cfg.format)\n64\t\t\t\t}\n65\t\t\t\tfmt.Fprintf(os.Stdout, \"%s %s\", ts, line)\n66\t\t\t}\n67\t\t\tif readErr != nil {\n68\t\t\t\tbreak\n69\t\t\t}\n70\t\t}\n71\t\treturn 0\n72\t}\n73\t\n74\tfunc parseArgs(args []string) (config, error) {\n75\t\tcfg := config{}\n76\t\tvar customFormat string\n77\t\tfor _, arg := range args {\n78\t\t\tif arg == \"-i\" {\n79\t\t\t\tcfg.incremental = true\n80\t\t\t} else if arg == \"-s\" {\n81\t\t\t\tcfg.sinceStart = true\n82\t\t\t} else if arg == \"-m\" {\n83\t\t\t\tcfg.monotonic = true\n84\t\t\t} else if strings.HasPrefix(arg, \"-\") {\n85\t\t\t\treturn config{}, fmt.Errorf(\"usage: ts [-i | -s] [-m] [format]\")\n86\t\t\t} else {\n87\t\t\t\tcustomFormat = arg\n88\t\t\t}\n89\t\t}\n90\t\tif cfg.incremental && cfg.sinceStart {\n91\t\t\treturn config{}, fmt.Errorf(\"usage: ts [-i | -s] [-m] [format]\")\n92\t\t}\n93\t\tif customFormat != \"\" {\n94\t\t\tcfg.format = customFormat\n95\t\t} else if cfg.incremental || cfg.sinceStart {\n96\t\t\tcfg.format = defaultIncrementalFormat\n97\t\t} else {\n98\t\t\tcfg.format = defaultFormat\n99\t\t}\n100\t\treturn cfg, nil\n101\t}\n102\t\n103\tfunc formatTime(t time.Time, format string) string {\n104\t\tvar b strings.Builder\n105\t\tb.Grow(len(format) * 2)\n106\t\ti := 0\n107\t\tfor i < len(format) {\n108\t\t\tif format[i] != '%' {\n109\t\t\t\tb.WriteByte(format[i])\n110\t\t\t\ti++\n111\t\t\t\tcontinue\n112\t\t\t}\n113\t\t\ti++\n114\t\t\tif i >= len(format) {\n115\t\t\t\tb.WriteByte('%')\n116\t\t\t\tbreak\n117\t\t\t}\n118\t\t\tif format[i] == '.' {\n119\t\t\t\ti++\n120\t\t\t\tif i >= len(format) {\n121\t\t\t\t\tb.WriteByte('%')\n122\t\t\t\t\tb.WriteByte('.')\n123\t\t\t\t\tbreak\n124\t\t\t\t}\n125\t\t\t\tb.WriteString(subsecondSpec(t, format[i]))\n126\t\t\t\ti++\n127\t\t\t\tcontinue\n128\t\t\t}\n129\t\t\tvar mod byte\n130\t\t\tif format[i] == '-' || format[i] == '_' || format[i] == '0' {\n131\t\t\t\tmod = format[i]\n132\t\t\t\ti++\n133\t\t\t\tif i >= len(format) {\n134\t\t\t\t\tb.WriteByte('%')\n135\t\t\t\t\tb.WriteByte(mod)\n136\t\t\t\t\tbreak\n137\t\t\t\t}\n138\t\t\t}\n139\t\t\tb.WriteString(formatSpec(t, format[i], mod))\n140\t\t\ti++\n141\t\t}\n142\t\treturn b.String()\n143\t}\n144\t\n145\tfunc subsecondSpec(t time.Time, spec byte) string {\n146\t\tusec := t.Nanosecond() / 1000\n147\t\tfrac := fmt.Sprintf(\".%06d\", usec)\n148\t\tswitch spec {\n149\t\tcase 'S':\n150\t\t\treturn fmt.Sprintf(\"%02d\", t.Second()) + frac\n151\t\tcase 's':\n152\t\t\treturn strconv.FormatInt(t.Unix(), 10) + frac\n153\t\tcase 'T':\n154\t\t\treturn fmt.Sprintf(\"%02d:%02d:%02d\", t.Hour(), t.Minute(), t.Second()) + frac\n155\t\tdefault:\n156\t\t\treturn \"%.\" + string(spec)\n157\t\t}\n158\t}\n159\t\n160\tfunc formatSpec(t time.Time, spec, mod byte) string {\n161\t\traw, width, pad := specValue(t, spec)\n162\t\treturn padValue(raw, width, pad, mod)\n163\t}\n164\t\n165\tfunc specValue(t time.Time, spec byte) (string, int, byte) {\n166\t\tif raw, w, p, ok := numSpec(t, spec); ok {\n167\t\t\treturn raw, w, p\n168\t\t}\n169\t\tif raw, ok := textSpec(t, spec); ok {\n170\t\t\treturn raw, 0, 0\n171\t\t}\n172\t\tif raw, ok := compositeSpec(t, spec); ok {\n173\t\t\treturn raw, 0, 0\n174\t\t}\n175\t\treturn \"%\" + string(spec), 0, 0\n176\t}\n177\t\n178\tfunc numSpec(t time.Time, spec byte) (string, int, byte, bool) {\n179\t\tswitch spec {\n180\t\tcase 'Y':\n181\t\t\treturn strconv.Itoa(t.Year()), 4, '0', true\n182\t\tcase 'C':\n183\t\t\treturn strconv.Itoa(t.Year() / 100), 2, '0', true\n184\t\tcase 'y':\n185\t\t\treturn strconv.Itoa(t.Year() % 100), 2, '0', true\n186\t\tcase 'm':\n187\t\t\treturn strconv.Itoa(int(t.Month())), 2, '0', true\n188\t\tcase 'd':\n189\t\t\treturn strconv.Itoa(t.Day()), 2, '0', true\n190\t\tcase 'e':\n191\t\t\treturn strconv.Itoa(t.Day()), 2, ' ', true\n192\t\tcase 'H':\n193\t\t\treturn strconv.Itoa(t.Hour()), 2, '0', true\n194\t\tcase 'k':\n195\t\t\treturn strconv.Itoa(t.Hour()), 2, ' ', true\n196\t\tcase 'I':\n197\t\t\treturn strconv.Itoa(hour12(t)), 2, '0', true\n198\t\tcase 'l':\n199\t\t\treturn strconv.Itoa(hour12(t)), 2, ' ', true\n200\t\tcase 'M':\n201\t\t\treturn strconv.Itoa(t.Minute()), 2, '0', true\n202\t\tcase 'S':\n203\t\t\treturn strconv.Itoa(t.Second()), 2, '0', true\n204\t\tcase 'j':\n205\t\t\treturn strconv.Itoa(t.YearDay()), 3, '0', true\n206\t\tcase 'N':\n207\t\t\treturn strconv.Itoa(t.Nanosecond()), 9, '0', true\n208\t\tcase 's':\n209\t\t\treturn strconv.FormatInt(t.Unix(), 10), 0, 0, true\n210\t\tcase 'u':\n211\t\t\td := int(t.Weekday())\n212\t\t\tif d == 0 {\n213\t\t\t\td = 7\n214\t\t\t}\n215\t\t\treturn strconv.Itoa(d), 0, 0, true\n216\t\tcase 'w':\n217\t\t\treturn strconv.Itoa(int(t.Weekday())), 0, 0, true\n218\t\tcase 'U':\n219\t\t\tyday := t.YearDay()\n220\t\t\twday := int(t.Weekday())\n221\t\t\treturn strconv.Itoa((yday + 6 - wday) / 7), 2, '0', true\n222\t\tcase 'W':\n223\t\t\tyday := t.YearDay()\n224\t\t\twday := int(t.Weekday())\n225\t\t\tif wday == 0 {\n226\t\t\t\twday = 7\n227\t\t\t}\n228\t\t\treturn strconv.Itoa((yday + 6 - (wday - 1)) / 7), 2, '0', true\n229\t\tcase 'V':\n230\t\t\t_, week := t.ISOWeek()\n231\t\t\treturn strconv.Itoa(week), 2, '0', true\n232\t\tcase 'G':\n233\t\t\tyear, _ := t.ISOWeek()\n234\t\t\treturn strconv.Itoa(year), 4, '0', true\n235\t\tcase 'g':\n236\t\t\tyear, _ := t.ISOWeek()\n237\t\t\treturn strconv.Itoa(year % 100), 2, '0', true\n238\t\tdefault:\n239\t\t\treturn \"\", 0, 0, false\n240\t\t}\n241\t}\n242\t\n243\tfunc textSpec(t time.Time, spec byte) (string, bool) {\n244\t\tswitch spec {\n245\t\tcase 'a':\n246\t\t\treturn t.Format(\"Mon\"), true\n247\t\tcase 'A':\n248\t\t\treturn t.Format(\"Monday\"), true\n249\t\tcase 'b', 'h':\n250\t\t\treturn t.Format(\"Jan\"), true\n251\t\tcase 'B':\n252\t\t\treturn t.Format(\"January\"), true\n253\t\tcase 'Z':\n254\t\t\treturn t.Format(\"MST\"), true\n255\t\tcase 'z':\n256\t\t\treturn t.Format(\"-0700\"), true\n257\t\tcase 'p':\n258\t\t\treturn t.Format(\"PM\"), true\n259\t\tcase 'P':\n260\t\t\treturn strings.ToLower(t.Format(\"PM\")), true\n261\t\tcase 'n':\n262\t\t\treturn \"\\n\", true\n263\t\tcase 't':\n264\t\t\treturn \"\