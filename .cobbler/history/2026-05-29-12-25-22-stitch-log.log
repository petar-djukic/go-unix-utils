\ttests := []testutils.DiffTest{\n\t\t{Name: \"default_multiline\", Stdin: []byte(\"alpha\\nbeta\\ngamma\\n\"), Normalize: norm},\n\t\t{Name: \"single_line\", Stdin: []byte(\"hello\\n\"), Normalize: norm},\n\t\t{Name: \"partial_last_line\", Stdin: []byte(\"complete\\npartial\"), Normalize: norm},\n\t\t{Name: \"empty_stdin\", Stdin: []byte{}},\n\t\t{Name: \"custom_format_iso\", Args: []string{\"%Y-%m-%d %H:%M:%S\"}, Stdin: []byte(\"test\\n\"), Normalize: norm},\n\t\t{Name: \"custom_format_time\", Args: []string{\"%H:%M:%S\"}, Stdin: []byte(\"test\\n\"), Normalize: norm},\n\t\t{Name: \"custom_format_T\", Args: []string{\"%T\"}, Stdin: []byte(\"test\\n\"), Normalize: norm},\n\t\t{Name: \"subsecond_S\", Args: []string{\"%.S\"}, Stdin: []byte(\"test\\n\"), Normalize: subsecNorm},\n\t\t{Name: \"subsecond_s\", Args: []string{\"%.s\"}, Stdin: []byte(\"test\\n\"), Normalize: subsecNorm},\n\t\t{Name: \"subsecond_T\", Args: []string{\"%.T\"}, Stdin: []byte(\"test\\n\"), Normalize: subsecNorm},\n\t\t{Name: \"incremental_default\", Args: []string{\"-i\"}, Stdin: []byte(\"a\\nb\\nc\\n\"), Normalize: elapsedNorm},\n\t\t{Name: \"incremental_custom_format\", Args: []string{\"-i\", \"%.S\"}, Stdin: []byte(\"x\\ny\\n\"), Normalize: subsecNorm},\n\t\t{Name: \"sincestart_default\", Args: []string{\"-s\"}, Stdin: []byte(\"a\\nb\\nc\\n\"), Normalize: elapsedNorm},\n\t\t{Name: \"sincestart_custom_format\", Args: []string{\"-s\", \"%.S\"}, Stdin: []byte(\"x\\ny\\n\"), Normalize: subsecNorm},\n\t\t{Name: \"sincestart_empty_stdin\", Args: []string{\"-s\"}, Stdin: []byte{}},\n\t\t{Name: \"sincestart_custom_T\", Args: []string{\"-s\", \"%T\"}, Stdin: []byte(\"a\\nb\\n\"), Normalize: elapsedNorm},\n\t\t{Name: \"monotonic_default\", Args: []string{\"-m\"}, Stdin: []byte(\"a\\nb\\n\"), Normalize: norm},\n\t\t{Name: \"monotonic_incremental\", Args: []string{\"-m\", \"-i\"}, Stdin: []byte(\"a\\nb\\nc\\n\"), Normalize: elapsedNorm},\n\t\t{Name: \"monotonic_sincestart\", Args: []string{\"-m\", \"-s\"}