{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A3eH8EGd1P5LPT9RMAKHxJ","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/ptx implements srd111-ptx: produce a permuted (KWIC) index of text input.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"regexp\"\n14\t\t\"sort\"\n15\t\t\"strconv\"\n16\t\t\"strings\"\n17\t\t\"syscall\"\n18\t\t\"unicode\"\n19\t\t\"unicode/utf8\"\n20\t\n21\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n22\t)\n23\t\n24\tconst (\n25\t\tdefaultWidth   = 72\n26\t\tdefaultGapSize = 3\n27\t)\n28\t\n29\ttype options struct {\n30\t\twidth      int\n31\t\tgapSize    int\n32\t\tignoreCase bool\n33\t\tautoRef    bool\n34\t\treferences bool\n35\t\twordRegexp *regexp.Regexp\n36\t\tfiles      []string\n37\t}\n38\t\n39\ttype entry struct {\n40\t\tbefore  string\n41\t\tkwAfter string\n42\t\tsortKey string\n43\t\tref     string\n44\t}\n45\t\n46\ttype wordSpan struct {\n47\t\tstart, end int\n48\t}\n49\t\n50\ttype inputLine struct {\n51\t\ttext    string\n52\t\tfile    string\n53\t\tlineNum int\n54\t}\n55\t\n56\tfunc main() {\n57\t\tsys.InstallSIGPIPEHandler()\n58\t\n59\t\topts, err := parseArgs(os.Args[1:])\n60\t\tif err != nil {\n61\t\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", err)\n62\t\t\tos.Exit(1)\n63\t\t}\n64\t\n65\t\tlines, err := readAllLines(opts.files)\n66\t\tif err != nil {\n67\t\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n68\t\t\tos.Exit(1)\n69\t\t}\n70\t\n71\t\tentries := buildIndex(lines, &opts)\n72\t\tsort.SliceStable(entries, func(i, j int) bool {\n73\t\t\treturn entries[i].sortKey < entries[j].sortKey\n74\t\t})\n75\t\n76\t\tif err := writeOutput(entries, opts.width, opts.gapSize); err != nil {\n77\t\t\tif errors.Is(err, syscall.EPIPE) {\n78\t\t\t\tos.Exit(0)\n79\t\t\t}\n80\t\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n81\t\t\tos.Exit(1)\n82\t\t}\n83\t}\n84\t\n85\tfunc parseArgs(args []string) (options, error) {\n86\t\topts := options{\n87\t\t\twidth:   defaultWidth,\n88\t\t\tgapSize: defaultGapSize,\n89\t\t}\n90\t\ti := 0\n91\t\tfor i < len(args) {\n92\t\t\ta := args[i]\n93\t\t\tif a == \"--\" {\n94\t\t\t\ti++\n95\t\t\t\tbreak\n96\t\t\t}\n97\t\t\tif strings.HasPrefix(a, \"--\") {\n98\t\t\t\tn, err := parseLongFlag(a, args[i+1:], &opts)\n99\t\t\t\tif err != nil {\n100\t\t\t\t\treturn opts, err\n101\t\t\t\t}\n102\t\t\t\ti += 1 + n\n103\t\t\t\tcontinue\n104\t\t\t}\n105\t\t\tif a != \"-\" && strings.HasPrefix(a, \"-\") {\n106\t\t\t\tn, err := parseShortFlags(a[1:], args[i+1:], &opts)\n107\t\t\t\tif err != nil {\n108\t\t\t\t\treturn opts, err\n109\t\t\t\t}\n110\t\t\t\ti += 1 + n\n111\t\t\t\tcontinue\n112\t\t\t}\n113\t\t\tbreak\n114\t\t}\n115\t\topts.files = args[i:]\n116\t\tif len(opts.files) == 0 {\n117\t\t\topts.files = []string{\"-\"}\n118\t\t}\n119\t\treturn opts, nil\n120\t}\n121\t\n122\tfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n123\t\tif flag == \"--ignore-case\" {\n124\t\t\topts.ignoreCase = true\n125\t\t\treturn 0, nil\n126\t\t}\n127\t\tif flag == \"--auto-reference\" {\n128\t\t\topts.autoRef = true\n129\t\t\treturn 0, nil\n130\t\t}\n131\t\tif flag == \"--references\" {\n132\t\t\topts.references = true\n133\t\t\treturn 0, nil\n134\t\t}\n135\t\tif strings.HasPrefix(flag, \"--width=\") {\n136\t\t\treturn 0, parseIntVal(flag[len(\"--width=\"):], &opts.width, \"width\")\n137\t\t}\n138\t\tif flag == \"--width\" {\n139\t\t\tif len(rest) == 0 {\n140\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n141\t\t\t}\n142\t\t\treturn 1, parseIntVal(rest[0], &opts.width, \"width\")\n143\t\t}\n144\t\tif strings.HasPrefix(flag, \"--gap-size=\") {\n145\t\t\treturn 0, parseIntVal(flag[len(\"--gap-size=\"):], &opts.gapSize, \"gap-size\")\n146\t\t}\n147\t\tif flag == \"--gap-size\" {\n148\t\t\tif len(rest) == 0 {\n149\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n150\t\t\t}\n151\t\t\treturn 1, parseIntVal(rest[0], &opts.gapSize, \"gap-size\")\n152\t\t}\n153\t\tif strings.HasPrefix(flag, \"--word-regexp=\") {\n154\t\t\treturn 0, parseRegexpVal(flag[len(\"--word-regexp=\"):], &opts.wordRegexp)\n155\t\t}\n156\t\tif flag == \"--word-regexp\" {\n157\t\t\tif len(rest) == 0 {\n158\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n159\t\t\t}\n160\t\t\treturn 1, parseRegexpVal(rest[0], &opts.wordRegexp)\n161\t\t}\n162\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n163\t}\n164\t\n165\tfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n166\t\tfor i := 0; i < len(flags); i++ {\n167\t\t\tswitch flags[i] {\n168\t\t\tcase 'f':\n169\t\t\t\topts.ignoreCase = true\n170\t\t\tcase 'A':\n171\t\t\t\topts.autoRef = true\n172\t\t\tcase 'r':\n173\t\t\t\topts.references = true\n174\t\t\tcase 'w':\n175\t\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.width, 'w')\n176\t\t\tcase 'g':\n177\t\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.gapSize, 'g')\n178\t\t\tcase 'W':\n179\t\t\t\treturn extractAndSetRegexp(flags[i+1:], rest, &opts.wordRegexp)\n180\t\t\tdefault:\n181\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[i])\n182\t\t\t}\n183\t\t}\n184\t\treturn 0, nil\n185\t}\n186\t\n187\tfunc extractAndSetInt(tail string, rest []string, dst *int, flag byte) (int, error) {\n188\t\tval, consumed, err := extractFlagValue(tail, rest, flag)\n189\t\tif err != nil {\n190\t\t\treturn 0, err\n191\t\t}\n192\t\tif err := parseIntVal(val, dst, string(flag)); err != nil {\n193\t\t\treturn 0, err\n194\t\t}\n195\t\treturn consumed, nil\n196\t}\n197\t\n198\tfunc extractFlagValue(tail string, rest []string, flag byte) (string, int, error) {\n199\t\tif tail != \"\" {\n200\t\t\treturn tail, 0, nil\n201\t\t}\n202\t\tif len(rest) > 0 {\n203\t\t\treturn rest[0], 1, nil\n204\t\t}\n205\t\treturn \"\", 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n206\t}\n207\t\n208\tfunc extractAndSetRegexp(tail string, rest []string, dst **regexp.Regexp) (int, error) {\n209\t\tval, consumed, err := extractFlagValue(tail, rest, 'W')\n210\t\tif err != nil {\n211\t\t\treturn 0, err\n212\t\t}\n213\t\tif err := parseRegexpVal(val, dst); err != nil {\n214\t\t\treturn 0, err\n215\t\t}\n216\t\treturn consumed, nil\n217\t}\n218\t\n219\tfunc parseRegexpVal(s string, dst **regexp.Regexp) error {\n220\t\tre, err := regexp.Compile(s)\n221\t\tif err != nil {\n222\t\t\treturn fmt.Errorf(\"invalid word regexp '%s': %s\", s, err)\n223\t\t}\n224\t\t*dst = re\n225\t\treturn nil\n226\t}\n227\t\n228\tfunc parseIntVal(s string, dst *int, name string) error {\n229\t\tv, err := strconv.Atoi(s)\n230\t\tif err != nil {\n231\t\t\treturn fmt.Errorf(\"invalid %s argument '%s'\", name, s)\n232\t\t}\n233\t\t*dst = v\n234\t\treturn nil\n235\t}\n236\t\n237\tfunc readAllLines(names []string) ([]inputLine, error) {\n238\t\tvar all []inputLine\n239\t\tfor _, name := range names {\n240\t\t\tlines, err := readFile(name)\n241\t\t\tif err != nil {\n242\t\t\t\treturn nil, err\n243\t\t\t}\n244\t\t\tfor i, text := range lines {\n245\t\t\t\tall = append(all, inputLine{text: text, file: name, lineNum: i + 1})\n246\t\t\t}\n247\t\t}\n248\t\treturn all, nil\n249\t}\n250\t\n251\tfunc readFile(name string) ([]string, error) {\n252\t\tvar r io.Reader\n253\t\tif name == \"-\" {\n254\t\t\tr = os.Stdin\n255\t\t} else {\n256\t\t\tf, err := os.Open(name)\n257\t\t\tif err != nil {\n258\t\t\t\treturn nil, err\n259\t\t\t}\n260\t\t\tdefer f.Close()\n261\t\t\tr = f\n262\t\t}\n263\t\tsc := bufio.NewScanner(r)\n264\t\tvar lines []string\n265\t\tfor sc.Scan() {\n266\t\t\tlines = append(lines, sc.Text())\n267\t\t}\n268\t\treturn lines, sc.Err()\n269\t}\n270\t\n271\tfunc buildIndex(lines []inputLine, opts *options) []entry {\n272\t\tvar entries []entry\n273\t\tfor _, il := range lines {\n274\t\t\ttext := il.text\n275\t\t\tvar ref string\n276\t\t\tif opts.references {\n277\t\t\t\tref, text = splitReference(text)\n278\t\t\t}\n279\t\t\tif opts.autoRef {\n280\t\t\t\tref = formatAutoRef(il.file, il.lineNum)\n281\t\t\t}\n282\t\t\tfor _, w := range findWords(text, opts.wordRegexp) {\n283\t\t\t\tsk := text[w.start:w.end]\n284\t\t\t\tif opts.ignoreCase {\n285\t\t\t\t\tsk = strings.ToUpper(sk)\n286\t\t\t\t}\n287\t\t\t\tentries = append(entries, entry{\n288\t\t\t\t\tbefore:  text[:w.start],\n289\t\t\t\t\tkwAfter: text[w.start:],\n290\t\t\t\t\tsortKey: sk,\n291\t\t\t\t\tref:     ref,\n292\t\t\t\t})\n293\t\t\t}\n294\t\t}\n295\t\treturn entries\n296\t}\n297\t\n298\tfunc findWords(line string, wordRe *regexp.Regexp) []wordSpan {\n299\t\tif wordRe != nil {\n300\t\t\treturn findWordsRegexp(line, wordRe)\n301\t\t}\n302\t\tvar spans []wordSpan\n303\t\ti := 0\n304\t\tfor i < len(line) {\n305\t\t\tr, size := utf8.DecodeRuneInString(line[i:])\n306\t\t\tif !isWordChar(r) {\n307\t\t\t\ti += size\n308\t\t\t\tcontinue\n309\t\t\t}\n310\t\t\tstart := i\n311\t\t\tfor i < len(line) {\n312\t\t\t\tr, size = utf8.DecodeRuneInString(line[i:])\n313\t\t\t\tif !isWordChar(r) {\n314\t\t\t\t\tbreak\n315\t\t\t\t}\n316\t\t\t\ti += size\n317\t\t\t}\n318\t\t\tspans = append(spans, wordSpan{start, i})\n319\t\t}\n320\t\treturn spans\n321\t}\n322\t\n323\tfunc findWordsRegexp(line string, re *regexp.Regexp) []wordSpan {\n324\t\tlocs := re.FindAllStringIndex(line, -1)\n325\t\tspans := make([]wordSpan, len(locs))\n326\t\tfor i, loc := range locs {\n327\t\t\tspans[i] = wordSpan{loc[0], loc[1]}\n328\t\t}\n329\t\treturn spans\n330\t}\n331\t\n332\tfunc isWordChar(r rune) bool {\n333\t\treturn unicode.IsLetter(r)\n334\t}\n335\t\n336\tfunc writeOutput(entries []entry, width, gapSize int) error {\n337\t\tw := bufio.NewWriter(os.Stdout)\n338\t\trefMax := maxRefWidth(entries)\n339\t\tkwicWidth := width\n340\t\tif refMax > 0 {\n341\t\t\tkwicWidth = width - refMax - gapSize\n342\t\t}\n343\t\thalf := kwicWidth / 2\n344\t\trightMax := kwicWidth - half - gapSize\n345\t\tfor _, e := range entries {\n346\t\t\tline := formatEntry(e, half, gapSize, rightMax, refMax)\n347\t\t\tif _, err := w.WriteString(line); err != nil {\n348\t\t\t\treturn err\n349\t\t\t}\n350\t\t\tif err := w.WriteByte('\\n'); err != nil {\n351\t\t\t\treturn err\n352\t\t\t}\n353\t\t}\n354\t\treturn w.Flush()\n355\t}\n356\t\n357\tfunc formatEntry(e entry, half, gapSize, rightMax, refMax int) string {\n358\t\tleft := strings.TrimRight(e.before, \" \")\n359\t\tleftMax := max(half-gapSize, 0)\n360\t\tif len(left) > leftMax {\n361\t\t\tleft = left[len(left)-leftMax:]\n362\t\t}\n363\t\tright := e.kwAfter\n364\t\tif rightMax > 0 && len(right) > rightMax {\n365\t\t\tright = right[:rightMax]\n366\t\t}\n367\t\tvar buf strings.Builder\n368\t\tif refMax > 0 {\n369\t\t\tbuf.WriteString(e.ref)\n370\t\t\twriteSpaces(&buf, refMax-len(e.ref)+gapSize)\n371\t\t}\n372\t\twriteSpaces(&buf, half-len(left))\n373\t\tbuf.WriteString(left)\n374\t\twriteSpaces(&buf, gapSize)\n375\t\tbuf.WriteString(right)\n376\t\treturn buf.String()\n377\t}\n378\t\n379\tfunc writeSpaces(b *strings.Builder, n int) {\n380\t\tfor range n {\n381\t\t\tb.WriteByte(' ')\n382\t\t}\n383\t}\n384\t\n385\tfunc splitReference(line string) (string, string) {\n386\t\ti := strings.IndexAny(line, \" \\t\")\n387\t\tif i < 0 {\n388\t\t\treturn line, \"\"\n389\t\t}\n390\t\tref := line[:i]\n391\t\trest := line[i:]\n392\t\tj := 0\n393\t\tfor j < len(rest) && (rest[j] == ' ' || rest[j] == '\\t') {\n394\t\t\tj++\n395\t\t}\n396\t\treturn ref, rest[j:]\n397\t}\n398\t\n399\tfunc formatAutoRef(file string, lineNum int) string {\n400\t\tif file == \"-\" {\n401\t\t\tfile = \"\"\n402\t\t}\n403\t\treturn file + \":\" + strconv.Itoa(lineNum)\n404\t}\n405\t\n406\tfunc maxRefWidth(entries []entry) int {\n407\t\tm := 0\n408\t\tfor _, e := range entries {\n409\t\t\tif len(e.ref) > m {\n410\t\t\t\tm = len(e.ref)\n411\t\t\t}\n412\t\t}\n413\t\treturn m\n414\t}\n415\t\n416\tfunc formatErr(err error) string {\n417\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n418\t\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n419\t\t}\n420\t\treturn err.Error()\n421\t}\n422\t"}]},"parent_tool_use_id":null,"session_id":"92eb9d44-3100-4344-b576-e8e69ede5b06","uuid":"b58ffc65-01d6-4a81-a464-b8d277131594","timestamp":"2026-05-30T16:41:05.925Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5675/cmd/ptx/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/ptx implements srd111-ptx: produce a permuted (KWIC) index of text input.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst (\n\tdefaultWidth   = 72\n\tdefaultGapSize = 3\n)\n\ntype options struct {\n\twidth      int\n\tgapSize    int\n\tignoreCase bool\n\tautoRef    bool\n\treferences bool\n\twordRegexp *regexp.Regexp\n\tfiles      []string\n}\n\ntype entry struct {\n\tbefore  string\n\tkwAfter string\n\tsortKey string\n\tref     string\n}\n\ntype wordSpan struct {\n\tstart, end int\n}\n\ntype inputLine struct {\n\ttext    string\n\tfile    string\n\tlineNum int\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tlines, err := readAllLines(opts.files)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n\t\tos.Exit(1)\n\t}\n\n\tentries := buildIndex(lines, &opts)\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\treturn entries[i].sortKey < entries[j].sortKey\n\t})\n\n\tif err := writeOutput(entries, opts.width, opts.gapSize); err != nil {\n\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\tos.Exit(0)\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) (options, error) {\n\topts := options{\n\t\twidth:   defaultWidth,\n\t\tgapSize: defaultGapSize,\n\t}\n\ti := 0\n\tfor i < len(args) {\n\t\ta := args[i]\n\t\tif a == \"--\" {\n\t\t\ti++\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(a, \"--\") {\n\t\t\tn, err := parseLongFlag(a, args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\tif a != \"-\" && strings.HasPrefix(a, \"-\") {\n\t\t\tn, err := parseShortFlags(a[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\tbreak\n\t}\n\topts.files = args[i:]\n\tif len(opts.files) == 0 {\n\t\topts.files = []string{\"-\"}\n\t}\n\treturn opts, nil\n}\n\nfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n\tif flag == \"--ignore-case\" {\n\t\topts.ignoreCase = true\n\t\treturn 0, nil\n\t}\n\tif flag == \"--auto-reference\" {\n\t\topts.autoRef = true\n\t\treturn 0, nil\n\t}\n\tif flag == \"--references\" {\n\t\topts.references = true\n\t\treturn 0, nil\n\t}\n\tif strings.HasPrefix(flag, \"--width=\") {\n\t\treturn 0, parseIntVal(flag[len(\"--width=\"):], &opts.width, \"width\")\n\t}\n\tif flag == \"--width\" {\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\treturn 1, parseIntVal(rest[0], &opts.width, \"width\")\n\t}\n\tif strings.HasPrefix(flag, \"--gap-size=\") {\n\t\treturn 0, parseIntVal(flag[len(\"--gap-size=\"):], &opts.gapSize, \"gap-size\")\n\t}\n\tif flag == \"--gap-size\" {\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\treturn 1, parseIntVal(rest[0], &opts.gapSize, \"gap-size\")\n\t}\n\tif strings.HasPrefix(flag, \"--word-regexp=\") {\n\t\treturn 0, parseRegexpVal(flag[len(\"--word-regexp=\"):], &opts.wordRegexp)\n\t}\n\tif flag == \"--word-regexp\" {\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\treturn 1, parseRegexpVal(rest[0], &opts.wordRegexp)\n\t}\n\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n}\n\nfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n\tfor i := 0; i < len(flags); i++ {\n\t\tswitch flags[i] {\n\t\tcase 'f':\n\t\t\topts.ignoreCase = true\n\t\tcase 'A':\n\t\t\topts.autoRef = true\n\t\tcase 'r':\n\t\t\topts.references = true\n\t\tcase 'w':\n\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.width, 'w')\n\t\tcase 'g':\n\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.gapSize, 'g')\n\t\tcase 'W':\n\t\t\treturn extractAndSetRegexp(flags[i+1:], rest, &opts.wordRegexp)\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[i])\n\t\t}\n\t}\n\treturn 0, nil\n}\n\nfunc extractAndSetInt(tail string, rest []string, dst *int, flag byte) (int, error) {\n\tval, consumed, err := extractFlagValue(tail, rest, flag)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tif err := parseIntVal(val, dst, string(flag)); err != nil {\n\t\treturn 0, err\n\t}\n\treturn consumed, nil\n}\n\nfunc extractFlagValue(tail string, rest []string, flag byte) (string, int, error) {\n\tif tail != \"\" {\n\t\treturn tail, 0, nil\n\t}\n\tif len(rest) > 0 {\n\t\treturn rest[0], 1, nil\n\t}\n\treturn \"\", 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n}\n\nfunc extractAndSetRegexp(tail string, rest []string, dst **regexp.Regexp) (int, error) {\n\tval, consumed, err := extractFlagValue(tail, rest, 'W')\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tif err := parseRegexpVal(val, dst); err != nil {\n\t\treturn 0, err\n\t}\n\treturn consumed, nil\n}\n\nfunc parseRegexpVal(s string, dst **regexp.Regexp) error {\n\tre, err := regexp.Compile(s)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid word regexp '%s': %s\", s, err)\n\t}\n\t*dst = re\n\treturn nil\n}\n\nfunc parseIntVal(s string, dst *int, name string) error {\n\tv, err := strconv.Atoi(s)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid %s argument '%s'\", name, s)\n\t}\n\t*dst = v\n\treturn nil\n}\n\nfunc readAllLines(names []string) ([]inputLine, error) {\n\tvar all []inputLine\n\tfor _, name := range names {\n\t\tlines, err := readFile(name)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfor i, text := range lines {\n\t\t\tall = append(all, inputLine{text: text, file: name, lineNum: i + 1})\n\t\t}\n\t}\n\treturn all, nil\n}\n\nfunc readFile(name string) ([]string, error) {\n\tvar r io.Reader\n\tif name == \"-\" {\n\t\tr = os.Stdin\n\t} else {\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tdefer f.Close()\n\t\tr = f\n\t}\n\tsc := bufio.NewScanner(r)\n\tvar lines []string\n\tfor sc.Scan() {\n\t\tlines = append(lines, sc.Text())\n\t}\n\treturn lines, sc.Err()\n}\n\nfunc buildIndex(lines []inputLine, opts *options) []entry {\n\tvar entries []entry\n\tfor _, il := range lines {\n\t\ttext := il.text\n\t\tvar ref string\n\t\tif opts.references {\n\t\t\tref, text = splitReference(text)\n\t\t}\n\t\tif opts.autoRef {\n\t\t\tref = formatAutoRef(il.file, il.lineNum)\n\t\t}\n\t\tfor _, w := range findWords(text, opts.wordRegexp) {\n\t\t\tsk := text[w.start:w.end]\n\t\t\tif opts.ignoreCase {\n\t\t\t\tsk = strings.ToUpper(sk)\n\t\t\t}\n\t\t\tentries = append(entries, entry{\n\t\t\t\tbefore:  text[:w.start],\n\t\t\t\tkwAfter: text[w.start:],\n\t\t\t\tsortKey: sk,\n\t\t\t\tref:     ref,\n\t\t\t})\n\t\t}\n\t}\n\treturn entries\n}\n\nfunc findWords(line string, wordRe *regexp.Regexp) []wordSpan {\n\tif wordRe != nil {\n\t\treturn findWordsRegexp(line, wordRe)\n\t}\n\tvar spans []wordSpan\n\ti := 0\n\tfor i < len(line) {\n\t\tr, size := utf8.DecodeRuneInString(line[i:])\n\t\tif !isWordChar(r) {\n\t\t\ti += size\n\t\t\tcontinue\n\t\t}\n\t\tstart := i\n\t\tfor i < len(line) {\n\t\t\tr, size = utf8.DecodeRuneInString(line[i:])\n\t\t\tif !isWordChar(r) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\ti += size\n\t\t}\n\t\tspans = append(spans, wordSpan{start, i})\n\t}\n\treturn spans\n}\n\nfunc findWordsRegexp(line string, re *regexp.Regexp) []wordSpan {\n\tlocs := re.FindAllStringIndex(line, -1)\n\tspans := make([]wordSpan, len(locs))\n\tfor i, loc := range locs {\n\t\tspans[i] = wordSpan{loc[0], loc[1]}\n\t}\n\treturn spans\n}\n\nfunc isWordChar(r rune) bool {\n\treturn unicode.IsLetter(r)\n}\n\nfunc writeOutput(entries []entry, width, gapSize int) error {\n\tw := bufio.NewWriter(os.Stdout)\n\trefMax := maxRefWidth(entries)\n\tkwicWidth := width\n\tif refMax > 0 {\n\t\tkwicWidth = width - refMax - gapSize\n\t}\n\thalf := kwicWidth / 2\n\trightMax := kwicWidth - half - gapSize\n\tfor _, e := range entries {\n\t\tline := formatEntry(e, half, gapSize, rightMax, refMax)\n\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn w.Flush()\n}\n\nfunc formatEntry(e entry, half, gapSize, rightMax, refMax int) string {\n\tleft := strings.TrimRight(e.before, \" \")\n\tleftMax := max(half-gapSize, 0)\n\tif len(left) > leftMax {\n\t\tleft = left[len(left)-leftMax:]\n\t}\n\tright := e.kwAfter\n\tif rightMax > 0 && len(right) > rightMax {\n\t\tright = right[:rightMax]\n\t}\n\tvar buf strings.Builder\n\tif refMax > 0 {\n\t\tbuf.WriteString(e.ref)\n\t\twriteSpaces(&buf, refMax-len(e.ref)+gapSize)\n\t}\n\twriteSpaces(&buf, half-len(left))\n\tbuf.WriteString(left)\n\twriteSpaces(&buf, gapSize)\n\tbuf.WriteString(right)\n\treturn buf.String()\n}\n\nfunc writeSpaces(b *strings.Builder, n int) {\n\tfor range n {\n\t\tb.WriteByte(' ')\n\t}\n}\n\nfunc splitReference(line string) (string, string) {\n\ti := strings.IndexAny(line, \" \\t\")\n\tif i < 0 {\n\t\treturn line, \"\"\n\t}\n\tref := line[:i]\n\trest := line[i:]\n\tj := 0\n\tfor j < len(rest) && (rest[j] == ' ' || rest[j] == '\\t') {\n\t\tj++\n\t}\n\treturn ref, rest[j:]\n}\n\nfunc formatAutoRef(file string, lineNum int) string {\n\tif file == \"-\" {\n\t\tfile = \"\"\n\t}\n\treturn file + \":\" + strconv.Itoa(lineNum)\n}\n\nfunc maxRefWidth(entries []entry) int {\n\tm := 0\n\tfor _, e := range entries {\n\t\tif len(e.ref) > m {\n\t\t\tm = len(e.ref)\n\t\t}\n\t}\n\treturn m\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n","numLines":422,"startLine":1,"totalLines":422}}}
