 \"dev\" {\n\t\tt.Fatalf(\"expected exported Version to be \\\"dev\\\", got %q\", Version)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1059,"cache_read_input_tokens":165106,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1059},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f3973621-b5f4-4c44-adc3-0118bf6028ed","uuid":"46976db0-b480-4b2b-bd3b-875b78780f09"}
