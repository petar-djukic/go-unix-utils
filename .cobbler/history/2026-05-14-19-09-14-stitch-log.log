n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":427,"cache_read_input_tokens":29959,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":427},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7dca3a83-6a8a-499a-b5a4-dd16921e7384","uuid":"ac01ffdd-37d7-4326-bfc7-ab578b8d9d54"}
