ct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n\treturn strconv.FormatInt(pct, 10) + \"%\"\n}\n\nfunc printTable(entries []fsEntry) {\n\tw := computeWidths(entries)\n\tprintLine(headers, w)\n\tfor _, e := range entries {\n\t\tprintLine(entryStrings(e), w)\n\t}\n}\n\nfunc entryStrings(e fsEntry) [6]string {\n\treturn [6]string{\n\t\te.filesystem,\n\t\tstrconv.FormatInt(e.blocks1K, 10),\n\t\tstrconv.FormatInt(e.used, 10),\n\t\tstrconv.FormatInt(e.available, 10),\n\t\te.usePercent,\n\t\te.mountedOn,\n\t}\n}\n\nfunc computeWidths(entries []fsEntry) [6]int {\n\tw := [6]int{\n\t\tlen(headers[0]), len(headers[1]), len(headers[2]),\n\t\tlen(headers[3]), len(headers[4]), len(headers[5]),\n\t}\n\tfor _, e := range entries {\n\t\tcols := entryStrings(e)\n\t\tfor i := range w {\n\t\t\tif len(cols[i]) > w[i] {\n\t\t\t\tw[i] = len(cols[i])\n\t\t\t}\n\t\t}\n\t}\n\treturn w\n}\n\nfunc printLine(cols [6]string, w [6]int) {\n\tfmt.Printf(\"%s %s %s %s %s %s\\n\",\n\t\tformat.PadRight(cols[0], w[0]),\n\t\tformat.PadLeft(cols[1], w[1]),\n\t\tformat.PadLeft(cols[2], w[2]),\n\t\tformat.PadLeft(cols[3], w[3]),\n\t\tformat.PadLeft(cols[4], w[4]),\n\t\tcols[5],\n\t)\n}\n\nfunc int8ToString(s []int8) string {\n\tb := make([]byte, 0, len(s))\n\tfor _, v := range s {\n\t\tif v == 0 {\n\t\t\tbreak\n\t\t}\n\t\tb = append(b, byte(v))\n\t}\n\treturn string(b)\n}\n","structuredPatch":[{"oldStart":183,"oldLines":13,"newStart":183,"newLines":11,"lines":["   )"," }"," ","-func int8ToString(s []int8) string {","-  b := make([]byte, 0, len(s))","-  for _, v := range s {","+func cstring(b []byte) string {","+  for i, v := range b {","     if v == 0 {","-      break","+      return string(b[:i])","     }","-    b = append(b, byte(v))","   }","   return string(b)"," }"]}],"userModified":false,"replaceAll":false}}
