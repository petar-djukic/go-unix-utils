{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NgsJLHYcM7QbrPeiyV5QvS","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd106-df R1.1-R1.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"math\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"syscall\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t\t\"golang.org/x/sys/unix\"\n18\t)\n19\t\n20\ttype fsEntry struct {\n21\t\tfilesystem string\n22\t\tblocks1K   int64\n23\t\tused       int64\n24\t\tavailable  int64\n25\t\tusePercent string\n26\t\tmountedOn  string\n27\t}\n28\t\n29\tvar headers = [6]string{\n30\t\t\"Filesystem\", \"1K-blocks\", \"Used\", \"Available\", \"Use%\", \"Mounted on\",\n31\t}\n32\t\n33\tfunc main() {\n34\t\tsys.InstallSIGPIPEHandler()\n35\t\tos.Exit(run(os.Args[1:]))\n36\t}\n37\t\n38\tfunc run(args []string) int {\n39\t\tif len(args) == 0 {\n40\t\t\treturn listAll()\n41\t\t}\n42\t\treturn listPaths(args)\n43\t}\n44\t\n45\tfunc listAll() int {\n46\t\tstats, err := getAllMounts()\n47\t\tif err != nil {\n48\t\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n49\t\t\treturn 1\n50\t\t}\n51\t\tentries := filterAndDedup(stats)\n52\t\tprintTable(entries)\n53\t\treturn 0\n54\t}\n55\t\n56\tfunc listPaths(paths []string) int {\n57\t\tstats, err := getAllMounts()\n58\t\tif err != nil {\n59\t\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n60\t\t\treturn 1\n61\t\t}\n62\t\tdevMap := buildDevMap(stats)\n63\t\texitCode := 0\n64\t\tentries := make([]fsEntry, 0, len(paths))\n65\t\tfor _, path := range paths {\n66\t\t\tentry, err := entryForPath(path, devMap)\n67\t\t\tif err != nil {\n68\t\t\t\tfmt.Fprintf(os.Stderr, \"df: %s: %s\\n\", path, capitalizeErr(err))\n69\t\t\t\texitCode = 1\n70\t\t\t\tcontinue\n71\t\t\t}\n72\t\t\tentries = append(entries, entry)\n73\t\t}\n74\t\tif len(entries) > 0 {\n75\t\t\tprintTable(entries)\n76\t\t}\n77\t\treturn exitCode\n78\t}\n79\t\n80\tfunc capitalizeErr(err error) string {\n81\t\ts := err.Error()\n82\t\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n83\t\t\treturn strings.ToUpper(s[:1]) + s[1:]\n84\t\t}\n85\t\treturn s\n86\t}\n87\t\n88\tfunc getAllMounts() ([]unix.Statfs_t, error) {\n89\t\tn, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)\n90\t\tif err != nil {\n91\t\t\treturn nil, err\n92\t\t}\n93\t\tbuf := make([]unix.Statfs_t, n)\n94\t\tn, err = unix.Getfsstat(buf, unix.MNT_NOWAIT)\n95\t\tif err != nil {\n96\t\t\treturn nil, err\n97\t\t}\n98\t\treturn buf[:n], nil\n99\t}\n100\t\n101\tfunc isDummyType(t string) bool {\n102\t\treturn t == \"devfs\" || t == \"autofs\"\n103\t}\n104\t\n105\tfunc filterAndDedup(stats []unix.Statfs_t) []fsEntry {\n106\t\tseen := make(map[int32]bool)\n107\t\tentries := make([]fsEntry, 0, len(stats))\n108\t\tfor _, s := range stats {\n109\t\t\tif isDummyType(cstring(s.Fstypename[:])) {\n110\t\t\t\tcontinue\n111\t\t\t}\n112\t\t\tif s.Blocks == 0 {\n113\t\t\t\tcontinue\n114\t\t\t}\n115\t\t\tdev, ok := mountDev(cstring(s.Mntonname[:]))\n116\t\t\tif !ok {\n117\t\t\t\tcontinue\n118\t\t\t}\n119\t\t\tif seen[dev] {\n120\t\t\t\tcontinue\n121\t\t\t}\n122\t\t\tseen[dev] = true\n123\t\t\tentries = append(entries, buildEntry(s))\n124\t\t}\n125\t\treturn entries\n126\t}\n127\t\n128\tfunc buildDevMap(stats []unix.Statfs_t) map[int32]string {\n129\t\tm := make(map[int32]string, len(stats))\n130\t\tfor _, s := range stats {\n131\t\t\tmount := cstring(s.Mntonname[:])\n132\t\t\tdev, ok := mountDev(mount)\n133\t\t\tif !ok {\n134\t\t\t\tcontinue\n135\t\t\t}\n136\t\t\tif _, exists := m[dev]; !exists {\n137\t\t\t\tm[dev] = mount\n138\t\t\t}\n139\t\t}\n140\t\treturn m\n141\t}\n142\t\n143\tfunc entryForPath(path string, devMap map[int32]string) (fsEntry, error) {\n144\t\tvar info syscall.Stat_t\n145\t\tif err := syscall.Stat(path, &info); err != nil {\n146\t\t\treturn fsEntry{}, err\n147\t\t}\n148\t\ttarget := path\n149\t\tif mount, ok := devMap[info.Dev]; ok {\n150\t\t\ttarget = mount\n151\t\t}\n152\t\tvar stat unix.Statfs_t\n153\t\tif err := unix.Statfs(target, &stat); err != nil {\n154\t\t\treturn fsEntry{}, err\n155\t\t}\n156\t\treturn buildEntry(stat), nil\n157\t}\n158\t\n159\tfunc mountDev(mount string) (int32, bool) {\n160\t\tvar info syscall.Stat_t\n161\t\tif err := syscall.Stat(mount, &info); err != nil {\n162\t\t\treturn 0, false\n163\t\t}\n164\t\treturn info.Dev, true\n165\t}\n166\t\n167\tfunc buildEntry(stat unix.Statfs_t) fsEntry {\n168\t\tbsize := uint64(stat.Bsize)\n169\t\ttotal := int64(stat.Blocks * bsize / 1024)\n170\t\tfree := int64(stat.Bfree * bsize / 1024)\n171\t\tavail := int64(stat.Bavail * bsize / 1024)\n172\t\treturn fsEntry{\n173\t\t\tfilesystem: cstring(stat.Mntfromname[:]),\n174\t\t\tblocks1K:   total,\n175\t\t\tused:       total - free,\n176\t\t\tavailable:  avail,\n177\t\t\tusePercent: computeUsePercent(total, avail),\n178\t\t\tmountedOn:  cstring(stat.Mntonname[:]),\n179\t\t}\n180\t}\n181\t\n182\tfunc computeUsePercent(total, avail int64) string {\n183\t\tif total == 0 {\n184\t\t\treturn \"-\"\n185\t\t}\n186\t\tused := total - avail\n187\t\tif used <= 0 {\n188\t\t\treturn \"0%\"\n189\t\t}\n190\t\tpct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n191\t\treturn strconv.FormatInt(pct, 10) + \"%\"\n192\t}\n193\t\n194\tfunc printTable(entries []fsEntry) {\n195\t\tw := computeWidths(entries)\n196\t\tprintLine(headers, w)\n197\t\tfor _, e := range entries {\n198\t\t\tprintLine(entryStrings(e), w)\n199\t\t}\n200\t}\n201\t\n202\tfunc entryStrings(e fsEntry) [6]string {\n203\t\treturn [6]string{\n204\t\t\te.filesystem,\n205\t\t\tstrconv.FormatInt(e.blocks1K, 10),\n206\t\t\tstrconv.FormatInt(e.used, 10),\n207\t\t\tstrconv.FormatInt(e.available, 10),\n208\t\t\te.usePercent,\n209\t\t\te.mountedOn,\n210\t\t}\n211\t}\n212\t\n213\tfunc computeWidths(entries []fsEntry) [6]int {\n214\t\tw := [6]int{\n215\t\t\tlen(headers[0]), len(headers[1]), len(headers[2]),\n216\t\t\tlen(headers[3]), len(headers[4]), len(headers[5]),\n217\t\t}\n218\t\tfor _, e := range entries {\n219\t\t\tcols := entryStrings(e)\n220\t\t\tfor i := range w {\n221\t\t\t\tif len(cols[i]) > w[i] {\n222\t\t\t\t\tw[i] = len(cols[i])\n223\t\t\t\t}\n224\t\t\t}\n225\t\t}\n226\t\treturn w\n227\t}\n228\t\n229\tfunc printLine(cols [6]string, w [6]int) {\n230\t\tfmt.Printf(\"%s %s %s %s %s %s\\n\",\n231\t\t\tformat.PadRight(cols[0], w[0]),\n232\t\t\tformat.PadLeft(cols[1], w[1]),\n233\t\t\tformat.PadLeft(cols[2], w[2]),\n234\t\t\tformat.PadLeft(cols[3], w[3]),\n235\t\t\tformat.PadLeft(cols[4], w[4]),\n236\t\t\tcols[5],\n237\t\t)\n238\t}\n239\t\n240\tfunc cstring(b []byte) string {\n241\t\tfor i, v := range b {\n242\t\t\tif v == 0 {\n243\t\t\t\treturn string(b[:i])\n244\t\t\t}\n245\t\t}\n246\t\treturn string(b)\n247\t}\n248\t"}]},"parent_tool_use_id":null,"session_id":"e6b56990-b444-4142-be23-d97fbc698916","uuid":"71d5c429-aab5-46e3-818e-35c1dc5f4daf","timestamp":"2026-05-27T19:24:56.316Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5605/cmd/df/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd106-df R1.1-R1.4.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n\t\"golang.org/x/sys/unix\"\n)\n\ntype fsEntry struct {\n\tfilesystem string\n\tblocks1K   int64\n\tused       int64\n\tavailable  int64\n\tusePercent string\n\tmountedOn  string\n}\n\nvar headers = [6]string{\n\t\"Filesystem\", \"1K-blocks\", \"Used\", \"Available\", \"Use%\", \"Mounted on\",\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run(os.Args[1:]))\n}\n\nfunc run(args []string) int {\n\tif len(args) == 0 {\n\t\treturn listAll()\n\t}\n\treturn listPaths(args)\n}\n\nfunc listAll() int {\n\tstats, err := getAllMounts()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n\t\treturn 1\n\t}\n\tentries := filterAndDedup(stats)\n\tprintTable(entries)\n\treturn 0\n}\n\nfunc listPaths(paths []string) int {\n\tstats, err := getAllMounts()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n\t\treturn 1\n\t}\n\tdevMap := buildDevMap(stats)\n\texitCode := 0\n\tentries := make([]fsEntry, 0, len(paths))\n\tfor _, path := range paths {\n\t\tentry, err := entryForPath(path, devMap)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"df: %s: %s\\n\", path, capitalizeErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, entry)\n\t}\n\tif len(entries) > 0 {\n\t\tprintTable(entries)\n\t}\n\treturn exitCode\n}\n\nfunc capitalizeErr(err error) string {\n\ts := err.Error()\n\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n\t\treturn strings.ToUpper(s[:1]) + s[1:]\n\t}\n\treturn s\n}\n\nfunc getAllMounts() ([]unix.Statfs_t, error) {\n\tn, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tbuf := make([]unix.Statfs_t, n)\n\tn, err = unix.Getfsstat(buf, unix.MNT_NOWAIT)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn buf[:n], nil\n}\n\nfunc isDummyType(t string) bool {\n\treturn t == \"devfs\" || t == \"autofs\"\n}\n\nfunc filterAndDedup(stats []unix.Statfs_t) []fsEntry {\n\tseen := make(map[int32]bool)\n\tentries := make([]fsEntry, 0, len(stats))\n\tfor _, s := range stats {\n\t\tif isDummyType(cstring(s.Fstypename[:])) {\n\t\t\tcontinue\n\t\t}\n\t\tif s.Blocks == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tdev, ok := mountDev(cstring(s.Mntonname[:]))\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[dev] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[dev] = true\n\t\tentries = append(entries, buildEntry(s))\n\t}\n\treturn entries\n}\n\nfunc buildDevMap(stats []unix.Statfs_t) map[int32]string {\n\tm := make(map[int32]string, len(stats))\n\tfor _, s := range stats {\n\t\tmount := cstring(s.Mntonname[:])\n\t\tdev, ok := mountDev(mount)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif _, exists := m[dev]; !exists {\n\t\t\tm[dev] = mount\n\t\t}\n\t}\n\treturn m\n}\n\nfunc entryForPath(path string, devMap map[int32]string) (fsEntry, error) {\n\tvar info syscall.Stat_t\n\tif err := syscall.Stat(path, &info); err != nil {\n\t\treturn fsEntry{}, err\n\t}\n\ttarget := path\n\tif mount, ok := devMap[info.Dev]; ok {\n\t\ttarget = mount\n\t}\n\tvar stat unix.Statfs_t\n\tif err := unix.Statfs(target, &stat); err != nil {\n\t\treturn fsEntry{}, err\n\t}\n\treturn buildEntry(stat), nil\n}\n\nfunc mountDev(mount string) (int32, bool) {\n\tvar info syscall.Stat_t\n\tif err := syscall.Stat(mount, &info); err != nil {\n\t\treturn 0, false\n\t}\n\treturn info.Dev, true\n}\n\nfunc buildEntry(stat unix.Statfs_t) fsEntry {\n\tbsize := uint64(stat.Bsize)\n\ttotal := int64(stat.Blocks * bsize / 1024)\n\tfree := int64(stat.Bfree * bsize / 1024)\n\tavail := int64(stat.Bavail * bsize / 1024)\n\treturn fsEntry{\n\t\tfilesystem: cstring(stat.Mntfromname[:]),\n\t\tblocks1K:   total,\n\t\tused:       total - free,\n\t\tavailable:  avail,\n\t\tusePercent: computeUsePercent(total, avail),\n\t\tmountedOn:  cstring(stat.Mntonname[:]),\n\t}\n}\n\nfunc computeUsePercent(total, avail int64) string {\n\tif total == 0 {\n\t\treturn \"-\"\n\t}\n\tused := total - avail\n\tif used <= 0 {\n\t\treturn \"0%\"\n\t}\n\tpct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n\treturn strconv.FormatInt(pct, 10) + \"%\"\n}\n\nfunc printTable(entries []fsEntry) {\n\tw := computeWidths(entries)\n\tprintLine(headers, w)\n\tfor _, e := range entries {\n\t\tprintLine(entryStrings(e), w)\n\t}\n}\n\nfunc entryStrings(e fsEntry) [6]string {\n\treturn [6]string{\n\t\te.filesystem,\n\t\tstrconv.FormatInt(e.blocks1K, 10),\n\t\tstrconv.FormatInt(e.used, 10),\n\t\tstrconv.FormatInt(e.available, 10),\n\t\te.usePercent,\n\t\te.mountedOn,\n\t}\n}\n\nfunc computeWidths(entries []fsEntry) [6]int {\n\tw := [6]int{\n\t\tlen(headers[0]), len(headers[1]), len(headers[2]),\n\t\tlen(headers[3]), len(headers[4]), len(headers[5]),\n\t}\n\tfor _, e := range entries {\n\t\tcols := entryStrings(e)\n\t\tfor i := range w {\n\t\t\tif len(cols[i]) > w[i] {\n\t\t\t\tw[i] = len(cols[i])\n\t\t\t}\n\t\t}\n\t}\n\treturn w\n}\n\nfunc printLine(cols [6]string, w [6]int) {\n\tfmt.Printf(\"%s %s %s %s %s %s\\n\",\n\t\tformat.PadRight(cols[0], w[0]),\n\t\tformat.PadLeft(cols[1], w[1]),\n\t\tformat.PadLeft(cols[2], w[2]),\n\t\tformat.PadLeft(cols[3], w[3]),\n\t\tformat.PadLeft(cols[4], w[4]),\n\t\tcols[5],\n\t)\n}\n\nfunc cstring(b []byte) string {\n\tfor i, v := range b {\n\t\tif v == 0 {\n\t\t\treturn string(b[:i])\n\t\t}\n\t}\n\treturn string(b)\n}\n","numLines":248,"startLine":1,"totalLines":248}}}
