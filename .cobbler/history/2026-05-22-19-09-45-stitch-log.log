turn 1, nil\n\t}\n\treturn 0, nil\n}\n\nfunc parseShortFlags(arg string, remaining []string, opts *options) (int, error) {\n\tconsumed := 1\n\tflags := arg[1:]\n\tfor j := 0; j < len(flags); j++ {\n\t\tc := flags[j]\n\t\tswitch c {\n\t\tcase 't':\n\t\t\tval, extra := flagValue(flags[j+1:], remaining, consumed)\n\t\t\tconsumed += extra\n\t\t\tts, err := parseTypeString(val)\n\t\t\tif err != nil {\n\t\t\t\treturn consumed, err\n\t\t\t}\n\t\t\topts.types = append(opts.types, ts...)\n\t\t\treturn consumed, nil\n\t\tcase 'A':\n\t\t\tval, extra := flagValue(flags[j+1:], remaining, consumed)\n\t\t\tconsumed += extra\n\t\t\treturn consumed, setAddrRadix(opts, val)\n\t\tcase 'j':\n\t\t\tval, extra := flagValue(flags[j+1:], remaining, consumed)\n\t\t\tconsumed += extra\n\t\t\treturn consumed, parseSkipBytes(opts, val)\n\t\tcase 'N':\n\t\t\tval, extra := flagValue(flags[j+1:], remaining, consumed)\n\t\t\tconsumed += extra\n\t\t\treturn consumed, parseReadBytes(opts, val)\n\t\tcase 'v':\n\t\t\topts.verbose = true\n\t\tcase 'b':\n\t\t\topts.types = append(opts.types, typeSpec{format: 'o', size: 1})\n\t\tcase 'c':\n\t\t\topts.types = append(opts.types, typeSpec{format: 'c', size: 1})\n\t\tcase 'd':\n\t\t\topts.types = append(opts.types, typeSpec{format: 'u', size: 2})\n\t\tcase 'o':\n\t\t\topts.types = append(opts.types, typeSpec{format: 'o', size: 2})\n\t\tcase 's':\n\t\t\topts.types = append(opts.types, typeSpec{format: 'd', size: 2})\n\t\tcase 'x':\n\t\t\topts.types = append(opts.types, typeSpec{format: 'x', size: 2})\n\t\tcase 'w':\n\t\t\trest := flags[j+1:]\n\t\t\tif len(rest) > 0 {\n\t\t\t\treturn consumed, parseWidth(opts, rest)\n\t\t\t}\n\t\t\tif consumed < len(remaining) {\n\t\t\t\tnext := remaining[consumed]\n\t\t\t\tif len(next) > 0 && next[0] >= '0' && next[0] <= '9' {\n\t\t\t\t\tconsumed++\n\t\t\t\t\treturn consumed, parseWidth(opts, next)\n\t\t\t\t}\n\t\t\t}\n\t\t\topts.outputWidth = 32\n\t\t\treturn consumed, nil\n\t\tdefault:\n\t\t\treturn consumed, fmt.Errorf(\"i