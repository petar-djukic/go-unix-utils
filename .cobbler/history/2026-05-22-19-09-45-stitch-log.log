"p\", \"q\", \"r\", \"s\", \"t\", \"u\", \"v\", \"w\",\n\t\"x\", \"y\", \"z\", \"{\", \"|\", \"}\", \"~\", \"del\",\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"od: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\tif len(opts.types) == 0 {\n\t\topts.types = []typeSpec{{format: 'o', size: 2}}\n\t}\n\tif opts.outputWidth == 0 {\n\t\topts.outputWidth = 16\n\t}\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\texitCode := run(opts, files)\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc run(opts options, files []string) int {\n\treader, exitCode := openInputs(files)\n\tif exitCode != 0 {\n\t\treturn exitCode\n\t}\n\tif closer, ok := reader.(io.Closer); ok {\n\t\tdefer closer.Close()\n\t}\n\tvar r io.Reader = reader\n\tif opts.skipBytes > 0 {\n\t\tif _, err := io.CopyN(io.Discard, r, opts.skipBytes); err != nil {\n\t\t\treturn 0\n\t\t}\n\t}\n\tif opts.readLimit {\n\t\tr = io.LimitReader(r, opts.readBytes)\n\t}\n\treturn dump(opts, r)\n}\n\nfunc dump(opts options, r io.Reader) int {\n\tbuf := make([]byte, opts.outputWidth)\n\tvar prevLine []byte\n\tduplicating := false\n\toffset := opts.skipBytes\n\n\tfor {\n\t\tn, err := io.ReadFull(r, buf)\n\t\tif n == 0 {\n\t\t\tbreak\n\t\t}\n\t\tline := buf[:n]\n\t\tif !opts.verbose && prevLine != nil && n == len(buf) && equalBytes(prevLine, line) {\n\t\t\tif !duplicating {\n\t\t\t\tfmt.Println(\"*\")\n\t\t\t\tduplicating = true\n\t\t\t}\n\t\t\toffset += int64(n)\n\t\t\tcontinue\n\t\t}\n\t\tduplicating = false\n\t\tprintBlock(opts, offset, line)\n\t\toffset += int64(n)\n\t\tif prevLine == nil {\n\t\t\tprevLine = make([]byte, len(buf))\n\t\t}\n\t\tcopy(prevLine, line)\n\t\tif err != nil {\n\t\t\tbreak\n\t\t}\n\t}\n\tprintAddress(opts.addrRadix, offset)\n\tfmt.Println()\n\treturn 0\n}\n\nfunc printBlock(opts options, offset int64, data []byte) {\n\tfor i, ts := range opts.types {\n\t\tif i == 0 {\n\t\t\tprintAddress(opts.addrRadix, offset)\n\t\t} else {\n\t\t\tprintAddressPadding(opts.addrRadix)\n\t\t}\n\t\tformatLine(ts, data, opts.outputWidth)\n\t\tfmt.Println()\n\t}\n}\n\nfunc printAddress(radix byte, offset int64) {\n\tswitch radix {\n\tcase 'o':\n\t\tfmt.Printf(\"%07o\", offset)\n\tcase 'x':\n\t\tfmt.Printf(\"%06x\", offset)\n\tcase 'd':\n\t\tfmt.Printf(\"%07d\", offset)\n\tcase 'n':\n\t\treturn\n\t}\n}\n\nfunc printAddressPadding(radix byte) {\n\tswitch radix {\n\tcase 'o', 'd':\n\t\tfmt.Print(\"       \")\n\tcase 'x':\n\t\tfmt.Print(\"      \")\n\tcase 'n':\n\t\treturn\n\t}\n}\n\nfunc formatLine(ts typeSpec, data []byte, width int) {\n\tswitch ts.format {\n\tcase 'a':\n\t\tformatNamedChars(data, width)\n\tcase 'c':\n\t\tformatCChars(data, width)\n\tcase 'o':\n\t\tformatIntegers(ts, data, width, fmtOctal)\n\tcase 'x':\n\t\tformatIntegers(ts, data, width, fmtHex)\n\tcase 'u':\n\t\tformatIntegers(ts, data, width, fmtUnsigned)\n\tcase 'd':\n\t\tformatIntegers(ts, data, width, fmtSigned)\n\tcase 'f':\n\t\tformatFloats(ts.size, data, width)\n\t}\n}\n\nfunc formatNamedChars(data []byte, width int) {\n\tfieldWidth := fieldWidthForType(typeSpec{format: 'a', size: 1}, width)\n\tfor i := 0; i < len(data); i++ {\n\t\tb := data[i] & 0x7f\n\t\tfmt.Printf(\" %*s\", fieldWidth-1, namedChars[b])\n\t}\n}\n\nfunc formatCChars(data []byte, width int) {\n\tfieldWidth := fieldWidthForType(typeSpec{format: 'c', size: 1}, width)\n\tfor i := 0; i < len(data); i++ {\n\t\ts := cCharRepr(data[i])\n\t\tfmt.Printf(\" %*s\", fieldWidth-1, s)\n\t}\n}\n\nfunc cCharRepr(b byte) string {\n\tswitch b {\n\tcase 0:\n\t\treturn \"\\\\0\"\n\tcase 7:\n\t\treturn \"\\\\a\"\n\tcase 8:\n\t\treturn \"\\\\b\"\n\tcase 9:\n\t\treturn \"\\\\t\"\n\tcase 10:\n\t\treturn \"\\\\n\"\n\tcase 11:\n\t\treturn \"\\\\v\"\n\tcase 12:\n\t\treturn \"\\\\f\"\n\tcase 13:\n\t\treturn \"\\\\r\"\n\tcase 0x5c:\n\t\treturn \"\\\\\"\n\t}\n\tif b >= 0x20 && b < 0x7f {\n\t\treturn string(rune(b))\n\t}\n\treturn fmt.Sprintf(\"%03o\", b)\n}\n\ntype intFormatter func(v uint64, fieldWidth int) string\n\nfunc fmtOctal(v uint64, fw int) string   { return fmt.Sprintf(\"%0*o\", fw-1, v) }\nfunc fmtHex(v uint64, fw int) string     { return fmt.Sprintf(\"%0*x\", fw-1, v) }\nfunc fmtUnsigned(v uint64, fw int) string { return fmt.Sprintf(\"%*d\", fw-1, v) }\nfunc fmtSigned(v uint64, fw int) string {\n\treturn fmt.Sprintf(\"%*d\", fw-1, toSigned(v, fw))\n}\n\nfunc toSigned(v uint64, fw int) int64 {\n\t_ = fw\n\tswitch {\n\tcase v <= math.MaxUint8 && v > math.MaxInt8:\n\t\treturn int64(int8(v))\n\tcase v <= math.MaxUint16 && v > math.MaxInt16:\n\t\treturn int64(int16(v))\n\tcase v <= math.MaxUint32 && v > math.MaxInt32:\n\t\treturn int64(int32(v))\n\tdefault:\n\t\treturn int64(v)\n\t}\n}\n\nfunc formatIntegers(ts typeSpec, data []byte, width int, fmtFn intFormatter) {\n\tfw := fieldWidthForType(ts, width)\n\tfor i := 0; i+ts.size <= len(data); i += ts.size {\n\t\tv := readUint(data[i:i+ts.size])\n\t\tfmt.Printf(\" %s\", fmtFn(v, fw))\n\t}\n\tif rem := len(data) % ts.size; rem != 0 {\n\t\tpadded := make([]byte, ts.size)\n\t\tstart := len(data) - rem\n\t\tcopy(padded, data[start:])\n\t\tv := readUint(padded)\n\t\tfmt.Printf(\" %s\", fmtFn(v, fw))\n\t}\n}\n\nfunc formatFloats(size int, data []byte, width int) {\n\tfw := fieldWidthForType(typeSpec{format: 'f', size: size}, width)\n\tfor i := 0; i+size <= len(data); i += size {\n\t\tvar f float64\n\t\tswitch size {\n\t\tcase 4:\n\t\t\tf = float64(math.Float32frombits(binary.LittleEndian.Uint32(data[i : i+4])))\n\t\tcase 8:\n\t\t\tf = math.Float64frombits(binary.LittleEndian.Uint64(data[i : i+8]))\n\t\t}\n\t\tfmt.Printf(\" %*g\", fw-1, f)\n\t}\n}\n\nfunc readUint(b []byte) uint64 {\n\tswitch len(b) {\n\tcase 1:\n\t\treturn uint64(b[0])\n\tcase 2:\n\t\treturn uint64(binary.LittleEndian.Uint16(b))\n\tcase 4:\n\t\treturn uint64(binary.LittleEndian.Uint32(b))\n\tcase 8:\n\t\treturn binary.LittleEndian.Uint64(b)\n\t}\n\treturn 0\n}\n\nfunc fieldWidthForType(ts typeSpec, outputWidth int) int {\n\tswitch ts.format {\n\tcase 'a':\n\t\treturn 4\n\tcase 'c':\n\t\treturn 4\n\tcase 'o':\n\t\treturn oFieldWidth(ts.size)\n\tcase 'x':\n\t\treturn xFieldWidth(ts.size)\n\tcase 'u':\n\t\treturn uFieldWidth(ts.size)\n\tcase 'd':\n\t\treturn dFieldWidth(ts.size)\n\tcase 'f':\n\t\treturn fFieldWidth(ts.size, outputWidth)\n\t}\n\treturn 4\n}\n\nfunc oFieldWidth(size int) int {\n\tswitch size {\n\tcase 1:\n\t\treturn 4\n\tcase 2:\n\t\treturn 7\n\tcase 4:\n\t\treturn 12\n\tcase 8:\n\t\treturn 23\n\t}\n\treturn 7\n}\n\nfunc xFieldWidth(size int) int {\n\tswitch size {\n\tcase 1:\n\t\treturn 3\n\tcase 2:\n\t\treturn 5\n\tcase 4:\n\t\treturn 9\n\tcase 8:\n\t\treturn 17\n\t}\n\treturn 5\n}\n\nfunc uFieldWidth(size int) int {\n\tswitch size {\n\tcase 1:\n\t\treturn 4\n\tcase 2:\n\t\treturn 6\n\tcase 4:\n\t\treturn 11\n\tcase 8:\n\t\treturn 21\n\t}\n\treturn 6\n}\n\nfunc dFieldWidth(size int) int {\n\tswitch size {\n\tcase 1:\n\t\treturn 5\n\tcase 2:\n\t\treturn 7\n\tcase 4:\n\t\treturn 12\n\tcase 8:\n\t\treturn 21\n\t}\n\treturn 7\n}\n\nfunc fFieldWidth(size, outputWidth int) int {\n\tswitch size {\n\tcase 4:\n\t\treturn outputWidth / 4 * 4 / (outputWidth / 4)\n\tcase 8:\n\t\treturn outputWidth / 8 * 8 / (outputWidth / 8)\n\t}\n\treturn 16\n}\n\nfunc equalBytes(a, b []byte) bool {\n\tif len(a) != len(b) {\n\t\treturn false\n\t}\n\tfor i := range a {\n\t\tif a[i] != b[i] {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc openInputs(files []string) (io.Reader, int) {\n\tif len(files) == 1 {\n\t\tif files[0] == \"-\" {\n\t\t\treturn os.Stdin, 0\n\t\t}\n\t\tf, err := os.Open(files[0])\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"od: %s: No such file or directory\\n\", files[0])\n\t\t\treturn nil, 1\n\t\t}\n\t\treturn f, 0\n\t}\n\treaders := make([]io.Reader, 0, len(files))\n\tfor _, name := range files {\n\t\tif name == \"-\" {\n\t\t\treaders = append(readers, os.Stdin)\n\t\t\tcontinue\n\t\t}\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\tfmt.Fpri