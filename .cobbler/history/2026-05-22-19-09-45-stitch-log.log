0, 0\n\t\tfor j < len(rest) && rest[j] >= '0' && rest[j] <= '9' {\n\t\t\tn = n*10 + int(rest[j]-'0')\n\t\t\tj++\n\t\t}\n\t\tif n == 0 {\n\t\t\tn = defaultSize(format)\n\t\t}\n\t\treturn n, j\n\t}\n\tif len(rest) > 0 {\n\t\tswitch rest[0] {\n\t\tcase 'C':\n\t\t\treturn 1, 1\n\t\tcase 'S':\n\t\t\treturn 2, 1\n\t\tcase 'I':\n\t\t\treturn 4, 1\n\t\tcase 'L':\n\t\t\treturn 8, 1\n\t\t}\n\t}\n\treturn defaultSize(format), 0\n}\n\nfunc defaultSize(format byte) int {\n\tif format == 'f' {\n\t\treturn 8\n\t}\n\treturn 4\n}\n","structuredPatch":[{"oldStart":84,"oldLines":28,"newStart":84,"newLines":38,"lines":["       return consumed + extra, parseReadBytes(opts, val)","     case 'v':","       opts.verbose = true","-    case 'b':","-      opts.types = append(opts.types, typeSpec{format: 'o', size: 1})","-    case 'c':","-      opts.types = append(opts.types, typeSpec{format: 'c', size: 1})","-    case 'd':","-      opts.types = append(opts.types, typeSpec{format: 'u', size: 2})","-    case 'o':","-      opts.types = append(opts.types, typeSpec{format: 'o', size: 2})","-    case 's':","-      opts.types = append(opts.types, typeSpec{format: 'd', size: 2})","-    case 'x':","-      opts.types = append(opts.types, typeSpec{format: 'x', size: 2})","     case 'w':","       extra, err := parseShortWidth(rest, remaining, consumed, opts)","       return consumed + extra, err","     default:","-      return consumed, fmt.Errorf(\"invalid option -- '%c'\", flags[j])","+      if ts, ok := traditionalFlag(flags[j]); ok {","+        opts.types = append(opts.types, ts)","+      } else {","+        return consumed, fmt.Errorf(\"invalid option -- '%c'\", flags[j])","+      }","     }","   }","   return consumed, nil"," }"," ","+func traditionalFlag(c byte) (typeSpec, bool) {","+  switch c {","+  case 'b':","+    return typeSpec{format: 'o', size: 1}, true","+  case 'c':","+    return typeSpec{format: 'c', size: 1}, true","+  case 'd':","+    return typeSpec{format: 'u', size: 2}, true","+  ca