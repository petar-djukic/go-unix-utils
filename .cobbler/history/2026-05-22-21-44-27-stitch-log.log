ame:      \"length-invalid-not-mult-8\",\n216\t\t\t\tArgs:      []string{\"--length=7\", helloFile},\n217\t\t\t\tExitCode:  1,\n218\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n219\t\t\t},\n220\t\t\t// R3.3: invalid length (zero) exits 1\n221\t\t\t{\n222\t\t\t\tName:      \"length-invalid-zero\",\n223\t\t\t\tArgs:      []string{\"--length=0\", helloFile},\n224\t\t\t\tExitCode:  1,\n225\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n226\t\t\t},\n227\t\t\t// R3.3: invalid length (exceeds 512) exits 1\n228\t\t\t{\n229\t\t\t\tName:      \"length-invalid-too-large\",\n230\t\t\t\tArgs:      []string{\"--length=520\", helloFile},\n231\t\t\t\tExitCode:  1,\n232\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n233\t\t\t},\n234\t\t\t// R3.3: invalid length (negative) exits 1\n235\t\t\t{\n236\t\t\t\tName:      \"length-invalid-negative\",\n237\t\t\t\tArgs:      []string{\"--length=-8\", helloFile},\n238\t\t\t\tExitCode:  1,\n239\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n240\t\t\t},\n241\t\t\t// R3.3: --length=256 with --check\n242\t\t\t{\n243\t\t\t\tName:      \"length-256-check\",\n244\t\t\t\tArgs:      []string{\"--length=256\", \"--check\", len256Checksum},\n245\t\t\t\tExitCode:  0,\n246\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n247\t\t\t},\n248\t\t\t// R3.3: --length=256 with --check BSD tag format\n249\t\t\t{\n250\t\t\t\tName:      \"length-256-check-bsd\",\n251\t\t\t\tArgs:      []string{\"--length=256\", \"--check\", bsd256Checksum},\n252\t\t\t\tExitCode:  0,\n253\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n254\t\t\t},\n255\t\n256\t\t\t// R4.1: exit 0 when all files processed successfully\n257\t\t\t{\n258\t\t\t\tName: \"exit-0-all-ok\",\n259\t\t\t\tArgs: []string{helloFile, emptyFile},\n260\t\t\t},\n261\t\t\t// R4.1: exit 0 when all verified digests match\n262\t\t\t{\n263\t\t\t\tName:      \"exit-0-check-all-match\",\n264\t\t\t\tArgs:      []string{\"--check\", multiChecksum