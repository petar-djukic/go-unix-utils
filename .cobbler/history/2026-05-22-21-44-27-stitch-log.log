{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XeewJMvMxKwFLw8Dgc8chg","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"hash\"\n9\t\t\"os\"\n10\t\t\"strconv\"\n11\t\t\"strings\"\n12\t\n13\t\t\"golang.org/x/crypto/blake2b\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tfunc newBLAKE2b(size int) func() hash.Hash {\n20\t\treturn func() hash.Hash {\n21\t\t\th, _ := blake2b.New(size, nil)\n22\t\t\treturn h\n23\t\t}\n24\t}\n25\t\n26\tfunc main() {\n27\t\tsys.InstallSIGPIPEHandler()\n28\t\topts, files := parseArgs(os.Args[1:])\n29\t\n30\t\tif opts.tag && opts.textExplicit {\n31\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: --tag does not support --text mode\\n\")\n32\t\t\tos.Exit(1)\n33\t\t}\n34\t\n35\t\tif opts.length == 0 {\n36\t\t\topts.length = 512\n37\t\t}\n38\t\tif opts.length <= 0 || opts.length%8 != 0 || opts.length > 512 {\n39\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: invalid length: %d\\n\", opts.length)\n40\t\t\tos.Exit(1)\n41\t\t}\n42\t\n43\t\tdigestBytes := opts.length / 8\n44\t\talgorithm := \"BLAKE2b\"\n45\t\tif opts.length != 512 {\n46\t\t\talgorithm = fmt.Sprintf(\"BLAKE2b-%d\", opts.length)\n47\t\t}\n48\t\n49\t\tcfg := hashutil.HashConfig{\n50\t\t\tAlgorithm: algorithm,\n51\t\t\tNewHash:   newBLAKE2b(digestBytes),\n52\t\t\tDigestLen: digestBytes,\n53\t\t}\n54\t\tif opts.check {\n55\t\t\tcheckOpts := hashutil.CheckOptions{\n56\t\t\t\tWarn:   opts.warn,\n57\t\t\t\tQuiet:  opts.quiet,\n58\t\t\t\tStatus: opts.status,\n59\t\t\t}\n60\t\t\texitCode := 0\n61\t\t\tfor _, f := range files {\n62\t\t\t\tok, err := hashutil.VerifyChecksums(f, cfg, checkOpts, os.Stdout, os.Stderr)\n63\t\t\t\tif err != nil {\n64\t\t\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: %s\\n\", err)\n65\t\t\t\t\texitCode = 1\n66\t\t\t\t} else if !ok {\n67\t\t\t\t\texitCode = 1\n68\t\t\t\t}\n69\t\t\t}\n70\t\t\tos.Exit(exitCode)\n71\t\t}\n72\t\tos.Exit(hashutil.DigestFiles(files, cfg, opts.binary, opts.tag, os.Stdout, os.Stderr))\n73\t}\n74\t\n75\ttype options struct {\n76\t\tbinary       bool\n77\t\ttag          bool\n78\t\tcheck        bool\n79\t\twarn         bool\n80\t\tquiet        bool\n81\t\tstatus       bool\n82\t\tlength       int\n83\t\ttextExplicit bool\n84\t}\n85\t\n86\tfunc parseArgs(args []string) (options, []string) {\n87\t\tvar opts options\n88\t\tvar files []string\n89\t\ti := 0\n90\t\tfor i < len(args) {\n91\t\t\targ := args[i]\n92\t\t\tif arg == \"--\" {\n93\t\t\t\tfiles = append(files, args[i+1:]...)\n94\t\t\t\tbreak\n95\t\t\t}\n96\t\t\tif handled, advance := parseLongFlag(args[i:], &opts); handled {\n97\t\t\t\ti += advance\n98\t\t\t\tcontinue\n99\t\t\t}\n100\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n101\t\t\t\tfiles = append(files, arg)\n102\t\t\t\ti++\n103\t\t\t\tcontinue\n104\t\t\t}\n105\t\t\ti += parseShortFlags(arg[1:], &opts)\n106\t\t}\n107\t\treturn opts, files\n108\t}\n109\t\n110\tfunc parseLongFlag(remaining []string, opts *options) (bool, int) {\n111\t\targ := remaining[0]\n112\t\tif !strings.HasPrefix(arg, \"--\") {\n113\t\t\treturn false, 0\n114\t\t}\n115\t\tif arg == \"--length\" || strings.HasPrefix(arg, \"--length=\") {\n116\t\t\treturn parseLengthFlag(remaining, opts)\n117\t\t}\n118\t\tswitch arg {\n119\t\tcase \"--binary\":\n120\t\t\topts.binary = true\n121\t\tcase \"--text\":\n122\t\t\topts.binary = false\n123\t\t\topts.textExplicit = true\n124\t\tcase \"--tag\":\n125\t\t\topts.tag = true\n126\t\tcase \"--check\":\n127\t\t\topts.check = true\n128\t\tcase \"--warn\":\n129\t\t\topts.warn = true\n130\t\tcase \"--quiet\":\n131\t\t\topts.quiet = true\n132\t\tcase \"--status\":\n133\t\t\topts.status = true\n134\t\tdefault:\n135\t\t\treturn false, 0\n136\t\t}\n137\t\treturn true, 1\n138\t}\n139\t\n140\tfunc parseLengthFlag(remaining []string, opts *options) (bool, int) {\n141\t\targ := remaining[0]\n142\t\tif strings.HasPrefix(arg, \"--length=\") {\n143\t\t\tval := arg[len(\"--length=\"):]\n144\t\t\tn, err := strconv.Atoi(val)\n145\t\t\tif err != nil {\n146\t\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: invalid length: '%s'\\n\", val)\n147\t\t\t\tos.Exit(1)\n148\t\t\t}\n149\t\t\topts.length = n\n150\t\t\treturn true, 1\n151\t\t}\n152\t\tif len(remaining) < 2 {\n153\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: option '--length' requires an argument\\n\")\n154\t\t\tos.Exit(1)\n155\t\t}\n156\t\tn, err := strconv.Atoi(remaining[1])\n157\t\tif err != nil {\n158\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: invalid length: '%s'\\n\", remaining[1])\n159\t\t\tos.Exit(1)\n160\t\t}\n161\t\topts.length = n\n162\t\treturn true, 2\n163\t}\n164\t\n165\tfunc parseShortFlags(flags string, opts *options) int {\n166\t\tfor _, ch := range flags {\n167\t\t\tswitch ch {\n168\t\t\tcase 'b':\n169\t\t\t\topts.binary = true\n170\t\t\tcase 't':\n171\t\t\t\topts.binary = false\n172\t\t\t\topts.textExplicit = true\n173\t\t\tcase 'c':\n174\t\t\t\topts.check = true\n175\t\t\tcase 'w':\n176\t\t\t\topts.warn = true\n177\t\t\t}\n178\t\t}\n179\t\treturn 1\n180\t}\n181\t"}]},"parent_tool_use_id":null,"session_id":"476fc32d-92d8-426e-a248-aa248daf431c","uuid":"5775a188-c5c4-405e-8e8a-dfb084f9272e","timestamp":"2026-05-23T01:45:58.615Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5499/cmd/b2sum/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"hash\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"golang.org/x/crypto/blake2b\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nfunc newBLAKE2b(size int) func() hash.Hash {\n\treturn func() hash.Hash {\n\t\th, _ := blake2b.New(size, nil)\n\t\treturn h\n\t}\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, files := parseArgs(os.Args[1:])\n\n\tif opts.tag && opts.textExplicit {\n\t\tfmt.Fprintf(os.Stderr, \"b2sum: --tag does not support --text mode\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tif opts.length == 0 {\n\t\topts.length = 512\n\t}\n\tif opts.length <= 0 || opts.length%8 != 0 || opts.length > 512 {\n\t\tfmt.Fprintf(os.Stderr, \"b2sum: invalid length: %d\\n\", opts.length)\n\t\tos.Exit(1)\n\t}\n\n\tdigestBytes := opts.length / 8\n\talgorithm := \"BLAKE2b\"\n\tif opts.length != 512 {\n\t\talgorithm = fmt.Sprintf(\"BLAKE2b-%d\", opts.length)\n\t}\n\n\tcfg := hashutil.HashConfig{\n\t\tAlgorithm: algorithm,\n\t\tNewHash:   newBLAKE2b(digestBytes),\n\t\tDigestLen: digestBytes,\n\t}\n\tif opts.check {\n\t\tcheckOpts := hashutil.CheckOptions{\n\t\t\tWarn:   opts.warn,\n\t\t\tQuiet:  opts.quiet,\n\t\t\tStatus: opts.status,\n\t\t}\n\t\texitCode := 0\n\t\tfor _, f := range files {\n\t\t\tok, err := hashutil.VerifyChecksums(f, cfg, checkOpts, os.Stdout, os.Stderr)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: %s\\n\", err)\n\t\t\t\texitCode = 1\n\t\t\t} else if !ok {\n\t\t\t\texitCode = 1\n\t\t\t}\n\t\t}\n\t\tos.Exit(exitCode)\n\t}\n\tos.Exit(hashutil.DigestFiles(files, cfg, opts.binary, opts.tag, os.Stdout, os.Stderr))\n}\n\ntype options struct {\n\tbinary       bool\n\ttag          bool\n\tcheck        bool\n\twarn         bool\n\tquiet        bool\n\tstatus       bool\n\tlength       int\n\ttextExplicit bool\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar files []string\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif handled, advance := parseLongFlag(args[i:], &opts); handled {\n\t\t\ti += advance\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n\t\t\tfiles = append(files, arg)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\ti += parseShortFlags(arg[1:], &opts)\n\t}\n\treturn opts, files\n}\n\nfunc parseLongFlag(remaining []string, opts *options) (bool, int) {\n\targ := remaining[0]\n\tif !strings.HasPrefix(arg, \"--\") {\n\t\treturn false, 0\n\t}\n\tif arg == \"--length\" || strings.HasPrefix(arg, \"--length=\") {\n\t\treturn parseLengthFlag(remaining, opts)\n\t}\n\tswitch arg {\n\tcase \"--binary\":\n\t\topts.binary = true\n\tcase \"--text\":\n\t\topts.binary = false\n\t\topts.textExplicit = true\n\tcase \"--tag\":\n\t\topts.tag = true\n\tcase \"--check\":\n\t\topts.check = true\n\tcase \"--warn\":\n\t\topts.warn = true\n\tcase \"--quiet\":\n\t\topts.quiet = true\n\tcase \"--status\":\n\t\topts.status = true\n\tdefault:\n\t\treturn false, 0\n\t}\n\treturn true, 1\n}\n\nfunc parseLengthFlag(remaining []string, opts *options) (bool, int) {\n\targ := remaining[0]\n\tif strings.HasPrefix(arg, \"--length=\") {\n\t\tval := arg[len(\"--length=\"):]\n\t\tn, err := strconv.Atoi(val)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: invalid length: '%s'\\n\", val)\n\t\t\tos.Exit(1)\n\t\t}\n\t\topts.length = n\n\t\treturn true, 1\n\t}\n\tif len(remaining) < 2 {\n\t\tfmt.Fprintf(os.Stderr, \"b2sum: option '--length' requires an argument\\n\")\n\t\tos.Exit(1)\n\t}\n\tn, err := strconv.Atoi(remaining[1])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"b2sum: invalid length: '%s'\\n\", remaining[1])\n\t\tos.Exit(1)\n\t}\n\topts.length = n\n\treturn true, 2\n}\n\nfunc parseShortFlags(flags string, opts *options) int {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase 'b':\n\t\t\topts.binary = true\n\t\tcase 't':\n\t\t\topts.binary = false\n\t\t\topts.textExplicit = true\n\t\tcase 'c':\n\t\t\topts.check = true\n\t\tcase 'w':\n\t\t\topts.warn = true\n\t\t}\n\t}\n\treturn 1\n}\n","numLines":181,"startLine":1,"totalLines":181}}}
