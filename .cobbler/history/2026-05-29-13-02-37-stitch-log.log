{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019m4CNKpiCuG26vFKMnV9Qe","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/ptx implements srd111-ptx: produce a permuted (KWIC) index of text input.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"sort\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\t\"unicode\"\n17\t\t\"unicode/utf8\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n20\t)\n21\t\n22\tconst (\n23\t\tdefaultWidth   = 72\n24\t\tdefaultGapSize = 3\n25\t)\n26\t\n27\ttype entry struct {\n28\t\tbefore  string\n29\t\tkwAfter string\n30\t\tsortKey string\n31\t}\n32\t\n33\ttype wordSpan struct {\n34\t\tstart, end int\n35\t}\n36\t\n37\tfunc main() {\n38\t\tsys.InstallSIGPIPEHandler()\n39\t\n40\t\targs := os.Args[1:]\n41\t\tif len(args) == 0 {\n42\t\t\targs = []string{\"-\"}\n43\t\t}\n44\t\n45\t\tlines, err := readAllLines(args)\n46\t\tif err != nil {\n47\t\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n48\t\t\tos.Exit(1)\n49\t\t}\n50\t\n51\t\tentries := buildIndex(lines)\n52\t\tsort.SliceStable(entries, func(i, j int) bool {\n53\t\t\treturn entries[i].sortKey < entries[j].sortKey\n54\t\t})\n55\t\n56\t\tif err := writeOutput(entries); err != nil {\n57\t\t\tif errors.Is(err, syscall.EPIPE) {\n58\t\t\t\tos.Exit(0)\n59\t\t\t}\n60\t\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n61\t\t\tos.Exit(1)\n62\t\t}\n63\t}\n64\t\n65\tfunc readAllLines(names []string) ([]string, error) {\n66\t\tvar all []string\n67\t\tfor _, name := range names {\n68\t\t\tlines, err := readFile(name)\n69\t\t\tif err != nil {\n70\t\t\t\treturn nil, err\n71\t\t\t}\n72\t\t\tall = append(all, lines...)\n73\t\t}\n74\t\treturn all, nil\n75\t}\n76\t\n77\tfunc readFile(name string) ([]string, error) {\n78\t\tvar r io.Reader\n79\t\tif name == \"-\" {\n80\t\t\tr = os.Stdin\n81\t\t} else {\n82\t\t\tf, err := os.Open(name)\n83\t\t\tif err != nil {\n84\t\t\t\treturn nil, err\n85\t\t\t}\n86\t\t\tdefer f.Close()\n87\t\t\tr = f\n88\t\t}\n89\t\tsc := bufio.NewScanner(r)\n90\t\tvar lines []string\n91\t\tfor sc.Scan() {\n92\t\t\tlines = append(lines, sc.Text())\n93\t\t}\n94\t\treturn lines, sc.Err()\n95\t}\n96\t\n97\tfunc buildIndex(lines []string) []entry {\n98\t\tvar entries []entry\n99\t\tfor _, line := range lines {\n100\t\t\tfor _, w := range findWords(line) {\n101\t\t\t\tentries = append(entries, entry{\n102\t\t\t\t\tbefore:  line[:w.start],\n103\t\t\t\t\tkwAfter: line[w.start:],\n104\t\t\t\t\tsortKey: line[w.start:w.end],\n105\t\t\t\t})\n106\t\t\t}\n107\t\t}\n108\t\treturn entries\n109\t}\n110\t\n111\tfunc findWords(line string) []wordSpan {\n112\t\tvar spans []wordSpan\n113\t\ti := 0\n114\t\tfor i < len(line) {\n115\t\t\tr, size := utf8.DecodeRuneInString(line[i:])\n116\t\t\tif !isWordChar(r) {\n117\t\t\t\ti += size\n118\t\t\t\tcontinue\n119\t\t\t}\n120\t\t\tstart := i\n121\t\t\tfor i < len(line) {\n122\t\t\t\tr, size = utf8.DecodeRuneInString(line[i:])\n123\t\t\t\tif !isWordChar(r) {\n124\t\t\t\t\tbreak\n125\t\t\t\t}\n126\t\t\t\ti += size\n127\t\t\t}\n128\t\t\tspans = append(spans, wordSpan{start, i})\n129\t\t}\n130\t\treturn spans\n131\t}\n132\t\n133\tfunc isWordChar(r rune) bool {\n134\t\treturn unicode.IsLetter(r) || unicode.IsDigit(r)\n135\t}\n136\t\n137\tfunc writeOutput(entries []entry) error {\n138\t\tw := bufio.NewWriter(os.Stdout)\n139\t\thalf := defaultWidth / 2\n140\t\tleftMax := half - defaultGapSize\n141\t\trightMax := defaultWidth - half - defaultGapSize\n142\t\tfor _, e := range entries {\n143\t\t\tline := formatEntry(e, leftMax, rightMax, half)\n144\t\t\tif _, err := w.WriteString(line); err != nil {\n145\t\t\t\treturn err\n146\t\t\t}\n147\t\t\tif err := w.WriteByte('\\n'); err != nil {\n148\t\t\t\treturn err\n149\t\t\t}\n150\t\t}\n151\t\treturn w.Flush()\n152\t}\n153\t\n154\tfunc formatEntry(e entry, leftMax, rightMax, half int) string {\n155\t\tleft := e.before\n156\t\tif len(left) > leftMax {\n157\t\t\tleft = left[len(left)-leftMax:]\n158\t\t}\n159\t\tkwLen := len(e.sortKey)\n160\t\tright := strings.ToUpper(e.kwAfter[:kwLen]) + e.kwAfter[kwLen:]\n161\t\tif len(right) > rightMax {\n162\t\t\tright = right[:rightMax]\n163\t\t}\n164\t\tvar buf strings.Builder\n165\t\tpad := half - defaultGapSize - len(left)\n166\t\twriteSpaces(&buf, pad)\n167\t\tbuf.WriteString(left)\n168\t\twriteSpaces(&buf, defaultGapSize)\n169\t\tbuf.WriteString(right)\n170\t\treturn buf.String()\n171\t}\n172\t\n173\tfunc writeSpaces(b *strings.Builder, n int) {\n174\t\tfor range n {\n175\t\t\tb.WriteByte(' ')\n176\t\t}\n177\t}\n178\t\n179\tfunc formatErr(err error) string {\n180\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n181\t\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n182\t\t}\n183\t\treturn err.Error()\n184\t}\n185\t"}]},"parent_tool_use_id":null,"session_id":"165afc1e-4c0e-454d-909a-66ac00073bd4","uuid":"0d50d08b-6803-40dc-b414-685a497fdfef","timestamp":"2026-05-29T17:02:46.609Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5655/cmd/ptx/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/ptx implements srd111-ptx: produce a permuted (KWIC) index of text input.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\t\"syscall\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst (\n\tdefaultWidth   = 72\n\tdefaultGapSize = 3\n)\n\ntype entry struct {\n\tbefore  string\n\tkwAfter string\n\tsortKey string\n}\n\ntype wordSpan struct {\n\tstart, end int\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\targs := os.Args[1:]\n\tif len(args) == 0 {\n\t\targs = []string{\"-\"}\n\t}\n\n\tlines, err := readAllLines(args)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n\t\tos.Exit(1)\n\t}\n\n\tentries := buildIndex(lines)\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\treturn entries[i].sortKey < entries[j].sortKey\n\t})\n\n\tif err := writeOutput(entries); err != nil {\n\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\tos.Exit(0)\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n\t\tos.Exit(1)\n\t}\n}\n\nfunc readAllLines(names []string) ([]string, error) {\n\tvar all []string\n\tfor _, name := range names {\n\t\tlines, err := readFile(name)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tall = append(all, lines...)\n\t}\n\treturn all, nil\n}\n\nfunc readFile(name string) ([]string, error) {\n\tvar r io.Reader\n\tif name == \"-\" {\n\t\tr = os.Stdin\n\t} else {\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tdefer f.Close()\n\t\tr = f\n\t}\n\tsc := bufio.NewScanner(r)\n\tvar lines []string\n\tfor sc.Scan() {\n\t\tlines = append(lines, sc.Text())\n\t}\n\treturn lines, sc.Err()\n}\n\nfunc buildIndex(lines []string) []entry {\n\tvar entries []entry\n\tfor _, line := range lines {\n\t\tfor _, w := range findWords(line) {\n\t\t\tentries = append(entries, entry{\n\t\t\t\tbefore:  line[:w.start],\n\t\t\t\tkwAfter: line[w.start:],\n\t\t\t\tsortKey: line[w.start:w.end],\n\t\t\t})\n\t\t}\n\t}\n\treturn entries\n}\n\nfunc findWords(line string) []wordSpan {\n\tvar spans []wordSpan\n\ti := 0\n\tfor i < len(line) {\n\t\tr, size := utf8.DecodeRuneInString(line[i:])\n\t\tif !isWordChar(r) {\n\t\t\ti += size\n\t\t\tcontinue\n\t\t}\n\t\tstart := i\n\t\tfor i < len(line) {\n\t\t\tr, size = utf8.DecodeRuneInString(line[i:])\n\t\t\tif !isWordChar(r) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\ti += size\n\t\t}\n\t\tspans = append(spans, wordSpan{start, i})\n\t}\n\treturn spans\n}\n\nfunc isWordChar(r rune) bool {\n\treturn unicode.IsLetter(r) || unicode.IsDigit(r)\n}\n\nfunc writeOutput(entries []entry) error {\n\tw := bufio.NewWriter(os.Stdout)\n\thalf := defaultWidth / 2\n\tleftMax := half - defaultGapSize\n\trightMax := defaultWidth - half - defaultGapSize\n\tfor _, e := range entries {\n\t\tline := formatEntry(e, leftMax, rightMax, half)\n\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn w.Flush()\n}\n\nfunc formatEntry(e entry, leftMax, rightMax, half int) string {\n\tleft := e.before\n\tif len(left) > leftMax {\n\t\tleft = left[len(left)-leftMax:]\n\t}\n\tkwLen := len(e.sortKey)\n\tright := strings.ToUpper(e.kwAfter[:kwLen]) + e.kwAfter[kwLen:]\n\tif len(right) > rightMax {\n\t\tright = right[:rightMax]\n\t}\n\tvar buf strings.Builder\n\tpad := half - defaultGapSize - len(left)\n\twriteSpaces(&buf, pad)\n\tbuf.WriteString(left)\n\twriteSpaces(&buf, defaultGapSize)\n\tbuf.WriteString(right)\n\treturn buf.String()\n}\n\nfunc writeSpaces(b *strings.Builder, n int) {\n\tfor range n {\n\t\tb.WriteByte(' ')\n\t}\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n","numLines":185,"startLine":1,"totalLines":185}}}
