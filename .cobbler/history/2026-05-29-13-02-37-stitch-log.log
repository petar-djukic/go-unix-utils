{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CiCzeUVxeDieuKgj5CwDbi","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/ptx implements srd111-ptx: produce a permuted (KWIC) index of text input.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"syscall\"\n17\t\t\"unicode\"\n18\t\t\"unicode/utf8\"\n19\t\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n21\t)\n22\t\n23\tconst (\n24\t\tdefaultWidth   = 72\n25\t\tdefaultGapSize = 3\n26\t)\n27\t\n28\ttype options struct {\n29\t\twidth      int\n30\t\tgapSize    int\n31\t\tignoreCase bool\n32\t\tfiles      []string\n33\t}\n34\t\n35\ttype entry struct {\n36\t\tbefore  string\n37\t\tkwAfter string\n38\t\tsortKey string\n39\t}\n40\t\n41\ttype wordSpan struct {\n42\t\tstart, end int\n43\t}\n44\t\n45\tfunc main() {\n46\t\tsys.InstallSIGPIPEHandler()\n47\t\n48\t\topts, err := parseArgs(os.Args[1:])\n49\t\tif err != nil {\n50\t\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", err)\n51\t\t\tos.Exit(1)\n52\t\t}\n53\t\n54\t\tlines, err := readAllLines(opts.files)\n55\t\tif err != nil {\n56\t\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n57\t\t\tos.Exit(1)\n58\t\t}\n59\t\n60\t\tentries := buildIndex(lines, opts.ignoreCase)\n61\t\tsort.SliceStable(entries, func(i, j int) bool {\n62\t\t\treturn entries[i].sortKey < entries[j].sortKey\n63\t\t})\n64\t\n65\t\tif err := writeOutput(entries, opts.width, opts.gapSize); err != nil {\n66\t\t\tif errors.Is(err, syscall.EPIPE) {\n67\t\t\t\tos.Exit(0)\n68\t\t\t}\n69\t\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n70\t\t\tos.Exit(1)\n71\t\t}\n72\t}\n73\t\n74\tfunc parseArgs(args []string) (options, error) {\n75\t\topts := options{\n76\t\t\twidth:   defaultWidth,\n77\t\t\tgapSize: defaultGapSize,\n78\t\t}\n79\t\ti := 0\n80\t\tfor i < len(args) {\n81\t\t\ta := args[i]\n82\t\t\tif a == \"--\" {\n83\t\t\t\ti++\n84\t\t\t\tbreak\n85\t\t\t}\n86\t\t\tif strings.HasPrefix(a, \"--\") {\n87\t\t\t\tn, err := parseLongFlag(a, args[i+1:], &opts)\n88\t\t\t\tif err != nil {\n89\t\t\t\t\treturn opts, err\n90\t\t\t\t}\n91\t\t\t\ti += 1 + n\n92\t\t\t\tcontinue\n93\t\t\t}\n94\t\t\tif a != \"-\" && strings.HasPrefix(a, \"-\") {\n95\t\t\t\tn, err := parseShortFlags(a[1:], args[i+1:], &opts)\n96\t\t\t\tif err != nil {\n97\t\t\t\t\treturn opts, err\n98\t\t\t\t}\n99\t\t\t\ti += 1 + n\n100\t\t\t\tcontinue\n101\t\t\t}\n102\t\t\tbreak\n103\t\t}\n104\t\topts.files = args[i:]\n105\t\tif len(opts.files) == 0 {\n106\t\t\topts.files = []string{\"-\"}\n107\t\t}\n108\t\treturn opts, nil\n109\t}\n110\t\n111\tfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n112\t\tif flag == \"--ignore-case\" {\n113\t\t\topts.ignoreCase = true\n114\t\t\treturn 0, nil\n115\t\t}\n116\t\tif strings.HasPrefix(flag, \"--width=\") {\n117\t\t\treturn 0, parseIntVal(flag[len(\"--width=\"):], &opts.width, \"width\")\n118\t\t}\n119\t\tif flag == \"--width\" {\n120\t\t\tif len(rest) == 0 {\n121\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n122\t\t\t}\n123\t\t\treturn 1, parseIntVal(rest[0], &opts.width, \"width\")\n124\t\t}\n125\t\tif strings.HasPrefix(flag, \"--gap-size=\") {\n126\t\t\treturn 0, parseIntVal(flag[len(\"--gap-size=\"):], &opts.gapSize, \"gap-size\")\n127\t\t}\n128\t\tif flag == \"--gap-size\" {\n129\t\t\tif len(rest) == 0 {\n130\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n131\t\t\t}\n132\t\t\treturn 1, parseIntVal(rest[0], &opts.gapSize, \"gap-size\")\n133\t\t}\n134\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n135\t}\n136\t\n137\tfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n138\t\tfor i := 0; i < len(flags); i++ {\n139\t\t\tswitch flags[i] {\n140\t\t\tcase 'f':\n141\t\t\t\topts.ignoreCase = true\n142\t\t\tcase 'w':\n143\t\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.width, 'w')\n144\t\t\tcase 'g':\n145\t\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.gapSize, 'g')\n146\t\t\tdefault:\n147\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[i])\n148\t\t\t}\n149\t\t}\n150\t\treturn 0, nil\n151\t}\n152\t\n153\tfunc extractAndSetInt(tail string, rest []string, dst *int, flag byte) (int, error) {\n154\t\tval, consumed, err := extractFlagValue(tail, rest, flag)\n155\t\tif err != nil {\n156\t\t\treturn 0, err\n157\t\t}\n158\t\tif err := parseIntVal(val, dst, string(flag)); err != nil {\n159\t\t\treturn 0, err\n160\t\t}\n161\t\treturn consumed, nil\n162\t}\n163\t\n164\tfunc extractFlagValue(tail string, rest []string, flag byte) (string, int, error) {\n165\t\tif tail != \"\" {\n166\t\t\treturn tail, 0, nil\n167\t\t}\n168\t\tif len(rest) > 0 {\n169\t\t\treturn rest[0], 1, nil\n170\t\t}\n171\t\treturn \"\", 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n172\t}\n173\t\n174\tfunc parseIntVal(s string, dst *int, name string) error {\n175\t\tv, err := strconv.Atoi(s)\n176\t\tif err != nil {\n177\t\t\treturn fmt.Errorf(\"invalid %s argument '%s'\", name, s)\n178\t\t}\n179\t\t*dst = v\n180\t\treturn nil\n181\t}\n182\t\n183\tfunc readAllLines(names []string) ([]string, error) {\n184\t\tvar all []string\n185\t\tfor _, name := range names {\n186\t\t\tlines, err := readFile(name)\n187\t\t\tif err != nil {\n188\t\t\t\treturn nil, err\n189\t\t\t}\n190\t\t\tall = append(all, lines...)\n191\t\t}\n192\t\treturn all, nil\n193\t}\n194\t\n195\tfunc readFile(name string) ([]string, error) {\n196\t\tvar r io.Reader\n197\t\tif name == \"-\" {\n198\t\t\tr = os.Stdin\n199\t\t} else {\n200\t\t\tf, err := os.Open(name)\n201\t\t\tif err != nil {\n202\t\t\t\treturn nil, err\n203\t\t\t}\n204\t\t\tdefer f.Close()\n205\t\t\tr = f\n206\t\t}\n207\t\tsc := bufio.NewScanner(r)\n208\t\tvar lines []string\n209\t\tfor sc.Scan() {\n210\t\t\tlines = append(lines, sc.Text())\n211\t\t}\n212\t\treturn lines, sc.Err()\n213\t}\n214\t\n215\tfunc buildIndex(lines []string, foldCase bool) []entry {\n216\t\tvar entries []entry\n217\t\tfor _, line := range lines {\n218\t\t\tfor _, w := range findWords(line) {\n219\t\t\t\tsk := line[w.start:w.end]\n220\t\t\t\tif foldCase {\n221\t\t\t\t\tsk = strings.ToUpper(sk)\n222\t\t\t\t}\n223\t\t\t\tentries = append(entries, entry{\n224\t\t\t\t\tbefore:  line[:w.start],\n225\t\t\t\t\tkwAfter: line[w.start:],\n226\t\t\t\t\tsortKey: sk,\n227\t\t\t\t})\n228\t\t\t}\n229\t\t}\n230\t\treturn entries\n231\t}\n232\t\n233\tfunc findWords(line string) []wordSpan {\n234\t\tvar spans []wordSpan\n235\t\ti := 0\n236\t\tfor i < len(line) {\n237\t\t\tr, size := utf8.DecodeRuneInString(line[i:])\n238\t\t\tif !isWordChar(r) {\n239\t\t\t\ti += size\n240\t\t\t\tcontinue\n241\t\t\t}\n242\t\t\tstart := i\n243\t\t\tfor i < len(line) {\n244\t\t\t\tr, size = utf8.DecodeRuneInString(line[i:])\n245\t\t\t\tif !isWordChar(r) {\n246\t\t\t\t\tbreak\n247\t\t\t\t}\n248\t\t\t\ti += size\n249\t\t\t}\n250\t\t\tspans = append(spans, wordSpan{start, i})\n251\t\t}\n252\t\treturn spans\n253\t}\n254\t\n255\tfunc isWordChar(r rune) bool {\n256\t\treturn unicode.IsLetter(r)\n257\t}\n258\t\n259\tfunc writeOutput(entries []entry, width, gapSize int) error {\n260\t\tw := bufio.NewWriter(os.Stdout)\n261\t\thalf := width / 2\n262\t\trightMax := width - half - gapSize\n263\t\tfor _, e := range entries {\n264\t\t\tline := formatEntry(e, half, gapSize, rightMax)\n265\t\t\tif _, err := w.WriteString(line); err != nil {\n266\t\t\t\treturn err\n267\t\t\t}\n268\t\t\tif err := w.WriteByte('\\n'); err != nil {\n269\t\t\t\treturn err\n270\t\t\t}\n271\t\t}\n272\t\treturn w.Flush()\n273\t}\n274\t\n275\tfunc formatEntry(e entry, half, gapSize, rightMax int) string {\n276\t\tleft := strings.TrimRight(e.before, \" \")\n277\t\tleftMax := max(half-gapSize, 0)\n278\t\tif len(left) > leftMax {\n279\t\t\tleft = left[len(left)-leftMax:]\n280\t\t}\n281\t\tright := e.kwAfter\n282\t\tif rightMax > 0 && len(right) > rightMax {\n283\t\t\tright = right[:rightMax]\n284\t\t}\n285\t\tvar buf strings.Builder\n286\t\twriteSpaces(&buf, half-len(left))\n287\t\tbuf.WriteString(left)\n288\t\twriteSpaces(&buf, gapSize)\n289\t\tbuf.WriteString(right)\n290\t\treturn buf.String()\n291\t}\n292\t\n293\tfunc writeSpaces(b *strings.Builder, n int) {\n294\t\tfor range n {\n295\t\t\tb.WriteByte(' ')\n296\t\t}\n297\t}\n298\t\n299\tfunc formatErr(err error) string {\n300\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n301\t\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n302\t\t}\n303\t\treturn err.Error()\n304\t}\n305\t"}]},"parent_tool_use_id":null,"session_id":"165afc1e-4c0e-454d-909a-66ac00073bd4","uuid":"dc5d720e-16f0-4a62-ad13-ec7922e86434","timestamp":"2026-05-29T17:17:19.357Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5655/cmd/ptx/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/ptx implements srd111-ptx: produce a permuted (KWIC) index of text input.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst (\n\tdefaultWidth   = 72\n\tdefaultGapSize = 3\n)\n\ntype options struct {\n\twidth      int\n\tgapSize    int\n\tignoreCase bool\n\tfiles      []string\n}\n\ntype entry struct {\n\tbefore  string\n\tkwAfter string\n\tsortKey string\n}\n\ntype wordSpan struct {\n\tstart, end int\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tlines, err := readAllLines(opts.files)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n\t\tos.Exit(1)\n\t}\n\n\tentries := buildIndex(lines, opts.ignoreCase)\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\treturn entries[i].sortKey < entries[j].sortKey\n\t})\n\n\tif err := writeOutput(entries, opts.width, opts.gapSize); err != nil {\n\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\tos.Exit(0)\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, \"ptx: %s\\n\", formatErr(err))\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) (options, error) {\n\topts := options{\n\t\twidth:   defaultWidth,\n\t\tgapSize: defaultGapSize,\n\t}\n\ti := 0\n\tfor i < len(args) {\n\t\ta := args[i]\n\t\tif a == \"--\" {\n\t\t\ti++\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(a, \"--\") {\n\t\t\tn, err := parseLongFlag(a, args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\tif a != \"-\" && strings.HasPrefix(a, \"-\") {\n\t\t\tn, err := parseShortFlags(a[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\tbreak\n\t}\n\topts.files = args[i:]\n\tif len(opts.files) == 0 {\n\t\topts.files = []string{\"-\"}\n\t}\n\treturn opts, nil\n}\n\nfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n\tif flag == \"--ignore-case\" {\n\t\topts.ignoreCase = true\n\t\treturn 0, nil\n\t}\n\tif strings.HasPrefix(flag, \"--width=\") {\n\t\treturn 0, parseIntVal(flag[len(\"--width=\"):], &opts.width, \"width\")\n\t}\n\tif flag == \"--width\" {\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\treturn 1, parseIntVal(rest[0], &opts.width, \"width\")\n\t}\n\tif strings.HasPrefix(flag, \"--gap-size=\") {\n\t\treturn 0, parseIntVal(flag[len(\"--gap-size=\"):], &opts.gapSize, \"gap-size\")\n\t}\n\tif flag == \"--gap-size\" {\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\treturn 1, parseIntVal(rest[0], &opts.gapSize, \"gap-size\")\n\t}\n\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n}\n\nfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n\tfor i := 0; i < len(flags); i++ {\n\t\tswitch flags[i] {\n\t\tcase 'f':\n\t\t\topts.ignoreCase = true\n\t\tcase 'w':\n\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.width, 'w')\n\t\tcase 'g':\n\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.gapSize, 'g')\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[i])\n\t\t}\n\t}\n\treturn 0, nil\n}\n\nfunc extractAndSetInt(tail string, rest []string, dst *int, flag byte) (int, error) {\n\tval, consumed, err := extractFlagValue(tail, rest, flag)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tif err := parseIntVal(val, dst, string(flag)); err != nil {\n\t\treturn 0, err\n\t}\n\treturn consumed, nil\n}\n\nfunc extractFlagValue(tail string, rest []string, flag byte) (string, int, error) {\n\tif tail != \"\" {\n\t\treturn tail, 0, nil\n\t}\n\tif len(rest) > 0 {\n\t\treturn rest[0], 1, nil\n\t}\n\treturn \"\", 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n}\n\nfunc parseIntVal(s string, dst *int, name string) error {\n\tv, err := strconv.Atoi(s)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid %s argument '%s'\", name, s)\n\t}\n\t*dst = v\n\treturn nil\n}\n\nfunc readAllLines(names []string) ([]string, error) {\n\tvar all []string\n\tfor _, name := range names {\n\t\tlines, err := readFile(name)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tall = append(all, lines...)\n\t}\n\treturn all, nil\n}\n\nfunc readFile(name string) ([]string, error) {\n\tvar r io.Reader\n\tif name == \"-\" {\n\t\tr = os.Stdin\n\t} else {\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tdefer f.Close()\n\t\tr = f\n\t}\n\tsc := bufio.NewScanner(r)\n\tvar lines []string\n\tfor sc.Scan() {\n\t\tlines = append(lines, sc.Text())\n\t}\n\treturn lines, sc.Err()\n}\n\nfunc buildIndex(lines []string, foldCase bool) []entry {\n\tvar entries []entry\n\tfor _, line := range lines {\n\t\tfor _, w := range findWords(line) {\n\t\t\tsk := line[w.start:w.end]\n\t\t\tif foldCase {\n\t\t\t\tsk = strings.ToUpper(sk)\n\t\t\t}\n\t\t\tentries = append(entries, entry{\n\t\t\t\tbefore:  line[:w.start],\n\t\t\t\tkwAfter: line[w.start:],\n\t\t\t\tsortKey: sk,\n\t\t\t})\n\t\t}\n\t}\n\treturn entries\n}\n\nfunc findWords(line string) []wordSpan {\n\tvar spans []wordSpan\n\ti := 0\n\tfor i < len(line) {\n\t\tr, size := utf8.DecodeRuneInString(line[i:])\n\t\tif !isWordChar(r) {\n\t\t\ti += size\n\t\t\tcontinue\n\t\t}\n\t\tstart := i\n\t\tfor i < len(line) {\n\t\t\tr, size = utf8.DecodeRuneInString(line[i:])\n\t\t\tif !isWordChar(r) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\ti += size\n\t\t}\n\t\tspans = append(spans, wordSpan{start, i})\n\t}\n\treturn spans\n}\n\nfunc isWordChar(r rune) bool {\n\treturn unicode.IsLetter(r)\n}\n\nfunc writeOutput(entries []entry, width, gapSize int) error {\n\tw := bufio.NewWriter(os.Stdout)\n\thalf := width / 2\n\trightMax := width - half - gapSize\n\tfor _, e := range entries {\n\t\tline := formatEntry(e, half, gapSize, rightMax)\n\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn w.Flush()\n}\n\nfunc formatEntry(e entry, half, gapSize, rightMax int) string {\n\tleft := strings.TrimRight(e.before, \" \")\n\tleftMax := max(half-gapSize, 0)\n\tif len(left) > leftMax {\n\t\tleft = left[len(left)-leftMax:]\n\t}\n\tright := e.kwAfter\n\tif rightMax > 0 && len(right) > rightMax {\n\t\tright = right[:rightMax]\n\t}\n\tvar buf strings.Builder\n\twriteSpaces(&buf, half-len(left))\n\tbuf.WriteString(left)\n\twriteSpaces(&buf, gapSize)\n\tbuf.WriteString(right)\n\treturn buf.String()\n}\n\nfunc writeSpaces(b *strings.Builder, n int) {\n\tfor range n {\n\t\tb.WriteByte(' ')\n\t}\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n","numLines":305,"startLine":1,"totalLines":305}}}
