{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xc4UfaBZheKkAUdAFbHzWV","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd026-cut.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"math\"\n12\t\t\"os\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\n17\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n18\t)\n19\t\n20\ttype options struct {\n21\t\tbyteList      string\n22\t\tcharList      string\n23\t\tfieldList     string\n24\t\tdelimiter     byte\n25\t\toutputDelim   string\n26\t\tcomplement    bool\n27\t\tonlyDelimited bool\n28\t\thasOutputDel  bool\n29\t}\n30\t\n31\tfunc main() {\n32\t\tsys.InstallSIGPIPEHandler()\n33\t\tw := bufio.NewWriter(os.Stdout)\n34\t\topts, files, err := parseArgs(os.Args[1:])\n35\t\tif err != nil {\n36\t\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n37\t\t\tos.Exit(1)\n38\t\t}\n39\t\texitCode := processFiles(w, opts, files)\n40\t\tif err := w.Flush(); err != nil {\n41\t\t\tos.Exit(1)\n42\t\t}\n43\t\tos.Exit(exitCode)\n44\t}\n45\t\n46\tfunc processFiles(w *bufio.Writer, opts options, files []string) int {\n47\t\texitCode := 0\n48\t\tif len(files) == 0 {\n49\t\t\tcutLine(os.Stdin, w, opts)\n50\t\t\treturn exitCode\n51\t\t}\n52\t\tfor _, name := range files {\n53\t\t\tif name == \"-\" {\n54\t\t\t\tcutLine(os.Stdin, w, opts)\n55\t\t\t\tcontinue\n56\t\t\t}\n57\t\t\tf, err := os.Open(name)\n58\t\t\tif err != nil {\n59\t\t\t\tfmt.Fprintf(os.Stderr, \"cut: %v\\n\", err)\n60\t\t\t\texitCode = 1\n61\t\t\t\tcontinue\n62\t\t\t}\n63\t\t\tcutLine(f, w, opts)\n64\t\t\tf.Close()\n65\t\t}\n66\t\treturn exitCode\n67\t}\n68\t\n69\tfunc parseArgs(args []string) (options, []string, error) {\n70\t\topts := options{delimiter: '\\t'}\n71\t\tvar files []string\n72\t\tfor i := 0; i < len(args); i++ {\n73\t\t\ta := args[i]\n74\t\t\tif a == \"--\" {\n75\t\t\t\tfiles = append(files, args[i+1:]...)\n76\t\t\t\tbreak\n77\t\t\t}\n78\t\t\tif a == \"--complement\" {\n79\t\t\t\topts.complement = true\n80\t\t\t\tcontinue\n81\t\t\t}\n82\t\t\tif a == \"--output-delimiter\" {\n83\t\t\t\tif i+1 >= len(args) {\n84\t\t\t\t\treturn options{}, nil, fmt.Errorf(\"option '--output-delimiter' requires an argument\")\n85\t\t\t\t}\n86\t\t\t\ti++\n87\t\t\t\topts.outputDelim = args[i]\n88\t\t\t\topts.hasOutputDel = true\n89\t\t\t\tcontinue\n90\t\t\t}\n91\t\t\tif strings.HasPrefix(a, \"--output-delimiter=\") {\n92\t\t\t\topts.outputDelim = a[len(\"--output-delimiter=\"):]\n93\t\t\t\topts.hasOutputDel = true\n94\t\t\t\tcontinue\n95\t\t\t}\n96\t\t\tadvanced, newI, err := parseShortFlag(a, args, i, &opts)\n97\t\t\tif err != nil {\n98\t\t\t\treturn options{}, nil, err\n99\t\t\t}\n100\t\t\ti = newI\n101\t\t\tif advanced {\n102\t\t\t\tcontinue\n103\t\t\t}\n104\t\t\tfiles = append(files, a)\n105\t\t}\n106\t\treturn opts, files, validateOpts(opts)\n107\t}\n108\t\n109\tfunc parseShortFlag(a string, args []string, i int, opts *options) (bool, int, error) {\n110\t\tswitch {\n111\t\tcase a == \"-b\" || strings.HasPrefix(a, \"-b\"):\n112\t\t\tval, idx, err := flagValue(a, \"-b\", args, i)\n113\t\t\tif err != nil {\n114\t\t\t\treturn false, i, err\n115\t\t\t}\n116\t\t\topts.byteList = val\n117\t\t\treturn true, idx, nil\n118\t\tcase a == \"-c\" || strings.HasPrefix(a, \"-c\"):\n119\t\t\tval, idx, err := flagValue(a, \"-c\", args, i)\n120\t\t\tif err != nil {\n121\t\t\t\treturn false, i, err\n122\t\t\t}\n123\t\t\topts.charList = val\n124\t\t\treturn true, idx, nil\n125\t\tcase a == \"-f\" || strings.HasPrefix(a, \"-f\"):\n126\t\t\tval, idx, err := flagValue(a, \"-f\", args, i)\n127\t\t\tif err != nil {\n128\t\t\t\treturn false, i, err\n129\t\t\t}\n130\t\t\topts.fieldList = val\n131\t\t\treturn true, idx, nil\n132\t\tcase a == \"-d\" || strings.HasPrefix(a, \"-d\"):\n133\t\t\tval, idx, err := flagValue(a, \"-d\", args, i)\n134\t\t\tif err != nil {\n135\t\t\t\treturn false, i, err\n136\t\t\t}\n137\t\t\tif len(val) != 1 {\n138\t\t\t\treturn false, i, fmt.Errorf(\"the delimiter must be a single character\")\n139\t\t\t}\n140\t\t\topts.delimiter = val[0]\n141\t\t\treturn true, idx, nil\n142\t\tcase a == \"-s\":\n143\t\t\topts.onlyDelimited = true\n144\t\t\treturn true, i, nil\n145\t\t}\n146\t\tif strings.HasPrefix(a, \"-\") && a != \"-\" {\n147\t\t\treturn false, i, fmt.Errorf(\"invalid option -- '%s'\", a[1:])\n148\t\t}\n149\t\treturn false, i, nil\n150\t}\n151\t\n152\tfunc flagValue(a, flag string, args []string, i int) (string, int, error) {\n153\t\tif a == flag {\n154\t\t\tif i+1 >= len(args) {\n155\t\t\t\treturn \"\", i, fmt.Errorf(\"option requires an argument -- '%s'\", flag[1:])\n156\t\t\t}\n157\t\t\treturn args[i+1], i + 1, nil\n158\t\t}\n159\t\treturn a[len(flag):], i, nil\n160\t}\n161\t\n162\tfunc validateOpts(opts options) error {\n163\t\tcount := 0\n164\t\tif opts.byteList != \"\" {\n165\t\t\tcount++\n166\t\t}\n167\t\tif opts.charList != \"\" {\n168\t\t\tcount++\n169\t\t}\n170\t\tif opts.fieldList != \"\" {\n171\t\t\tcount++\n172\t\t}\n173\t\tif count == 0 {\n174\t\t\treturn fmt.Errorf(\"you must specify a list of bytes, characters, or fields\")\n175\t\t}\n176\t\tif count > 1 {\n177\t\t\treturn fmt.Errorf(\"only one type of list may be specified\")\n178\t\t}\n179\t\treturn nil\n180\t}\n181\t\n182\tfunc cutLine(r io.Reader, w *bufio.Writer, opts options) {\n183\t\tswitch {\n184\t\tcase opts.byteList != \"\":\n185\t\t\tcutBytes(r, w, opts)\n186\t\tcase opts.charList != \"\":\n187\t\t\tcutChars(r, w, opts)\n188\t\tdefault:\n189\t\t\tcutFields(r, w, opts)\n190\t\t}\n191\t}\n192\t\n193\tfunc cutBytes(r io.Reader, w *bufio.Writer, opts options) {\n194\t\tranges, err := parseRangeList(opts.byteList)\n195\t\tif err != nil {\n196\t\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n197\t\t\treturn\n198\t\t}\n199\t\tif opts.complement {\n200\t\t\tranges = complementRanges(ranges)\n201\t\t}\n202\t\tprocessLines(r, w, ranges)\n203\t}\n204\t\n205\tfunc cutChars(r io.Reader, w *bufio.Writer, opts options) {\n206\t\tranges, err := parseRangeList(opts.charList)\n207\t\tif err != nil {\n208\t\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n209\t\t\treturn\n210\t\t}\n211\t\tif opts.complement {\n212\t\t\tranges = complementRanges(ranges)\n213\t\t}\n214\t\tprocessLines(r, w, ranges)\n215\t}\n216\t\n217\tfunc processLines(r io.Reader, w *bufio.Writer, ranges [][2]int) {\n218\t\tbr := bufio.NewReader(r)\n219\t\tfor {\n220\t\t\tline, err := br.ReadBytes('\\n')\n221\t\t\tif len(line) > 0 && line[len(line)-1] == '\\n' {\n222\t\t\t\tline = line[:len(line)-1]\n223\t\t\t}\n224\t\t\tif len(line) > 0 {\n225\t\t\t\twriteSelectedBytes(w, line, ranges)\n226\t\t\t}\n227\t\t\tif err == nil || len(line) > 0 {\n228\t\t\t\tw.WriteByte('\\n')\n229\t\t\t}\n230\t\t\tif err != nil {\n231\t\t\t\tbreak\n232\t\t\t}\n233\t\t}\n234\t}\n235\t\n236\tfunc writeSelectedBytes(w *bufio.Writer, line []byte, ranges [][2]int) {\n237\t\tlineLen := len(line)\n238\t\tfor _, rng := range ranges {\n239\t\t\tlo := rng[0] - 1\n240\t\t\thi := rng[1]\n241\t\t\tif lo >= lineLen {\n242\t\t\t\tcontinue\n243\t\t\t}\n244\t\t\tif hi > lineLen {\n245\t\t\t\thi = lineLen\n246\t\t\t}\n247\t\t\tw.Write(line[lo:hi])\n248\t\t}\n249\t}\n250\t\n251\tfunc parseRangeList(list string) ([][2]int, error) {\n252\t\tparts := strings.Split(list, \",\")\n253\t\tvar ranges [][2]int\n254\t\tfor _, p := range parts {\n255\t\t\tr, err := parseRange(p)\n256\t\t\tif err != nil {\n257\t\t\t\treturn nil, err\n258\t\t\t}\n259\t\t\tranges = append(ranges, r)\n260\t\t}\n261\t\treturn mergeRanges(ranges), nil\n262\t}\n263\t\n264\tfunc parseRange(s string) ([2]int, error) {\n265\t\tif s == \"\" {\n266\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range\")\n267\t\t}\n268\t\tidx := strings.Index(s, \"-\")\n269\t\tif idx < 0 {\n270\t\t\tn, err := strconv.Atoi(s)\n271\t\t\tif err != nil || n <= 0 {\n272\t\t\t\treturn [2]int{}, fmt.Errorf(\"invalid byte/character position '%s'\", s)\n273\t\t\t}\n274\t\t\treturn [2]int{n, n}, nil\n275\t\t}\n276\t\treturn parseHyphenRange(s, idx)\n277\t}\n278\t\n279\tfunc parseHyphenRange(s string, idx int) ([2]int, error) {\n280\t\tif idx == 0 {\n281\t\t\thi, err := strconv.Atoi(s[1:])\n282\t\t\tif err != nil || hi <= 0 {\n283\t\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n284\t\t\t}\n285\t\t\treturn [2]int{1, hi}, nil\n286\t\t}\n287\t\tlo, err := strconv.Atoi(s[:idx])\n288\t\tif err != nil || lo <= 0 {\n289\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n290\t\t}\n291\t\tif idx == len(s)-1 {\n292\t\t\treturn [2]int{lo, math.MaxInt}, nil\n293\t\t}\n294\t\thi, err := strconv.Atoi(s[idx+1:])\n295\t\tif err != nil || hi <= 0 {\n296\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n297\t\t}\n298\t\tif lo > hi {\n299\t\t\treturn [2]int{}, fmt.Errorf(\"invalid decreasing range\")\n300\t\t}\n301\t\treturn [2]int{lo, hi}, nil\n302\t}\n303\t\n304\tfunc mergeRanges(ranges [][2]int) [][2]int {\n305\t\tif len(ranges) == 0 {\n306\t\t\treturn ranges\n307\t\t}\n308\t\tsort.Slice(ranges, func(i, j int) bool {\n309\t\t\treturn ranges[i][0] < ranges[j][0]\n310\t\t})\n311\t\tmerged := [][2]int{ranges[0]}\n312\t\tfor _, r := range ranges[1:] {\n313\t\t\tlast := &merged[len(merged)-1]\n314\t\t\tif r[0] <= last[1]+1 {\n315\t\t\t\tif r[1] > last[1] {\n316\t\t\t\t\tlast[1] = r[1]\n317\t\t\t\t}\n318\t\t\t} else {\n319\t\t\t\tmerged = append(merged, r)\n320\t\t\t}\n321\t\t}\n322\t\treturn merged\n323\t}\n324\t\n325\tfunc complementRanges(ranges [][2]int) [][2]int {\n326\t\tvar result [][2]int\n327\t\tprev := 1\n328\t\tfor _, r := range ranges {\n329\t\t\tif r[0] > prev {\n330\t\t\t\tresult = append(result, [2]int{prev, r[0] - 1})\n331\t\t\t}\n332\t\t\tprev = r[1] + 1\n333\t\t}\n334\t\tif prev > 0 && prev < math.MaxInt {\n335\t\t\tresult = append(result, [2]int{prev, math.MaxInt})\n336\t\t}\n337\t\treturn result\n338\t}\n339\t\n340\tfunc cutFields(r io.Reader, w *bufio.Writer, opts options) {\n341\t\tranges, err := parseRangeList(opts.fieldList)\n342\t\tif err != nil {\n343\t\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n344\t\t\treturn\n345\t\t}\n346\t\tif opts.complement {\n347\t\t\tranges = complementRanges(ranges)\n348\t\t}\n349\t\toutDelim := string(opts.delimiter)\n350\t\tif opts.hasOutputDel {\n351\t\t\toutDelim = opts.outputDelim\n352\t\t}\n353\t\tbr := bufio.NewReader(r)\n354\t\tfor {\n355\t\t\tline, readErr := br.ReadString('\\n')\n356\t\t\thasNewline := len(line) > 0 && line[len(line)-1] == '\\n'\n357\t\t\tif hasNewline {\n358\t\t\t\tline = line[:len(line)-1]\n359\t\t\t}\n360\t\t\thasDelim := containsByte(line, opts.delimiter)\n361\t\t\tif !hasDelim && opts.onlyDelimited {\n362\t\t\t\tif readErr != nil {\n363\t\t\t\t\tbreak\n364\t\t\t\t}\n365\t\t\t\tcontinue\n366\t\t\t}\n367\t\t\tif hasDelim {\n368\t\t\t\twriteSelectedFields(w, line, opts.delimiter, ranges, outDelim)\n369\t\t\t} else if len(line) > 0 {\n370\t\t\t\tw.WriteString(line)\n371\t\t\t}\n372\t\t\tif readErr == nil || len(line) > 0 {\n373\t\t\t\tw.WriteByte('\\n')\n374\t\t\t}\n375\t\t\tif readErr != nil {\n376\t\t\t\tbreak\n377\t\t\t}\n378\t\t}\n379\t}\n380\t\n381\tfunc writeSelectedFields(w *bufio.Writer, line string, delim byte, ranges [][2]int, outDelim string) {\n382\t\tfields := splitFields(line, delim)\n383\t\tselected := selectFields(fields, ranges)\n384\t\tw.WriteString(strings.Join(selected, outDelim))\n385\t}\n386\t\n387\tfunc containsByte(s string, b byte) bool {\n388\t\tfor i := 0; i < len(s); i++ {\n389\t\t\tif s[i] == b {\n390\t\t\t\treturn true\n391\t\t\t}\n392\t\t}\n393\t\treturn false\n394\t}\n395\t\n396\tfunc splitFields(line string, delim byte) []string {\n397\t\tvar fields []string\n398\t\tstart := 0\n399\t\tfor i := 0; i < len(line); i++ {\n400\t\t\tif line[i] == delim {\n401\t\t\t\tfields = append(fields, line[start:i])\n402\t\t\t\tstart = i + 1\n403\t\t\t}\n404\t\t}\n405\t\tfields = append(fields, line[start:])\n406\t\treturn fields\n407\t}\n408\t\n409\tfunc selectFields(fields []string, ranges [][2]int) []string {\n410\t\tvar result []string\n411\t\tn := len(fields)\n412\t\tfor _, rng := range ranges {\n413\t\t\tlo := rng[0]\n414\t\t\thi := rng[1]\n415\t\t\tif lo > n {\n416\t\t\t\tcontinue\n417\t\t\t}\n418\t\t\tif hi > n {\n419\t\t\t\thi = n\n420\t\t\t}\n421\t\t\tfor i := lo; i <= hi; i++ {\n422\t\t\t\tresult = append(result, fields[i-1])\n423\t\t\t}\n424\t\t}\n425\t\treturn result\n426\t}\n427\t"}]},"parent_tool_use_id":null,"session_id":"d1329a98-9a68-4c83-8b22-4b03cd6229d4","uuid":"a9bb833a-b75e-4a84-84c9-6fcf0334e7b0","timestamp":"2026-05-15T15:10:41.702Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5283/cmd/cut/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd026-cut.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"math\"\n\t\"os\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype options struct {\n\tbyteList      string\n\tcharList      string\n\tfieldList     string\n\tdelimiter     byte\n\toutputDelim   string\n\tcomplement    bool\n\tonlyDelimited bool\n\thasOutputDel  bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tw := bufio.NewWriter(os.Stdout)\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\texitCode := processFiles(w, opts, files)\n\tif err := w.Flush(); err != nil {\n\t\tos.Exit(1)\n\t}\n\tos.Exit(exitCode)\n}\n\nfunc processFiles(w *bufio.Writer, opts options, files []string) int {\n\texitCode := 0\n\tif len(files) == 0 {\n\t\tcutLine(os.Stdin, w, opts)\n\t\treturn exitCode\n\t}\n\tfor _, name := range files {\n\t\tif name == \"-\" {\n\t\t\tcutLine(os.Stdin, w, opts)\n\t\t\tcontinue\n\t\t}\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"cut: %v\\n\", err)\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tcutLine(f, w, opts)\n\t\tf.Close()\n\t}\n\treturn exitCode\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\topts := options{delimiter: '\\t'}\n\tvar files []string\n\tfor i := 0; i < len(args); i++ {\n\t\ta := args[i]\n\t\tif a == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif a == \"--complement\" {\n\t\t\topts.complement = true\n\t\t\tcontinue\n\t\t}\n\t\tif a == \"--output-delimiter\" {\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn options{}, nil, fmt.Errorf(\"option '--output-delimiter' requires an argument\")\n\t\t\t}\n\t\t\ti++\n\t\t\topts.outputDelim = args[i]\n\t\t\topts.hasOutputDel = true\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(a, \"--output-delimiter=\") {\n\t\t\topts.outputDelim = a[len(\"--output-delimiter=\"):]\n\t\t\topts.hasOutputDel = true\n\t\t\tcontinue\n\t\t}\n\t\tadvanced, newI, err := parseShortFlag(a, args, i, &opts)\n\t\tif err != nil {\n\t\t\treturn options{}, nil, err\n\t\t}\n\t\ti = newI\n\t\tif advanced {\n\t\t\tcontinue\n\t\t}\n\t\tfiles = append(files, a)\n\t}\n\treturn opts, files, validateOpts(opts)\n}\n\nfunc parseShortFlag(a string, args []string, i int, opts *options) (bool, int, error) {\n\tswitch {\n\tcase a == \"-b\" || strings.HasPrefix(a, \"-b\"):\n\t\tval, idx, err := flagValue(a, \"-b\", args, i)\n\t\tif err != nil {\n\t\t\treturn false, i, err\n\t\t}\n\t\topts.byteList = val\n\t\treturn true, idx, nil\n\tcase a == \"-c\" || strings.HasPrefix(a, \"-c\"):\n\t\tval, idx, err := flagValue(a, \"-c\", args, i)\n\t\tif err != nil {\n\t\t\treturn false, i, err\n\t\t}\n\t\topts.charList = val\n\t\treturn true, idx, nil\n\tcase a == \"-f\" || strings.HasPrefix(a, \"-f\"):\n\t\tval, idx, err := flagValue(a, \"-f\", args, i)\n\t\tif err != nil {\n\t\t\treturn false, i, err\n\t\t}\n\t\topts.fieldList = val\n\t\treturn true, idx, nil\n\tcase a == \"-d\" || strings.HasPrefix(a, \"-d\"):\n\t\tval, idx, err := flagValue(a, \"-d\", args, i)\n\t\tif err != nil {\n\t\t\treturn false, i, err\n\t\t}\n\t\tif len(val) != 1 {\n\t\t\treturn false, i, fmt.Errorf(\"the delimiter must be a single character\")\n\t\t}\n\t\topts.delimiter = val[0]\n\t\treturn true, idx, nil\n\tcase a == \"-s\":\n\t\topts.onlyDelimited = true\n\t\treturn true, i, nil\n\t}\n\tif strings.HasPrefix(a, \"-\") && a != \"-\" {\n\t\treturn false, i, fmt.Errorf(\"invalid option -- '%s'\", a[1:])\n\t}\n\treturn false, i, nil\n}\n\nfunc flagValue(a, flag string, args []string, i int) (string, int, error) {\n\tif a == flag {\n\t\tif i+1 >= len(args) {\n\t\t\treturn \"\", i, fmt.Errorf(\"option requires an argument -- '%s'\", flag[1:])\n\t\t}\n\t\treturn args[i+1], i + 1, nil\n\t}\n\treturn a[len(flag):], i, nil\n}\n\nfunc validateOpts(opts options) error {\n\tcount := 0\n\tif opts.byteList != \"\" {\n\t\tcount++\n\t}\n\tif opts.charList != \"\" {\n\t\tcount++\n\t}\n\tif opts.fieldList != \"\" {\n\t\tcount++\n\t}\n\tif count == 0 {\n\t\treturn fmt.Errorf(\"you must specify a list of bytes, characters, or fields\")\n\t}\n\tif count > 1 {\n\t\treturn fmt.Errorf(\"only one type of list may be specified\")\n\t}\n\treturn nil\n}\n\nfunc cutLine(r io.Reader, w *bufio.Writer, opts options) {\n\tswitch {\n\tcase opts.byteList != \"\":\n\t\tcutBytes(r, w, opts)\n\tcase opts.charList != \"\":\n\t\tcutChars(r, w, opts)\n\tdefault:\n\t\tcutFields(r, w, opts)\n\t}\n}\n\nfunc cutBytes(r io.Reader, w *bufio.Writer, opts options) {\n\tranges, err := parseRangeList(opts.byteList)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n\t\treturn\n\t}\n\tif opts.complement {\n\t\tranges = complementRanges(ranges)\n\t}\n\tprocessLines(r, w, ranges)\n}\n\nfunc cutChars(r io.Reader, w *bufio.Writer, opts options) {\n\tranges, err := parseRangeList(opts.charList)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n\t\treturn\n\t}\n\tif opts.complement {\n\t\tranges = complementRanges(ranges)\n\t}\n\tprocessLines(r, w, ranges)\n}\n\nfunc processLines(r io.Reader, w *bufio.Writer, ranges [][2]int) {\n\tbr := bufio.NewReader(r)\n\tfor {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 && line[len(line)-1] == '\\n' {\n\t\t\tline = line[:len(line)-1]\n\t\t}\n\t\tif len(line) > 0 {\n\t\t\twriteSelectedBytes(w, line, ranges)\n\t\t}\n\t\tif err == nil || len(line) > 0 {\n\t\t\tw.WriteByte('\\n')\n\t\t}\n\t\tif err != nil {\n\t\t\tbreak\n\t\t}\n\t}\n}\n\nfunc writeSelectedBytes(w *bufio.Writer, line []byte, ranges [][2]int) {\n\tlineLen := len(line)\n\tfor _, rng := range ranges {\n\t\tlo := rng[0] - 1\n\t\thi := rng[1]\n\t\tif lo >= lineLen {\n\t\t\tcontinue\n\t\t}\n\t\tif hi > lineLen {\n\t\t\thi = lineLen\n\t\t}\n\t\tw.Write(line[lo:hi])\n\t}\n}\n\nfunc parseRangeList(list string) ([][2]int, error) {\n\tparts := strings.Split(list, \",\")\n\tvar ranges [][2]int\n\tfor _, p := range parts {\n\t\tr, err := parseRange(p)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tranges = append(ranges, r)\n\t}\n\treturn mergeRanges(ranges), nil\n}\n\nfunc parseRange(s string) ([2]int, error) {\n\tif s == \"\" {\n\t\treturn [2]int{}, fmt.Errorf(\"invalid range\")\n\t}\n\tidx := strings.Index(s, \"-\")\n\tif idx < 0 {\n\t\tn, err := strconv.Atoi(s)\n\t\tif err != nil || n <= 0 {\n\t\t\treturn [2]int{}, fmt.Errorf(\"invalid byte/character position '%s'\", s)\n\t\t}\n\t\treturn [2]int{n, n}, nil\n\t}\n\treturn parseHyphenRange(s, idx)\n}\n\nfunc parseHyphenRange(s string, idx int) ([2]int, error) {\n\tif idx == 0 {\n\t\thi, err := strconv.Atoi(s[1:])\n\t\tif err != nil || hi <= 0 {\n\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n\t\t}\n\t\treturn [2]int{1, hi}, nil\n\t}\n\tlo, err := strconv.Atoi(s[:idx])\n\tif err != nil || lo <= 0 {\n\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n\t}\n\tif idx == len(s)-1 {\n\t\treturn [2]int{lo, math.MaxInt}, nil\n\t}\n\thi, err := strconv.Atoi(s[idx+1:])\n\tif err != nil || hi <= 0 {\n\t\treturn [2]int{}, fmt.Errorf(\"invalid range '%s'\", s)\n\t}\n\tif lo > hi {\n\t\treturn [2]int{}, fmt.Errorf(\"invalid decreasing range\")\n\t}\n\treturn [2]int{lo, hi}, nil\n}\n\nfunc mergeRanges(ranges [][2]int) [][2]int {\n\tif len(ranges) == 0 {\n\t\treturn ranges\n\t}\n\tsort.Slice(ranges, func(i, j int) bool {\n\t\treturn ranges[i][0] < ranges[j][0]\n\t})\n\tmerged := [][2]int{ranges[0]}\n\tfor _, r := range ranges[1:] {\n\t\tlast := &merged[len(merged)-1]\n\t\tif r[0] <= last[1]+1 {\n\t\t\tif r[1] > last[1] {\n\t\t\t\tlast[1] = r[1]\n\t\t\t}\n\t\t} else {\n\t\t\tmerged = append(merged, r)\n\t\t}\n\t}\n\treturn merged\n}\n\nfunc complementRanges(ranges [][2]int) [][2]int {\n\tvar result [][2]int\n\tprev := 1\n\tfor _, r := range ranges {\n\t\tif r[0] > prev {\n\t\t\tresult = append(result, [2]int{prev, r[0] - 1})\n\t\t}\n\t\tprev = r[1] + 1\n\t}\n\tif prev > 0 && prev < math.MaxInt {\n\t\tresult = append(result, [2]int{prev, math.MaxInt})\n\t}\n\treturn result\n}\n\nfunc cutFields(r io.Reader, w *bufio.Writer, opts options) {\n\tranges, err := parseRangeList(opts.fieldList)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n\t\treturn\n\t}\n\tif opts.complement {\n\t\tranges = complementRanges(ranges)\n\t}\n\toutDelim := string(opts.delimiter)\n\tif opts.hasOutputDel {\n\t\toutDelim = opts.outputDelim\n\t}\n\tbr := bufio.NewReader(r)\n\tfor {\n\t\tline, readErr := br.ReadString('\\n')\n\t\thasNewline := len(line) > 0 && line[len(line)-1] == '\\n'\n\t\tif hasNewline {\n\t\t\tline = line[:len(line)-1]\n\t\t}\n\t\thasDelim := containsByte(line, opts.delimiter)\n\t\tif !hasDelim && opts.onlyDelimited {\n\t\t\tif readErr != nil {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif hasDelim {\n\t\t\twriteSelectedFields(w, line, opts.delimiter, ranges, outDelim)\n\t\t} else if len(line) > 0 {\n\t\t\tw.WriteString(line)\n\t\t}\n\t\tif readErr == nil || len(line) > 0 {\n\t\t\tw.WriteByte('\\n')\n\t\t}\n\t\tif readErr != nil {\n\t\t\tbreak\n\t\t}\n\t}\n}\n\nfunc writeSelectedFields(w *bufio.Writer, line string, delim byte, ranges [][2]int, outDelim string) {\n\tfields := splitFields(line, delim)\n\tselected := selectFields(fields, ranges)\n\tw.WriteString(strings.Join(selected, outDelim))\n}\n\nfunc containsByte(s string, b byte) bool {\n\tfor i := 0; i < len(s); i++ {\n\t\tif s[i] == b {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc splitFields(line string, delim byte) []string {\n\tvar fields []string\n\tstart := 0\n\tfor i := 0; i < len(line); i++ {\n\t\tif line[i] == delim {\n\t\t\tfields = append(fields, line[start:i])\n\t\t\tstart = i + 1\n\t\t}\n\t}\n\tfields = append(fields, line[start:])\n\treturn fields\n}\n\nfunc selectFields(fields []string, ranges [][2]int) []string {\n\tvar result []string\n\tn := len(fields)\n\tfor _, rng := range ranges {\n\t\tlo := rng[0]\n\t\thi := rng[1]\n\t\tif lo > n {\n\t\t\tcontinue\n\t\t}\n\t\tif hi > n {\n\t\t\thi = n\n\t\t}\n\t\tfor i := lo; i <= hi; i++ {\n\t\t\tresult = append(result, fields[i-1])\n\t\t}\n\t}\n\treturn result\n}\n","numLines":427,"startLine":1,"totalLines":427}}}
