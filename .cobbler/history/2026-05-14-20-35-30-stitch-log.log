in, refBin, tests)\n}\n```\n\nThe pattern is straightforward: build the Go binary, find the GNU reference binary (gtrue in this case), define test cases using the `DiffTest` struct, and call `RunDiffTests` with the binaries and test cases. The framework compares stdout, stderr, and exit codes between the two implementations."}],"totalDurationMs":11559,"totalTokens":22504,"totalToolUseCount":5,"usage":{"input_tokens":6,"cache_creation_input_tokens":684,"cache_read_input_tokens":20956,"output_tokens":858,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":684},"inference_geo":"","iterations":[{"input_tokens":6,"output_tokens":858,"cache_read_input_tokens":20956,"cache_creation_input_tokens":684,"cache_creation":{"ephemeral_5m_input_tokens":684,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"toolStats":{"readCount":2,"searchCount":2,"bashCount":1,"editFileCount":0,"linesAdded":0,"linesRemoved":0,"otherToolCount":0}}}
