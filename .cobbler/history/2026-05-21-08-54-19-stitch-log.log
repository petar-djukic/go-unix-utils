nBin(t, goBin, []string{\"--version\"}, t.TempDir())\n432\t\t\trefRes := runBin(t, refBin, []string{\"--version\"}, t.TempDir())\n433\t\t\tif goRes.exitCode != refRes.exitCode {\n434\t\t\t\tt.Fatalf(\"exit code: go=%d ref=%d\", goRes.exitCode, refRes.exitCode)\n435\t\t\t}\n436\t\t\tif len(goRes.stdout) == 0 {\n437\t\t\t\tt.Fatal(\"--version produced no stdout\")\n438\t\t\t}\n439\t\t})\n440\t}\n441\t\n442\tfunc writeFile(t *testing.T, dir, name, content string) {\n443\t\tt.Helper()\n444\t\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n445\t\t\tt.Fatal(err)\n446\t\t}\n447\t}\n448\t\n449\tfunc setupDir(t *testing.T, dir string, files map[string]string) {\n450\t\tt.Helper()\n451\t\tfor name, content := range files {\n452\t\t\twriteFile(t, dir, name, content)\n453\t\t}\n454\t}\n455\t\n456\tfunc runLinkTest(\n457\t\tt *testing.T, goBin, refBin string,\n458\t\tfiles map[string]string,\n459\t\targs []string,\n460\t\tverify func(t *testing.T, dir string),\n461\t) {\n462\t\tt.Helper()\n463\t\tgoDir := t.TempDir()\n464\t\trefDir := t.TempDir()\n465\t\n466\t\tneedsDestDir := false\n467\t\tif len(args) > 2 {\n468\t\t\tlast := args[len(args)-1]\n469\t\t\tnonFlagCount := 0\n470\t\t\tfor _, a := range args {\n471\t\t\t\tif !isFlag(a) {\n472\t\t\t\t\tnonFlagCount++\n473\t\t\t\t}\n474\t\t\t}\n475\t\t\tif nonFlagCount > 2 {\n476\t\t\t\tneedsDestDir = true\n477\t\t\t\t_ = last\n478\t\t\t}\n479\t\t}\n480\t\n481\t\tfor _, d := range []string{goDir, refDir} {\n482\t\t\tsetupDir(t, d, files)\n483\t\t\tif needsDestDir {\n484\t\t\t\tlast := args[len(args)-1]\n485\t\t\t\tos.Mkdir(filepath.Join(d, last), 0o755)\n486\t\t\t}\n487\t\t}\n488\t\n489\t\tgoRes := runBin(t, goBin, args, goDir)\n490\t\trefRes := runBin(t, refBin, args, refDir)\n491\t\tcompareResults(t, args, goRes, refRes)\n492\t\n493\t\tif verify != nil {\n494\t\t\tt.Run(\"verify_go\", func(t *testing.T) { verify(t, goDir) })\n495\t\t\tt.Run(\"verify_ref\", func(t *testing.T) { verify(t, refDir) })\n496\t\t}\n497\t}\n498\t\n499\tfunc runLinkTestV(\n500\t\tt *testing.T, goBin, refBin string,\n501\t\tfiles map[string]string,\n502\t\targs []string,\n503\t\tverify ...func(t *testing.T, dir string),\n504\t) {\n505\t\tt.Helper()\n506\t\tgoDir := t.TempDir()\n507\t\trefDir := t.TempDir()\n508\t\tsetupDir(t, goDir, files)\n509\t\tsetupDir(t, refDir, files)\n510\t\tgoRes := runBin(t, goBin, args, goDir)\n511\t\trefRes := runBin(t, refBin, args, refDir)\n512\t\tcompareResults(t, args, goRes, refRes)\n513\t\n514\t\tif len(verify) > 0 && verify[0] != nil {\n515\t\t\tt.Run(\"verify_go\", func(t *testing.T) { verify[0](t, goDir) })\n516\t\t\tt.Run(\"verify_ref\", func(t *testing.T) { verify[0](t, refDir) })\n517\t\t}\n518\t}\n519\t\n520\tfunc runLinkTestN(\n521\t\tt *testing.T, goBin, refBin string,\n522\t\tsetup func(t *testing.T, dir string),\n523\t\targs []string,\n524\t\tverify func(t *testing.T, dir string),\n525\t) {\n526\t\tt.Helper()\n527\t\tgoDir := t.TempDir()\n528\t\trefDir := t.TempDir()\n529\t\tsetup(t, goDir)\n530\t\tsetup(t, refDir)\n531\t\tgoRes := runBin(t, goBin, args, goDir)\n532\t\trefRes := runBin(t, refBin, args, refDir)\n533\t\tcompareResults(t, args, goRes, refRes)\n534\t\n535\t\tif verify != nil {\n536\t\t\tt.Run(\"verify_go\", func(t *testing.T) { verify(t, goDir) })\n537\t\t\tt.Run(\"verify_ref\", func(t *testing.T) { verify(t, refDir) })\n538\t\t}\n539\t}\n540\t\n541\tfunc isFlag(s string) bool {\n542\t\treturn len(s) > 0 && s[0] == '-'\n543\t}\n544\t\n545\tfunc verifyHardLink(t *testing.T, dir, orig, link string) {\n546\t\tt.Helper()\n547\t\torigPath := filepath.Join(dir, orig)\n548\t\tlinkPath := filepath.Join(dir, link)\n549\t\torigInfo, err := os.Stat(origPath)\n550\t\tif err != nil {\n551\t\t\tt.Fatalf(\"stat original %s: %v\", orig, err)\n552\t\t}\n553\t\tlinkInfo, err := os.Lstat(linkPath)\n554\t\tif err != nil {\n555\t\t\tt.Fatalf(\"lstat link %s: %v\", link, err)\n556\t\t}\n557\t\tif linkInfo.Mode()&os.ModeSymlink != 0 {\n558\t\t\t