tils.NormalizeFunc,\n384\t\tstdin string,\n385\t) string {\n386\t\tt.Helper()\n387\t\tgoDir := t.TempDir()\n388\t\trefDir := t.TempDir()\n389\t\tsetup(t, goDir)\n390\t\tsetup(t, refDir)\n391\t\tenv := buildTestEnv()\n392\t\tgoRes := runCmd(t, goBin, args, env, goDir, stdin)\n393\t\trefRes := runCmd(t, refBin, args, env, refDir, stdin)\n394\t\tcompareResults(t, goRes, refRes, norm)\n395\t\treturn goDir\n396\t}\n397\t\n398\tfunc runCmd(\n399\t\tt *testing.T, bin string, args, env []string, dir, stdin string,\n400\t) cmdResult {\n401\t\tt.Helper()\n402\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n403\t\tdefer cancel()\n404\t\tcmd := exec.CommandContext(ctx, bin, args...)\n405\t\tcmd.Dir = dir\n406\t\tcmd.Env = env\n407\t\tif stdin != \"\" {\n408\t\t\tcmd.Stdin = strings.NewReader(stdin)\n409\t\t}\n410\t\tvar stdout, stderr bytes.Buffer\n411\t\tcmd.Stdout = &stdout\n412\t\tcmd.Stderr = &stderr\n413\t\terr := cmd.Run()\n414\t\tif ctx.Err() == context.DeadlineExceeded {\n415\t\t\tt.Fatalf(\"binary %s timed out\", bin)\n416\t\t}\n417\t\tif err == nil {\n418\t\t\treturn cmdResult{stdout: stdout.Bytes(), stderr: stderr.Bytes()}\n419\t\t}\n420\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n421\t\t\treturn cmdResult{\n422\t\t\t\tstdout:   stdout.Bytes(),\n423\t\t\t\tstderr:   stderr.Bytes(),\n424\t\t\t\texitCode: exitErr.ExitCode(),\n425\t\t\t}\n426\t\t}\n427\t\tt.Fatalf(\"failed to run %s: %v\", bin, err)\n428\t\treturn cmdResult{}\n429\t}\n430\t\n431\tfunc buildTestEnv() []string {\n432\t\tenvMap := make(map[string]string)\n433\t\tfor _, entry := range os.Environ() {\n434\t\t\tkey, val, _ := strings.Cut(entry, \"=\")\n435\t\t\tenvMap[key] = val\n436\t\t}\n437\t\tenvMap[\"LC_ALL\"] = \"C\"\n438\t\tout := make([]string, 0, len(envMap))\n439\t\tfor k, v := range envMap {\n440\t\t\tout = append(out, k+\"=\"+v)\n441\t\t}\n442\t\treturn out\n443\t}\n444\t\n445\tfunc compareResults(\n446\t\tt *testing.T, goRes, refRes cmdResult, norm []testutils.NormalizeFunc,\n447\t) {\n448\t\tt.Helper()\n449\t\tgoOut, goErr := goRes.stdout, goRes.stderr\n450\t\trefOut, refErr := refRes.stdout, refRes.stderr\n451\t\tfor _, fn := range norm {\n452\t\t\tgoOut = fn(goOut)\n453\t\t\trefOut = fn(refOut)\n454\t\t\tgoErr = fn(goErr)\n455\t\t\trefErr = fn(refErr)\n456\t\t}\n457\t\tif !bytes.Equal(goOut, refOut) {\n458\t\t\tt.Errorf(\"stdout differs\\n  go:  %q\\n  ref: %q\", goOut, refOut)\n459\t\t}\n460\t\tif !bytes.Equal(goErr, refErr) {\n461\t\t\tt.Errorf(\"stderr differs\\n  go:  %q\\n  ref: %q\", goErr, refErr)\n462\t\t}\n463\t\tif goRes.exitCode != refRes.exitCode {\n464\t\t\tt.Errorf(\"exit code differs: go=%d ref=%d\",\n465\t\t\t\tgoRes.exitCode, refRes.exitCode)\n466\t\t}\n467\t}\n468\t\n469\tfunc writeFile(t *testing.T, dir, name, content string) {\n470\t\tt.Helper()\n471\t\tpath := filepath.Join(dir, name)\n472\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n473\t\t\tt.Fatal(err)\n474\t\t}\n475\t}\n476\t\n477\tfunc checkFile(t *testing.T, dir, name, want string) {\n478\t\tt.Helper()\n479\t\tgot, err := os.ReadFile(filepath.Join(dir, name))\n480\t\tif err != nil {\n481\t\t\tt.Fatalf(\"expected file %s: %v\", name, err)\n482\t\t}\n483\t\tif string(got) != want {\n484\t\t\tt.Errorf(\"file %s: got %q, want %q\", name, got, want)\n485\t\t}\n486\t}\n487\t\n488\tfunc checkAbsent(t *testing.T, dir, name string) {\n489\t\tt.Helper()\n490\t\tif _, err := os.Lstat(filepath.Join(dir, name)); err == nil {\n491\t\t\tt.Errorf(\"expected %s to not exist\", name)\n492\t\t}\n493\t}\n494\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_013KRKmHVcRFSzUBdqEWVEd3","session_id":"f480