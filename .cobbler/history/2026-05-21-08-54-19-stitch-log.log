{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vm3pU7ksXD5KsCbaCYsX5g","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd057-mv R1.1-R1.4, R2.1-R2.4, R3.1-R3.3, R4.1-R4.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"context\"\n10\t\t\"errors\"\n11\t\t\"os\"\n12\t\t\"os/exec\"\n13\t\t\"path/filepath\"\n14\t\t\"regexp\"\n15\t\t\"strings\"\n16\t\t\"testing\"\n17\t\t\"time\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n20\t)\n21\t\n22\ttype cmdResult struct {\n23\t\tstdout   []byte\n24\t\tstderr   []byte\n25\t\texitCode int\n26\t}\n27\t\n28\tfunc TestDiff(t *testing.T) {\n29\t\tgoBin := testutils.BuildBinary(t, \".\")\n30\t\trefBin, err := exec.LookPath(\"gmv\")\n31\t\tif err != nil {\n32\t\t\tt.Skip(\"reference binary gmv not found\")\n33\t\t}\n34\t\n35\t\tbinaryNameRe := regexp.MustCompile(`(?m)^(?:/\\S+/)?g?mv:`)\n36\t\tnormBin := testutils.NormalizeFunc(func(b []byte) []byte {\n37\t\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mv:\"))\n38\t\t})\n39\t\tnormCase := testutils.NormalizeFunc(func(b []byte) []byte {\n40\t\t\treturn bytes.ToLower(b)\n41\t\t})\n42\t\tnormTry := testutils.NormalizeFunc(func(b []byte) []byte {\n43\t\t\tvar out [][]byte\n44\t\t\tfor line := range bytes.SplitSeq(b, []byte(\"\\n\")) {\n45\t\t\t\tif !bytes.HasPrefix(bytes.TrimSpace(bytes.ToLower(line)), []byte(\"try \")) {\n46\t\t\t\t\tout = append(out, bytes.Clone(line))\n47\t\t\t\t}\n48\t\t\t}\n49\t\t\treturn bytes.Join(out, []byte(\"\\n\"))\n50\t\t})\n51\t\terrNorm := []testutils.NormalizeFunc{normBin, normCase, normTry}\n52\t\n53\t\tt.Run(\"r1_1_rename_file\", func(t *testing.T) {\n54\t\t\tsetup := func(t *testing.T, dir string) {\n55\t\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n56\t\t\t}\n57\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n58\t\t\t\t[]string{\"src.txt\", \"dest.txt\"}, nil)\n59\t\t\tcheckFile(t, goDir, \"dest.txt\", \"hello\\n\")\n60\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n61\t\t})\n62\t\n63\t\tt.Run(\"r1_1_overwrite_existing\", func(t *testing.T) {\n64\t\t\tsetup := func(t *testing.T, dir string) {\n65\t\t\t\twriteFile(t, dir, \"src.txt\", \"new\\n\")\n66\t\t\t\twriteFile(t, dir, \"dest.txt\", \"old\\n\")\n67\t\t\t}\n68\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n69\t\t\t\t[]string{\"src.txt\", \"dest.txt\"}, nil)\n70\t\t\tcheckFile(t, goDir, \"dest.txt\", \"new\\n\")\n71\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n72\t\t})\n73\t\n74\t\tt.Run(\"r1_2_multi_file_into_dir\", func(t *testing.T) {\n75\t\t\tsetup := func(t *testing.T, dir string) {\n76\t\t\t\twriteFile(t, dir, \"a.txt\", \"aaa\\n\")\n77\t\t\t\twriteFile(t, dir, \"b.txt\", \"bbb\\n\")\n78\t\t\t\tos.Mkdir(filepath.Join(dir, \"dest\"), 0o755)\n79\t\t\t}\n80\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n81\t\t\t\t[]string{\"a.txt\", \"b.txt\", \"dest\"}, nil)\n82\t\t\tcheckFile(t, goDir, \"dest/a.txt\", \"aaa\\n\")\n83\t\t\tcheckFile(t, goDir, \"dest/b.txt\", \"bbb\\n\")\n84\t\t\tcheckAbsent(t, goDir, \"a.txt\")\n85\t\t\tcheckAbsent(t, goDir, \"b.txt\")\n86\t\t})\n87\t\n88\t\tt.Run(\"r1_3_move_directory\", func(t *testing.T) {\n89\t\t\tsetup := func(t *testing.T, dir string) {\n90\t\t\t\tos.Mkdir(filepath.Join(dir, \"srcdir\"), 0o755)\n91\t\t\t\twriteFile(t, dir, \"srcdir/file.txt\", \"inside\\n\")\n92\t\t\t}\n93\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n94\t\t\t\t[]string{\"srcdir\", \"destdir\"}, nil)\n95\t\t\tcheckFile(t, goDir, \"destdir/file.txt\", \"inside\\n\")\n96\t\t\tcheckAbsent(t, goDir, \"srcdir\")\n97\t\t})\n98\t\n99\t\tt.Run(\"r1_4_dest_is_directory\", func(t *testing.T) {\n100\t\t\tsetup := func(t *testing.T, dir string) {\n101\t\t\t\twriteFile(t, dir, \"file.txt\", \"content\\n\")\n102\t\t\t\tos.Mkdir(filepath.Join(dir, \"destdir\"), 0o755)\n103\t\t\t}\n104\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n105\t\t\t\t[]string{\"file.txt\", \"destdir\"}, nil)\n106\t\t\