ults(t, args, goRes, refRes)\n119\t\t})\n120\t\n121\t\tt.Run(\"parents_partial_existing\", func(t *testing.T) {\n122\t\t\tgoDir := t.TempDir()\n123\t\t\trefDir := t.TempDir()\n124\t\t\tos.Mkdir(filepath.Join(goDir, \"a\"), 0o755)\n125\t\t\tos.Mkdir(filepath.Join(refDir, \"a\"), 0o755)\n126\t\t\targs := []string{\"-p\", \"a/b/c\"}\n127\t\t\tgoRes := runBin(t, goBin, args, goDir)\n128\t\t\trefRes := runBin(t, refBin, args, refDir)\n129\t\t\tcompareResults(t, args, goRes, refRes)\n130\t\t})\n131\t\n132\t\tt.Run(\"parents_long_flag\", func(t *testing.T) {\n133\t\t\trunCreationTest(t, goBin, refBin, []string{\"--parents\", \"x/y/z\"})\n134\t\t})\n135\t\n136\t\tt.Run(\"parents_verbose\", func(t *testing.T) {\n137\t\t\trunCreationTest(t, goBin, refBin, []string{\"-p\", \"-v\", \"d/e/f\"})\n138\t\t})\n139\t\n140\t\tt.Run(\"parents_verbose_combined\", func(t *testing.T) {\n141\t\t\trunCreationTest(t, goBin, refBin, []string{\"-pv\", \"g/h/i\"})\n142\t\t})\n143\t\n144\t\tt.Run(\"parents_multiple\", func(t *testing.T) {\n145\t\t\trunCreationTest(t, goBin, refBin, []string{\"-p\", \"m1/m2\", \"n1/n2\"})\n146\t\t})\n147\t\n148\t\tt.Run(\"verbose_partial_failure\", func(t *testing.T) {\n149\t\t\tgoDir := t.TempDir()\n150\t\t\trefDir := t.TempDir()\n151\t\t\tos.Mkdir(filepath.Join(goDir, \"existdir\"), 0o755)\n152\t\t\tos.Mkdir(filepath.Join(refDir, \"existdir\"), 0o755)\n153\t\t\targs := []string{\"-v\", \"existdir\", \"newdir\"}\n154\t\t\tgoRes := runBin(t, goBin, args, goDir)\n155\t\t\trefRes := runBin(t, refBin, args, refDir)\n156\t\t\tcompareResults(t, args, goRes, refRes)\n157\t\t})\n158\t\n159\t\tt.Run(\"mode_octal\", func(t *testing.T) {\n160\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"0755\", \"mdir\"})\n161\t\t})\n162\t\n163\t\tt.Run(\"mode_octal_no_leading_zero\", func(t *testing.T) {\n164\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"755\", \"mdir2\"})\n165\t\t})\n166\t\n167\t\tt.Run(\"mode_octal_restrictive\", func(t *testing.T) {\n168\t\t\tr