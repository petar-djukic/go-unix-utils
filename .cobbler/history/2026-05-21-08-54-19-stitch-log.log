\n220\t\t\t\t\tArgs:     []string{\"-m\"},\n221\t\t\t\t\tExitCode: 1,\n222\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n223\t\t\t\t\t\tnormalizeBinaryName,\n224\t\t\t\t\t},\n225\t\t\t\t},\n226\t\t\t})\n227\t\t})\n228\t\n229\t\tt.Run(\"invalid_short_option\", func(t *testing.T) {\n230\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n231\t\t\t\t{\n232\t\t\t\t\tName:     \"bad_short_option\",\n233\t\t\t\t\tArgs:     []string{\"-x\"},\n234\t\t\t\t\tExitCode: 1,\n235\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n236\t\t\t\t\t\tnormalizeBinaryName,\n237\t\t\t\t\t},\n238\t\t\t\t},\n239\t\t\t})\n240\t\t})\n241\t\n242\t\tt.Run(\"double_dash_separator\", func(t *testing.T) {\n243\t\t\trunCreationTest(t, goBin, refBin, []string{\"--\", \"-dirname\"})\n244\t\t})\n245\t\n246\t\tt.Run(\"help_flag\", func(t *testing.T) {\n247\t\t\tgoRes := runBin(t, goBin, []string{\"--help\"}, t.TempDir())\n248\t\t\trefRes := runBin(t, refBin, []string{\"--help\"}, t.TempDir())\n249\t\t\tif goRes.exitCode != refRes.exitCode {\n250\t\t\t\tt.Fatalf(\"exit code: go=%d ref=%d\", goRes.exitCode, refRes.exitCode)\n251\t\t\t}\n252\t\t\tif len(goRes.stdout) == 0 {\n253\t\t\t\tt.Fatal(\"--help produced no stdout\")\n254\t\t\t}\n255\t\t})\n256\t\n257\t\tt.Run(\"version_flag\", func(t *testing.T) {\n258\t\t\tgoRes := runBin(t, goBin, []string{\"--version\"}, t.TempDir())\n259\t\t\trefRes := runBin(t, refBin, []string{\"--version\"}, t.TempDir())\n260\t\t\tif goRes.exitCode != refRes.exitCode {\n261\t\t\t\tt.Fatalf(\"exit code: go=%d ref=%d\", goRes.exitCode, refRes.exitCode)\n262\t\t\t}\n263\t\t\tif len(goRes.stdout) == 0 {\n264\t\t\t\tt.Fatal(\"--version produced no stdout\")\n265\t\t\t}\n266\t\t})\n267\t}\n268\t\n269\tfunc TestCreationPermissions(t *testing.T) {\n270\t\tgoBin := testutils.BuildBinary(t, \".\")\n271\t\trefBin, err := exec.LookPath(\"gmkdir\")\n272\t\tif err != nil {\n273\t\t\tt.Skip(\"reference binary not found\")\n274\t\t}\n275\t\n276\t\tgoDir := t.TempDir()\n277\t\trefDir := t.TempDir()\n278\t\targs := []string{\"permdir\"}\n279\t\trunBin(t, goBin, args, goDir)\n280\t\trunBin(t, refBin, args, refDir)\n281\t\n282\t\tgoInfo, err := os.Stat(filepath.Join(goDir, \"permdir\"))\n283\t\tif err != nil {\n284\t\t\tt.Fatalf(\"go binary did not create directory: %v\", err)\n285\t\t}\n286\t\trefInfo, err := os.Stat(filepath.Join(refDir, \"permdir\"))\n287\t\tif err != nil {\n288\t\t\tt.Fatalf(\"ref binary did not create directory: %v\", err)\n289\t\t}\n290\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n291\t\t\tt.Fatalf(\"permission mismatch: go=%v ref=%v\",\n292\t\t\t\tgoInfo.Mode().Perm(), refInfo.Mode().Perm())\n293\t\t}\n294\t}\n295\t\n296\tfunc TestModePermissions(t *testing.T) {\n297\t\tgoBin := testutils.BuildBinary(t, \".\")\n298\t\trefBin, err := exec.LookPath(\"gmkdir\")\n299\t\tif err != nil {\n300\t\t\tt.Skip(\"reference binary not found\")\n301\t\t}\n302\t\n303\t\ttests := []struct {\n304\t\t\tname string\n305\t\t\targs []string\n306\t\t\tdirs []string\n307\t\t}{\n308\t\t\t{\"octal_0755\", []string{\"-m\", \"0755\", \"d1\"}, []string{\"d1\"}},\n309\t\t\t{\"octal_0700\", []string{\"-m\", \"0700\", \"d2\"}, []string{\"d2\"}},\n310\t\t\t{\"octal_0777\", []string{\"-m\", \"0777\", \"d3\"}, []string{\"d3\"}},\n311\t\t\t{\"octal_0750\", []string{\"-m\", \"0750\", \"d4\"}, []string{\"d4\"}},\n312\t\t\t{\"symbolic_urwx_gorx\", []string{\"-m\", \"u=rwx,go=rx\", \"d5\"}, []string{\"d5\"}},\n313\t\t\t{\"symbolic_arwx\", []string{\"-m\", \"a=rwx\", \"d6\"}, []string{\"d6\"}},\n314\t\t}\n315\t\n316\t\tfor _, tt := range tests {\n317\t\t\tt.Run(tt.name, func(t *testing.T) {\n318\t\t\t\tgoDir := t.TempDir()\n319\t\t\t\trefDir := t.TempDir()\n320\t\t\t\trunBin(t, goBin, tt.args, goDir)\n321\t\t\t\trunBin(t, refBin, tt.args, refDir)\n322\t\t\t\tfor _, sub := range tt.dirs {\n323\t\t\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, sub))\n324\t\t\t\t\tif err != nil {\n325\t\t\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", sub, err)\n326\t\t\t\t\t}\n327\t\t\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, sub))\n328\t\t\t\t\tif err != nil {\n329\t\t\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", sub, err)\n330\t\t\t\t\t}\n331\t\t\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n332\t\t\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n333\t\t\t\t\t\t\tsub, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n334\t\t\t\t\t}\n335\t\t\t\t}\n336\t\t\t})\n337\t\t}\n338\t}\n339\t\n340\tfunc TestModeParentsPermissions(t *testing.T) {\n341\t\tgoBin := testutils.BuildBinary(t, \".\")\n342\t\trefBin, err := exec.LookPath(\"gmkdir\")\n343\t\tif err != nil {\n344\t\t\tt.Skip(\"reference binary not found\")\n345\t\t}\n346\t\n347\t\tgoDir := t.TempDir()\n348\t\trefDir := t.TempDir()\n349\t\targs := []string{\"-p\", \"-m\", \"0700\", \"a/b/c\"}\n350\t\trunBin(t, goBin, args, goDir)\n351\t\trunBin(t, refBin, args, refDir)\n352\t\n353\t\tfor _, sub := range []string{\"a\", \"a/b\", \"a/b/c\"} {\n354\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, sub))\n355\t\t\tif err != nil {\n356\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", sub, err)\n357\t\t\t}\n358\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, sub))\n359\t\t\tif err != nil {\n360\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", sub, err)\n361\t\t\t}\n362\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n363\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n364\t\t\t\t\tsub, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n365\t\t\t}\n366\t\t}\n367\t}\n368\t\n369\tfunc runCreationTest(t *testing.T, goBin, refBin string, args []string) {\n370\t\tt.Helper()\n371\t\tgoDir := t.TempDir()\n372\t\trefDir := t.TempDir()\n373\t\tgoRes := runBin(t, goBin, args, goDir)\n374\t\trefRes := runBin(t, refBin, args, refDir)\n375\t\tcompareResults(t, args, goRes, refRes)\n376\t}\n377\t\n378\ttype binResult struct {\n379\t\tstdout   []byte\n380\t\tstderr   []byte\n381\t\texitCode int\n382\t}\n383\t\n384\tfunc runBin(t *testing.T, binary string, args []string, workDir string) binResult {\n385\t\tt.Helper()\n386\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n387\t\tdefer cancel()\n388\t\tcmd := exec.CommandContext(ctx, binary, args...)\n389\t\tcmd.Dir = workDir\n390\t\tcmd.Env = append(os.Environ(), \"LC_ALL=C\")\n391\t\tvar stdout, stderr bytes.Buffer\n392\t\tcmd.Stdout = &stdout\n393\t\tcmd.Stderr = &stderr\n394\t\terr := cmd.Run()\n395\t\tif ctx.Err() == context.DeadlineExceeded {\n396\t\t\tt.Fatalf(\"binary %s timed out\", binary)\n397\t\t}\n398\t\texitCode := 0\n399\t\tif err != nil {\n400\t\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n401\t\t\t\texitCode = exitErr.ExitCode()\n402\t\t\t} else {\n403\t\t\t\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n404\t\t\t}\n405\t\t}\n406\t\treturn binResult{stdout: stdout.Bytes(), stderr: stderr.Bytes(), exitCode: exitCode}\n407\t}\n408\t\n409\tfunc compareResults(t *testing.T, args []string, goRes, refRes binResult) {\n410\t\tt.Helper()\n411\t\tgoStdout := normalizeBinaryName(goRes.stdout)\n412\t\trefStdout := normalizeBinaryName(refRes.stdout)\n413\t\tgoStderr := normalizeBinaryName(goRes.stderr)\n414\t\trefStderr := normalizeBinaryName(refRes.stderr)\n415\t\n416\t\tif !bytes.Equal(goStdout, refStdout) ||\n417\t\t\t!bytes.Equal(goStderr, refStderr) ||\n418\t\t\tgoRes.exitCode != refRes.exitCode {\n419\t\t\tt.Fatalf(\"divergence detected\\n\"+\n420\t\t\t\t\"  args:       %v\\n\"+\n421\t\t\t\t\"  ref stdout: %q\\n\"+\n422\t\t\t\t\"  go  stdout: %q\\n\"+\n423\t\t\t\t\"  ref stderr: %q\\n\"+\n424\t\t\t\t\"  go  stderr: %q\\n\"+\n425\t\t\t\t\"  ref exit:   %d\\n\"+\n426\t\t\t\t\"  go  exit:   %d\\n\",\n427\t\t\t\targs, refStdout, goStdout, refStderr, goStderr, refRes.exitCode, goRes.exitCode)\n428\t\t}\n429\t}\n430\t\n431\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mkdir\\b`)\n432\t\n433\tfunc normalizeBinaryName(b []byte) []byte {\n434\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mkdir\"))\n435\t}\n436\t\n437\tfunc TestParentsPermissions(t *testing.T) {\n438\t\tgoBin := testutils.BuildBinary(t, \".\")\n439\t\trefBin, err := exec.LookPath(\"gmkdir\")\n440\t\tif err != nil {\n441\t\t\tt.Skip(\"reference binary not found\")\n442\t\t}\n443\t\n444\t\tgoDir := t.TempDir()\n445\t\trefDir := t.TempDir()\n446\t\targs := []string{\"-p\", \"a/b/c\"}\n447\t\trunBin(t, goBin, args, goDir)\n448\t\trunBin(t, refBin, args, refDir)\n449\t\n450\t\tfor _, sub := range []string{\"a\", \"a/b\", \"a/b/c\"} {\n451\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, sub))\n452\t\t\tif err != nil {\n453\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", sub, err)\n454\t\t\t}\n455\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, sub))\n456\t\t\tif err != nil {\n457\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", sub, err)\n458\t\t\t}\n459\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n460\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n461\t\t\t\t\tsub, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n462\t\t\t}\n463\t\t}\n464\t}\n465\t\n466\tfunc TestUnrecognizedOption(t *testing.T) {\n467\t\tgoBin := testutils.BuildBinary(t, \".\")\n468\t\trefBin, err := exec.LookPath(\"gmkdir\")\n469\t\tif err != nil {\n470\t\t\tt.Skip(\"reference binary not found\")\n471\t\t}\n472\t\n473\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n474\t\t\t{\n475\t\t\t\tName:     \"bad_long_option\",\n476\t\t\t\tArgs:     []string{\"--badopt\"},\n477\t\t\t\tExitCode: 1,\n478\t\t\t\tNormalize: []testutils.NormalizeFunc{\n479\t\t\t\t\tnormalizeBinaryName,\n480\t\t\t\t},\n481\t\t\t},\n482\t\t})\n483\t}\n484\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</syste