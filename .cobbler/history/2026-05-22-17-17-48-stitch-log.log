tils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc writeFixture(t *testing.T, dir, name, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n","numLines":203,"startLine":1,"totalLines":203}}}
