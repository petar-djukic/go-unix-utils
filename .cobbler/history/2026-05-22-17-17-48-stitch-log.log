{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CbFGeGUvoXFtPPX2iY9Rv8","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/fmt implements srd070-fmt: simple text formatter that reformats\n5\t// paragraphs to fit within a specified line width.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"bufio\"\n10\t\t\"errors\"\n11\t\t\"fmt\"\n12\t\t\"io\"\n13\t\t\"os\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"syscall\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n19\t)\n20\t\n21\tvar (\n22\t\tflagWidth   int\n23\t\tflagGoal    int\n24\t\tflagSplit   bool\n25\t\tflagTagged  bool\n26\t\tflagPrefix  string\n27\t\tflagUniform bool\n28\t)\n29\t\n30\tfunc init() {\n31\t\tflagWidth = 75\n32\t\tflagGoal = 0\n33\t}\n34\t\n35\tfunc main() {\n36\t\tsys.InstallSIGPIPEHandler()\n37\t\n38\t\targs := parseFlags(os.Args[1:])\n39\t\tif len(args) == 0 {\n40\t\t\targs = []string{\"-\"}\n41\t\t}\n42\t\n43\t\tif flagGoal == 0 {\n44\t\t\tflagGoal = flagWidth * 93 / 100\n45\t\t}\n46\t\n47\t\texitCode := 0\n48\t\tfor _, name := range args {\n49\t\t\tif err := fmtFile(name); err != nil {\n50\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n51\t\t\t\t\tos.Exit(0)\n52\t\t\t\t}\n53\t\t\t\tfmt.Fprintf(os.Stderr, \"fmt: %s\\n\", formatErr(err))\n54\t\t\t\texitCode = 1\n55\t\t\t}\n56\t\t}\n57\t\tif exitCode != 0 {\n58\t\t\tos.Exit(exitCode)\n59\t\t}\n60\t}\n61\t\n62\tfunc parseFlags(args []string) []string {\n63\t\tvar files []string\n64\t\tendOfFlags := false\n65\t\tfor i := 0; i < len(args); i++ {\n66\t\t\targ := args[i]\n67\t\t\tif endOfFlags || arg == \"\" || arg == \"-\" || arg[0] != '-' {\n68\t\t\t\tfiles = append(files, arg)\n69\t\t\t\tcontinue\n70\t\t\t}\n71\t\t\tif arg == \"--\" {\n72\t\t\t\tendOfFlags = true\n73\t\t\t\tcontinue\n74\t\t\t}\n75\t\t\tif len(arg) > 2 && arg[:2] == \"--\" {\n76\t\t\t\ti = parseLongFlag(args, i)\n77\t\t\t\tcontinue\n78\t\t\t}\n79\t\t\ti = parseShortFlags(args, i)\n80\t\t}\n81\t\treturn files\n82\t}\n83\t\n84\tfunc parseLongFlag(args []string, i int) int {\n85\t\targ := args[i]\n86\t\tswitch {\n87\t\tcase matchLong(arg, \"--width\"):\n88\t\t\tflagWidth = parseLongIntArg(arg, \"--width\")\n89\t\tcase matchLong(arg, \"--goal\"):\n90\t\t\tflagGoal = parseLongIntArg(arg, \"--goal\")\n91\t\tcase arg == \"--split-only\":\n92\t\t\tflagSplit = true\n93\t\tcase arg == \"--tagged-paragraph\":\n94\t\t\tflagTagged = true\n95\t\tcase matchLong(arg, \"--prefix\"):\n96\t\t\tflagPrefix = parseLongStrArg(arg, \"--prefix\")\n97\t\tcase arg == \"--uniform-spacing\":\n98\t\t\tflagUniform = true\n99\t\tdefault:\n100\t\t\tfmt.Fprintf(os.Stderr, \"fmt: unrecognized option '%s'\\n\", arg)\n101\t\t\tos.Exit(1)\n102\t\t}\n103\t\treturn i\n104\t}\n105\t\n106\tfunc matchLong(arg, name string) bool {\n107\t\treturn arg == name || (len(arg) > len(name) && arg[:len(name)+1] == name+\"=\")\n108\t}\n109\t\n110\tfunc parseLongIntArg(arg, name string) int {\n111\t\teq := len(name) + 1\n112\t\tif len(arg) <= len(name) || arg[len(name)] != '=' {\n113\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option '%s' requires an argument\\n\", name)\n114\t\t\tos.Exit(1)\n115\t\t}\n116\t\tv, err := strconv.Atoi(arg[eq:])\n117\t\tif err != nil || v < 0 {\n118\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", arg[eq:])\n119\t\t\tos.Exit(1)\n120\t\t}\n121\t\treturn v\n122\t}\n123\t\n124\tfunc parseLongStrArg(arg, name string) string {\n125\t\teq := len(name) + 1\n126\t\tif len(arg) <= len(name) || arg[len(name)] != '=' {\n127\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option '%s' requires an argument\\n\", name)\n128\t\t\tos.Exit(1)\n129\t\t}\n130\t\treturn arg[eq:]\n131\t}\n132\t\n133\tfunc parseShortFlags(args []string, i int) int {\n134\t\targ := args[i]\n135\t\tfor j := 1; j < len(arg); j++ {\n136\t\t\tc := arg[j]\n137\t\t\tswitch c {\n138\t\t\tcase 'w':\n139\t\t\t\tflagWidth = consumeIntArg(args, arg, &i, j)\n140\t\t\t\treturn i\n141\t\t\tcase 'g':\n142\t\t\t\tflagGoal = consumeIntArg(args, arg, &i, j)\n143\t\t\t\treturn i\n144\t\t\tcase 'p':\n145\t\t\t\tflagPrefix = consumeStrArg(args, arg, &i, j)\n146\t\t\t\treturn i\n147\t\t\tcase 's':\n148\t\t\t\tflagSplit = true\n149\t\t\tcase 't':\n150\t\t\t\tflagTagged = true\n151\t\t\tcase 'u':\n152\t\t\t\tflagUniform = true\n153\t\t\tdefault:\n154\t\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid option -- '%c'\\n\", c)\n155\t\t\t\tos.Exit(1)\n156\t\t\t}\n157\t\t}\n158\t\treturn i\n159\t}\n160\t\n161\tfunc consumeIntArg(args []string, arg string, i *int, j int) int {\n162\t\trest := arg[j+1:]\n163\t\tif rest != \"\" {\n164\t\t\tv, err := strconv.Atoi(rest)\n165\t\t\tif err != nil || v < 0 {\n166\t\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", rest)\n167\t\t\t\tos.Exit(1)\n168\t\t\t}\n169\t\t\treturn v\n170\t\t}\n171\t\t*i++\n172\t\tif *i >= len(args) {\n173\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n174\t\t\tos.Exit(1)\n175\t\t}\n176\t\tv, err := strconv.Atoi(args[*i])\n177\t\tif err != nil || v < 0 {\n178\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", args[*i])\n179\t\t\tos.Exit(1)\n180\t\t}\n181\t\treturn v\n182\t}\n183\t\n184\tfunc consumeStrArg(args []string, arg string, i *int, j int) string {\n185\t\trest := arg[j+1:]\n186\t\tif rest != \"\" {\n187\t\t\treturn rest\n188\t\t}\n189\t\t*i++\n190\t\tif *i >= len(args) {\n191\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n192\t\t\tos.Exit(1)\n193\t\t}\n194\t\treturn args[*i]\n195\t}\n196\t\n197\tfunc fmtFile(name string) error {\n198\t\tvar r io.Reader\n199\t\tif name == \"-\" {\n200\t\t\tr = os.Stdin\n201\t\t} else {\n202\t\t\tf, err := os.Open(name)\n203\t\t\tif err != nil {\n204\t\t\t\treturn err\n205\t\t\t}\n206\t\t\tdefer f.Close()\n207\t\t\tr = f\n208\t\t}\n209\t\treturn formatInput(r)\n210\t}\n211\t\n212\tfunc formatInput(r io.Reader) error {\n213\t\tscanner := bufio.NewScanner(r)\n214\t\tvar lines []string\n215\t\tfor scanner.Scan() {\n216\t\t\tlines = append(lines, scanner.Text())\n217\t\t}\n218\t\tif err := scanner.Err(); err != nil {\n219\t\t\treturn err\n220\t\t}\n221\t\tw := bufio.NewWriter(os.Stdout)\n222\t\tvar werr error\n223\t\tif flagPrefix != \"\" {\n224\t\t\twerr = formatWithPrefix(w, lines)\n225\t\t} else {\n226\t\t\twerr = writeFormatted(w, lines)\n227\t\t}\n228\t\tif werr != nil {\n229\t\t\treturn werr\n230\t\t}\n231\t\treturn w.Flush()\n232\t}\n233\t\n234\tfunc writeFormatted(w *bufio.Writer, lines []string) error {\n235\t\tblocks := groupParagraphs(lines)\n236\t\tfor _, block := range blocks {\n237\t\t\tif len(block) == 0 {\n238\t\t\t\tif _, err := w.WriteString(\"\\n\"); err != nil {\n239\t\t\t\t\treturn err\n240\t\t\t\t}\n241\t\t\t\tcontinue\n242\t\t\t}\n243\t\t\tif err := formatParagraph(w, block); err != nil {\n244\t\t\t\treturn err\n245\t\t\t}\n246\t\t}\n247\t\treturn nil\n248\t}\n249\t\n250\tfunc groupParagraphs(lines []string) [][]string {\n251\t\tvar result [][]string\n252\t\tvar current []string\n253\t\tfor _, line := range lines {\n254\t\t\tif strings.TrimSpace(line) == \"\" {\n255\t\t\t\tif len(current) > 0 {\n256\t\t\t\t\tresult = append(result, current)\n257\t\t\t\t\tcurrent = nil\n258\t\t\t\t}\n259\t\t\t\tresult = append(result, nil)\n260\t\t\t\tcontinue\n261\t\t\t}\n262\t\t\tcurrent = append(current, line)\n263\t\t}\n264\t\tif len(current) > 0 {\n265\t\t\tresult = append(result, current)\n266\t\t}\n267\t\treturn result\n268\t}\n269\t\n270\tfunc formatParagraph(w *bufio.Writer, lines []string) error {\n271\t\tif flagSplit {\n272\t\t\treturn writeSplitOnly(w, lines)\n273\t\t}\n274\t\tif len(lines) == 1 && len(lines[0]) <= flagWidth {\n275\t\t\treturn writeLines(w, lines)\n276\t\t}\n277\t\tfirstIndent, bodyIndent := getIndents(lines)\n278\t\twords := extractWords(lines)\n279\t\tif len(words) == 0 {\n280\t\t\treturn nil\n281\t\t}\n282\t\tfilled := fillLines(words, firstIndent, bodyIndent, flagGoal, flagWidth)\n283\t\treturn writeLines(w, filled)\n284\t}\n285\t\n286\tfunc getIndents(lines []string) (string, string) {\n287\t\tfirst := extractIndent(lines[0])\n288\t\tif len(lines) > 1 {\n289\t\t\treturn first, extractIndent(lines[1])\n290\t\t}\n291\t\treturn first, first\n292\t}\n293\t\n294\tfunc extractIndent(s string) string {\n295\t\ttrimmed := strings.TrimLeft(s, \" \\t\")\n296\t\treturn s[:len(s)-len(trimmed)]\n297\t}\n298\t\n299\tfunc extractWords(lines []string) []string {\n300\t\tvar words []string\n301\t\tfor _, line := range lines {\n302\t\t\twords = append(words, strings.Fields(line)...)\n303\t\t}\n304\t\treturn words\n305\t}\n306\t\n307\tfunc fillLines(words []string, firstIndent, bodyIndent string, goal, max int) []string {\n308\t\tif len(words) == 0 {\n309\t\t\treturn nil\n310\t\t}\n311\t\tif goal > max {\n312\t\t\tgoal = max\n313\t\t}\n314\t\tvar result []string\n315\t\tline := firstIndent + words[0]\n316\t\tfor i := 1; i < len(words); i++ {\n317\t\t\tsep := wordSep(words[i-1])\n318\t\t\ttrial := line + sep + words[i]\n319\t\t\tif len(trial) > max || pastGoal(len(line), len(trial), goal) {\n320\t\t\t\tresult = append(result, line)\n321\t\t\t\tline = bodyIndent + words[i]\n322\t\t\t} else {\n323\t\t\t\tline = trial\n324\t\t\t}\n325\t\t}\n326\t\treturn append(result, line)\n327\t}\n328\t\n329\tfunc pastGoal(lineLen, trialLen, goal int) bool {\n330\t\tif trialLen <= goal {\n331\t\t\treturn false\n332\t\t}\n333\t\tover := trialLen - goal\n334\t\tunder := goal - lineLen\n335\t\tif under <= 0 {\n336\t\t\treturn true\n337\t\t}\n338\t\treturn over > under\n339\t}\n340\t\n341\tfunc wordSep(prev string) string {\n342\t\tif endsWithSentence(prev) {\n343\t\t\treturn \"  \"\n344\t\t}\n345\t\treturn \" \"\n346\t}\n347\t\n348\tfunc endsWithSentence(word string) bool {\n349\t\tif len(word) == 0 {\n350\t\t\treturn false\n351\t\t}\n352\t\tlast := word[len(word)-1]\n353\t\treturn last == '.' || last == '!' || last == '?'\n354\t}\n355\t\n356\tfunc writeLines(w *bufio.Writer, lines []string) error {\n357\t\tfor _, line := range lines {\n358\t\t\tif _, err := w.WriteString(line); err != nil {\n359\t\t\t\treturn err\n360\t\t\t}\n361\t\t\tif err := w.WriteByte('\\n'); err != nil {\n362\t\t\t\treturn err\n363\t\t\t}\n364\t\t}\n365\t\treturn nil\n366\t}\n367\t\n368\tfunc writeSplitOnly(w *bufio.Writer, lines []string) error {\n369\t\tfor _, line := range lines {\n370\t\t\tif len(line) <= flagWidth {\n371\t\t\t\tif _, err := w.WriteString(line); err != nil {\n372\t\t\t\t\treturn err\n373\t\t\t\t}\n374\t\t\t\tif err := w.WriteByte('\\n'); err != nil {\n375\t\t\t\t\treturn err\n376\t\t\t\t}\n377\t\t\t\tcontinue\n378\t\t\t}\n379\t\t\tindent := extractIndent(line)\n380\t\t\twords := strings.Fields(line)\n381\t\t\tfilled := fillLines(words, indent, indent, flagGoal, flagWidth)\n382\t\t\tif err := writeLines(w, filled); err != nil {\n383\t\t\t\treturn err\n384\t\t\t}\n385\t\t}\n386\t\treturn nil\n387\t}\n388\t\n389\tfunc formatWithPrefix(w *bufio.Writer, allLines []string) error {\n390\t\tvar group []string\n391\t\tfor _, line := range allLines {\n392\t\t\tstripped, has := stripPrefix(line)\n393\t\t\tif has {\n394\t\t\t\tgroup = append(group, stripped)\n395\t\t\t\tcontinue\n396\t\t\t}\n397\t\t\tif err := flushPrefixGroup(w, group); err != nil {\n398\t\t\t\treturn err\n399\t\t\t}\n400\t\t\tgroup = nil\n401\t\t\tif _, err := w.WriteString(line); err != nil {\n402\t\t\t\treturn err\n403\t\t\t}\n404\t\t\tif err := w.WriteByte('\\n'); err != nil {\n405\t\t\t\treturn err\n406\t\t\t}\n407\t\t}\n408\t\treturn flushPrefixGroup(w, group)\n409\t}\n410\t\n411\tfunc flushPrefixGroup(w *bufio.Writer, lines []string) error {\n412\t\tif len(lines) == 0 {\n413\t\t\treturn nil\n414\t\t}\n415\t\tblocks := groupParagraphs(lines)\n416\t\tfor _, block := range blocks {\n417\t\t\tif err := writePrefixBlock(w, block); err != nil {\n418\t\t\t\treturn err\n419\t\t\t}\n420\t\t}\n421\t\treturn nil\n422\t}\n423\t\n424\tfunc writePrefixBlock(w *bufio.Writer, block []string) error {\n425\t\tif len(block) == 0 {\n426\t\t\t_, err := w.WriteString(flagPrefix + \"\\n\")\n427\t\t\treturn err\n428\t\t}\n429\t\tfirstIndent, bodyIndent := getIndents(block)\n430\t\twords := extractWords(block)\n431\t\tif len(words) == 0 {\n432\t\t\treturn nil\n433\t\t}\n434\t\tpLen := len(flagPrefix)\n435\t\tfilled := fillLines(words, firstIndent, bodyIndent,\n436\t\t\tmax(1, flagGoal-pLen), max(1, flagWidth-pLen))\n437\t\tfor _, fl := range filled {\n438\t\t\tif _, err := w.WriteString(flagPrefix + fl + \"\\n\"); err != nil {\n439\t\t\t\treturn err\n440\t\t\t}\n441\t\t}\n442\t\treturn nil\n443\t}\n444\t\n445\tfunc stripPrefix(line string) (string, bool) {\n446\t\ttrimmed := strings.TrimLeft(line, \" \\t\")\n447\t\tif strings.HasPrefix(trimmed, flagPrefix) {\n448\t\t\treturn trimmed[len(flagPrefix):], true\n449\t\t}\n450\t\treturn line, false\n451\t}\n452\t\n453\tfunc formatErr(err error) string {\n454\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n455\t\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n456\t\t}\n457\t\treturn err.Error()\n458\t}\n459\t"}]},"parent_tool_use_id":null,"session_id":"688cb75f-a2b7-4544-8316-d6567366dfcc","uuid":"175777db-91ca-400e-8531-183d64d8ee0b","timestamp":"2026-05-22T21:17:58.002Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5464/cmd/fmt/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/fmt implements srd070-fmt: simple text formatter that reformats\n// paragraphs to fit within a specified line width.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar (\n\tflagWidth   int\n\tflagGoal    int\n\tflagSplit   bool\n\tflagTagged  bool\n\tflagPrefix  string\n\tflagUniform bool\n)\n\nfunc init() {\n\tflagWidth = 75\n\tflagGoal = 0\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\targs := parseFlags(os.Args[1:])\n\tif len(args) == 0 {\n\t\targs = []string{\"-\"}\n\t}\n\n\tif flagGoal == 0 {\n\t\tflagGoal = flagWidth * 93 / 100\n\t}\n\n\texitCode := 0\n\tfor _, name := range args {\n\t\tif err := fmtFile(name); err != nil {\n\t\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\t\tos.Exit(0)\n\t\t\t}\n\t\t\tfmt.Fprintf(os.Stderr, \"fmt: %s\\n\", formatErr(err))\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc parseFlags(args []string) []string {\n\tvar files []string\n\tendOfFlags := false\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif endOfFlags || arg == \"\" || arg == \"-\" || arg[0] != '-' {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 2 && arg[:2] == \"--\" {\n\t\t\ti = parseLongFlag(args, i)\n\t\t\tcontinue\n\t\t}\n\t\ti = parseShortFlags(args, i)\n\t}\n\treturn files\n}\n\nfunc parseLongFlag(args []string, i int) int {\n\targ := args[i]\n\tswitch {\n\tcase matchLong(arg, \"--width\"):\n\t\tflagWidth = parseLongIntArg(arg, \"--width\")\n\tcase matchLong(arg, \"--goal\"):\n\t\tflagGoal = parseLongIntArg(arg, \"--goal\")\n\tcase arg == \"--split-only\":\n\t\tflagSplit = true\n\tcase arg == \"--tagged-paragraph\":\n\t\tflagTagged = true\n\tcase matchLong(arg, \"--prefix\"):\n\t\tflagPrefix = parseLongStrArg(arg, \"--prefix\")\n\tcase arg == \"--uniform-spacing\":\n\t\tflagUniform = true\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"fmt: unrecognized option '%s'\\n\", arg)\n\t\tos.Exit(1)\n\t}\n\treturn i\n}\n\nfunc matchLong(arg, name string) bool {\n\treturn arg == name || (len(arg) > len(name) && arg[:len(name)+1] == name+\"=\")\n}\n\nfunc parseLongIntArg(arg, name string) int {\n\teq := len(name) + 1\n\tif len(arg) <= len(name) || arg[len(name)] != '=' {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: option '%s' requires an argument\\n\", name)\n\t\tos.Exit(1)\n\t}\n\tv, err := strconv.Atoi(arg[eq:])\n\tif err != nil || v < 0 {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", arg[eq:])\n\t\tos.Exit(1)\n\t}\n\treturn v\n}\n\nfunc parseLongStrArg(arg, name string) string {\n\teq := len(name) + 1\n\tif len(arg) <= len(name) || arg[len(name)] != '=' {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: option '%s' requires an argument\\n\", name)\n\t\tos.Exit(1)\n\t}\n\treturn arg[eq:]\n}\n\nfunc parseShortFlags(args []string, i int) int {\n\targ := args[i]\n\tfor j := 1; j < len(arg); j++ {\n\t\tc := arg[j]\n\t\tswitch c {\n\t\tcase 'w':\n\t\t\tflagWidth = consumeIntArg(args, arg, &i, j)\n\t\t\treturn i\n\t\tcase 'g':\n\t\t\tflagGoal = consumeIntArg(args, arg, &i, j)\n\t\t\treturn i\n\t\tcase 'p':\n\t\t\tflagPrefix = consumeStrArg(args, arg, &i, j)\n\t\t\treturn i\n\t\tcase 's':\n\t\t\tflagSplit = true\n\t\tcase 't':\n\t\t\tflagTagged = true\n\t\tcase 'u':\n\t\t\tflagUniform = true\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid option -- '%c'\\n\", c)\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\treturn i\n}\n\nfunc consumeIntArg(args []string, arg string, i *int, j int) int {\n\trest := arg[j+1:]\n\tif rest != \"\" {\n\t\tv, err := strconv.Atoi(rest)\n\t\tif err != nil || v < 0 {\n\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", rest)\n\t\t\tos.Exit(1)\n\t\t}\n\t\treturn v\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n\t\tos.Exit(1)\n\t}\n\tv, err := strconv.Atoi(args[*i])\n\tif err != nil || v < 0 {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", args[*i])\n\t\tos.Exit(1)\n\t}\n\treturn v\n}\n\nfunc consumeStrArg(args []string, arg string, i *int, j int) string {\n\trest := arg[j+1:]\n\tif rest != \"\" {\n\t\treturn rest\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n\t\tos.Exit(1)\n\t}\n\treturn args[*i]\n}\n\nfunc fmtFile(name string) error {\n\tvar r io.Reader\n\tif name == \"-\" {\n\t\tr = os.Stdin\n\t} else {\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tdefer f.Close()\n\t\tr = f\n\t}\n\treturn formatInput(r)\n}\n\nfunc formatInput(r io.Reader) error {\n\tscanner := bufio.NewScanner(r)\n\tvar lines []string\n\tfor scanner.Scan() {\n\t\tlines = append(lines, scanner.Text())\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\treturn err\n\t}\n\tw := bufio.NewWriter(os.Stdout)\n\tvar werr error\n\tif flagPrefix != \"\" {\n\t\twerr = formatWithPrefix(w, lines)\n\t} else {\n\t\twerr = writeFormatted(w, lines)\n\t}\n\tif werr != nil {\n\t\treturn werr\n\t}\n\treturn w.Flush()\n}\n\nfunc writeFormatted(w *bufio.Writer, lines []string) error {\n\tblocks := groupParagraphs(lines)\n\tfor _, block := range blocks {\n\t\tif len(block) == 0 {\n\t\t\tif _, err := w.WriteString(\"\\n\"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif err := formatParagraph(w, block); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc groupParagraphs(lines []string) [][]string {\n\tvar result [][]string\n\tvar current []string\n\tfor _, line := range lines {\n\t\tif strings.TrimSpace(line) == \"\" {\n\t\t\tif len(current) > 0 {\n\t\t\t\tresult = append(result, current)\n\t\t\t\tcurrent = nil\n\t\t\t}\n\t\t\tresult = append(result, nil)\n\t\t\tcontinue\n\t\t}\n\t\tcurrent = append(current, line)\n\t}\n\tif len(current) > 0 {\n\t\tresult = append(result, current)\n\t}\n\treturn result\n}\n\nfunc formatParagraph(w *bufio.Writer, lines []string) error {\n\tif flagSplit {\n\t\treturn writeSplitOnly(w, lines)\n\t}\n\tif len(lines) == 1 && len(lines[0]) <= flagWidth {\n\t\treturn writeLines(w, lines)\n\t}\n\tfirstIndent, bodyIndent := getIndents(lines)\n\twords := extractWords(lines)\n\tif len(words) == 0 {\n\t\treturn nil\n\t}\n\tfilled := fillLines(words, firstIndent, bodyIndent, flagGoal, flagWidth)\n\treturn writeLines(w, filled)\n}\n\nfunc getIndents(lines []string) (string, string) {\n\tfirst := extractIndent(lines[0])\n\tif len(lines) > 1 {\n\t\treturn first, extractIndent(lines[1])\n\t}\n\treturn first, first\n}\n\nfunc extractIndent(s string) string {\n\ttrimmed := strings.TrimLeft(s, \" \\t\")\n\treturn s[:len(s)-len(trimmed)]\n}\n\nfunc extractWords(lines []string) []string {\n\tvar words []string\n\tfor _, line := range lines {\n\t\twords = append(words, strings.Fields(line)...)\n\t}\n\treturn words\n}\n\nfunc fillLines(words []string, firstIndent, bodyIndent string, goal, max int) []string {\n\tif len(words) == 0 {\n\t\treturn nil\n\t}\n\tif goal > max {\n\t\tgoal = max\n\t}\n\tvar result []string\n\tline := firstIndent + words[0]\n\tfor i := 1; i < len(words); i++ {\n\t\tsep := wordSep(words[i-1])\n\t\ttrial := line + sep + words[i]\n\t\tif len(trial) > max || pastGoal(len(line), len(trial), goal) {\n\t\t\tresult = append(result, line)\n\t\t\tline = bodyIndent + words[i]\n\t\t} else {\n\t\t\tline = trial\n\t\t}\n\t}\n\treturn append(result, line)\n}\n\nfunc pastGoal(lineLen, trialLen, goal int) bool {\n\tif trialLen <= goal {\n\t\treturn false\n\t}\n\tover := trialLen - goal\n\tunder := goal - lineLen\n\tif under <= 0 {\n\t\treturn true\n\t}\n\treturn over > under\n}\n\nfunc wordSep(prev string) string {\n\tif endsWithSentence(prev) {\n\t\treturn \"  \"\n\t}\n\treturn \" \"\n}\n\nfunc endsWithSentence(word string) bool {\n\tif len(word) == 0 {\n\t\treturn false\n\t}\n\tlast := word[len(word)-1]\n\treturn last == '.' || last == '!' || last == '?'\n}\n\nfunc writeLines(w *bufio.Writer, lines []string) error {\n\tfor _, line := range lines {\n\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc writeSplitOnly(w *bufio.Writer, lines []string) error {\n\tfor _, line := range lines {\n\t\tif len(line) <= flagWidth {\n\t\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tindent := extractIndent(line)\n\t\twords := strings.Fields(line)\n\t\tfilled := fillLines(words, indent, indent, flagGoal, flagWidth)\n\t\tif err := writeLines(w, filled); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc formatWithPrefix(w *bufio.Writer, allLines []string) error {\n\tvar group []string\n\tfor _, line := range allLines {\n\t\tstripped, has := stripPrefix(line)\n\t\tif has {\n\t\t\tgroup = append(group, stripped)\n\t\t\tcontinue\n\t\t}\n\t\tif err := flushPrefixGroup(w, group); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tgroup = nil\n\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn flushPrefixGroup(w, group)\n}\n\nfunc flushPrefixGroup(w *bufio.Writer, lines []string) error {\n\tif len(lines) == 0 {\n\t\treturn nil\n\t}\n\tblocks := groupParagraphs(lines)\n\tfor _, block := range blocks {\n\t\tif err := writePrefixBlock(w, block); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc writePrefixBlock(w *bufio.Writer, block []string) error {\n\tif len(block) == 0 {\n\t\t_, err := w.WriteString(flagPrefix + \"\\n\")\n\t\treturn err\n\t}\n\tfirstIndent, bodyIndent := getIndents(block)\n\twords := extractWords(block)\n\tif len(words) == 0 {\n\t\treturn nil\n\t}\n\tpLen := len(flagPrefix)\n\tfilled := fillLines(words, firstIndent, bodyIndent,\n\t\tmax(1, flagGoal-pLen), max(1, flagWidth-pLen))\n\tfor _, fl := range filled {\n\t\tif _, err := w.WriteString(flagPrefix + fl + \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc stripPrefix(line string) (string, bool) {\n\ttrimmed := strings.TrimLeft(line, \" \\t\")\n\tif strings.HasPrefix(trimmed, flagPrefix) {\n\t\treturn trimmed[len(flagPrefix):], true\n\t}\n\treturn line, false\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n","numLines":459,"startLine":1,"totalLines":459}}}
