{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BCeTWqXYLp1D99qevW7q59","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd025-unexpand.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tfunc main() {\n19\t\tsys.InstallSIGPIPEHandler()\n20\t\tw := bufio.NewWriter(os.Stdout)\n21\t\tstops, allMode, files, err := parseArgs(os.Args[1:])\n22\t\tif err != nil {\n23\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: %s\\n\", err)\n24\t\t\tos.Exit(1)\n25\t\t}\n26\t\texitCode := 0\n27\t\tif len(files) == 0 {\n28\t\t\tunexpand(os.Stdin, w, stops, allMode)\n29\t\t} else {\n30\t\t\tfor _, name := range files {\n31\t\t\t\tif name == \"-\" {\n32\t\t\t\t\tunexpand(os.Stdin, w, stops, allMode)\n33\t\t\t\t\tcontinue\n34\t\t\t\t}\n35\t\t\t\tf, err := os.Open(name)\n36\t\t\t\tif err != nil {\n37\t\t\t\t\tfmt.Fprintf(os.Stderr, \"unexpand: %v\\n\", err)\n38\t\t\t\t\texitCode = 1\n39\t\t\t\t\tcontinue\n40\t\t\t\t}\n41\t\t\t\tunexpand(f, w, stops, allMode)\n42\t\t\t\tf.Close()\n43\t\t\t}\n44\t\t}\n45\t\tif err := w.Flush(); err != nil {\n46\t\t\tos.Exit(1)\n47\t\t}\n48\t\tos.Exit(exitCode)\n49\t}\n50\t\n51\ttype tabStops struct {\n52\t\tinterval  int\n53\t\tpositions []int\n54\t}\n55\t\n56\tfunc parseArgs(args []string) (tabStops, bool, []string, error) {\n57\t\tvar rawStops []string\n58\t\tvar files []string\n59\t\tallMode := false\n60\t\tfor i := 0; i < len(args); i++ {\n61\t\t\ta := args[i]\n62\t\t\tif a == \"--\" {\n63\t\t\t\tfiles = append(files, args[i+1:]...)\n64\t\t\t\tbreak\n65\t\t\t}\n66\t\t\tif a == \"-a\" {\n67\t\t\t\tallMode = true\n68\t\t\t\tcontinue\n69\t\t\t}\n70\t\t\tif a == \"-t\" || strings.HasPrefix(a, \"-t\") {\n71\t\t\t\tvar val string\n72\t\t\t\tif a == \"-t\" {\n73\t\t\t\t\tif i+1 >= len(args) {\n74\t\t\t\t\t\treturn tabStops{}, false, nil, fmt.Errorf(\"option requires an argument -- 't'\")\n75\t\t\t\t\t}\n76\t\t\t\t\ti++\n77\t\t\t\t\tval = args[i]\n78\t\t\t\t} else {\n79\t\t\t\t\tval = a[2:]\n80\t\t\t\t}\n81\t\t\t\trawStops = append(rawStops, val)\n82\t\t\t\tallMode = true\n83\t\t\t\tcontinue\n84\t\t\t}\n85\t\t\tif strings.HasPrefix(a, \"-\") && a != \"-\" {\n86\t\t\t\treturn tabStops{}, false, nil, fmt.Errorf(\"invalid option -- '%s'\", a[1:])\n87\t\t\t}\n88\t\t\tfiles = append(files, a)\n89\t\t}\n90\t\tif len(rawStops) == 0 {\n91\t\t\treturn tabStops{interval: 8}, allMode, files, nil\n92\t\t}\n93\t\tstops, err := parseTabStops(strings.Join(rawStops, \",\"))\n94\t\tif err != nil {\n95\t\t\treturn tabStops{}, false, nil, err\n96\t\t}\n97\t\treturn stops, allMode, files, nil\n98\t}\n99\t\n100\tfunc parseTabStops(val string) (tabStops, error) {\n101\t\tparts := strings.FieldsFunc(val, func(r rune) bool {\n102\t\t\treturn r == ',' || r == ' '\n103\t\t})\n104\t\tif len(parts) == 0 {\n105\t\t\treturn tabStops{}, fmt.Errorf(\"tab size contains invalid character(s): '%s'\", val)\n106\t\t}\n107\t\tif len(parts) == 1 {\n108\t\t\tn, err := strconv.Atoi(parts[0])\n109\t\t\tif err != nil || n <= 0 {\n110\t\t\t\treturn tabStops{}, fmt.Errorf(\"invalid tab size: '%s'\", parts[0])\n111\t\t\t}\n112\t\t\treturn tabStops{interval: n}, nil\n113\t\t}\n114\t\tpositions := make([]int, len(parts))\n115\t\tfor i, p := range parts {\n116\t\t\tn, err := strconv.Atoi(p)\n117\t\t\tif err != nil || n <= 0 {\n118\t\t\t\treturn tabStops{}, fmt.Errorf(\"invalid tab size: '%s'\", p)\n119\t\t\t}\n120\t\t\tif i > 0 && n <= positions[i-1] {\n121\t\t\t\treturn tabStops{}, fmt.Errorf(\"tab sizes must be ascending\")\n122\t\t\t}\n123\t\t\tpositions[i] = n\n124\t\t}\n125\t\treturn tabStops{positions: positions}, nil\n126\t}\n127\t\n128\tfunc unexpand(r io.Reader, w *bufio.Writer, stops tabStops, allMode bool) {\n129\t\tbr := bufio.NewReader(r)\n130\t\tcol := 1\n131\t\tleading := true\n132\t\tspaceRun := 0\n133\t\tspaceRunStart := 0\n134\t\tflush := func() {\n135\t\t\tif !leading && spaceRun < 2 {\n136\t\t\t\tfor i := 0; i < spaceRun; i++ {\n137\t\t\t\t\tw.WriteByte(' ')\n138\t\t\t\t}\n139\t\t\t} else {\n140\t\t\t\temitCompacted(w, spaceRunStart, spaceRun, stops)\n141\t\t\t}\n142\t\t\tspaceRun = 0\n143\t\t\tspaceRunStart = 0\n144\t\t}\n145\t\tfor {\n146\t\t\tb, err := br.ReadByte()\n147\t\t\tif err != nil {\n148\t\t\t\tif spaceRun > 0 {\n149\t\t\t\t\tflush()\n150\t\t\t\t}\n151\t\t\t\treturn\n152\t\t\t}\n153\t\t\tswitch b {\n154\t\t\tcase ' ':\n155\t\t\t\tif leading || allMode {\n156\t\t\t\t\tif spaceRun == 0 {\n157\t\t\t\t\t\tspaceRunStart = col\n158\t\t\t\t\t}\n159\t\t\t\t\tspaceRun++\n160\t\t\t\t\tcol++\n161\t\t\t\t} else {\n162\t\t\t\t\tw.WriteByte(' ')\n163\t\t\t\t\tcol++\n164\t\t\t\t}\n165\t\t\tcase '\\t':\n166\t\t\t\tif leading || allMode {\n167\t\t\t\t\tnextCol := nextTabStop(col+spaceRun, stops)\n168\t\t\t\t\tspaceRun = 0\n169\t\t\t\t\tspaceRunStart = 0\n170\t\t\t\t\tw.WriteByte('\\t')\n171\t\t\t\t\tcol = nextCol\n172\t\t\t\t} else {\n173\t\t\t\t\tw.WriteByte('\\t')\n174\t\t\t\t\tcol = nextTabStop(col, stops)\n175\t\t\t\t}\n176\t\t\tcase '\\n':\n177\t\t\t\tif spaceRun > 0 {\n178\t\t\t\t\tflush()\n179\t\t\t\t}\n180\t\t\t\tw.WriteByte('\\n')\n181\t\t\t\tcol = 1\n182\t\t\t\tleading = true\n183\t\t\tdefault:\n184\t\t\t\tif spaceRun > 0 {\n185\t\t\t\t\tflush()\n186\t\t\t\t}\n187\t\t\t\tw.WriteByte(b)\n188\t\t\t\tcol++\n189\t\t\t\tleading = false\n190\t\t\t}\n191\t\t}\n192\t}\n193\t\n194\tfunc nextTabStop(col int, stops tabStops) int {\n195\t\tif stops.positions == nil {\n196\t\t\treturn col + stops.interval - (col-1)%stops.interval\n197\t\t}\n198\t\tcolIdx := col - 1\n199\t\tfor _, p := range stops.positions {\n200\t\t\tif p > colIdx {\n201\t\t\t\treturn p + 1\n202\t\t\t}\n203\t\t}\n204\t\treturn col + 1\n205\t}\n206\t\n207\tfunc emitCompacted(w *bufio.Writer, startCol int, count int, stops tabStops) {\n208\t\tcol := startCol\n209\t\tend := start