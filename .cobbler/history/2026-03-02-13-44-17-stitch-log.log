ormalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: 'expected file data.txt contains \"line1\\nline2\\nline3\\n\"'\n      stderr: \"\"\n    traces:\n      - prd007-sponge R1.1\n      - prd007-sponge R2.5\n\n  - name: sponge_passthrough_stdout\n    description: No output filename; stdin content appears on stdout.\n    inputs:\n      args: []\n      stdin: \"hello world\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello world\\n\"\n      stderr: \"\"\n    traces:\n      - prd007-sponge R4.1\n      - prd007-sponge R4.3\n\n  - name: sponge_append_mode\n    description: '-a flag prepends original file content before stdin content. Setup: existing.txt contains \"original line\\n\"'\n    inputs:\n      args: [\"-a\", \"existing.txt\"]\n      stdin: \"appended line\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: 'expected file existing.txt contains \"original line\\nappended line\\n\"'\n      stderr: \"\"\n    traces:\n      - prd007-sponge R3.1\n      - prd007-sponge R3.3\n\n  - name: sponge_append_mode_no_existing_file\n    description: '-a with a non-existent output file behaves as default mode (creates new file). Setup: newfile.txt does not exist'\n    inputs:\n      args: [\"-a\", \"newfile.txt\"]\n      stdin: \"new content\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: 'expected file newfile.txt contains \"new content\\n\"'\n      stderr: \"\"\n    traces:\n      - prd007-sponge R3.2\n\n  - name: sponge_large_stdin\n    description: Input >= 1 MB forces temp-file spill; output file content must match.\n    inputs:\n      args: [\"large_out.txt\"]\n      stdin: \"generated payload of 1,048,576+ bytes (e.g., seq 1 50000)\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: 'expected file large_out.txt contains \"identical to stdin