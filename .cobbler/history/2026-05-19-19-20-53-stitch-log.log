return allOK, nil\n53\t}\n54\t\n55\tfunc verifyOneLine(line string, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) bool {\n56\t\tfilename, expected, _, err := ParseChecksumLine(line, cfg)\n57\t\tif err != nil {\n58\t\t\tif opts.Warn && !opts.Status {\n59\t\t\t\tfmt.Fprintf(stderr, \"WARNING: improperly formatted checksum line\\n\")\n60\t\t\t}\n61\t\t\treturn true\n62\t\t}\n63\t\tactual, err := computeFileDigest(filename, cfg)\n64\t\tif err != nil {\n65\t\t\tif !opts.Status {\n66\t\t\t\tfmt.Fprintf(stdout, \"%s: FAILED open or read\\n\", filename)\n67\t\t\t}\n68\t\t\treturn false\n69\t\t}\n70\t\tif actual != expected {\n71\t\t\tif !opts.Status {\n72\t\t\t\tfmt.Fprintf(stdout, \"%s: FAILED\\n\", filename)\n73\t\t\t}\n74\t\t\treturn false\n75\t\t}\n76\t\tif !opts.Status && !opts.Quiet {\n77\t\t\tfmt.Fprintf(stdout, \"%s: OK\\n\", filename)\n78\t\t}\n79\t\treturn true\n80\t}\n81\t\n82\tfunc computeFileDigest(filename string, cfg HashConfig) (string, error) {\n83\t\tf, err := os.Open(filename)\n84\t\tif err != nil {\n85\t\t\treturn \"\", err\n86\t\t}\n87\t\tdefer f.Close()\n88\t\treturn ComputeDigest(f, cfg)\n89\t}\n90\t\n91\t// DigestFiles computes and prints digests for each file (or stdin when files\n92\t// is empty or contains \"-\"), returning the exit code. (R3.1, R3.2)\n93\tfunc DigestFiles(files []string, cfg HashConfig, binary, tag bool, stdout, stderr io.Writer) int {\n94\t\tif len(files) == 0 {\n95\t\t\tfiles = []string{\"-\"}\n96\t\t}\n97\t\texitCode := 0\n98\t\tfor _, file := range files {\n99\t\t\tif err := digestAndPrint(file, cfg, binary, tag, stdout); err != nil {\n100\t\t\t\tfmt.Fprintf(stderr, \"%s: %s\\n\", file, err)\n101\t\t\t\texitCode = 1\n102\t\t\t}\n103\t\t}\n104\t\treturn exitCode\n105\t}\n106\t\n107\tfunc digestAndPrint(file string, cfg HashConfig, binary, tag bool, stdout io.Writer) error {\n108\t\tr, err := openInput(file)\n109\t\tif err != nil {\n110\t\t\treturn err\n111\t\t}\n112\t\tdefer r.Close()\n113\t\tdigest, err := ComputeDigest(r, cfg)\n114\t\tif err != nil {\n115\t\t\treturn err\n116\t\t}\n117\t\tif tag {\n118\t\t\tfmt.Fprintln(stdout, FormatBSDTag(cfg.Algorithm, file, digest))\n119\t\t} else {\n120\t\t\tfmt.Fprintln(stdout, FormatGNU(digest, file, binary))\n121\t\t}\n122\t\treturn nil\n123\t}\n124\t\n125\tfunc openInput(file string) (io.ReadCloser, error) {\n126\t\tif file == \"-\" {\n127\t\t\treturn io.NopCloser(os.Stdin), nil\n128\t\t}\n129\t\treturn os.Open(file)\n130\t}\n131\t"}]},"parent_tool_use_id":null,"session_id":"dfd9f134-9a20-46e6-becd-fe02f697bba9","uuid":"665cca62-dc21-44e4-9291-310de66c709f","timestamp":"2026-05-19T23:21:08.362Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5311/pkg/hashutil/hashutil.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage hashutil\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"regexp\"\n)\n\nvar (\n\tbsdTagRe = regexp.MustCompile(`^(\\S+) \\((.+)\\) = ([0-9a-fA-F]+)$`)\n\tgnuRe    = regexp.MustCompile(`^([0-9a-fA-F]+) ([ *])(.+)$`)\n)\n\n// ParseChecksumLine parses a single GNU or BSD tag format checksum line. (R2.1)\nfunc ParseChecksumLine(line string, cfg HashConfig) (filename, expectedDigest string, binary bool, err error) {\n\tif m := bsdTagRe.FindStringSubmatch(line); m != nil {\n\t\treturn m[2], m[3], false, nil\n\t}\n\tif m := gnuRe.FindStringSubmatch(line); m != nil {\n\t\treturn m[3], m[1], m[2] == \"*\", nil\n\t}\n\treturn \"\", \"\", false, fmt.Errorf(\"malformed checksum line\")\n}\n\n// VerifyChecksums reads checksumFile, verifies each entry, and prints\n// results according to opts. Returns whether all checks passed. (R2.3)\nfunc VerifyChecksums(checksumFile string, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) (bool, error) {\n\tr, err := openInput(checksumFile)\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"opening checksum file: %w\",