62\t\t}\n63\t\n64\t\ttests := []testutils.DiffTest{\n65\t\t\t{Name: \"basic-listing\", Args: []string{basicDir}, Env: []string{\"COLUMNS=80\"}},\n66\t\t\t{Name: \"hidden-excluded\", Args: []string{mixedDir}, Env: []string{\"COLUMNS=80\"}},\n67\t\t\t{Name: \"c-locale-sort\", Args: []string{sortDir}, Env: []string{\"COLUMNS=80\"}},\n68\t\t\t{Name: \"escape-special\", Args: []string{escapeDir}, Env: []string{\"COLUMNS=80\"}},\n69\t\t\t{Name: \"default-cwd\", WorkDir: defaultDir, Env: []string{\"COLUMNS=80\"}},\n70\t\t\t{\n71\t\t\t\tName:      \"nonexistent\",\n72\t\t\t\tArgs:      []string{\"/nonexistent-path-12345\"},\n73\t\t\t\tExitCode:  1,\n74\t\t\t\tNormalize: errNorm,\n75\t\t\t},\n76\t\t}\n77\t\n78\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n79\t}\n80\t"}]},"parent_tool_use_id":null,"session_id":"2a4d3e12-2a9b-4b02-9c01-a29a55ada75b","uuid":"b9a97b1a-ac50-4b05-9222-2bcdc6af8cb3","timestamp":"2026-05-27T20:01:03.336Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5608/cmd/dir/dir_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc programNameNormalizer(b []byte) []byte {\n\treturn bytes.ReplaceAll(b, []byte(\"gdir:\"), []byte(\"dir:\"))\n}\n\nfunc touchFile(t *testing.T, dir, name string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(dir, name), nil, 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gdir\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\terrNorm := []testutils.NormalizeFunc{programNameNormalizer}\n\n\tbasicDir := t.TempDir()\n\tfor _, name := range []string{\n\t\t\"alpha\", \"bravo\", \"charlie\", \"delta\", \"echo\",\n\t\t\"foxtrot\", \"golf\", \"hotel\", \"india\", \"juliet\",\n\t} {\n\t\ttouchFile(t, basicDir, name)\n\t}\n\n\tmixedDir := t.TempDir()\n\tfor _, name := range []string{\".hidden\", \"Bravo\", \"alpha\", \".secret\", \"Charlie\"} {\n\t\ttouchFile(t, mixedDir, name)\n\t}\n\n\tsortDir := t.TempDir()\n\tfor _, name := range []string{\"A\", \"B\", \"a\", \"b\", \"Z\", \"z\"} {\n\t\ttouchFile(t, sortDir, name)\n\t}\n\n\tescapeDir := t.TempDir()\n\tfor _, name := range []string{\"normal\", \"has space\", \"back\\\\slash\", \"tab\\there\"} {\n\t\ttouchFile(t, escapeDir, name)\n\t}\n\n\tdefaultDir := t.TempDir()\n\tfor _, name := range []string{\"one\", \"two\", \"three\"} {\n\t\ttouchFile(t, defaultDir, name)\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{Name: \"basic-listing\", Args: []string{basicDir}, Env: []string{\"COLUMNS=80\"}},\n\t\t{Name: \"hidden-excluded\", Args: []string{mixedDir}, Env: []string{\"COLUMNS=80\"}},\n\t\t{Name: \"c-locale-sort\", Args: []string{sortDir}, Env: []string{\"COLUMNS=80\"}},\n\t\t{Name: \"escape-special\", Args: []string{escapeDir}, Env: []string{\"COLUMNS=80\"}},\n\t\t{Name: \"default-cwd\", WorkDir: defaultDir, Env: []string{\"COLUMNS=80\"}},\n\t\t{\n\t\t\tName:      \"nonexistent\",\n\t\t\tArgs:      []string{\"/nonexistent-path-12345\"},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: errNorm,\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n","numLines":80,"startLine":1,"totalLines":80}}}
