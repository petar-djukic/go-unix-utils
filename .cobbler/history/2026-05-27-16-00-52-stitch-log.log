nc compareNumeric(a, b string, i, j *int) int {\n\tai, aj := *i, *j\n\tfor ai < len(a) && isDigit(a[ai]) {\n\t\tai++\n\t}\n\tfor aj < len(b) && isDigit(b[aj]) {\n\t\taj++\n\t}\n\tlenA, lenB := ai-*i, aj-*j\n\tif lenA != lenB {\n\t\t*i = ai\n\t\t*j = aj\n\t\treturn lenA - lenB\n\t}\n\tfor *i < ai {\n\t\tif a[*i] != b[*j] {\n\t\t\tresult := int(a[*i]) - int(b[*j])\n\t\t\t*i = ai\n\t\t\t*j = aj\n\t\t\treturn result\n\t\t}\n\t\t*i++\n\t\t*j++\n\t}\n\treturn 0\n}\n\nfunc isDigit(c byte) bool {\n\treturn c >= '0' && c <= '9'\n}\n","numLines":97,"startLine":1,"totalLines":97}}}
