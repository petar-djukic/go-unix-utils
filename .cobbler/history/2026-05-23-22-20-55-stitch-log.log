oInfo.Mode().Type()&os.ModeNamedPipe == 0 {\n173\t\t\tt.Fatal(\"go binary created a non-FIFO file\")\n174\t\t}\n175\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n176\t\t\tt.Fatalf(\"permission mismatch: go=%v ref=%v\",\n177\t\t\t\tgoInfo.Mode().Perm(), refInfo.Mode().Perm())\n178\t\t}\n179\t}\n180\t\n181\tfunc TestModePermissions(t *testing.T) {\n182\t\tgoBin := testutils.BuildBinary(t, \".\")\n183\t\trefBin, err := exec.LookPath(\"gmkfifo\")\n184\t\tif err != nil {\n185\t\t\tt.Skip(\"reference binary not found\")\n186\t\t}\n187\t\n188\t\ttests := []struct {\n189\t\t\tname string\n190\t\t\targs []string\n191\t\t}{\n192\t\t\t{\"octal_0600\", []string{\"-m\", \"0600\", \"p1\"}},\n193\t\t\t{\"octal_0644\", []string{\"-m\", \"0644\", \"p2\"}},\n194\t\t\t{\"octal_0666\", []string{\"-m\", \"0666\", \"p3\"}},\n195\t\t\t{\"symbolic_urw_gor\", []string{\"-m\", \"u=rw,go=r\", \"p4\"}},\n196\t\t\t{\"symbolic_arw\", []string{\"-m\", \"a=rw\", \"p5\"}},\n197\t\t}\n198\t\n199\t\tfor _, tt := range tests {\n200\t\t\tt.Run(tt.name, func(t *testing.T) {\n201\t\t\t\tgoDir := t.TempDir()\n202\t\t\t\trefDir := t.TempDir()\n203\t\t\t\trunBin(t, goBin, tt.args, goDir)\n204\t\t\t\trunBin(t, refBin, tt.args, refDir)\n205\t\t\t\tname := tt.args[len(tt.args)-1]\n206\t\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, name))\n207\t\t\t\tif err != nil {\n208\t\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", name, err)\n209\t\t\t\t}\n210\t\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, name))\n211\t\t\t\tif err != nil {\n212\t\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", name, err)\n213\t\t\t\t}\n214\t\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n215\t\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n216\t\t\t\t\t\tname, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n217\t\t\t\t}\n218\t\t\t})\n219\t\t}\n220\t}\n221\t\n222\tfunc runCreationTest(t *testing.T, goBin, refBin string, args []string) {\n223\t\tt.Helper()\n224\t\tgoDir := t.TempDir()\n225\t\trefDir := t.TempDir()\n226\t\tgoRes := runBin(t, goBin, args, goDir)\n227\t\trefRes := runBin(t, refBin, args, refDir)\n228\t\tcompareResults(t, args, goRes, refRes)\n229\t}\n230\t\n231\ttype binResult struct {\n232\t\tstdout   []byte\n233\t\tstderr   []byte\n234\t\texitCode int\n235\t}\n236\t\n237\tfunc runBin(t *testing.T, binary string, args []string, workDir string) binResult {\n238\t\tt.Helper()\n239\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n240\t\tdefer cancel()\n241\t\tcmd := exec.CommandContext(ctx, binary, args...)\n242\t\tcmd.Dir = workDir\n243\t\tcmd.Env = append(os.Environ(), \"LC_ALL=C\")\n244\t\tvar stdout, stderr bytes.Buffer\n245\t\tcmd.Stdout = &stdout\n246\t\tcmd.Stderr = &stderr\n247\t\terr := cmd.Run()\n248\t\tif ctx.Err() == context.DeadlineExceeded {\n249\t\t\tt.Fatalf(\"binary %s timed out\", binary)\n250\t\t}\n251\t\texitCode := 0\n252\t\tif err != nil {\n253\t\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n254\t\t\t\texitCode = exitErr.ExitCode()\n255\t\t\t} else {\n256\t\t\t\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n257\t\t\t}\n258\t\t}\n259\t\treturn binResult{stdout: stdout.Bytes(), stderr: stderr.Bytes(), exitCode: exitCode}\n260\t}\n261\t\n262\tfunc compareResults(t *testing.T, args []string, goRes, refRes binResult) {\n263\t\tt.Helper()\n264\t\tgoStdout := normalizeBinaryName(goRes.stdout)\n265\t\trefStdout := normalizeBinaryName(refRes.stdout)\n266\t\tgoStderr := normalizeBinaryName(goRes.stderr)\n267\t\trefStderr := normalizeBinaryName(refRes.stderr)\n268\t\tif !bytes.Equal(goStdout, refStdout) ||\n269\t\t\t!bytes.Equal(goStderr, refStderr) ||\n270\t\t\tgoRes.exitCode != refRes.exitCode {\n271\t\t\tt.Fatalf(\"divergence detected\\n\"+\n272\t\t\t\t\"  args:       %v\\n\"+\n273\t\t\t\t\"  ref stdout: %q\\n\"+\n274\t\t\t\t\"  go  stdout: %q\\n\"+\n275\t\t\t\t\"  ref stderr: %q\\n\"+\n276\t\t\t\t\"  go  stderr: %q\\n\"+\n277\t\t\t\t\"  ref exit:   %d\\n\"+\n278\t\