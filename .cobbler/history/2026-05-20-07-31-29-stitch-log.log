\t\tcase isDirectory(last):\n63\t\t\tfor _, target := range targets[:len(targets)-1] {\n64\t\t\t\tlinkName := filepath.Join(last, filepath.Base(target))\n65\t\t\t\tif err := createLink(target, linkName, opts); err != nil {\n66\t\t\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n67\t\t\t\t\texitCode = 1\n68\t\t\t\t}\n69\t\t\t}\n70\t\tcase len(targets) == 2:\n71\t\t\tif err := createLink(targets[0], targets[1], opts); err != nil {\n72\t\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n73\t\t\t\texitCode = 1\n74\t\t\t}\n75\t\tdefault:\n76\t\t\tfmt.Fprintf(os.Stderr, \"ln: target '%s': %s\\n\",\n77\t\t\t\tlast, targetDirError(last))\n78\t\t\texitCode = 1\n79\t\t}\n80\t\n81\t\treturn exitCode\n82\t}\n83\t\n84\tfunc createLink(target, linkName string, opts options) error {\n85\t\tif opts.symbolic {\n86\t\t\tt := target\n87\t\t\tif opts.relative {\n88\t\t\t\trel, err := computeRelative(target, linkName)\n89\t\t\t\tif err != nil {\n90\t\t\t\t\treturn err\n91\t\t\t\t}\n92\t\t\t\tt = rel\n93\t\t\t}\n94\t\t\tif err := os.Symlink(t, linkName); err != nil {\n95\t\t\t\treturn fmt.Errorf(\"failed to create symbolic link '%s': %s\",\n96\t\t\t\t\tlinkName, sysErrMsg(err))\n97\t\t\t}\n98\t\t\treturn nil\n99\t\t}\n100\t\treturn createHardLink(target, linkName)\n101\t}\n102\t\n103\tfunc computeRelative(target, linkName string) (string, error) {\n104\t\tabsTarget, err := filepath.Abs(target)\n105\t\tif err != nil {\n106\t\t\treturn \"\", fmt.Errorf(\"failed to access '%s': %s\", target, sysErrMsg(err))\n107\t\t}\n108\t\tlinkDir := filepath.Dir(linkName)\n109\t\tabsLinkDir, err := filepath.Abs(linkDir)\n110\t\tif err != nil {\n111\t\t\treturn \"\", fmt.Errorf(\"failed to access '%s': %s\", linkDir, sysErrMsg(err))\n112\t\t}\n113\t\trel, err := filepath.Rel(absLinkDir, absTarget)\n114\t\tif err != nil {\n115\t\t\treturn \"\", fmt.Errorf(\"failed to compute relative path: %s\", err)\n116\t\t}\n117\t\treturn rel, nil\n118\t}\n119\t\n120\tfunc createHardLink(target, linkName string) error {\n121\t\tfi, err := os.Stat(target)\n122\t\tif err != nil {\n123\t\t\treturn fmt.Errorf(\"failed to access '%s': %s\", target, sysErrMsg(err))\n124\t\t}\n125\t\tif fi.IsDir() {\n126\t\t\treturn fmt.Errorf(\"%s: hard link not allowed for directory\", target)\n127\t\t}\n128\t\tif err := os.Link(target, linkName); err != nil {\n129\t\t\treturn fmt.Errorf(\"failed to create hard link '%s': %s\",\n130\t\t\t\tlinkName, sysErrMsg(err))\n131\t\t}\n132\t\treturn nil\n133\t}\n134\t\n135\tfunc isDirectory(path string) bool {\n136\t\tfi, err := os.Stat(path)\n137\t\tif err != nil {\n138\t\t\treturn false\n139\t\t}\n140\t\treturn fi.IsDir()\n141\t}\n142\t\n143\tfunc targetDirError(path string) string {\n144\t\t_, err := os.Stat(path)\n145\t\tif err != nil {\n146\t\t\treturn \"No such file or directory\"\n147\t\t}\n148\t\treturn \"Not a directory\"\n149\t}\n150\t\n151\tfunc sysErrMsg(err error) string {\n152\t\tpe, ok := err.(*os.PathError)\n153\t\tif !ok {\n154\t\t\tle, ok := err.(*os.LinkError)\n155\t\t\tif !ok {\n156\t\t\t\treturn err.Error()\n157\t\t\t}\n158\t\t\treturn errnoMsg(le.Err)\n159\t\t}\n160\t\treturn errnoMsg(pe.Err)\n161\t}\n162\t\n163\tfunc errnoMsg(err error) string {\n164\t\tse, ok := err.(syscall.Errno)\n165\t\tif !ok {\n166\t\t\treturn err.Error()\n167\t\t}\n168\t\tswitch se {\n169\t\tcase syscall.EEXIST:\n170\t\t\treturn \"File exists\"\n171\t\tcase syscall.ENOENT:\n172\t\t\treturn \"No such file or directory\"\n173\t\tcase syscall.EACCES:\n174\t\t\treturn \"Permission denied\"\n175\t\tcase syscall.ENOTDIR:\n176\t\t\treturn \"Not a directory\"\n177\t\tcase syscall.EPERM:\n178\t\t\treturn \"Operation not permitted\"\n179\t\tcase syscall.EXDEV:\n180\t\t\treturn \"Invalid cross-device link\"\n181\t\tdefault:\n182\t\t\treturn se.Error()\n183\t\t}\n184\t}\n185\t\n186\tfunc parseArgs(args []string) (options, []string, error) {\n187\t\tvar opts options\n188\t\tvar targets []string\n189\t\n190\t\ti := 0\n191\t\tfor i < len(args) {\n192\t\t\targ := args[i]\n193\t\t\tif arg == \"--\" {\n194\t\t\t\ttargets = append(targets, args[i+1:]...)\n195\t\t\t\tbreak\n196\t\t\t}\n197\t\t\tif strings.HasPrefix(arg, \"--\") {\n198\t\t\t\tn, err := parseLongFlag(arg, &opts)\n199\t\t\t\tif err != nil {\n200\t\t\t\t\treturn opts, nil, err\n201\t\t\t\t}\n202\t\t\t\ti += n\n203\t\t\t\tcontinue\n204\t\t\t}\n205\t\t\tif len(arg) > 1 && arg[0] == '-' {\n206\t\t\t\tif err := parseShortFlags(arg[1:], &opts); err != nil {\n207\t\t\t\t\treturn opts, nil, err\n208\t\t\t\t}\n209\t\t\t\ti++\n210\t\t\t\tcontinue\n211\t\t\t}\n212\t\t\ttargets = append(targets, arg)\n213\t\t\ti++\n214\t\t}\n215\t\n216\t\tif len(targets) == 0 {\n217\t\t\treturn opts, nil, fmt.Errorf(\"missing file operand\")\n218\t\t}\n219\t\n220\t\treturn opts, targets, nil\n221\t}\n222\t\n223\tfunc parseLongFlag(flag string, opts *options) (int, error) {\n224\t\tswitch flag {\n225\t\tcase \"--help\":\n226\t\t\tfmt.Fprint(os.Stdout, helpText)\n227\t\t\tos.Exit(0)\n228\t\t\treturn 0, nil\n229\t\tcase \"--version\":\n230\t\t\tfmt.Fprint(os.Stdout, versionText)\n231\t\t\tos.Exit(0)\n232\t\t\treturn 0, nil\n233\t\tcase \"--symbolic\":\n234\t\t\topts.symbolic = true\n235\t\t\treturn 1, nil\n236\t\tcase \"--relative\":\n237\t\t\topts.relative = true\n238\t\t\treturn 1, nil\n239\t\tdefault:\n240\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n241\t\t}\n242\t}\n243\t\n244\tfunc parseShortFlags(flags string, opts *options) error {\n245\t\tfor j := 0; j < len(flags); j++ {\n246\t\t\tswitch flags[j] {\n247\t\t\tcase 's':\n248\t\t\t\topts.symbolic = true\n249\t\t\tcase 'r':\n250\t\t\t\topts.relative = true\n251\t\t\tdefault:\n252\t\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n253\t\t\t}\n254\t\t}\n255\t\treturn nil\n256\t}\n257\t"}]},"parent_tool_use_id":null,"session_id":"b2a830a3-a3ed-44a2-a7a8-4fe91a5228a8","uuid":"817fd4d2-f330-488a-a27c-39a69d7403c0","timestamp":"2026-05-20T11:33:16.761Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5341/cmd/ln/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd037-ln R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3, R2.4.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ln [OPTION]... TARGET LINK_NAME\n  or:  ln [OPTION]... TARGET\n  or:  ln [OPTION]... TARGET... DIRECTORY\nIn the 1st form, create a link to TARGET with the name LINK_NAME.\nIn the 2nd form, create a link to TARGET in the current directory.\nIn the 3rd form, create links to each TARGET in DIRECTORY.\n\n  -s, --symbolic  make symbolic links instead of hard links\n  -r, --relative  create symbolic links relative to link location\n      --help      display this help and exit\n      --version   output version information and exit\n`\n\nconst versionText = `ln (go-unix-utils) dev\n`\n\ntype options struct {\n\tsymbolic bool\n\trelative bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, targets, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'ln --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tos.Exit(run(opts, targets))\n}\n\nfunc run(opts options, targets []string) int {\n\texitCode := 0\n\tlast := targets[len(targets)-1]\n\n\tswitch {\n\tcase len(targets) == 1:\n\t\tlinkName := \"./\" + filepath.Base(targets[0])\n\t\tif err := createLink(targets[0], linkName, opts); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\tcase isDirectory(last):\n\t\tfor _, target := range targets[:len(targets)-1] {\n\t\t\tlinkName := filepath.Join(last, filepath.Base(target))\n\t\t\tif err := createLink(target, linkName, opts); err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\t\t\texitCode = 1\n\t\t\t}\n\t\t}\n\tcase len(targets) == 2:\n\t\tif err := createLink(targets[0], targets[1], opts); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"ln: target '%s': %s\\n\",\n\t\t\tlast, targetDirError(last))\n\t\texitCode = 1\n\t}\n\n\treturn exitCode\n}\n\nfunc createLink(target, linkName string, opts options) error {\n\tif opts.symbolic {\n\t\tt := target\n\t\tif opts.relative {\n\t\t\trel, err := computeRelative(target, linkName)\n\t\t\tif err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tt = rel\n\t\t}\n\t\tif err := os.Symlink(t, linkName); err != nil {\n\t\t\treturn fmt.Errorf(\"failed to create symbolic link '%s': %s\",\n\t\t\t\tlinkName, sysErrMsg(err))\n\t\t}\n\t\treturn nil\n\t}\n\treturn createHardLink(target, linkName)\n}\n\nfunc computeRelative(target, linkName string) (string, error) {\n\tabsTarget, err := filepath.Abs(target)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to access '%s': %s\", target, sysErrMsg(err))\n\t}\n\tlinkDir := filepath.Dir(linkName)\n\tabsLinkDir, err := filepath.Abs(linkDir)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to access '%s': %s\", linkDir, sysErrMsg(err))\n\t}\n\trel, err := filepath.Rel(absLinkDir, absTarget)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to compute relative path: %s\", err)\n\t}\n\treturn rel, nil\n}\n\nfunc createHardLink(target, linkName string) error {\n\tfi, err := os.Stat(target)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to access '%s': %s\", target, sysErrMsg(err))\n\t}\n\tif fi.IsDir() {\n\t\treturn fmt.Errorf(\"%s: hard link not allowed for directory\", target)\n\t}\n\tif err := os.Link(target, linkName); err != nil {\n\t\treturn fmt.Errorf(\"failed to create hard link '%s': %s\",\n\t\t\tlinkName, sysErrMsg(err))\n\t}\n\treturn nil\n}\n\nfunc isDirectory(path string) bool {\n\tfi, err := os.Stat(path)\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn fi.IsDir()\n}\n\nfunc targetDirError(path string) string {\n\t_, err := os.Stat(path)\n\tif err != nil {\n\t\treturn \"No such file or directory\"\n\t}\n\treturn \"Not a directory\"\n}\n\nfunc sysErrMsg(err error) string {\n\tpe, ok := err.(*os.PathError)\n\tif !ok {\n\t\tle, ok := err.(*os.LinkError)\n\t\tif !ok {\n\t\t\treturn err.Error()\n\t\t}\n\t\treturn errnoMsg(le.Err)\n\t}\n\treturn errnoMsg(pe.Err)\n}\n\nfunc errnoMsg(err error) string {\n\tse, ok := err.(syscall.Errno)\n\tif !ok {\n\t\treturn err.Error()\n\t}\n\tswitch se {\n\tcase syscall.EEXIST:\n\t\treturn \"File exists\"\n\tcase syscall.ENOENT:\n\t\treturn \"No such file or directory\"\n\tcase syscall.EACCES:\n\t\treturn \"Permission denied\"\n\tcase syscall.ENOTDIR:\n\t\treturn \"Not a directory\"\n\tcase syscall.EPERM:\n\t\treturn \"Operation not permitted\"\n\tcase syscall.EXDEV:\n\t\treturn \"Invalid cross-device link\"\n\tdefault:\n\t\treturn se.Error()\n\t}\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar targets []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ttargets = append(targets, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tif err := parseShortFlags(arg[1:], &opts); err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\ttargets = append(targets, arg)\n\t\ti++\n\t}\n\n\tif len(targets) == 0 {\n\t\treturn opts, nil, fmt.Errorf(\"missing file operand\")\n\t}\n\n\treturn opts, targets, nil\n}\n\nfunc parseLongFlag(flag string, opts *options) (int, error) {\n\tswitch flag {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase \"--symbolic\":\n\t\topts.symbolic = true\n\t\treturn 1, nil\n\tcase \"--relative\":\n\t\topts.relative = true\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, opts *options) error {\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 's':\n\t\t\topts.symbolic = true\n\t\tcase 'r':\n\t\t\topts.relative = true\n\t\tdefault:\n\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn nil\n}\n","numLines":257,"startLine":1,"totalLines":257}}}
