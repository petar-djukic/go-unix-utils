07\t\tif name == \"\" {\n208\t\t\tfmt.Fprintf(os.Stderr, \"%s: '': No such file or directory\\n\", progName())\n209\t\t\treturn false\n210\t\t}\n211\t\tpathMax := sysPathMax()\n212\t\tnameMax := sysNameMax()\n213\t\tif len(name) > pathMax {\n214\t\t\tfmt.Fprintf(os.Stderr, \"%s: %s: File name too long\\n\", progName(), name)\n215\t\t\treturn false\n216\t\t}\n217\t\treturn checkDefaultComponents(name, nameMax)\n218\t}\n219\t\n220\tfunc checkDefaultComponents(name string, nameMax int) bool {\n221\t\tfor _, comp := range strings.Split(name, \"/\") {\n222\t\t\tif len(comp) > nameMax {\n223\t\t\t\tfmt.Fprintf(os.Stderr,\n224\t\t\t\t\t\"%s: %s: File name too long\\n\", progName(), name)\n225\t\t\t\treturn false\n226\t\t\t}\n227\t\t}\n228\t\treturn checkAccessibility(name)\n229\t}\n230\t\n231\tfunc checkAccessibility(name string) bool {\n232\t\tprefix := \"\"\n233\t\tsep := \"\"\n234\t\tif strings.HasPrefix(name, \"/\") {\n235\t\t\tprefix = \"/\"\n236\t\t\tsep = \"\"\n237\t\t}\n238\t\tcomponents := strings.Split(name, \"/\")\n239\t\tfor i, comp := range components {\n240\t\t\tif comp == \"\" {\n241\t\t\t\tcontinue\n242\t\t\t}\n243\t\t\tprefix = prefix + sep + comp\n244\t\t\tsep = \"/\"\n245\t\t\tif i == len(components)-1 {\n246\t\t\t\tbreak\n247\t\t\t}\n248\t\t\tif err := syscall.Access(prefix, syscall.F_OK); err != nil {\n249\t\t\t\tbreak\n250\t\t\t}\n251\t\t\tif err := syscall.Access(prefix, 0x01); err != nil {\n252\t\t\t\tfmt.Fprintf(os.Stderr, \"%s: %s: %s\\n\",\n253\t\t\t\t\tprogName(), name, accessErrMsg(err))\n254\t\t\t\treturn false\n255\t\t\t}\n256\t\t}\n257\t\treturn true\n258\t}\n259\t\n260\tfunc accessErrMsg(err error) string {\n261\t\tif errno, ok := err.(syscall.Errno); ok {\n262\t\t\tswitch errno {\n263\t\t\tcase syscall.EACCES:\n264\t\t\t\treturn \"Permission denied\"\n265\t\t\tcase syscall.ENOTDIR:\n266\t\t\t\treturn \"Not a directory\"\n267\t\t\tdefault:\n268\t\t\t\treturn errno.Error()\n269\t\t\t}\n270\t\t}\n271\t\treturn err.Error()\n272\t}\n273\t\n274\