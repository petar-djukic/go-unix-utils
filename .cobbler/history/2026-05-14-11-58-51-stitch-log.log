eLen *int64) {\n\ti := 0\n\tfor i < len(data) {\n\t\tr, size := utf8.DecodeRune(data[i:])\n\t\tif r == utf8.RuneError && size == 1 {\n\t\t\tc.chars++\n\t\t\tprocessNonSpaceByte(data[i], c, inWord, lineLen)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tc.chars++\n\t\tif r == '\\n' {\n\t\t\tc.lines++\n\t\t\thandleNewline(c, inWord, lineLen)\n\t\t} else if r == '\\t' {\n\t\t\thandleTab(inWord, lineLen)\n\t\t} else if unicode.IsSpace(r) {\n\t\t\t*inWord = false\n\t\t\t*lineLen++\n\t\t} else {\n\t\t\tif !*inWord {\n\t\t\t\tc.words++\n\t\t\t\t*inWord = true\n\t\t\t}\n\t\t\t*lineLen++\n\t\t}\n\t\ti += size\n\t}\n}\n\nfunc processNonSpaceByte(b byte, c *counts, inWord *bool, lineLen *int64) {\n\tswitch b {\n\tcase '\\n':\n\t\tc.lines++\n\t\thandleNewline(c, inWord, lineLen)\n\tcase '\\t':\n\t\thandleTab(inWord, lineLen)\n\tcase ' ', '\\r', '\\f', '\\v':\n\t\t*inWord = false\n\t\t*lineLen++\n\tdefault:\n\t\tif !*inWord {\n\t\t\tc.words++\n\t\t\t*inWord = true\n\t\t}\n\t\t*lineLen++\n\t}\n}\n\nfunc handleNewline(c *counts, inWord *bool, lineLen *int64) {\n\t*inWord = false\n\tif *lineLen > c.maxLine {\n\t\tc.maxLine = *lineLen\n\t}\n\t*lineLen = 0\n}\n\nfunc handleTab(inWord *bool, lineLen *int64) {\n\t*inWord = false\n\t*lineLen = (*lineLen/8 + 1) * 8\n}\n\nfunc printResults(w io.Writer, opts options, results []counts, names []string, width int) {\n\ttotal := sumCounts(results)\n\tshowTotal := shouldShowTotal(opts.totalMode, len(results))\n\n\tif opts.totalMode != \"only\" {\n\t\tfor i, c := range results {\n\t\t\tprintLine(w, opts, c, names[i], width)\n\t\t}\n\t}\n\tif showTotal {\n\t\tprintLine(w, opts, total, \"total\", width)\n\t}\n}\n\nfunc sumCounts(results []counts) counts {\n\tvar total counts\n\tfor _, c := range results {\n\t\ttotal.lines += c.lines\n\t\ttotal.words += c.words\n\t\ttotal.bytes += c.bytes\n\t\ttotal.chars += c.chars\n\t\tif c.maxLine > total.maxLine {\n\t\t\ttotal.maxLine = c.maxLine\n\t\t}\n\t}\n\treturn total\n}\n\nfunc shouldShowTotal(mode string, n int