zeFunc{\n64\t\t\t\t\t\tnormalizeBinaryName,\n65\t\t\t\t\t},\n66\t\t\t\t},\n67\t\t\t})\n68\t\t})\n69\t\n70\t\tt.Run(\"nonempty\", func(t *testing.T) {\n71\t\t\tworkDir := t.TempDir()\n72\t\t\tos.Mkdir(filepath.Join(workDir, \"nonempty\"), 0o755)\n73\t\t\tos.WriteFile(filepath.Join(workDir, \"nonempty\", \"file\"), []byte(\"x\"), 0o644)\n74\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n75\t\t\t\t{\n76\t\t\t\t\tName:     \"not_empty\",\n77\t\t\t\t\tArgs:     []string{\"nonempty\"},\n78\t\t\t\t\tWorkDir:  workDir,\n79\t\t\t\t\tExitCode: 1,\n80\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n81\t\t\t\t\t\tnormalizeBinaryName,\n82\t\t\t\t\t},\n83\t\t\t\t},\n84\t\t\t})\n85\t\t})\n86\t\n87\t\tt.Run(\"single_empty\", func(t *testing.T) {\n88\t\t\trunRemovalTest(t, goBin, refBin, []string{\"emptydir\"},\n89\t\t\t\tfunc(dir string) {\n90\t\t\t\t\tos.Mkdir(filepath.Join(dir, \"emptydir\"), 0o755)\n91\t\t\t\t})\n92\t\t})\n93\t\n94\t\tt.Run(\"multiple_empty\", func(t *testing.T) {\n95\t\t\trunRemovalTest(t, goBin, refBin, []string{\"aaa\", \"bbb\", \"ccc\"},\n96\t\t\t\tfunc(dir string) {\n97\t\t\t\t\tos.Mkdir(filepath.Join(dir, \"aaa\"), 0o755)\n98\t\t\t\t\tos.Mkdir(filepath.Join(dir, \"bbb\"), 0o755)\n99\t\t\t\t\tos.Mkdir(filepath.Join(dir, \"ccc\"), 0o755)\n100\t\t\t\t})\n101\t\t})\n102\t\n103\t\tt.Run(\"partial_failure\", func(t *testing.T) {\n104\t\t\tsetup := func(dir string) {\n105\t\t\t\tos.Mkdir(filepath.Join(dir, \"emptydir\"), 0o755)\n106\t\t\t\tos.Mkdir(filepath.Join(dir, \"nonempty\"), 0o755)\n107\t\t\t\tos.WriteFile(filepath.Join(dir, \"nonempty\", \"file\"), []byte(\"x\"), 0o644)\n108\t\t\t}\n109\t\t\tgoDir := t.TempDir()\n110\t\t\trefDir := t.TempDir()\n111\t\t\tsetup(goDir)\n112\t\t\tsetup(refDir)\n113\t\t\targs := []string{\"emptydir\", \"nonempty\"}\n114\t\t\tgoRes := runBin(t, goBin, args, goDir)\n115\t\t\trefRes := runBin(t, refBin, args, refDir)\n116\t\t\tcompareResults(t, args, goRes, refRes)\n117\t\t})\n118\t\n119\t\tt.Run(\"multiple_