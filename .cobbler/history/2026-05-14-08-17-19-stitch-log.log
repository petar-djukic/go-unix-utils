\n108\t\trefBin, err := exec.LookPath(\"gtee\")\n109\t\tif err != nil {\n110\t\t\tt.Skip(\"reference binary gtee not found\")\n111\t\t}\n112\t\tinput := []byte(\"interrupt test\\n\")\n113\t\ttests := []testutils.DiffTest{\n114\t\t\t{Name: \"ignore_interrupts_short\", Args: []string{\"-i\"}, Stdin: input},\n115\t\t\t{Name: \"ignore_interrupts_long\", Args: []string{\"--ignore-interrupts\"}, Stdin: input},\n116\t\t}\n117\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n118\t}\n119\t\n120\tfunc TestDiffWriteOrder(t *testing.T) {\n121\t\tgoBin := testutils.BuildBinary(t, \".\")\n122\t\trefBin, err := exec.LookPath(\"gtee\")\n123\t\tif err != nil {\n124\t\t\tt.Skip(\"reference binary gtee not found\")\n125\t\t}\n126\t\tvar ordered []byte\n127\t\tfor i := range 100 {\n128\t\t\tordered = fmt.Appendf(ordered, \"line %03d\\n\", i)\n129\t\t}\n130\t\ttests := []testutils.DiffTest{\n131\t\t\t{Name: \"write_order\", Stdin: ordered},\n132\t\t}\n133\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n134\t}\n135\t\n136\tfunc TestDiffMultiFileAppend(t *testing.T) {\n137\t\tgoBin := testutils.BuildBinary(t, \".\")\n138\t\trefBin, err := exec.LookPath(\"gtee\")\n139\t\tif err != nil {\n140\t\t\tt.Skip(\"reference binary gtee not found\")\n141\t\t}\n142\t\trunMultiFileAppendTest(t, goBin, \"go_multi_append\")\n143\t\trunMultiFileAppendTest(t, refBin, \"ref_multi_append\")\n144\t}\n145\t\n146\tfunc TestFileCreation(t *testing.T) {\n147\t\tgoBin := testutils.BuildBinary(t, \".\")\n148\t\tdir := t.TempDir()\n149\t\toutFile := filepath.Join(dir, \"created.txt\")\n150\t\tcmd := exec.Command(goBin, outFile)\n151\t\tcmd.Stdin = bytes.NewReader([]byte(\"create me\\n\"))\n152\t\tout, err := cmd.Output()\n153\t\tif err != nil {\n154\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n155\t\t}\n156\t\tif string(out) != \"create me\\n\" {\n157\t\t\tt.Fatalf(\"stdout: got %q, want %q\", out, \"create me\\n\")\n158\t\t}\n159\t\tgot, err := os.ReadFile(outFile)\n160\t\tif err != nil {\n161\t\t\tt.Fatal