{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AF7R9Ygz2a33HbCsXv6NnS","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/tee implements srd017-tee: read stdin and write to stdout and files.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"os/signal\"\n13\t\t\"syscall\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tfunc main() {\n19\t\tsys.InstallSIGPIPEHandler()\n20\t\n21\t\tappendMode, ignoreInterrupts, files := parseFlags(os.Args[1:])\n22\t\tif ignoreInterrupts {\n23\t\t\tsignal.Ignore(os.Interrupt)\n24\t\t}\n25\t\twriters, closers, exitCode := openOutputs(files, appendMode)\n26\t\tdefer closeAll(closers)\n27\t\n28\t\tif err := copyStdin(writers); err != nil {\n29\t\t\tif !errors.Is(err, syscall.EPIPE) {\n30\t\t\t\tfmt.Fprintf(os.Stderr, \"tee: %v\\n\", err)\n31\t\t\t\texitCode = 1\n32\t\t\t}\n33\t\t}\n34\t\tif exitCode != 0 {\n35\t\t\tos.Exit(exitCode)\n36\t\t}\n37\t}\n38\t\n39\tfunc parseFlags(args []string) (bool, bool, []string) {\n40\t\tappendMode := false\n41\t\tignoreInterrupts := false\n42\t\tvar files []string\n43\t\tendOfFlags := false\n44\t\tfor _, arg := range args {\n45\t\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n46\t\t\t\tfiles = append(files, arg)\n47\t\t\t\tcontinue\n48\t\t\t}\n49\t\t\tif arg == \"--\" {\n50\t\t\t\tendOfFlags = true\n51\t\t\t\tcontinue\n52\t\t\t}\n53\t\t\tif arg == \"--append\" {\n54\t\t\t\tappendMode = true\n55\t\t\t\tcontinue\n56\t\t\t}\n57\t\t\tif arg == \"--ignore-interrupts\" {\n58\t\t\t\tignoreInterrupts = true\n59\t\t\t\tcontinue\n60\t\t\t}\n61\t\t\tfor _, c := range arg[1:] {\n62\t\t\t\tswitch c {\n63\t\t\t\tcase 'a':\n64\t\t\t\t\tappendMode = true\n65\t\t\t\tcase 'i':\n66\t\t\t\t\tignoreInterrupts = true\n67\t\t\t\tdefault:\n68\t\t\t\t\tfmt.Fprintf(os.Stderr, \"tee: invalid option -- '%c'\\n\", c)\n69\t\t\t\t\tos.Exit(1)\n70\t\t\t\t}\n71\t\t\t}\n72\t\t}\n73\t\treturn appendMode, ignoreInterrupts, files\n74\t}\n75\t\n76\t// R1.1, R1.4: build writers for stdout and each named file.\n77\tfunc openOutputs(files []string, appendMode bool) ([]io.Writer, []io.Closer, int) {\n78\t\twriters := []io.Writer{os.Stdout}\n79\t\tvar closers []io.Closer\n80\t\texitCode := 0\n81\t\tfor _, name := range files {\n82\t\t\tif name == \"-\" {\n83\t\t\t\tcontinue\n84\t\t\t}\n85\t\t\tf, err := openFile(name, appendMode)\n86\t\t\tif err != nil {\n87\t\t\t\tfmt.Fprintf(os.Stderr, \"tee: %s: %v\\n\", name, unwrapErr(err))\n88\t\t\t\texitCode = 1\n89\t\t\t\tcontinue\n90\t\t\t}\n91\t\t\twriters = append(writers, f)\n92\t\t\tclosers = append(closers, f)\n93\t\t}\n94\t\treturn writers, closers, exitCode\n95\t}\n96\t\n97\t// R1.3: create or truncate; append if -a.\n98\tfunc openFile(name string, appendMode bool) (*os.File, error) {\n99\t\tflags := os.O_WRONLY | os.O_CREATE\n100\t\tif appendMode {\n101\t\t\tflags |= os.O_APPEND\n102\t\t} else {\n103\t\t\tflags |= os.O_TRUNC\n104\t\t}\n105\t\treturn os.OpenFile(name, flags, 0o666)\n106\t}\n107\t\n108\t// R1.1, R1.5: copy stdin to all writers in order received.\n109\tfunc copyStdin(writers []io.Writer) error {\n110\t\tmw := io.MultiWriter(writers...)\n111\t\t_, err := io.Copy(mw, os.Stdin)\n112\t\treturn err\n113\t}\n114\t\n115\tfunc closeAll(closers []io.Closer) {\n116\t\tfor _, c := range closers {\n117\t\t\tc.Close()\n118\t\t}\n119\t}\n120\t\n121\tfunc unwrapErr(err error) error {\n122\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n123\t\t\treturn pe.Err\n124\t\t}\n125\t\treturn err\n126\t}\n127\t"}]},"parent_tool_use_id":null,"session_id":"bd09a5a3-e61f-4fcc-856a-0c9a1fbde06a","uuid":"f4ee576c-c4d4-4ad2-9197-62353244e853","timestamp":"2026-05-14T12:17:29.550Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5158/cmd/tee/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/tee implements srd017-tee: read stdin and write to stdout and files.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/signal\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tappendMode, ignoreInterrupts, files := parseFlags(os.Args[1:])\n\tif ignoreInterrupts {\n\t\tsignal.Ignore(os.Interrupt)\n\t}\n\twriters, closers, exitCode := openOutputs(files, appendMode)\n\tdefer closeAll(closers)\n\n\tif err := copyStdin(writers); err != nil {\n\t\tif !errors.Is(err, syscall.EPIPE) {\n\t\t\tfmt.Fprintf(os.Stderr, \"tee: %v\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc parseFlags(args []string) (bool, bool, []string) {\n\tappendMode := false\n\tignoreInterrupts := false\n\tvar files []string\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--append\" {\n\t\t\tappendMode = true\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--ignore-interrupts\" {\n\t\t\tignoreInterrupts = true\n\t\t\tcontinue\n\t\t}\n\t\tfor _, c := range arg[1:] {\n\t\t\tswitch c {\n\t\t\tcase 'a':\n\t\t\t\tappendMode = true\n\t\t\tcase 'i':\n\t\t\t\tignoreInterrupts = true\n\t\t\tdefault:\n\t\t\t\tfmt.Fprintf(os.Stderr, \"tee: invalid option -- '%c'\\n\", c)\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t}\n\t}\n\treturn appendMode, ignoreInterrupts, files\n}\n\n// R1.1, R1.4: build writers for stdout and each named file.\nfunc openOutputs(files []string, appendMode bool) ([]io.Writer, []io.Closer, int) {\n\twriters := []io.Writer{os.Stdout}\n\tvar closers []io.Closer\n\texitCode := 0\n\tfor _, name := range files {\n\t\tif name == \"-\" {\n\t\t\tcontinue\n\t\t}\n\t\tf, err := openFile(name, appendMode)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"tee: %s: %v\\n\", name, unwrapErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\twriters = append(writers, f)\n\t\tclosers = append(closers, f)\n\t}\n\treturn writers, closers, exitCode\n}\n\n// R1.3: create or truncate; append if -a.\nfunc openFile(name string, appendMode bool) (*os.File, error) {\n\tflags := os.O_WRONLY | os.O_CREATE\n\tif appendMode {\n\t\tflags |= os.O_APPEND\n\t} else {\n\t\tflags |= os.O_TRUNC\n\t}\n\treturn os.OpenFile(name, flags, 0o666)\n}\n\n// R1.1, R1.5: copy stdin to all writers in order received.\nfunc copyStdin(writers []io.Writer) error {\n\tmw := io.MultiWriter(writers...)\n\t_, err := io.Copy(mw, os.Stdin)\n\treturn err\n}\n\nfunc closeAll(closers []io.Closer) {\n\tfor _, c := range closers {\n\t\tc.Close()\n\t}\n}\n\nfunc unwrapErr(err error) error {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn pe.Err\n\t}\n\treturn err\n}\n","numLines":127,"startLine":1,"totalLines":127}}}
