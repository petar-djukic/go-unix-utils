{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BR33pCCfaQWvd3TTTrkGQa","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"path/filepath\"\n12\t\t\"testing\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n15\t)\n16\t\n17\tfunc TestDiff(t *testing.T) {\n18\t\tgoBin := testutils.BuildBinary(t, \".\")\n19\t\trefBin, err := exec.LookPath(\"gtee\")\n20\t\tif err != nil {\n21\t\t\tt.Skip(\"reference binary gtee not found\")\n22\t\t}\n23\t\ttests := []testutils.DiffTest{\n24\t\t\t{Name: \"passthrough_no_files\", Stdin: []byte(\"hello\\nworld\\n\")},\n25\t\t\t{Name: \"empty_stdin\", Stdin: []byte{}},\n26\t\t\t{Name: \"large_input\", Stdin: bytes.Repeat([]byte(\"abcdefghij\\n\"), 1000)},\n27\t\t\t{Name: \"no_trailing_newline\", Stdin: []byte(\"no newline\")},\n28\t\t\t{Name: \"binary_data\", Stdin: allBytes()},\n29\t\t}\n30\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n31\t}\n32\t\n33\tfunc TestDiffSingleFile(t *testing.T) {\n34\t\tgoBin := testutils.BuildBinary(t, \".\")\n35\t\trefBin, err := exec.LookPath(\"gtee\")\n36\t\tif err != nil {\n37\t\t\tt.Skip(\"reference binary gtee not found\")\n38\t\t}\n39\t\tinput := []byte(\"hello\\nworld\\n\")\n40\t\trunFileTest(t, goBin, \"go_single\", input, \"out.txt\")\n41\t\trunFileTest(t, refBin, \"ref_single\", input, \"out.txt\")\n42\t}\n43\t\n44\tfunc TestDiffMultipleFiles(t *testing.T) {\n45\t\tgoBin := testutils.BuildBinary(t, \".\")\n46\t\trefBin, err := exec.LookPath(\"gtee\")\n47\t\tif err != nil {\n48\t\t\tt.Skip(\"reference binary gtee not found\")\n49\t\t}\n50\t\tinput := []byte(\"multi\\nfile\\ntest\\n\")\n51\t\tgoStdout := runMultiFileTest(t, goBin, \"go_multi\", input, \"a.txt\", \"b.txt\")\n52\t\trefStdout := runMultiFileTest(t, refBin, \"ref_multi\", input, \"a.txt\", \"b.txt\")\