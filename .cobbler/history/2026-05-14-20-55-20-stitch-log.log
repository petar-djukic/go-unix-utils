{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FSABheRiZscCs4XNWn4RwR","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd051-pwd R3.1-R3.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"os/exec\"\n9\t\t\"regexp\"\n10\t\t\"testing\"\n11\t\n12\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n13\t)\n14\t\n15\tfunc TestDiff(t *testing.T) {\n16\t\tgoBin := testutils.BuildBinary(t, \".\")\n17\t\trefBin, err := exec.LookPath(\"gpwd\")\n18\t\tif err != nil {\n19\t\t\tt.Skip(\"reference binary not found\")\n20\t\t}\n21\t\n22\t\tdiscardStdout := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n23\t\n24\t\tbinaryNameRe := regexp.MustCompile(`(?:/\\S+/)?g?pwd`)\n25\t\tnormalizeBinaryName := testutils.NormalizeFunc(func(b []byte) []byte {\n26\t\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"pwd\"))\n27\t\t})\n28\t\n29\t\t// R3.3: All differential tests set LC_ALL=C in the environment.\n30\t\tlcEnv := []string{\"LC_ALL=C\"}\n31\t\n32\t\ttests := []testutils.DiffTest{\n33\t\t\t// R3.2: default invocation (physical mode)\n34\t\t\t{\n35\t\t\t\tName: \"default\",\n36\t\t\t\tEnv:  lcEnv,\n37\t\t\t},\n38\t\t\t// R3.2: -P flag (physical mode)\n39\t\t\t{\n40\t\t\t\tName: \"physical-short\",\n41\t\t\t\tArgs: []string{\"-P\"},\n42\t\t\t\tEnv:  lcEnv,\n43\t\t\t},\n44\t\t\t{\n45\t\t\t\tName: \"physical-long\",\n46\t\t\t\tArgs: []string{\"--physical\"},\n47\t\t\t\tEnv:  lcEnv,\n48\t\t\t},\n49\t\t\t// R3.2: -L flag (logical mode)\n50\t\t\t{\n51\t\t\t\tName: \"logical-short\",\n52\t\t\t\tArgs: []string{\"-L\"},\n53\t\t\t\tEnv:  lcEnv,\n54\t\t\t},\n55\t\t\t{\n56\t\t\t\tName: \"logical-long\",\n57\t\t\t\tArgs: []string{\"--logical\"},\n58\t\t\t\tEnv:  lcEnv,\n59\t\t\t},\n60\t\t\t// R3.2: -L -P precedence (last wins)\n61\t\t\t{\n62\t\t\t\tName: \"logical-then-physical\",\n63\t\t\t\tArgs: []string{\"-L\", \"-P\"},\n64\t\t\t\tEnv:  lcEnv,\n65\t\t\t},\n66\t\t\t{\n67\t\t\t\tName: \"physical-then-logical\",\n68\t\t\t\tArgs: []string{\"-P\", \"-L\"},\n69\t\t\t\tEnv:  lcEnv,\n70\t\t\t},\n71\t\t\t{\n72\t\t\t\tName: \"combined-LP\",\n73\t\t\t\tArgs: []string{\"-LP\"},\n74\t\t\t\tEnv:  lcEnv,\n75\t\t\t},\n76\t\t\t{\n77\t\t\t\tName: \"combined-PL\",\n78\t\t\t\tArgs: []string{\"-PL\"},\n79\t\t\t\tEnv:  lcEnv,\n80\t\t\t},\n81\t\t\t// R2.1: extra positional operand (gpwd warns but still prints and exits 0)\n82\t\t\t{\n83\t\t\t\tName:      \"extra-operand\",\n84\t\t\t\tArgs:      []string{\"foo\"},\n85\t\t\t\tEnv:       lcEnv,\n86\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n87\t\t\t},\n88\t\t\t{\n89\t\t\t\tName:      \"extra-operand-after-dashdash\",\n90\t\t\t\tArgs:      []string{\"--\", \"foo\"},\n91\t\t\t\tEnv:       lcEnv,\n92\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n93\t\t\t},\n94\t\t\t// R2.2: unknown flags\n95\t\t\t{\n96\t\t\t\tName:      \"error-unknown-long-flag\",\n97\t\t\t\tArgs:      []string{\"--bogus\"},\n98\t\t\t\tEnv:       lcEnv,\n99\t\t\t\tExitCode:  1,\n100\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n101\t\t\t},\n102\t\t\t{\n103\t\t\t\tName:      \"error-unknown-short-flag\",\n104\t\t\t\tArgs:      []string{\"-x\"},\n105\t\t\t\tEnv:       lcEnv,\n106\t\t\t\tExitCode:  1,\n107\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n108\t\t\t},\n109\t\t\t// --help and --version (discard stdout since text differs)\n110\t\t\t{\n111\t\t\t\tName:      \"help\",\n112\t\t\t\tArgs:      []string{\"--help\"},\n113\t\t\t\tEnv:       lcEnv,\n114\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStdout},\n115\t\t\t},\n116\t\t\t{\n117\t\t\t\tName:      \"version\",\n118\t\t\t\tArgs:      []string{\"--version\"},\n119\t\t\t\tEnv:       lcEnv,\n120\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStdout},\n121\t\t\t},\n122\t\t}\n123\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n124\t}\n125\t\n\n<system-reminder>\nWhenever you read 