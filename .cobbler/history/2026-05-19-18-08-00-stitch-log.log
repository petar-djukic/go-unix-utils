{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GVGBShU5SiZTYfMzuv61DY","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage hashutil\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"regexp\"\n12\t)\n13\t\n14\tvar (\n15\t\tbsdTagRe = regexp.MustCompile(`^(\\S+) \\((.+)\\) = ([0-9a-fA-F]+)$`)\n16\t\tgnuRe    = regexp.MustCompile(`^([0-9a-fA-F]+) ([ *])(.+)$`)\n17\t)\n18\t\n19\t// ParseChecksumLine parses a single GNU or BSD tag format checksum line. (R2.1)\n20\tfunc ParseChecksumLine(line string, cfg HashConfig) (filename, expectedDigest string, binary bool, err error) {\n21\t\tif m := bsdTagRe.FindStringSubmatch(line); m != nil {\n22\t\t\treturn m[2], m[3], false, nil\n23\t\t}\n24\t\tif m := gnuRe.FindStringSubmatch(line); m != nil {\n25\t\t\treturn m[3], m[1], m[2] == \"*\", nil\n26\t\t}\n27\t\treturn \"\", \"\", false, fmt.Errorf(\"malformed checksum line\")\n28\t}\n29\t\n30\t// VerifyChecksums reads checksumFile, verifies each entry, and prints\n31\t// results according to opts. Returns whether all checks passed. (R2.3)\n32\tfunc VerifyChecksums(checksumFile string, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) (bool, error) {\n33\t\tr, err := openInput(checksumFile)\n34\t\tif err != nil {\n35\t\t\treturn false, fmt.Errorf(\"opening checksum file: %w\", err)\n36\t\t}\n37\t\tdefer r.Close()\n38\t\treturn verifyLines(r, cfg, opts, stdout, stderr)\n39\t}\n40\t\n41\tfunc verifyLines(r io.Reader, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) (bool, error) {\n42\t\tscanner := bufio.NewScanner(r)\n43\t\tallOK := true\n44\t\tfor scanner.Scan() {\n45\t\t\tif !verifyOneLine(scanner.Text(), cfg, opts, stdout, stderr) {\n46\t\t\t\tallOK = false\n47\t\t\t}\n48\t\t}\n49\t\tif err := scanner.Err(); err != nil {\n50\t\t\treturn false, fmt.Errorf(\"reading checksum input: %w\", err)\n51\t\t}\n52\t\treturn allOK, nil\n53\t}\n54\t\n55\tfunc verifyOneLine(line string, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) bool {\n56\t\tfilename, expected, _, err := ParseChecksumLine(line, cfg)\n57\t\tif err != nil {\n58\t\t\tif opts.Warn && !opts.Status {\n59\t\t\t\tfmt.Fprintf(stderr, \"WARNING: improperly formatted checksum line\\n\")\n60\t\t\t}\n61\t\t\treturn true\n62\t\t}\n63\t\tactual, err := computeFileDigest(filename, cfg)\n64\t\tif err != nil {\n65\t\t\tif !opts.Status {\n66\t\t\t\tfmt.Fprintf(stdout, \"%s: FAILED open or read\\n\", filename)\n67\t\t\t}\n68\t\t\treturn false\n69\t\t}\n70\t\tif actual != expected {\n71\t\t\tif !opts.Status {\n72\t\t\t\tfmt.Fprintf(stdout, \"%s: FAILED\\n\", filename)\n73\t\t\t}\n74\t\t\treturn false\n75\t\t}\n76\t\tif !opts.Status && !opts.Quiet {\n77\t\t\tfmt.Fprintf(stdout, \"%s: OK\\n\", filename)\n78\t\t}\n79\t\treturn true\n80\t}\n81\t\n82\tfunc computeFileDigest(filename string, cfg HashConfig) (string, error) {\n83\t\tf, err := os.Open(filename)\n84\t\tif err != nil {\n85\t\t\treturn \"\", err\n86\t\t}\n87\t\tdefer f.Close()\n88\t\treturn ComputeDigest(f, cfg)\n89\t}\n90\t\n91\t// DigestFiles computes and prints digests for each file (or stdin when files\n92\t// is empty or contains \"-\"), returning the exit code. (R3.1, R3.2)\n93\tfunc DigestFiles(files []string, cfg HashConfig, binary, tag bool, stdout, stderr io.Writer) int {\n94\t\tif len(files) == 0 {\n95\t\t\tfiles = []string{\"-\"}\n96\t\t}\n97\t\texitCode := 0\n98\t\tfor _, file := range files {\n99\t\t\tif err := digestAndPrint(file, cfg, binary, tag, stdout); err != nil {\n100\t\t\t\tfmt.Fprintf(stderr, \"%s: %s\\n\", file, err)\n101\t\t\t\texitCode = 1\n102\t\t\t}\n103\t\t}\n104\t\treturn exitCode\n105\t}\n106\t\n107\tfunc digestAndPrint(file string, cfg HashConfig, binary, tag bool, stdout io.Writer) error {\n108\t\tr, err := openInput(file)\n109\t\tif err != nil {\n110\t\t\treturn err\n111\t\t}\n112\t\tdefer r.Close()\n113\t\tdigest, err := ComputeDigest(r, cfg)\n114\t\tif err != nil {\n115\t\t\treturn err\n116\t\t}\n117\t\tif tag {\n118\t\t\tfmt.Fprintln(stdout, FormatBSDTag(cfg.Algorithm, file, digest))\n119\t\t} else {\n120\t\t\tfmt.Fprintln(stdout, FormatGNU(digest, file, binary))\n121\t\t}\n122\t\treturn nil\n123\t}\n124\t\n125\tfunc openInput(file string) (io.ReadCloser, error) {\n126\t\tif file == \"-\" {\n127\t\t\treturn io.NopCloser(os.Stdin), nil\n128\t\t}\n129\t\treturn os.Open(file)\n130\t}\n131\t"}]},"parent_tool_use_id":null,"session_id":"8db693d2-13eb-4853-94f3-cef8544dde31","uuid":"d8f00ca6-96dd-4508-a2f0-fbf568a94806","timestamp":"2026-05-19T22:09:07.013Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5301/pkg/hashutil/hashutil.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage hashutil\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"regexp\"\n)\n\nvar (\n\tbsdTagRe = regexp.MustCompile(`^(\\S+) \\((.+)\\) = ([0-9a-fA-F]+)$`)\n\tgnuRe    = regexp.MustCompile(`^([0-9a-fA-F]+) ([ *])(.+)$`)\n)\n\n// ParseChecksumLine parses a single GNU or BSD tag format checksum line. (R2.1)\nfunc ParseChecksumLine(line string, cfg HashConfig) (filename, expectedDigest string, binary bool, err error) {\n\tif m := bsdTagRe.FindStringSubmatch(line); m != nil {\n\t\treturn m[2], m[3], false, nil\n\t}\n\tif m := gnuRe.FindStringSubmatch(line); m != nil {\n\t\treturn m[3], m[1], m[2] == \"*\", nil\n\t}\n\treturn \"\", \"\", false, fmt.Errorf(\"malformed checksum line\")\n}\n\n// VerifyChecksums reads checksumFile, verifies each entry, and prints\n// results according to opts. Returns whether all checks passed. (R2.3)\nfunc VerifyChecksums(checksumFile string, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) (bool, error) {\n\tr, err := openInput(checksumFile)\n\tif err != nil {\n\t\treturn false, fmt.Errorf(\"opening checksum file: %w\", err)\n\t}\n\tdefer r.Close()\n\treturn verifyLines(r, cfg, opts, stdout, stderr)\n}\n\nfunc verifyLines(r io.Reader, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) (bool, error) {\n\tscanner := bufio.NewScanner(r)\n\tallOK := true\n\tfor scanner.Scan() {\n\t\tif !verifyOneLine(scanner.Text(), cfg, opts, stdout, stderr) {\n\t\t\tallOK = false\n\t\t}\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\treturn false, fmt.Errorf(\"reading checksum input: %w\", err)\n\t}\n\treturn allOK, nil\n}\n\nfunc verifyOneLine(line string, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) bool {\n\tfilename, expected, _, err := ParseChecksumLine(line, cfg)\n\tif err != nil {\n\t\tif opts.Warn && !opts.Status {\n\t\t\tfmt.Fprintf(stderr, \"WARNING: improperly formatted checksum line\\n\")\n\t\t}\n\t\treturn true\n\t}\n\tactual, err := computeFileDigest(filename, cfg)\n\tif err != nil {\n\t\tif !opts.Status {\n\t\t\tfmt.Fprintf(stdout, \"%s: FAILED open or read\\n\", filename)\n\t\t}\n\t\treturn false\n\t}\n\tif actual != expected {\n\t\tif !opts.Status {\n\t\t\tfmt.Fprintf(stdout, \"%s: FAILED\\n\", filename)\n\t\t}\n\t\treturn false\n\t}\n\tif !opts.Status && !opts.Quiet {\n\t\tfmt.Fprintf(stdout, \"%s: OK\\n\", filename)\n\t}\n\treturn true\n}\n\nfunc computeFileDigest(filename string, cfg HashConfig) (string, error) {\n\tf, err := os.Open(filename)\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer f.Close()\n\treturn ComputeDigest(f, cfg)\n}\n\n// DigestFiles computes and prints digests for each file (or stdin when files\n// is empty or contains \"-\"), returning the exit code. (R3.1, R3.2)\nfunc DigestFiles(files []string, cfg HashConfig, binary, tag bool, stdout, stderr io.Writer) int {\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\texitCode := 0\n\tfor _, file := range files {\n\t\tif err := digestAndPrint(file, cfg, binary, tag, stdout); err != nil {\n\t\t\tfmt.Fprintf(stderr, \"%s: %s\\n\", file, err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc digestAndPrint(file string, cfg HashConfig, binary, tag bool, stdout io.Writer) error {\n\tr, err := openInput(file)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer r.Close()\n\tdigest, err := ComputeDigest(r, cfg)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif tag {\n\t\tfmt.Fprintln(stdout, FormatBSDTag(cfg.Algorithm, file, digest))\n\t} else {\n\t\tfmt.Fprintln(stdout, FormatGNU(digest, file, binary))\n\t}\n\treturn nil\n}\n\nfunc openInput(file string) (io.ReadCloser, error) {\n\tif file == \"-\" {\n\t\treturn io.NopCloser(os.Stdin), nil\n\t}\n\treturn os.Open(file)\n}\n","numLines":131,"startLine":1,"totalLines":131}}}
