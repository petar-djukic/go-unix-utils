{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018ofQ1cGVTNCArutRwtCq5R","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd114-vidir R1.1, R1.2, R1.3, R1.4, R2.1, R2.2.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tvar verbose bool\n20\t\n21\tfunc main() {\n22\t\tsys.InstallSIGPIPEHandler()\n23\t\tos.Exit(run(os.Args[1:]))\n24\t}\n25\t\n26\tfunc run(args []string) int {\n27\t\targs = parseFlags(args)\n28\t\tfiles, err := collectFiles(args)\n29\t\tif err != nil {\n30\t\t\tfmt.Fprintf(os.Stderr, \"vidir: %v\\n\", err)\n31\t\t\treturn 1\n32\t\t}\n33\t\tif len(files) == 0 {\n34\t\t\treturn 0\n35\t\t}\n36\t\toriginal := buildListing(files)\n37\t\tedited, err := editListing(original)\n38\t\tif err != nil {\n39\t\t\tfmt.Fprintf(os.Stderr, \"vidir: %v\\n\", err)\n40\t\t\treturn 1\n41\t\t}\n42\t\treturn applyChanges(original, edited)\n43\t}\n44\t\n45\tfunc parseFlags(args []string) []string {\n46\t\tvar rest []string\n47\t\tfor _, a := range args {\n48\t\t\tswitch a {\n49\t\t\tcase \"-v\", \"--verbose\":\n50\t\t\t\tverbose = true\n51\t\t\tdefault:\n52\t\t\t\trest = append(rest, a)\n53\t\t\t}\n54\t\t}\n55\t\treturn rest\n56\t}\n57\t\n58\tfunc collectFiles(args []string) ([]string, error) {\n59\t\tif !isTerminalStdin() {\n60\t\t\treturn readStdinFiles()\n61\t\t}\n62\t\tdir := \".\"\n63\t\tif len(args) > 0 {\n64\t\t\tdir = args[0]\n65\t\t}\n66\t\treturn readDirFiles(dir)\n67\t}\n68\t\n69\tfunc isTerminalStdin() bool {\n70\t\tfi, err := os.Stdin.Stat()\n71\t\tif err != nil {\n72\t\t\treturn true\n73\t\t}\n74\t\treturn fi.Mode()&os.ModeCharDevice != 0\n75\t}\n76\t\n77\tfunc readStdinFiles() ([]string, error) {\n78\t\tvar files []string\n79\t\tscanner := bufio.NewScanner(os.Stdin)\n80\t\tfor scanner.Scan() {\n81\t\t\tline := scanner.Text()\n82\t\t\tif line != \"\" {\n83\t\t\t\tfiles = append(files, line)\n84\t\t\t}\n85\t\t}\n86\t\treturn files, scanner.Err()\n87\t}\n88\t\n89\tfunc readDirFiles(dir string) ([]string, error) {\n90\t\tentries, err := os.ReadDir(dir)\n91\t\tif err != nil {\n92\t\t\treturn nil, err\n93\t\t}\n94\t\tfiles := make([]string, 0, len(entries))\n95\t\tfor _, e := range entries {\n96\t\t\tfiles = append(files, filepath.Join(dir, e.Name()))\n97\t\t}\n98\t\treturn files, nil\n99\t}\n100\t\n101\ttype entry struct {\n102\t\tid   int\n103\t\tname string\n104\t}\n105\t\n106\tfunc buildListing(files []string) []entry {\n107\t\tentries := make([]entry, len(files))\n108\t\tfor i, f := range files {\n109\t\t\tentries[i] = entry{id: i + 1, name: f}\n110\t\t}\n111\t\treturn entries\n112\t}\n113\t\n114\tfunc editListing(entries []entry) ([]entry, error) {\n115\t\ttmp, err := writeTempFile(entries)\n116\t\tif err != nil {\n117\t\t\treturn nil, err\n118\t\t}\n119\t\tdefer os.Remove(tmp)\n120\t\tif err := runEditor(tmp); err != nil {\n121\t\t\treturn nil, err\n122\t\t}\n123\t\treturn parseListing(tmp)\n124\t}\n125\t\n126\tfunc writeTempFile(entries []entry) (string, error) {\n127\t\tf, err := os.CreateTemp(\"\", \"vidir-*.txt\")\n128\t\tif err != nil {\n129\t\t\treturn \"\", err\n130\t\t}\n131\t\tdefer f.Close()\n132\t\tw := bufio.NewWriter(f)\n133\t\tfor _, e := range entries {\n134\t\t\tfmt.Fprintf(w, \"%d\\t%s\\n\", e.id, e.name)\n135\t\t}\n136\t\tif err := w.Flush(); err != nil {\n137\t\t\treturn \"\", err\n138\t\t}\n139\t\treturn f.Name(), nil\n140\t}\n141\t\n142\tfunc runEditor(path string) error {\n143\t\teditor := os.Getenv(\"EDITOR\")\n144\t\tif editor == \"\" {\n145\t\t\teditor = \"vi\"\n146\t\t}\n147\t\tcmd := makeEditorCmd(editor, path)\n148\t\tcmd.Stdin = os.Stdin\n149\t\tcmd.Stdout = os.Stdout\n150\t\tcmd.Stderr = os.Stderr\n151\t\treturn cmd.Run()\n152\t}\n153\t\n154\tfunc parseListing(path string) ([]entry, error) {\n155\t\tf, err := os.Open(path)\n156\t\tif err != nil {\n157\t\t\treturn nil, err\n158\t\t}\n159\t\tdefer f.Close()\n160\t\tvar entries []entry\n161\t\tscanner := bufio.NewScanner(f)\n162\t\tfor scanner.Scan() {\n163\t\t\te, err := parseLine(scanner.Text())\n164\t\t\tif err != nil {\n165\t\t\t\treturn nil, err\n166\t\t\t}\n167\t\t\tif e != nil {\n168\t\t\t\tentries = append(entries, *e)\n169\t\t\t}\n170\t\t}\n171\t\treturn entries, scanner.Err()\n172\t}\n173\t\n174\tfunc parseLine(line string) (*entry, error) {\n175\t\tif strings.TrimSpace(line) == \"\" {\n176\t\t\treturn nil, nil\n177\t\t}\n178\t\tparts := strings.SplitN(line, \"\\t\", 2)\n179\t\tif len(parts) != 2 {\n180\t\t\treturn nil, fmt.Errorf(\"invalid line: %s\", line)\n181\t\t}\n182\t\tid, err := strconv.Atoi(strings.TrimSpace(parts[0]))\n183\t\tif err != nil {\n184\t\t\treturn nil, fmt.Errorf(\"invalid id: %s\", parts[0])\n185\t\t}\n186\t\treturn &entry{id: id, name: parts[1]}, nil\n187\t}\n188\t\n189\tfunc applyChanges(original, edited []entry) int {\n190\t\teditedMap := make(map[int]string, len(edited))\n191\t\tfor _, e := range edited {\n192\t\t\teditedMap[e.id] = e.name\n193\t\t}\n194\t\tcode := processRenames(original, editedMap)\n195\t\tif c := processDeletions(original, editedMap); c != 0 {\n196\t\t\tcode = c\n197\t\t}\n198\t\treturn code\n199\t}\n200\t\n201\tfunc processRenames(original []entry, editedMap map[int]string) int {\n202\t\tcode := 0\n203\t\tfor _, orig := range original {\n204\t\t\tnewName, exists := editedMap[orig.id]\n205\t\t\tif !exists || newName == orig.name {\n206\t\t\t\tcontinue\n207\t\t\t}\n208\t\t\tif err := renameFile(orig.name, newName); err != nil {\n209\t\t\t\tfmt.Fprintf(os.Stderr, \"vidir: %v\\n\", err)\n210\t\t\t\tcode = 1\n211\t\t\t}\n212\t\t}\n213\t\treturn code\n214\t}\n215\t\n216\tfunc renameFile(oldName, newName string) error {\n217\t\tdir := filepath.Dir(newName)\n218\t\tif err := os.MkdirAll(dir, 0o755); err != nil {\n219\t\t\treturn fmt.Errorf(\"mkdir %s: %w\", dir, err)\n220\t\t}\n221\t\tif verbose {\n222\t\t\tfmt.Fprintf(os.Stderr, \"%s -> %s\\n\", oldName, newName)\n223\t\t}\n224\t\treturn os.Rename(oldName, newName)\n225\t}\n226\t\n227\tfunc makeEditorCmd(editor, path string) *exec.Cmd {\n228\t\treturn exec.Command(editor, path)\n229\t}\n230\t\n231\tfunc processDeletions(original []entry, editedMap map[int]string) int {\n232\t\tcode := 0\n233\t\tfor _, orig := range original {\n234\t\t\tif _, exists := editedMap[orig.id]; exists {\n235\t\t\t\tcontinue\n236\t\t\t}\n237\t\t\tname := orig.name\n238\t\t\tif verbose {\n239\t\t\t\tfmt.Fprintf(os.Stderr, \"delete %s\\n\", name)\n240\t\t\t}\n241\t\t\tif err := os.Remove(name); err != nil {\n242\t\t\t\tfmt.Fprintf(os.Stderr, \"vidir: %v\\n\", err)\n243\t\t\t\tcode = 1\n244\t\t\t}\n245\t\t}\n246\t\treturn code\n247\t}\n248\t"}]},"parent_tool_use_id":null,"session_id":"9e7630c7-a205-448c-bfa0-74c39d48505d","uuid":"4aa74671-7e2d-47bf-9e88-f3da83c84cb8","timestamp":"2026-05-28T17:26:22.273Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5637/cmd/vidir/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd114-vidir R1.1, R1.2, R1.3, R1.4, R2.1, R2.2.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar verbose bool\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run(os.Args[1:]))\n}\n\nfunc run(args []string) int {\n\targs = parseFlags(args)\n\tfiles, err := collectFiles(args)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"vidir: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif len(files) == 0 {\n\t\treturn 0\n\t}\n\toriginal := buildListing(files)\n\tedited, err := editListing(original)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"vidir: %v\\n\", err)\n\t\treturn 1\n\t}\n\treturn applyChanges(original, edited)\n}\n\nfunc parseFlags(args []string) []string {\n\tvar rest []string\n\tfor _, a := range args {\n\t\tswitch a {\n\t\tcase \"-v\", \"--verbose\":\n\t\t\tverbose = true\n\t\tdefault:\n\t\t\trest = append(rest, a)\n\t\t}\n\t}\n\treturn rest\n}\n\nfunc collectFiles(args []string) ([]string, error) {\n\tif !isTerminalStdin() {\n\t\treturn readStdinFiles()\n\t}\n\tdir := \".\"\n\tif len(args) > 0 {\n\t\tdir = args[0]\n\t}\n\treturn readDirFiles(dir)\n}\n\nfunc isTerminalStdin() bool {\n\tfi, err := os.Stdin.Stat()\n\tif err != nil {\n\t\treturn true\n\t}\n\treturn fi.Mode()&os.ModeCharDevice != 0\n}\n\nfunc readStdinFiles() ([]string, error) {\n\tvar files []string\n\tscanner := bufio.NewScanner(os.Stdin)\n\tfor scanner.Scan() {\n\t\tline := scanner.Text()\n\t\tif line != \"\" {\n\t\t\tfiles = append(files, line)\n\t\t}\n\t}\n\treturn files, scanner.Err()\n}\n\nfunc readDirFiles(dir string) ([]string, error) {\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfiles := make([]string, 0, len(entries))\n\tfor _, e := range entries {\n\t\tfiles = append(files, filepath.Join(dir, e.Name()))\n\t}\n\treturn files, nil\n}\n\ntype entry struct {\n\tid   int\n\tname string\n}\n\nfunc buildListing(files []string) []entry {\n\tentries := make([]entry, len(files))\n\tfor i, f := range files {\n\t\tentries[i] = entry{id: i + 1, name: f}\n\t}\n\treturn entries\n}\n\nfunc editListing(entries []entry) ([]entry, error) {\n\ttmp, err := writeTempFile(entries)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer os.Remove(tmp)\n\tif err := runEditor(tmp); err != nil {\n\t\treturn nil, err\n\t}\n\treturn parseListing(tmp)\n}\n\nfunc writeTempFile(entries []entry) (string, error) {\n\tf, err := os.CreateTemp(\"\", \"vidir-*.txt\")\n\tif err != nil {\n\t\treturn \"\", err\n\t}\n\tdefer f.Close()\n\tw := bufio.NewWriter(f)\n\tfor _, e := range entries {\n\t\tfmt.Fprintf(w, \"%d\\t%s\\n\", e.id, e.name)\n\t}\n\tif err := w.Flush(); err != nil {\n\t\treturn \"\", err\n\t}\n\treturn f.Name(), nil\n}\n\nfunc runEditor(path string) error {\n\teditor := os.Getenv(\"EDITOR\")\n\tif editor == \"\" {\n\t\teditor = \"vi\"\n\t}\n\tcmd := makeEditorCmd(editor, path)\n\tcmd.Stdin = os.Stdin\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\treturn cmd.Run()\n}\n\nfunc parseListing(path string) ([]entry, error) {\n\tf, err := os.Open(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer f.Close()\n\tvar entries []entry\n\tscanner := bufio.NewScanner(f)\n\tfor scanner.Scan() {\n\t\te, err := parseLine(scanner.Text())\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif e != nil {\n\t\t\tentries = append(entries, *e)\n\t\t}\n\t}\n\treturn entries, scanner.Err()\n}\n\nfunc parseLine(line string) (*entry, error) {\n\tif strings.TrimSpace(line) == \"\" {\n\t\treturn nil, nil\n\t}\n\tparts := strings.SplitN(line, \"\\t\", 2)\n\tif len(parts) != 2 {\n\t\treturn nil, fmt.Errorf(\"invalid line: %s\", line)\n\t}\n\tid, err := strconv.Atoi(strings.TrimSpace(parts[0]))\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"invalid id: %s\", parts[0])\n\t}\n\treturn &entry{id: id, name: parts[1]}, nil\n}\n\nfunc applyChanges(original, edited []entry) int {\n\teditedMap := make(map[int]string, len(edited))\n\tfor _, e := range edited {\n\t\teditedMap[e.id] = e.name\n\t}\n\tcode := processRenames(original, editedMap)\n\tif c := processDeletions(original, editedMap); c != 0 {\n\t\tcode = c\n\t}\n\treturn code\n}\n\nfunc processRenames(original []entry, editedMap map[int]string) int {\n\tcode := 0\n\tfor _, orig := range original {\n\t\tnewName, exists := editedMap[orig.id]\n\t\tif !exists || newName == orig.name {\n\t\t\tcontinue\n\t\t}\n\t\tif err := renameFile(orig.name, newName); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"vidir: %v\\n\", err)\n\t\t\tcode = 1\n\t\t}\n\t}\n\treturn code\n}\n\nfunc renameFile(oldName, newName string) error {\n\tdir := filepath.Dir(newName)\n\tif err := os.MkdirAll(dir, 0o755); err != nil {\n\t\treturn fmt.Errorf(\"mkdir %s: %w\", dir, err)\n\t}\n\tif verbose {\n\t\tfmt.Fprintf(os.Stderr, \"%s -> %s\\n\", oldName, newName)\n\t}\n\treturn os.Rename(oldName, newName)\n}\n\nfunc makeEditorCmd(editor, path string) *exec.Cmd {\n\treturn exec.Command(editor, path)\n}\n\nfunc processDeletions(original []entry, editedMap map[int]string) int {\n\tcode := 0\n\tfor _, orig := range original {\n\t\tif _, exists := editedMap[orig.id]; exists {\n\t\t\tcontinue\n\t\t}\n\t\tname := orig.name\n\t\tif verbose {\n\t\t\tfmt.Fprintf(os.Stderr, \"delete %s\\n\", name)\n\t\t}\n\t\tif err := os.Remove(name); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"vidir: %v\\n\", err)\n\t\t\tcode = 1\n\t\t}\n\t}\n\treturn code\n}\n","numLines":248,"startLine":1,"totalLines":248}}}
