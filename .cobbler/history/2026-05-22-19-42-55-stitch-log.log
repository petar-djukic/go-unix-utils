, fmt.Errorf(\"invalid byte count: ''\")\n192\t\t}\n193\t\tmult := int64(1)\n194\t\tnum := s\n195\t\tswitch s[len(s)-1] {\n196\t\tcase 'b':\n197\t\t\tmult = 512\n198\t\t\tnum = s[:len(s)-1]\n199\t\tcase 'k':\n200\t\t\tmult = 1024\n201\t\t\tnum = s[:len(s)-1]\n202\t\tcase 'm':\n203\t\t\tmult = 1048576\n204\t\t\tnum = s[:len(s)-1]\n205\t\t}\n206\t\tn := int64(0)\n207\t\tfor _, c := range num {\n208\t\t\tif c < '0' || c > '9' {\n209\t\t\t\treturn 0, fmt.Errorf(\"invalid byte count: '%s'\", s)\n210\t\t\t}\n211\t\t\tn = n*10 + int64(c-'0')\n212\t\t}\n213\t\treturn n * mult, nil\n214\t}\n215\t\n216\tfunc parseTypeString(s string) ([]typeSpec, error) {\n217\t\tvar specs []typeSpec\n218\t\tfor i := 0; i < len(s); i++ {\n219\t\t\tc := s[i]\n220\t\t\tswitch c {\n221\t\t\tcase 'a', 'c':\n222\t\t\t\tspecs = append(specs, typeSpec{format: c, size: 1})\n223\t\t\tcase 'd', 'f', 'o', 'u', 'x':\n224\t\t\t\tsize, advance := parseSize(s[i+1:], c)\n225\t\t\t\tspecs = append(specs, typeSpec{format: c, size: size})\n226\t\t\t\ti += advance\n227\t\t\tdefault:\n228\t\t\t\treturn nil, fmt.Errorf(\"invalid type string '%s'\", s)\n229\t\t\t}\n230\t\t}\n231\t\treturn specs, nil\n232\t}\n233\t\n234\tfunc parseSize(rest string, format byte) (int, int) {\n235\t\tif len(rest) > 0 && rest[0] >= '0' && rest[0] <= '9' {\n236\t\t\tn, j := 0, 0\n237\t\t\tfor j < len(rest) && rest[j] >= '0' && rest[j] <= '9' {\n238\t\t\t\tn = n*10 + int(rest[j]-'0')\n239\t\t\t\tj++\n240\t\t\t}\n241\t\t\tif n == 0 {\n242\t\t\t\tn = defaultSize(format)\n243\t\t\t}\n244\t\t\treturn n, j\n245\t\t}\n246\t\tif len(rest) > 0 {\n247\t\t\tswitch rest[0] {\n248\t\t\tcase 'C':\n249\t\t\t\treturn 1, 1\n250\t\t\tcase 'S':\n251\t\t\t\treturn 2, 1\n252\t\t\tcase 'I':\n253\t\t\t\treturn 4, 1\n254\t\t\tcase 'L':\n255\t\t\t\treturn 8, 1\n256\t\t\t}\n257\t\t}\n258\t\treturn defaultSize(format), 0\n259\t}\n260\t\n261\tfunc defaultSize(format byte) int {\n262\t\tif format == 'f' {\n263\t\t\treturn 8\n264\t\t}\n265\t\treturn 4\n266\t}\n267\t