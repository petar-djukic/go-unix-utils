ults(t, args, goRes, refRes)\n119\t\t})\n120\t\n121\t\tt.Run(\"parents_partial_existing\", func(t *testing.T) {\n122\t\t\tgoDir := t.TempDir()\n123\t\t\trefDir := t.TempDir()\n124\t\t\tos.Mkdir(filepath.Join(goDir, \"a\"), 0o755)\n125\t\t\tos.Mkdir(filepath.Join(refDir, \"a\"), 0o755)\n126\t\t\targs := []string{\"-p\", \"a/b/c\"}\n127\t\t\tgoRes := runBin(t, goBin, args, goDir)\n128\t\t\trefRes := runBin(t, refBin, args, refDir)\n129\t\t\tcompareResults(t, args, goRes, refRes)\n130\t\t})\n131\t\n132\t\tt.Run(\"parents_long_flag\", func(t *testing.T) {\n133\t\t\trunCreationTest(t, goBin, refBin, []string{\"--parents\", \"x/y/z\"})\n134\t\t})\n135\t\n136\t\tt.Run(\"parents_verbose\", func(t *testing.T) {\n137\t\t\trunCreationTest(t, goBin, refBin, []string{\"-p\", \"-v\", \"d/e/f\"})\n138\t\t})\n139\t\n140\t\tt.Run(\"parents_verbose_combined\", func(t *testing.T) {\n141\t\t\trunCreationTest(t, goBin, refBin, []string{\"-pv\", \"g/h/i\"})\n142\t\t})\n143\t\n144\t\tt.Run(\"parents_multiple\", func(t *testing.T) {\n145\t\t\trunCreationTest(t, goBin, refBin, []string{\"-p\", \"m1/m2\", \"n1/n2\"})\n146\t\t})\n147\t\n148\t\tt.Run(\"verbose_partial_failure\", func(t *testing.T) {\n149\t\t\tgoDir := t.TempDir()\n150\t\t\trefDir := t.TempDir()\n151\t\t\tos.Mkdir(filepath.Join(goDir, \"existdir\"), 0o755)\n152\t\t\tos.Mkdir(filepath.Join(refDir, \"existdir\"), 0o755)\n153\t\t\targs := []string{\"-v\", \"existdir\", \"newdir\"}\n154\t\t\tgoRes := runBin(t, goBin, args, goDir)\n155\t\t\trefRes := runBin(t, refBin, args, refDir)\n156\t\t\tcompareResults(t, args, goRes, refRes)\n157\t\t})\n158\t\n159\t\tt.Run(\"mode_octal\", func(t *testing.T) {\n160\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"0755\", \"mdir\"})\n161\t\t})\n162\t\n163\t\tt.Run(\"mode_octal_no_leading_zero\", func(t *testing.T) {\n164\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"755\", \"mdir2\"})\n165\t\t})\n166\t\n167\t\tt.Run(\"mode_octal_restrictive\", func(t *testing.T) {\n168\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"0700\", \"mdir3\"})\n169\t\t})\n170\t\n171\t\tt.Run(\"mode_long_flag\", func(t *testing.T) {\n172\t\t\trunCreationTest(t, goBin, refBin, []string{\"--mode=0755\", \"mdir4\"})\n173\t\t})\n174\t\n175\t\tt.Run(\"mode_long_flag_separate\", func(t *testing.T) {\n176\t\t\trunCreationTest(t, goBin, refBin, []string{\"--mode\", \"0755\", \"mdir5\"})\n177\t\t})\n178\t\n179\t\tt.Run(\"mode_combined_short\", func(t *testing.T) {\n180\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m0755\", \"mdir6\"})\n181\t\t})\n182\t\n183\t\tt.Run(\"mode_verbose\", func(t *testing.T) {\n184\t\t\trunCreationTest(t, goBin, refBin, []string{\"-v\", \"-m\", \"0700\", \"mvdir\"})\n185\t\t})\n186\t\n187\t\tt.Run(\"mode_combined_vm\", func(t *testing.T) {\n188\t\t\trunCreationTest(t, goBin, refBin, []string{\"-vm\", \"0700\", \"vmdir\"})\n189\t\t})\n190\t\n191\t\tt.Run(\"mode_parents_nested\", func(t *testing.T) {\n192\t\t\trunCreationTest(t, goBin, refBin, []string{\"-p\", \"-m\", \"0700\", \"pm/pn/po\"})\n193\t\t})\n194\t\n195\t\tt.Run(\"mode_parents_verbose\", func(t *testing.T) {\n196\t\t\trunCreationTest(t, goBin, refBin, []string{\"-pvm\", \"0700\", \"pvm/pvn/pvo\"})\n197\t\t})\n198\t\n199\t\tt.Run(\"mode_symbolic_urwx\", func(t *testing.T) {\n200\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"u=rwx,go=rx\", \"sdir\"})\n201\t\t})\n202\t\n203\t\tt.Run(\"mode_invalid\", func(t *testing.T) {\n204\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n205\t\t\t\t{\n206\t\t\t\t\tName:     \"bogus_mode\",\n207\t\t\t\t\tArgs:     []string{\"-m\", \"bogus\", \"dir\"},\n208\t\t\t\t\tExitCode: 1,\n209\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n210\t\t\t\t\t\tnormalizeBinaryName,\n211\t\t\t\t\t},\n212\t\t\t\t},\n213\t\t\t})\n214\t\t})\n215\t\n216\t\tt.Run(\"mode_missing_arg\", func(t *testing.T) {\n217\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n218\t\t\t\t{\n219\t\t\t\t\tName:     \"m_no_arg\",\n220\t\t\t\t\tArgs:     []string{\"-m\"},\n221\t\t\t\t\tExitCode: 1,\n222\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n223\t\t\t\t\t\tnormalizeBinaryName,\n224\t\t\t\t\t},\n225\t\t\t\t},\n226\t\t\t})\n227\t\t})\n228\t}\n229\t\n230\tfunc TestCreationPermissions(t *testing.T) {\n231\t\tgoBin := testutils.BuildBinary(t, \".\")\n232\t\trefBin, err := exec.LookPath(\"gmkdir\")\n233\t\tif err != nil {\n234\t\t\tt.Skip(\"reference binary not found\")\n235\t\t}\n236\t\n237\t\tgoDir := t.TempDir()\n238\t\trefDir := t.TempDir()\n239\t\targs := []string{\"permdir\"}\n240\t\trunBin(t, goBin, args, goDir)\n241\t\trunBin(t, refBin, args, refDir)\n242\t\n243\t\tgoInfo, err := os.Stat(filepath.Join(goDir, \"permdir\"))\n244\t\tif err != nil {\n245\t\t\tt.Fatalf(\"go binary did not create directory: %v\", err)\n246\t\t}\n247\t\trefInfo, err := os.Stat(filepath.Join(refDir, \"permdir\"))\n248\t\tif err != nil {\n249\t\t\tt.Fatalf(\"ref binary did not create directory: %v\", err)\n250\t\t}\n251\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n252\t\t\tt.Fatalf(\"permission mismatch: go=%v ref=%v\",\n253\t\t\t\tgoInfo.Mode().Perm(), refInfo.Mode().Perm())\n254\t\t}\n255\t}\n256\t\n257\tfunc TestModePermissions(t *testing.T) {\n258\t\tgoBin := testutils.BuildBinary(t, \".\")\n259\t\trefBin, err := exec.LookPath(\"gmkdir\")\n260\t\tif err != nil {\n261\t\t\tt.Skip(\"reference binary not found\")\n262\t\t}\n263\t\n264\t\ttests := []struct {\n265\t\t\tname string\n266\t\t\targs []string\n267\t\t\tdirs []string\n268\t\t}{\n269\t\t\t{\"octal_0755\", []string{\"-m\", \"0755\", \"d1\"}, []string{\"d1\"}},\n270\t\t\t{\"octal_0700\", []string{\"-m\", \"0700\", \"d2\"}, []string{\"d2\"}},\n271\t\t\t{\"octal_0777\", []string{\"-m\", \"0777\", \"d3\"}, []string{\"d3\"}},\n272\t\t\t{\"octal_0750\", []string{\"-m\", \"0750\", \"d4\"}, []string{\"d4\"}},\n273\t\t\t{\"symbolic_urwx_gorx\", []string{\"-m\", \"u=rwx,go=rx\", \"d5\"}, []string{\"d5\"}},\n274\t\t\t{\"symbolic_arwx\", []string{\"-m\", \"a=rwx\", \"d6\"}, []string{\"d6\"}},\n275\t\t}\n276\t\n277\t\tfor _, tt := range tests {\n278\t\t\tt.Run(tt.name, func(t *testing.T) {\n279\t\t\t\tgoDir := t.TempDir()\n280\t\t\t\trefDir := t.TempDir()\n281\t\t\t\trunBin(t, goBin, tt.args, goDir)\n282\t\t\t\trunBin(t, refBin, tt.args, refDir)\n283\t\t\t\tfor _, sub := range tt.dirs {\n284\t\t\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, sub))\n285\t\t\t\t\tif err != nil {\n286\t\t\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", sub, err)\n287\t\t\t\t\t}\n288\t\t\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, sub))\n289\t\t\t\t\tif err != nil {\n290\t\t\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", sub, err)\n291\t\t\t\t\t}\n292\t\t\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n293\t\t\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n294\t\t\t\t\t\t\tsub, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n295\t\t\t\t\t}\n296\t\t\t\t}\n297\t\t\t})\n298\t\t}\n299\t}\n300\t\n301\tfunc TestModeParentsPermissions(t *testing.T) {\n302\t\tgoBin := testutils.BuildBinary(t, \".\")\n303\t\trefBin, err := exec.LookPath(\"gmkdir\")\n304\t\tif err != nil {\n305\t\t\tt.Skip(\"reference binary not found\")\n306\t\t}\n307\t\n308\t\tgoDir := t.TempDir()\n309\t\trefDir := t.TempDir()\n310\t\targs := []string{\"-p\", \"-m\", \"0700\", \"a/b/c\"}\n311\t\trunBin(t, goBin, args, goDir)\n312\t\trunBin(t, refBin, args, refDir)\n313\t\n314\t\tfor _, sub := range []string{\"a\", \"a/b\", \"a/b/c\"} {\n315\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, sub))\n316\t\t\tif err != nil {\n317\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", sub, err)\n318\t\t\t}\n319\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, sub))\n320\t\t\tif err != nil {\n321\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", sub, err)\n322\t\t\t}\n323\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n324\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n325\t\t\t\t\tsub, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n326\t\t\t}\n327\t\t}\n328\t}\n329\t\n330\tfunc runCreationTest(t *testing.T, goBin, refBin string, args []string) {\n331\t\tt.Helper()\n332\t\tgoDir := t.TempDir()\n333\t\trefDir := t.TempDir()\n334\t\tgoRes := runBin(t, goBin, args, goDir)\n335\t\trefRes := runBin(t, refBin, args, refDir)\n336\t\tcompareResults(t, args, goRes, refRes)\n337\t}\n338\t\n339\ttype binResult struct {\n340\t\tstdout   []byte\n341\t\tstderr   []byte\n342\t\texitCode int\n343\t}\n344\t\n345\tfunc runBin(t *testing.T, binary string, args []string, workDir string) binResult {\n346\t\tt.Helper()\n347\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n348\t\tdefer cancel()\n349\t\tcmd := exec.CommandContext(ctx, binary, args...)\n350\t\tcmd.Dir = workDir\n351\t\tcmd.Env = append(os.Environ(), \"LC_ALL=C\")\n352\t\tvar stdout, stderr bytes.Buffer\n353\t\tcmd.Stdout = &stdout\n354\t\tcmd.Stderr = &stderr\n355\t\terr := cmd.Run()\n356\t\tif ctx.Err() == context.DeadlineExceeded {\n357\t\t\tt.Fatalf(\"binary %s timed out\", binary)\n358\t\t}\n359\t\texitCode := 0\n360\t\tif err != nil {\n361\t\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n362\t\t\t\texitCode = exitErr.ExitCode()\n363\t\t\t} else {\n364\t\t\t\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n365\t\t\t}\n366\t\t}\n367\t\treturn binResult{stdout: stdout.Bytes(), stderr: stderr.Bytes(), exitCode: exitCode}\n368\t}\n369\t\n370\tfunc compareResults(t *testing.T, args []string, goRes, refRes binResult) {\n371\t\tt.Helper()\n372\t\tgoStdout := normalizeBinaryName(goRes.stdout)\n373\t\trefStdout := normalizeBinaryName(refRes.stdout)\n374\t\tgoStderr := normalizeBinaryName(goRes.stderr)\n375\t\trefStderr := normalizeBinaryName(refRes.stderr)\n376\t\n377\t\tif !bytes.Equal(goStdout, refStdout) ||\n378\t\t\t!bytes.Equal(goStderr, refStderr) ||\n379\t\t\tgoRes.exitCode != refRes.exitCode {\n380\t\t\tt.Fatalf(\"divergence detected\\n\"+\n381\t\t\t\t\"  args:       %v\\n\"+\n382\t\t\t\t\"  ref stdout: %q\\n\"+\n383\t\t\t\t\"  go  stdout: %q\\n\"+\n384\t\t\t\t\"  ref stderr: %q\\n\"+\n385\t\t\t\t\"  go  stderr: %q\\n\"+\n386\t\t\t\t\"  ref exit:   %d\\n\"+\n387\t\t\t\t\"  go  exit:   %d\\n\",\n388\t\t\t\targs, refStdout, goStdout, refStderr, goStderr, refRes.exitCode, goRes.exitCode)\n389\t\t}\n390\t}\n391\t\n392\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mkdir\\b`)\n393\t\n394\tfunc normalizeBinaryName(b []byte) []byte {\n395\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mkdir\"))\n396\t}\n397\t\n398\tfunc TestParentsPermissions(t *testing.T) {\n399\t\tgoBin := testutils.BuildBinary(t, \".\")\n400\t\trefBin, err := exec.LookPath(\"gmkdir\")\n401\t\tif err != nil {\n402\t\t\tt.Skip(\"reference binary not found\")\n403\t\t}\n404\t\n405\t\tgoDir := t.TempDir()\n406\t\trefDir := t.TempDir()\n407\t\targs := []string{\"-p\", \"a/b/c\"}\n408\t\trunBin(t, goBin, args, goDir)\n409\t\trunBin(t, refBin, args, refDir)\n410\t\n411\t\tfor _, sub := range []string{\"a\", \"a/b\", \"a/b/c\"} {\n412\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, sub))\n413\t\t\tif err != nil {\n414\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", sub, err)\n415\t\t\t}\n416\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, sub))\n417\t\t\tif err != nil {\n418\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", sub, err)\n419\t\t\t}\n420\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n421\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n422\t\t\t\t\tsub, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n423\t\t\t}\n424\t\t}\n425\t}\n426\t\n427\tfunc TestUnrecognizedOption(t *testing.T) {\n428\t\tgoBin := testutils.BuildBinary(t, \".\")\n429\t\trefBin, err := exec.LookPath(\"gmkdir\")\n430\t\tif err != nil {\n431\t\t\tt.Skip(\"reference binary not found\")\n432\t\t}\n433\t\n434\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n435\t\t\t{\n436\t\t\t\tName:     \"bad_long_option\",\n437\t\t\t\tArgs:     []string{\"--bad