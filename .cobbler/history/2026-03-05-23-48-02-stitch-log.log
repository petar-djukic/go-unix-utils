{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rurh31gPCPJQ8wRbbc5HX7","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package main implements the cmd/ls binary.\n     5→// Lists directory contents with support for filtering, sorting, and\n     6→// multi-column or single-column output formatting.\n     7→//\n     8→// Implements: prd008-ls R1-R7 (core flags), prd010-ls-extended R2 (sort), R3 (time selection), R4 (time-style)\n     9→// Architecture: docs/ARCHITECTURE.yaml § cmd/\n    10→package main\n    11→\n    12→import (\n    13→\t\"fmt\"\n    14→\t\"os\"\n    15→\t\"os/signal\"\n    16→\t\"strings\"\n    17→\t\"syscall\"\n    18→\t\"time\"\n    19→\n    20→\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n    21→\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n    22→)\n    23→\n    24→// progName is the program name used in error diagnostics (R6).\n    25→const progName = \"ls\"\n    26→\n    27→// defaultTermWidth is the terminal width used when stdout is not a TTY\n    28→// or when terminal width cannot be determined (D1).\n    29→const defaultTermWidth = 80\n    30→\n    31→// filterMode determines which entries are included in the listing.\n    32→type filterMode int\n    33→\n    34→const (\n    35→\tfilterDefault    filterMode = iota // hide entries starting with '.' (R1.4)\n    36→\tfilterAll                         // -a: show all including '.' and '..' (R3.1)\n    37→\tfilterAlmostAll                   // -A: show all except '.' and '..' (R3.2)\n    38→)\n    39→\n    40→// timeStyle controls the timestamp format in long listing mode.\n    41→type timeStyle int\n    42→\n    43→const (\n    44→\ttimeStyleDefault timeStyle = iota // default ls format (Jan _2 15:04 or Jan _2  2006)\n    45→\ttimeStyleFullISO                  // --time-style=full-iso\n    46→\ttimeStyleLongISO                  // --time-style=long-iso\n    47→\ttimeStyleISO                      // --time-style=iso\n    48→\ttimeStyleLocale                   // --time-style=locale (same as default under LC_ALL=C, DD6)\n    49→)\n    50→\n    51→// outputMode determines the output format.\n    52→type outputMode int\n    53→\n    54→const (\n    55→\toutputAuto    outputMode = iota // multi-column on TTY, single-column otherwise (R5)\n    56→\toutputSingle                   // -1: force single-column (R5)\n    57→\toutputColumns                  // -C: force multi-column (R5)\n    58→)\n    59→\n    60→// lsConfig holds the resolved options for a single ls invocation.\n    61→type lsConfig struct {\n    62→\tfilter    filterMode\n    63→\tsortBy    sortMode\n    64→\treverse   bool // -r/--reverse: reverse sort order (R2)\n    65→\toutput    outputMode\n    66→\ttimeField timeField // -c, -u, --time=WORD: timestamp selection (R3)\n    67→\ttimeStyle timeStyle // --time-style=STYLE, --full-time: timestamp format (R4)\n    68→}\n    69→\n    70→// fileEntry holds the name and optional metadata for a listed entry.\n    71→type fileEntry struct {\n    72→\tname string\n    73→\tinfo *sys.FileInfo\n    74→}\n    75→\n    76→func main() {\n    77→\t// R7.1: SIGPIPE handler so piping to head exits cleanly.\n    78→\tsigCh := make(chan os.Signal, 1)\n    79→\tsignal.Notify(sigCh, syscall.SIGPIPE)\n    80→\tgo func() {\n    81→\t\t<-sigCh\n    82→\t\tos.Exit(0)\n    83→\t}()\n    84→\n    85→\tcfg, operands, parseErr := parseFlags()\n    86→\tif parseErr != nil {\n    87→\t\t// R6: exit 2 for invalid options.\n    88→\t\tfmt.Fprintf(os.Stderr, \"%s: %v\\n\", progName, parseErr)\n    89→\t\tos.Exit(2)\n    90→\t}\n    91→\n    92→\t// R1: default to current directory when no operands.\n    93→\tif len(operands) == 0 {\n    94→\t\toperands = []string{\".\"}\n    95→\t}\n    96→\n    97→\texitCode := 0\n    98→\tvar fileOps []fileEntry\n    99→\tvar dirOps []fileEntry\n   100→\n   101→\t// R2: classify operands into files and directories.\n   102→\tfor _, op := range operands {\n   103→\t\tfi, err := sys.Lstat(op)\n   104→\t\tif err != nil {\n   105→\t\t\t// R6: print error, set exit code, continue.\n   106→\t\t\tfmt.Fprintf(os.Stderr, \"%s: cannot access '%s': %v\\n\", progName, op, sysErr(err))\n   107→\t\t\texitCode = 2\n   108→\t\t\tcontinue\n   109→\t\t}\n   110→\t\tentry := fileEntry{name: op, info: fi}\n   111→\t\tif fi.Mode.IsDir() {\n   112→\t\t\tdirOps = append(dirOps, entry)\n   113→\t\t} else {\n   114→\t\t\tfileOps = append(fileOps, entry)\n   115→\t\t}\n   116→\t}\n   117→\n   118→\t// R2: directory header when more than one operand is given.\n   119→\tshowHeader := len(operands) > 1\n   120→\tneedNewline := false\n   121→\n   122→\t// R2: list file operands first, sorted.\n   123→\tif len(fileOps) > 0 {\n   124→\t\tsortEntries(fileOps, cfg)\n   125→\t\tprintEntries(entryNames(fileOps), cfg)\n   126→\t\tneedNewline = true\n   127→\t}\n   128→\n   129→\t// R2: list directory operands, sorted.\n   130→\tsortEntries(dirOps, cfg)\n   131→\tfor _, de := range dirOps {\n   132→\t\tif needNewline {\n   133→\t\t\tfmt.Println()\n   134→\t\t}\n   135→\t\tif showHeader {\n   136→\t\t\tfmt.Printf(\"%s:\\n\", de.name)\n   137→\t\t}\n   138→\t\tentries, err := readDir(de.name, cfg)\n   139→\t\tif err != nil {\n   140→\t\t\tfmt.Fprintf(os.Stderr, \"%s: cannot open directory '%s': %v\\n\",\n   141→\t\t\t\tprogName, de.name, sysErr(err))\n   142→\t\t\texitCode = 2\n   143→\t\t\tneedNewline = true\n   144→\t\t\tcontinue\n   145→\t\t}\n   146→\t\tsortEntries(entries, cfg)\n   147→\t\tprintEntries(entryNames(entries), cfg)\n   148→\t\tneedNewline = true\n   149→\t}\n   150→\n   151→\tos.Exit(exitCode)\n   152→}\n   153→\n   154→// parseFlags parses command-line arguments, supporting combined short flags\n   155→// (e.g., -aSr) and long flags (--reverse, --sort=none, --time=WORD,\n   156→// --time-style=STYLE, --full-time). Returns the resolved config, operand\n   157→// paths, and any parse error. Follows the manual parsing pattern established\n   158→// in cmd/wc.\n   159→func parseFlags() (lsConfig, []string, error) {\n   160→\tcfg := lsConfig{}\n   161→\tvar operands []string\n   162→\n   163→\targs := os.Args[1:]\n   164→\tfor i := 0; i < len(args); i++ {\n   165→\t\targ := args[i]\n   166→\n   167→\t\t// \"--\" terminates flag parsing.\n   168→\t\tif arg == \"--\" {\n   169→\t\t\toperands = append(operands, args[i+1:]...)\n   170→\t\t\tbreak\n   171→\t\t}\n   172→\n   173→\t\t// Long flags.\n   174→\t\tif strings.HasPrefix(arg, \"--\") {\n   175→\t\t\tswitch {\n   176→\t\t\tcase arg == \"--reverse\":\n   177→\t\t\t\tcfg.reverse = true\n   178→\t\t\tcase arg == \"--full-time\":\n   179→\t\t\t\t// R4: --full-time is an alias for --time-style=full-iso.\n   180→\t\t\t\tcfg.timeStyle = timeStyleFullISO\n   181→\t\t\tcase arg == \"--sort=none\":\n   182→\t\t\t\t// R1: --sort=none is an alias for -U.\n   183→\t\t\t\tcfg.sortBy = sortNone\n   184→\t\t\tcase strings.HasPrefix(arg, \"--sort=\"):\n   185→\t\t\t\treturn lsConfig{}, nil, fmt.Errorf(\"invalid argument '%s' for '--sort'\", arg[len(\"--sort=\"):])\n   186→\t\t\tcase strings.HasPrefix(arg, \"--time-style=\"):\n   187→\t\t\t\tts, err := parseTimeStyle(arg[len(\"--time-style=\"):])\n   188→\t\t\t\tif err != nil {\n   189→\t\t\t\t\treturn lsConfig{}, nil, err\n   190→\t\t\t\t}\n   191→\t\t\t\tcfg.timeStyle = ts\n   192→\t\t\tcase strings.HasPrefix(arg, \"--time=\"):\n   193→\t\t\t\ttf, err := parseTimeWord(arg[len(\"--time=\"):])\n   194→\t\t\t\tif err != nil {\n   195→\t\t\t\t\treturn lsConfig{}, nil, err\n   196→\t\t\t\t}\n   197→\t\t\t\tcfg.timeField = tf\n   198→\t\t\tdefault:\n   199→\t\t\t\treturn lsConfig{}, nil, fmt.Errorf(\"unrecognized option '%s'\", arg)\n   200→\t\t\t}\n   201→\t\t\tcontinue\n   202→\t\t}\n   203→\n   204→\t\t// Short flags (may be combined: -aSr).\n   205→\t\tif len(arg) > 1 && arg[0] == '-' {\n   206→\t\t\tfor _, ch := range arg[1:] {\n   207→\t\t\t\tswitch ch {\n   208→\t\t\t\tcase 'a':\n   209→\t\t\t\t\t// R3.1, R3.4: last of -a/-A wins.\n   210→\t\t\t\t\tcfg.filter = filterAll\n   211→\t\t\t\tcase 'A':\n   212→\t\t\t\t\t// R3.2, R3.4: last of -a/-A wins.\n   213→\t\t\t\t\tcfg.filter = filterAlmostAll\n   214→\t\t\t\tcase 'r':\n   215→\t\t\t\t\tcfg.reverse = true\n   216→\t\t\t\tcase 't':\n   217→\t\t\t\t\t// R2.6: last sort flag wins.\n   218→\t\t\t\t\tcfg.sortBy = sortByTime\n   219→\t\t\t\tcase 'S':\n   220→\t\t\t\t\tcfg.sortBy = sortBySize\n   221→\t\t\t\tcase 'X':\n   222→\t\t\t\t\tcfg.sortBy = sortByExtension\n   223→\t\t\t\tcase 'U':\n   224→\t\t\t\t\t// R2.4: directory order, no sorting.\n   225→\t\t\t\t\tcfg.sortBy = sortNone\n   226→\t\t\t\tcase 'c':\n   227→\t\t\t\t\t// R3: select status change time (ctime).\n   228→\t\t\t\t\tcfg.timeField = timeChanged\n   229→\t\t\t\tcase 'u':\n   230→\t\t\t\t\t// R3: select access time (atime).\n   231→\t\t\t\t\tcfg.timeField = timeAccessed\n   232→\t\t\t\tcase '1':\n   233→\t\t\t\t\tcfg.output = outputSingle\n   234→\t\t\t\tcase 'C':\n   235→\t\t\t\t\tcfg.output = outputColumns\n   236→\t\t\t\tdefault:\n   237→\t\t\t\t\treturn lsConfig{}, nil, fmt.Errorf(\"invalid option -- '%c'\", ch)\n   238→\t\t\t\t}\n   239→\t\t\t}\n   240→\t\t\tcontinue\n   241→\t\t}\n   242→\n   243→\t\toperands = append(operands, arg)\n   244→\t}\n   245→\n   246→\treturn cfg, operands, nil\n   247→}\n   248→\n   249→// parseTimeStyle maps a --time-style=STYLE argument to a timeStyle value.\n   250→func parseTimeStyle(style string) (timeStyle, error) {\n   251→\tswitch style {\n   252→\tcase \"full-iso\":\n   253→\t\treturn timeStyleFullISO, nil\n   254→\tcase \"long-iso\":\n   255→\t\treturn timeStyleLongISO, nil\n   256→\tcase \"iso\":\n   257→\t\treturn timeStyleISO, nil\n   258→\tcase \"locale\":\n   259→\t\treturn timeStyleLocale, nil\n   260→\tdefault:\n   261→\t\treturn 0, fmt.Errorf(\"invalid argument '%s' for '--time-style'\", style)\n   262→\t}\n   263→}\n   264→\n   265→// parseTimeWord maps a --time=WORD argument to a timeField value.\n   266→func parseTimeWord(word string) (timeField, error) {\n   267→\tswitch word {\n   268→\tcase \"mtime\", \"modification\":\n   269→\t\treturn timeModified, nil\n   270→\tcase \"ctime\", \"status\":\n   271→\t\treturn timeChanged, nil\n   272→\tcase \"atime\", \"access\", \"use\":\n   273→\t\treturn timeAccessed, nil\n   274→\tdefault:\n   275→\t\treturn 0, fmt.Errorf(\"invalid argument '%s' for '--time'\", word)\n   276→\t}\n   277→}\n   278→\n   279→// readDir reads directory entries and applies the active filter.\n   280→// For filterAll, \".\" and \"..\" are prepended to the listing since\n   281→// os.ReadDir omits them.\n   282→func readDir(dirPath string, cfg lsConfig) ([]fileEntry, error) {\n   283→\tdirEntries, err := os.ReadDir(dirPath)\n   284→\tif err != nil {\n   285→\t\treturn nil, err\n   286→\t}\n   287→\n   288→\tneedStat := cfg.sortBy == sortByTime || cfg.sortBy == sortBySize\n   289→\tvar entries []fileEntry\n   290→\n   291→\t// R3.1: -a includes \".\" and \"..\" which os.ReadDir omits.\n   292→\tif cfg.filter == filterAll {\n   293→\t\tentries = append(entries, makeEntry(dirPath, \".\", needStat))\n   294→\t\tentries = append(entries, makeEntry(dirPath, \"..\", needStat))\n   295→\t}\n   296→\n   297→\tfor _, de := range dirEntries {\n   298→\t\tname := de.Name()\n   299→\n   300→\t\t// R1.4: default filter hides entries starting with '.'.\n   301→\t\tif cfg.filter == filterDefault && strings.HasPrefix(name, \".\") {\n   302→\t\t\tcontinue\n   303→\t\t}\n   304→\n   305→\t\tentries = append(entries, makeEntry(dirPath, name, needStat))\n   306→\t}\n   307→\n   308→\treturn entries, nil\n   309→}\n   310→\n   311→// makeEntry creates a fileEntry, stat'ing the file when needStat is true\n   312→// to obtain metadata for time or size sorting.\n   313→func makeEntry(dirPath, name string, needStat bool) fileEntry {\n   314→\tentry := fileEntry{name: name}\n   315→\tif needStat {\n   316→\t\tpath := joinPath(dirPath, name)\n   317→\t\tfi, err := sys.Lstat(path)\n   318→\t\tif err == nil {\n   319→\t\t\tentry.info = fi\n   320→\t\t}\n   321→\t}\n   322→\treturn entry\n   323→}\n   324→\n   325→// joinPath constructs a child path preserving the parent directory's prefix\n   326→// form. Avoids filepath.Join which cleans \"..\" components, breaking stat of\n   327→// \"dir/..\" entries needed for -a.\n   328→func joinPath(dir, name string) string {\n   329→\tif len(dir) > 0 && dir[len(dir)-1] == '/' {\n   330→\t\treturn dir + name\n   331→\t}\n   332→\treturn dir + \"/\" + name\n   333→}\n   334→\n   335→// entryNames extracts the names from a slice of file entries.\n   336→func entryNames(entries []fileEntry) []string {\n   337→\tnames := make([]string, len(entries))\n   338→\tfor i, e := range entries {\n   339→\t\tnames[i] = e.name\n   340→\t}\n   341→\treturn names\n   342→}\n   343→\n   344→// printEntries outputs names in single-column or multi-column format\n   345→// depending on the active output mode and whether stdout is a TTY.\n   346→func printEntries(names []string, cfg lsConfig) {\n   347→\tif len(names) == 0 {\n   348→\t\treturn\n   349→\t}\n   350→\n   351→\tif useSingleColumn(cfg) {\n   352→\t\tfor _, name := range names {\n   353→\t\t\tfmt.Println(name)\n   354→\t\t}\n   355→\t\treturn\n   356→\t}\n   357→\n   358→\t// R5: multi-column output using pkg/format.\n   359→\twidth := termWidth()\n   360→\tgrid := format.Columns(names, width)\n   361→\tfor _, row := range grid {\n   362→\t\tline := strings.Join(row, \"  \")\n   363→\t\tfmt.Println(strings.TrimRight(line, \" \"))\n   364→\t}\n   365→}\n   366→\n   367→// useSingleColumn returns true when output should be one entry per line.\n   368→func useSingleColumn(cfg lsConfig) bool {\n   369→\tswitch cfg.output {\n   370→\tcase outputSingle:\n   371→\t\treturn true\n   372→\tcase outputColumns:\n   373→\t\treturn false\n   374→\tdefault:\n   375→\t\t// R5: auto-detect based on stdout.\n   376→\t\treturn !isStdoutTTY()\n   377→\t}\n   378→}\n   379→\n   380→// isStdoutTTY reports whether stdout is connected to a terminal (D4).\n   381→func isStdoutTTY() bool {\n   382→\tfi, err := os.Stdout.Stat()\n   383→\tif err != nil {\n   384→\t\treturn false\n   385→\t}\n   386→\treturn fi.Mode()&os.ModeCharDevice != 0\n   387→}\n   388→\n   389→// termWidth returns the current terminal column count, falling back to\n   390→// defaultTermWidth when the width cannot be determined (D1).\n   391→func termWidth() int {\n   392→\tw, err := sys.TerminalWidth()\n   393→\tif err != nil || w <= 0 {\n   394→\t\treturn defaultTermWidth\n   395→\t}\n   396→\treturn w\n   397→}\n   398→\n   399→// sysErr extracts the underlying system error from an os.PathError for\n   400→// cleaner diagnostic messages matching GNU ls format.\n   401→func sysErr(err error) error {\n   402→\tif pe, ok := err.(*os.PathError); ok { //nolint:errorlint\n   403→\t\treturn pe.Err\n   404→\t}\n   405→\treturn err\n   406→}\n   407→\n   408→// formatTime formats a timestamp according to the active time style.\n   409→// R4: --time-style controls the format in long listing mode. The default\n   410→// and locale styles produce the same output under LC_ALL=C (DD6).\n   411→func formatTime(t time.Time, style timeStyle, now time.Time) string {\n   412→\tsixMonths := 6 * 30 * 24 * time.Hour\n   413→\trecent := !t.After(now) && now.Sub(t) < sixMonths\n   414→\n   415→\tswitch style {\n   416→\tcase timeStyleFullISO:\n   417→\t\treturn t.Format(\"2006-01-02 15:04:05.000000000 -0700\")\n   418→\tcase timeStyleLongISO:\n   419→\t\treturn t.Format(\"2006-01-02 15:04\")\n   420→\tcase timeStyleISO:\n   421→\t\tif recent {\n   422→\t\t\treturn t.Format(\"01-02 15:04\")\n   423→\t\t}\n   424→\t\treturn t.Format(\"2006-01-02 \")\n   425→\tdefault:\n   426→\t\t// timeStyleDefault and timeStyleLocale: same format under LC_ALL=C (DD6).\n   427→\t\tif recent {\n   428→\t\t\treturn t.Format(\"Jan _2 15:04\")\n   429→\t\t}\n   430→\t\treturn t.Format(\"Jan _2  2006\")\n   431→\t}\n   432→}\n   433→"}]},"parent_tool_use_id":null,"session_id":"8ab6c3f3-6c03-4d5b-9d8b-ea4468f3b690","uuid":"23f9aabe-2174-4d88-b286-321e0381de6f","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/310/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package main implements the cmd/ls binary.\n// Lists directory contents with support for filtering, sorting, and\n// multi-column or single-column output formatting.\n//\n// Implements: prd008-ls R1-R7 (core flags), prd010-ls-extended R2 (sort), R3 (time selection), R4 (time-style)\n// Architecture: docs/ARCHITECTURE.yaml § cmd/\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/signal\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\n// progName is the program name used in error diagnostics (R6).\nconst progName = \"ls\"\n\n// defaultTermWidth is the terminal width used when stdout is not a TTY\n// or when terminal width cannot be determined (D1).\nconst defaultTermWidth = 80\n\n// filterMode determines which entries are included in the listing.\ntype filterMode int\n\nconst (\n\tfilterDefault    filterMode = iota // hide entries starting with '.' (R1.4)\n\tfilterAll                         // -a: show all including '.' and '..' (R3.1)\n\tfilterAlmostAll                   // -A: show all except '.' and '..' (R3.2)\n)\n\n// timeStyle controls the timestamp format in long listing mode.\ntype timeStyle int\n\nconst (\n\ttimeStyleDefault timeStyle = iota // default ls format (Jan _2 15:04 or Jan _2  2006)\n\ttimeStyleFullISO                  // --time-style=full-iso\n\ttimeStyleLongISO                  // --time-style=long-iso\n\ttimeStyleISO                      // --time-style=iso\n\ttimeStyleLocale                   // --time-style=locale (same as default under LC_ALL=C, DD6)\n)\n\n// outputMode determines the output format.\ntype outputMode int\n\nconst (\n\toutputAuto    outputMode = iota // multi-column on TTY, single-column otherwise (R5)\n\toutputSingle                   // -1: force single-column (R5)\n\toutputColumns                  // -C: force multi-column (R5)\n)\n\n// lsConfig holds the resolved options for a single ls invocation.\ntype lsConfig struct {\n\tfilter    filterMode\n\tsortBy    sortMode\n\treverse   bool // -r/--reverse: reverse sort order (R2)\n\toutput    outputMode\n\ttimeField timeField // -c, -u, --time=WORD: timestamp selection (R3)\n\ttimeStyle timeStyle // --time-style=STYLE, --full-time: timestamp format (R4)\n}\n\n// fileEntry holds the name and optional metadata for a listed entry.\ntype fileEntry struct {\n\tname string\n\tinfo *sys.FileInfo\n}\n\nfunc main() {\n\t// R7.1: SIGPIPE handler so piping to head exits cleanly.\n\tsigCh := make(chan os.Signal, 1)\n\tsignal.Notify(sigCh, syscall.SIGPIPE)\n\tgo func() {\n\t\t<-sigCh\n\t\tos.Exit(0)\n\t}()\n\n\tcfg, operands, parseErr := parseFlags()\n\tif parseErr != nil {\n\t\t// R6: exit 2 for invalid options.\n\t\tfmt.Fprintf(os.Stderr, \"%s: %v\\n\", progName, parseErr)\n\t\tos.Exit(2)\n\t}\n\n\t// R1: default to current directory when no operands.\n\tif len(operands) == 0 {\n\t\toperands = []string{\".\"}\n\t}\n\n\texitCode := 0\n\tvar fileOps []fileEntry\n\tvar dirOps []fileEntry\n\n\t// R2: classify operands into files and directories.\n\tfor _, op := range operands {\n\t\tfi, err := sys.Lstat(op)\n\t\tif err != nil {\n\t\t\t// R6: print error, set exit code, continue.\n\t\t\tfmt.Fprintf(os.Stderr, \"%s: cannot access '%s': %v\\n\", progName, op, sysErr(err))\n\t\t\texitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentry := fileEntry{name: op, info: fi}\n\t\tif fi.Mode.IsDir() {\n\t\t\tdirOps = append(dirOps, entry)\n\t\t} else {\n\t\t\tfileOps = append(fileOps, entry)\n\t\t}\n\t}\n\n\t// R2: directory header when more than one operand is given.\n\tshowHeader := len(operands) > 1\n\tneedNewline := false\n\n\t// R2: list file operands first, sorted.\n\tif len(fileOps) > 0 {\n\t\tsortEntries(fileOps, cfg)\n\t\tprintEntries(entryNames(fileOps), cfg)\n\t\tneedNewline = true\n\t}\n\n\t// R2: list directory operands, sorted.\n\tsortEntries(dirOps, cfg)\n\tfor _, de := range dirOps {\n\t\tif needNewline {\n\t\t\tfmt.Println()\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Printf(\"%s:\\n\", de.name)\n\t\t}\n\t\tentries, err := readDir(de.name, cfg)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"%s: cannot open directory '%s': %v\\n\",\n\t\t\t\tprogName, de.name, sysErr(err))\n\t\t\texitCode = 2\n\t\t\tneedNewline = true\n\t\t\tcontinue\n\t\t}\n\t\tsortEntries(entries, cfg)\n\t\tprintEntries(entryNames(entries), cfg)\n\t\tneedNewline = true\n\t}\n\n\tos.Exit(exitCode)\n}\n\n// parseFlags parses command-line arguments, supporting combined short flags\n// (e.g., -aSr) and long flags (--reverse, --sort=none, --time=WORD,\n// --time-style=STYLE, --full-time). Returns the resolved config, operand\n// paths, and any parse error. Follows the manual parsing pattern established\n// in cmd/wc.\nfunc parseFlags() (lsConfig, []string, error) {\n\tcfg := lsConfig{}\n\tvar operands []string\n\n\targs := os.Args[1:]\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\n\t\t// \"--\" terminates flag parsing.\n\t\tif arg == \"--\" {\n\t\t\toperands = append(operands, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\n\t\t// Long flags.\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tswitch {\n\t\t\tcase arg == \"--reverse\":\n\t\t\t\tcfg.reverse = true\n\t\t\tcase arg == \"--full-time\":\n\t\t\t\t// R4: --full-time is an alias for --time-style=full-iso.\n\t\t\t\tcfg.timeStyle = timeStyleFullISO\n\t\t\tcase arg == \"--sort=none\":\n\t\t\t\t// R1: --sort=none is an alias for -U.\n\t\t\t\tcfg.sortBy = sortNone\n\t\t\tcase strings.HasPrefix(arg, \"--sort=\"):\n\t\t\t\treturn lsConfig{}, nil, fmt.Errorf(\"invalid argument '%s' for '--sort'\", arg[len(\"--sort=\"):])\n\t\t\tcase strings.HasPrefix(arg, \"--time-style=\"):\n\t\t\t\tts, err := parseTimeStyle(arg[len(\"--time-style=\"):])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn lsConfig{}, nil, err\n\t\t\t\t}\n\t\t\t\tcfg.timeStyle = ts\n\t\t\tcase strings.HasPrefix(arg, \"--time=\"):\n\t\t\t\ttf, err := parseTimeWord(arg[len(\"--time=\"):])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn lsConfig{}, nil, err\n\t\t\t\t}\n\t\t\t\tcfg.timeField = tf\n\t\t\tdefault:\n\t\t\t\treturn lsConfig{}, nil, fmt.Errorf(\"unrecognized option '%s'\", arg)\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\t// Short flags (may be combined: -aSr).\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tfor _, ch := range arg[1:] {\n\t\t\t\tswitch ch {\n\t\t\t\tcase 'a':\n\t\t\t\t\t// R3.1, R3.4: last of -a/-A wins.\n\t\t\t\t\tcfg.filter = filterAll\n\t\t\t\tcase 'A':\n\t\t\t\t\t// R3.2, R3.4: last of -a/-A wins.\n\t\t\t\t\tcfg.filter = filterAlmostAll\n\t\t\t\tcase 'r':\n\t\t\t\t\tcfg.reverse = true\n\t\t\t\tcase 't':\n\t\t\t\t\t// R2.6: last sort flag wins.\n\t\t\t\t\tcfg.sortBy = sortByTime\n\t\t\t\tcase 'S':\n\t\t\t\t\tcfg.sortBy = sortBySize\n\t\t\t\tcase 'X':\n\t\t\t\t\tcfg.sortBy = sortByExtension\n\t\t\t\tcase 'U':\n\t\t\t\t\t// R2.4: directory order, no sorting.\n\t\t\t\t\tcfg.sortBy = sortNone\n\t\t\t\tcase 'c':\n\t\t\t\t\t// R3: select status change time (ctime).\n\t\t\t\t\tcfg.timeField = timeChanged\n\t\t\t\tcase 'u':\n\t\t\t\t\t// R3: select access time (atime).\n\t\t\t\t\tcfg.timeField = timeAccessed\n\t\t\t\tcase '1':\n\t\t\t\t\tcfg.output = outputSingle\n\t\t\t\tcase 'C':\n\t\t\t\t\tcfg.output = outputColumns\n\t\t\t\tdefault:\n\t\t\t\t\treturn lsConfig{}, nil, fmt.Errorf(\"invalid option -- '%c'\", ch)\n\t\t\t\t}\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\n\t\toperands = append(operands, arg)\n\t}\n\n\treturn cfg, operands, nil\n}\n\n// parseTimeStyle maps a --time-style=STYLE argument to a timeStyle value.\nfunc parseTimeStyle(style string) (timeStyle, error) {\n\tswitch style {\n\tcase \"full-iso\":\n\t\treturn timeStyleFullISO, nil\n\tcase \"long-iso\":\n\t\treturn timeStyleLongISO, nil\n\tcase \"iso\":\n\t\treturn timeStyleISO, nil\n\tcase \"locale\":\n\t\treturn timeStyleLocale, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"invalid argument '%s' for '--time-style'\", style)\n\t}\n}\n\n// parseTimeWord maps a --time=WORD argument to a timeField value.\nfunc parseTimeWord(word string) (timeField, error) {\n\tswitch word {\n\tcase \"mtime\", \"modification\":\n\t\treturn timeModified, nil\n\tcase \"ctime\", \"status\":\n\t\treturn timeChanged, nil\n\tcase \"atime\", \"access\", \"use\":\n\t\treturn timeAccessed, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"invalid argument '%s' for '--time'\", word)\n\t}\n}\n\n// readDir reads directory entries and applies the active filter.\n// For filterAll, \".\" and \"..\" are prepended to the listing since\n// os.ReadDir omits them.\nfunc readDir(dirPath string, cfg lsConfig) ([]fileEntry, error) {\n\tdirEntries, err := os.ReadDir(dirPath)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tneedStat := cfg.sortBy == sortByTime || cfg.sortBy == sortBySize\n\tvar entries []fileEntry\n\n\t// R3.1: -a includes \".\" and \"..\" which os.ReadDir omits.\n\tif cfg.filter == filterAll {\n\t\tentries = append(entries, makeEntry(dirPath, \".\", needStat))\n\t\tentries = append(entries, makeEntry(dirPath, \"..\", needStat))\n\t}\n\n\tfor _, de := range dirEntries {\n\t\tname := de.Name()\n\n\t\t// R1.4: default filter hides entries starting with '.'.\n\t\tif cfg.filter == filterDefault && strings.HasPrefix(name, \".\") {\n\t\t\tcontinue\n\t\t}\n\n\t\tentries = append(entries, makeEntry(dirPath, name, needStat))\n\t}\n\n\treturn entries, nil\n}\n\n// makeEntry creates a fileEntry, stat'ing the file when needStat is true\n// to obtain metadata for time or size sorting.\nfunc makeEntry(dirPath, name string, needStat bool) fileEntry {\n\tentry := fileEntry{name: name}\n\tif needStat {\n\t\tpath := joinPath(dirPath, name)\n\t\tfi, err := sys.Lstat(path)\n\t\tif err == nil {\n\t\t\tentry.info = fi\n\t\t}\n\t}\n\treturn entry\n}\n\n// joinPath constructs a child path preserving the parent directory's prefix\n// form. Avoids filepath.Join which cleans \"..\" components, breaking stat of\n// \"dir/..\" entries needed for -a.\nfunc joinPath(dir, name string) string {\n\tif len(dir) > 0 && dir[len(dir)-1] == '/' {\n\t\treturn dir + name\n\t}\n\treturn dir + \"/\" + name\n}\n\n// entryNames extracts the names from a slice of file entries.\nfunc entryNames(entries []fileEntry) []string {\n\tnames := make([]string, len(entries))\n\tfor i, e := range entries {\n\t\tnames[i] = e.name\n\t}\n\treturn names\n}\n\n// printEntries outputs names in single-column or multi-column format\n// depending on the active output mode and whether stdout is a TTY.\nfunc printEntries(names []string, cfg lsConfig) {\n\tif len(names) == 0 {\n\t\treturn\n\t}\n\n\tif useSingleColumn(cfg) {\n\t\tfor _, name := range names {\n\t\t\tfmt.Println(name)\n\t\t}\n\t\treturn\n\t}\n\n\t// R5: multi-column output using pkg/format.\n\twidth := termWidth()\n\tgrid := format.Columns(names, width)\n\tfor _, row := range grid {\n\t\tline := strings.Join(row, \"  \")\n\t\tfmt.Println(strings.TrimRight(line, \" \"))\n\t}\n}\n\n// useSingleColumn returns true when output should be one entry per line.\nfunc useSingleColumn(cfg lsConfig) bool {\n\tswitch cfg.output {\n\tcase outputSingle:\n\t\treturn true\n\tcase outputColumns:\n\t\treturn false\n\tdefault:\n\t\t// R5: auto-detect based on stdout.\n\t\treturn !isStdoutTTY()\n\t}\n}\n\n// isStdoutTTY reports whether stdout is connected to a terminal (D4).\nfunc isStdoutTTY() bool {\n\tfi, err := os.Stdout.Stat()\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn fi.Mode()&os.ModeCharDevice != 0\n}\n\n// termWidth returns the current terminal column count, falling back to\n// defaultTermWidth when the width cannot be determined (D1).\nfunc termWidth() int {\n\tw, err := sys.TerminalWidth()\n\tif err != nil || w <= 0 {\n\t\treturn defaultTermWidth\n\t}\n\treturn w\n}\n\n// sysErr extracts the underlying system error from an os.PathError for\n// cleaner diagnostic messages matching GNU ls format.\nfunc sysErr(err error) error {\n\tif pe, ok := err.(*os.PathError); ok { //nolint:errorlint\n\t\treturn pe.Err\n\t}\n\treturn err\n}\n\n// formatTime formats a timestamp according to the active time style.\n// R4: --time-style controls the format in long listing mode. The default\n// and locale styles produce the same output under LC_ALL=C (DD6).\nfunc formatTime(t time.Time, style timeStyle, now time.Time) string {\n\tsixMonths := 6 * 30 * 24 * time.Hour\n\trecent := !t.After(now) && now.Sub(t) < sixMonths\n\n\tswitch style {\n\tcase timeStyleFullISO:\n\t\treturn t.Format(\"2006-01-02 15:04:05.000000000 -0700\")\n\tcase timeStyleLongISO:\n\t\treturn t.Format(\"2006-01-02 15:04\")\n\tcase timeStyleISO:\n\t\tif recent {\n\t\t\treturn t.Format(\"01-02 15:04\")\n\t\t}\n\t\treturn t.Format(\"2006-01-02 \")\n\tdefault:\n\t\t// timeStyleDefault and timeStyleLocale: same format under LC_ALL=C (DD6).\n\t\tif recent {\n\t\t\treturn t.Format(\"Jan _2 15:04\")\n\t\t}\n\t\treturn t.Format(\"Jan _2  2006\")\n\t}\n}\n","numLines":433,"startLine":1,"totalLines":433}}}
