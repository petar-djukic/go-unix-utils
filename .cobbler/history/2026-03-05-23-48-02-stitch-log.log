x(st.Mtimespec.Sec, st.Mtimespec.Nsec)","+  fi.AccessTime = time.Unix(st.Atimespec.Sec, st.Atimespec.Nsec)","+  fi.ChangeTime = time.Unix(st.Ctimespec.Sec, st.Ctimespec.Nsec)"," }"]}],"userModified":false,"replaceAll":false}}
