10-ls-extended R2.3\n\n  - name: sort_reverse_time\n    description: -tr reverses time sort (oldest first).\n    inputs:\n      args: [\"-1tr\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: entries ordered oldest to newest\n      stderr: \"\"\n    traces:\n      - prd010-ls-extended R2.3\n      - prd010-ls-extended R2.1\n\n  - name: sort_unsorted\n    description: -U disables sorting; entries in directory order.\n    inputs:\n      args: [\"-1U\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: entries in directory order (same for both binaries on same filesystem)\n      stderr: \"\"\n    traces:\n      - prd010-ls-extended R2.4\n\n  - name: version_sort\n    description: -v sorts with numeric-aware version sort (file2 before file10).\n    inputs:\n      args: [\"-1v\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: file1, file2, file10, file20 (numeric sort, not lexicographic)\n      stderr: \"\"\n    traces:\n      - prd010-ls-extended R2.5\n\n  - name: inode_display\n    description: -i prepends inode number to each entry.\n    inputs:\n      args: [\"-1i\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: each line has right-aligned inode number followed by entry name\n      stderr: \"\"\n    traces:\n      - prd010-ls-extended R3.1\n\n  - name: block_display\n    description: -s prepends block count to each entry.\n    inputs:\n      args: [\"-1s\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: each line has right-aligned block count followed by entry name\n      stderr: \"\"\n    traces:\n      - prd010-ls-extended R3.2\n\n  - name: numeric_ids\n    description: -n activates long format with numeric UID/GID instead of names.\n    inputs:\n      args: [\"-n\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: LsExtendedNormalizer replaces mtime with MTIME\n    expected:\n      exit_code: 0\n      stdout_structure: long format with numeric owner and group IDs\n      stderr: \"\"\n    traces:\n      - prd010-ls-extended R3.4\n      - prd010-ls-extended R6.1\n\n  - name: classify_indicator\n    description: '-F appends type indicators to entry names. Fixture contains: a directory (gets /), an executable (gets *), a symlink (gets @), a named pipe (gets |), a regular file (no indicator).'\n    inputs:\n      args: [\"-1F\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: 'output contains \"/\", \"*\", and \"@\"'\n      stderr: \"\"\n    traces:\n      - prd010-ls-extended R4.1\n      - prd010-ls-extended R4.2\n\n  - name: recursive\n    description: -R recursively lists subdirectories with \"path:\" headers.\n    inputs:\n      args: [\"-1R\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout_structure: |\n        Root listing followed by subdirectory listings, each with \"path:\" header\n        and blank-line separators.\n      stderr: \"\"\n    traces:\n      - prd010-ls-extended R5.1\n      - prd010-ls-extended R5.3\n      - prd010-ls-extended R5.4\n\n  - name: recursive_long\n    description: -Rl lists all subdirectories