ng) (string, int) {\n69\t\tif len(s) < 2 {\n70\t\t\treturn \"%\", 1\n71\t\t}\n72\t\tif s[1] == '%' {\n73\t\t\treturn \"%\", 2\n74\t\t}\n75\t\tflags, width, prec, dir, adv := parseModifiers(s[1:])\n76\t\tval := fsDirectiveValue(fs, path, dir)\n77\t\tformatted := applyModifiers(val, flags, width, prec)\n78\t\treturn formatted, 1 + adv\n79\t}\n80\t\n81\tfunc parseModifiers(s string) (string, int, int, byte, int) {\n82\t\ti := 0\n83\t\tvar flags string\n84\t\tfor i < len(s) && (s[i] == '-' || s[i] == '+' || s[i] == ' ' || s[i] == '0' || s[i] == '#') {\n85\t\t\tflags += string(s[i])\n86\t\t\ti++\n87\t\t}\n88\t\twidth := 0\n89\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n90\t\t\twidth = width*10 + int(s[i]-'0')\n91\t\t\ti++\n92\t\t}\n93\t\tprec := -1\n94\t\tif i < len(s) && s[i] == '.' {\n95\t\t\ti++\n96\t\t\tprec = 0\n97\t\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n98\t\t\t\tprec = prec*10 + int(s[i]-'0')\n99\t\t\t\ti++\n100\t\t\t}\n101\t\t}\n102\t\tif i >= len(s) {\n103\t\t\treturn flags, width, prec, 0, i\n104\t\t}\n105\t\treturn flags, width, prec, s[i], i + 1\n106\t}\n107\t\n108\tfunc applyModifiers(val string, flags string, width int, prec int) string {\n109\t\tif width == 0 && prec < 0 && flags == \"\" {\n110\t\t\treturn val\n111\t\t}\n112\t\tfmtStr := \"%\" + flags\n113\t\tif width > 0 {\n114\t\t\tfmtStr += strconv.Itoa(width)\n115\t\t}\n116\t\tif prec >= 0 {\n117\t\t\tfmtStr += \".\" + strconv.Itoa(prec)\n118\t\t}\n119\t\tfmtStr += \"s\"\n120\t\treturn fmt.Sprintf(fmtStr, val)\n121\t}\n122\t\n123\tfunc fileDirectiveValue(fi *sys.FileInfo, path string, dir byte) string {\n124\t\trawMode := rawModeFromInfo(fi)\n125\t\tswitch dir {\n126\t\tcase 'a':\n127\t\t\treturn fmt.Sprintf(\"%o\", rawMode&07777)\n128\t\tcase 'A':\n129\t\t\treturn permString(fi.Mode)\n130\t\tcase 'b':\n131\t\t\treturn fmt.Sprintf(\"%d\", fi.Blocks)\n132\t\tcase 'B':\n133\t\t\treturn \"512\"\n134\t\tcase 'd':\n135\t\t\treturn fmt.Sprintf(\"%d\", fi.Dev)\n136\t\tcase 'D':\n137\t\t\tr