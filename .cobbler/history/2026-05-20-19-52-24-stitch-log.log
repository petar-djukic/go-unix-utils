{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VPMuCjeenDNuBCCZBFe8xG","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/sponge implements srd007-sponge: soak all of stdin before writing\n5\t// to a named output file, preventing read-write conflicts in pipelines.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"flag\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"os/signal\"\n14\t\t\"path/filepath\"\n15\t\t\"runtime\"\n16\t\t\"sync\"\n17\t\t\"syscall\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n20\t)\n21\t\n22\tvar appendMode = flag.Bool(\"a\", false, \"append to output file\")\n23\t\n24\tvar (\n25\t\ttempFileMu   sync.Mutex\n26\t\ttempFilePath string\n27\t)\n28\t\n29\tfunc main() {\n30\t\tsys.InstallSIGPIPEHandler()\n31\t\tflag.Parse()\n32\t\tos.Exit(run())\n33\t}\n34\t\n35\tfunc run() (exitCode int) {\n36\t\tdefer func() {\n37\t\t\tif r := recover(); r != nil {\n38\t\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", r)\n39\t\t\t\texitCode = 1\n40\t\t\t}\n41\t\t}()\n42\t\tinstallCleanupHandler()\n43\t\tdefer cleanupCurrentTempFile()\n44\t\n45\t\tdata, tmpFile, err := readAllStdin()\n46\t\tif err != nil {\n47\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n48\t\t\treturn 1\n49\t\t}\n50\t\tif tmpFile != \"\" {\n51\t\t\tsetTempFile(tmpFile)\n52\t\t}\n53\t\n54\t\targs := flag.Args()\n55\t\tif len(args) == 0 {\n56\t\t\treturn runPassthrough(data, tmpFile)\n57\t\t}\n58\t\treturn runOutput(args[0], data, tmpFile)\n59\t}\n60\t\n61\tfunc runPassthrough(data []byte, tmpFile string) int {\n62\t\tif err := writeToStdout(data, tmpFile); err != nil {\n63\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n64\t\t\treturn 1\n65\t\t}\n66\t\treturn 0\n67\t}\n68\t\n69\tfunc runOutput(filename string, data []byte, tmpFile string) int {\n70\t\tmode, exists, isRegular, err := outputFileInfo(filename)\n71\t\tif err != nil {\n72\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n73\t\t\treturn 1\n74\t\t}\n75\t\n76\t\t// R3.1, R3.2: append only when file exists and is a regular file\n77\t\tif *appendMode && exists && isRegular {\n78\t\t\tdata, tmpFile, err = prependOriginal(filename, data, tmpFile)\n79\t\t\tif err != nil {\n80\t\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n81\t\t\t\treturn 1\n82\t\t\t}\n83\t\t\tif tmpFile != \"\" {\n84\t\t\t\tsetTempFile(tmpFile)\n85\t\t\t}\n86\t\t}\n87\t\n88\t\tif err := writeOutputFile(filename, data, tmpFile, mode, exists, isRegular); err != nil {\n89\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n90\t\t\treturn 1\n91\t\t}\n92\t\tclearTempFile()\n93\t\treturn 0\n94\t}\n95\t\n96\tfunc readAllStdin() ([]byte, string, error) {\n97\t\tdata, err := io.ReadAll(os.Stdin)\n98\t\tif err != nil {\n99\t\t\treturn nil, \"\", fmt.Errorf(\"read stdin: %w\", err)\n100\t\t}\n101\t\tthreshold := spillThreshold()\n102\t\tif uint64(len(data)) > threshold {\n103\t\t\ttmpPath, err := spillToTempFile(data)\n104\t\t\tif err != nil {\n105\t\t\t\treturn nil, \"\", err\n106\t\t\t}\n107\t\t\treturn nil, tmpPath, nil\n108\t\t}\n109\t\treturn data, \"\", nil\n110\t}\n111\t\n112\tfunc spillThreshold() uint64 {\n113\t\tvar m runtime.MemStats\n114\t\truntime.ReadMemStats(&m)\n115\t\tavail := m.Sys - m.HeapInuse\n116\t\tif avail == 0 {\n117\t\t\treturn 256 * 1024 * 1024\n118\t\t}\n119\t\tquarter := avail / 4\n120\t\tconst maxThreshold = 1024 * 1024 * 1024\n121\t\tif quarter > maxThreshold {\n122\t\t\treturn maxThreshold\n123\t\t}\n124\t\treturn quarter\n125\t}\n126\t\n127\tfunc spillToTempFile(data []byte) (string, error) {\n128\t\tf, err := os.CreateTemp(tempDir(), \"sponge.\")\n129\t\tif err != nil {\n130\t\t\treturn \"\", fmt.Errorf(\"create temp file: %w\", err)\n131\t\t}\n132\t\tpath := f.Name()\n133\t\tif _, err := f.Write(data); err != nil {\n134\t\t\tf.Close()\n135\t\t\tos.Remove(path)\n136\t\t\treturn \"\", fmt.Errorf(\"write temp file: %w\", err)\n137\t\t}\n138\t\tif err := f.Close(); err != nil {\n139\t\t\tos.Remove(path)\n140\t\t\treturn \"\", fmt.Errorf(\"close temp file: %w\", err)\n141\t\t}\n142\t\treturn path, nil\n143\t}\n144\t\n145\tfunc tempDir() string {\n146\t\tif d := os.Getenv(\"TMPDIR\"); d != \"\" {\n147\t\t\treturn d\n148\t\t}\n149\t\treturn \"/tmp\"\n150\t}\n151\t\n152\tfunc setTempFile(path string) {\n153\t\ttempFileMu.Lock()\n154\t\ttempFilePath = path\n155\t\ttempFileMu.Unlock()\n156\t}\n157\t\n158\tfunc clearTempFile() {\n159\t\ttempFileMu.Lock()\n160\t\ttempFilePath = \"\"\n161\t\ttempFileMu.Unlock()\n162\t}\n163\t\n164\tfunc cleanupCurrentTempFile() {\n165\t\ttempFileMu.Lock()\n166\t\tp := tempFilePath\n167\t\ttempFilePath = \"\"\n168\t\ttempFileMu.Unlock()\n169\t\tif p != \"\" {\n170\t\t\tos.Remove(p)\n171\t\t}\n172\t}\n173\t\n174\tfunc installCleanupHandler() {\n175\t\tsigCh := make(chan os.Signal, 1)\n176\t\tsignal.Notify(sigCh, syscall.SIGINT, syscall.SIGTERM, syscall.SIGHUP, syscall.SIGPIPE)\n177\t\tgo func() {\n178\t\t\t<-sigCh\n179\t\t\ttempFileMu.Lock()\n180\t\t\tp := tempFilePath\n181\t\t\ttempFileMu.Unlock()\n182\t\t\tif p != \"\" {\n183\t\t\t\tos.Remove(p)\n184\t\t\t}\n185\t\t\tos.Exit(1)\n186\t\t}()\n187\t}\n188\t\n189\t// R2.4: use lstat to determine file existence, mode, and whether it is regular\n190\tfunc outputFileInfo(filename string) (os.FileMode, bool, bool, error) {\n191\t\tfi, err := sys.Lstat(filename)\n192\t\tif err != nil {\n193\t\t\tif os.IsNotExist(err) {\n194\t\t\t\treturn 0666, false, false, nil\n195\t\t\t}\n196\t\t\treturn 0, false, false, fmt.Errorf(\"lstat %s: %w\", filename, err)\n197\t\t}\n198\t\treturn fi.Mode.Perm(), true, fi.Mode.IsRegular(), nil\n199\t}\n200\t\n201\t// R3.1: prepend original file content before stdin content\n202\tfunc prependOriginal(filename string, data []byte, tmpFile string) ([]byte, string, error) {\n203\t\toriginal, err := os.ReadFile(filename)\n204\t\tif err != nil {\n205\t\t\treturn nil, \"\", fmt.Errorf(\"read %s: %w\", filename, err)\n206\t\t}\n207\t\tif len(original) == 0 {\n208\t\t\treturn data, tmpFile, nil\n209\t\t}\n210\t\tif tmpFile != \"\" {\n211\t\t\tcombined, err := combineTempFiles(original, tmpFile)\n212\t\t\tif err != nil {\n213\t\t\t\treturn nil, \"\", err\n214\t\t\t}\n215\t\t\treturn nil, combined, nil\n216\t\t}\n217\t\tcombined := make([]byte, len(original)+len(data))\n218\t\tcopy(combined, original)\n219\t\tcopy(combined[len(original):], data)\n220\t\treturn combined, \"\", nil\n221\t}\n222\t\n223\tfunc combineTempFiles(original []byte, stdinTmpFile string) (string, error) {\n224\t\tf, err := os.CreateTemp(tempDir(), \"sponge.\")\n225\t\tif err != nil {\n226\t\t\treturn \"\", fmt.Errorf(\"create temp file: %w\", err)\n227\t\t}\n228\t\tpath := f.Name()\n229\t\n230\t\tif _, err := f.Write(original); err != nil {\n231\t\t\tf.Close()\n232\t\t\tos.Remove(path)\n233\t\t\treturn \"\", fmt.Errorf(\"write original to temp: %w\", err)\n234\t\t}\n235\t\tif err := appendFromFile(f, stdinTmpFile); err != nil {\n236\t\t\tf.Close()\n237\t\t\tos.Remove(path)\n238\t\t\treturn \"\", err\n239\t\t}\n240\t\tif err := f.Close(); err != nil {\n241\t\t\tos.Remove(path)\n242\t\t\treturn \"\", fmt.Errorf(\"close temp file: %w\", err)\n243\t\t}\n244\t\n245\t\tsetTempFile(path)\n246\t\tos.Remove(stdinTmpFile)\n247\t\treturn path, nil\n248\t}\n249\t\n250\tfunc appendFromFile(dst *os.File, srcPath string) error {\n251\t\tsrc, err := os.Open(srcPath)\n252\t\tif err != nil {\n253\t\t\treturn fmt.Errorf(\"open %s: %w\", srcPath, err)\n254\t\t}\n255\t\tdefer src.Close()\n256\t\tif _, err := io.Copy(dst, src); err != nil {\n257\t\t\treturn fmt.Errorf(\"copy from %s: %w\", srcPath, err)\n258\t\t}\n259\t\treturn nil\n260\t}\n261\t\n262\tfunc writeOutputFile(filename string, data []byte, tmpFile string, mode os.FileMode, exists bool, isRegular bool) error {\n263\t\ttmpPath := tmpFile\n264\t\tvar err error\n265\t\tif tmpPath == \"\" {\n266\t\t\ttmpPath, err = spillToTempFile(data)\n267\t\t\tif err != nil {\n268\t\t\t\treturn err\n269\t\t\t}\n270\t\t\tsetTempFile(tmpPath)\n271\t\t}\n272\t\n273\t\t// R2.4: only attempt atomic rename for regular files or new files\n274\t\tif !exists || isRegular {\n275\t\t\treturn attemptAtomicWrite(tmpPath, filename, mode, exists)\n276\t\t}\n277\t\treturn directWrite(tmpPath, filename, mode)\n278\t}\n279\t\n280\tfunc attemptAtomicWrite(tmpPath, filename string, mode os.FileMode, exists bool) error {\n281\t\tif err := os.Rename(tmpPath, filename); err != nil {\n282\t\t\treturn atomicFallbackCopy(tmpPath, filename, mode)\n283\t\t}\n284\t\tif exists {\n285\t\t\tif err := os.Chmod(filename, mode); err != nil {\n286\t\t\t\treturn fmt.Errorf(\"chmod %s: %w\", filename, err)\n287\t\t\t}\n288\t\t}\n289\t\treturn nil\n290\t}\n291\t\n292\t// R2.5: ensure output is never in a partially-written state\n293\tfunc atomicFallbackCopy(tmpPath, filename string, mode os.FileMode) error {\n294\t\tdir := filepath.Dir(filename)\n295\t\ttmpDst, err := os.CreateTemp(dir, \".sponge-\")\n296\t\tif err != nil {\n297\t\t\treturn directWrite(tmpPath, filename, mode)\n298\t\t}\n299\t\ttmpDstPath := tmpDst.Name()\n300\t\n301\t\tif err := copyFileToWriter(tmpPath, tmpDst, mode); err != nil {\n302\t\t\tos.Remove(tmpDstPath)\n303\t\t\treturn err\n304\t\t}\n305\t\tif err := os.Rename(tmpDstPath, filename); err != nil {\n306\t\t\tos.Remove(tmpDstPath)\n307\t\t\treturn directWrite(tmpPath, filename, mode)\n308\t\t}\n309\t\tos.Remove(tmpPath)\n310\t\treturn nil\n311\t}\n312\t\n313\tfunc copyFileToWriter(srcPath string, dst *os.File, mode os.FileMode) error {\n314\t\tsrc, err := os.Open(srcPath)\n315\t\tif err != nil {\n316\t\t\tdst.Close()\n317\t\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n318\t\t}\n319\t\tdefer src.Close()\n320\t\n321\t\tif _, err := io.Copy(dst, src); err != nil {\n322\t\t\tdst.Close()\n323\t\t\treturn fmt.Errorf(\"copy: %w\", err)\n324\t\t}\n325\t\tif err := dst.Chmod(mode); err != nil {\n326\t\t\tdst.Close()\n327\t\t\treturn fmt.Errorf(\"chmod: %w\", err)\n328\t\t}\n329\t\treturn dst.Close()\n330\t}\n331\t\n332\tfunc directWrite(tmpPath, filename string, mode os.FileMode) error {\n333\t\tsrc, err := os.Open(tmpPath)\n334\t\tif err != nil {\n335\t\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n336\t\t}\n337\t\tdefer src.Close()\n338\t\n339\t\tdst, err := os.OpenFile(filename, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n340\t\tif err != nil {\n341\t\t\treturn fmt.Errorf(\"open %s: %w\", filename, err)\n342\t\t}\n343\t\n344\t\tif _, err := io.Copy(dst, src); err != nil {\n345\t\t\tdst.Close()\n346\t\t\treturn fmt.Errorf(\"copy to %s: %w\", filename, err)\n347\t\t}\n348\t\tif err := dst.Close(); err != nil {\n349\t\t\treturn fmt.Errorf(\"close %s: %w\", filename, err)\n350\t\t}\n351\t\tos.Remove(tmpPath)\n352\t\treturn nil\n353\t}\n354\t\n355\tfunc writeToStdout(data []byte, tmpFile string) error {\n356\t\tif tmpFile != \"\" {\n357\t\t\treturn copyTempFileToStdout(tmpFile)\n358\t\t}\n359\t\tif _, err := os.Stdout.Write(data); err != nil {\n360\t\t\treturn fmt.Errorf(\"write stdout: %w\", err)\n361\t\t}\n362\t\treturn nil\n363\t}\n364\t\n365\tfunc copyTempFileToStdout(tmpFile string) error {\n366\t\tf, err := os.Open(tmpFile)\n367\t\tif err != nil {\n368\t\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n369\t\t}\n370\t\tdefer f.Close()\n371\t\tif _, err := f.Seek(0, io.SeekStart); err != nil {\n372\t\t\treturn fmt.Errorf(\"seek temp file: %w\", err)\n373\t\t}\n374\t\tif _, err := io.Copy(os.Stdout, f); err != nil {\n375\t\t\treturn fmt.Errorf(\"write stdout: %w\", err)\n376\t\t}\n377\t\treturn nil\n378\t}\n379\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01HUfpsw2uG2BdJWbpmAdfdr","session_id":"417d3d97-6d0