 reverseBeforeFixed(input, sep)\n\t}\n\n\thasTrailingSep := strings.HasSuffix(input, sep)\n\ttrimmed := input\n\tif hasTrailingSep {\n\t\ttrimmed = input[:len(input)-len(sep)]\n\t}\n\n\tparts := strings.Split(trimmed, sep)\n\tfor i, j := 0, len(parts)-1; i < j; i, j = i+1, j-1 {\n\t\tparts[i], parts[j] = parts[j], parts[i]\n\t}\n\n\tresult := strings.Join(parts, sep)\n\tif hasTrailingSep {\n\t\tresult += sep\n\t}\n\treturn result\n}\n\nfunc reverseBeforeFixed(input string, sep string) {\n\tparts := splitBefore(input, sep)\n\tfor i, j := 0, len(parts)-1; i < j; i, j = i+1, j-1 {\n\t\tparts[i], parts[j] = parts[j], parts[i]\n\t}\n\treturn strings.Join(parts, \"\")\n}\n\nfunc splitBefore(input string, sep string) []string {\n\tvar parts []string\n\tfor {\n\t\tidx := strings.Index(input, sep)\n\t\tif idx < 0 {\n\t\t\tif input != \"\" {\n\t\t\t\tparts = append(parts, input)\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tif idx > 0 {\n\t\t\tparts = append(parts, input[:idx])\n\t\t}\n\t\tnext := idx + len(sep)\n\t\tnextIdx := strings.Index(input[next:], sep)\n\t\tif nextIdx < 0 {\n\t\t\tparts = append(parts, input[idx:])\n\t\t\tbreak\n\t\t}\n\t\tparts = append(parts, input[idx:next+nextIdx])\n\t\tinput = input[next+nextIdx:]\n\t}\n\treturn parts\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
