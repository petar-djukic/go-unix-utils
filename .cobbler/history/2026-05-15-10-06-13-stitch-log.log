{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XXiN9e6gQnaqVRTYZ3c6Tb","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd023-fold R1.1-R1.4, R2.1-R2.3, R3.1-R3.4, R4.1-R4.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"syscall\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tfunc main() {\n20\t\tsys.InstallSIGPIPEHandler()\n21\t\tos.Exit(run(os.Args[1:]))\n22\t}\n23\t\n24\ttype options struct {\n25\t\twidth     int\n26\t\tbyteMode  bool\n27\t\tspaceMode bool\n28\t}\n29\t\n30\tfunc defaultOptions() options {\n31\t\treturn options{\n32\t\t\twidth: 80,\n33\t\t}\n34\t}\n35\t\n36\tfunc run(args []string) int {\n37\t\topts, files, err := parseArgs(args)\n38\t\tif err != nil {\n39\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n40\t\t\treturn 1\n41\t\t}\n42\t\tif len(files) == 0 {\n43\t\t\tfiles = []string{\"-\"}\n44\t\t}\n45\t\tw := bufio.NewWriter(os.Stdout)\n46\t\texitCode := 0\n47\t\tfor _, f := range files {\n48\t\t\tif err := processFile(f, opts, w); err != nil {\n49\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n50\t\t\t\t\tos.Exit(0)\n51\t\t\t\t}\n52\t\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n53\t\t\t\texitCode = 1\n54\t\t\t}\n55\t\t}\n56\t\tif err := w.Flush(); err != nil {\n57\t\t\tif errors.Is(err, syscall.EPIPE) {\n58\t\t\t\tos.Exit(0)\n59\t\t\t}\n60\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n61\t\t\texitCode = 1\n62\t\t}\n63\t\treturn exitCode\n64\t}\n65\t\n66\tfunc parseArgs(args []string) (options, []string, error) {\n67\t\topts := defaultOptions()\n68\t\tvar files []string\n69\t\ti := 0\n70\t\tfor i < len(args) {\n71\t\t\targ := args[i]\n72\t\t\tif arg == \"--\" {\n73\t\t\t\tfiles = append(files, args[i+1:]...)\n74\t\t\t\tbreak\n75\t\t\t}\n76\t\t\tif arg == \"-\" {\n77\t\t\t\tfiles = append(files, arg)\n78\t\t\t\ti++\n79\t\t\t\tcontinue\n80\t\t\t}\n81\t\t\tif len(arg) > 1 && arg[0] == '-' {\n82\t\t\t\tconsumed, err := parseFlag(arg, args[i+1:], &opts)\n83\t\t\t\tif err != nil {\n84\t\t\t\t\treturn opts, nil, err\n85\t\t\t\t}\n86\t\t\t\ti += 1 + consumed\n87\t\t\t\tcontinue\n88\t\t\t}\n89\t\t\tfiles = append(files, arg)\n90\t\t\ti++\n91\t\t}\n92\t\treturn opts, files, nil\n93\t}\n94\t\n95\tfunc parseFlag(arg string, remaining []string, opts *options) (int, error) {\n96\t\tflag := arg[1:]\n97\t\ti := 0\n98\t\tfor i < len(flag) {\n99\t\t\tswitch flag[i] {\n100\t\t\tcase 'b':\n101\t\t\t\topts.byteMode = true\n102\t\t\t\ti++\n103\t\t\tcase 's':\n104\t\t\t\topts.spaceMode = true\n105\t\t\t\ti++\n106\t\t\tcase 'w':\n107\t\t\t\treturn setWidth(flag[i+1:], remaining, opts)\n108\t\t\tdefault:\n109\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flag[i])\n110\t\t\t}\n111\t\t}\n112\t\treturn 0, nil\n113\t}\n114\t\n115\tfunc setWidth(val string, remaining []string, opts *options) (int, error) {\n116\t\tif val == \"\" {\n117\t\t\tif len(remaining) > 0 {\n118\t\t\t\tval = remaining[0]\n119\t\t\t} else {\n120\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'w'\")\n121\t\t\t}\n122\t\t\tn, err := strconv.Atoi(val)\n123\t\t\tif err != nil || n <= 0 {\n124\t\t\t\treturn 0, fmt.Errorf(\"invalid number of columns: '%s'\", val)\n125\t\t\t}\n126\t\t\topts.width = n\n127\t\t\treturn 1, nil\n128\t\t}\n129\t\tn, err := strconv.Atoi(val)\n130\t\tif err != nil || n <= 0 {\n131\t\t\treturn 0, fmt.Errorf(\"invalid number of columns: '%s'\", val)\n132\t\t}\n133\t\topts.width = n\n134\t\treturn 0, nil\n135\t}\n136\t\n137\tfunc processFile(path string, opts options, w *bufio.Writer) error {\n138\t\tvar r io.Reader\n139\t\tif path == \"-\" {\n140\t\t\tr = os.Stdin\n141\t\t} else {\n142\t\t\tf, err := os.Open(path)\n143\t\t\tif err != nil {\n144\t\t\t\treturn err\n145\t\t\t}\n146\t\t\tdefer f.Close()\n147\t\t\tr = f\n148\t\t}\n149\t\treturn processInput(r, opts, w)\n150\t}\n151\t\n152\tfunc processInput(r io.Reader, opts options, w *bufio.Writer) error {\n153\t\tbr := bufio.NewReader(r)\n154\t\tfor {\n155\t\t\tline, err := readLine(br)\n156\t\t\tif len(line) > 0 {\n157\t\t\t\tif wErr := wrapLine(line, opts, w); wErr != nil {\n158\t\t\t\t\treturn wErr\n159\t\t\t\t}\n160\t\t\t}\n161\t\t\tif err == io.EOF {\n162\t\t\t\treturn nil\n163\t\t\t}\n164\t\t\tif err != nil {\n165\t\t\t\treturn err\n166\t\t\t}\n167\t\t}\n168\t}\n169\t\n170\tfunc readLine(r *bufio.Reader) ([]byte, error) {\n171\t\tline, err := r.ReadBytes('\\n')\n172\t\tif len(line) > 0 {\n173\t\t\treturn line, err\n174\t\t}\n175\t\treturn nil, err\n176\t}\n177\t\n178\tfunc wrapLine(line []byte, opts options, w *bufio.Writer) error {\n179\t\tif opts.byteMode {\n180\t\t\treturn wrapByteMode(line, opts, w)\n181\t\t}\n182\t\treturn wrapColumnMode(line, opts, w)\n183\t}\n184\t\n185\tfunc wrapByteMode(line []byte, opts options, w *bufio.Writer) error {\n186\t\twidth := opts.width\n187\t\tfor len(line) > 0 {\n188\t\t\tif endsWithNewline(line) && len(line)-1 <= width {\n189\t\t\t\t_, err := w.Write(line)\n190\t\t\t\treturn err\n191\t\t\t}\n192\t\t\tif !endsWithNewline(line) && len(line) <= width {\n193\t\t\t\t_, err := w.Write(line)\n194\t\t\t\treturn err\n195\t\t\t}\n196\t\t\tseg := line[:width]\n197\t\t\tif opts.spaceMode {\n198\t\t\t\tseg = breakAtSpace(line, width)\n199\t\t\t}\n200\t\t\tif _, err := w.Write(seg); err != nil {\n201\t\t\t\treturn err\n202\t\t\t}\n203\t\t\tif err := w.WriteByte('\\n'); err != nil {\n204\t\t\t\treturn err\n205\t\t\t}\n206\t\t\tline = line[len(seg):]\n207\t\t}\n208\t\treturn nil\n209\t}\n210\t\n211\tfunc wrapColumnMode(line []byte, opts options, w *bufio.Writer) error {\n212\t\twidth := opts.width\n213\t\tcol := 0\n214\t\tstart := 0\n215\t\tlastSpace := -1\n216\t\tfor i := range len(line) {\n217\t\t\tb := line[i]\n218\t\t\tif b == '\\n' {\n219\t\t\t\tif _, err := w.Write(line[start : i+1]); err != nil {\n220\t\t\t\t\treturn err\n221\t\t\t\t}\n222\t\t\t\tstart = i + 1\n223\t\t\t\tcol = 0\n224\t\t\t\tlastSpace = -1\n225\t\t\t\tcontinue\n226\t\t\t}\n227\t\t\tnextCol := advanceColumn(col, b)\n228\t\t\tif nextCol > width {\n229\t\t\t\tbreakPos := i\n230\t\t\t\tif opts.spaceMode && lastSpace >= start {\n231\t\t\t\t\tbreakPos = lastSpace + 1\n232\t\t\t\t}\n233\t\t\t\tif _, err := w.Write(line[start:breakPos]); err != nil {\n234\t\t\t\t\treturn err\n235\t\t\t\t}\n236\t\t\t\tif err := w.WriteByte('\\n'); err != nil {\n237\t\t\t\t\treturn err\n238\t\t\t\t}\n239\t\t\t\tstart = breakPos\n240\t\t\t\tcol = recalcColumn(line[start:i+1], 0)\n241\t\t\t\tlastSpace = -1\n242\t\t\t\tfor j := start; j <= i; j++ {\n243\t\t\t\t\tif line[j] == ' ' || line[j] == '\\t' {\n244\t\t\t\t\t\tlastSpace = j\n245\t\t\t\t\t}\n246\t\t\t\t}\n247\t\t\t\tcontinue\n248\t\t\t}\n249\t\t\tif b == ' ' || b == '\\t' {\n250\t\t\t\tlastSpace = i\n251\t\t\t}\n252\t\t\tcol = nextCol\n253\t\t}\n254\t\tif start < len(line) {\n255\t\t\tif _, err := w.Write(line[start:]); err != nil {\n256\t\t\t\treturn err\n257\t\t\t}\n258\t\t}\n259\t\treturn nil\n260\t}\n261\t\n262\tfunc advanceColumn(col int, b byte) int {\n263\t\tif b == '\\t' {\n264\t\t\treturn col + 8 - (col % 8)\n265\t\t}\n266\t\tif b == '\\b' {\n267\t\t\tif col > 0 {\n268\t\t\t\treturn col - 1\n269\t\t\t}\n270\t\t\treturn 0\n271\t\t}\n272\t\tif b == '\\r' {\n273\t\t\treturn 0\n274\t\t}\n275\t\treturn col + 1\n276\t}\n277\t\n278\tfunc recalcColumn(data []byte, startCol int) int {\n279\t\tcol := startCol\n280\t\tfor _, b := range data {\n281\t\t\tcol = advanceColumn(col, b)\n282\t\t}\n283\t\treturn col\n284\t}\n285\t\n286\tfunc breakAtSpace(line []byte, width int) []byte {\n287\t\tif width > len(line) {\n288\t\t\twidth = len(line)\n289\t\t}\n290\t\tseg := line[:width]\n291\t\tfor i := len(seg) - 1; i >= 0; i-- {\n292\t\t\tif seg[i] == ' ' || seg[i] == '\\t' {\n293\t\t\t\treturn seg[:i+1]\n294\t\t\t}\n295\t\t}\n296\t\treturn seg\n297\t}\n298\t\n299\tfunc endsWithNewline(line []byte) bool {\n300\t\treturn len(line) > 0 && line[len(line)-1] == '\\n'\n301\t}\n302\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01CfcP1KDHEP3iQzoQqf3X8j","session_id":"90e916e3-9a57-43df-b341-b74db7c6ff8c","uuid":"ffea84d8-6e23-440b-9c0d-42fc73c8b0f7","timestamp":"2026-05-15T14:07:31.967Z"}
