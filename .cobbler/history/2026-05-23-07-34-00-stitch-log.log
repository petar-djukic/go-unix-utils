{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019a2dYQX7qhqS5vqTtWh26k","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage encutil\n5\t\n6\timport (\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"strings\"\n10\t)\n11\t\n12\t// DecoderConfig parameterizes a decoding operation with the decoding function\n13\t// and garbage-handling behavior.\n14\t// R2.1: Decode converts an encoded string back to raw bytes.\n15\t// R2.1: IgnoreGarbage skips non-alphabet characters in the input.\n16\ttype DecoderConfig struct {\n17\t\tDecode        func(string) ([]byte, error)\n18\t\tIgnoreGarbage bool\n19\t}\n20\t\n21\t// Decode reads encoded input from r, decodes it using cfg, and writes the raw\n22\t// bytes to w.\n23\t// R2.2: reads all input, strips whitespace, decodes via cfg.Decode, writes to w.\n24\t// R2.3: returns error on invalid characters when IgnoreGarbage is false.\n25\tfunc Decode(r io.Reader, w io.Writer, cfg DecoderConfig) error {\n26\t\tdata, err := io.ReadAll(r)\n27\t\tif err != nil {\n28\t\t\treturn err\n29\t\t}\n30\t\tinput := stripWhitespace(string(data))\n31\t\tif cfg.IgnoreGarbage {\n32\t\t\tinput = stripGarbage(input)\n33\t\t}\n34\t\tdecoded, err := cfg.Decode(input)\n35\t\tif err != nil {\n36\t\t\treturn err\n37\t\t}\n38\t\t_, err = w.Write(decoded)\n39\t\treturn err\n40\t}\n41\t\n42\tfunc stripWhitespace(s string) string {\n43\t\tvar b strings.Builder\n44\t\tb.Grow(len(s))\n45\t\tfor i := 0; i < len(s); i++ {\n46\t\t\tch := s[i]\n47\t\t\tif ch != ' ' && ch != '\\t' && ch != '\\n' && ch != '\\r' {\n48\t\t\t\tb.WriteByte(ch)\n49\t\t\t}\n50\t\t}\n51\t\treturn b.String()\n52\t}\n53\t\n54\t// stripGarbage removes characters not in the common base-encoding superset\n55\t// alphabet (A-Za-z0-9+/=-_), covering Base64, Base64URL, Base32, Base32hex,\n56\t// and Base16.\n57\tfunc stripGarbage(s string) string {\n58\t\tvar b strings.Builder\n59\t\tb.Grow(len(s))\n60\t\tfor i := 0; i < len(s); i++ {\n61\t\t\tif isEncodingAlphabet(s[i]) {\n62\t\t\t\tb.WriteByte(s[i])\n63\t\t\t}\n64\t\t}\n65\t\treturn b.String()\n66\t}\n67\t\n68\tfunc isEncodingAlphabet(ch byte) bool {\n69\t\treturn (ch >= 'A' && ch <= 'Z') ||\n70\t\t\t(ch >= 'a' && ch <= 'z') ||\n71\t\t\t(ch >= '0' && ch <= '9') ||\n72\t\t\tch == '+' || ch == '/' || ch == '=' ||\n73\t\t\tch == '-' || ch == '_'\n74\t}\n75\t\n76\t// OpenInput opens a file for reading, or returns os.Stdin when filename is\n77\t// empty or \"-\".\n78\t// R3.1: returns an io.ReadCloser for the named file or stdin.\n79\t// R3.2: returns an error when the file cannot be opened.\n80\tfunc OpenInput(filename string) (io.ReadCloser, error) {\n81\t\tif filename == \"\" || filename == \"-\" {\n82\t\t\treturn os.Stdin, nil\n83\t\t}\n84\t\treturn os.Open(filename)\n85\t}\n86\t"}]},"parent_tool_use_id":null,"session_id":"72c6b047-c286-46f9-a34a-a11886458d67","uuid":"838d7fe6-89a4-49a2-92f7-3f98f727ed9a","timestamp":"2026-05-23T11:34:10.841Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5514/pkg/encutil/decode.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage encutil\n\nimport (\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n)\n\n// DecoderConfig parameterizes a decoding operation with the decoding function\n// and garbage-handling behavior.\n// R2.1: Decode converts an encoded string back to raw bytes.\n// R2.1: IgnoreGarbage skips non-alphabet characters in the input.\ntype DecoderConfig struct {\n\tDecode        func(string) ([]byte, error)\n\tIgnoreGarbage bool\n}\n\n// Decode reads encoded input from r, decodes it using cfg, and writes the raw\n// bytes to w.\n// R2.2: reads all input, strips whitespace, decodes via cfg.Decode, writes to w.\n// R2.3: returns error on invalid characters when IgnoreGarbage is false.\nfunc Decode(r io.Reader, w io.Writer, cfg DecoderConfig) error {\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tinput := stripWhitespace(string(data))\n\tif cfg.IgnoreGarbage {\n\t\tinput = stripGarbage(input)\n\t}\n\tdecoded, err := cfg.Decode(input)\n\tif err != nil {\n\t\treturn err\n\t}\n\t_, err = w.Write(decoded)\n\treturn err\n}\n\nfunc stripWhitespace(s string) string {\n\tvar b strings.Builder\n\tb.Grow(len(s))\n\tfor i := 0; i < len(s); i++ {\n\t\tch := s[i]\n\t\tif ch != ' ' && ch != '\\t' && ch != '\\n' && ch != '\\r' {\n\t\t\tb.WriteByte(ch)\n\t\t}\n\t}\n\treturn b.String()\n}\n\n// stripGarbage removes characters not in the common base-encoding superset\n// alphabet (A-Za-z0-9+/=-_), covering Base64, Base64URL, Base32, Base32hex,\n// and Base16.\nfunc stripGarbage(s string) string {\n\tvar b strings.Builder\n\tb.Grow(len(s))\n\tfor i := 0; i < len(s); i++ {\n\t\tif isEncodingAlphabet(s[i]) {\n\t\t\tb.WriteByte(s[i])\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc isEncodingAlphabet(ch byte) bool {\n\treturn (ch >= 'A' && ch <= 'Z') ||\n\t\t(ch >= 'a' && ch <= 'z') ||\n\t\t(ch >= '0' && ch <= '9') ||\n\t\tch == '+' || ch == '/' || ch == '=' ||\n\t\tch == '-' || ch == '_'\n}\n\n// OpenInput opens a file for reading, or returns os.Stdin when filename is\n// empty or \"-\".\n// R3.1: returns an io.ReadCloser for the named file or stdin.\n// R3.2: returns an error when the file cannot be opened.\nfunc OpenInput(filename string) (io.ReadCloser, error) {\n\tif filename == \"\" || filename == \"-\" {\n\t\treturn os.Stdin, nil\n\t}\n\treturn os.Open(filename)\n}\n","numLines":86,"startLine":1,"totalLines":86}}}
