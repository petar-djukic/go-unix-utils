{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013AndhFJq93Deje7Yuw9Bwk","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"encoding/base32\"\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"syscall\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/encutil\"\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tfunc main() {\n20\t\tsys.InstallSIGPIPEHandler()\n21\t\topts, file := parseArgs(os.Args[1:])\n22\t\n23\t\trc, err := encutil.OpenInput(file)\n24\t\tif err != nil {\n25\t\t\tfmt.Fprintf(os.Stderr, \"base32: %s: %s\\n\", file, err.Error())\n26\t\t\tos.Exit(1)\n27\t\t}\n28\t\tdefer rc.Close()\n29\t\n30\t\tif opts.decode {\n31\t\t\terr = encutil.Decode(rc, os.Stdout, encutil.DecoderConfig{\n32\t\t\t\tDecode:        decodeBase32,\n33\t\t\t\tIgnoreGarbage: opts.ignoreGarbage,\n34\t\t\t})\n35\t\t} else {\n36\t\t\terr = encutil.Encode(rc, os.Stdout, encutil.EncoderConfig{\n37\t\t\t\tEncode:  encodeBase32,\n38\t\t\t\tWrapCol: opts.wrap,\n39\t\t\t})\n40\t\t}\n41\t\tif err != nil {\n42\t\t\tif errors.Is(err, syscall.EPIPE) {\n43\t\t\t\tos.Exit(0)\n44\t\t\t}\n45\t\t\tfmt.Fprintf(os.Stderr, \"base32: %s\\n\", err.Error())\n46\t\t\tos.Exit(1)\n47\t\t}\n48\t}\n49\t\n50\tfunc encodeBase32(data []byte) string {\n51\t\treturn base32.StdEncoding.EncodeToString(data)\n52\t}\n53\t\n54\tfunc decodeBase32(s string) ([]byte, error) {\n55\t\treturn base32.StdEncoding.DecodeString(s)\n56\t}\n57\t\n58\ttype options struct {\n59\t\tdecode        bool\n60\t\tignoreGarbage bool\n61\t\twrap          int\n62\t}\n63\t\n64\tfunc parseArgs(args []string) (options, string) {\n65\t\topts := options{wrap: 76}\n66\t\tvar file string\n67\t\ti := 0\n68\t\tfor i < len(args) {\n69\t\t\targ := args[i]\n70\t\t\tif arg == \"--\" {\n71\t\t\t\tif i+1 < len(args) {\n72\t\t\t\t\tfile = ar