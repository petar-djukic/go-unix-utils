{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FYRkwXwD8dMP1oMz8XJCHX","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"hash\"\n9\t\t\"os\"\n10\t\t\"strings\"\n11\t\n12\t\t\"golang.org/x/crypto/blake2b\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tfunc newBLAKE2b() hash.Hash {\n19\t\th, _ := blake2b.New512(nil)\n20\t\treturn h\n21\t}\n22\t\n23\tfunc main() {\n24\t\tsys.InstallSIGPIPEHandler()\n25\t\topts, files := parseArgs(os.Args[1:])\n26\t\tcfg := hashutil.HashConfig{\n27\t\t\tAlgorithm: \"BLAKE2b\",\n28\t\t\tNewHash:   newBLAKE2b,\n29\t\t\tDigestLen: 64,\n30\t\t}\n31\t\tif opts.check {\n32\t\t\tcheckOpts := hashutil.CheckOptions{\n33\t\t\t\tWarn:   opts.warn,\n34\t\t\t\tQuiet:  opts.quiet,\n35\t\t\t\tStatus: opts.status,\n36\t\t\t}\n37\t\t\texitCode := 0\n38\t\t\tfor _, f := range files {\n39\t\t\t\tok, err := hashutil.VerifyChecksums(f, cfg, checkOpts, os.Stdout, os.Stderr)\n40\t\t\t\tif err != nil {\n41\t\t\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: %s\\n\", err)\n42\t\t\t\t\texitCode = 1\n43\t\t\t\t} else if !ok {\n44\t\t\t\t\texitCode = 1\n45\t\t\t\t}\n46\t\t\t}\n47\t\t\tos.Exit(exitCode)\n48\t\t}\n49\t\tos.Exit(hashutil.DigestFiles(files, cfg, opts.binary, opts.tag, os.Stdout, os.Stderr))\n50\t}\n51\t\n52\ttype options struct {\n53\t\tbinary bool\n54\t\ttag    bool\n55\t\tcheck  bool\n56\t\twarn   bool\n57\t\tquiet  bool\n58\t\tstatus bool\n59\t}\n60\t\n61\tfunc parseArgs(args []string) (options, []string) {\n62\t\tvar opts options\n63\t\tvar files []string\n64\t\ti := 0\n65\t\tfor i < len(args) {\n66\t\t\targ := args[i]\n67\t\t\tif arg == \"--\" {\n68\t\t\t\tfiles = append(files, args[i+1:]...)\n69\t\t\t\tbreak\n70\t\t\t}\n71\t\t\tif handled, advance := parseLongFlag(arg, &opts); handled {\n72\t\t\t\ti += advance\n73\t\t\t\tcontinue\n74\t\t\t}\n75\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n76\t\t\t\tfiles = append(files, arg)\n77\t\t\t\ti++\n78\t\t\t\tcontinue\n79\t\t\t}\n80\t\t\ti += parseShortFlags(arg[1:], &opts)\n81\t\t}\n82\t\treturn opts, files\n83\t}\n84\t\n85\tfunc parseLongFlag(arg string, opts *options) (bool, int) {\n86\t\tif !strings.HasPrefix(arg, \"--\") {\n87\t\t\treturn false, 0\n88\t\t}\n89\t\tswitch arg {\n90\t\tcase \"--binary\":\n91\t\t\topts.binary = true\n92\t\tcase \"--text\":\n93\t\t\topts.binary = false\n94\t\tcase \"--tag\":\n95\t\t\topts.tag = true\n96\t\tcase \"--check\":\n97\t\t\topts.check = true\n98\t\tcase \"--warn\":\n99\t\t\topts.warn = true\n100\t\tcase \"--quiet\":\n101\t\t\topts.quiet = true\n102\t\tcase \"--status\":\n103\t\t\topts.status = true\n104\t\tdefault:\n105\t\t\treturn false, 0\n106\t\t}\n107\t\treturn true, 1\n108\t}\n109\t\n110\tfunc parseShortFlags(flags string, opts *options) int {\n111\t\tfor _, ch := range flags {\n112\t\t\tswitch ch {\n113\t\t\tcase 'b':\n114\t\t\t\topts.binary = true\n115\t\t\tcase 't':\n116\t\t\t\topts.binary = false\n117\t\t\tcase 'c':\n118\t\t\t\topts.check = true\n119\t\t\tcase 'w':\n120\t\t\t\topts.warn = true\n121\t\t\t}\n122\t\t}\n123\t\treturn 1\n124\t}\n125\t"}]},"parent_tool_use_id":null,"session_id":"7f1b0926-f3d6-48cd-808e-21c806523a9b","uuid":"0d6314bf-bb15-435c-b372-8203a75c3aca","timestamp":"2026-05-23T01:26:09.385Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5495/cmd/b2sum/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"hash\"\n\t\"os\"\n\t\"strings\"\n\n\t\"golang.org/x/crypto/blake2b\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nfunc newBLAKE2b() hash.Hash {\n\th, _ := blake2b.New512(nil)\n\treturn h\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, files := parseArgs(os.Args[1:])\n\tcfg := hashutil.HashConfig{\n\t\tAlgorithm: \"BLAKE2b\",\n\t\tNewHash:   newBLAKE2b,\n\t\tDigestLen: 64,\n\t}\n\tif opts.check {\n\t\tcheckOpts := hashutil.CheckOptions{\n\t\t\tWarn:   opts.warn,\n\t\t\tQuiet:  opts.quiet,\n\t\t\tStatus: opts.status,\n\t\t}\n\t\texitCode := 0\n\t\tfor _, f := range files {\n\t\t\tok, err := hashutil.VerifyChecksums(f, cfg, checkOpts, os.Stdout, os.Stderr)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: %s\\n\", err)\n\t\t\t\texitCode = 1\n\t\t\t} else if !ok {\n\t\t\t\texitCode = 1\n\t\t\t}\n\t\t}\n\t\tos.Exit(exitCode)\n\t}\n\tos.Exit(hashutil.DigestFiles(files, cfg, opts.binary, opts.tag, os.Stdout, os.Stderr))\n}\n\ntype options struct {\n\tbinary bool\n\ttag    bool\n\tcheck  bool\n\twarn   bool\n\tquiet  bool\n\tstatus bool\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar files []string\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif handled, advance := parseLongFlag(arg, &opts); handled {\n\t\t\ti += advance\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n\t\t\tfiles = append(files, arg)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\ti += parseShortFlags(arg[1:], &opts)\n\t}\n\treturn opts, files\n}\n\nfunc parseLongFlag(arg string, opts *options) (bool, int) {\n\tif !strings.HasPrefix(arg, \"--\") {\n\t\treturn false, 0\n\t}\n\tswitch arg {\n\tcase \"--binary\":\n\t\topts.binary = true\n\tcase \"--text\":\n\t\topts.binary = false\n\tcase \"--tag\":\n\t\topts.tag = true\n\tcase \"--check\":\n\t\topts.check = true\n\tcase \"--warn\":\n\t\topts.warn = true\n\tcase \"--quiet\":\n\t\topts.quiet = true\n\tcase \"--status\":\n\t\topts.status = true\n\tdefault:\n\t\treturn false, 0\n\t}\n\treturn true, 1\n}\n\nfunc parseShortFlags(flags string, opts *options) int {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase 'b':\n\t\t\topts.binary = true\n\t\tcase 't':\n\t\t\topts.binary = false\n\t\tcase 'c':\n\t\t\topts.check = true\n\t\tcase 'w':\n\t\t\topts.warn = true\n\t\t}\n\t}\n\treturn 1\n}\n","numLines":125,"startLine":1,"totalLines":125}}}
