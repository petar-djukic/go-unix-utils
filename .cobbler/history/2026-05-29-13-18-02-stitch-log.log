 err != nil {\n62\t\t\treturn err\n63\t\t}\n64\t\treturn writeAllFlags(ww, t.Lflag, lflags)\n65\t}\n66\t\n67\tfunc printSaveFormat(w io.Writer, t *unix.Termios) error {\n68\t\tif _, err := fmt.Fprintf(w, \"%x:%x:%x:%x\", t.Iflag, t.Oflag, t.Cflag, t.Lflag); err != nil {\n69\t\t\treturn err\n70\t\t}\n71\t\tfor _, v := range t.Cc {\n72\t\t\tif _, err := fmt.Fprintf(w, \":%x\", v); err != nil {\n73\t\t\t\treturn err\n74\t\t\t}\n75\t\t}\n76\t\t_, err := fmt.Fprintf(w, \":%x:%x\\n\", t.Ispeed, t.Ospeed)\n77\t\treturn err\n78\t}\n79\t\n80\tfunc speedLine(t *unix.Termios, rows, cols int) string {\n81\t\tif t.Ispeed != t.Ospeed && t.Ispeed != 0 {\n82\t\t\treturn fmt.Sprintf(\"ispeed %d baud; ospeed %d baud; rows %d; columns %d;\\n\",\n83\t\t\t\tt.Ispeed, t.Ospeed, rows, cols)\n84\t\t}\n85\t\treturn fmt.Sprintf(\"speed %d baud; rows %d; columns %d;\\n\", t.Ospeed, rows, cols)\n86\t}\n87\t\n88\tfunc csizeStr(cflag uint64) string {\n89\t\tswitch cflag & unix.CSIZE {\n90\t\tcase unix.CS5:\n91\t\t\treturn \"cs5\"\n92\t\tcase unix.CS6:\n93\t\t\treturn \"cs6\"\n94\t\tcase unix.CS7:\n95\t\t\treturn \"cs7\"\n96\t\tdefault:\n97\t\t\treturn \"\"\n98\t\t}\n99\t}\n100\t\n101\tfunc csizeAllStr(cflag uint64) string {\n102\t\tswitch cflag & unix.CSIZE {\n103\t\tcase unix.CS5:\n104\t\t\treturn \"cs5\"\n105\t\tcase unix.CS6:\n106\t\t\treturn \"cs6\"\n107\t\tcase unix.CS7:\n108\t\t\treturn \"cs7\"\n109\t\tdefault:\n110\t\t\treturn \"cs8\"\n111\t\t}\n112\t}\n113\t\n114\tfunc diffFlags(current uint64, flags []flagDef) []string {\n115\t\tvar result []string\n116\t\tfor _, f := range flags {\n117\t\t\tif f.sane == 0 {\n118\t\t\t\tcontinue\n119\t\t\t}\n120\t\t\tset := current&f.mask != 0\n121\t\t\tif f.sane == 1 && !set {\n122\t\t\t\tresult = append(result, \"-\"+f.name)\n123\t\t\t} else if f.sane == -1 && set {\n124\t\t\t\tresult = append(result, f.name)\n125\t\t\t}\n126\t\t}\n127\t\treturn result\n128\t}\n129\t\n130\tfunc diffCC(cc []uint8) []string {\n131\t\tvar result []string\n132\t\tfor _, c