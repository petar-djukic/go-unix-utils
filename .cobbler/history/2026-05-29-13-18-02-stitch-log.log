{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Tp4Z6342QNXSVHwsnjrFqM","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"strconv\"\n9\t\t\"strings\"\n10\t\n11\t\t\"golang.org/x/sys/unix\"\n12\t)\n13\t\n14\tfunc applySettings(fd int, t *unix.Termios, settings []string) error {\n15\t\tfor i := 0; i < len(settings); i++ {\n16\t\t\tn, err := applySetting(t, settings[i:])\n17\t\t\tif err != nil {\n18\t\t\t\treturn err\n19\t\t\t}\n20\t\t\ti += n - 1\n21\t\t}\n22\t\treturn unix.IoctlSetTermios(fd, unix.TIOCSETA, t)\n23\t}\n24\t\n25\tfunc applySetting(t *unix.Termios, args []string) (int, error) {\n26\t\ts := args[0]\n27\t\tif strings.Contains(s, \":\") {\n28\t\t\treturn 1, restoreFromSave(t, s)\n29\t\t}\n30\t\tif s == \"ispeed\" || s == \"ospeed\" {\n31\t\t\treturn applySpeedKeyword(t, s, args[1:])\n32\t\t}\n33\t\tnegate := strings.HasPrefix(s, \"-\")\n34\t\tname := s\n35\t\tif negate {\n36\t\t\tname = s[1:]\n37\t\t}\n38\t\tif applyFlag(t, name, negate) {\n39\t\t\treturn 1, nil\n40\t\t}\n41\t\tif !negate && applyCSize(t, name) {\n42\t\t\treturn 1, nil\n43\t\t}\n44\t\tif cc, ok := findCC(name); ok && !negate {\n45\t\t\treturn applyCharSetting(t, cc, args[1:])\n46\t\t}\n47\t\tif applyCombo(t, s) {\n48\t\t\treturn 1, nil\n49\t\t}\n50\t\tif n, err := strconv.ParseUint(s, 10, 64); err == nil {\n51\t\t\tif !validBaudRates[n] {\n52\t\t\t\treturn 0, fmt.Errorf(\"invalid argument '%s'\", s)\n53\t\t\t}\n54\t\t\tt.Ispeed = n\n55\t\t\tt.Ospeed = n\n56\t\t\treturn 1, nil\n57\t\t}\n58\t\treturn 0, fmt.Errorf(\"invalid argument '%s'\", s)\n59\t}\n60\t\n61\tfunc applyFlag(t *unix.Termios, name string, negate bool) bool {\n62\t\tif f, ok := findFlag(name, iflags); ok {\n63\t\t\ttoggleBit(&t.Iflag, f.mask, !negate)\n64\t\t\treturn true\n65\t\t}\n66\t\tif f, ok := findFlag(name, oflags); ok {\n67\t\t\ttoggleBit(&t.Oflag, f.mask, !negate)\n68\t\t\treturn true\n69\t\t}\n70\t\tif f, ok := findFlag(name, cflags); ok {\n71\t\t\ttoggleBit(&t.Cflag, f.mask, !negate)\n72\t\t\treturn true\n73\t\t}\n74\t\tif f, ok := findFlag(name, lflags); ok {\n75\t\t\ttoggleBit(&t.Lflag, f.mask, !negate)\n76\t\t\treturn true\n77\t\t}\n78\t\treturn false\n79\t}\n80\t\n81\tfunc findFlag(name string, flags []flagDef) (flagDef, bool) {\n82\t\tfor _, f := range flags {\n83\t\t\tif f.name == name {\n84\t\t\t\treturn f, true\n85\t\t\t}\n86\t\t}\n87\t\treturn flagDef{}, false\n88\t}\n89\t\n90\tfunc toggleBit(field *uint64, mask uint64, set bool) {\n91\t\tif set {\n92\t\t\t*field |= mask\n93\t\t} else {\n94\t\t\t*field &^= mask\n95\t\t}\n96\t}\n97\t\n98\tfunc applyCSize(t *unix.Termios, name string) bool {\n99\t\tvar val uint64\n100\t\tswitch name {\n101\t\tcase \"cs5\":\n102\t\t\tval = unix.CS5\n103\t\tcase \"cs6\":\n104\t\t\tval = unix.CS6\n105\t\tcase \"cs7\":\n106\t\t\tval = unix.CS7\n107\t\tcase \"cs8\":\n108\t\t\tval = unix.CS8\n109\t\tdefault:\n110\t\t\treturn false\n111\t\t}\n112\t\tt.Cflag = (t.Cflag &^ unix.CSIZE) | val\n113\t\treturn true\n114\t}\n115\t\n116\tfunc restoreFromSave(t *unix.Termios, s string) error {\n117\t\tparts := strings.Split(s, \":\")\n118\t\texpected := 4 + len(t.Cc) + 2\n119\t\tif len(parts) != expected {\n120\t\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n121\t\t}\n122\t\tvals, err := parseHexFields(parts)\n123\t\tif err != nil {\n124\t\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n125\t\t}\n126\t\tt.Iflag = vals[0]\n127\t\tt.Oflag = vals[1]\n128\t\tt.Cflag = vals[2]\n129\t\tt.Lflag = vals[3]\n130\t\tfor i := range t.Cc {\n131\t\t\tt.Cc[i] = uint8(vals[4+i])\n132\t\t}\n133\t\tt.Ispeed = vals[4+len(t.Cc)]\n134\t\tt.Ospeed = vals[4+len(t.Cc)+1]\n135\t\treturn nil\n136\t}\n137\t\n138\tfunc parseHexFields(parts []string) ([]uint64, error) {\n139\t\tvals := make([]uint64, len(parts))\n140\t\tfor i, p := range parts {\n141\t\t\tv, err := strconv.ParseUint(p, 16, 64)\n142\t\t\tif err != nil {\n143\t\t\t\treturn nil, err\n144\t\t\t}\n145\t\t\tvals[i] = v\n146\t\t}\n147\t\treturn vals, nil\n148\t}\n149\t\n150\tfunc findCC(name string) (ccDef, bool) {\n151\t\tfor _, c := range controlChars {\n152\t\t\tif c.name == name {\n153\t\t\t\treturn c, true\n154\t\t\t}\n155\t\t}\n156\t\treturn ccDef{}, false\n157\t}\n158\t\n159\tfunc applyCharSetting(t *unix.Termios, cc ccDef, rest []string) (int, error) {\n160\t\tif len(rest) < 1 {\n161\t\t\treturn 0, fmt.Errorf(\"missing argument to '%s'\", cc.name)\n162\t\t}\n163\t\tval, err := parseCharValue(rest[0])\n164\t\tif err != nil {\n165\t\t\treturn 0, err\n166\t\t}\n167\t\tt.Cc[cc.index] = val\n168\t\treturn 2, nil\n169\t}\n170\t\n171\tfunc parseCharValue(s string) (uint8, error) {\n172\t\tif s == \"^-\" || s == \"undef\" {\n173\t\t\treturn vdisable, nil\n174\t\t}\n175\t\tif len(s) == 2 && s[0] == '^' {\n176\t\t\tif s[1] == '?' {\n177\t\t\t\treturn 0x7f, nil\n178\t\t\t}\n179\t\t\treturn s[1] & 0x1f, nil\n180\t\t}\n181\t\tif len(s) == 1 {\n182\t\t\treturn s[0], nil\n183\t\t}\n184\t\tn, err := strconv.ParseUint(s, 0, 8)\n185\t\tif err != nil {\n186\t\t\treturn 0, fmt.Errorf(\"invalid integer argument '%s'\", s)\n187\t\t}\n188\t\treturn uint8(n), nil\n189\t}\n190\t\n191\tfunc applySpeedKeyword(t *unix.Termios, keyword string, rest []string) (int, error) {\n192\t\tif len(rest) < 1 {\n193\t\t\treturn 0, fmt.Errorf(\"missing argument to '%s'\", keyword)\n194\t\t}\n195\t\tn, err := strconv.ParseUint(rest[0], 10, 64)\n196\t\tif err != nil || !validBaudRates[n] {\n197\t\t\treturn 0, fmt.Errorf(\"invalid argument '%s'\", rest[0])\n198\t\t}\n199\t\tif keyword == \"ispeed\" {\n200\t\t\tt.Ispeed = n\n201\t\t} else {\n202\t\t\tt.Ospeed = n\n203\t\t}\n204\t\treturn 2, nil\n205\t}\n206\t\n207\tfunc applyCombo(t *unix.Termios, s string) bool {\n208\t\tswitch s {\n209\t\tcase \"sane\":\n210\t\t\tapplySane(t)\n211\t\tcase \"raw\":\n212\t\t\tapplyRaw(t)\n213\t\tcase \"cooked\", \"-raw\":\n214\t\t\tapplyCooked(t)\n215\t\tcase \"evenp\", \"parity\":\n216\t\t\tapplyEvenParity(t)\n217\t\tcase \"-evenp\", \"-parity\":\n218\t\t\tclearParity(t)\n219\t\tcase \"oddp\":\n220\t\t\tapplyOddParity(t)\n221\t\tcase \"-oddp\":\n222\t\t\tclearOddParity(t)\n223\t\tdefault:\n224\t\t\treturn false\n225\t\t}\n226\t\treturn true\n227\t}\n228\t\n229\tfunc applySane(t *unix.Termios) {\n230\t\tsetFlagsSane(&t.Cflag, cflags)\n231\t\tsetFlagsSane(&t.Iflag, iflags)\n232\t\tsetFlagsSane(&t.Oflag, oflags)\n233\t\tsetFlagsSane(&t.Lflag, lflags)\n234\t\tt.Cflag = (t.Cflag &^ unix.CSIZE) | unix.CS8\n235\t\tfor _, c := range controlChars {\n236\t\t\tt.Cc[c.index] = c.saneVal\n237\t\t}\n238\t}\n239\t\n240\tfunc setFlagsSane(field *uint64, flags []flagDef) {\n241\t\tfor _, f := range flags {\n242\t\t\tif f.sane == 1 {\n243\t\t\t\t*field |= f.mask\n244\t\t\t} else if f.sane == -1 {\n245\t\t\t\t*field &^= f.mask\n246\t\t\t}\n247\t\t}\n248\t}\n249\t\n250\tfunc applyRaw(t *unix.Termios) {\n251\t\tt.Iflag &^= unix.IGNBRK | unix.BRKINT | unix.PARMRK |\n252\t\t\tunix.ISTRIP | unix.INLCR | unix.IGNCR | unix.ICRNL | unix.IXON\n253\t\tt.Oflag &^= unix.OPOST\n254\t\tt.Lflag &^= unix.ECHO | unix.ECHONL | unix.ICANON |\n255\t\t\tunix.ISIG | unix.IEXTEN\n256\t\tt.Cflag = (t.Cflag &^ (unix.CSIZE | unix.PARENB)) | unix.CS8\n257\t\tt.Cc[unix.VMIN] = 1\n258\t\tt.Cc[unix.VTIME] = 0\n259\t}\n260\t\n261\tfunc applyCooked(t *unix.Termios) {\n262\t\tt.Iflag |= unix.BRKINT | unix.IGNPAR | unix.ISTRIP |\n263\t\t\tunix.ICRNL | unix.IXON\n264\t\tt.Oflag |= unix.OPOST\n265\t\tt.Lflag |= unix.ISIG | unix.ICANON\n266\t\tt.Cc[unix.VEOF] = 0x04\n267\t}\n268\t\n269\tfunc applyEvenParity(t *unix.Termios) {\n270\t\tt.Cflag = (t.Cflag &^ (unix.CSIZE | unix.PARODD)) | unix.CS7 | unix.PARENB\n271\t}\n272\t\n273\tfunc clearParity(t *unix.Termios) {\n274\t\tt.Cflag = (t.Cflag &^ (unix.CSIZE | unix.PARENB)) | unix.CS8\n275\t}\n276\t\n277\tfunc applyOddParity(t *unix.Termios) {\n278\t\tt.Cflag = (t.Cflag &^ unix.CSIZE) | unix.CS7 | unix.PARENB | unix.PARODD\n279\t}\n280\t\n281\tfunc clearOddParity(t *unix.Termios) {\n282\t\tt.Cflag = (t.Cflag &^ (unix.CSIZE | unix.PARENB | unix.PARODD)) | unix.CS8\n283\t}\n284\t"}]},"parent_tool_use_id":null,"session_id":"f584f668-1d5b-4e5a-b50f-af9f46c250c3","uuid":"5cb6e94f-5e6b-4082-9651-adb4d15b673c","timestamp":"2026-05-29T17:19:18.546Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5656/cmd/stty/settings.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"golang.org/x/sys/unix\"\n)\n\nfunc applySettings(fd int, t *unix.Termios, settings []string) error {\n\tfor i := 0; i < len(settings); i++ {\n\t\tn, err := applySetting(t, settings[i:])\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ti += n - 1\n\t}\n\treturn unix.IoctlSetTermios(fd, unix.TIOCSETA, t)\n}\n\nfunc applySetting(t *unix.Termios, args []string) (int, error) {\n\ts := args[0]\n\tif strings.Contains(s, \":\") {\n\t\treturn 1, restoreFromSave(t, s)\n\t}\n\tif s == \"ispeed\" || s == \"ospeed\" {\n\t\treturn applySpeedKeyword(t, s, args[1:])\n\t}\n\tnegate := strings.HasPrefix(s, \"-\")\n\tname := s\n\tif negate {\n\t\tname = s[1:]\n\t}\n\tif applyFlag(t, name, negate) {\n\t\treturn 1, nil\n\t}\n\tif !negate && applyCSize(t, name) {\n\t\treturn 1, nil\n\t}\n\tif cc, ok := findCC(name); ok && !negate {\n\t\treturn applyCharSetting(t, cc, args[1:])\n\t}\n\tif applyCombo(t, s) {\n\t\treturn 1, nil\n\t}\n\tif n, err := strconv.ParseUint(s, 10, 64); err == nil {\n\t\tif !validBaudRates[n] {\n\t\t\treturn 0, fmt.Errorf(\"invalid argument '%s'\", s)\n\t\t}\n\t\tt.Ispeed = n\n\t\tt.Ospeed = n\n\t\treturn 1, nil\n\t}\n\treturn 0, fmt.Errorf(\"invalid argument '%s'\", s)\n}\n\nfunc applyFlag(t *unix.Termios, name string, negate bool) bool {\n\tif f, ok := findFlag(name, iflags); ok {\n\t\ttoggleBit(&t.Iflag, f.mask, !negate)\n\t\treturn true\n\t}\n\tif f, ok := findFlag(name, oflags); ok {\n\t\ttoggleBit(&t.Oflag, f.mask, !negate)\n\t\treturn true\n\t}\n\tif f, ok := findFlag(name, cflags); ok {\n\t\ttoggleBit(&t.Cflag, f.mask, !negate)\n\t\treturn true\n\t}\n\tif f, ok := findFlag(name, lflags); ok {\n\t\ttoggleBit(&t.Lflag, f.mask, !negate)\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc findFlag(name string, flags []flagDef) (flagDef, bool) {\n\tfor _, f := range flags {\n\t\tif f.name == name {\n\t\t\treturn f, true\n\t\t}\n\t}\n\treturn flagDef{}, false\n}\n\nfunc toggleBit(field *uint64, mask uint64, set bool) {\n\tif set {\n\t\t*field |= mask\n\t} else {\n\t\t*field &^= mask\n\t}\n}\n\nfunc applyCSize(t *unix.Termios, name string) bool {\n\tvar val uint64\n\tswitch name {\n\tcase \"cs5\":\n\t\tval = unix.CS5\n\tcase \"cs6\":\n\t\tval = unix.CS6\n\tcase \"cs7\":\n\t\tval = unix.CS7\n\tcase \"cs8\":\n\t\tval = unix.CS8\n\tdefault:\n\t\treturn false\n\t}\n\tt.Cflag = (t.Cflag &^ unix.CSIZE) | val\n\treturn true\n}\n\nfunc restoreFromSave(t *unix.Termios, s string) error {\n\tparts := strings.Split(s, \":\")\n\texpected := 4 + len(t.Cc) + 2\n\tif len(parts) != expected {\n\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n\t}\n\tvals, err := parseHexFields(parts)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n\t}\n\tt.Iflag = vals[0]\n\tt.Oflag = vals[1]\n\tt.Cflag = vals[2]\n\tt.Lflag = vals[3]\n\tfor i := range t.Cc {\n\t\tt.Cc[i] = uint8(vals[4+i])\n\t}\n\tt.Ispeed = vals[4+len(t.Cc)]\n\tt.Ospeed = vals[4+len(t.Cc)+1]\n\treturn nil\n}\n\nfunc parseHexFields(parts []string) ([]uint64, error) {\n\tvals := make([]uint64, len(parts))\n\tfor i, p := range parts {\n\t\tv, err := strconv.ParseUint(p, 16, 64)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tvals[i] = v\n\t}\n\treturn vals, nil\n}\n\nfunc findCC(name string) (ccDef, bool) {\n\tfor _, c := range controlChars {\n\t\tif c.name == name {\n\t\t\treturn c, true\n\t\t}\n\t}\n\treturn ccDef{}, false\n}\n\nfunc applyCharSetting(t *unix.Termios, cc ccDef, rest []string) (int, error) {\n\tif len(rest) < 1 {\n\t\treturn 0, fmt.Errorf(\"missing argument to '%s'\", cc.name)\n\t}\n\tval, err := parseCharValue(rest[0])\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tt.Cc[cc.index] = val\n\treturn 2, nil\n}\n\nfunc parseCharValue(s string) (uint8, error) {\n\tif s == \"^-\" || s == \"undef\" {\n\t\treturn vdisable, nil\n\t}\n\tif len(s) == 2 && s[0] == '^' {\n\t\tif s[1] == '?' {\n\t\t\treturn 0x7f, nil\n\t\t}\n\t\treturn s[1] & 0x1f, nil\n\t}\n\tif len(s) == 1 {\n\t\treturn s[0], nil\n\t}\n\tn, err := strconv.ParseUint(s, 0, 8)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid integer argument '%s'\", s)\n\t}\n\treturn uint8(n), nil\n}\n\nfunc applySpeedKeyword(t *unix.Termios, keyword string, rest []string) (int, error) {\n\tif len(rest) < 1 {\n\t\treturn 0, fmt.Errorf(\"missing argument to '%s'\", keyword)\n\t}\n\tn, err := strconv.ParseUint(rest[0], 10, 64)\n\tif err != nil || !validBaudRates[n] {\n\t\treturn 0, fmt.Errorf(\"invalid argument '%s'\", rest[0])\n\t}\n\tif keyword == \"ispeed\" {\n\t\tt.Ispeed = n\n\t} else {\n\t\tt.Ospeed = n\n\t}\n\treturn 2, nil\n}\n\nfunc applyCombo(t *unix.Termios, s string) bool {\n\tswitch s {\n\tcase \"sane\":\n\t\tapplySane(t)\n\tcase \"raw\":\n\t\tapplyRaw(t)\n\tcase \"cooked\", \"-raw\":\n\t\tapplyCooked(t)\n\tcase \"evenp\", \"parity\":\n\t\tapplyEvenParity(t)\n\tcase \"-evenp\", \"-parity\":\n\t\tclearParity(t)\n\tcase \"oddp\":\n\t\tapplyOddParity(t)\n\tcase \"-oddp\":\n\t\tclearOddParity(t)\n\tdefault:\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc applySane(t *unix.Termios) {\n\tsetFlagsSane(&t.Cflag, cflags)\n\tsetFlagsSane(&t.Iflag, iflags)\n\tsetFlagsSane(&t.Oflag, oflags)\n\tsetFlagsSane(&t.Lflag, lflags)\n\tt.Cflag = (t.Cflag &^ unix.CSIZE) | unix.CS8\n\tfor _, c := range controlChars {\n\t\tt.Cc[c.index] = c.saneVal\n\t}\n}\n\nfunc setFlagsSane(field *uint64, flags []flagDef) {\n\tfor _, f := range flags {\n\t\tif f.sane == 1 {\n\t\t\t*field |= f.mask\n\t\t} else if f.sane == -1 {\n\t\t\t*field &^= f.mask\n\t\t}\n\t}\n}\n\nfunc applyRaw(t *unix.Termios) {\n\tt.Iflag &^= unix.IGNBRK | unix.BRKINT | unix.PARMRK |\n\t\tunix.ISTRIP | unix.INLCR | unix.IGNCR | unix.ICRNL | unix.IXON\n\tt.Oflag &^= unix.OPOST\n\tt.Lflag &^= unix.ECHO | unix.ECHONL | unix.ICANON |\n\t\tunix.ISIG | unix.IEXTEN\n\tt.Cflag = (t.Cflag &^ (unix.CSIZE | unix.PARENB)) | unix.CS8\n\tt.Cc[unix.VMIN] = 1\n\tt.Cc[unix.VTIME] = 0\n}\n\nfunc applyCooked(t *unix.Termios) {\n\tt.Iflag |= unix.BRKINT | unix.IGNPAR | unix.ISTRIP |\n\t\tunix.ICRNL | unix.IXON\n\tt.Oflag |= unix.OPOST\n\tt.Lflag |= unix.ISIG | unix.ICANON\n\tt.Cc[unix.VEOF] = 0x04\n}\n\nfunc applyEvenParity(t *unix.Termios) {\n\tt.Cflag = (t.Cflag &^ (unix.CSIZE | unix.PARODD)) | unix.CS7 | unix.PARENB\n}\n\nfunc clearParity(t *unix.Termios) {\n\tt.Cflag = (t.Cflag &^ (unix.CSIZE | unix.PARENB)) | unix.CS8\n}\n\nfunc applyOddParity(t *unix.Termios) {\n\tt.Cflag = (t.Cflag &^ unix.CSIZE) | unix.CS7 | unix.PARENB | unix.PARODD\n}\n\nfunc clearOddParity(t *unix.Termios) {\n\tt.Cflag = (t.Cflag &^ (unix.CSIZE | unix.PARENB | unix.PARODD)) | unix.CS8\n}\n","numLines":284,"startLine":1,"totalLines":284}}}
