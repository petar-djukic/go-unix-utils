{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013fTmgBn8dDDxJGneiSpHXx","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd105-stty R1.1, R2.1, R3.1, R3.2, R4.1, R5.1, R6.1, R6.2, R7.1.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"strings\"\n11\t\n12\t\t\"golang.org/x/sys/unix\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: stty [-F DEVICE | --file=DEVICE] [SETTING]...\n18\t  or:  stty [-F DEVICE | --file=DEVICE] [-a|--all]\n19\t  or:  stty [-F DEVICE | --file=DEVICE] [-g|--save]\n20\tPrint or change terminal line settings.\n21\t\n22\t      --help     display this help and exit\n23\t      --version  output version information and exit\n24\t`\n25\t\n26\tconst versionText = `stty (go-unix-utils) dev\n27\t`\n28\t\n29\ttype options struct {\n30\t\tshowAll  bool\n31\t\tsave     bool\n32\t\tdevice   string\n33\t\tsettings []string\n34\t}\n35\t\n36\tfunc main() {\n37\t\tsys.InstallSIGPIPEHandler()\n38\t\topts := parseArgs(os.Args[1:])\n39\t\tfd, closer := openFD(opts.device)\n40\t\tif closer != nil {\n41\t\t\tdefer closer()\n42\t\t}\n43\t\tt, err := unix.IoctlGetTermios(fd, unix.TIOCGETA)\n44\t\tif err != nil {\n45\t\t\texitTermiosErr(opts.device, err)\n46\t\t}\n47\t\tif err := run(fd, t, opts); err != nil {\n48\t\t\tfmt.Fprintf(os.Stderr, \"stty: %v\\n\", err)\n49\t\t\tos.Exit(1)\n50\t\t}\n51\t}\n52\t\n53\tfunc run(fd int, t *unix.Termios, opts options) error {\n54\t\tif len(opts.settings) > 0 {\n55\t\t\treturn applySettings(fd, t, opts.settings)\n56\t\t}\n57\t\trows, cols := getWinSize(fd)\n58\t\tif opts.save {\n59\t\t\treturn printSaveFormat(os.Stdout, t)\n60\t\t}\n61\t\tif opts.showAll {\n62\t\t\treturn printAllDisplay(os.Stdout, t, rows, cols)\n63\t\t}\n64\t\treturn printDefaultDisplay(os.Stdout, t, rows, cols)\n65\t}\n66\t\n67\tfunc parseArgs(args []string) options {\n68\t\tvar opts options\n69\t\tfor i := 0; i < len(args); i++ {\n70\t\t\tswitch arg := args[i]; {\n71\t\t\tcase arg == \"--help\":\n72\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n73\t\t\t\tos.Exit(0)\n74\t\t\tcase arg == \"--version\":\n75\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n76\t\t\t\tos.Exit(0)\n77\t\t\tcase arg == \"-a\" || arg == \"--all\":\n78\t\t\t\topts.showAll = true\n79\t\t\tcase arg == \"-g\" || arg == \"--save\":\n80\t\t\t\topts.save = true\n81\t\t\tcase arg == \"-F\" || arg == \"--file\":\n82\t\t\t\ti++\n83\t\t\t\tif i >= len(args) {\n84\t\t\t\t\tfmt.Fprintf(os.Stderr, \"stty: option requires an argument -- 'F'\\n\")\n85\t\t\t\t\tos.Exit(1)\n86\t\t\t\t}\n87\t\t\t\topts.device = args[i]\n88\t\t\tcase strings.HasPrefix(arg, \"--file=\"):\n89\t\t\t\topts.device = arg[len(\"--file=\"):]\n90\t\t\tdefault:\n91\t\t\t\topts.settings = append(opts.settings, arg)\n92\t\t\t}\n93\t\t}\n94\t\treturn opts\n95\t}\n96\t\n97\tfunc openFD(device string) (int, func()) {\n98\t\tif device == \"\" {\n99\t\t\treturn int(os.Stdin.Fd()), nil\n100\t\t}\n101\t\tfd, err := unix.Open(device, unix.O_RDONLY|unix.O_NONBLOCK, 0)\n102\t\tif err != nil {\n103\t\t\tfmt.Fprintf(os.Stderr, \"stty: %s: %s\\n\", device, sysErr(err))\n104\t\t\tos.Exit(1)\n105\t\t}\n106\t\treturn fd, func() { unix.Close(fd) }\n107\t}\n108\t\n109\tfunc exitTermiosErr(device string, err error) {\n110\t\tdev := \"'standard input'\"\n111\t\tif device != \"\" {\n112\t\t\tdev = device\n113\t\t}\n114\t\tfmt.Fprintf(os.Stderr, \"stty: %s: %s\\n\", dev, sysErr(err))\n115\t\tos.Exit(1)\n116\t}\n117\t\n118\tfunc sysErr(err error) string {\n119\t\ts := err.Error()\n120\t\tif s == \"\" {\n121\t\t\treturn s\n122\t\t}\n123\t\treturn strings.ToUpper(s[:1]) + s[1:]\n124\t}\n125\t"}]},"parent_tool_use_id":null,"session_id":"f584f668-1d5b-4e5a-b50f-af9f46c250c3","uuid":"c3d4f8b1-6d74-44a0-9c45-b18b1bcdee49","timestamp":"2026-05-29T17:18:15.677Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5656/cmd/stty/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd105-stty R1.1, R2.1, R3.1, R3.2, R4.1, R5.1, R6.1, R6.2, R7.1.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n\n\t\"golang.org/x/sys/unix\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: stty [-F DEVICE | --file=DEVICE] [SETTING]...\n  or:  stty [-F DEVICE | --file=DEVICE] [-a|--all]\n  or:  stty [-F DEVICE | --file=DEVICE] [-g|--save]\nPrint or change terminal line settings.\n\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `stty (go-unix-utils) dev\n`\n\ntype options struct {\n\tshowAll  bool\n\tsave     bool\n\tdevice   string\n\tsettings []string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts := parseArgs(os.Args[1:])\n\tfd, closer := openFD(opts.device)\n\tif closer != nil {\n\t\tdefer closer()\n\t}\n\tt, err := unix.IoctlGetTermios(fd, unix.TIOCGETA)\n\tif err != nil {\n\t\texitTermiosErr(opts.device, err)\n\t}\n\tif err := run(fd, t, opts); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"stty: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc run(fd int, t *unix.Termios, opts options) error {\n\tif len(opts.settings) > 0 {\n\t\treturn applySettings(fd, t, opts.settings)\n\t}\n\trows, cols := getWinSize(fd)\n\tif opts.save {\n\t\treturn printSaveFormat(os.Stdout, t)\n\t}\n\tif opts.showAll {\n\t\treturn printAllDisplay(os.Stdout, t, rows, cols)\n\t}\n\treturn printDefaultDisplay(os.Stdout, t, rows, cols)\n}\n\nfunc parseArgs(args []string) options {\n\tvar opts options\n\tfor i := 0; i < len(args); i++ {\n\t\tswitch arg := args[i]; {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"-a\" || arg == \"--all\":\n\t\t\topts.showAll = true\n\t\tcase arg == \"-g\" || arg == \"--save\":\n\t\t\topts.save = true\n\t\tcase arg == \"-F\" || arg == \"--file\":\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"stty: option requires an argument -- 'F'\\n\")\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\topts.device = args[i]\n\t\tcase strings.HasPrefix(arg, \"--file=\"):\n\t\t\topts.device = arg[len(\"--file=\"):]\n\t\tdefault:\n\t\t\topts.settings = append(opts.settings, arg)\n\t\t}\n\t}\n\treturn opts\n}\n\nfunc openFD(device string) (int, func()) {\n\tif device == \"\" {\n\t\treturn int(os.Stdin.Fd()), nil\n\t}\n\tfd, err := unix.Open(device, unix.O_RDONLY|unix.O_NONBLOCK, 0)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"stty: %s: %s\\n\", device, sysErr(err))\n\t\tos.Exit(1)\n\t}\n\treturn fd, func() { unix.Close(fd) }\n}\n\nfunc exitTermiosErr(device string, err error) {\n\tdev := \"'standard input'\"\n\tif device != \"\" {\n\t\tdev = device\n\t}\n\tfmt.Fprintf(os.Stderr, \"stty: %s: %s\\n\", dev, sysErr(err))\n\tos.Exit(1)\n}\n\nfunc sysErr(err error) string {\n\ts := err.Error()\n\tif s == \"\" {\n\t\treturn s\n\t}\n\treturn strings.ToUpper(s[:1]) + s[1:]\n}\n","numLines":125,"startLine":1,"totalLines":125}}}
