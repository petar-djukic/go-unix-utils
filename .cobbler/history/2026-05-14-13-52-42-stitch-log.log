:    \"silent-long-multi-file\",\n194\t\t\t\tArgs:    []string{\"--silent\", \"a.txt\", \"b.txt\"},\n195\t\t\t\tWorkDir: dir,\n196\t\t\t},\n197\t\t\t// R3.4: -v forces header on single file\n198\t\t\t{\n199\t\t\t\tName:    \"verbose-single-file\",\n200\t\t\t\tArgs:    []string{\"-v\", \"a.txt\"},\n201\t\t\t\tWorkDir: dir,\n202\t\t\t},\n203\t\t\t// R3.4: --verbose long form\n204\t\t\t{\n205\t\t\t\tName:    \"verbose-long-single-file\",\n206\t\t\t\tArgs:    []string{\"--verbose\", \"a.txt\"},\n207\t\t\t\tWorkDir: dir,\n208\t\t\t},\n209\t\t\t// R3.4: -v with multiple files\n210\t\t\t{\n211\t\t\t\tName:    \"verbose-multi-file\",\n212\t\t\t\tArgs:    []string{\"-v\", \"a.txt\", \"b.txt\"},\n213\t\t\t\tWorkDir: dir,\n214\t\t\t},\n215\t\t\t// R3.3+R3.4: last -q/-v wins\n216\t\t\t{\n217\t\t\t\tName:    \"quiet-then-verbose\",\n218\t\t\t\tArgs:    []string{\"-q\", \"-v\", \"a.txt\"},\n219\t\t\t\tWorkDir: dir,\n220\t\t\t},\n221\t\t\t{\n222\t\t\t\tName:    \"verbose-then-quiet\",\n223\t\t\t\tArgs:    []string{\"-v\", \"-q\", \"a.txt\", \"b.txt\"},\n224\t\t\t\tWorkDir: dir,\n225\t\t\t},\n226\t\t\t// R3.1: multi-file with -n\n227\t\t\t{\n228\t\t\t\tName:    \"multi-file-with-n\",\n229\t\t\t\tArgs:    []string{\"-n\", \"1\", \"a.txt\", \"b.txt\"},\n230\t\t\t\tWorkDir: dir,\n231\t\t\t},\n232\t\t\t// R3.1: multi-file with -c\n233\t\t\t{\n234\t\t\t\tName:    \"multi-file-with-c\",\n235\t\t\t\tArgs:    []string{\"-c\", \"3\", \"a.txt\", \"b.txt\"},\n236\t\t\t\tWorkDir: dir,\n237\t\t\t},\n238\t\t\t// R3.5: error on non-existent file continues processing\n239\t\t\t{\n240\t\t\t\tName:      \"nonexistent-with-valid\",\n241\t\t\t\tArgs:      []string{\"nonexistent.txt\", \"a.txt\"},\n242\t\t\t\tWorkDir:   dir,\n243\t\t\t\tExitCode:  1,\n244\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n245\t\t\t},\n246\t\t\t// R3.5+R4.2: valid file then nonexistent\n247\t\t\t{\n248\t\t\t\tName:      \"valid-then-nonexistent\",\n249\t\t\t\tArgs:      []string{\"a.txt\", \"nonexistent.txt\"}