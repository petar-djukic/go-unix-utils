\t\t\t{\n67\t\t\t\tName:  \"line-count-exceeds-input\",\n68\t\t\t\tArgs:  []string{\"-n\", \"100\"},\n69\t\t\t\tStdin: []byte(\"one\\ntwo\\n\"),\n70\t\t\t},\n71\t\t\t{\n72\t\t\t\tName:  \"line-no-trailing-newline-negative\",\n73\t\t\t\tArgs:  []string{\"-n\", \"-1\"},\n74\t\t\t\tStdin: []byte(\"a\\nb\\nc\"),\n75\t\t\t},\n76\t\n77\t\t\t// R2.1: -c NUM byte count\n78\t\t\t{\n79\t\t\t\tName:  \"bytes-5\",\n80\t\t\t\tArgs:  []string{\"-c\", \"5\"},\n81\t\t\t\tStdin: []byte(\"abcdefghij\"),\n82\t\t\t},\n83\t\t\t{\n84\t\t\t\tName:  \"bytes-exceeds-input\",\n85\t\t\t\tArgs:  []string{\"-c\", \"100\"},\n86\t\t\t\tStdin: []byte(\"short\"),\n87\t\t\t},\n88\t\t\t{\n89\t\t\t\tName:  \"bytes-zero\",\n90\t\t\t\tArgs:  []string{\"-c\", \"0\"},\n91\t\t\t\tStdin: []byte(\"hello\"),\n92\t\t\t},\n93\t\n94\t\t\t// R2.1: -c and -n mutual exclusivity (last wins)\n95\t\t\t{\n96\t\t\t\tName:  \"bytes-after-lines\",\n97\t\t\t\tArgs:  []string{\"-n\", \"2\", \"-c\", \"5\"},\n98\t\t\t\tStdin: []byte(\"abcdefghij\\nklmnop\\n\"),\n99\t\t\t},\n100\t\t\t{\n101\t\t\t\tName:  \"lines-after-bytes\",\n102\t\t\t\tArgs:  []string{\"-c\", \"5\", \"-n\", \"1\"},\n103\t\t\t\tStdin: []byte(\"abcdefghij\\nklmnop\\n\"),\n104\t\t\t},\n105\t\n106\t\t\t// R2.2: negative byte count\n107\t\t\t{\n108\t\t\t\tName:  \"bytes-negative\",\n109\t\t\t\tArgs:  []string{\"-c\", \"-3\"},\n110\t\t\t\tStdin: []byte(\"abcdefghij\"),\n111\t\t\t},\n112\t\t\t{\n113\t\t\t\tName:  \"bytes-negative-exceeds-input\",\n114\t\t\t\tArgs:  []string{\"-c\", \"-100\"},\n115\t\t\t\tStdin: []byte(\"short\"),\n116\t\t\t},\n117\t\n118\t\t\t// R2.3: multiplier suffixes\n119\t\t\t{\n120\t\t\t\tName:  \"bytes-suffix-b\",\n121\t\t\t\tArgs:  []string{\"-c\", \"1b\"},\n122\t\t\t\tStdin: bytes512(),\n123\t\t\t},\n124\t\t\t{\n125\t\t\t\tName:  \"bytes-long-form\",\n126\t\t\t\tArgs:  []string{\"--bytes=5\"},\n127\t\t\t\tStdin: []byte(\"abcdefghij\"),\n128\t\t\t},\n129\t\t\t{\n130\t\t\t\tName:  \"bytes-long-form-negative\",\n131\t\t\t\tArgs:  []string{\"