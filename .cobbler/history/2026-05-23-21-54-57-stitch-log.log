oupB.gid), \"file\"},\n60\t\t\t\t\tWorkDir: workDir,\n61\t\t\t\t},\n62\t\t\t})\n63\t\t\tverifyGroup(t, filepath.Join(workDir, \"file\"), groupB.gid)\n64\t\t})\n65\t\n66\t\tt.Run(\"owner_and_group\", func(t *testing.T) {\n67\t\t\tworkDir := t.TempDir()\n68\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n69\t\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n70\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n71\t\t\t\t{\n72\t\t\t\t\tName:      \"owner_group\",\n73\t\t\t\t\tArgs:      []string{cur.Username + \":\" + groupB.name, \"file\"},\n74\t\t\t\t\tWorkDir:   workDir,\n75\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n76\t\t\t\t},\n77\t\t\t})\n78\t\t})\n79\t\n80\t\tt.Run(\"owner_with_login_group\", func(t *testing.T) {\n81\t\t\tworkDir := t.TempDir()\n82\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n83\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n84\t\t\t\t{\n85\t\t\t\t\tName:      \"login_group\",\n86\t\t\t\t\tArgs:      []string{cur.Username + \":\", \"file\"},\n87\t\t\t\t\tWorkDir:   workDir,\n88\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n89\t\t\t\t},\n90\t\t\t})\n91\t\t})\n92\t\n93\t\tt.Run(\"owner_only\", func(t *testing.T) {\n94\t\t\tworkDir := t.TempDir()\n95\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n96\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n97\t\t\t\t{\n98\t\t\t\t\tName:      \"owner\",\n99\t\t\t\t\tArgs:      []string{cur.Username, \"file\"},\n100\t\t\t\t\tWorkDir:   workDir,\n101\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n102\t\t\t\t},\n103\t\t\t})\n104\t\t})\n105\t\n106\t\tt.Run(\"multiple_files\", func(t *testing.T) {\n107\t\t\tworkDir := t.TempDir()\n108\t\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n109\t\t\t\tos.WriteFile(filepath.Join(workDir, name), []byte(\"x\"), 0o644)\n110\t\t\t\tsetGroup(t, filepath.Join(workDir, name), groupA.gid)\n111\t\t\t}\n112\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n113\t\t\t\t{\n114\t\t\t\t\tName:    \"three_files\",\n115\t\t\t\t\tArgs:    []string{\":\" + groupB.name, \"a\", \"b\", \"c\"},\n116\t\t\t\t\tWorkDir: workDir,\n117\t\t\t\t},\n118\t\t\t})\n119\t\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n120\t\t\t\tverifyGroup(t, filepath.Join(workDir, name), groupB.gid)\n121\t\t\t}\n122\t\t})\n123\t\n124\t\tt.Run(\"reference_file\", func(t *testing.T) {\n125\t\t\tworkDir := t.TempDir()\n126\t\t\tos.WriteFile(filepath.Join(workDir, \"ref\"), []byte(\"r\"), 0o644)\n127\t\t\tsetGroup(t, filepath.Join(workDir, \"ref\"), groupB.gid)\n128\t\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"t\"), 0o644)\n129\t\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n130\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n131\t\t\t\t{\n132\t\t\t\t\tName:      \"reference\",\n133\t\t\t\t\tArgs:      []string{\"--reference=ref\", \"target\"},\n134\t\t\t\t\tWorkDir:   workDir,\n135\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n136\t\t\t\t},\n137\t\t\t})\n138\t\t})\n139\t\n140\t\tt.Run(\"invalid_user\", func(t *testing.T) {\n141\t\t\tworkDir := t.TempDir()\n142\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n143\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n144\t\t\t\t{\n145\t\t\t\t\tName:      \"bad_user\",\n146\t\t\t\t\tArgs:      []string{\"nonexistent_user_xyz\", \"file\"},\n147\t\t\t\t\tWorkDir:   workDir,\n148\t\t\t\t\tExitCode:  1,\n149\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n150\t\t\t\t},\n151\t\t\t})\n152\t\t})\n153\t\n154\t\tt.Run(\"invalid_group\", func(t *testing.T) {\n155\t\t\tworkDir := t.TempDir()\n156\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n157\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n158\t\t\t\t{\n159\t\t\t\t\tName:      \"bad_group\",\n160\t\t\t\t\tArgs:      []string{\":nonexistent_group_xyz\", \"file\"},\n161\t\t\t\t\tWorkDir:   workDir,\n162\t\t\t\t\tExitCode:  1,\n163\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n164\t\t\t\t},\n165\t\t\t})\n166\t\t})\n167\t\n168\t\tt.Run(\"missing_operand\", func(t *testing.T) {\n169\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n170\t\t\t\t{\n171\t\t\t\t\tName:      \"no_args\",\n172\t\t\t\t\tArgs:      []string{},\n173\t\t\t\t\tExitCode:  1,\n174\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n175\t\t\t\t},\n176\t\t\t})\n177\t\t})\n178\t\n179\t\tt.Run(\"missing_file_operand\", func(t *testing.T) {\n180\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n181\t\t\t\t{\n182\t\t\t\t\tName:      \"owner_only\",\n183\t\t\t\t\tArgs:      []string{cur.Username},\n184\t\t\t\t\tExitCode:  1,\n185\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n186\t\t\t\t},\n187\t\t\t})\n188\t\t})\n189\t\n190\t\tt.Run(\"nonexistent_file\", func(t *testing.T) {\n191\t\t\tworkDir := t.TempDir()\n192\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n193\t\t\t\t{\n194\t\t\t\t\tName:      \"no_such_file\",\n195\t\t\t\t\tArgs:      []string{\":\" + groupA.name, \"does_not_exist\"},\n196\t\t\t\t\tWorkDir:   workDir,\n197\t\t\t\t\tExitCode:  1,\n198\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n199\t\t\t\t},\n200\t\t\t})\n201\t\t})\n202\t\n203\t\tt.Run(\"partial_failure\", func(t *testing.T) {\n204\t\t\tworkDir := t.TempDir()\n205\t\t\tos.WriteFile(filepath.Join(workDir, \"good\"), []byte(\"x\"), 0o644)\n206\t\t\tsetGroup(t, filepath.Join(workDir, \"good\"), groupA.gid)\n207\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n208\t\t\t\t{\n209\t\t\t\t\tName:      \"one_good_one_bad\",\n210\t\t\t\t\tArgs:      []string{\":\" + groupB.name, \"good\", \"missing\"},\n211\t\t\t\t\tWorkDir:   workDir,\n212\t\t\t\t\tExitCode:  1,\n213\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n214\t\t\t\t},\n215\t\t\t})\n216\t\t\tverifyGroup(t, filepath.Join(workDir, \"good\"), groupB.gid)\n217\t\t})\n218\t\n219\t\tt.Run(\"recursive_directory\", func(t *testing.T) {\n220\t\t\tworkDir := t.TempDir()\n221\t\t\tos.MkdirAll(filepath.Join(workDir, \"d\", \"sub\"), 0o755)\n222\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n223\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"sub\", \"f2\"), []byte(\"x\"), 0o644)\n224\t\t\tsetGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid)\n225\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n226\t\t\t\t{\n227\t\t\t\t\tName:    \"recursive\",\n228\t\t\t\t\tArgs:    []string{\"-R\", \":\" + groupB.name, \"d\"},\n229\t\t\t\t\tWorkDir: workDir,\n230\t\t\t\t},\n231\t\t\t})\n232\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n233\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"f1\"), groupB.gid)\n234\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sub\"), groupB.gid)\n235\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sub\", \"f2\"), groupB.gid)\n236\t\t})\n237\t\n238\t\tt.Run(\"no_dereference_symlink\", func(t *testing.T) {\n239\t\t\tworkDir := t.TempDir()\n240\t\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"x\"), 0o644)\n241\t\t\tos.Symlink(\"target\", filepath.Join(workDir, \"link\"))\n242\t\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n243\t\t\tsetGroup(t, filepath.Join(workDir, \"link\"), groupA.gid)\n244\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n245\t\t\t\t{\n246\t\t\t\t\tName:      \"h_flag\",\n247\t\t\t\t\tArgs:      []string{\"-h\", \":\" + groupB.name, \"link\"},\n248\t\t\t\t\tWorkDir:   workDir,\n249\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n250\t\t\t\t},\n251\t\t\t})\n252\t\t\tverifyGroup(t, filepath.Join(workDir, \"link\"), groupB.gid)\n253\t\t\tverifyGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n254\t\t})\n255\t\n256\t\tt.Run(\"recursive_P_mode\", func(t *testing.T) {\n257\t\t\tworkDir := t.TempDir()\n258\t\t\tos.MkdirAll(filepath.Join(workDir, \"d\"), 0o755)\n259\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"real\"), []byte(\"x\"), 0o644)\n260\t\t\tos.Symlink(\"real\", filepath.Join(workDir, \"d\", \"sym\"))\n261\t\t\tsetGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid)\n262\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n263\t\t\t\t{\n264\t\t\t\t\tName:      \"P_flag\",\n265\t\t\t\t\tArgs:      []string{\"-R\", \"-P\", \":\" + groupB.name, \"d\"},\n266\t\t\t\t\tWorkDir:   workDir,\n267\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n268\t\t\t\t},\n269\t\t\t})\n270\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n271\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"real\"), groupB.gid)\n272\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sym\"), groupB.gid)\n273\t\t})\n274\t}\n275\t\n276\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?chown\\b`)\n277\t\n278\tfunc normalizeBinaryName(b []byte) []byte {\n279\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"chown\"))\n280\t}\n281\t\n282\tvar errorVerbRe = regexp.MustCompile(\n283\t\t`(cannot access|changing ownership of)`,\n284\t)\n285\t\n286\tfunc normalizeErrorVerb(b []byte) []byte {\n287\t\tout := errorVerbRe.ReplaceAll(b, []byte(\"ERROR_VERB\"))\n288\t\tout = normalizeErrnoCase(out)\n289\t\treturn out\n290\t}\n291\t\n292\tvar errnoRe = regexp.MustCompile(`(?i)(no such file or directory|permission denied|operation not permitted)`)\n293\t\n294\tfunc normalizeErrnoCase(b []byte) []byte {\n295\t\treturn errnoRe.ReplaceAllFunc(b, func(m []byte) []byte {\n296\t\t\tlower := make([]byte, len(m))\n297\t\t\tfor i, c := range m {\n298\t\t\t\tif c >= 'A' && c <= 'Z' {\n299\t\t\t\t\tlower[i] = c + 32\n300\t\t\t\t} else {\n301\t\t\t\t\tlower[i] = c\n302\t\t\t\t}\n303\t\t\t}\n304\t\t\treturn lower\n305\t\t})\n306\t}\n307\t\n308\ttype groupInfo struct {\n309\t\tname string\n310\t\tgid  int\n311\t}\n312\t\n313\tfunc testGroups(t *testing.T) []groupInfo {\n314\t\tt.Helper()\n315\t\tcur, err := user.Current()\n316\t\tif err != nil {\n317\t\t\tt.Fatalf(\"user.Current: %v\", err)\n318\t\t}\n319\t\tgids, err := cur.GroupIds()\n320\t\tif err != nil {\n321\t\t\tt.Fatalf(\"GroupIds: %v\", err)\n322\t\t}\n323\t\tvar groups []groupInfo\n324\t\tfor _, gidStr := range gids {\n325\t\t\tgid, err := strconv.Atoi(gidStr)\n326\t\t\tif err != nil {\n327\t\t\t\tcontinue\n328\t\t\t}\n329\t\t\tg, err := user.LookupGroupId(gidStr)\n330\t\t\tif err != nil {\n331\t\t\t\tcontinue\n332\t\t\t}\n333\t\t\tgroups = append(groups, groupInfo{name: g.Name, gid: gid})\n334\t\t\tif len(groups) == 2 {\n335\t\t\t\tbreak\n336\t\t\t}\n337\t\t}\n338\t\treturn groups\n339\t}\n340\t\n341\tfunc setGroup(t *testing.T, path string, gid int) {\n342\t\tt.Helper()\n343\t\tif err := os.Lchown(path, -1, gid); err != nil {\n344\t\t\tt.Fatalf(\"setGroup(%s, %d): %v\", path, gid, err)\n345\t\t}\n346\t}\n347\t\n348\tfunc setGroupRecursive(t *testing.T, root string, gid int) {\n349\t\tt.Helper()\n350\t\tfilepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n351\t\t\tif err != nil {\n352\t\t\t\treturn err\n353\t\t\t}\n354\t\t\treturn os.Lchown(path, -1, gid)\n355\t\t})\n356\t}\n357\t\n358\tfunc verifyGroup(t *testing.T, path string, expectedGID int) {\n359\t\tt.Helper()\n360\t\tinfo, err := os.Lstat(path)\n361\t\tif err != nil {\n362\t\t\tt.Fatalf(\"Lstat(%s): %v\", path, err)\n363\t\t}\n364\t\tstat, ok := info.Sys().(*syscall.Stat_t)\n365\t\tif !ok {\n366\t\t\tt.Fatal(\"Sys() is not *syscall.Stat_t\")\n367\t\t}\n368\t\tif int(stat.Gid) != expectedGID {\n369\t\t\tt.Errorf(\"group of %s: got %d, want %d\", path, stat.Gid, expectedGID)\n370\t\t}\n371\t}\n372\t\n373\tfunc TestHelp(t *testing.T) {\n374\t\tgoBin := testutils.BuildBinary(t, \".\")\n375\t\tcmd := exec.Command(goBin, \"--help\")\n376\t\tout, err := cmd.Output()\n377\t\tif err != nil {\n378\t\t\tt.Fatalf(\"--help failed: %v\", err)\n379\t\t}\n380\t\tif len(out) == 0 {\n381\t\t\tt.Fatal(\"--help produced no output\")\n382\t\t}\n383\t}\n384\t\n385\tfunc TestVersion(t *testing.T) {\n386\t\tgoBin := testutils.BuildBinary(t, \".\")\n387\t\tcmd := exec.Command(goBin, \"--version\")\n388\t\tout, err := cmd.Output()\n389\t\tif err != nil {\n390\t\t\tt.Fatalf(\"--version failed: %v\", err)\n391\t\t}\n392\t\tif len(out) == 0 {\n393\t\t\tt.Fatal(\"--version produced no output\")\n394\t\t}\n395\t}\n396\t\n397\tfunc TestReferenceNonexistent(t *testing.T) {\n398\t\tgoBin := testutils.BuildBinary(t, \".\")\n399\t\tcmd := exec.Command(goBin, \"--reference=/tmp/no_such_ref_file_xyz\", \"somefile\")\n400\t\tcmd.Dir = t.TempDir()\n401\t\tout, err := cmd.CombinedOutput()\n402\t\tif err == nil {\n403\t\t\tt.Fatal(\"expected error for nonexistent reference file\")\n404\t\t}\n405\t\t_ = out\n406\t\texitCode := cmd.ProcessState.ExitCode()\n407\t\tif exitCode != 1 {\n408\t\t\tt.Errorf(\"exit code: got %d, want 1\", exitCode)\n409\t\t}\n410\t}\n411\t"}]},"parent_tool_use_id":null,"session_id":"a39bb1de-8019-4cee-97a2-987b3a588d8f","uuid":"1ef68366-7c21-4a30-9d2f-cc254ac66a4f","timestamp":"2026-05-24T01:55:09.784Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5558/cmd/chown/chown_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"os\"\n\t\"os/exec\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"syscall\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gchown\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gchown not found\")\n\t}\n\n\tcur, err := user.Current()\n\tif err != nil {\n\t\tt.Fatalf(\"user.Current: %v\", err)\n\t}\n\n\tgroups := testGroups(t)\n\tif len(groups) < 2 {\n\t\tt.Skip(\"need at least two groups for testing\")\n\t}\n\tgroupA := groups[0]\n\tgroupB := groups[1]\n\n\tt.Run(\"colon_group\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"change_by_name\",\n\t\t\t\tArgs:    []string{\":\" + groupB.name, \"file\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"file\"), groupB.gid)\n\t})\n\n\tt.Run(\"colon_numeric_gid\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"change_by_gid\",\n\t\t\t\tArgs:    []string{\":\" + strconv.Itoa(groupB.gid), \"file\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"file\"), groupB.gid)\n\t})\n\n\tt.Run(\"owner_and_group\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"owner_group\",\n\t\t\t\tArgs:      []string{cur.Username + \":\" + groupB.name, \"file\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"owner_with_login_group\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"login_group\",\n\t\t\t\tArgs:      []string{cur.Username + \":\", \"file\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"owner_only\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"owner\",\n\t\t\t\tArgs:      []string{cur.Username, \"file\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"multiple_files\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n\t\t\tos.WriteFile(filepath.Join(workDir, name), []byte(\"x\"), 0o644)\n\t\t\tsetGroup(t, filepath.Join(workDir, name), groupA.gid)\n\t\t}\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"three_files\",\n\t\t\t\tArgs:    []string{\":\" + groupB.name, \"a\", \"b\", \"c\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n\t\t\tverifyGroup(t, filepath.Join(workDir, name), groupB.gid)\n\t\t}\n\t})\n\n\tt.Run(\"reference_file\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"ref\"), []byte(\"r\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"ref\"), groupB.gid)\n\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"t\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"reference\",\n\t\t\t\tArgs:      []string{\"--reference=ref\", \"target\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"invalid_user\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"bad_user\",\n\t\t\t\tArgs:      []string{\"nonexistent_user_xyz\", \"file\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"invalid_group\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"bad_group\",\n\t\t\t\tArgs:      []string{\":nonexistent_group_xyz\", \"file\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"missing_operand\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"no_args\",\n\t\t\t\tArgs:      []string{},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"missing_file_operand\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"owner_only\",\n\t\t\t\tArgs:      []string{cur.Username},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"nonexistent_file\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"no_such_file\",\n\t\t\t\tArgs:      []string{\":\" + groupA.name, \"does_not_exist\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"partial_failure\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"good\"), []byte(\"x\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"good\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"one_good_one_bad\",\n\t\t\t\tArgs:      []string{\":\" + groupB.name, \"good\", \"missing\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"good\"), groupB.gid)\n\t})\n\n\tt.Run(\"recursive_directory\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.MkdirAll(filepath.Join(workDir, \"d\", \"sub\"), 0o755)\n\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"sub\", \"f2\"), []byte(\"x\"), 0o644)\n\t\tsetGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"recursive\",\n\t\t\t\tArgs:    []string{\"-R\", \":\" + groupB.name, \"d\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"f1\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sub\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sub\", \"f2\"), groupB.gid)\n\t})\n\n\tt.Run(\"no_dereference_symlink\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"x\"), 0o644)\n\t\tos.Symlink(\"target\", filepath.Join(workDir, \"link\"))\n\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n\t\tsetGroup(t, filepath.Join(workDir, \"link\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"h_flag\",\n\t\t\t\tArgs:      []string{\"-h\", \":\" + groupB.name, \"link\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"link\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n\t})\n\n\tt.Run(\"recursive_P_mode\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.MkdirAll(filepath.Join(workDir, \"d\"), 0o755)\n\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"real\"), []byte(\"x\"), 0o644)\n\t\tos.Symlink(\"real\", filepath.Join(workDir, \"d\", \"sym\"))\n\t\tsetGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"P_flag\",\n\t\t\t\tArgs:      []string{\"-R\", \"-P\", \":\" + groupB.name, \"d\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"real\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sym\"), groupB.gid)\n\t})\n}\n\nvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?chown\\b`)\n\nfunc normalizeBinaryName(b []byte) []byte {\n\treturn binaryNameRe.ReplaceAll(b, []byte(\"chown\"))\n}\n\nvar errorVerbRe = regexp.MustCompile(\n\t`(cannot access|changing ownership of)`,\n)\n\nfunc normalizeErrorVerb(b []byte) []byte {\n\tout := errorVerbRe.ReplaceAll(b, []byte(\"ERROR_VERB\"))\n\tout = normalizeErrnoCase(out)\n\treturn out\n}\n\nvar errnoRe = regexp.MustCompile(`(?i)(no such file or directory|permission denied|operation not permitted)`)\n\nfunc normalizeErrnoCase(b []byte) []byte {\n\treturn errnoRe.ReplaceAllFunc(b, func(m []byte) []byte {\n\t\tlower := make([]byte, len(m))\n\t\tfor i, c := range m {\n\t\t\tif c >= 'A' && c <= 'Z' {\n\t\t\t\tlower[i] = c + 32\n\t\t\t} else {\n\t\t\t\tlower[i] = c\n\t\t\t}\n\t\t}\n\t\treturn lower\n\t})\n}\n\ntype groupInfo struct {\n\tname string\n\tgid  int\n}\n\nfunc testGroups(t *testing.T) []groupInfo {\n\tt.Helper()\n\tcur, err := user.Current()\n\tif err != nil {\n\t\tt.Fatalf(\"user.Current: %v\", err)\n\t}\n\tgids, err := cur.GroupIds()\n\tif err != nil {\n\t\tt.Fatalf(\"GroupIds: %v\", err)\n\t}\n\tvar groups []groupInfo\n\tfor _, gidStr := range gids {\n\t\tgid, err := strconv.Atoi(gidStr)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tg, err := user.LookupGroupId(gidStr)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tgroups = append(groups, groupInfo{name: g.Name, gid: gid})\n\t\tif len(groups) == 2 {\n\t\t\tbreak\n\t\t}\n\t}\n\treturn groups\n}\n\nfunc setGroup(t *testing.T, path string, gid int) {\n\tt.Helper()\n\tif err := os.Lchown(path, -1, gid); err != nil {\n\t\tt.Fatalf(\"setGroup(%s, %d): %v\", path, gid, err)\n\t}\n}\n\nfunc setGroupRecursive(t *testing.T, root string, gid int) {\n\tt.Helper()\n\tfilepath.Walk(root, func(path string, info os.FileInfo, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\treturn os.Lchown(path, -1, gid)\n\t})\n}\n\nfunc verifyGroup(t *testing.T, path string, expectedGID int) {\n\tt.Helper()\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\tt.Fatalf(\"Lstat(%s): %v\", path, err)\n\t}\n\tstat, ok := info.Sys().(*syscall.Stat_t)\n\tif !ok {\n\t\tt.Fatal(\"Sys() is not *syscall.Stat_t\")\n\t}\n\tif int(stat.Gid) != expectedGID {\n\t\tt.Errorf(\"group of %s: got %d, want %d\", path, stat.Gid, expectedGID)\n\t}\n}\n\nfunc TestHelp(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tcmd := exec.Command(goBin, \"--help\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"--help failed: %v\", err)\n\t}\n\tif len(out) == 0 {\n\t\tt.Fatal(\"--help produced no output\")\n\t}\n}\n\nfunc TestVersion(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tcmd := exec.Command(goBin, \"--version\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"--version failed: %v\", err)\n\t}\n\tif len(out) == 0 {\n\t\tt.Fatal(\"--version produced no output\")\n\t}\n}\n\nfunc TestReferenceNonexistent(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tcmd := exec.Command(goBin, \"--reference=/tmp/no_such_ref_file_xyz\", \"somefile\")\n\tcmd.Dir = t.TempDir()\n\tout, err := cmd.CombinedOutput()\n\tif err == nil {\n\t\tt.Fatal(\"expected error for nonexistent reference file\")\n\t}\n\t_ = out\n\texitCode := cmd.ProcessState.ExitCode()\n\tif exitCode != 1 {\n\t\tt.Errorf(\"exit code: got %d, want 1\", exitCode)\n\t}\n}\n","numLines":411,"startLine":1,"totalLines":411}}}
