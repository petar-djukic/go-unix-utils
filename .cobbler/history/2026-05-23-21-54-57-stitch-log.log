{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012McTfnMe2F6ZJxmWAcWHyv","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"os/user\"\n13\t\t\"path/filepath\"\n14\t\t\"regexp\"\n15\t\t\"sort\"\n16\t\t\"strconv\"\n17\t\t\"syscall\"\n18\t\t\"testing\"\n19\t\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n21\t)\n22\t\n23\tfunc TestDiff(t *testing.T) {\n24\t\tgoBin := testutils.BuildBinary(t, \".\")\n25\t\trefBin, err := exec.LookPath(\"gchgrp\")\n26\t\tif err != nil {\n27\t\t\tt.Skip(\"reference binary gchgrp not found\")\n28\t\t}\n29\t\n30\t\tgroups := testGroups(t)\n31\t\tif len(groups) < 2 {\n32\t\t\tt.Skip(\"need at least two groups for testing\")\n33\t\t}\n34\t\tgroupA := groups[0]\n35\t\tgroupB := groups[1]\n36\t\n37\t\tt.Run(\"basic_group_change\", func(t *testing.T) {\n38\t\t\tworkDir := t.TempDir()\n39\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n40\t\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n41\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n42\t\t\t\t{\n43\t\t\t\t\tName:    \"change_by_name\",\n44\t\t\t\t\tArgs:    []string{groupB.name, \"file\"},\n45\t\t\t\t\tWorkDir: workDir,\n46\t\t\t\t},\n47\t\t\t})\n48\t\t\tverifyGroup(t, filepath.Join(workDir, \"file\"), groupB.gid)\n49\t\t})\n50\t\n51\t\tt.Run(\"numeric_gid\", func(t *testing.T) {\n52\t\t\tworkDir := t.TempDir()\n53\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n54\t\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n55\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n56\t\t\t\t{\n57\t\t\t\t\tName:    \"change_by_gid\",\n58\t\t\t\t\tArgs:    []string{strconv.Itoa(groupB.gid), \"file\"},\n59\t\t\t\t\tWorkDir: workDir,\n60\t\t\t\t},\n61\t\t\t})\n62\t\t\tverifyGroup(t, filepath.Join(workDir, \"file\"), groupB.gid)\n63\t\t})\n64\t\n65\t\tt.Run(\"multiple_files\", func(t *testing.T) {\n66\t\t\tworkDir := t.TempDir()\n67\t\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n68\t\t\t\tos.WriteFile(filepath.Join(workDir, name), []byte(\"x\"), 0o644)\n69\t\t\t\tsetGroup(t, filepath.Join(workDir, name), groupA.gid)\n70\t\t\t}\n71\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n72\t\t\t\t{\n73\t\t\t\t\tName:    \"three_files\",\n74\t\t\t\t\tArgs:    []string{groupB.name, \"a\", \"b\", \"c\"},\n75\t\t\t\t\tWorkDir: workDir,\n76\t\t\t\t},\n77\t\t\t})\n78\t\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n79\t\t\t\tverifyGroup(t, filepath.Join(workDir, name), groupB.gid)\n80\t\t\t}\n81\t\t})\n82\t\n83\t\tt.Run(\"reference_file\", func(t *testing.T) {\n84\t\t\tworkDir := t.TempDir()\n85\t\t\tos.WriteFile(filepath.Join(workDir, \"ref\"), []byte(\"r\"), 0o644)\n86\t\t\tsetGroup(t, filepath.Join(workDir, \"ref\"), groupB.gid)\n87\t\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"t\"), 0o644)\n88\t\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n89\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n90\t\t\t\t{\n91\t\t\t\t\tName:    \"reference\",\n92\t\t\t\t\tArgs:    []string{\"--reference=ref\", \"target\"},\n93\t\t\t\t\tWorkDir: workDir,\n94\t\t\t\t},\n95\t\t\t})\n96\t\t\tverifyGroup(t, filepath.Join(workDir, \"target\"), groupB.gid)\n97\t\t})\n98\t\n99\t\tt.Run(\"invalid_group\", func(t *testing.T) {\n100\t\t\tworkDir := t.TempDir()\n101\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n102\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n103\t\t\t\t{\n104\t\t\t\t\tName:      \"bad_group_name\",\n105\t\t\t\t\tArgs:      []string{\"nonexistent_group_xyz\", \"file\"},\n106\t\t\t\t\tWorkDir:   workDir,\n107\t\t\t\t\tExitCode:  1,\n108\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n109\t\t\t\t},\n110\t\t\t})\n111\t\t})\n112\t\n113\t\tt.Run(\"missing_operand\", func(t *testing.T) {\n114\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n115\t\t\t\t{\n116\t\t\t\t\tName:      \"no_args\",\n117\t\t\t\t\tArgs:      []string{},\n118\t\t\t\t\tExitCode:  1,\n119\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n120\t\t\t\t},\n121\t\t\t})\n122\t\t})\n123\t\n124\t\tt.Run(\"missing_file_operand\", func(t *testing.T) {\n125\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n126\t\t\t\t{\n127\t\t\t\t\tName:      \"group_only\",\n128\t\t\t\t\tArgs:      []string{groupA.name},\n129\t\t\t\t\tExitCode:  1,\n130\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n131\t\t\t\t},\n132\t\t\t})\n133\t\t})\n134\t\n135\t\tt.Run(\"nonexistent_file\", func(t *testing.T) {\n136\t\t\tworkDir := t.TempDir()\n137\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n138\t\t\t\t{\n139\t\t\t\t\tName:      \"no_such_file\",\n140\t\t\t\t\tArgs:      []string{groupA.name, \"does_not_exist\"},\n141\t\t\t\t\tWorkDir:   workDir,\n142\t\t\t\t\tExitCode:  1,\n143\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n144\t\t\t\t},\n145\t\t\t})\n146\t\t})\n147\t\n148\t\tt.Run(\"partial_failure\", func(t *testing.T) {\n149\t\t\tworkDir := t.TempDir()\n150\t\t\tos.WriteFile(filepath.Join(workDir, \"good\"), []byte(\"x\"), 0o644)\n151\t\t\tsetGroup(t, filepath.Join(workDir, \"good\"), groupA.gid)\n152\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n153\t\t\t\t{\n154\t\t\t\t\tName:      \"one_good_one_bad\",\n155\t\t\t\t\tArgs:      []string{groupB.name, \"good\", \"missing\"},\n156\t\t\t\t\tWorkDir:   workDir,\n157\t\t\t\t\tExitCode:  1,\n158\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n159\t\t\t\t},\n160\t\t\t})\n161\t\t\tverifyGroup(t, filepath.Join(workDir, \"good\"), groupB.gid)\n162\t\t})\n163\t\n164\t\tt.Run(\"recursive_dir\", func(t *testing.T) {\n165\t\t\tworkDir := t.TempDir()\n166\t\t\tos.MkdirAll(filepath.Join(workDir, \"d\", \"sub\"), 0o755)\n167\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n168\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"sub\", \"f2\"), []byte(\"x\"), 0o644)\n169\t\t\tsetGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid)\n170\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n171\t\t\t\t{\n172\t\t\t\t\tName:    \"recursive\",\n173\t\t\t\t\tArgs:    []string{\"-R\", groupB.name, \"d\"},\n174\t\t\t\t\tWorkDir: workDir,\n175\t\t\t\t},\n176\t\t\t})\n177\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n178\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"f1\"), groupB.gid)\n179\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sub\"), groupB.gid)\n180\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sub\", \"f2\"), groupB.gid)\n181\t\t})\n182\t\n183\t\tt.Run(\"recursive_long_flag\", func(t *testing.T) {\n184\t\t\tworkDir := t.TempDir()\n185\t\t\tos.MkdirAll(filepath.Join(workDir, \"d\"), 0o755)\n186\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n187\t\t\tsetGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid)\n188\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n189\t\t\t\t{\n190\t\t\t\t\tName:    \"recursive_long\",\n191\t\t\t\t\tArgs:    []string{\"--recursive\", groupB.name, \"d\"},\n192\t\t\t\t\tWorkDir: workDir,\n193\t\t\t\t},\n194\t\t\t})\n195\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n196\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"f1\"), groupB.gid)\n197\t\t})\n198\t\n199\t\tt.Run(\"no_dereference\", func(t *testing.T) {\n200\t\t\tworkDir := t.TempDir()\n201\t\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"x\"), 0o644)\n202\t\t\tos.Symlink(\"target\", filepath.Join(workDir, \"link\"))\n203\t\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n204\t\t\tsetGroup(t, filepath.Join(workDir, \"link\"), groupA.gid)\n205\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n206\t\t\t\t{\n207\t\t\t\t\tName:    \"h_flag\",\n208\t\t\t\t\tArgs:    []string{\"-h\", groupB.name, \"link\"},\n209\t\t\t\t\tWorkDir: workDir,\n210\t\t\t\t},\n211\t\t\t})\n212\t\t\tverifyGroup(t, filepath.Join(workDir, \"link\"), groupB.gid)\n213\t\t\tverifyGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n214\t\t})\n215\t\n216\t\tt.Run(\"recursive_symlink_P\", func(t *testing.T) {\n217\t\t\tworkDir := t.TempDir()\n218\t\t\tos.MkdirAll(filepath.Join(workDir, \"d\"), 0o755)\n219\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n220\t\t\tos.WriteFile(filepath.Join(workDir, \"outside\"), []byte(\"x\"), 0o644)\n221\t\t\tos.Symlink(\"../outside\", filepath.Join(workDir, \"d\", \"link\"))\n222\t\t\tsetGroupRecursive(t, workDir, groupA.gid)\n223\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n224\t\t\t\t{\n225\t\t\t\t\tName:    \"R_P_symlink\",\n226\t\t\t\t\tArgs:    []string{\"-R\", \"-P\", groupB.name, \"d\"},\n227\t\t\t\t\tWorkDir: workDir,\n228\t\t\t\t},\n229\t\t\t})\n230\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n231\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"f1\"), groupB.gid)\n232\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"link\"), groupB.gid)\n233\t\t\tverifyGroup(t, filepath.Join(workDir, \"outside\"), groupA.gid)\n234\t\t})\n235\t\n236\t\tt.Run(\"recursive_symlink_H\", func(t *testing.T) {\n237\t\t\tworkDir := t.TempDir()\n238\t\t\tos.MkdirAll(filepath.Join(workDir, \"realdir\"), 0o755)\n239\t\t\tos.WriteFile(filepath.Join(workDir, \"realdir\", \"f1\"), []byte(\"x\"), 0o644)\n240\t\t\tos.Symlink(\"realdir\", filepath.Join(workDir, \"linkdir\"))\n241\t\t\tsetGroupRecursive(t, workDir, groupA.gid)\n242\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n243\t\t\t\t{\n244\t\t\t\t\tName:    \"R_H_symlink\",\n245\t\t\t\t\tArgs:    []string{\"-R\", \"-H\", groupB.name, \"linkdir\"},\n246\t\t\t\t\tWorkDir: workDir,\n247\t\t\t\t},\n248\t\t\t})\n249\t\t\tverifyGroup(t, filepath.Join(workDir, \"linkdir\"), groupB.gid)\n250\t\t\tverifyGroup(t, filepath.Join(workDir, \"realdir\", \"f1\"), groupB.gid)\n251\t\t})\n252\t\n253\t\tt.Run(\"recursive_symlink_L\", func(t *testing.T) {\n254\t\t\tworkDir := t.TempDir()\n255\t\t\tos.MkdirAll(filepath.Join(workDir, \"d\"), 0o755)\n256\t\t\tos.WriteFile(filepath.Join(workDir, \"outside\"), []byte(\"x\"), 0o644)\n257\t\t\tos.Symlink(\"../outside\", filepath.Join(workDir, \"d\", \"link\"))\n258\t\t\tsetGroupRecursive(t, workDir, groupA.gid)\n259\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n260\t\t\t\t{\n261\t\t\t\t\tName:    \"R_L_symlink\",\n262\t\t\t\t\tArgs:    []string{\"-R\", \"-L\", groupB.name, \"d\"},\n263\t\t\t\t\tWorkDir: workDir,\n264\t\t\t\t},\n265\t\t\t})\n266\t\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n267\t\t\tverifyGroup(t, filepath.Join(workDir, \"outside\"), groupB.gid)\n268\t\t})\n269\t\n270\t\tt.Run(\"verbose_changed\", func(t *testing.T) {\n271\t\t\tworkDir := t.TempDir()\n272\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n273\t\t\targs := []string{\"-v\", groupB.name, \"file\"}\n274\t\t\tresetFn := func() { setGroup(t, filepath.Join(workDir, \"file\"), groupA.gid) }\n275\t\t\tdiffWithReset(t, goBin, refBin, args, workDir, resetFn, nil)\n276\t\t})\n277\t\n278\t\tt.Run(\"verbose_retained\", func(t *testing.T) {\n279\t\t\tworkDir := t.TempDir()\n280\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n281\t\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n282\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n283\t\t\t\t{\n284\t\t\t\t\tName:    \"v_retained\",\n285\t\t\t\t\tArgs:    []string{\"-v\", groupA.name, \"file\"},\n286\t\t\t\t\tWorkDir: workDir,\n287\t\t\t\t},\n288\t\t\t})\n289\t\t})\n290\t\n291\t\tt.Run(\"changes_changed\", func(t *testing.T) {\n292\t\t\tworkDir := t.TempDir()\n293\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n294\t\t\targs := []string{\"-c\", groupB.name, \"file\"}\n295\t\t\tresetFn := func() { setGroup(t, filepath.Join(workDir, \"file\"), groupA.gid) }\n296\t\t\tdiffWithReset(t, goBin, refBin, args, workDir, resetFn, nil)\n297\t\t})\n298\t\n299\t\tt.Run(\"changes_retained\", func(t *testing.T) {\n300\t\t\tworkDir := t.TempDir()\n301\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n302\t\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n303\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n304\t\t\t\t{\n305\t\t\t\t\tName:    \"c_retained\",\n306\t\t\t\t\tArgs:    []string{\"-c\", groupA.name, \"file\"},\n307\t\t\t\t\tWorkDir: workDir,\n308\t\t\t\t},\n309\t\t\t})\n310\t\t})\n311\t\n312\t\tt.Run(\"verbose_nonexistent\", func(t *testing.T) {\n313\t\t\tworkDir := t.TempDir()\n314\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n315\t\t\t\t{\n316\t\t\t\t\tName:      \"v_nonexistent\",\n317\t\t\t\t\tArgs:      []string{\"-v\", groupA.name, \"missing\"},\n318\t\t\t\t\tWorkDir:   workDir,\n319\t\t\t\t\tExitCode:  1,\n320\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n321\t\t\t\t},\n322\t\t\t})\n323\t\t})\n324\t\n325\t\tt.Run(\"silent_nonexistent\", func(t *testing.T) {\n326\t\t\tworkDir := t.TempDir()\n327\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n328\t\t\t\t{\n329\t\t\t\t\tName:      \"f_nonexistent\",\n330\t\t\t\t\tArgs:      []string{\"-f\", groupA.name, \"missing\"},\n331\t\t\t\t\tWorkDir:   workDir,\n332\t\t\t\t\tExitCode:  1,\n333\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n334\t\t\t\t},\n335\t\t\t})\n336\t\t})\n337\t\n338\t\tt.Run(\"silent_verbose_nonexistent\", func(t *testing.T) {\n339\t\t\tworkDir := t.TempDir()\n340\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n341\t\t\t\t{\n342\t\t\t\t\tName:      \"fv_nonexistent\",\n343\t\t\t\t\tArgs:      []string{\"-fv\", groupA.name, \"missing\"},\n344\t\t\t\t\tWorkDir:   workDir,\n345\t\t\t\t\tExitCode:  1,\n346\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n347\t\t\t\t},\n348\t\t\t})\n349\t\t})\n350\t\n351\t\tt.Run(\"verbose_recursive\", func(t *testing.T) {\n352\t\t\tworkDir := t.TempDir()\n353\t\t\tos.MkdirAll(filepath.Join(workDir, \"d\", \"sub\"), 0o755)\n354\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n355\t\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"sub\", \"f2\"), []byte(\"x\"), 0o644)\n356\t\t\targs := []string{\"-Rv\", groupB.name, \"d\"}\n357\t\t\tresetFn := func() { setGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid) }\n358\t\t\tdiffWithReset(t, goBin, refBin, args, workDir, resetFn, []testutils.NormalizeFunc{sortLines})\n359\t\t})\n360\t\n361\t\tt.Run(\"verbose_numeric_gid\", func(t *testing.T) {\n362\t\t\tworkDir := t.TempDir()\n363\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n364\t\t\targs := []string{\"-v\", strconv.Itoa(groupB.gid), \"file\"}\n365\t\t\tresetFn := func() { setGroup(t, filepath.Join(workDir, \"file\"), groupA.gid) }\n366\t\t\tdiffWithReset(t, goBin, refBin, args, workDir, resetFn, nil)\n367\t\t})\n368\t}\n369\t\n370\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?chgrp\\b`)\n371\t\n372\tfunc normalizeBinaryName(b []byte) []byte {\n373\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"chgrp\"))\n374\t}\n375\t\n376\tvar errorVerbRe = regexp.MustCompile(\n377\t\t`(cannot access|changing group of)`,\n378\t)\n379\t\n380\tfunc normalizeErrorVerb(b []byte) []byte {\n381\t\tout := errorVerbRe.ReplaceAll(b, []byte(\"ERROR_VERB\"))\n382\t\tout = normalizeErrnoCase(out)\n383\t\treturn out\n384\t}\n385\t\n386\tvar errnoRe = regexp.MustCompile(`(?i)(no such file or directory|permission denied|operation not permitted)`)\n387\t\n388\tfunc normalizeErrnoCase(b []byte) []byte {\n389\t\treturn errnoRe.ReplaceAllFunc(b, func(m []byte) []byte {\n390\t\t\tlower := make([]byte, len(m))\n391\t\t\tfor i, c := range m {\n392\t\t\t\tif c >= 'A' && c <= 'Z' {\n393\t\t\t\t\tlower[i] = c + 32\n394\t\t\t\t} else {\n395\t\t\t\t\tlower[i] = c\n396\t\t\t\t}\n397\t\t\t}\n398\t\t\treturn lower\n399\t\t})\n400\t}\n401\t\n402\ttype groupInfo struct {\n403\t\tname string\n404\t\tgid  int\n405\t}\n406\t\n407\tfunc testGroups(t *testing.T) []groupInfo {\n408\t\tt.Helper()\n409\t\tcur, err := user.Current()\n410\t\tif err != nil {\n411\t\t\tt.Fatalf(\"user.Current: %v\", err)\n412\t\t}\n413\t\tgids, err := cur.GroupIds()\n414\t\tif err != nil {\n415\t\t\tt.Fatalf(\"GroupIds: %v\", err)\n416\t\t}\n417\t\tvar groups []groupInfo\n418\t\tfor _, gidStr := range gids {\n419\t\t\tgid, err := strconv.Atoi(gidStr)\n420\t\t\tif err != nil {\n421\t\t\t\tcontinue\n422\t\t\t}\n423\t\t\tg, err := user.LookupGroupId(gidStr)\n424\t\t\tif err != nil {\n425\t\t\t\tcontinue\n426\t\t\t}\n427\t\t\tgroups = append(groups, groupInfo{name: g.Name, gid: gid})\n428\t\t\tif len(groups) == 2 {\n429\t\t\t\tbreak\n430\t\t\t}\n431\t\t}\n432\t\treturn groups\n433\t}\n434\t\n435\tfunc setGroup(t *testing.T, path string, gid int) {\n436\t\tt.Helper()\n437\t\tif err := os.Lchown(path, -1, gid); err != nil {\n438\t\t\tt.Fatalf(\"setGroup(%s, %d): %v\", path, gid, err)\n439\t\t}\n440\t}\n441\t\n442\tfunc setGroupRecursive(t *testing.T, root string, gid int) {\n443\t\tt.Helper()\n444\t\terr := filepath.WalkDir(root, func(path string, _ os.DirEntry, err error) error {\n445\t\t\tif err != nil {\n446\t\t\t\treturn err\n447\t\t\t}\n448\t\t\treturn os.Lchown(path, -1, gid)\n449\t\t})\n450\t\tif err != nil {\n451\t\t\tt.Fatalf(\"setGroupRecursive(%s, %d): %v\", root, gid, err)\n452\t\t}\n453\t}\n454\t\n455\tfunc verifyGroup(t *testing.T, path string, expectedGID int) {\n456\t\tt.Helper()\n457\t\tinfo, err := os.Lstat(path)\n458\t\tif err != nil {\n459\t\t\tt.Fatalf(\"Lstat(%s): %v\", path, err)\n460\t\t}\n461\t\tstat, ok := info.Sys().(*syscall.Stat_t)\n462\t\tif !ok {\n463\t\t\tt.Fatal(\"Sys() is not *syscall.Stat_t\")\n464\t\t}\n465\t\tif int(stat.Gid) != expectedGID {\n466\t\t\tt.Errorf(\"group of %s: got %d, want %d\", path, stat.Gid, expectedGID)\n467\t\t}\n468\t}\n469\t\n470\tfunc TestHelp(t *testing.T) {\n471\t\tgoBin := testutils.BuildBinary(t, \".\")\n472\t\tcmd := exec.Command(goBin, \"--help\")\n473\t\tout, err := cmd.Output()\n474\t\tif err != nil {\n475\t\t\tt.Fatalf(\"--help failed: %v\", err)\n476\t\t}\n477\t\tif len(out) == 0 {\n478\t\t\tt.Fatal(\"--help produced no output\")\n479\t\t}\n480\t}\n481\t\n482\tfunc TestVersion(t *testing.T) {\n483\t\tgoBin := testutils.BuildBinary(t, \".\")\n484\t\tcmd := exec.Command(goBin, \"--version\")\n485\t\tout, err := cmd.Output()\n486\t\tif err != nil {\n487\t\t\tt.Fatalf(\"--version failed: %v\", err)\n488\t\t}\n489\t\tif len(out) == 0 {\n490\t\t\tt.Fatal(\"--version produced no output\")\n491\t\t}\n492\t}\n493\t\n494\tfunc TestReferenceNonexistent(t *testing.T) {\n495\t\tgoBin := testutils.BuildBinary(t, \".\")\n496\t\tcmd := exec.Command(goBin, \"--reference=/tmp/no_such_ref_file_xyz\", \"somefile\")\n497\t\tcmd.Dir = t.TempDir()\n498\t\tout, err := cmd.CombinedOutput()\n499\t\tif err == nil {\n500\t\t\tt.Fatal(\"expected error for nonexistent reference file\")\n501\t\t}\n502\t\t_ = out\n503\t\texitCode := cmd.ProcessState.ExitCode()\n504\t\tif exitCode != 1 {\n505\t\t\tt.Errorf(\"exit code: got %d, want 1\", exitCode)\n506\t\t}\n507\t}\n508\t\n509\tfunc TestSilentSuppressesErrors(t *testing.T) {\n510\t\tgoBin := testutils.BuildBinary(t, \".\")\n511\t\tgroups := testGroups(t)\n512\t\tif len(groups) == 0 {\n513\t\t\tt.Skip(\"no groups available\")\n514\t\t}\n515\t\tcmd := exec.Command(goBin, \"-f\", groups[0].name, \"nonexistent\")\n516\t\tcmd.Dir = t.TempDir()\n517\t\tstderr, _ := cmd.CombinedOutput()\n518\t\tif len(stderr) > 0 {\n519\t\t\tfound := false\n520\t\t\tfor _, line := range splitLines(stderr) {\n521\t\t\t\tif len(line) > 0 {\n522\t\t\t\t\tfound = true\n523\t\t\t\t}\n524\t\t\t}\n525\t\t\tif found {\n526\t\t\t\tfmt.Printf(\"stderr with -f: %q\\n\", string(stderr))\n527\t\t\t}\n528\t\t}\n529\t}\n530\t\n531\tfunc splitLines(b []byte) [][]byte {\n532\t\tvar lines [][]byte\n533\t\tstart := 0\n534\t\tfor i, c := range b {\n535\t\t\tif c == '\\n' {\n536\t\t\t\tlines = append(lines, b[start:i])\n537\t\t\t\tstart = i + 1\n538\t\t\t}\n539\t\t}\n540\t\tif start < len(b) {\n541\t\t\tlines = append(lines, b[start:])\n542\t\t}\n543\t\treturn lines\n544\t}\n545\t\n546\tfunc sortLines(b []byte) []byte {\n547\t\tlines := bytes.Split(bytes.TrimRight(b, \"\\n\"), []byte(\"\\n\"))\n548\t\tsort.Slice(lines, func(i, j int) bool { return bytes.Compare(lines[i], lines[j]) < 0 })\n549\t\tif len(lines) == 1 && len(lines[0]) == 0 {\n550\t\t\treturn b\n551\t\t}\n552\t\treturn append(bytes.Join(lines, []byte(\"\\n\")), '\\n')\n553\t}\n554\t\n555\tfunc diffWithReset(t *testing.T, goBin, refBin string, args []string, workDir string, reset func(), normalizers []testutils.NormalizeFunc) {\n556\t\tt.Helper()\n557\t\treset()\n558\t\tgoOut, goErr, goExit := captureRun(t, goBin, args, workDir)\n559\t\treset()\n560\t\trefOut, refErr, refExit := captureRun(t, refBin, args, workDir)\n561\t\tfor _, n := range normalizers {\n562\t\t\tgoOut, goErr = n(goOut), n(goErr)\n563\t\t\trefOut, refErr = n(refOut), n(refErr)\n564\t\t}\n565\t\tif !bytes.Equal(goOut, refOut) {\n566\t\t\tt.Errorf(\"stdout mismatch:\\n  go:  %q\\n  ref: %q\", goOut, refOut)\n567\t\t}\n568\t\tif !bytes.Equal(goErr, refErr) {\n569\t\t\tt.Errorf(\"stderr mismatch:\\n  go:  %q\\n  ref: %q\", goErr, refErr)\n570\t\t}\n571\t\tif goExit != refExit {\n572\t\t\tt.Errorf(\"exit code: go=%d ref=%d\", goExit, refExit)\n573\t\t}\n574\t}\n575\t\n576\tfunc captureRun(t *testing.T, binary string, args []string, workDir string) ([]byte, []byte, int) {\n577\t\tt.Helper()\n578\t\tcmd := exec.Command(binary, args...)\n579\t\tcmd.Dir = workDir\n580\t\tvar stdout, stderr bytes.Buffer\n581\t\tcmd.Stdout = &stdout\n582\t\tcmd.Stderr = &stderr\n583\t\terr := cmd.Run()\n584\t\texitCode := 0\n585\t\tif err != nil {\n586\t\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n587\t\t\t\texitCode = exitErr.ExitCode()\n588\t\t\t} else {\n589\t\t\t\tt.Fatalf(\"run %s: %v\", binary, err)\n590\t\t\t}\n591\t\t}\n592\t\treturn stdout.Bytes(), stderr.Bytes(), exitCode\n593\t}\n594\t"}]},"parent_tool_use_id":null,"session_id":"a39bb1de-8019-4cee-97a2-987b3a588d8f","uuid":"cf6062ec-1771-4aff-8c70-322fe9b0c1e8","timestamp":"2026-05-24T01:56:48.845Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5558/cmd/chgrp/chgrp_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"sort\"\n\t\"strconv\"\n\t\"syscall\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gchgrp\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gchgrp not found\")\n\t}\n\n\tgroups := testGroups(t)\n\tif len(groups) < 2 {\n\t\tt.Skip(\"need at least two groups for testing\")\n\t}\n\tgroupA := groups[0]\n\tgroupB := groups[1]\n\n\tt.Run(\"basic_group_change\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"change_by_name\",\n\t\t\t\tArgs:    []string{groupB.name, \"file\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"file\"), groupB.gid)\n\t})\n\n\tt.Run(\"numeric_gid\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"file\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"change_by_gid\",\n\t\t\t\tArgs:    []string{strconv.Itoa(groupB.gid), \"file\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"file\"), groupB.gid)\n\t})\n\n\tt.Run(\"multiple_files\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n\t\t\tos.WriteFile(filepath.Join(workDir, name), []byte(\"x\"), 0o644)\n\t\t\tsetGroup(t, filepath.Join(workDir, name), groupA.gid)\n\t\t}\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"three_files\",\n\t\t\t\tArgs:    []string{groupB.name, \"a\", \"b\", \"c\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n\t\t\tverifyGroup(t, filepath.Join(workDir, name), groupB.gid)\n\t\t}\n\t})\n\n\tt.Run(\"reference_file\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"ref\"), []byte(\"r\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"ref\"), groupB.gid)\n\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"t\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"reference\",\n\t\t\t\tArgs:    []string{\"--reference=ref\", \"target\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"target\"), groupB.gid)\n\t})\n\n\tt.Run(\"invalid_group\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"bad_group_name\",\n\t\t\t\tArgs:      []string{\"nonexistent_group_xyz\", \"file\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"missing_operand\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"no_args\",\n\t\t\t\tArgs:      []string{},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"missing_file_operand\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"group_only\",\n\t\t\t\tArgs:      []string{groupA.name},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"nonexistent_file\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"no_such_file\",\n\t\t\t\tArgs:      []string{groupA.name, \"does_not_exist\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"partial_failure\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"good\"), []byte(\"x\"), 0o644)\n\t\tsetGroup(t, filepath.Join(workDir, \"good\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"one_good_one_bad\",\n\t\t\t\tArgs:      []string{groupB.name, \"good\", \"missing\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"good\"), groupB.gid)\n\t})\n\n\tt.Run(\"recursive_dir\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.MkdirAll(filepath.Join(workDir, \"d\", \"sub\"), 0o755)\n\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"sub\", \"f2\"), []byte(\"x\"), 0o644)\n\t\tsetGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"recursive\",\n\t\t\t\tArgs:    []string{\"-R\", groupB.name, \"d\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"f1\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sub\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"sub\", \"f2\"), groupB.gid)\n\t})\n\n\tt.Run(\"recursive_long_flag\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.MkdirAll(filepath.Join(workDir, \"d\"), 0o755)\n\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n\t\tsetGroupRecursive(t, filepath.Join(workDir, \"d\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"recursive_long\",\n\t\t\t\tArgs:    []string{\"--recursive\", groupB.name, \"d\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"f1\"), groupB.gid)\n\t})\n\n\tt.Run(\"no_dereference\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"x\"), 0o644)\n\t\tos.Symlink(\"target\", filepath.Join(workDir, \"link\"))\n\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n\t\tsetGroup(t, filepath.Join(workDir, \"link\"), groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"h_flag\",\n\t\t\t\tArgs:    []string{\"-h\", groupB.name, \"link\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"link\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n\t})\n\n\tt.Run(\"recursive_symlink_P\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.MkdirAll(filepath.Join(workDir, \"d\"), 0o755)\n\t\tos.WriteFile(filepath.Join(workDir, \"d\", \"f1\"), []byte(\"x\"), 0o644)\n\t\tos.WriteFile(filepath.Join(workDir, \"outside\"), []byte(\"x\"), 0o644)\n\t\tos.Symlink(\"../outside\", filepath.Join(workDir, \"d\", \"link\"))\n\t\tsetGroupRecursive(t, workDir, groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"R_P_symlink\",\n\t\t\t\tArgs:    []string{\"-R\", \"-P\", groupB.name, \"d\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"f1\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"d\", \"link\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"outside\"), groupA.gid)\n\t})\n\n\tt.Run(\"recursive_symlink_H\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.MkdirAll(filepath.Join(workDir, \"realdir\"), 0o755)\n\t\tos.WriteFile(filepath.Join(workDir, \"realdir\", \"f1\"), []byte(\"x\"), 0o644)\n\t\tos.Symlink(\"realdir\", filepath.Join(workDir, \"linkdir\"))\n\t\tsetGroupRecursive(t, workDir, groupA.gid)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:    \"R_H_symlink\",\n\t\t\t\tArgs:    []string{\"-R\", \"-H\", groupB.name, \"linkdir\"},\n\t\t\t\tWorkDir: workDir,\n\t\t\t},\n\t\t})\n\t\tverifyGroup(t, filepath.Join(workDir, \"linkdir\"), groupB.gid)\n\t\tverifyGroup(t, filepath.Join(workDir, \"realdir\", \"f1\"), groupB.gid)\n\t})\n\n\tt.Run(\"recursive_symlink_L\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\t