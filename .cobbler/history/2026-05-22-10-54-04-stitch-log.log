alizeFunc(func(b []byte) []byte {\n\treturn bytes.ToLower(b)\n})\nnormalizeOpenPrefix := testutils.NormalizeFunc(func(b []byte) []byte {\n\treturn bytes.ReplaceAll(b, []byte(\": open \"), []byte(\": \"))\n})\nerrNorm := []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrCase, normalizeOpenPrefix}\n```\n\n**Applied to file errors:**\n- `nonexistent_file` (line 61-66): ExitCode: 1, uses `errNorm`\n- `nonexistent_then_valid` (line 68-73): ExitCode: 1, uses `errNorm`\n- `valid_then_nonexistent` (line 75-80): ExitCode: 1, uses `errNorm`\n\n---\n\n### **Pattern 3: Line-by-line Regex Normalization (comm)**\n\n**File:** `/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5461/cmd/comm/comm_test.go` (lines 21-36)\n\n```go\nvar stderrNorm = regexp.MustCompile(`^g?comm:`)\n\nfunc normStderr(b []byte) []byte {\n\tvar out []byte\n\tfor line := range bytes.SplitSeq(b, []byte(\"\\n\")) {\n\t\tif len(out) > 0 {\n\t\t\tout = append(out, '\\n')\n\t\t}\n\t\tout = append(out, stderrNorm.ReplaceAll(line, []byte(\"PROG:\"))...)\n\t}\n\treturn out\n}\n\nfunc normStderrLower(b []byte) []byte {\n\treturn bytes.ToLower(normStderr(b))\n}\n```\n\n---\n\n### **Pattern 4: Total Discard of Stderr (head)**\n\n**File:** `/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5461/cmd/head/head_test.go` (line 23)\n\n```go\ndiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n```\n\n**Used for file not found errors:**\n- `nonexistent-only` (ExitCode: 1)\n- `bytes-invalid` (ExitCode: 1)\n- Multiple file permutations with missing files\n\n---\n\n### **Pattern 5: Selective Prefix Filtering (expr)**\n\n**File:** `/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5461/cmd/expr/expr_test.go`\n\n```go\nnormBinName := testutils.NormalizeFunc(func(b []byte) []byte {\n\treturn bytes.ReplaceAll(b, []byte(\"gexpr:\"), []byte(\"expr:\"))\n})\nnormStripTry := testutils.NormalizeFunc(func(b []byte