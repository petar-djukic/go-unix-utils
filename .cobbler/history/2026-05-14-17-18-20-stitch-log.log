fmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n69\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n70\t\t\t\tos.Exit(2)\n71\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n72\t\t\t\tparseShortFlags(arg[1:], &opts)\n73\t\t\tdefault:\n74\t\t\t\tpaths = append(paths, arg)\n75\t\t\t}\n76\t\t}\n77\t\treturn opts, paths\n78\t}\n79\t\n80\tfunc parseShortFlags(flags string, opts *options) {\n81\t\tfor _, ch := range flags {\n82\t\t\tswitch ch {\n83\t\t\tcase '1':\n84\t\t\t\topts.forceColumns = false\n85\t\t\t\tif !opts.longFormat {\n86\t\t\t\t\topts.singleColumn = true\n87\t\t\t\t}\n88\t\t\tcase 'l':\n89\t\t\t\topts.longFormat = true\n90\t\t\t\topts.singleColumn = false\n91\t\t\t\topts.forceColumns = false\n92\t\t\tcase 'C':\n93\t\t\t\topts.forceColumns = true\n94\t\t\t\topts.longFormat = false\n95\t\t\t\topts.singleColumn = false\n96\t\t\tdefault:\n97\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n98\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n99\t\t\t\tos.Exit(2)\n100\t\t\t}\n101\t\t}\n102\t}\n103\t\n104\tfunc run(paths []string, opts options) int {\n105\t\texitCode := 0\n106\t\tfiles, dirs := classifyPaths(paths, &exitCode)\n107\t\tneedSep := false\n108\t\tif len(files) > 0 {\n109\t\t\tsort.Strings(files)\n110\t\t\tif opts.longFormat {\n111\t\t\t\texitCode = maxCode(exitCode, writeLongFiles(files))\n112\t\t\t} else {\n113\t\t\t\twriteEntries(files, opts)\n114\t\t\t}\n115\t\t\tneedSep = true\n116\t\t}\n117\t\tshowHeader := len(dirs) > 1 || len(files) > 0\n118\t\tfor _, dir := range dirs {\n119\t\t\tif needSep {\n120\t\t\t\tfmt.Fprintln(os.Stdout)\n121\t\t\t}\n122\t\t\tif showHeader {\n123\t\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n124\t\t\t}\n125\t\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n126\t\t\tneedSep = true\n127\t\t}\n128\t\treturn exitCode\n129\t}\n130\t\n131\tfunc classifyPaths(paths []string, exitCode *int) ([]string, []string) {\n132\t\tvar files, dirs []string\n133\t\tfor _, p := range paths {\n134\t\t\tinfo, err := os.Lstat(p)\n135\t\t\tif err != nil {\n136\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n137\t\t\t\t*exitCode = 2\n138\t\t\t\tcontinue\n139\t\t\t}\n140\t\t\tif info.IsDir() {\n141\t\t\t\tdirs = append(dirs, p)\n142\t\t\t} else {\n143\t\t\t\tfiles = append(files, p)\n144\t\t\t}\n145\t\t}\n146\t\treturn files, dirs\n147\t}\n148\t\n149\tfunc maxCode(a, b int) int {\n150\t\tif a > b {\n151\t\t\treturn a\n152\t\t}\n153\t\treturn b\n154\t}\n155\t\n156\tfunc listDir(path string, opts options) int {\n157\t\tnames, err := readNames(path)\n158\t\tif err != nil {\n159\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n160\t\t\t\tpath, sysError(err))\n161\t\t\treturn 2\n162\t\t}\n163\t\tif opts.longFormat {\n164\t\t\treturn writeLongDir(path, names)\n165\t\t}\n166\t\twriteEntries(names, opts)\n167\t\treturn 0\n168\t}\n169\t\n170\tfunc readNames(path string) ([]string, error) {\n171\t\tentries, err := os.ReadDir(path)\n172\t\tif err != nil {\n173\t\t\treturn nil, err\n174\t\t}\n175\t\tnames := make([]string, 0, len(entries))\n176\t\tfor _, e := range entries {\n177\t\t\tif !strings.HasPrefix(e.Name(), \".\") {\n178\t\t\t\tnames = append(names, e.Name())\n179\t\t\t}\n180\t\t}\n181\t\tsort.Strings(names)\n182\t\treturn names, nil\n183\t}\n184\t\n185\tfunc writeEntries(names []string, opts options) {\n186\t\tif len(names) == 0 {\n187\t\t\treturn\n188\t\t}\n189\t\tif opts.forceColumns {\n190\t\t\twriteColumnsWidth(names, 0)\n191\t\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n192\t\t\twriteLines(names)\n193\t\t} else {\n194\t\t\twriteColumnsWidth(names, 0)\n195\t\t}\n196\t}\n197\t\n198\tfunc writeColumnsWidth(names []string, width int) {\n199\t\tif width <= 0 {\n200\t\t\tw, err := sys.TerminalWidth()\n201\t\t\tif err != nil {\n202\t\t\t\tw = 80\n203\t\t\t}\n204\t\t\twidth = w\n205\t\t}\n206\t\tgrid := format.Columns(names, width)\n207\t\twidths := gridColumnWidths(grid)\n208\t\tfor _, row := range grid {\n209\t\t\twriteGridRow(row, widths)\n210\t\t}\n211\t}\n212\t\n213\tfunc writeLines(names []string) {\n214\t\tfor _, name := range names {\n215\t\t\twriteLine(name)\n216\t\t}\n217\t}\n218\t\n219\tfunc gridColumnWidths(grid [][]string) []int {\n220\t\tif len(grid) == 0 {\n221\t\t\treturn nil\n222\t\t}\n223\t\twidths := make([]int, len(grid[0]))\n224\t\tfor _, row := range grid {\n225\t\t\tfor c, cell := range row {\n226\t\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n227\t\t\t\t\twidths[c] = w\n228\t\t\t\t}\n229\t\t\t}\n230\t\t}\n231\t\treturn widths\n232\t}\n233\t\n234\tfunc writeGridRow(row []string, widths []int) {\n235\t\tvar b strings.Builder\n236\t\tfor i, cell := range row {\n237\t\t\tif i < len(row)-1 {\n238\t\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n239\t\t\t\tb.WriteString(\"  \")\n240\t\t\t} else {\n241\t\t\t\tb.WriteString(cell)\n242\t\t\t}\n243\t\t}\n244\t\twriteLine(b.String())\n245\t}\n246\t\n247\ttype longEntry struct {\n248\t\tname  string\n249\t\tpath  string\n250\t\tinfo  *sys.FileInfo\n251\t\towner string\n252\t\tgroup string\n253\t}\n254\t\n255\ttype longWidths struct {\n256\t\tnlink int\n257\t\towner int\n258\t\tgroup int\n259\t\tsize  int\n260\t}\n261\t\n262\tfunc writeLongFiles(paths []string) int {\n263\t\tentries := make([]longEntry, 0, len(paths))\n264\t\tcode := 0\n265\t\tfor _, p := range paths {\n266\t\t\tfi, err := sys.Lstat(p)\n267\t\t\tif err != nil {\n268\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n269\t\t\t\tcode = 2\n270\t\t\t\tcontinue\n271\t\t\t}\n272\t\t\tentries = append(entries, newLongEntry(p, p, fi))\n273\t\t}\n274\t\twriteLongEntries(entries)\n275\t\treturn code\n276\t}\n277\t\n278\tfunc writeLongDir(path string, names []string) int {\n279\t\tentries := make([]longEntry, 0, len(names))\n280\t\tcode := 0\n281\t\tfor _, name := range names {\n282\t\t\tfull := filepath.Join(path, name)\n283\t\t\tfi, err := sys.Lstat(full)\n284\t\t\tif err != nil {\n285\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n286\t\t\t\tcode = 2\n287\t\t\t\tcontinue\n288\t\t\t}\n289\t\t\tentries = append(entries, newLongEntry(name, full, fi))\n290\t\t}\n291\t\ttotalBlocks := int64(0)\n292\t\tfor _, e := range entries {\n293\t\t\ttotalBlocks += e.info.Blocks\n294\t\t}\n295\t\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n296\t\twriteLongEntries(entries)\n297\t\treturn code\n298\t}\n299\t\n300\tfunc newLongEntry(name string, path string, fi *sys.FileInfo) longEntry {\n301\t\treturn longEntry{\n302\t\t\tname:  name,\n303\t\t\tpath:  path,\n304\t\t\tinfo:  fi,\n305\t\t\towner: resolveOwner(fi.Uid),\n306\t\t\tgroup: resolveGroup(fi.Gid),\n307\t\t}\n308\t}\n309\t\n310\tfunc writeLongEntries(entries []longEntry) {\n311\t\tif len(entries) == 0 {\n312\t\t\treturn\n313\t\t}\n314\t\tw := computeLongWidths(entries)\n315\t\tfor _, e := range entries {\n316\t\t\twriteLine(formatLongLine(e, w))\n317\t\t}\n318\t}\n319\t\n320\tfunc computeLongWidths(entries []longEntry) longWidths {\n321\t\tvar w longWidths\n322\t\tfor _, e := range entries {\n323\t\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n324\t\t\t\tw.nlink = n\n325\t\t\t}\n326\t\t\tif n := len(e.owner); n > w.owner {\n327\t\t\t\tw.owner = n\n328\t\t\t}\n329\t\t\tif n := len(e.group); n > w.group {\n330\t\t\t\tw.group = n\n331\t\t\t}\n332\t\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n333\t\t\t\tw.size = n\n334\t\t\t}\n335\t\t}\n336\t\treturn w\n337\t}\n338\t\n339\tfunc formatLongLine(e longEntry, w longWidths) string {\n340\t\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n341\t\tsize := strconv.FormatInt(e.info.Size, 10)\n342\t\tname := e.name\n343\t\tif e.info.Mode&os.ModeSymlink != 0 {\n344\t\t\tif target, err := os.Readlink(e.path); err == nil {\n345\t\t\t\tname += \" -> \" + target\n346\t\t\t}\n347\t\t}\n348\t\treturn permString(e.info.Mode) + \" \" +\n349\t\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n350\t\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n351\t\t\tformat.PadRight(e.group, w.group) + \" \" +\n352\t\t\tformat.PadLeft(size, w.size) + \" \" +\n353\t\t\tformatMtime(e.info.ModTime) + \" \" +\n354\t\t\tname\n355\t}\n356\t\n357\tfunc permString(mode os.FileMode) string {\n358\t\tvar b [10]byte\n359\t\tb[0] = fileTypeChar(mode)\n360\t\tconst rwx = \"rwx\"\n361\t\tperm := mode.Perm()\n362\t\tfor i := 0; i < 9; i++ {\n363\t\t\tif perm&(1<<uint(8-i)) != 0 {\n364\t\t\t\tb[1+i] = rwx[i%3]\n365\t\t\t} else {\n366\t\t\t\tb[1+i] = '-'\n367\t\t\t}\n368\t\t}\n369\t\tapplySpecialBits(mode, &b)\n370\t\treturn string(b[:])\n371\t}\n372\t\n373\tfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n374\t\tif mode&os.ModeSetuid != 0 {\n375\t\t\tif b[3] == 'x' {\n376\t\t\t\tb[3] = 's'\n377\t\t\t} else {\n378\t\t\t\tb[3] = 'S'\n379\t\t\t}\n380\t\t}\n381\t\tif mode&os.ModeSetgid != 0 {\n382\t\t\tif b[6] == 'x' {\n383\t\t\t\tb[6] = 's'\n384\t\t\t} else {\n385\t\t\t\tb[6] = 'S'\n386\t\t\t}\n387\t\t}\n388\t\tif mode&os.ModeSticky != 0 {\n389\t\t\tif b[9] == 'x' {\n390\t\t\t\tb[9] = 't'\n391\t\t\t} else {\n392\t\t\t\tb[9] = 'T'\n393\t\t\t}\n394\t\t}\n395\t}\n396\t\n397\tfunc fileTypeChar(mode os.FileMode) byte {\n398\t\tswitch {\n399\t\tcase mode&os.ModeDir != 0:\n400\t\t\treturn 'd'\n401\t\tcase mode&os.ModeSymlink != 0:\n402\t\t\treturn 'l'\n403\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n404\t\t\treturn 'c'\n405\t\tcase mode&os.ModeDevice != 0:\n406\t\t\treturn 'b'\n407\t\tcase mode&os.ModeNamedPipe != 0:\n408\t\t\treturn 'p'\n409\t\tcase mode&os.ModeSocket != 0:\n410\t\t\treturn 's'\n411\t\tdefault:\n412\t\t\treturn '-'\n413\t\t}\n414\t}\n415\t\n416\tfunc resolveOwner(uid uint32) string {\n417\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n418\t\tif err != nil {\n419\t\t\treturn strconv.FormatUint(uint64(uid), 10)\n420\t\t}\n421\t\treturn u.Username\n422\t}\n423\t\n424\tfunc resolveGroup(gid uint32) string {\n425\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n426\t\tif err != nil {\n427\t\t\treturn strconv.FormatUint(uint64(gid), 10)\n428\t\t}\n429\t\treturn g.Name\n430\t}\n431\t\n432\tfunc formatMtime(t time.Time) string {\n433\t\tsixMonths := 6 * 30 * 24 * time.Hour\n434\t\tago := time.Since(t)\n435\t\tif ago >= 0 && ago < sixMonths {\n436\t\t\treturn t.Format(\"Jan _2 15:04\")\n437\t\t}\n438\t\treturn t.Format(\"Jan _2  2006\")\n439\t}\n440\t\n441\tfunc writeLine(s string) {\n442\t\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n443\t\t\tos.Exit(1)\n444\t\t}\n445\t}\n446\t\n447\tfunc sysError(err error) string {\n448\t\tvar pathErr *os.PathError\n449\t\tif errors.As(err, &pathErr) {\n450\t\t\treturn pathErr.Err.Error()\n451\t\t}\n452\t\treturn err.Error()\n453\t}\n454\t"}]},"parent_tool_use_id":null,"session_id":"a04ad21e-648f-4773-9ded-6e08ddad38f7","uuid":"75be0d30-8ab7-4007-8698-70027d037f59","timestamp":"2026-05-14T21:22:33.623Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5205/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd008-ls R1.1-R1.12.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n  -C             list entries by columns\n  -1             list one file per line\n  -l             use a long listing format\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn bool\n\tlongFormat   bool\n\tforceColumns bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\tcase 'C':\n\t\t\topts.forceColumns = true\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\texitCode := 0\n\tfiles, dirs := classifyPaths(paths, &exitCode)\n\tneedSep := false\n\tif len(files) > 0 {\n\t\tsort.Strings(files)\n\t\tif opts.longFormat {\n\t\t\texitCode = maxCode(exitCode, writeLongFiles(files))\n\t\t} else {\n\t\t\twriteEntries(files, opts)\n\t\t}\n\t\tneedSep = true\n\t}\n\tshowHeader := len(dirs) > 1 || len(files) > 0\n\tfor _, dir := range dirs {\n\t\tif needSep {\n\t\t\tfmt.Fprintln(os.Stdout)\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n\t\t}\n\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n\t\tneedSep = true\n\t}\n\treturn exitCode\n}\n\nfunc classifyPaths(paths []string, exitCode *int) ([]string, []string) {\n\tvar files, dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\t*exitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\treturn files, dirs\n}\n\nfunc maxCode(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc listDir(path string, opts options) int {\n\tnames, err := readNames(path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n\t\t\tpath, sysError(err))\n\t\treturn 2\n\t}\n\tif opts.longFormat {\n\t\treturn writeLongDir(path, names)\n\t}\n\twriteEntries(names, opts)\n\treturn 0\n}\n\nfunc readNames(path string) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tfor _, e := range entries {\n\t\tif !strings.HasPrefix(e.Name(), \".\") {\n\t\t\tnames = append(names, e.Name())\n\t\t}\n\t}\n\tsort.Strings(names)\n\treturn names, nil\n}\n\nfunc writeEntries(names []string, opts options) {\n\tif len(names) == 0 {\n\t\treturn\n\t}\n\tif opts.forceColumns {\n\t\twriteColumnsWidth(names, 0)\n\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n\t\twriteLines(names)\n\t} else {\n\t\twriteColumnsWidth(names, 0)\n\t}\n}\n\nfunc writeColumnsWidth(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tgrid := format.Columns(names, width)\n\twidths := gridColumnWidths(grid)\n\tfor _, row := range grid {\n\t\twriteGridRow(row, widths)\n\t}\n}\n\nfunc writeLines(names []string) {\n\tfor _, name := range names {\n\t\twriteLine(name)\n\t}\n}\n\nfunc gridColumnWidths(grid [][]string) []int {\n\tif len(grid) == 0 {\n\t\treturn nil\n\t}\n\twidths := make([]int, len(grid[0]))\n\tfor _, row := range grid {\n\t\tfor c, cell := range row {\n\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n\t\t\t\twidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\treturn widths\n}\n\nfunc writeGridRow(row []string, widths []int) {\n\tvar b strings.Builder\n\tfor i, cell := range row {\n\t\tif i < len(row)-1 {\n\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n\t\t\tb.WriteString(\"  \")\n\t\t} else {\n\t\t\tb.WriteString(cell)\n\t\t}\n\t}\n\twriteLine(b.String())\n}\n\ntype longEntry struct {\n\tname  string\n\tpath  string\n\tinfo  *sys.FileInfo\n\towner string\n\tgroup string\n}\n\ntype longWidths struct {\n\tnlink int\n\towner int\n\tgroup int\n\tsize  int\n}\n\nfunc writeLongFiles(paths []string) int {\n\tentries := make([]longEntry, 0, len(paths))\n\tcode := 0\n\tfor _, p := range paths {\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(p, p, fi))\n\t}\n\twriteLongEntries(entries)\n\treturn code\n}\n\nfunc writeLongDir(path string, names []string) int {\n\tentries := make([]longEntry, 0, len(names))\n\tcode := 0\n\tfor _, name := range names {\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(full)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(name, full, fi))\n\t}\n\ttotalBlocks := int64(0)\n\tfor _, e := range entries {\n\t\ttotalBlocks += e.info.Blocks\n\t}\n\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n\twriteLongEntries(entries)\n\treturn code\n}\n\nfunc newLongEntry(name string, path string, fi *sys.FileInfo) longEntry {\n\treturn longEntry{\n\t\tname:  name,\n\t\tpath:  path,\n\t\tinfo:  fi,\n\t\towner: resolveOwner(fi.Uid),\n\t\tgroup: resolveGroup(fi.Gid),\n\t}\n}\n\nfunc writeLongEntries(entries []longEntry) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tw := computeLongWidths(entries)\n\tfor _, e := range entries {\n\t\twriteLine(formatLongLine(e, w))\n\t}\n}\n\nfunc computeLongWidths(entries []longEntry) longWidths {\n\tvar w longWidths\n\tfor _, e := range entries {\n\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n\t\t\tw.nlink = n\n\t\t}\n\t\tif n := len(e.owner); n > w.owner {\n\t\t\tw.owner = n\n\t\t}\n\t\tif n := len(e.group); n > w.group {\n\t\t\tw.group = n\n\t\t}\n\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n\t\t\tw.size = n\n\t\t}\n\t}\n\treturn w\n}\n\nfunc formatLongLine(e longEntry, w longWidths) string {\n\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n\tsize := strconv.FormatInt(e.info.Size, 10)\n\tname := e.name\n\tif e.info.Mode&os.ModeSymlink != 0 {\n\t\tif target, err := os.Readlink(e.path); err == nil {\n\t\t\tname += \" -> \" + target\n\t\t}\n\t}\n\treturn permString(e.info.Mode) + \" \" +\n\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n\t\tformat.PadRight(e.group, w.group) + \" \" +\n\t\tformat.PadLeft(size, w.size) + \" \" +\n\t\tformatMtime(e.info.ModTime) + \" \" +\n\t\tname\n}\n\nfunc permString(mode os.FileMode) string {\n\tvar b [10]byte\n\tb[0] = fileTypeChar(mode)\n\tconst rwx = \"rwx\"\n\tperm := mode.Perm()\n\tfor i := 0; i < 9; i++ {\n\t\tif perm&(1<<uint(8-i)) != 0 {\n\t\t\tb[1+i] = rwx[i%3]\n\t\t} else {\n\t\t\tb[1+i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(mode, &b)\n\treturn string(b[:])\n}\n\nfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif b[3] == 'x' {\n\t\t\tb[3] = 's'\n\t\t} else {\n\t\t\tb[3] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif b[6] == 'x' {\n\t\t\tb[6] = 's'\n\t\t} else {\n\t\t\tb[6] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif b[9] == 'x' {\n\t\t\tb[9] = 't'\n\t\t} else {\n\t\t\tb[9] = 'T'\n\t\t}\n\t}\n}\n\nfunc fileTypeChar(mode os.FileMode) byte {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn 'l'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\treturn 'b'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\treturn 's'\n\tdefault:\n\t\treturn '-'\n\t}\n}\n\nfunc resolveOwner(uid uint32) string {\n\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(uid), 10)\n\t}\n\treturn u.Username\n}\n\nfunc resolveGroup(gid uint32) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(gid), 10)\n\t}\n\treturn g.Name\n}\n\nfunc formatMtime(t time.Time) string {\n\tsixMonths := 6 * 30 * 24 * time.Hour\n\tago := time.Since(t)\n\tif ago >= 0 && ago < sixMonths {\n\t\treturn t.Format(\"Jan _2 15:04\")\n\t}\n\treturn t.Format(\"Jan _2  2006\")\n}\n\nfunc writeLine(s string) {\n\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc sysError(err error) string {\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\treturn pathErr.Err.Error()\n\t}\n\treturn err.Error()\n}\n","numLines":454,"startLine":1,"totalLines":454}}}
