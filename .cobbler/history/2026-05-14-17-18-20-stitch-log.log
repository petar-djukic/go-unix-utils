{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HVqshkF3GydE1LCHQBQPcL","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd008-ls R1.1-R1.8.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\t\"unicode/utf8\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n21\t)\n22\t\n23\tconst helpText = `Usage: ls [OPTION]... [FILE]...\n24\tList information about the FILEs (the current directory by default).\n25\tSort entries alphabetically if no flags given.\n26\t\n27\t  -1             list one file per line\n28\t  -l             use a long listing format\n29\t      --help     display this help and exit\n30\t      --version  output version information and exit\n31\t`\n32\t\n33\tconst versionText = `ls (go-unix-utils) dev\n34\t`\n35\t\n36\ttype options struct {\n37\t\tsingleColumn bool\n38\t\tlongFormat   bool\n39\t}\n40\t\n41\tfunc main() {\n42\t\tsys.InstallSIGPIPEHandler()\n43\t\topts, paths := parseArgs(os.Args[1:])\n44\t\tif len(paths) == 0 {\n45\t\t\tpaths = []string{\".\"}\n46\t\t}\n47\t\tos.Exit(run(paths, opts))\n48\t}\n49\t\n50\tfunc parseArgs(args []string) (options, []string) {\n51\t\tvar opts options\n52\t\tvar paths []string\n53\t\tfor len(args) > 0 {\n54\t\t\targ := args[0]\n55\t\t\targs = args[1:]\n56\t\t\tswitch {\n57\t\t\tcase arg == \"--help\":\n58\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n59\t\t\t\tos.Exit(0)\n60\t\t\tcase arg == \"--version\":\n61\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n62\t\t\t\tos.Exit(0)\n63\t\t\tcase arg == \"--\":\n64\t\t\t\treturn opts, append(paths, args...)\n65\t\t\tcase strings.HasPrefix(arg, \"--\"):\n66\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n67\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n68\t\t\t\tos.Exit(2)\n69\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n70\t\t\t\tparseShortFlags(arg[1:], &opts)\n71\t\t\tdefault:\n72\t\t\t\tpaths = append(paths, arg)\n73\t\t\t}\n74\t\t}\n75\t\treturn opts, paths\n76\t}\n77\t\n78\tfunc parseShortFlags(flags string, opts *options) {\n79\t\tfor _, ch := range flags {\n80\t\t\tswitch ch {\n81\t\t\tcase '1':\n82\t\t\t\tif !opts.longFormat {\n83\t\t\t\t\topts.singleColumn = true\n84\t\t\t\t}\n85\t\t\tcase 'l':\n86\t\t\t\topts.longFormat = true\n87\t\t\t\topts.singleColumn = false\n88\t\t\tdefault:\n89\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n90\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n91\t\t\t\tos.Exit(2)\n92\t\t\t}\n93\t\t}\n94\t}\n95\t\n96\tfunc run(paths []string, opts options) int {\n97\t\texitCode := 0\n98\t\tfiles, dirs := classifyPaths(paths, &exitCode)\n99\t\tneedSep := false\n100\t\tif len(files) > 0 {\n101\t\t\tsort.Strings(files)\n102\t\t\tif opts.longFormat {\n103\t\t\t\texitCode = maxCode(exitCode, writeLongFiles(files))\n104\t\t\t} else {\n105\t\t\t\twriteEntries(files, opts)\n106\t\t\t}\n107\t\t\tneedSep = true\n108\t\t}\n109\t\tshowHeader := len(dirs) > 1 || len(files) > 0\n110\t\tfor _, dir := range dirs {\n111\t\t\tif needSep {\n112\t\t\t\tfmt.Fprintln(os.Stdout)\n113\t\t\t}\n114\t\t\tif showHeader {\n115\t\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n116\t\t\t}\n117\t\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n118\t\t\tneedSep = true\n119\t\t}\n120\t\treturn exitCode\n121\t}\n122\t\n123\tfunc classifyPaths(paths []string, exitCode *int) ([]string, []string) {\n124\t\tvar files, dirs []string\n125\t\tfor _, p := range paths {\n126\t\t\tinfo, err := os.Lstat(p)\n127\t\t\tif err != nil {\n128\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n129\t\t\t\t*exitCode = 2\n130\t\t\t\tcontinue\n131\t\t\t}\n132\t\t\tif info.IsDir() {\n133\t\t\t\tdirs = append(dirs, p)\n134\t\t\t} else {\n135\t\t\t\tfiles = append(files, p)\n136\t\t\t}\n137\t\t}\n138\t\treturn files, dirs\n139\t}\n140\t\n141\tfunc maxCode(a, b int) int {\n142\t\tif a > b {\n143\t\t\treturn a\n144\t\t}\n145\t\treturn b\n146\t}\n147\t\n148\tfunc listDir(path string, opts options) int {\n149\t\tnames, err := readNames(path)\n150\t\tif err != nil {\n151\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n152\t\t\t\tpath, sysError(err))\n153\t\t\treturn 2\n154\t\t}\n155\t\tif opts.longFormat {\n156\t\t\treturn writeLongDir(path, names)\n157\t\t}\n158\t\twriteEntries(names, opts)\n159\t\treturn 0\n160\t}\n161\t\n162\tfunc readNames(path string) ([]string, error) {\n163\t\tentries, err := os.ReadDir(path)\n164\t\tif err != nil {\n165\t\t\treturn nil, err\n166\t\t}\n167\t\tnames := make([]string, 0, len(entries))\n168\t\tfor _, e := range entries {\n169\t\t\tif !strings.HasPrefix(e.Name(), \".\") {\n170\t\t\t\tnames = append(names, e.Name())\n171\t\t\t}\n172\t\t}\n173\t\tsort.Strings(names)\n174\t\treturn names, nil\n175\t}\n176\t\n177\tfunc writeEntries(names []string, opts options) {\n178\t\tif len(names) == 0 {\n179\t\t\treturn\n180\t\t}\n181\t\tif opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n182\t\t\twriteLines(names)\n183\t\t} else {\n184\t\t\twriteColumns(names)\n185\t\t}\n186\t}\n187\t\n188\tfunc writeColumns(names []string) {\n189\t\ttermWidth, err := sys.TerminalWidth()\n190\t\tif err != nil {\n191\t\t\ttermWidth = 80\n192\t\t}\n193\t\tgrid := format.Columns(names, termWidth)\n194\t\twidths := gridColumnWidths(grid)\n195\t\tfor _, row := range grid {\n196\t\t\twriteGridRow(row, widths)\n197\t\t}\n198\t}\n199\t\n200\tfunc writeLines(names []string) {\n201\t\tfor _, name := range names {\n202\t\t\twriteLine(name)\n203\t\t}\n204\t}\n205\t\n206\tfunc gridColumnWidths(grid [][]string) []int {\n207\t\tif len(grid) == 0 {\n208\t\t\treturn nil\n209\t\t}\n210\t\twidths := make([]int, len(grid[0]))\n211\t\tfor _, row := range grid {\n212\t\t\tfor c, cell := range row {\n213\t\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n214\t\t\t\t\twidths[c] = w\n215\t\t\t\t}\n216\t\t\t}\n217\t\t}\n218\t\treturn widths\n219\t}\n220\t\n221\tfunc writeGridRow(row []string, widths []int) {\n222\t\tvar b strings.Builder\n223\t\tfor i, cell := range row {\n224\t\t\tif i < len(row)-1 {\n225\t\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n226\t\t\t\tb.WriteString(\"  \")\n227\t\t\t} else {\n228\t\t\t\tb.WriteString(cell)\n229\t\t\t}\n230\t\t}\n231\t\twriteLine(b.String())\n232\t}\n233\t\n234\ttype longEntry struct {\n235\t\tname  string\n236\t\tinfo  *sys.FileInfo\n237\t\towner string\n238\t\tgroup string\n239\t}\n240\t\n241\ttype longWidths struct {\n242\t\tnlink int\n243\t\towner int\n244\t\tgroup int\n245\t\tsize  int\n246\t}\n247\t\n248\tfunc writeLongFiles(paths []string) int {\n249\t\tentries := make([]longEntry, 0, len(paths))\n250\t\tcode := 0\n251\t\tfor _, p := range paths {\n252\t\t\tfi, err := sys.Lstat(p)\n253\t\t\tif err != nil {\n254\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n255\t\t\t\tcode = 2\n256\t\t\t\tcontinue\n257\t\t\t}\n258\t\t\tentries = append(entries, newLongEntry(p, fi))\n259\t\t}\n260\t\twriteLongEntries(entries)\n261\t\treturn code\n262\t}\n263\t\n264\tfunc writeLongDir(path string, names []string) int {\n265\t\tentries := make([]longEntry, 0, len(names))\n266\t\tcode := 0\n267\t\tfor _, name := range names {\n268\t\t\tfull := filepath.Join(path, name)\n269\t\t\tfi, err := sys.Lstat(full)\n270\t\t\tif err != nil {\n271\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n272\t\t\t\tcode = 2\n273\t\t\t\tcontinue\n274\t\t\t}\n275\t\t\tentries = append(entries, newLongEntry(name, fi))\n276\t\t}\n277\t\ttotalBlocks := int64(0)\n278\t\tfor _, e := range entries {\n279\t\t\ttotalBlocks += e.info.Blocks\n280\t\t}\n281\t\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n282\t\twriteLongEntries(entries)\n283\t\treturn code\n284\t}\n285\t\n286\tfunc newLongEntry(name string, fi *sys.FileInfo) longEntry {\n287\t\treturn longEntry{\n288\t\t\tname:  name,\n289\t\t\tinfo:  fi,\n290\t\t\towner: resolveOwner(fi.Uid),\n291\t\t\tgroup: resolveGroup(fi.Gid),\n292\t\t}\n293\t}\n294\t\n295\tfunc writeLongEntries(entries []longEntry) {\n296\t\tif len(entries) == 0 {\n297\t\t\treturn\n298\t\t}\n299\t\tw := computeLongWidths(entries)\n300\t\tfor _, e := range entries {\n301\t\t\twriteLine(formatLongLine(e, w))\n302\t\t}\n303\t}\n304\t\n305\tfunc computeLongWidths(entries []longEntry) longWidths {\n306\t\tvar w longWidths\n307\t\tfor _, e := range entries {\n308\t\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n309\t\t\t\tw.nlink = n\n310\t\t\t}\n311\t\t\tif n := len(e.owner); n > w.owner {\n312\t\t\t\tw.owner = n\n313\t\t\t}\n314\t\t\tif n := len(e.group); n > w.group {\n315\t\t\t\tw.group = n\n316\t\t\t}\n317\t\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n318\t\t\t\tw.size = n\n319\t\t\t}\n320\t\t}\n321\t\treturn w\n322\t}\n323\t\n324\tfunc formatLongLine(e longEntry, w longWidths) string {\n325\t\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n326\t\tsize := strconv.FormatInt(e.info.Size, 10)\n327\t\treturn permString(e.info.Mode) + \" \" +\n328\t\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n329\t\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n330\t\t\tformat.PadRight(e.group, w.group) + \" \" +\n331\t\t\tformat.PadLeft(size, w.size) + \" \" +\n332\t\t\tformatMtime(e.info.ModTime) + \" \" +\n333\t\t\te.name\n334\t}\n335\t\n336\tfunc permString(mode os.FileMode) string {\n337\t\tvar b [10]byte\n338\t\tb[0] = fileTypeChar(mode)\n339\t\tconst rwx = \"rwx\"\n340\t\tperm := mode.Perm()\n341\t\tfor i := 0; i < 9; i++ {\n342\t\t\tif perm&(1<<uint(8-i)) != 0 {\n343\t\t\t\tb[1+i] = rwx[i%3]\n344\t\t\t} else {\n345\t\t\t\tb[1+i] = '-'\n346\t\t\t}\n347\t\t}\n348\t\tapplySpecialBits(mode, &b)\n349\t\treturn string(b[:])\n350\t}\n351\t\n352\tfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n353\t\tif mode&os.ModeSetuid != 0 {\n354\t\t\tif b[3] == 'x' {\n355\t\t\t\tb[3] = 's'\n356\t\t\t} else {\n357\t\t\t\tb[3] = 'S'\n358\t\t\t}\n359\t\t}\n360\t\tif mode&os.ModeSetgid != 0 {\n361\t\t\tif b[6] == 'x' {\n362\t\t\t\tb[6] = 's'\n363\t\t\t} else {\n364\t\t\t\tb[6] = 'S'\n365\t\t\t}\n366\t\t}\n367\t\tif mode&os.ModeSticky != 0 {\n368\t\t\tif b[9] == 'x' {\n369\t\t\t\tb[9] = 't'\n370\t\t\t} else {\n371\t\t\t\tb[9] = 'T'\n372\t\t\t}\n373\t\t}\n374\t}\n375\t\n376\tfunc fileTypeChar(mode os.FileMode) byte {\n377\t\tswitch {\n378\t\tcase mode&os.ModeDir != 0:\n379\t\t\treturn 'd'\n380\t\tcase mode&os.ModeSymlink != 0:\n381\t\t\treturn 'l'\n382\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n383\t\t\treturn 'c'\n384\t\tcase mode&os.ModeDevice != 0:\n385\t\t\treturn 'b'\n386\t\tcase mode&os.ModeNamedPipe != 0:\n387\t\t\treturn 'p'\n388\t\tcase mode&os.ModeSocket != 0:\n389\t\t\treturn 's'\n390\t\tdefault:\n391\t\t\treturn '-'\n392\t\t}\n393\t}\n394\t\n395\tfunc resolveOwner(uid uint32) string {\n396\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n397\t\tif err != nil {\n398\t\t\treturn strconv.FormatUint(uint64(uid), 10)\n399\t\t}\n400\t\treturn u.Username\n401\t}\n402\t\n403\tfunc resolveGroup(gid uint32) string {\n404\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n405\t\tif err != nil {\n406\t\t\treturn strconv.FormatUint(uint64(gid), 10)\n407\t\t}\n408\t\treturn g.Name\n409\t}\n410\t\n411\tfunc formatMtime(t time.Time) string {\n412\t\tsixMonths := 6 * 30 * 24 * time.Hour\n413\t\tago := time.Since(t)\n414\t\tif ago >= 0 && ago < sixMonths {\n415\t\t\treturn t.Format(\"Jan _2 15:04\")\n416\t\t}\n417\t\treturn t.Format(\"Jan _2  2006\")\n418\t}\n419\t\n420\tfunc writeLine(s string) {\n421\t\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n422\t\t\tos.Exit(1)\n423\t\t}\n424\t}\n425\t\n426\tfunc sysError(err error) string {\n427\t\tvar pathErr *os.PathError\n428\t\tif errors.As(err, &pathErr) {\n429\t\t\treturn pathErr.Err.Error()\n430\t\t}\n431\t\treturn err.Error()\n432\t}\n433\t"}]},"parent_tool_use_id":null,"session_id":"a04ad21e-648f-4773-9ded-6e08ddad38f7","uuid":"8b981d42-ee22-44da-9e79-908481dafe00","timestamp":"2026-05-14T21:18:29.279Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5205/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd008-ls R1.1-R1.8.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n  -1             list one file per line\n  -l             use a long listing format\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn bool\n\tlongFormat   bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\texitCode := 0\n\tfiles, dirs := classifyPaths(paths, &exitCode)\n\tneedSep := false\n\tif len(files) > 0 {\n\t\tsort.Strings(files)\n\t\tif opts.longFormat {\n\t\t\texitCode = maxCode(exitCode, writeLongFiles(files))\n\t\t} else {\n\t\t\twriteEntries(files, opts)\n\t\t}\n\t\tneedSep = true\n\t}\n\tshowHeader := len(dirs) > 1 || len(files) > 0\n\tfor _, dir := range dirs {\n\t\tif needSep {\n\t\t\tfmt.Fprintln(os.Stdout)\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n\t\t}\n\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n\t\tneedSep = true\n\t}\n\treturn exitCode\n}\n\nfunc classifyPaths(paths []string, exitCode *int) ([]string, []string) {\n\tvar files, dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\t*exitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\treturn files, dirs\n}\n\nfunc maxCode(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc listDir(path string, opts options) int {\n\tnames, err := readNames(path)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n\t\t\tpath, sysError(err))\n\t\treturn 2\n\t}\n\tif opts.longFormat {\n\t\treturn writeLongDir(path, names)\n\t}\n\twriteEntries(names, opts)\n\treturn 0\n}\n\nfunc readNames(path string) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tfor _, e := range entries {\n\t\tif !strings.HasPrefix(e.Name(), \".\") {\n\t\t\tnames = append(names, e.Name())\n\t\t}\n\t}\n\tsort.Strings(names)\n\treturn names, nil\n}\n\nfunc writeEntries(names []string, opts options) {\n\tif len(names) == 0 {\n\t\treturn\n\t}\n\tif opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n\t\twriteLines(names)\n\t} else {\n\t\twriteColumns(names)\n\t}\n}\n\nfunc writeColumns(names []string) {\n\ttermWidth, err := sys.TerminalWidth()\n\tif err != nil {\n\t\ttermWidth = 80\n\t}\n\tgrid := format.Columns(names, termWidth)\n\twidths := gridColumnWidths(grid)\n\tfor _, row := range grid {\n\t\twriteGridRow(row, widths)\n\t}\n}\n\nfunc writeLines(names []string) {\n\tfor _, name := range names {\n\t\twriteLine(name)\n\t}\n}\n\nfunc gridColumnWidths(grid [][]string) []int {\n\tif len(grid) == 0 {\n\t\treturn nil\n\t}\n\twidths := make([]int, len(grid[0]))\n\tfor _, row := range grid {\n\t\tfor c, cell := range row {\n\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n\t\t\t\twidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\treturn widths\n}\n\nfunc writeGridRow(row []string, widths []int) {\n\tvar b strings.Builder\n\tfor i, cell := range row {\n\t\tif i < len(row)-1 {\n\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n\t\t\tb.WriteString(\"  \")\n\t\t} else {\n\t\t\tb.WriteString(cell)\n\t\t}\n\t}\n\twriteLine(b.String())\n}\n\ntype longEntry struct {\n\tname  string\n\tinfo  *sys.FileInfo\n\towner string\n\tgroup string\n}\n\ntype longWidths struct {\n\tnlink int\n\towner int\n\tgroup int\n\tsize  int\n}\n\nfunc writeLongFiles(paths []string) int {\n\tentries := make([]longEntry, 0, len(paths))\n\tcode := 0\n\tfor _, p := range paths {\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(p, fi))\n\t}\n\twriteLongEntries(entries)\n\treturn code\n}\n\nfunc writeLongDir(path string, names []string) int {\n\tentries := make([]longEntry, 0, len(names))\n\tcode := 0\n\tfor _, name := range names {\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(full)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(name, fi))\n\t}\n\ttotalBlocks := int64(0)\n\tfor _, e := range entries {\n\t\ttotalBlocks += e.info.Blocks\n\t}\n\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n\twriteLongEntries(entries)\n\treturn code\n}\n\nfunc newLongEntry(name string, fi *sys.FileInfo) longEntry {\n\treturn longEntry{\n\t\tname:  name,\n\t\tinfo:  fi,\n\t\towner: resolveOwner(fi.Uid),\n\t\tgroup: resolveGroup(fi.Gid),\n\t}\n}\n\nfunc writeLongEntries(entries []longEntry) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tw := computeLongWidths(entries)\n\tfor _, e := range entries {\n\t\twriteLine(formatLongLine(e, w))\n\t}\n}\n\nfunc computeLongWidths(entries []longEntry) longWidths {\n\tvar w longWidths\n\tfor _, e := range entries {\n\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n\t\t\tw.nlink = n\n\t\t}\n\t\tif n := len(e.owner); n > w.owner {\n\t\t\tw.owner = n\n\t\t}\n\t\tif n := len(e.group); n > w.group {\n\t\t\tw.group = n\n\t\t}\n\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n\t\t\tw.size = n\n\t\t}\n\t}\n\treturn w\n}\n\nfunc formatLongLine(e longEntry, w longWidths) string {\n\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n\tsize := strconv.FormatInt(e.info.Size, 10)\n\treturn permString(e.info.Mode) + \" \" +\n\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n\t\tformat.PadRight(e.group, w.group) + \" \" +\n\t\tformat.PadLeft(size, w.size) + \" \" +\n\t\tformatMtime(e.info.ModTime) + \" \" +\n\t\te.name\n}\n\nfunc permString(mode os.FileMode) string {\n\tvar b [10]byte\n\tb[0] = fileTypeChar(mode)\n\tconst rwx = \"rwx\"\n\tperm := mode.Perm()\n\tfor i := 0; i < 9; i++ {\n\t\tif perm&(1<<uint(8-i)) != 0 {\n\t\t\tb[1+i] = rwx[i%3]\n\t\t} else {\n\t\t\tb[1+i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(mode, &b)\n\treturn string(b[:])\n}\n\nfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif b[3] == 'x' {\n\t\t\tb[3] = 's'\n\t\t} else {\n\t\t\tb[3] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif b[6] == 'x' {\n\t\t\tb[6] = 's'\n\t\t} else {\n\t\t\tb[6] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif b[9] == 'x' {\n\t\t\tb[9] = 't'\n\t\t} else {\n\t\t\tb[9] = 'T'\n\t\t}\n\t}\n}\n\nfunc fileTypeChar(mode os.FileMode) byte {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn 'l'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\treturn 'b'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\treturn 's'\n\tdefault:\n\t\treturn '-'\n\t}\n}\n\nfunc resolveOwner(uid uint32) string {\n\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(uid), 10)\n\t}\n\treturn u.Username\n}\n\nfunc resolveGroup(gid uint32) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(gid), 10)\n\t}\n\treturn g.Name\n}\n\nfunc formatMtime(t time.Time) string {\n\tsixMonths := 6 * 30 * 24 * time.Hour\n\tago := time.Since(t)\n\tif ago >= 0 && ago < sixMonths {\n\t\treturn t.Format(\"Jan _2 15:04\")\n\t}\n\treturn t.Format(\"Jan _2  2006\")\n}\n\nfunc writeLine(s string) {\n\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc sysError(err error) string {\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\treturn pathErr.Err.Error()\n\t}\n\treturn err.Error()\n}\n","numLines":433,"startLine":1,"totalLines":433}}}
