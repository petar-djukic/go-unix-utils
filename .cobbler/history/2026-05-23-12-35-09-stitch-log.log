rr)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc parseFlags() (opts, []string, error) {\n\tvar o opts\n\tfs := flag.NewFlagSet(filepath.Base(os.Args[0]), flag.ContinueOnError)\n\tfs.SetOutput(os.Stderr)\n\tfs.Usage = func() {}\n\tfs.StringVar(&o.sizeStr, \"s\", \"\", \"\")\n\tfs.StringVar(&o.sizeStr, \"size\", \"\", \"\")\n\tfs.BoolVar(&o.noCreate, \"c\", false, \"\")\n\tfs.BoolVar(&o.noCreate, \"no-create\", false, \"\")\n\tfs.StringVar(&o.refFile, \"r\", \"\", \"\")\n\tfs.StringVar(&o.refFile, \"reference\", \"\", \"\")\n\tif err := fs.Parse(os.Args[1:]); err != nil {\n\t\treturn o, nil, err\n\t}\n\tfs.Visit(func(f *flag.Flag) {\n\t\tswitch f.Name {\n\t\tcase \"s\", \"size\":\n\t\t\to.sizeSet = true\n\t\tcase \"r\", \"reference\":\n\t\t\to.refSet = true\n\t\t}\n\t})\n\treturn o, fs.Args(), nil\n}\n\nfunc innerError(err error) string {\n\tif pe, ok := err.(*os.PathError); ok {\n\t\treturn pe.Err.Error()\n\t}\n\treturn err.Error()\n}\n\nfunc parseSizeSpec(s string) (byte, int64, error) {\n\tif s == \"\" {\n\t\treturn 0, 0, fmt.Errorf(\"empty\")\n\t}\n\tswitch s[0] {\n\tcase '+', '-', '<', '>', '/', '%':\n\t\tval, err := sizeparse.ParseWithOptions(s[1:], sizeparse.ParseOptions{})\n\t\tif err != nil {\n\t\t\treturn 0, 0, err\n\t\t}\n\t\treturn s[0], val, nil\n\tdefault:\n\t\tval, err := sizeparse.ParseWithOptions(s, sizeparse.ParseOptions{})\n\t\tif err != nil {\n\t\t\treturn 0, 0, err\n\t\t}\n\t\treturn 0, val, nil\n\t}\n}\n\nfunc computeNewSize(current int64, mode byte, value int64) int64 {\n\tswitch mode {\n\tcase '+':\n\t\treturn current + value\n\tcase '-':\n\t\tif current < value {\n\t\t\treturn 0\n\t\t}\n\t\treturn current - value\n\tcase '<':\n\t\tif current > value {\n\t\t\treturn value\n\t\t}\n\t\treturn current\n\tcase '>':\n\t\tif current < value {\n\t\t\treturn value\n\t\t}\n\t\treturn current\n\tcase '/':\n\t\tif value == 0 {\n\t\t\treturn current\n\t\t}\n\t\treturn (current / value) * value\n\tcase '%':\n\t\tif value == 0 {\n\t\t\treturn current\n\t\t}\n\t\trem := current % value\n\t\tif rem == 0 {\n\t\t\treturn current\n\t\t}\n\t\treturn current + value - rem\n\tdefault:\n\t\treturn value\n\t}\n}\n\nfunc processFile(path string, refSize int64, hasRef, hasSize bool, mode byte, sizeVal int64, noCreate bool) error {\n\tvar currentSize int64\n\tfi, err := os.Stat(path)\n\tif err != nil {\n\t\tif !os.IsNotExist(err) {\n\t\t\treturn err\n\t\t}\n\t\tif noCreate {\n\t\t\treturn nil\n\t\t}\n\t\tf, createErr := os.OpenFile(path, os.O_CREATE|os.O_WRONLY, 0666)\n\t\tif createErr != nil {\n\t\t\treturn createErr\n\t\t}\n\t\tf.Close()\n\t} else {\n\t\tcurrentSize = fi.Size()\n\t}\n\tbase := currentSize\n\tif hasRef {\n\t\tbase = refSize\n\t}\n\tvar newSize int64\n\tif hasSize {\n\t\tnewSize = computeNewSize(base, mode, sizeVal)\n\t} else {\n\t\tnewSize = base\n\t}\n\treturn os.Truncate(path, newSize)\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1093,"cache_read_input_tokens":26144,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1093},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5d300cbb-1173-48e1-93b4-4f506bd94bc9","uuid":"87243a3b-0c7f-4a8b-9c56-9a247d01e16c"}
