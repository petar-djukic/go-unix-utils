98\t\t\t}\n199\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n200\t\t\t\t[]string{\"src.txt\", \"nowrite/dest.txt\"}, errNorm)\n201\t\t\tcheckFile(t, goDir, \"src.txt\", \"hello\\n\")\n202\t\t})\n203\t\n204\t\tt.Run(\"r3_1_verbose_rename\", func(t *testing.T) {\n205\t\t\tsetup := func(t *testing.T, dir string) {\n206\t\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n207\t\t\t}\n208\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n209\t\t\t\t[]string{\"-v\", \"src.txt\", \"dest.txt\"}, nil)\n210\t\t\tcheckFile(t, goDir, \"dest.txt\", \"hello\\n\")\n211\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n212\t\t})\n213\t\n214\t\tt.Run(\"r3_1_verbose_into_dir\", func(t *testing.T) {\n215\t\t\tsetup := func(t *testing.T, dir string) {\n216\t\t\t\twriteFile(t, dir, \"file.txt\", \"content\\n\")\n217\t\t\t\tos.Mkdir(filepath.Join(dir, \"dest\"), 0o755)\n218\t\t\t}\n219\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n220\t\t\t\t[]string{\"-v\", \"file.txt\", \"dest\"}, nil)\n221\t\t\tcheckFile(t, goDir, \"dest/file.txt\", \"content\\n\")\n222\t\t\tcheckAbsent(t, goDir, \"file.txt\")\n223\t\t})\n224\t\n225\t\tt.Run(\"r3_1_verbose_overwrite\", func(t *testing.T) {\n226\t\t\tsetup := func(t *testing.T, dir string) {\n227\t\t\t\twriteFile(t, dir, \"src.txt\", \"new\\n\")\n228\t\t\t\twriteFile(t, dir, \"dest.txt\", \"old\\n\")\n229\t\t\t}\n230\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n231\t\t\t\t[]string{\"-v\", \"src.txt\", \"dest.txt\"}, nil)\n232\t\t\tcheckFile(t, goDir, \"dest.txt\", \"new\\n\")\n233\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n234\t\t})\n235\t\n236\t\tt.Run(\"r3_1_verbose_long_flag\", func(t *testing.T) {\n237\t\t\tsetup := func(t *testing.T, dir string) {\n238\t\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n239\t\t\t}\n240\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n241\t\t\t\t[]string{\"--verbose\", \"src.txt\", \"dest.txt\"}, nil)\n242\t\t\tcheckFile(t, goDir, \"dest.txt\", \"hello\\n\")\n243\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n244\t\t