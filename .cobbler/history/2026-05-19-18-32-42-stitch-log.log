ay not be installed\")\n\t}\n\tif err != nil {\n\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n\t}\n}\n\nfunc sha1hex(data []byte) string {\n\tsum := sha1.Sum(data)\n\treturn hex.EncodeToString(sum[:])\n}\n\nfunc writeFile(t *testing.T, path, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1065,"cache_read_input_tokens":28384,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1065},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6891220b-f751-47d7-8e06-cab7cc8e84af","uuid":"1160a219-dbb6-4960-8328-06ef08863cda"}
