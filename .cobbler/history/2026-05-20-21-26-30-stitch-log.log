es[len(files)-1]\n74\t\tsources := files[:len(files)-1]\n75\t\tcode := 0\n76\t\tif len(sources) > 1 {\n77\t\t\tcode = moveMultiple(sources, dest, opts)\n78\t\t} else {\n79\t\t\tcode = moveSingle(sources[0], dest, opts)\n80\t\t}\n81\t\tif code != 0 {\n82\t\t\tos.Exit(code)\n83\t\t}\n84\t}\n85\t\n86\tfunc parseFlags(args []string) ([]string, options) {\n87\t\tvar files []string\n88\t\tvar opts options\n89\t\tendOfFlags := false\n90\t\tfor i := 0; i < len(args); i++ {\n91\t\t\targ := args[i]\n92\t\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n93\t\t\t\tfiles = append(files, arg)\n94\t\t\t\tcontinue\n95\t\t\t}\n96\t\t\tif arg == \"--\" {\n97\t\t\t\tendOfFlags = true\n98\t\t\t\tcontinue\n99\t\t\t}\n100\t\t\tif strings.HasPrefix(arg, \"--\") {\n101\t\t\t\tswitch {\n102\t\t\t\tcase arg == \"--interactive\":\n103\t\t\t\t\topts.mode = modeInteractive\n104\t\t\t\tcase arg == \"--force\":\n105\t\t\t\t\topts.mode = modeForce\n106\t\t\t\tcase arg == \"--no-clobber\":\n107\t\t\t\t\topts.mode = modeNoClobber\n108\t\t\t\tcase arg == \"--verbose\":\n109\t\t\t\t\topts.verbose = true\n110\t\t\t\tcase arg == \"--no-target-directory\":\n111\t\t\t\t\topts.noTargetDir = true\n112\t\t\t\tcase arg == \"--target-directory\":\n113\t\t\t\t\ti++\n114\t\t\t\t\tif i < len(args) {\n115\t\t\t\t\t\topts.targetDir = args[i]\n116\t\t\t\t\t}\n117\t\t\t\tcase strings.HasPrefix(arg, \"--target-directory=\"):\n118\t\t\t\t\topts.targetDir = arg[len(\"--target-directory=\"):]\n119\t\t\t\t}\n120\t\t\t\tcontinue\n121\t\t\t}\n122\t\t\tchars := arg[1:]\n123\t\t\tfor j := 0; j < len(chars); j++ {\n124\t\t\t\tswitch chars[j] {\n125\t\t\t\tcase 'i':\n126\t\t\t\t\topts.mode = modeInteractive\n127\t\t\t\tcase 'f':\n128\t\t\t\t\topts.mode = modeForce\n129\t\t\t\tcase 'n':\n130\t\t\t\t\topts.mode = modeNoClobber\n131\t\t\t\tcase 'v':\n132\t\t\t\t\topts.verbose = true\n133\t\t\t\tcase 'T':\n134\t\t\t\t\topts.noTargetDir = true\n135\t\t\t\tcase 't':\n136\t\t\t\t\trest := chars[j+1:]\n137\t\t\t\t\tif len(rest) > 0 {\n138\t\t\t\t\t\topts.targetDir = rest\n139\t\t\t\t\t} else {\n140\t\t\t\t\t\ti++\n141\t\t\t\t\t\tif i < len(args) {\n142\t\t\t\t\t\t\topts.targetDir = args[i]\n143\t\t\t\t\t\t}\n144\t\t\t\t\t}\n145\t\t\t\t\tj = len(chars)\n146\t\t\t\t}\n147\t\t\t}\n148\t\t}\n149\t\treturn files, opts\n150\t}\n151\t\n152\tfunc moveSingle(src, dest string, opts options) int {\n153\t\tif !opts.noTargetDir {\n154\t\t\tinfo, err := os.Stat(dest)\n155\t\t\tif err == nil && info.IsDir() {\n156\t\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n157\t\t\t}\n158\t\t}\n159\t\tswitch checkOverwrite(dest, opts.mode) {\n160\t\tcase owSkip:\n161\t\t\treturn 0\n162\t\tcase owSkipError:\n163\t\t\treturn 1\n164\t\t}\n165\t\trenamed, err := moveFile(src, dest)\n166\t\tif err != nil {\n167\t\t\tfmt.Fprintf(os.Stderr, \"mv: %s\\n\", err)\n168\t\t\treturn 1\n169\t\t}\n170\t\tif opts.verbose {\n171\t\t\tprintVerbose(src, dest, renamed)\n172\t\t}\n173\t\treturn 0\n174\t}\n175\t\n176\tfunc moveMultiple(sources []string, dest string, opts options) int {\n177\t\tinfo, err := os.Stat(dest)\n178\t\tif err != nil || !info.IsDir() {\n179\t\t\tfmt.Fprintf(os.Stderr, \"mv: target '%s': not a directory\\n\", dest)\n180\t\t\treturn 1\n181\t\t}\n182\t\tcode := 0\n183\t\tfor _, src := range sources {\n184\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n185\t\t\tswitch checkOverwrite(target, opts.mode) {\n186\t\t\tcase owSkip:\n187\t\t\t\tcontinue\n188\t\t\tcase owSkipError:\n189\t\t\t\tcode = 1\n190\t\t\t\tcontinue\n191\t\t\t}\n192\t\t\trenamed, err := moveFile(src, target)\n193\t\t\tif err != nil {\n194\t\t\t\tfmt.Fprintf(os.Stderr, \"mv: %s\\n\", err)\n195\t\t\t\tcode = 1\n196\t\t\t\tcontinue\n197\t\t\t}\n198\t\t\tif opts.verbose {\n199\t\t\t\tprintVerbose(src, target, renamed)\n200\t\t\t}\n201\t\t}\n202\t\treturn code\n203\t}\n204\t\n205\ttype overwriteAction int\n206\t\n207\tconst (\n208\t\towProceed   overwriteAction = iota\n209\t\towSkip\n210\t\towSkipError\n211\t)\n212\t\n213\tfunc checkOverwrite(dest string, mode overwriteMode) overwriteAction {\n214\t\tif _, err := os.Lstat(dest); err != nil {\n215\t\t\treturn owProceed\n216\t\t}\n217\t\tswitch mode {\n218\t\tcase modeNoClobber:\n219\t\t\treturn owSkip\n220\t\tcase modeInteractive:\n221\t\t\tif promptOverwrite(dest) {\n222\t\t\t\treturn owProceed\n223\t\t\t}\n224\t\t\treturn owSkipError\n225\t\t}\n226\t\treturn owProceed\n227\t}\n228\t\n229\tfunc promptOverwrite(dest string) bool {\n230\t\tfmt.Fprintf(os.Stderr, \"mv: overwrite '%s'? \", dest)\n231\t\tif !stdinScanner.Scan() {\n232\t\t\treturn false\n233\t\t}\n234\t\tline := stdinScanner.Text()\n235\t\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n236\t}\n237\t\n238\tfunc moveFile(src, dest string) (bool, error) {\n239\t\tsrcInfo, err := os.Lstat(src)\n240\t\tif err != nil {\n241\t\t\treturn false, fmtPathErr(\"cannot stat\", src, err)\n242\t\t}\n243\t\terr = os.Rename(src, dest)\n244\t\tif err == nil {\n245\t\t\treturn true, nil\n246\t\t}\n247\t\tif isCrossDevice(err) {\n248\t\t\treturn false, crossDeviceMove(src, dest)\n249\t\t}\n250\t\tif srcInfo.IsDir() && isDirExistsErr(err) {\n251\t\t\tif rmErr := os.Remove(dest); rmErr == nil {\n252\t\t\t\tif err2 := os.Rename(src, dest); err2 == nil {\n253\t\t\t\t\treturn true, nil\n254\t\t\t\t}\n255\t\t\t}\n256\t\t}\n257\t\tif !srcInfo.IsDir() {\n258\t\t\tif di, derr := os.Lstat(dest); derr == nil && di.IsDir() {\n259\t\t\t\treturn false, fmt.Errorf(\n260\t\t\t\t\t\"cannot overwrite directory '%s' with non-directory '%s'\", dest, src)\n261\t\t\t}\n262\t\t}\n263\t\treturn false, fmtMoveErr(src, dest, err)\n264\t}\n265\t\n266\tfunc printVerbose(src, dest string, renamed bool) {\n267\t\tif renamed {\n268\t\t\tfmt.Printf(\"renamed '%s' -> '%s'\\n\", src, dest)\n269\t\t} else {\n270\t\t\tfmt.Printf(\"'%s' -> '%s'\\n\", src, dest)\n271\t\t}\n272\t}\n273\t\n274\tfunc isCrossDevice(err error) bool {\n275\t\tif linkErr, ok := errors.AsType[*os.LinkError](err); ok {\n276\t\t\treturn errors.Is(linkErr.Err, sysca