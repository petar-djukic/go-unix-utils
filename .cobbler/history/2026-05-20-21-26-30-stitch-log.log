t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n154\t\t\t\t[]string{\"-f\", \"src.txt\", \"dest.txt\"}, nil)\n155\t\t\tcheckFile(t, goDir, \"dest.txt\", \"new\\n\")\n156\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n157\t\t})\n158\t\n159\t\tt.Run(\"r2_2_force_after_interactive\", func(t *testing.T) {\n160\t\t\tsetup := func(t *testing.T, dir string) {\n161\t\t\t\twriteFile(t, dir, \"src.txt\", \"new\\n\")\n162\t\t\t\twriteFile(t, dir, \"dest.txt\", \"old\\n\")\n163\t\t\t}\n164\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n165\t\t\t\t[]string{\"-i\", \"-f\", \"src.txt\", \"dest.txt\"}, nil)\n166\t\t\tcheckFile(t, goDir, \"dest.txt\", \"new\\n\")\n167\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n168\t\t})\n169\t\n170\t\tt.Run(\"r2_3_no_clobber\", func(t *testing.T) {\n171\t\t\tsetup := func(t *testing.T, dir string) {\n172\t\t\t\twriteFile(t, dir, \"src.txt\", \"new\\n\")\n173\t\t\t\twriteFile(t, dir, \"dest.txt\", \"old\\n\")\n174\t\t\t}\n175\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n176\t\t\t\t[]string{\"-n\", \"src.txt\", \"dest.txt\"}, nil)\n177\t\t\tcheckFile(t, goDir, \"dest.txt\", \"old\\n\")\n178\t\t\tcheckFile(t, goDir, \"src.txt\", \"new\\n\")\n179\t\t})\n180\t\n181\t\tt.Run(\"r2_3_no_clobber_no_dest\", func(t *testing.T) {\n182\t\t\tsetup := func(t *testing.T, dir string) {\n183\t\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n184\t\t\t}\n185\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n186\t\t\t\t[]string{\"-n\", \"src.txt\", \"dest.txt\"}, nil)\n187\t\t\tcheckFile(t, goDir, \"dest.txt\", \"hello\\n\")\n188\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n189\t\t})\n190\t\n191\t\tt.Run(\"r2_4_permission_denied\", func(t *testing.T) {\n192\t\t\tsetup := func(t *testing.T, dir string) {\n193\t\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n194\t\t\t\trestricted := filepath.Join(dir, \"nowrite\")\n195\t\t\t\tos.Mkdir(restricted, 0o755)\n196\t\t\t\tos.Chmod(restricted, 0o555)\n197\t\t\t\tt.Cleanup(func() { os.Chmod(restricted, 0o755) })\n198\t\t\t}\n