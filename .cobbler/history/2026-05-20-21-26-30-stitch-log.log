{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RtWTmByrmXuXBv1Lh4cTKP","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd057-mv R1.1-R1.4, R2.1-R2.4, R3.1-R3.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"context\"\n10\t\t\"errors\"\n11\t\t\"os\"\n12\t\t\"os/exec\"\n13\t\t\"path/filepath\"\n14\t\t\"regexp\"\n15\t\t\"strings\"\n16\t\t\"testing\"\n17\t\t\"time\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n20\t)\n21\t\n22\ttype cmdResult struct {\n23\t\tstdout   []byte\n24\t\tstderr   []byte\n25\t\texitCode int\n26\t}\n27\t\n28\tfunc TestDiff(t *testing.T) {\n29\t\tgoBin := testutils.BuildBinary(t, \".\")\n30\t\trefBin, err := exec.LookPath(\"gmv\")\n31\t\tif err != nil {\n32\t\t\tt.Skip(\"reference binary gmv not found\")\n33\t\t}\n34\t\n35\t\tbinaryNameRe := regexp.MustCompile(`(?m)^(?:/\\S+/)?g?mv:`)\n36\t\tnormBin := testutils.NormalizeFunc(func(b []byte) []byte {\n37\t\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mv:\"))\n38\t\t})\n39\t\tnormCase := testutils.NormalizeFunc(func(b []byte) []byte {\n40\t\t\treturn bytes.ToLower(b)\n41\t\t})\n42\t\tnormTry := testutils.NormalizeFunc(func(b []byte) []byte {\n43\t\t\tvar out [][]byte\n44\t\t\tfor line := range bytes.SplitSeq(b, []byte(\"\\n\")) {\n45\t\t\t\tif !bytes.HasPrefix(bytes.TrimSpace(bytes.ToLower(line)), []byte(\"try \")) {\n46\t\t\t\t\tout = append(out, bytes.Clone(line))\n47\t\t\t\t}\n48\t\t\t}\n49\t\t\treturn bytes.Join(out, []byte(\"\\n\"))\n50\t\t})\n51\t\terrNorm := []testutils.NormalizeFunc{normBin, normCase, normTry}\n52\t\n53\t\tt.Run(\"r1_1_rename_file\", func(t *testing.T) {\n54\t\t\tsetup := func(t *testing.T, dir string) {\n55\t\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n56\t\t\t}\n57\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n58\t\t\t\t[]string{\"src.txt\", \"dest.txt\"}, nil)\n59\t\t\tcheckFile(t, goDir, \"de