DeadlineExceeded {\n\t\tt.Fatal(\"chronic timed out; SIGPIPE handler may not be installed\")\n\t}\n\tif err != nil {\n\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2081,"cache_read_input_tokens":25064,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2081},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"11219621-a4aa-469f-8167-d9d655f0c002","uuid":"c3dac291-8ca8-4c88-88b8-3a7c09cb32a6"}
