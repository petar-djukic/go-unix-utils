{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F6gsRJi32DdPD19VtVQetR","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/shred implements srd099-shred R1.1-R1.4, R2.1-R2.4, R3.1-R3.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"crypto/rand\"\n9\t\t\"flag\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst helpText = `Usage: shred [OPTION]... FILE...\n19\tOverwrite the specified FILE(s) repeatedly, in order to make it harder\n20\tfor even very expensive hardware probing to recover the data.\n21\t\n22\tIf FILE is -, shred standard output.\n23\t\n24\tMandatory arguments to long options are mandatory for short options too.\n25\t  -n, --iterations=N  overwrite N times instead of the default (3)\n26\t  -u, --remove        truncate and remove file after overwriting\n27\t  -v, --verbose        show progress\n28\t  -z, --zero           add a final overwrite with zeros to hide shredding\n29\t  -s, --size=N         shred this many bytes (suffixes like K, M, G accepted)\n30\t      --help     display this help and exit\n31\t      --version  output version information and exit\n32\t`\n33\t\n34\tconst versionText = `shred (go-unix-utils) dev\n35\t`\n36\t\n37\ttype options struct {\n38\t\titerations int\n39\t\tremove     bool\n40\t\tverbose    bool\n41\t\tzero       bool\n42\t\tsize       int64\n43\t\tsizeSet    bool\n44\t}\n45\t\n46\tfunc main() {\n47\t\tsys.InstallSIGPIPEHandler()\n48\t\n49\t\topts, files := parseArgs(os.Args[1:])\n50\t\tif len(files) == 0 {\n51\t\t\tfmt.Fprintln(os.Stderr, \"shred: missing file operand\")\n52\t\t\tfmt.Fprintln(os.Stderr, \"Try 'shred --help' for more information.\")\n53\t\t\tos.Exit(1)\n54\t\t}\n55\t\n56\t\texitCode := 0\n57\t\tfor _, file := range files {\n58\t\t\tif err := shredFile(opts, file); err != nil {\n59\t\t\t\tfmt.Fprintf(os.Stderr, \"shred: %s: %s\\n\", file, err)\n60\t\t\t\texitCode = 1\n61\t\t\t}\n62\t\t}\n63\t\tif exitCode != 0 {\n64\t\t\tos.Exit(exitCode)\n65\t\t}\n66\t}\n67\t\n68\tfunc parseArgs(args []string) (options, []string) {\n69\t\tvar opts options\n70\t\tvar sizeStr string\n71\t\n72\t\tfs := flag.NewFlagSet(\"shred\", flag.ContinueOnError)\n73\t\tfs.SetOutput(io.Discard)\n74\t\tfs.IntVar(&opts.iterations, \"n\", 3, \"\")\n75\t\tfs.IntVar(&opts.iterations, \"iterations\", 3, \"\")\n76\t\tfs.BoolVar(&opts.remove, \"u\", false, \"\")\n77\t\tfs.BoolVar(&opts.remove, \"remove\", false, \"\")\n78\t\tfs.BoolVar(&opts.verbose, \"v\", false, \"\")\n79\t\tfs.BoolVar(&opts.verbose, \"verbose\", false, \"\")\n80\t\tfs.BoolVar(&opts.zero, \"z\", false, \"\")\n81\t\tfs.BoolVar(&opts.zero, \"zero\", false, \"\")\n82\t\tfs.StringVar(&sizeStr, \"s\", \"\", \"\")\n83\t\tfs.StringVar(&sizeStr, \"size\", \"\", \"\")\n84\t\n85\t\thelp := fs.Bool(\"help\", false, \"\")\n86\t\tversion := fs.Bool(\"version\", false, \"\")\n87\t\n88\t\tif err := fs.Parse(args); err != nil {\n89\t\t\tfmt.Fprintf(os.Stderr, \"shred: %s\\n\", err)\n90\t\t\tfmt.Fprintln(os.Stderr, \"Try 'shred --help' for more information.\")\n91\t\t\tos.Exit(1)\n92\t\t}\n93\t\n94\t\tif *help {\n95\t\t\tfmt.Fprint(os.Stdout, helpText)\n96\t\t\tos.Exit(0)\n97\t\t}\n98\t\tif *version {\n99\t\t\tfmt.Fprint(os.Stdout, versionText)\n100\t\t\tos.Exit(0)\n101\t\t}\n102\t\n103\t\tif sizeStr != \"\" {\n104\t\t\tn, err := sizeparse.Parse(sizeStr)\n105\t\t\tif err != nil {\n106\t\t\t\tfmt.Fprintf(os.Stderr, \"shred: invalid size: '%s'\\n\", sizeStr)\n107\t\t\t\tos.Exit(1)\n108\t\t\t}\n109\t\t\topts.size = n\n110\t\t\topts.sizeSet = true\n111\t\t}\n112\t\n113\t\treturn opts, fs.Args()\n114\t}\n115\t\n116\tfunc shredFile(opts options, path string) error {\n117\t\tf, err := os.OpenFile(path, os.O_WRONLY, 0)\n118\t\tif err != nil {\n119\t\t\treturn err\n120\t\t}\n121\t\tdefer f.Close()\n122\t\n123\t\tsize, err := fileSize(f, opts)\n124\t\tif err != nil {\n125\t\t\treturn err\n126\t\t}\n127\t\n128\t\tfor i := 0; i < opts.iterations; i++ {\n129\t\t\tif opts.verbose {\n130\t\t\t\tprintPass(path, i+1, opts)\n131\t\t\t}\n132\t\t\tif err := overwritePass(f, size, rand.Reader); err != nil {\n133\t\t\t\treturn err\n134\t\t\t}\n135\t\t}\n136\t\n137\t\tif opts.zero {\n138\t\t\tif opts.verbose {\n139\t\t\t\tprintZeroPass(path, opts)\n140\t\t\t}\n141\t\t\tif err := zeroPass(f, size); err != nil {\n142\t\t\t\treturn err\n143\t\t\t}\n144\t\t}\n145\t\n146\t\tif err := f.Sync(); err != nil {\n147\t\t\treturn err\n148\t\t}\n149\t\tf.Close()\n150\t\n151\t\tif opts.remove {\n152\t\t\treturn removeFile(path)\n153\t\t}\n154\t\treturn nil\n155\t}\n156\t\n157\tfunc fileSize(f *os.File, opts options) (int64, error) {\n158\t\tif opts.sizeSet {\n159\t\t\treturn opts.size, nil\n160\t\t}\n161\t\tinfo, err := f.Stat()\n162\t\tif err != nil {\n163\t\t\treturn 0, err\n164\t\t}\n165\t\treturn info.Size(), nil\n166\t}\n167\t\n168\tfunc overwritePass(f *os.File, size int64, src io.Reader) error {\n169\t\tif _, err := f.Seek(0, io.SeekStart); err != nil {\n170\t\t\treturn err\n171\t\t}\n172\t\t_, err := io.CopyN(f, src, size)\n173\t\treturn err\n174\t}\n175\t\n176\tfunc zeroPass(f *os.File, size int64) error {\n177\t\treturn overwritePass(f, size, zeroReader{})\n178\t}\n179\t\n180\ttype zeroReader struct{}\n181\t\n182\tfunc (zeroReader) Read(p []byte) (int, error) {\n183\t\tclear(p)\n184\t\treturn len(p), nil\n185\t}\n186\t\n187\tfunc removeFile(path string) error {\n188\t\tif err := os.Truncate(path, 0); err != nil {\n189\t\t\treturn err\n190\t\t}\n191\t\treturn os.Remove(path)\n192\t}\n193\t\n194\tfunc printPass(path string, pass int, opts options) {\n195\t\ttotal := opts.iterations\n196\t\tif opts.zero {\n197\t\t\ttotal++\n198\t\t}\n199\t\tfmt.Fprintf(os.Stderr, \"shred: %s: pass %d/%d (random)...\\n\",\n200\t\t\tpath, pass, total)\n201\t}\n202\t\n203\tfunc printZeroPass(path string, opts options) {\n204\t\ttotal := opts.iterations\n205\t\tif opts.zero {\n206\t\t\ttotal++\n207\t\t}\n208\t\tfmt.Fprintf(os.Stderr, \"shred: %s: pass %d/%d (000000)...\\n\",\n209\t\t\tpath, total, total)\n210\t}\n211\t"}]},"parent_tool_use_id":null,"session_id":"0c9fb8d5-be1b-47e3-80b6-7f9b855343df","uuid":"bdc29b0d-1a29-40b9-826d-4f0d5414927e","timestamp":"2026-05-27T14:53:48.162Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5590/cmd/shred/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/shred implements srd099-shred R1.1-R1.4, R2.1-R2.4, R3.1-R3.3.\npackage main\n\nimport (\n\t\"crypto/rand\"\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: shred [OPTION]... FILE...\nOverwrite the specified FILE(s) repeatedly, in order to make it harder\nfor even very expensive hardware probing to recover the data.\n\nIf FILE is -, shred standard output.\n\nMandatory arguments to long options are mandatory for short options too.\n  -n, --iterations=N  overwrite N times instead of the default (3)\n  -u, --remove        truncate and remove file after overwriting\n  -v, --verbose        show progress\n  -z, --zero           add a final overwrite with zeros to hide shredding\n  -s, --size=N         shred this many bytes (suffixes like K, M, G accepted)\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `shred (go-unix-utils) dev\n`\n\ntype options struct {\n\titerations int\n\tremove     bool\n\tverbose    bool\n\tzero       bool\n\tsize       int64\n\tsizeSet    bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, files := parseArgs(os.Args[1:])\n\tif len(files) == 0 {\n\t\tfmt.Fprintln(os.Stderr, \"shred: missing file operand\")\n\t\tfmt.Fprintln(os.Stderr, \"Try 'shred --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\n\texitCode := 0\n\tfor _, file := range files {\n\t\tif err := shredFile(opts, file); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"shred: %s: %s\\n\", file, err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar sizeStr string\n\n\tfs := flag.NewFlagSet(\"shred\", flag.ContinueOnError)\n\tfs.SetOutput(io.Discard)\n\tfs.IntVar(&opts.iterations, \"n\", 3, \"\")\n\tfs.IntVar(&opts.iterations, \"iterations\", 3, \"\")\n\tfs.BoolVar(&opts.remove, \"u\", false, \"\")\n\tfs.BoolVar(&opts.remove, \"remove\", false, \"\")\n\tfs.BoolVar(&opts.verbose, \"v\", false, \"\")\n\tfs.BoolVar(&opts.verbose, \"verbose\", false, \"\")\n\tfs.BoolVar(&opts.zero, \"z\", false, \"\")\n\tfs.BoolVar(&opts.zero, \"zero\", false, \"\")\n\tfs.StringVar(&sizeStr, \"s\", \"\", \"\")\n\tfs.StringVar(&sizeStr, \"size\", \"\", \"\")\n\n\thelp := fs.Bool(\"help\", false, \"\")\n\tversion := fs.Bool(\"version\", false, \"\")\n\n\tif err := fs.Parse(args); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"shred: %s\\n\", err)\n\t\tfmt.Fprintln(os.Stderr, \"Try 'shred --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\n\tif *help {\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t}\n\tif *version {\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t}\n\n\tif sizeStr != \"\" {\n\t\tn, err := sizeparse.Parse(sizeStr)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"shred: invalid size: '%s'\\n\", sizeStr)\n\t\t\tos.Exit(1)\n\t\t}\n\t\topts.size = n\n\t\topts.sizeSet = true\n\t}\n\n\treturn opts, fs.Args()\n}\n\nfunc shredFile(opts options, path string) error {\n\tf, err := os.OpenFile(path, os.O_WRONLY, 0)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer f.Close()\n\n\tsize, err := fileSize(f, opts)\n\tif err != nil {\n\t\treturn err\n\t}\n\n\tfor i := 0; i < opts.iterations; i++ {\n\t\tif opts.verbose {\n\t\t\tprintPass(path, i+1, opts)\n\t\t}\n\t\tif err := overwritePass(f, size, rand.Reader); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\n\tif opts.zero {\n\t\tif opts.verbose {\n\t\t\tprintZeroPass(path, opts)\n\t\t}\n\t\tif err := zeroPass(f, size); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\n\tif err := f.Sync(); err != nil {\n\t\treturn err\n\t}\n\tf.Close()\n\n\tif opts.remove {\n\t\treturn removeFile(path)\n\t}\n\treturn nil\n}\n\nfunc fileSize(f *os.File, opts options) (int64, error) {\n\tif opts.sizeSet {\n\t\treturn opts.size, nil\n\t}\n\tinfo, err := f.Stat()\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn info.Size(), nil\n}\n\nfunc overwritePass(f *os.File, size int64, src io.Reader) error {\n\tif _, err := f.Seek(0, io.SeekStart); err != nil {\n\t\treturn err\n\t}\n\t_, err := io.CopyN(f, src, size)\n\treturn err\n}\n\nfunc zeroPass(f *os.File, size int64) error {\n\treturn overwritePass(f, size, zeroReader{})\n}\n\ntype zeroReader struct{}\n\nfunc (zeroReader) Read(p []byte) (int, error) {\n\tclear(p)\n\treturn len(p), nil\n}\n\nfunc removeFile(path string) error {\n\tif err := os.Truncate(path, 0); err != nil {\n\t\treturn err\n\t}\n\treturn os.Remove(path)\n}\n\nfunc printPass(path string, pass int, opts options) {\n\ttotal := opts.iterations\n\tif opts.zero {\n\t\ttotal++\n\t}\n\tfmt.Fprintf(os.Stderr, \"shred: %s: pass %d/%d (random)...\\n\",\n\t\tpath, pass, total)\n}\n\nfunc printZeroPass(path string, opts options) {\n\ttotal := opts.iterations\n\tif opts.zero {\n\t\ttotal++\n\t}\n\tfmt.Fprintf(os.Stderr, \"shred: %s: pass %d/%d (000000)...\\n\",\n\t\tpath, total, total)\n}\n","numLines":211,"startLine":1,"totalLines":211}}}
