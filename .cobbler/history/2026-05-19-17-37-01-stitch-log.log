iter, opts options) int {\n219\t\tscanner := bufio.NewScanner(r)\n220\t\tfirst := true\n221\t\tvar prev string\n222\t\tvar prevKey string\n223\t\tcount := 0\n224\t\tfor scanner.Scan() {\n225\t\t\tline := scanner.Text()\n226\t\t\tkey := comparisonKey(line, opts)\n227\t\t\tif first {\n228\t\t\t\tprev = line\n229\t\t\t\tprevKey = key\n230\t\t\t\tcount = 1\n231\t\t\t\tfirst = false\n232\t\t\t\tcontinue\n233\t\t\t}\n234\t\t\tif key == prevKey {\n235\t\t\t\tcount++\n236\t\t\t\tcontinue\n237\t\t\t}\n238\t\t\tif err := emitRun(w, prev, count, opts); err != nil {\n239\t\t\t\treturn epipeOr1(err)\n240\t\t\t}\n241\t\t\tprev = line\n242\t\t\tprevKey = key\n243\t\t\tcount = 1\n244\t\t}\n245\t\tif !first {\n246\t\t\tif err := emitRun(w, prev, count, opts); err != nil {\n247\t\t\t\treturn epipeOr1(err)\n248\t\t\t}\n249\t\t}\n250\t\tif err := w.Flush(); err != nil {\n251\t\t\treturn epipeOr1(err)\n252\t\t}\n253\t\treturn 0\n254\t}\n255\t\n256\tfunc emitRun(w *bufio.Writer, line string, count int, opts options) error {\n257\t\tn := runCopies(count, opts)\n258\t\tfor range n {\n259\t\t\tif opts.count {\n260\t\t\t\tif _, err := fmt.Fprintf(w, \"%7d %s\\n\", count, line); err != nil {\n261\t\t\t\t\treturn err\n262\t\t\t\t}\n263\t\t\t} else {\n264\t\t\t\tif _, err := w.WriteString(line); err != nil {\n265\t\t\t\t\treturn err\n266\t\t\t\t}\n267\t\t\t\tif err := w.WriteByte('\\n'); err != nil {\n268\t\t\t\t\treturn err\n269\t\t\t\t}\n270\t\t\t}\n271\t\t}\n272\t\treturn nil\n273\t}\n274\t\n275\tfunc epipeOr1(err error) int {\n276\t\tif errors.Is(err, syscall.EPIPE) {\n277\t\t\treturn 0\n278\t\t}\n279\t\treturn 1\n280\t}\n281\t\n282\tfunc runCopies(count int, opts options) int {\n283\t\tif (opts.repeated || opts.allRepeated) && opts.unique {\n284\t\t\treturn 0\n285\t\t}\n286\t\tif opts.allRepeated {\n287\t\t\tif count > 1 {\n288\t\t\t\treturn count\n289\t\t\t}\n290\t\t\treturn 0\n291\t\t}\n292\t\tif opts.repeated {\n293\t\t\tif count > 1 {\n294\t\t\t\treturn 1\n295\t\t\t}\n296\t\t\treturn 0