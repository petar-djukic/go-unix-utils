{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lasi3RaKDBSYNt5u4GaCGM","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"strings\"\n12\t\t\"unicode\"\n13\t\t\"unicode/utf8\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype options struct {\n19\t\tprintLines bool\n20\t\tprintWords bool\n21\t\tprintBytes bool\n22\t\tprintChars bool\n23\t\tprintMax   bool\n24\t\ttotalMode  string\n25\t\tfiles0From string\n26\t}\n27\t\n28\ttype counts struct {\n29\t\tlines   int64\n30\t\twords   int64\n31\t\tbytes   int64\n32\t\tchars   int64\n33\t\tmaxLine int64\n34\t}\n35\t\n36\tfunc main() {\n37\t\tsys.InstallSIGPIPEHandler()\n38\t\topts, files := parseArgs(os.Args[1:])\n39\t\texitCode := run(opts, files, os.Stdout, os.Stderr)\n40\t\tos.Exit(exitCode)\n41\t}\n42\t\n43\tfunc run(opts options, files []string, stdout io.Writer, stderr io.Writer) int {\n44\t\tif noFlagsSet(opts) {\n45\t\t\topts.printLines = true\n46\t\t\topts.printWords = true\n47\t\t\topts.printBytes = true\n48\t\t}\n49\t\tif opts.totalMode == \"\" {\n50\t\t\topts.totalMode = \"auto\"\n51\t\t}\n52\t\n53\t\tif opts.files0From != \"\" {\n54\t\t\textra, err := readFiles0From(opts.files0From)\n55\t\t\tif err != nil {\n56\t\t\t\tfmt.Fprintf(stderr, \"wc: %s\\n\", err)\n57\t\t\t\treturn 1\n58\t\t\t}\n59\t\t\tfiles = append(files, extra...)\n60\t\t}\n61\t\n62\t\tif len(files) == 0 {\n63\t\t\tfiles = []string{\"\"}\n64\t\t}\n65\t\n66\t\twidth := 1\n67\t\tif opts.totalMode != \"only\" && opts.files0From != \"-\" {\n68\t\t\twidth = computeWidth(files, countColumns(opts))\n69\t\t}\n70\t\tresults, names, hadError := processFiles(files, stderr)\n71\t\twriteErr := printResults(stdout, opts, results, names, width, len(files))\n72\t\tif hadError || writeErr {\n73\t\t\treturn 1\n74\t\t}\n75\t\treturn 0\n76\t}\n77\t\n78\tfunc noFlagsSet(opts options) bool {\n79\t\treturn !opts.printLines && !opts.printWords &&\n80\t\t\t!opts.printBytes && !opts.printChars && !opts.printMax\n81\t}\n82\t\n83\tfunc processFiles(files []string, stderr io.Writer) ([]counts, []string, bool) {\n84\t\tresults := make([]counts, 0, len(files))\n85\t\tnames := make([]string, 0, len(files))\n86\t\thadError := false\n87\t\n88\t\tfor _, f := range files {\n89\t\t\tc, err := countFile(f)\n90\t\t\tif err != nil {\n91\t\t\t\tfmt.Fprintf(stderr, \"wc: %s\\n\", err)\n92\t\t\t\thadError = true\n93\t\t\t\tcontinue\n94\t\t\t}\n95\t\t\tresults = append(results, c)\n96\t\t\tif f == \"\" {\n97\t\t\t\tnames = append(names, \"\")\n98\t\t\t} else {\n99\t\t\t\tnames = append(names, f)\n100\t\t\t}\n101\t\t}\n102\t\treturn results, names, hadError\n103\t}\n104\t\n105\tfunc countFile(name string) (counts, error) {\n106\t\tvar r io.Reader\n107\t\tif name == \"-\" || name == \"\" {\n108\t\t\tr = os.Stdin\n109\t\t} else {\n110\t\t\tf, err := os.Open(name)\n111\t\t\tif err != nil {\n112\t\t\t\treturn counts{}, fmt.Errorf(\"%s: %s\", name, err.(*os.PathError).Err)\n113\t\t\t}\n114\t\t\tdefer f.Close()\n115\t\t\tr = f\n116\t\t}\n117\t\treturn countReader(r)\n118\t}\n119\t\n120\tfunc countReader(r io.Reader) (counts, error) {\n121\t\tvar c counts\n122\t\tbr := bufio.NewReader(r)\n123\t\tinWord := false\n124\t\tlineLen := int64(0)\n125\t\n126\t\tbuf := make([]byte, 32*1024)\n127\t\tfor {\n128\t\t\tn, err := br.Read(buf)\n129\t\t\tc.bytes += int64(n)\n130\t\t\tprocessChunk(buf[:n], &c, &inWord, &lineLen)\n131\t\t\tif err == io.EOF {\n132\t\t\t\tbreak\n133\t\t\t}\n134\t\t\tif err != nil {\n135\t\t\t\treturn c, err\n136\t\t\t}\n137\t\t}\n138\t\n139\t\tif lineLen > c.maxLine {\n140\t\t\tc.maxLine = lineLen\n141\t\t}\n142\t\treturn c, nil\n143\t}\n144\t\n145\tfunc processChunk(data []byte, c *counts, inWord *bool, lineLen *int64) {\n146\t\ti := 0\n147\t\tfor i < len(data) {\n148\t\t\tr, size := utf8.DecodeRune(data[i:])\n149\t\t\tif r == utf8.RuneError && size == 1 {\n150\t\t\t\tc.chars++\n151\t\t\t\tprocessInvalidByte(data[i], c, inWord, lineLen)\n152\t\t\t\ti++\n153\t\t\t\tcontinue\n154\t\t\t}\n155\t\t\tc.chars++\n156\t\t\tif r == '\\n' {\n157\t\t\t\tc.lines++\n158\t\t\t\thandleNewline(c, inWord, lineLen)\n159\t\t\t} else if r == '\\t' {\n160\t\t\t\thandleTab(inWord, lineLen)\n161\t\t\t} else if r == '\\r' || r == '\\f' {\n162\t\t\t\t*inWord = false\n163\t\t\t\thandleReturn(c, lineLen)\n164\t\t\t} else if unicode.IsSpace(r) {\n165\t\t\t\t*inWord = false\n166\t\t\t\tif isPrintable(r) {\n167\t\t\t\t\t*lineLen++\n168\t\t\t\t}\n169\t\t\t} else {\n170\t\t\t\tif !*inWord {\n171\t\t\t\t\tc.words++\n172\t\t\t\t\t*inWord = true\n173\t\t\t\t}\n174\t\t\t\tif isPrintable(r) {\n175\t\t\t\t\t*lineLen++\n176\t\t\t\t}\n177\t\t\t}\n178\t\t\ti += size\n179\t\t}\n180\t}\n181\t\n182\tfunc processInvalidByte(b byte, c *counts, inWord *bool, lineLen *int64) {\n183\t\tswitch b {\n184\t\tcase '\\n':\n185\t\t\tc.lines++\n186\t\t\thandleNewline(c, inWord, lineLen)\n187\t\tcase '\\t':\n188\t\t\thandleTab(inWord, lineLen)\n189\t\tcase '\\r', '\\f':\n190\t\t\t*inWord = false\n191\t\t\thandleReturn(c, lineLen)\n192\t\tcase ' ', '\\v':\n193\t\t\t*inWord = false\n194\t\tdefault:\n195\t\t\tif !*inWord {\n196\t\t\t\tc.words++\n197\t\t\t\t*inWord = true\n198\t\t\t}\n199\t\t}\n200\t}\n201\t\n202\tfunc handleNewline(c *counts, inWord *bool, lineLen *int64) {\n203\t\t*inWord = false\n204\t\tif *lineLen > c.maxLine {\n205\t\t\tc.maxLine = *lineLen\n206\t\t}\n207\t\t*lineLen = 0\n208\t}\n209\t\n210\tfunc handleReturn(c *counts, lineLen *int64) {\n211\t\tif *lineLen > c.maxLine {\n212\t\t\tc.maxLine = *lineLen\n213\t\t}\n214\t\t*lineLen = 0\n215\t}\n216\t\n217\tfunc handleTab(inWord *bool, lineLen *int64) {\n218\t\t*inWord = false\n219\t\t*lineLen = (*lineLen/8 + 1) * 8\n220\t}\n221\t\n222\tfunc isPrintable(r rune) bool {\n223\t\treturn r >= 0x20 && r <= 0x7E\n224\t}\n225\t\n226\tfunc printResults(w io.Writer, opts options, results []counts, names []string, width int, numFiles int) bool {\n227\t\ttotal := sumCounts(results)\n228\t\tshowTotal := shouldShowTotal(opts.totalMode, numFiles)\n229\t\twriteErr := false\n230\t\n231\t\tif opts.totalMode != \"only\" {\n232\t\t\tfor i, c := range results {\n233\t\t\t\tif err := printLine(w, opts, c, names[i], width); err != nil {\n234\t\t\t\t\twriteErr = true\n235\t\t\t\t}\n236\t\t\t}\n237\t\t}\n238\t\tif showTotal {\n239\t\t\tlabel := \"total\"\n240\t\t\tif opts.totalMode == \"only\" {\n241\t\t\t\tlabel = \"\"\n242\t\t\t}\n243\t\t\tif err := printLine(w, opts, total, label, width); err != nil {\n244\t\t\t\twriteErr = true\n245\t\t\t}\n246\t\t}\n247\t\treturn writeErr\n248\t}\n249\t\n250\tfunc sumCounts(results []counts) counts {\n251\t\tvar total counts\n252\t\tfor _, c := range results {\n253\t\t\ttotal.lines += c.lines\n254\t\t\ttotal.words += c.words\n255\t\t\ttotal.bytes += c.bytes\n256\t\t\ttotal.chars += c.chars\n257\t\t\tif c.maxLine > total.maxLine {\n258\t\t\t\ttotal.maxLine = c.maxLine\n259\t\t\t}\n260\t\t}\n261\t\treturn total\n262\t}\n263\t\n264\tfunc shouldShowTotal(mode string, n int) bool {\n265\t\tswitch mode {\n266\t\tcase \"always\":\n267\t\t\treturn true\n268\t\tcase \"only\":\n269\t\t\treturn true\n270\t\tcase \"never\":\n271\t\t\treturn false\n272\t\tdefault:\n273\t\t\treturn n > 1\n274\t\t}\n275\t}\n276\t\n277\tfunc countColumns(opts options) int {\n278\t\tn := 0\n279\t\tif opts.printLines {\n280\t\t\tn++\n281\t\t}\n282\t\tif opts.printWords {\n283\t\t\tn++\n284\t\t}\n285\t\tif opts.printChars {\n286\t\t\tn++\n287\t\t}\n288\t\tif opts.printBytes {\n289\t\t\tn++\n290\t\t}\n291\t\tif opts.printMax {\n292\t\t\tn++\n293\t\t}\n294\t\treturn n\n295\t}\n296\t\n297\tfunc computeWidth(files []string, numColumns int) int {\n298\t\ttotalSize := int64(0)\n299\t\thasRegular := false\n300\t\tfor _, f := range files {\n301\t\t\tif f == \"-\" || f == \"\" {\n302\t\t\t\tcontinue\n303\t\t\t}\n304\t\t\tinfo, err := os.Stat(f)\n305\t\t\tif err != nil || !info.Mode().IsRegular() {\n306\t\t\t\tcontinue\n307\t\t\t}\n308\t\t\ttotalSize += info.Size()\n309\t\t\thasRegular = true\n310\t\t}\n311\t\tminWidth := 1\n312\t\tif numColumns > 1 && !hasRegular {\n313\t\t\tminWidth = 7\n314\t\t}\n315\t\tif hasRegular {\n316\t\t\treturn max(len(fmt.Sprintf(\"%d\", totalSize)), minWidth)\n317\t\t}\n318\t\treturn minWidth\n319\t}\n320\t\n321\tfunc printLine(w io.Writer, opts options, c counts, name string, width int) error {\n322\t\tfields := collectFields(opts, c, width)\n323\t\tline := strings.Join(fields, \" \")\n324\t\tif name != \"\" {\n325\t\t\tline += \" \" + name\n326\t\t}\n327\t\t_, err := fmt.Fprintln(w, line)\n328\t\treturn err\n329\t}\n330\t\n331\tfunc collectFields(opts options, c counts, width int) []string {\n332\t\tfields := make([]string, 0, 5)\n333\t\tif opts.printLines {\n334\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.lines))\n335\t\t}\n336\t\tif opts.printWords {\n337\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.words))\n338\t\t}\n339\t\tif opts.printChars {\n340\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.chars))\n341\t\t}\n342\t\tif opts.printBytes {\n343\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.bytes))\n344\t\t}\n345\t\tif opts.printMax {\n346\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.maxLine))\n347\t\t}\n348\t\treturn fields\n349\t}\n350\t\n351\tfunc readFiles0From(path string) ([]string, error) {\n352\t\tvar r io.Reader\n353\t\tif path == \"-\" {\n354\t\t\tr = os.Stdin\n355\t\t} else {\n356\t\t\tf, err := os.Open(path)\n357\t\t\tif err != nil {\n358\t\t\t\treturn nil, err\n359\t\t\t}\n360\t\t\tdefer f.Close()\n361\t\t\tr = f\n362\t\t}\n363\t\tdata, err := io.ReadAll(r)\n364\t\tif err != nil {\n365\t\t\treturn nil, err\n366\t\t}\n367\t\tif len(data) == 0 {\n368\t\t\treturn nil, nil\n369\t\t}\n370\t\tparts := strings.Split(string(data), \"\\x00\")\n371\t\tif parts[len(parts)-1] == \"\" {\n372\t\t\tparts = parts[:len(parts)-1]\n373\t\t}\n374\t\treturn parts, nil\n375\t}\n376\t\n377\tfunc parseArgs(args []string) (options, []string) {\n378\t\tvar opts options\n379\t\tvar files []string\n380\t\ti := 0\n381\t\tfor i < len(args) {\n382\t\t\targ := args[i]\n383\t\t\tif arg == \"--\" {\n384\t\t\t\tfiles = append(files, args[i+1:]...)\n385\t\t\t\tbreak\n386\t\t\t}\n387\t\t\tif handled, advance := parseLongFlag(arg, args[i:], &opts); handled {\n388\t\t\t\ti += advance\n389\t\t\t\tcontinue\n390\t\t\t}\n391\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n392\t\t\t\tfiles = append(files, arg)\n393\t\t\t\ti++\n394\t\t\t\tcontinue\n395\t\t\t}\n396\t\t\ti += parseShortFlags(arg[1:], &opts)\n397\t\t}\n398\t\treturn opts, files\n399\t}\n400\t\n401\tfunc parseLongFlag(arg string, _ []string, opts *options) (bool, int) {\n402\t\tif !strings.HasPrefix(arg, \"--\") {\n403\t\t\treturn false, 0\n404\t\t}\n405\t\tswitch {\n406\t\tcase arg == \"--lines\":\n407\t\t\topts.printLines = true\n408\t\tcase arg == \"--words\":\n409\t\t\topts.printWords = true\n410\t\tcase arg == \"--bytes\":\n411\t\t\topts.printBytes = true\n412\t\tcase arg == \"--chars\":\n413\t\t\topts.printChars = true\n414\t\tcase arg == \"--max-line-length\":\n415\t\t\topts.printMax = true\n416\t\tcase strings.HasPrefix(arg, \"--total=\"):\n417\t\t\topts.totalMode = arg[len(\"--total=\"):]\n418\t\tcase strings.HasPrefix(arg, \"--files0-from=\"):\n419\t\t\topts.files0From = arg[len(\"--files0-from=\"):]\n420\t\tdefault:\n421\t\t\treturn false, 0\n422\t\t}\n423\t\treturn true, 1\n424\t}\n425\t\n426\tfunc parseShortFlags(flags string, opts *options) int {\n427\t\tfor _, ch := range flags {\n428\t\t\tswitch ch {\n429\t\t\tcase 'l':\n430\t\t\t\topts.printLines = true\n431\t\t\tcase 'w':\n432\t\t\t\topts.printWords = true\n433\t\t\tcase 'c':\n434\t\t\t\topts.printBytes = true\n435\t\t\tcase 'm':\n436\t\t\t\topts.printChars = true\n437\t\t\tcase 'L':\n438\t\t\t\topts.printMax = true\n439\t\t\t}\n440\t\t}\n441\t\treturn 1\n442\t}\