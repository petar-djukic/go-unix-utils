{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Sn9gMSbTjL2pv43oRd27Z9","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd008-ls R1.1-R1.14, R2.1-R2.15, R3.1-R3.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\t\"unicode/utf8\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n21\t)\n22\t\n23\tconst helpText = `Usage: ls [OPTION]... [FILE]...\n24\tList information about the FILEs (the current directory by default).\n25\tSort entries alphabetically if no flags given.\n26\t\n27\t  -a             do not ignore entries starting with .\n28\t  -A             do not list implied . and ..\n29\t  -C             list entries by columns\n30\t  -d             list directories themselves, not their contents\n31\t  -i             print the index number of each file\n32\t  -l             use a long listing format\n33\t  -n             like -l, but list numeric user and group IDs\n34\t  -r             reverse order while sorting\n35\t  -s             print the allocated size of each file, in blocks\n36\t  -S             sort by file size, largest first\n37\t  -t             sort by modification time, newest first\n38\t  -U             do not sort; list entries in directory order\n39\t  -v             natural sort of (version) numbers within text\n40\t  -x             list entries by lines instead of by columns\n41\t  -1             list one file per line\n42\t      --color[=WHEN]  colorize the output; WHEN can be 'always'\n43\t                         (default if omitted), 'auto', or 'never'\n44\t      --help     display this help and exit\n45\t      --version  output version information and exit\n46\t`\n47\t\n48\tconst versionText = `ls (go-unix-utils) dev\n49\t`\n50\t\n51\ttype options struct {\n52\t\tsingleColumn   bool\n53\t\tlongFormat     bool\n54\t\tforceColumns   bool\n55\t\thorizontalSort bool\n56\t\tshowAll        bool\n57\t\tshowAlmostAll  bool\n58\t\tdirAsEntry     bool\n59\t\tsortByTime     bool\n60\t\tsortBySize     bool\n61\t\treverseSort    bool\n62\t\tunsorted       bool\n63\t\tversionSort    bool\n64\t\tshowInode      bool\n65\t\tshowBlocks     bool\n66\t\tnumericIds     bool\n67\t\tcolorMode      string\n68\t}\n69\t\n70\tfunc main() {\n71\t\tsys.InstallSIGPIPEHandler()\n72\t\topts, paths := parseArgs(os.Args[1:])\n73\t\tif len(paths) == 0 {\n74\t\t\tpaths = []string{\".\"}\n75\t\t}\n76\t\tos.Exit(run(paths, opts))\n77\t}\n78\t\n79\tfunc parseArgs(args []string) (options, []string) {\n80\t\tvar opts options\n81\t\tvar paths []string\n82\t\tfor len(args) > 0 {\n83\t\t\targ := args[0]\n84\t\t\targs = args[1:]\n85\t\t\tswitch {\n86\t\t\tcase arg == \"--help\":\n87\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n88\t\t\t\tos.Exit(0)\n89\t\t\tcase arg == \"--version\":\n90\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n91\t\t\t\tos.Exit(0)\n92\t\t\tcase arg == \"--\":\n93\t\t\t\treturn opts, append(paths, args...)\n94\t\t\tcase arg == \"--color\":\n95\t\t\t\topts.colorMode = \"always\"\n96\t\t\tcase strings.HasPrefix(arg, \"--color=\"):\n97\t\t\t\topts.colorMode = parseColorValue(arg)\n98\t\t\tcase strings.HasPrefix(arg, \"--\"):\n99\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n100\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n101\t\t\t\tos.Exit(2)\n102\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n103\t\t\t\tparseShortFlags(arg[1:], &opts)\n104\t\t\tdefault:\n105\t\t\t\tpaths = append(paths, arg)\n106\t\t\t}\n107\t\t}\n108\t\treturn opts, paths\n109\t}\n110\t\n111\tfunc parseShortFlags(flags string, opts *options) {\n112\t\tfor _, ch := range flags {\n113\t\t\tswitch ch {\n114\t\t\tcase '1':\n115\t\t\t\topts.forceColumns = false\n116\t\t\t\topts.horizontalSort = false\n117\t\t\t\tif !opts.longFormat {\n118\t\t\t\t\topts.singleColumn = true\n119\t\t\t\t}\n120\t\t\tcase 'l':\n121\t\t\t\topts.longFormat = true\n122\t\t\t\topts.singleColumn = false\n123\t\t\t\topts.forceColumns = false\n124\t\t\t\topts.horizontalSort = false\n125\t\t\tcase 'C':\n126\t\t\t\topts.forceColumns = true\n127\t\t\t\topts.horizontalSort = false\n128\t\t\t\topts.longFormat = false\n129\t\t\t\topts.singleColumn = false\n130\t\t\tcase 'x':\n131\t\t\t\topts.forceColumns = true\n132\t\t\t\topts.horizontalSort = true\n133\t\t\t\topts.longFormat = false\n134\t\t\t\topts.singleColumn = false\n135\t\t\tcase 'a':\n136\t\t\t\topts.showAll = true\n137\t\t\t\topts.showAlmostAll = false\n138\t\t\tcase 'A':\n139\t\t\t\topts.showAlmostAll = true\n140\t\t\t\topts.showAll = false\n141\t\t\tcase 'd':\n142\t\t\t\topts.dirAsEntry = true\n143\t\t\tcase 'i':\n144\t\t\t\topts.showInode = true\n145\t\t\tcase 'n':\n146\t\t\t\topts.numericIds = true\n147\t\t\t\topts.longFormat = true\n148\t\t\t\topts.singleColumn = false\n149\t\t\t\topts.forceColumns = false\n150\t\t\t\topts.horizontalSort = false\n151\t\t\tcase 'r':\n152\t\t\t\topts.reverseSort = true\n153\t\t\tcase 's':\n154\t\t\t\topts.showBlocks = true\n155\t\t\tcase 't':\n156\t\t\t\topts.sortByTime = true\n157\t\t\t\topts.sortBySize = false\n158\t\t\t\topts.unsorted = false\n159\t\t\t\topts.versionSort = false\n160\t\t\tcase 'S':\n161\t\t\t\topts.sortBySize = true\n162\t\t\t\topts.sortByTime = false\n163\t\t\t\topts.unsorted = false\n164\t\t\t\topts.versionSort = false\n165\t\t\tcase 'U':\n166\t\t\t\topts.unsorted = true\n167\t\t\t\topts.sortByTime = false\n168\t\t\t\topts.sortBySize = false\n169\t\t\t\topts.versionSort = false\n170\t\t\tcase 'v':\n171\t\t\t\topts.versionSort = true\n172\t\t\t\topts.sortByTime = false\n173\t\t\t\topts.sortBySize = false\n174\t\t\t\topts.unsorted = false\n175\t\t\tdefault:\n176\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n177\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n178\t\t\t\tos.Exit(2)\n179\t\t\t}\n180\t\t}\n181\t}\n182\t\n183\tfunc parseColorValue(arg string) string {\n184\t\tval := arg[len(\"--color=\"):]\n185\t\tswitch val {\n186\t\tcase \"always\", \"auto\", \"never\":\n187\t\t\treturn val\n188\t\tdefault:\n189\t\t\tfmt.Fprintf(os.Stderr,\n190\t\t\t\t\"ls: invalid argument '%s' for '--color'\\n\", val)\n191\t\t\tfmt.Fprintln(os.Stderr,\n192\t\t\t\t\"Try 'ls --help' for more information.\")\n193\t\t\tos.Exit(2)\n194\t\t\treturn \"\"\n195\t\t}\n196\t}\n197\t\n198\tfunc setupColor(opts options) {\n199\t\tswitch opts.colorMode {\n200\t\tcase \"always\":\n201\t\t\tformat.SetColorEnabled(true)\n202\t\tcase \"auto\":\n203\t\t\tformat.SetColorEnabled(sys.IsTerminal(os.Stdout.Fd()))\n204\t\tdefault:\n205\t\t\tformat.SetColorEnabled(false)\n206\t\t}\n207\t}\n208\t\n209\tfunc run(paths []string, opts options) int {\n210\t\tsetupColor(opts)\n211\t\texitCode := 0\n212\t\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n213\t\tneedSep := false\n214\t\tif len(files) > 0 {\n215\t\t\tsortEntries(files, \"\", opts)\n216\t\t\tif opts.longFormat {\n217\t\t\t\texitCode = maxCode(exitCode, writeLongFiles(files, opts))\n218\t\t\t} else {\n219\t\t\t\tdisplay := buildDisplayNames(files, \"\", opts)\n220\t\t\t\twriteEntries(display, opts)\n221\t\t\t}\n222\t\t\tneedSep = true\n223\t\t}\n224\t\tshowHeader := len(dirs) > 1 || len(files) > 0\n225\t\tsortEntries(dirs, \"\", opts)\n226\t\tfor _, dir := range dirs {\n227\t\t\tif needSep {\n228\t\t\t\tfmt.Fprintln(os.Stdout)\n229\t\t\t}\n230\t\t\tif showHeader {\n231\t\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n232\t\t\t}\n233\t\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n234\t\t\tneedSep = true\n235\t\t}\n236\t\treturn exitCode\n237\t}\n238\t\n239\tfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n240\t\tvar files, dirs []string\n241\t\tfor _, p := range paths {\n242\t\t\tinfo, err := os.Lstat(p)\n243\t\t\tif err != nil {\n244\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n245\t\t\t\t*exitCode = 2\n246\t\t\t\tcontinue\n247\t\t\t}\n248\t\t\tif info.IsDir() && !dirAsEntry {\n249\t\t\t\tdirs = append(dirs, p)\n250\t\t\t} else {\n251\t\t\t\tfiles = append(files, p)\n252\t\t\t}\n253\t\t}\n254\t\treturn files, dirs\n255\t}\n256\t\n257\tfunc maxCode(a, b int) int {\n258\t\tif a > b {\n259\t\t\treturn a\n260\t\t}\n261\t\treturn b\n262\t}\n263\t\n264\tfunc listDir(path string, opts options) int {\n265\t\tnames, err := readNames(path, opts)\n266\t\tif err != nil {\n267\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n268\t\t\t\tpath, sysError(err))\n269\t\t\treturn 2\n270\t\t}\n271\t\tif opts.longFormat {\n272\t\t\treturn writeLongDir(path, names, opts)\n273\t\t}\n274\t\tdisplay := buildDisplayNames(names, path, opts)\n275\t\twriteEntries(display, opts)\n276\t\treturn 0\n277\t}\n278\t\n279\tfunc readNames(path string, opts options) ([]string, error) {\n280\t\tentries, err := os.ReadDir(path)\n281\t\tif err != nil {\n282\t\t\treturn nil, err\n283\t\t}\n284\t\tnames := make([]string, 0, len(entries))\n285\t\tif opts.showAll {\n286\t\t\tnames = append(names, \".\", \"..\")\n287\t\t}\n288\t\tfor _, e := range entries {\n289\t\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n290\t\t\t\tcontinue\n291\t\t\t}\n292\t\t\tnames = append(names, e.Name())\n293\t\t}\n294\t\tsortEntries(names, path, opts)\n295\t\treturn names, nil\n296\t}\n297\t\n298\tfunc sortEntries(names []string, basePath string, opts options) {\n299\t\tif opts.unsorted {\n300\t\t\treturn\n301\t\t}\n302\t\tif opts.versionSort {\n303\t\t\tsort.SliceStable(names, func(i, j int) bool {\n304\t\t\t\treturn strverscmp(names[i], names[j]) < 0\n305\t\t\t})\n306\t\t\tif opts.reverseSort {\n307\t\t\t\treverseSlice(names)\n308\t\t\t}\n309\t\t\treturn\n310\t\t}\n311\t\tif !opts.sortByTime && !opts.sortBySize {\n312\t\t\tsort.Strings(names)\n313\t\t\tif opts.reverseSort {\n314\t\t\t\treverseSlice(names)\n315\t\t\t}\n316\t\t\treturn\n317\t\t}\n318\t\ttype entry struct {\n319\t\t\tname    string\n320\t\t\tmodTime time.Time\n321\t\t\tsize    int64\n322\t\t}\n323\t\tentries := make([]entry, len(names))\n324\t\tfor i, name := range names {\n325\t\t\tentries[i].name = name\n326\t\t\tp := name\n327\t\t\tif basePath != \"\" {\n328\t\t\t\tp = filepath.Join(basePath, name)\n329\t\t\t}\n330\t\t\tif fi, err := sys.Lstat(p); err == nil {\n331\t\t\t\tentries[i].modTime = fi.ModTime\n332\t\t\t\tentries[i].size = fi.Size\n333\t\t\t}\n334\t\t}\n335\t\tsort.SliceStable(entries, func(i, j int) bool {\n336\t\t\tif opts.sortByTime {\n337\t\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n338\t\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n339\t\t\t\t}\n340\t\t\t\treturn entries[i].name < entries[j].name\n341\t\t\t}\n342\t\t\tif entries[i].size != entries[j].size {\n343\t\t\t\treturn entries[i].size > entries[j].size\n344\t\t\t}\n345\t\t\treturn entries[i].name < entries[j].name\n346\t\t})\n347\t\tfor i, e := range entries {\n348\t\t\tnames[i] = e.name\n349\t\t}\n350\t\tif opts.reverseSort {\n351\t\t\treverseSlice(names)\n352\t\t}\n353\t}\n354\t\n355\ttype entryInfo struct {\n356\t\tinode  uint64\n357\t\tblocks int64\n358\t\tmode   os.FileMode\n359\t}\n360\t\n361\tfunc statDisplayEntries(names []string, basePath string) ([]entryInfo, int, int) {\n362\t\tinfos := make([]entryInfo, len(names))\n363\t\tvar inodeW, blocksW int\n364\t\tfor i, name := range names {\n365\t\t\tp := name\n366\t\t\tif basePath != \"\" {\n367\t\t\t\tp = filepath.Join(basePath, name)\n368\t\t\t}\n369\t\t\tfi, err := sys.Lstat(p)\n370\t\t\tif err != nil {\n371\t\t\t\tcontinue\n372\t\t\t}\n373\t\t\tinfos[i] = entryInfo{fi.Ino, fi.Blocks / 2, fi.Mode}\n374\t\t\tif n := len(strconv.FormatUint(fi.Ino, 10)); n > inodeW {\n375\t\t\t\tinodeW = n\n376\t\t\t}\n377\t\t\tif n := len(strconv.FormatInt(fi.Blocks/2, 10)); n > blocksW {\n378\t\t\t\tblocksW = n\n379\t\t\t}\n380\t\t}\n381\t\treturn infos, inodeW, blocksW\n382\t}\n383\t\n384\tfunc buildDisplayNames(names []string, basePath string, opts options) []string {\n385\t\tneedPrefix := opts.showInode || opts.showBlocks\n386\t\tneedColor := format.FileTypeColor(os.ModeDir) != \"\"\n387\t\tif !needPrefix && !needColor {\n388\t\t\treturn names\n389\t\t}\n390\t\tinfos, inodeW, blocksW := statDisplayEntries(names, basePath)\n391\t\tresult := make([]string, len(names))\n392\t\tfor i, name := range names {\n393\t\t\tvar b strings.Builder\n394\t\t\tif opts.showInode {\n395\t\t\t\tb.WriteString(format.PadLeft(strconv.FormatUint(infos[i].inode, 10), inodeW))\n396\t\t\t\tb.WriteByte(' ')\n397\t\t\t}\n398\t\t\tif opts.showBlocks {\n399\t\t\t\tb.WriteString(format.PadLeft(strconv.FormatInt(infos[i].blocks, 10), blocksW))\n400\t\t\t\tb.WriteByte(' ')\n401\t\t\t}\n402\t\t\tb.WriteString(colorEntry(name, infos[i].mode))\n403\t\t\tresult[i] = b.String()\n404\t\t}\n405\t\treturn result\n406\t}\n407\t\n408\tfunc colorEntry(name string, mode os.FileMode) string {\n409\t\tc := format.FileTypeColor(mode)\n410\t\tif c == \"\" {\n411\t\t\treturn name\n412\t\t}\n413\t\treturn c + name + format.Reset()\n414\t}\n415\t\n416\tfunc writeEntries(names []string, opts options) {\n417\t\tif len(names) == 0 {\n418\t\t\treturn\n419\t\t}\n420\t\tif opts.forceColumns {\n421\t\t\tif opts.horizontalSort {\n422\t\t\t\twriteHorizontalColumns(names, 0)\n423\t\t\t} else {\n424\t\t\t\twriteColumnsWidth(names, 0)\n425\t\t\t}\n426\t\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n427\t\t\twriteLines(names)\n428\t\t} else {\n429\t\t\twriteColumnsWidth(names, 0)\n430\t\t}\n431\t}\n432\t\n433\tfunc writeColumnsWidth(names []string, width int) {\n434\t\tif width <= 0 {\n435\t\t\tw, err := sys.TerminalWidth()\n436\t\t\tif err != nil {\n437\t\t\t\tw = 80\n438\t\t\t}\n439\t\t\twidth = w\n440\t\t}\n441\t\tgrid := format.Columns(names, width)\n442\t\twidths := gridColumnWidths(grid)\n443\t\tfor _, row := range grid {\n444\t\t\twriteGridRow(row, widths)\n445\t\t}\n446\t}\n447\t\n448\tfunc writeHorizontalColumns(names []string, width int) {\n449\t\tif width <= 0 {\n450\t\t\tw, err := sys.TerminalWidth()\n451\t\t\tif err != nil {\n452\t\t\t\tw = 80\n453\t\t\t}\n454\t\t\twidth = w\n455\t\t}\n456\t\tnumCols := findHorizontalMaxCols(names, width)\n457\t\trows := (len(names) + numCols - 1) / numCols\n458\t\tcolWidths := make([]int, numCols)\n459\t\tfor c := 0; c < numCols; c++ {\n460\t\t\tfor r := 0; r < rows; r++ {\n461\t\t\t\tidx := r*numCols + c\n462\t\t\t\tif idx >= len(names) {\n463\t\t\t\t\tbreak\n464\t\t\t\t}\n465\t\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n466\t\t\t\t\tcolWidths[c] = w\n467\t\t\t\t}\n468\t\t\t}\n469\t\t}\n470\t\tfor r := 0; r < rows; r++ {\n471\t\t\tvar row []string\n472\t\t\tfor c := 0; c < numCols; c++ {\n473\t\t\t\tidx := r*numCols + c\n474\t\t\t\tif idx >= len(names) {\n475\t\t\t\t\tbreak\n476\t\t\t\t}\n477\t\t\t\trow = append(row, names[idx])\n478\t\t\t}\n479\t\t\twriteGridRow(row, colWidths)\n480\t\t}\n481\t}\n482\t\n483\tfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n484\t\tn := len(entries)\n485\t\tfor cols := n; cols > 1; cols-- {\n486\t\t\tif horizontalGridFits(entries, cols, termWidth) {\n487\t\t\t\treturn cols\n488\t\t\t}\n489\t\t}\n490\t\treturn 1\n491\t}\n492\t\n493\tfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n494\t\trows := (len(entries) + cols - 1) / cols\n495\t\tcolWidths := make([]int, cols)\n496\t\tfor c := 0; c < cols; c++ {\n497\t\t\tfor r := 0; r < rows; r++ {\n498\t\t\t\tidx := r*cols + c\n499\t\t\t\tif idx >= len(entries) {\n500\t\t\t\t\tbreak\n501\t\t\t\t}\n502\t\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n503\t\t\t\t\tcolWidths[c] = w\n504\t\t\t\t}\n505\t\t\t}\n506\t\t}\n507\t\ttotal := 0\n508\t\tfor c := 0; c < cols; c++ {\n509\t\t\tif c < cols-1 {\n510\t\t\t\ttotal += colWidths[c] + 2\n511\t\t\t} else {\n512\t\t\t\ttotal += colWidths[c]\n513\t\t\t}\n514\t\t\tif total > termWidth {\n515\t\t\t\treturn false\n516\t\t\t}\n517\t\t}\n518\t\treturn true\n519\t}\n520\t\n521\tfunc writeLines(names []string) {\n522\t\tfor _, name := range names {\n523\t\t\twriteLine(name)\n524\t\t}\n525\t}\n526\t\n527\tfunc gridColumnWidths(grid [][]string) []int {\n528\t\tif len(grid) == 0 {\n529\t\t\treturn nil\n530\t\t}\n531\t\twidths := make([]int, len(grid[0]))\n532\t\tfor _, row := range grid {\n533\t\t\tfor c, cell := range row {\n534\t\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n535\t\t\t\t\twidths[c] = w\n536\t\t\t\t}\n537\t\t\t}\n538\t\t}\n539\t\treturn widths\n540\t}\n541\t\n542\tfunc writeGridRow(row []string, widths []int) {\n543\t\tvar b strings.Builder\n544\t\tfor i, cell := range row {\n545\t\t\tif i < len(row)-1 {\n546\t\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n547\t\t\t\tb.WriteString(\"  \")\n548\t\t\t} else {\n549\t\t\t\tb.WriteString(cell)\n550\t\t\t}\n551\t\t}\n552\t\twriteLine(b.String())\n553\t}\n554\t\n555\ttype longEntry struct {\n556\t\tname  string\n557\t\tpath  string\n558\t\tinfo  *sys.FileInfo\n559\t\towner string\n560\t\tgroup string\n561\t}\n562\t\n563\ttype longWidths struct {\n564\t\tinode  int\n565\t\tblocks int\n566\t\tnlink  int\n567\t\towner  int\n568\t\tgroup  int\n569\t\tsize   int\n570\t}\n571\t\n572\tfunc writeLongFiles(paths []string, opts options) int {\n573\t\tentries := make([]longEntry, 0, len(paths))\n574\t\tcode := 0\n575\t\tfor _, p := range paths {\n576\t\t\tfi, err := sys.Lstat(p)\n577\t\t\tif err != nil {\n578\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n579\t\t\t\tcode = 2\n580\t\t\t\tcontinue\n581\t\t\t}\n582\t\t\tentries = append(entries, newLongEntry(p, p, fi, opts))\n583\t\t}\n584\t\twriteLongEntries(entries, opts)\n585\t\treturn code\n586\t}\n587\t\n588\tfunc writeLongDir(path string, names []string, opts options) int {\n589\t\tentries := make([]longEntry, 0, len(names))\n590\t\tcode := 0\n591\t\tfor _, name := range names {\n592\t\t\tfull := filepath.Join(path, name)\n593\t\t\tfi, err := sys.Lstat(full)\n594\t\t\tif err != nil {\n595\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n596\t\t\t\tcode = 2\n597\t\t\t\tcontinue\n598\t\t\t}\n599\t\t\tentries = append(entries, newLongEntry(name, full, fi, opts))\n600\t\t}\n601\t\ttotalBlocks := int64(0)\n602\t\tfor _, e := range entries {\n603\t\t\ttotalBlocks += e.info.Blocks\n604\t\t}\n605\t\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n606\t\twriteLongEntries(entries, opts)\n607\t\treturn code\n608\t}\n609\t\n610\tfunc newLongEntry(name, path string, fi *sys.FileInfo, opts options) longEntry {\n611\t\towner := resolveOwner(fi.Uid)\n612\t\tgroup := resolveGroup(fi.Gid)\n613\t\tif opts.numericIds {\n614\t\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n615\t\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n616\t\t}\n617\t\treturn longEntry{\n618\t\t\tname:  name,\n619\t\t\tpath:  path,\n620\t\t\tinfo:  fi,\n621\t\t\towner: owner,\n622\t\t\tgroup: group,\n623\t\t}\n624\t}\n625\t\n626\tfunc writeLongEntries(entries []longEntry, opts options) {\n627\t\tif len(entries) == 0 {\n628\t\t\treturn\n629\t\t}\n630\t\tw := computeLongWidths(entries, opts)\n631\t\tfor _, e := range entries {\n632\t\t\twriteLine(formatLongLine(e, w, opts))\n633\t\t}\n634\t}\n635\t\n636\tfunc computeLongWidths(entries []longEntry, opts options) longWidths {\n637\t\tvar w longWidths\n638\t\tfor _, e := range entries {\n639\t\t\tif opts.showInode {\n640\t\t\t\tif n := len(strconv.FormatUint(e.info.Ino, 10)); n > w.inode {\n641\t\t\t\t\tw.inode = n\n642\t\t\t\t}\n643\t\t\t}\n644\t\t\tif opts.showBlocks {\n645\t\t\t\tif n := len(strconv.FormatInt(e.info.Blocks/2, 10)); n > w.blocks {\n646\t\t\t\t\tw.blocks = n\n647\t\t\t\t}\n648\t\t\t}\n649\t\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n650\t\t\t\tw.nlink = n\n651\t\t\t}\n652\t\t\tif n := len(e.owner); n > w.owner {\n653\t\t\t\tw.owner = n\n654\t\t\t}\n655\t\t\tif n := len(e.group); n > w.group {\n656\t\t\t\tw.group = n\n657\t\t\t}\n658\t\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n659\t\t\t\tw.size = n\n660\t\t\t}\n661\t\t}\n662\t\treturn w\n663\t}\n664\t\n665\tfunc formatLongLine(e longEntry, w longWidths, opts options) string {\n666\t\tvar prefix string\n667\t\tif opts.showInode {\n668\t\t\tprefix += format.PadLeft(strconv.FormatUint(e.info.Ino, 10), w.inode) + \" \"\n669\t\t}\n670\t\tif opts.showBlocks {\n671\t\t\tprefix += format.PadLeft(strconv.FormatInt(e.info.Blocks/2, 10), w.blocks) + \" \"\n672\t\t}\n673\t\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n674\t\tsize := strconv.FormatInt(e.info.Size, 10)\n675\t\tname := colorEntry(e.name, e.info.Mode)\n676\t\tif e.info.Mode&os.ModeSymlink != 0 {\n677\t\t\tif target, err := os.Readlink(e.path); err == nil {\n678\t\t\t\tname += \" -> \" + target\n679\t\t\t}\n680\t\t}\n681\t\treturn prefix +\n682\t\t\tpermString(e.info.Mode) + \" \" +\n683\t\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n684\t\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n685\t\t\tformat.PadRight(e.group, w.group) + \" \" +\n686\t\t\tformat.PadLeft(size, w.size) + \" \" +\n687\t\t\tformatMtime(e.info.ModTime) + \" \" +\n688\t\t\tname\n689\t}\n690\t\n691\tfunc permString(mode os.FileMode) string {\n692\t\tvar b [10]byte\n693\t\tb[0] = fileTypeChar(mode)\n694\t\tconst rwx = \"rwx\"\n695\t\tperm := mode.Perm()\n696\t\tfor i := 0; i < 9; i++ {\n697\t\t\tif perm&(1<<uint(8-i)) != 0 {\n698\t\t\t\tb[1+i] = rwx[i%3]\n699\t\t\t} else {\n700\t\t\t\tb[1+i] = '-'\n701\t\t\t}\n702\t\t}\n703\t\tapplySpecialBits(mode, &b)\n704\t\treturn string(b[:])\n705\t}\n706\t\n707\tfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n708\t\tif mode&os.ModeSetuid != 0 {\n709\t\t\tif b[3] == 'x' {\n710\t\t\t\tb[3] = 's'\n711\t\t\t} else {\n712\t\t\t\tb[3] = 'S'\n713\t\t\t}\n714\t\t}\n715\t\tif mode&os.ModeSetgid != 0 {\n716\t\t\tif b[6] == 'x' {\n717\t\t\t\tb[6] = 's'\n718\t\t\t} else {\n719\t\t\t\tb[6] = 'S'\n720\t\t\t}\n721\t\t}\n722\t\tif mode&os.ModeSticky != 0 {\n723\t\t\tif b[9] == 'x' {\n724\t\t\t\tb[9] = 't'\n725\t\t\t} else {\n726\t\t\t\tb[9] = 'T'\n727\t\t\t}\n728\t\t}\n729\t}\n730\t\n731\tfunc fileTypeChar(mode os.FileMode) byte {\n732\t\tswitch {\n733\t\tcase mode&os.ModeDir != 0:\n734\t\t\treturn 'd'\n735\t\tcase mode&os.ModeSymlink != 0:\n736\t\t\treturn 'l'\n737\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n738\t\t\treturn 'c'\n739\t\tcase mode&os.ModeDevice != 0:\n740\t\t\treturn 'b'\n741\t\tcase mode&os.ModeNamedPipe != 0:\n742\t\t\treturn 'p'\n743\t\tcase mode&os.ModeSocket != 0:\n744\t\t\treturn 's'\n745\t\tdefault:\n746\t\t\treturn '-'\n747\t\t}\n748\t}\n749\t\n750\tfunc resolveOwner(uid uint32) string {\n751\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n752\t\tif err != nil {\n753\t\t\treturn strconv.FormatUint(uint64(uid), 10)\n754\t\t}\n755\t\treturn u.Username\n756\t}\n757\t\n758\tfunc resolveGroup(gid uint32) string {\n759\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n760\t\tif err != nil {\n761\t\t\treturn strconv.FormatUint(uint64(gid), 10)\n762\t\t}\n763\t\treturn g.Name\n764\t}\n765\t\n766\tfunc formatMtime(t time.Time) string {\n767\t\tsixMonths := 6 * 30 * 24 * time.Hour\n768\t\tago := time.Since(t)\n769\t\tif ago >= 0 && ago < sixMonths {\n770\t\t\treturn t.Format(\"Jan _2 15:04\")\n771\t\t}\n772\t\treturn t.Format(\"Jan _2  2006\")\n773\t}\n774\t\n775\tfunc writeLine(s string) {\n776\t\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n777\t\t\tos.Exit(1)\n778\t\t}\n779\t}\n780\t\n781\tfunc sysError(err error) string {\n782\t\tvar pathErr *os.PathError\n783\t\tif errors.As(err, &pathErr) {\n784\t\t\treturn pathErr.Err.Error()\n785\t\t}\n786\t\treturn err.Error()\n787\t}\n788\t"}]},"parent_tool_use_id":null,"session_id":"bc084725-cea8-4998-8eed-e375644451ce","uuid":"51bafffe-f70d-436d-97b4-9f671f61a9c4","timestamp":"2026-05-14T22:19:50.302Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5220/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd008-ls R1.1-R1.14, R2.1-R2.15, R3.1-R3.3.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n  -a             do not ignore entries starting with .\n  -A             do not list implied . and ..\n  -C             list entries by columns\n  -d             list directories themselves, not their contents\n  -i             print the index number of each file\n  -l             use a long listing format\n  -n             like -l, but list numeric user and group IDs\n  -r             reverse order while sorting\n  -s             print the allocated size of each file, in blocks\n  -S             sort by file size, largest first\n  -t             sort by modification time, newest first\n  -U             do not sort; list entries in directory order\n  -v             natural sort of (version) numbers within text\n  -x             list entries by lines instead of by columns\n  -1             list one file per line\n      --color[=WHEN]  colorize the output; WHEN can be 'always'\n                         (default if omitted), 'auto', or 'never'\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn   bool\n\tlongFormat     bool\n\tforceColumns   bool\n\thorizontalSort bool\n\tshowAll        bool\n\tshowAlmostAll  bool\n\tdirAsEntry     bool\n\tsortByTime     bool\n\tsortBySize     bool\n\treverseSort    bool\n\tunsorted       bool\n\tversionSort    bool\n\tshowInode      bool\n\tshowBlocks     bool\n\tnumericIds     bool\n\tcolorMode      string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase arg == \"--color\":\n\t\t\topts.colorMode = \"always\"\n\t\tcase strings.HasPrefix(arg, \"--color=\"):\n\t\t\topts.colorMode = parseColorValue(arg)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'C':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = false\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'x':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = true\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'a':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\tcase 'A':\n\t\t\topts.showAlmostAll = true\n\t\t\topts.showAll = false\n\t\tcase 'd':\n\t\t\topts.dirAsEntry = true\n\t\tcase 'i':\n\t\t\topts.showInode = true\n\t\tcase 'n':\n\t\t\topts.numericIds = true\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'r':\n\t\t\topts.reverseSort = true\n\t\tcase 's':\n\t\t\topts.showBlocks = true\n\t\tcase 't':\n\t\t\topts.sortByTime = true\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'S':\n\t\t\topts.sortBySize = true\n\t\t\topts.sortByTime = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'U':\n\t\t\topts.unsorted = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.versionSort = false\n\t\tcase 'v':\n\t\t\topts.versionSort = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc parseColorValue(arg string) string {\n\tval := arg[len(\"--color=\"):]\n\tswitch val {\n\tcase \"always\", \"auto\", \"never\":\n\t\treturn val\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"ls: invalid argument '%s' for '--color'\\n\", val)\n\t\tfmt.Fprintln(os.Stderr,\n\t\t\t\"Try 'ls --help' for more information.\")\n\t\tos.Exit(2)\n\t\treturn \"\"\n\t}\n}\n\nfunc setupColor(opts options) {\n\tswitch opts.colorMode {\n\tcase \"always\":\n\t\tformat.SetColorEnabled(true)\n\tcase \"auto\":\n\t\tformat.SetColorEnabled(sys.IsTerminal(os.Stdout.Fd()))\n\tdefault:\n\t\tformat.SetColorEnabled(false)\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\tsetupColor(opts)\n\texitCode := 0\n\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n\tneedSep := false\n\tif len(files) > 0 {\n\t\tsortEntries(files, \"\", opts)\n\t\tif opts.longFormat {\n\t\t\texitCode = maxCode(exitCode, writeLongFiles(files, opts))\n\t\t} else {\n\t\t\tdisplay := buildDisplayNames(files, \"\", opts)\n\t\t\twriteEntries(display, opts)\n\t\t}\n\t\tneedSep = true\n\t}\n\tshowHeader := len(dirs) > 1 || len(files) > 0\n\tsortEntries(dirs, \"\", opts)\n\tfor _, dir := range dirs {\n\t\tif needSep {\n\t\t\tfmt.Fprintln(os.Stdout)\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n\t\t}\n\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n\t\tneedSep = true\n\t}\n\treturn exitCode\n}\n\nfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n\tvar files, dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\t*exitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() && !dirAsEntry {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\treturn files, dirs\n}\n\nfunc maxCode(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc listDir(path string, opts options) int {\n\tnames, err := readNames(path, opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n\t\t\tpath, sysError(err))\n\t\treturn 2\n\t}\n\tif opts.longFormat {\n\t\treturn writeLongDir(path, names, opts)\n\t}\n\tdisplay := buildDisplayNames(names, path, opts)\n\twriteEntries(display, opts)\n\treturn 0\n}\n\nfunc readNames(path string, opts options) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tif opts.showAll {\n\t\tnames = append(names, \".\", \"..\")\n\t}\n\tfor _, e := range entries {\n\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name())\n\t}\n\tsortEntries(names, path, opts)\n\treturn names, nil\n}\n\nfunc sortEntries(names []string, basePath string, opts options) {\n\tif opts.unsorted {\n\t\treturn\n\t}\n\tif opts.versionSort {\n\t\tsort.SliceStable(names, func(i, j int) bool {\n\t\t\treturn strverscmp(names[i], names[j]) < 0\n\t\t})\n\t\tif opts.reverseSort {\n\t\t\treverseSlice(names)\n\t\t}\n\t\treturn\n\t}\n\tif !opts.sortByTime && !opts.sortBySize {\n\t\tsort.Strings(names)\n\t\tif opts.reverseSort {\n\t\t\treverseSlice(names)\n\t\t}\n\t\treturn\n\t}\n\ttype entry struct {\n\t\tname    string\n\t\tmodTime time.Time\n\t\tsize    int64\n\t}\n\tentries := make([]entry, len(names))\n\tfor i, name := range names {\n\t\tentries[i].name = name\n\t\tp := name\n\t\tif basePath != \"\" {\n\t\t\tp = filepath.Join(basePath, name)\n\t\t}\n\t\tif fi, err := sys.Lstat(p); err == nil {\n\t\t\tentries[i].modTime = fi.ModTime\n\t\t\tentries[i].size = fi.Size\n\t\t}\n\t}\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\tif opts.sortByTime {\n\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n\t\t\t}\n\t\t\treturn entries[i].name < entries[j].name\n\t\t}\n\t\tif entries[i].size != entries[j].size {\n\t\t\treturn entries[i].size > entries[j].size\n\t\t}\n\t\treturn entries[i].name < entries[j].name\n\t})\n\tfor i, e := range entries {\n\t\tnames[i] = e.name\n\t}\n\tif opts.reverseSort {\n\t\treverseSlice(names)\n\t}\n}\n\ntype entryInfo struct {\n\tinode  uint64\n\tblocks int64\n\tmode   os.FileMode\n}\n\nfunc statDisplayEntries(names []string, basePath string) ([]entryInfo, int, int) {\n\tinfos := make([]entryInfo, len(names))\n\tvar inodeW, blocksW int\n\tfor i, name := range names {\n\t\tp := name\n\t\tif basePath != \"\" {\n\t\t\tp = filepath.Join(basePath, name)\n\t\t}\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tinfos[i] = entryInfo{fi.Ino, fi.Blocks / 2, fi.Mode}\n\t\tif n := len(strconv.FormatUint(fi.Ino, 10)); n > inodeW {\n\t\t\tinodeW = n\n\t\t}\n\t\tif n := len(strconv.FormatInt(fi.Blocks/2, 10)); n > blocksW {\n\t\t\tblocksW = n\n\t\t}\n\t}\n\treturn infos, inodeW, blocksW\n}\n\nfunc buildDisplayNames(names []string, basePath string, opts options) []string {\n\tneedPrefix := opts.showInode || opts.showBlocks\n\tneedColor := format.FileTypeColor(os.ModeDir) != \"\"\n\tif !needPrefix && !needColor {\n\t\treturn names\n\t}\n\tinfos, inodeW, blocksW := statDisplayEntries(names, basePath)\n\tresult := make([]string, len(names))\n\tfor i, name := range names {\n\t\tvar b strings.Builder\n\t\tif opts.showInode {\n\t\t\tb.WriteString(format.PadLeft(strconv.FormatUint(infos[i].inode, 10), inodeW))\n\t\t\tb.WriteByte(' ')\n\t\t}\n\t\tif opts.showBlocks {\n\t\t\tb.WriteString(format.PadLeft(strconv.FormatInt(infos[i].blocks, 10), blocksW))\n\t\t\tb.WriteByte(' ')\n\t\t}\n\t\tb.WriteString(colorEntry(name, infos[i].mode))\n\t\tresult[i] = b.String()\n\t}\n\treturn result\n}\n\nfunc colorEntry(name string, mode os.FileMode) string {\n\tc := format.FileTypeColor(mode)\n\tif c == \"\" {\n\t\treturn name\n\t}\n\treturn c + name + format.Reset()\n}\n\nfunc writeEntries(names []string, opts options) {\n\tif len(names) == 0 {\n\t\treturn\n\t}\n\tif opts.forceColumns {\n\t\tif opts.horizontalSort {\n\t\t\twriteHorizontalColumns(names, 0)\n\t\t} else {\n\t\t\twriteColumnsWidth(names, 0)\n\t\t}\n\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n\t\twriteLines(names)\n\t} else {\n\t\twriteColumnsWidth(names, 0)\n\t}\n}\n\nfunc writeColumnsWidth(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tgrid := format.Columns(names, width)\n\twidths := gridColumnWidths(grid)\n\tfor _, row := range grid {\n\t\twriteGridRow(row, widths)\n\t}\n}\n\nfunc writeHorizontalColumns(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tnumCols := findHorizontalMaxCols(names, width)\n\trows := (len(names) + numCols - 1) / numCols\n\tcolWidths := make([]int, numCols)\n\tfor c := 0; c < numCols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\tfor r := 0; r < rows; r++ {\n\t\tvar row []string\n\t\tfor c := 0; c < numCols; c++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\trow = append(row, names[idx])\n\t\t}\n\t\twriteGridRow(row, colWidths)\n\t}\n}\n\nfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n\tn := len(entries)\n\tfor cols := n; cols > 1; cols-- {\n\t\tif horizontalGridFits(entries, cols, termWidth) {\n\t\t\treturn cols\n\t\t}\n\t}\n\treturn 1\n}\n\nfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n\trows := (len(entries) + cols - 1) / cols\n\tcolWidths := make([]int, cols)\n\tfor c := 0; c < cols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*cols + c\n\t\t\tif idx >= len(entries) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\ttotal := 0\n\tfor c := 0; c < cols; c++ {\n\t\tif c < cols-1 {\n\t\t\ttotal += colWidths[c] + 2\n\t\t} else {\n\t\t\ttotal += colWidths[c]\n\t\t}\n\t\tif total > termWidth {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc writeLines(names []string) {\n\tfor _, name := range names {\n\t\twriteLine(name)\n\t}\n}\n\nfunc gridColumnWidths(grid [][]string) []int {\n\tif len(grid) == 0 {\n\t\treturn nil\n\t}\n\twidths := make([]int, len(grid[0]))\n\tfor _, row := range grid {\n\t\tfor c, cell := range row {\n\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n\t\t\t\twidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\treturn widths\n}\n\nfunc writeGridRow(row []string, widths []int) {\n\tvar b strings.Builder\n\tfor i, cell := range row {\n\t\tif i < len(row)-1 {\n\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n\t\t\tb.WriteString(\"  \")\n\t\t} else {\n\t\t\tb.WriteString(cell)\n\t\t}\n\t}\n\twriteLine(b.String())\n}\n\ntype longEntry struct {\n\tname  string\n\tpath  string\n\tinfo  *sys.FileInfo\n\towner string\n\tgroup string\n}\n\ntype longWidths struct {\n\tinode  int\n\tblocks int\n\tnlink  int\n\towner  int\n\tgroup  int\n\tsize   int\n}\n\nfunc writeLongFiles(paths []string, opts options) int {\n\tentries := make([]longEntry, 0, len(paths))\n\tcode := 0\n\tfor _, p := range paths {\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(p, p, fi, opts))\n\t}\n\twriteLongEntries(entries, opts)\n\treturn code\n}\n\nfunc writeLongDir(path string, names []string, opts options) int {\n\tentries := make([]longEntry, 0, len(names))\n\tcode := 0\n\tfor _, name := range names {\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(full)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(name, full, fi, opts))\n\t}\n\ttotalBlocks := int64(0)\n\tfor _, e := range entries {\n\t\ttotalBlocks += e.info.Blocks\n\t}\n\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n\twriteLongEntries(entries, opts)\n\treturn code\n}\n\nfunc newLongEntry(name, path string, fi *sys.FileInfo, opts options) longEntry {\n\towner := resolveOwner(fi.Uid)\n\tgroup := resolveGroup(fi.Gid)\n\tif opts.numericIds {\n\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n\t}\n\treturn longEntry{\n\t\tname:  name,\n\t\tpath:  path,\n\t\tinfo:  fi,\n\t\towner: owner,\n\t\tgroup: group,\n\t}\n}\n\nfunc writeLongEntries(entries []longEntry, opts options) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tw := computeLongWidths(entries, opts)\n\tfor _, e := range entries {\n\t\twriteLine(formatLongLine(e, w, opts))\n\t}\n}\n\nfunc computeLongWidths(entries []longEntry, opts options) longWidths {\n\tvar w longWidths\n\tfor _, e := range entries {\n\t\tif opts.showInode {\n\t\t\tif n := len(strconv.FormatUint(e.info.Ino, 10)); n > w.inode {\n\t\t\t\tw.inode = n\n\t\t\t}\n\t\t}\n\t\tif opts.showBlocks {\n\t\t\tif n := len(strconv.FormatInt(e.info.Blocks/2, 10)); n > w.blocks {\n\t\t\t\tw.blocks = n\n\t\t\t}\n\t\t}\n\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n\t\t\tw.nlink = n\n\t\t}\n\t\tif n := len(e.owner); n > w.owner {\n\t\t\tw.owner = n\n\t\t}\n\t\tif n := len(e.group); n > w.group {\n\t\t\tw.group = n\n\t\t}\n\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n\t\t\tw.size = n\n\t\t}\n\t}\n\treturn w\n}\n\nfunc formatLongLine(e longEntry, w longWidths, opts options) string {\n\tvar prefix string\n\tif opts.showInode {\n\t\tprefix += format.PadLeft(strconv.FormatUint(e.info.Ino, 10), w.inode) + \" \"\n\t}\n\tif opts.showBlocks {\n\t\tprefix += format.PadLeft(strconv.FormatInt(e.info.Blocks/2, 10), w.blocks) + \" \"\n\t}\n\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n\tsize := strconv.FormatInt(e.info.Size, 10)\n\tname := colorEntry(e.name, e.info.Mode)\n\tif e.info.Mode&os.ModeSymlink != 0 {\n\t\tif target, err := os.Readlink(e.path); err == nil {\n\t\t\tname += \" -> \" + target\n\t\t}\n\t}\n\treturn prefix +\n\t\tpermString(e.info.Mode) + \" \" +\n\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n\t\tformat.PadRight(e.group, w.group) + \" \" +\n\t\tformat.PadLeft(size, w.size) + \" \" +\n\t\tformatMtime(e.info.ModTime) + \" \" +\n\t\tname\n}\n\nfunc permString(mode os.FileMode) string {\n\tvar b [10]byte\n\tb[0] = fileTypeChar(mode)\n\tconst rwx = \"rwx\"\n\tperm := mode.Perm()\n\tfor i := 0; i < 9; i++ {\n\t\tif perm&(1<<uint(8-i)) != 0 {\n\t\t\tb[1+i] = rwx[i%3]\n\t\t} else {\n\t\t\tb[1+i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(mode, &b)\n\treturn string(b[:])\n}\n\nfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif b[3] == 'x' {\n\t\t\tb[3] = 's'\n\t\t} else {\n\t\t\tb[3] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif b[6] == 'x' {\n\t\t\tb[6] = 's'\n\t\t} else {\n\t\t\tb[6] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif b[9] == 'x' {\n\t\t\tb[9] = 't'\n\t\t} else {\n\t\t\tb[9] = 'T'\n\t\t}\n\t}\n}\n\nfunc fileTypeChar(mode os.FileMode) byte {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn 'l'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\treturn 'b'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\treturn 's'\n\tdefault:\n\t\treturn '-'\n\t}\n}\n\nfunc resolveOwner(uid uint32) string {\n\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(uid), 10)\n\t}\n\treturn u.Username\n}\n\nfunc resolveGroup(gid uint32) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(gid), 10)\n\t}\n\treturn g.Name\n}\n\nfunc formatMtime(t time.Time) string {\n\tsixMonths := 6 * 30 * 24 * time.Hour\n\tago := time.Since(t)\n\tif ago >= 0 && ago < sixMonths {\n\t\treturn t.Format(\"Jan _2 15:04\")\n\t}\n\treturn t.Format(\"Jan _2  2006\")\n}\n\nfunc writeLine(s string) {\n\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc sysError(err error) string {\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\treturn pathErr.Err.Error()\n\t}\n\treturn err.Error()\n}\n","numLines":788,"startLine":1,"totalLines":788}}}
