{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VHnMmfvxU94oHcDPgsmLMA","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd008-ls R1.1-R1.14, R2.1-R2.6.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\t\"unicode/utf8\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n21\t)\n22\t\n23\tconst helpText = `Usage: ls [OPTION]... [FILE]...\n24\tList information about the FILEs (the current directory by default).\n25\tSort entries alphabetically if no flags given.\n26\t\n27\t  -a             do not ignore entries starting with .\n28\t  -A             do not list implied . and ..\n29\t  -C             list entries by columns\n30\t  -d             list directories themselves, not their contents\n31\t  -l             use a long listing format\n32\t  -S             sort by file size, largest first\n33\t  -t             sort by modification time, newest first\n34\t  -x             list entries by lines instead of by columns\n35\t  -1             list one file per line\n36\t      --help     display this help and exit\n37\t      --version  output version information and exit\n38\t`\n39\t\n40\tconst versionText = `ls (go-unix-utils) dev\n41\t`\n42\t\n43\ttype options struct {\n44\t\tsingleColumn   bool\n45\t\tlongFormat     bool\n46\t\tforceColumns   bool\n47\t\thorizontalSort bool\n48\t\tshowAll        bool\n49\t\tshowAlmostAll  bool\n50\t\tdirAsEntry     bool\n51\t\tsortByTime     bool\n52\t\tsortBySize     bool\n53\t}\n54\t\n55\tfunc main() {\n56\t\tsys.InstallSIGPIPEHandler()\n57\t\topts, paths := parseArgs(os.Args[1:])\n58\t\tif len(paths) == 0 {\n59\t\t\tpaths = []string{\".\"}\n60\t\t}\n61\t\tos.Exit(run(paths, opts))\n62\t}\n63\t\n64\tfunc parseArgs(args []string) (options, []string) {\n65\t\tvar opts options\n66\t\tvar paths []string\n67\t\tfor len(args) > 0 {\n68\t\t\targ := args[0]\n69\t\t\targs = args[1:]\n70\t\t\tswitch {\n71\t\t\tcase arg == \"--help\":\n72\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n73\t\t\t\tos.Exit(0)\n74\t\t\tcase arg == \"--version\":\n75\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n76\t\t\t\tos.Exit(0)\n77\t\t\tcase arg == \"--\":\n78\t\t\t\treturn opts, append(paths, args...)\n79\t\t\tcase strings.HasPrefix(arg, \"--\"):\n80\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n81\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n82\t\t\t\tos.Exit(2)\n83\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n84\t\t\t\tparseShortFlags(arg[1:], &opts)\n85\t\t\tdefault:\n86\t\t\t\tpaths = append(paths, arg)\n87\t\t\t}\n88\t\t}\n89\t\treturn opts, paths\n90\t}\n91\t\n92\tfunc parseShortFlags(flags string, opts *options) {\n93\t\tfor _, ch := range flags {\n94\t\t\tswitch ch {\n95\t\t\tcase '1':\n96\t\t\t\topts.forceColumns = false\n97\t\t\t\topts.horizontalSort = false\n98\t\t\t\tif !opts.longFormat {\n99\t\t\t\t\topts.singleColumn = true\n100\t\t\t\t}\n101\t\t\tcase 'l':\n102\t\t\t\topts.longFormat = true\n103\t\t\t\topts.singleColumn = false\n104\t\t\t\topts.forceColumns = false\n105\t\t\t\topts.horizontalSort = false\n106\t\t\tcase 'C':\n107\t\t\t\topts.forceColumns = true\n108\t\t\t\topts.horizontalSort = false\n109\t\t\t\topts.longFormat = false\n110\t\t\t\topts.singleColumn = false\n111\t\t\tcase 'x':\n112\t\t\t\topts.forceColumns = true\n113\t\t\t\topts.horizontalSort = true\n114\t\t\t\topts.longFormat = false\n115\t\t\t\topts.singleColumn = false\n116\t\t\tcase 'a':\n117\t\t\t\topts.showAll = true\n118\t\t\t\topts.showAlmostAll = false\n119\t\t\tcase 'A':\n120\t\t\t\topts.showAlmostAll = true\n121\t\t\t\topts.showAll = false\n122\t\t\tcase 'd':\n123\t\t\t\topts.dirAsEntry = true\n124\t\t\tcase 't':\n125\t\t\t\topts.sortByTime = true\n126\t\t\t\topts.sortBySize = false\n127\t\t\tcase 'S':\n128\t\t\t\topts.sortBySize = true\n129\t\t\t\topts.sortByTime = false\n130\t\t\tdefault:\n131\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n132\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n133\t\t\t\tos.Exit(2)\n134\t\t\t}\n135\t\t}\n136\t}\n137\t\n138\tfunc run(paths []string, opts options) int {\n139\t\texitCode := 0\n140\t\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n141\t\tneedSep := false\n142\t\tif len(files) > 0 {\n143\t\t\tsortEntries(files, \"\", opts)\n144\t\t\tif opts.longFormat {\n145\t\t\t\texitCode = maxCode(exitCode, writeLongFiles(files))\n146\t\t\t} else {\n147\t\t\t\twriteEntries(files, opts)\n148\t\t\t}\n149\t\t\tneedSep = true\n150\t\t}\n151\t\tshowHeader := len(dirs) > 1 || len(files) > 0\n152\t\tsortEntries(dirs, \"\", opts)\n153\t\tfor _, dir := range dirs {\n154\t\t\tif needSep {\n155\t\t\t\tfmt.Fprintln(os.Stdout)\n156\t\t\t}\n157\t\t\tif showHeader {\n158\t\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n159\t\t\t}\n160\t\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n161\t\t\tneedSep = true\n162\t\t}\n163\t\treturn exitCode\n164\t}\n165\t\n166\tfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n167\t\tvar files, dirs []string\n168\t\tfor _, p := range paths {\n169\t\t\tinfo, err := os.Lstat(p)\n170\t\t\tif err != nil {\n171\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n172\t\t\t\t*exitCode = 2\n173\t\t\t\tcontinue\n174\t\t\t}\n175\t\t\tif info.IsDir() && !dirAsEntry {\n176\t\t\t\tdirs = append(dirs, p)\n177\t\t\t} else {\n178\t\t\t\tfiles = append(files, p)\n179\t\t\t}\n180\t\t}\n181\t\treturn files, dirs\n182\t}\n183\t\n184\tfunc maxCode(a, b int) int {\n185\t\tif a > b {\n186\t\t\treturn a\n187\t\t}\n188\t\treturn b\n189\t}\n190\t\n191\tfunc listDir(path string, opts options) int {\n192\t\tnames, err := readNames(path, opts)\n193\t\tif err != nil {\n194\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n195\t\t\t\tpath, sysError(err))\n196\t\t\treturn 2\n197\t\t}\n198\t\tif opts.longFormat {\n199\t\t\treturn writeLongDir(path, names)\n200\t\t}\n201\t\twriteEntries(names, opts)\n202\t\treturn 0\n203\t}\n204\t\n205\tfunc readNames(path string, opts options) ([]string, error) {\n206\t\tentries, err := os.ReadDir(path)\n207\t\tif err != nil {\n208\t\t\treturn nil, err\n209\t\t}\n210\t\tnames := make([]string, 0, len(entries))\n211\t\tif opts.showAll {\n212\t\t\tnames = append(names, \".\", \"..\")\n213\t\t}\n214\t\tfor _, e := range entries {\n215\t\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n216\t\t\t\tcontinue\n217\t\t\t}\n218\t\t\tnames = append(names, e.Name())\n219\t\t}\n220\t\tsortEntries(names, path, opts)\n221\t\treturn names, nil\n222\t}\n223\t\n224\tfunc sortEntries(names []string, basePath string, opts options) {\n225\t\tif !opts.sortByTime && !opts.sortBySize {\n226\t\t\tsort.Strings(names)\n227\t\t\treturn\n228\t\t}\n229\t\ttype entry struct {\n230\t\t\tname    string\n231\t\t\tmodTime time.Time\n232\t\t\tsize    int64\n233\t\t}\n234\t\tentries := make([]entry, len(names))\n235\t\tfor i, name := range names {\n236\t\t\tentries[i].name = name\n237\t\t\tp := name\n238\t\t\tif basePath != \"\" {\n239\t\t\t\tp = filepath.Join(basePath, name)\n240\t\t\t}\n241\t\t\tif fi, err := sys.Lstat(p); err == nil {\n242\t\t\t\tentries[i].modTime = fi.ModTime\n243\t\t\t\tentries[i].size = fi.Size\n244\t\t\t}\n245\t\t}\n246\t\tsort.SliceStable(entries, func(i, j int) bool {\n247\t\t\tif opts.sortByTime {\n248\t\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n249\t\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n250\t\t\t\t}\n251\t\t\t\treturn entries[i].name < entries[j].name\n252\t\t\t}\n253\t\t\tif entries[i].size != entries[j].size {\n254\t\t\t\treturn entries[i].size > entries[j].size\n255\t\t\t}\n256\t\t\treturn entries[i].name < entries[j].name\n257\t\t})\n258\t\tfor i, e := range entries {\n259\t\t\tnames[i] = e.name\n260\t\t}\n261\t}\n262\t\n263\tfunc writeEntries(names []string, opts options) {\n264\t\tif len(names) == 0 {\n265\t\t\treturn\n266\t\t}\n267\t\tif opts.forceColumns {\n268\t\t\tif opts.horizontalSort {\n269\t\t\t\twriteHorizontalColumns(names, 0)\n270\t\t\t} else {\n271\t\t\t\twriteColumnsWidth(names, 0)\n272\t\t\t}\n273\t\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n274\t\t\twriteLines(names)\n275\t\t} else {\n276\t\t\twriteColumnsWidth(names, 0)\n277\t\t}\n278\t}\n279\t\n280\tfunc writeColumnsWidth(names []string, width int) {\n281\t\tif width <= 0 {\n282\t\t\tw, err := sys.TerminalWidth()\n283\t\t\tif err != nil {\n284\t\t\t\tw = 80\n285\t\t\t}\n286\t\t\twidth = w\n287\t\t}\n288\t\tgrid := format.Columns(names, width)\n289\t\twidths := gridColumnWidths(grid)\n290\t\tfor _, row := range grid {\n291\t\t\twriteGridRow(row, widths)\n292\t\t}\n293\t}\n294\t\n295\tfunc writeHorizontalColumns(names []string, width int) {\n296\t\tif width <= 0 {\n297\t\t\tw, err := sys.TerminalWidth()\n298\t\t\tif err != nil {\n299\t\t\t\tw = 80\n300\t\t\t}\n301\t\t\twidth = w\n302\t\t}\n303\t\tnumCols := findHorizontalMaxCols(names, width)\n304\t\trows := (len(names) + numCols - 1) / numCols\n305\t\tcolWidths := make([]int, numCols)\n306\t\tfor c := 0; c < numCols; c++ {\n307\t\t\tfor r := 0; r < rows; r++ {\n308\t\t\t\tidx := r*numCols + c\n309\t\t\t\tif idx >= len(names) {\n310\t\t\t\t\tbreak\n311\t\t\t\t}\n312\t\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n313\t\t\t\t\tcolWidths[c] = w\n314\t\t\t\t}\n315\t\t\t}\n316\t\t}\n317\t\tfor r := 0; r < rows; r++ {\n318\t\t\tvar row []string\n319\t\t\tfor c := 0; c < numCols; c++ {\n320\t\t\t\tidx := r*numCols + c\n321\t\t\t\tif idx >= len(names) {\n322\t\t\t\t\tbreak\n323\t\t\t\t}\n324\t\t\t\trow = append(row, names[idx])\n325\t\t\t}\n326\t\t\twriteGridRow(row, colWidths)\n327\t\t}\n328\t}\n329\t\n330\tfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n331\t\tn := len(entries)\n332\t\tfor cols := n; cols > 1; cols-- {\n333\t\t\tif horizontalGridFits(entries, cols, termWidth) {\n334\t\t\t\treturn cols\n335\t\t\t}\n336\t\t}\n337\t\treturn 1\n338\t}\n339\t\n340\tfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n341\t\trows := (len(entries) + cols - 1) / cols\n342\t\tcolWidths := make([]int, cols)\n343\t\tfor c := 0; c < cols; c++ {\n344\t\t\tfor r := 0; r < rows; r++ {\n345\t\t\t\tidx := r*cols + c\n346\t\t\t\tif idx >= len(entries) {\n347\t\t\t\t\tbreak\n348\t\t\t\t}\n349\t\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n350\t\t\t\t\tcolWidths[c] = w\n351\t\t\t\t}\n352\t\t\t}\n353\t\t}\n354\t\ttotal := 0\n355\t\tfor c := 0; c < cols; c++ {\n356\t\t\tif c < cols-1 {\n357\t\t\t\ttotal += colWidths[c] + 2\n358\t\t\t} else {\n359\t\t\t\ttotal += colWidths[c]\n360\t\t\t}\n361\t\t\tif total > termWidth {\n362\t\t\t\treturn false\n363\t\t\t}\n364\t\t}\n365\t\treturn true\n366\t}\n367\t\n368\tfunc writeLines(names []string) {\n369\t\tfor _, name := range names {\n370\t\t\twriteLine(name)\n371\t\t}\n372\t}\n373\t\n374\tfunc gridColumnWidths(grid [][]string) []int {\n375\t\tif len(grid) == 0 {\n376\t\t\treturn nil\n377\t\t}\n378\t\twidths := make([]int, len(grid[0]))\n379\t\tfor _, row := range grid {\n380\t\t\tfor c, cell := range row {\n381\t\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n382\t\t\t\t\twidths[c] = w\n383\t\t\t\t}\n384\t\t\t}\n385\t\t}\n386\t\treturn widths\n387\t}\n388\t\n389\tfunc writeGridRow(row []string, widths []int) {\n390\t\tvar b strings.Builder\n391\t\tfor i, cell := range row {\n392\t\t\tif i < len(row)-1 {\n393\t\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n394\t\t\t\tb.WriteString(\"  \")\n395\t\t\t} else {\n396\t\t\t\tb.WriteString(cell)\n397\t\t\t}\n398\t\t}\n399\t\twriteLine(b.String())\n400\t}\n401\t\n402\ttype longEntry struct {\n403\t\tname  string\n404\t\tpath  string\n405\t\tinfo  *sys.FileInfo\n406\t\towner string\n407\t\tgroup string\n408\t}\n409\t\n410\ttype longWidths struct {\n411\t\tnlink int\n412\t\towner int\n413\t\tgroup int\n414\t\tsize  int\n415\t}\n416\t\n417\tfunc writeLongFiles(paths []string) int {\n418\t\tentries := make([]longEntry, 0, len(paths))\n419\t\tcode := 0\n420\t\tfor _, p := range paths {\n421\t\t\tfi, err := sys.Lstat(p)\n422\t\t\tif err != nil {\n423\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n424\t\t\t\tcode = 2\n425\t\t\t\tcontinue\n426\t\t\t}\n427\t\t\tentries = append(entries, newLongEntry(p, p, fi))\n428\t\t}\n429\t\twriteLongEntries(entries)\n430\t\treturn code\n431\t}\n432\t\n433\tfunc writeLongDir(path string, names []string) int {\n434\t\tentries := make([]longEntry, 0, len(names))\n435\t\tcode := 0\n436\t\tfor _, name := range names {\n437\t\t\tfull := filepath.Join(path, name)\n438\t\t\tfi, err := sys.Lstat(full)\n439\t\t\tif err != nil {\n440\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n441\t\t\t\tcode = 2\n442\t\t\t\tcontinue\n443\t\t\t}\n444\t\t\tentries = append(entries, newLongEntry(name, full, fi))\n445\t\t}\n446\t\ttotalBlocks := int64(0)\n447\t\tfor _, e := range entries {\n448\t\t\ttotalBlocks += e.info.Blocks\n449\t\t}\n450\t\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n451\t\twriteLongEntries(entries)\n452\t\treturn code\n453\t}\n454\t\n455\tfunc newLongEntry(name string, path string, fi *sys.FileInfo) longEntry {\n456\t\treturn longEntry{\n457\t\t\tname:  name,\n458\t\t\tpath:  path,\n459\t\t\tinfo:  fi,\n460\t\t\towner: resolveOwner(fi.Uid),\n461\t\t\tgroup: resolveGroup(fi.Gid),\n462\t\t}\n463\t}\n464\t\n465\tfunc writeLongEntries(entries []longEntry) {\n466\t\tif len(entries) == 0 {\n467\t\t\treturn\n468\t\t}\n469\t\tw := computeLongWidths(entries)\n470\t\tfor _, e := range entries {\n471\t\t\twriteLine(formatLongLine(e, w))\n472\t\t}\n473\t}\n474\t\n475\tfunc computeLongWidths(entries []longEntry) longWidths {\n476\t\tvar w longWidths\n477\t\tfor _, e := range entries {\n478\t\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n479\t\t\t\tw.nlink = n\n480\t\t\t}\n481\t\t\tif n := len(e.owner); n > w.owner {\n482\t\t\t\tw.owner = n\n483\t\t\t}\n484\t\t\tif n := len(e.group); n > w.group {\n485\t\t\t\tw.group = n\n486\t\t\t}\n487\t\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n488\t\t\t\tw.size = n\n489\t\t\t}\n490\t\t}\n491\t\treturn w\n492\t}\n493\t\n494\tfunc formatLongLine(e longEntry, w longWidths) string {\n495\t\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n496\t\tsize := strconv.FormatInt(e.info.Size, 10)\n497\t\tname := e.name\n498\t\tif e.info.Mode&os.ModeSymlink != 0 {\n499\t\t\tif target, err := os.Readlink(e.path); err == nil {\n500\t\t\t\tname += \" -> \" + target\n501\t\t\t}\n502\t\t}\n503\t\treturn permString(e.info.Mode) + \" \" +\n504\t\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n505\t\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n506\t\t\tformat.PadRight(e.group, w.group) + \" \" +\n507\t\t\tformat.PadLeft(size, w.size) + \" \" +\n508\t\t\tformatMtime(e.info.ModTime) + \" \" +\n509\t\t\tname\n510\t}\n511\t\n512\tfunc permString(mode os.FileMode) string {\n513\t\tvar b [10]byte\n514\t\tb[0] = fileTypeChar(mode)\n515\t\tconst rwx = \"rwx\"\n516\t\tperm := mode.Perm()\n517\t\tfor i := 0; i < 9; i++ {\n518\t\t\tif perm&(1<<uint(8-i)) != 0 {\n519\t\t\t\tb[1+i] = rwx[i%3]\n520\t\t\t} else {\n521\t\t\t\tb[1+i] = '-'\n522\t\t\t}\n523\t\t}\n524\t\tapplySpecialBits(mode, &b)\n525\t\treturn string(b[:])\n526\t}\n527\t\n528\tfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n529\t\tif mode&os.ModeSetuid != 0 {\n530\t\t\tif b[3] == 'x' {\n531\t\t\t\tb[3] = 's'\n532\t\t\t} else {\n533\t\t\t\tb[3] = 'S'\n534\t\t\t}\n535\t\t}\n536\t\tif mode&os.ModeSetgid != 0 {\n537\t\t\tif b[6] == 'x' {\n538\t\t\t\tb[6] = 's'\n539\t\t\t} else {\n540\t\t\t\tb[6] = 'S'\n541\t\t\t}\n542\t\t}\n543\t\tif mode&os.ModeSticky != 0 {\n544\t\t\tif b[9] == 'x' {\n545\t\t\t\tb[9] = 't'\n546\t\t\t} else {\n547\t\t\t\tb[9] = 'T'\n548\t\t\t}\n549\t\t}\n550\t}\n551\t\n552\tfunc fileTypeChar(mode os.FileMode) byte {\n553\t\tswitch {\n554\t\tcase mode&os.ModeDir != 0:\n555\t\t\treturn 'd'\n556\t\tcase mode&os.ModeSymlink != 0:\n557\t\t\treturn 'l'\n558\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n559\t\t\treturn 'c'\n560\t\tcase mode&os.ModeDevice != 0:\n561\t\t\treturn 'b'\n562\t\tcase mode&os.ModeNamedPipe != 0:\n563\t\t\treturn 'p'\n564\t\tcase mode&os.ModeSocket != 0:\n565\t\t\treturn 's'\n566\t\tdefault:\n567\t\t\treturn '-'\n568\t\t}\n569\t}\n570\t\n571\tfunc resolveOwner(uid uint32) string {\n572\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n573\t\tif err != nil {\n574\t\t\treturn strconv.FormatUint(uint64(uid), 10)\n575\t\t}\n576\t\treturn u.Username\n577\t}\n578\t\n579\tfunc resolveGroup(gid uint32) string {\n580\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n581\t\tif err != nil {\n582\t\t\treturn strconv.FormatUint(uint64(gid), 10)\n583\t\t}\n584\t\treturn g.Name\n585\t}\n586\t\n587\tfunc formatMtime(t time.Time) string {\n588\t\tsixMonths := 6 * 30 * 24 * time.Hour\n589\t\tago := time.Since(t)\n590\t\tif ago >= 0 && ago < sixMonths {\n591\t\t\treturn t.Format(\"Jan _2 15:04\")\n592\t\t}\n593\t\treturn t.Format(\"Jan _2  2006\")\n594\t}\n595\t\n596\tfunc writeLine(s string) {\n597\t\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n598\t\t\tos.Exit(1)\n599\t\t}\n600\t}\n601\t\n602\tfunc sysError(err error) string {\n603\t\tvar pathErr *os.PathError\n604\t\tif errors.As(err, &pathErr) {\n605\t\t\treturn pathErr.Err.Error()\n606\t\t}\n607\t\treturn err.Error()\n608\t}\n609\t"}]},"parent_tool_use_id":null,"session_id":"57c237a2-51c6-44f4-a02e-e82460fe14a1","uuid":"a57cb797-535e-4b5b-8db1-bc6a00a9ef29","timestamp":"2026-05-14T21:42:36.932Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5210/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd008-ls R1.1-R1.14, R2.1-R2.6.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n  -a             do not ignore entries starting with .\n  -A             do not list implied . and ..\n  -C             list entries by columns\n  -d             list directories themselves, not their contents\n  -l             use a long listing format\n  -S             sort by file size, largest first\n  -t             sort by modification time, newest first\n  -x             list entries by lines instead of by columns\n  -1             list one file per line\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn   bool\n\tlongFormat     bool\n\tforceColumns   bool\n\thorizontalSort bool\n\tshowAll        bool\n\tshowAlmostAll  bool\n\tdirAsEntry     bool\n\tsortByTime     bool\n\tsortBySize     bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'C':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = false\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'x':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = true\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'a':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\tcase 'A':\n\t\t\topts.showAlmostAll = true\n\t\t\topts.showAll = false\n\t\tcase 'd':\n\t\t\topts.dirAsEntry = true\n\t\tcase 't':\n\t\t\topts.sortByTime = true\n\t\t\topts.sortBySize = false\n\t\tcase 'S':\n\t\t\topts.sortBySize = true\n\t\t\topts.sortByTime = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\texitCode := 0\n\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n\tneedSep := false\n\tif len(files) > 0 {\n\t\tsortEntries(files, \"\", opts)\n\t\tif opts.longFormat {\n\t\t\texitCode = maxCode(exitCode, writeLongFiles(files))\n\t\t} else {\n\t\t\twriteEntries(files, opts)\n\t\t}\n\t\tneedSep = true\n\t}\n\tshowHeader := len(dirs) > 1 || len(files) > 0\n\tsortEntries(dirs, \"\", opts)\n\tfor _, dir := range dirs {\n\t\tif needSep {\n\t\t\tfmt.Fprintln(os.Stdout)\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n\t\t}\n\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n\t\tneedSep = true\n\t}\n\treturn exitCode\n}\n\nfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n\tvar files, dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\t*exitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() && !dirAsEntry {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\treturn files, dirs\n}\n\nfunc maxCode(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc listDir(path string, opts options) int {\n\tnames, err := readNames(path, opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n\t\t\tpath, sysError(err))\n\t\treturn 2\n\t}\n\tif opts.longFormat {\n\t\treturn writeLongDir(path, names)\n\t}\n\twriteEntries(names, opts)\n\treturn 0\n}\n\nfunc readNames(path string, opts options) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tif opts.showAll {\n\t\tnames = append(names, \".\", \"..\")\n\t}\n\tfor _, e := range entries {\n\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name())\n\t}\n\tsortEntries(names, path, opts)\n\treturn names, nil\n}\n\nfunc sortEntries(names []string, basePath string, opts options) {\n\tif !opts.sortByTime && !opts.sortBySize {\n\t\tsort.Strings(names)\n\t\treturn\n\t}\n\ttype entry struct {\n\t\tname    string\n\t\tmodTime time.Time\n\t\tsize    int64\n\t}\n\tentries := make([]entry, len(names))\n\tfor i, name := range names {\n\t\tentries[i].name = name\n\t\tp := name\n\t\tif basePath != \"\" {\n\t\t\tp = filepath.Join(basePath, name)\n\t\t}\n\t\tif fi, err := sys.Lstat(p); err == nil {\n\t\t\tentries[i].modTime = fi.ModTime\n\t\t\tentries[i].size = fi.Size\n\t\t}\n\t}\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\tif opts.sortByTime {\n\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n\t\t\t}\n\t\t\treturn entries[i].name < entries[j].name\n\t\t}\n\t\tif entries[i].size != entries[j].size {\n\t\t\treturn entries[i].size > entries[j].size\n\t\t}\n\t\treturn entries[i].name < entries[j].name\n\t})\n\tfor i, e := range entries {\n\t\tnames[i] = e.name\n\t}\n}\n\nfunc writeEntries(names []string, opts options) {\n\tif len(names) == 0 {\n\t\treturn\n\t}\n\tif opts.forceColumns {\n\t\tif opts.horizontalSort {\n\t\t\twriteHorizontalColumns(names, 0)\n\t\t} else {\n\t\t\twriteColumnsWidth(names, 0)\n\t\t}\n\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n\t\twriteLines(names)\n\t} else {\n\t\twriteColumnsWidth(names, 0)\n\t}\n}\n\nfunc writeColumnsWidth(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tgrid := format.Columns(names, width)\n\twidths := gridColumnWidths(grid)\n\tfor _, row := range grid {\n\t\twriteGridRow(row, widths)\n\t}\n}\n\nfunc writeHorizontalColumns(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tnumCols := findHorizontalMaxCols(names, width)\n\trows := (len(names) + numCols - 1) / numCols\n\tcolWidths := make([]int, numCols)\n\tfor c := 0; c < numCols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\tfor r := 0; r < rows; r++ {\n\t\tvar row []string\n\t\tfor c := 0; c < numCols; c++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\trow = append(row, names[idx])\n\t\t}\n\t\twriteGridRow(row, colWidths)\n\t}\n}\n\nfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n\tn := len(entries)\n\tfor cols := n; cols > 1; cols-- {\n\t\tif horizontalGridFits(entries, cols, termWidth) {\n\t\t\treturn cols\n\t\t}\n\t}\n\treturn 1\n}\n\nfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n\trows := (len(entries) + cols - 1) / cols\n\tcolWidths := make([]int, cols)\n\tfor c := 0; c < cols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*cols + c\n\t\t\tif idx >= len(entries) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\ttotal := 0\n\tfor c := 0; c < cols; c++ {\n\t\tif c < cols-1 {\n\t\t\ttotal += colWidths[c] + 2\n\t\t} else {\n\t\t\ttotal += colWidths[c]\n\t\t}\n\t\tif total > termWidth {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc writeLines(names []string) {\n\tfor _, name := range names {\n\t\twriteLine(name)\n\t}\n}\n\nfunc gridColumnWidths(grid [][]string) []int {\n\tif len(grid) == 0 {\n\t\treturn nil\n\t}\n\twidths := make([]int, len(grid[0]))\n\tfor _, row := range grid {\n\t\tfor c, cell := range row {\n\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n\t\t\t\twidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\treturn widths\n}\n\nfunc writeGridRow(row []string, widths []int) {\n\tvar b strings.Builder\n\tfor i, cell := range row {\n\t\tif i < len(row)-1 {\n\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n\t\t\tb.WriteString(\"  \")\n\t\t} else {\n\t\t\tb.WriteString(cell)\n\t\t}\n\t}\n\twriteLine(b.String())\n}\n\ntype longEntry struct {\n\tname  string\n\tpath  string\n\tinfo  *sys.FileInfo\n\towner string\n\tgroup string\n}\n\ntype longWidths struct {\n\tnlink int\n\towner int\n\tgroup int\n\tsize  int\n}\n\nfunc writeLongFiles(paths []string) int {\n\tentries := make([]longEntry, 0, len(paths))\n\tcode := 0\n\tfor _, p := range paths {\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(p, p, fi))\n\t}\n\twriteLongEntries(entries)\n\treturn code\n}\n\nfunc writeLongDir(path string, names []string) int {\n\tentries := make([]longEntry, 0, len(names))\n\tcode := 0\n\tfor _, name := range names {\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(full)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(name, full, fi))\n\t}\n\ttotalBlocks := int64(0)\n\tfor _, e := range entries {\n\t\ttotalBlocks += e.info.Blocks\n\t}\n\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n\twriteLongEntries(entries)\n\treturn code\n}\n\nfunc newLongEntry(name string, path string, fi *sys.FileInfo) longEntry {\n\treturn longEntry{\n\t\tname:  name,\n\t\tpath:  path,\n\t\tinfo:  fi,\n\t\towner: resolveOwner(fi.Uid),\n\t\tgroup: resolveGroup(fi.Gid),\n\t}\n}\n\nfunc writeLongEntries(entries []longEntry) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tw := computeLongWidths(entries)\n\tfor _, e := range entries {\n\t\twriteLine(formatLongLine(e, w))\n\t}\n}\n\nfunc computeLongWidths(entries []longEntry) longWidths {\n\tvar w longWidths\n\tfor _, e := range entries {\n\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n\t\t\tw.nlink = n\n\t\t}\n\t\tif n := len(e.owner); n > w.owner {\n\t\t\tw.owner = n\n\t\t}\n\t\tif n := len(e.group); n > w.group {\n\t\t\tw.group = n\n\t\t}\n\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n\t\t\tw.size = n\n\t\t}\n\t}\n\treturn w\n}\n\nfunc formatLongLine(e longEntry, w longWidths) string {\n\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n\tsize := strconv.FormatInt(e.info.Size, 10)\n\tname := e.name\n\tif e.info.Mode&os.ModeSymlink != 0 {\n\t\tif target, err := os.Readlink(e.path); err == nil {\n\t\t\tname += \" -> \" + target\n\t\t}\n\t}\n\treturn permString(e.info.Mode) + \" \" +\n\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n\t\tformat.PadRight(e.group, w.group) + \" \" +\n\t\tformat.PadLeft(size, w.size) + \" \" +\n\t\tformatMtime(e.info.ModTime) + \" \" +\n\t\tname\n}\n\nfunc permString(mode os.FileMode) string {\n\tvar b [10]byte\n\tb[0] = fileTypeChar(mode)\n\tconst rwx = \"rwx\"\n\tperm := mode.Perm()\n\tfor i := 0; i < 9; i++ {\n\t\tif perm&(1<<uint(8-i)) != 0 {\n\t\t\tb[1+i] = rwx[i%3]\n\t\t} else {\n\t\t\tb[1+i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(mode, &b)\n\treturn string(b[:])\n}\n\nfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif b[3] == 'x' {\n\t\t\tb[3] = 's'\n\t\t} else {\n\t\t\tb[3] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif b[6] == 'x' {\n\t\t\tb[6] = 's'\n\t\t} else {\n\t\t\tb[6] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif b[9] == 'x' {\n\t\t\tb[9] = 't'\n\t\t} else {\n\t\t\tb[9] = 'T'\n\t\t}\n\t}\n}\n\nfunc fileTypeChar(mode os.FileMode) byte {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn 'l'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\treturn 'b'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\treturn 's'\n\tdefault:\n\t\treturn '-'\n\t}\n}\n\nfunc resolveOwner(uid uint32) string {\n\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(uid), 10)\n\t}\n\treturn u.Username\n}\n\nfunc resolveGroup(gid uint32) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(gid), 10)\n\t}\n\treturn g.Name\n}\n\nfunc formatMtime(t time.Time) string {\n\tsixMonths := 6 * 30 * 24 * time.Hour\n\tago := time.Since(t)\n\tif ago >= 0 && ago < sixMonths {\n\t\treturn t.Format(\"Jan _2 15:04\")\n\t}\n\treturn t.Format(\"Jan _2  2006\")\n}\n\nfunc writeLine(s string) {\n\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc sysError(err error) string {\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\treturn pathErr.Err.Error()\n\t}\n\treturn err.Error()\n}\n","numLines":609,"startLine":1,"totalLines":609}}}
