est string, mode overwriteMode) overwriteAction {\n214\t\tif _, err := os.Lstat(dest); err != nil {\n215\t\t\treturn owProceed\n216\t\t}\n217\t\tswitch mode {\n218\t\tcase modeNoClobber:\n219\t\t\treturn owSkip\n220\t\tcase modeInteractive:\n221\t\t\tif promptOverwrite(dest) {\n222\t\t\t\treturn owProceed\n223\t\t\t}\n224\t\t\treturn owSkipError\n225\t\t}\n226\t\treturn owProceed\n227\t}\n228\t\n229\tfunc promptOverwrite(dest string) bool {\n230\t\tfmt.Fprintf(os.Stderr, \"mv: overwrite '%s'? \", dest)\n231\t\tif !stdinScanner.Scan() {\n232\t\t\treturn false\n233\t\t}\n234\t\tline := stdinScanner.Text()\n235\t\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n236\t}\n237\t\n238\tfunc moveFile(src, dest string) (bool, error) {\n239\t\tsrcInfo, err := os.Lstat(src)\n240\t\tif err != nil {\n241\t\t\treturn false, fmtPathErr(\"cannot stat\", src, err)\n242\t\t}\n243\t\terr = os.Rename(src, dest)\n244\t\tif err == nil {\n245\t\t\treturn true, nil\n246\t\t}\n247\t\tif isCrossDevice(err) {\n248\t\t\treturn false, crossDeviceMove(src, dest)\n249\t\t}\n250\t\tif srcInfo.IsDir() && isDirExistsErr(err) {\n251\t\t\tif rmErr := os.Remove(dest); rmErr == nil {\n252\t\t\t\tif err2 := os.Rename(src, dest); err2 == nil {\n253\t\t\t\t\treturn true, nil\n254\t\t\t\t}\n255\t\t\t}\n256\t\t}\n257\t\tif !srcInfo.IsDir() {\n258\t\t\tif di, derr := os.Lstat(dest); derr == nil && di.IsDir() {\n259\t\t\t\treturn false, fmt.Errorf(\n260\t\t\t\t\t\"cannot overwrite directory '%s' with non-directory '%s'\", dest, src)\n261\t\t\t}\n262\t\t}\n263\t\treturn false, fmtMoveErr(src, dest, err)\n264\t}\n265\t\n266\tfunc printVerbose(src, dest string, renamed bool) {\n267\t\tif renamed {\n268\t\t\tfmt.Printf(\"renamed '%s' -> '%s'\\n\", src, dest)\n269\t\t} else {\n270\t\t\tfmt.Printf(\"'%s' -> '%s'\\n\", src, dest)\n271\t\t}\n272\t}\n273\t\n274\tfunc isCrossDevice(err error) bool {\n275\t\tif linkErr, ok := errors.AsType[*os.LinkError](err); ok {\n276\t\t\treturn errors.Is(linkErr.Err, sysca