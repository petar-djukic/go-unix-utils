oss all error messages.\n\nI'll write a function that replaces patterns like `genv:` or `env:` or the full binary path at the beginning of lines with a canonical prefix, so the test output matches regardless of which binary name was used. I'm updating the error message format to match the genv output style, then adding a test normalizer that strips the binary name prefix so the error messages can be compared consistently.","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":969,"cache_read_input_tokens":35490,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":969},"output_tokens":9,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d461bfc8-ec86-4b76-a705-0ddc369f10bf","uuid":"ee14decd-1aa0-4822-8d20-414bc5832f3b"}
