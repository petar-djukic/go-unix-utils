{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LF4DPX3FB7SAyj9axZFPgw","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"strings\"\n14\t\t\"testing\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n18\t)\n19\t\n20\tfunc TestDiff(t *testing.T) {\n21\t\tgoBin := testutils.BuildBinary(t, \".\")\n22\t\trefBin, err := exec.LookPath(\"gtee\")\n23\t\tif err != nil {\n24\t\t\tt.Skip(\"reference binary gtee not found\")\n25\t\t}\n26\t\ttests := []testutils.DiffTest{\n27\t\t\t{Name: \"passthrough_no_files\", Stdin: []byte(\"hello\\nworld\\n\")},\n28\t\t\t{Name: \"empty_stdin\", Stdin: []byte{}},\n29\t\t\t{Name: \"large_input\", Stdin: bytes.Repeat([]byte(\"abcdefghij\\n\"), 1000)},\n30\t\t\t{Name: \"no_trailing_newline\", Stdin: []byte(\"no newline\")},\n31\t\t\t{Name: \"binary_data\", Stdin: allBytes()},\n32\t\t}\n33\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n34\t}\n35\t\n36\tfunc TestDiffSingleFile(t *testing.T) {\n37\t\tgoBin := testutils.BuildBinary(t, \".\")\n38\t\trefBin, err := exec.LookPath(\"gtee\")\n39\t\tif err != nil {\n40\t\t\tt.Skip(\"reference binary gtee not found\")\n41\t\t}\n42\t\tinput := []byte(\"hello\\nworld\\n\")\n43\t\trunFileTest(t, goBin, \"go_single\", input, \"out.txt\")\n44\t\trunFileTest(t, refBin, \"ref_single\", input, \"out.txt\")\n45\t}\n46\t\n47\tfunc TestDiffMultipleFiles(t *testing.T) {\n48\t\tgoBin := testutils.BuildBinary(t, \".\")\n49\t\trefBin, err := exec.LookPath(\"gtee\")\n50\t\tif err != nil {\n51\t\t\tt.Skip(\"reference binary gtee not found\")\n52\t\t}\n53\t\tinput := []byte(\"multi\\nfile\\ntest\\n\")\n54\t\tgoStdout := runMultiFileTest(t, goBin, \"go_multi\", input, \"a.txt\", \"b.txt\")\n55\t\trefStdout := runMultiFileTest(t,