Error for tee-style diagnostics.\nfunc formatPathError(err error) string {\n\tif pe, ok := err.(*os.PathError); ok {\n\t\treturn fmt.Sprintf(\"%s: %s\", pe.Path, pe.Err.Error())\n\t}\n\treturn err.Error()\n}\n\nfunc closeFiles(files []*os.File) {\n\tfor _, f := range files {\n\t\tf.Close() // best-effort close, error ignored\n\t}\n}\n","structuredPatch":[],"originalFile":null}}
