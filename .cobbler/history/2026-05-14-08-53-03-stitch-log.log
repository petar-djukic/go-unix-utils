{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XLsBL2haKY1frAEPHA3DdB","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: head [OPTION]... [FILE]...\n18\tPrint the first 10 lines of each FILE to standard output.\n19\tWith more than one FILE, precede each with a header giving the file name.\n20\t\n21\tWith no FILE, or when FILE is -, read standard input.\n22\t\n23\tMandatory arguments to long options are mandatory for short options too.\n24\t  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n25\t                             with the leading '-', print all but the last\n26\t                             NUM bytes of each file\n27\t  -n, --lines=[-]NUM       output the first NUM lines instead of the first 10;\n28\t                             with the leading '-', output all but the last\n29\t                             NUM lines of each file\n30\t  -q, --quiet, --silent    never print headers giving file names\n31\t  -v, --verbose            always print headers giving file names\n32\t      --help        display this help and exit\n33\t      --version     output version information and exit\n34\t`\n35\t\n36\tconst versionText = `head (go-unix-utils) dev\n37\t`\n38\t\n39\ttype countMode int\n40\t\n41\tconst (\n42\t\tmodeLines countMode = iota\n43\t\tmodeBytes\n44\t)\n45\t\n46\ttype options struct {\n47\t\tmode  countMode\n48\t\tcount int64\n49\t}\n50\t\n51\tfunc main() {\n52\t\tsys.InstallSIGPIPEHandler()\n53\t\n54\t\topts, files, err := parseArgs(os.Args[1:])\n55\t\tif err != nil {\n56\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n57\t\t\tfmt.Fprintf(os.Stderr, \"Try 'head --help' for more information.\\n\")\n58\t\t\tos.Exit(1)\n59\t\t}\n60\t\n61\t\tif len(files) == 0 {\n62\t\t\tfiles = []string{\"-\"}\n63\t\t}\n64\t\n65\t\texitCode := 0\n66\t\tfor _, file := range files {\n67\t\t\tif err := processFile(opts, file); err != nil {\n68\t\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n69\t\t\t\texitCode = 1\n70\t\t\t}\n71\t\t}\n72\t\tif exitCode != 0 {\n73\t\t\tos.Exit(exitCode)\n74\t\t}\n75\t}\n76\t\n77\tfunc parseArgs(args []string) (options, []string, error) {\n78\t\topts := options{count: 10}\n79\t\tvar files []string\n80\t\n81\t\ti := 0\n82\t\tfor i < len(args) {\n83\t\t\targ := args[i]\n84\t\t\tif arg == \"--\" {\n85\t\t\t\tfiles = append(files, args[i+1:]...)\n86\t\t\t\tbreak\n87\t\t\t}\n88\t\t\tif strings.HasPrefix(arg, \"--\") {\n89\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n90\t\t\t\tif err != nil {\n91\t\t\t\t\treturn opts, nil, err\n92\t\t\t\t}\n93\t\t\t\ti += n\n94\t\t\t\tcontinue\n95\t\t\t}\n96\t\t\tif len(arg) > 1 && arg[0] == '-' {\n97\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n98\t\t\t\tif err != nil {\n99\t\t\t\t\treturn opts, nil, err\n100\t\t\t\t}\n101\t\t\t\ti += 1 + n\n102\t\t\t\tcontinue\n103\t\t\t}\n104\t\t\tfiles = append(files, arg)\n105\t\t\ti++\n106\t\t}\n107\t\n108\t\treturn opts, files, nil\n109\t}\n110\t\n111\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n112\t\tswitch {\n113\t\tcase flag == \"--help\":\n114\t\t\tfmt.Fprint(os.Stdout, helpText)\n115\t\t\tos.Exit(0)\n116\t\t\treturn 0, nil\n117\t\tcase flag == \"--version\":\n118\t\t\tfmt.Fprint(os.Stdout, versionText)\n119\t\t\tos.Exit(0)\n120\t\t\treturn 0, nil\n121\t\tcase flag == \"--lines\":\n122\t\t\tif len(remaining) < 2 {\n123\t\t\t\treturn 0, fmt.Errorf(\"option '--lines' requires an argument\")\n124\t\t\t}\n125\t\t\tcount, err := parseLineCount(remaining[1])\n126\t\t\tif err != nil {\n127\t\t\t\treturn 0, err\n128\t\t\t}\n129\t\t\topts.count = count\n130\t\t\topts.mode = modeLines\n131\t\t\treturn 2, nil\n132\t\tcase strings.HasPrefix(flag, \"--lines=\"):\n133\t\t\tcount, err := parseLineCount(flag[len(\"--lines=\"):])\n134\t\t\tif err != nil {\n135\t\t\t\treturn 0, err\n136\t\t\t}\n137\t\t\topts.count = count\n138\t\t\topts.mode = modeLines\n139\t\t\treturn 1, nil\n140\t\tdefault:\n141\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n142\t\t}\n143\t}\n144\t\n145\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n146\t\tconsumed := 0\n147\t\tfor j := 0; j < len(flags); j++ {\n148\t\t\tswitch flags[j] {\n149\t\t\tcase 'n':\n150\t\t\t\tvar val string\n151\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n152\t\t\t\t\tval = rest\n153\t\t\t\t} else if len(remaining) > consumed {\n154\t\t\t\t\tval = remaining[consumed]\n155\t\t\t\t\tconsumed++\n156\t\t\t\t} else {\n157\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'n'\")\n158\t\t\t\t}\n159\t\t\t\tcount, err := parseLineCount(val)\n160\t\t\t\tif err != nil {\n161\t\t\t\t\treturn 0, err\n162\t\t\t\t}\n163\t\t\t\topts.count = count\n164\t\t\t\topts.mode = modeLines\n165\t\t\t\treturn consumed, nil\n166\t\t\tdefault:\n167\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n168\t\t\t}\n169\t\t}\n170\t\treturn consumed, nil\n171\t}\n172\t\n173\tfunc parseLineCount(s string) (int64, error) {\n174\t\tn, err := strconv.ParseInt(s, 10, 64)\n175\t\tif err != nil {\n176\t\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n177\t\t}\n178\t\treturn n, nil\n179\t}\n180\t\n181\tfunc processFile(opts options, name string) error {\n182\t\tr, closer, err := openInput(name)\n183\t\tif err != nil {\n184\t\t\treturn err\n185\t\t}\n186\t\tif closer != nil {\n187\t\t\tdefer closer.Close()\n188\t\t}\n189\t\treturn headLines(r, os.Stdout, opts.count)\n190\t}\n191\t\n192\tfunc openInput(name string) (io.Reader, io.Closer, error) {\n193\t\tif name == \"-\" {\n194\t\t\treturn os.Stdin, nil, nil\n195\t\t}\n196\t\tf, err := os.Open(name)\n197\t\tif err != nil {\n198\t\t\treturn nil, nil, err\n199\t\t}\n200\t\treturn f, f, nil\n201\t}\n202\t\n203\tfunc headLines(r io.Reader, w io.Writer, count int64) error {\n204\t\tif count == 0 {\n205\t\t\treturn nil\n206\t\t}\n207\t\tif count < 0 {\n208\t\t\treturn headLinesFromEnd(r, w, -count)\n209\t\t}\n210\t\treturn headLinesFromStart(r, w, count)\n211\t}\n212\t\n213\tfunc headLinesFromStart(r io.Reader, w io.Writer, n int64) error {\n214\t\tbr := bufio.NewReader(r)\n215\t\tfor range n {\n216\t\t\tline, err := br.ReadBytes('\\n')\n217\t\t\tif len(line) > 0 {\n218\t\t\t\tif _, werr := w.Write(line); werr != nil {\n219\t\t\t\t\treturn werr\n220\t\t\t\t}\n221\t\t\t}\n222\t\t\tif err != nil {\n223\t\t\t\treturn nil\n224\t\t\t}\n225\t\t}\n226\t\treturn nil\n227\t}\n228\t\n229\tfunc headLinesFromEnd(r io.Reader, w io.Writer, n int64) error {\n230\t\tbr := bufio.NewReader(r)\n231\t\tvar lines [][]byte\n232\t\tfor {\n233\t\t\tline, err := br.ReadBytes('\\n')\n234\t\t\tif len(line) > 0 {\n235\t\t\t\tlines = append(lines, line)\n236\t\t\t}\n237\t\t\tif err != nil {\n238\t\t\t\tbreak\n239\t\t\t}\n240\t\t}\n241\t\tend := max(int64(len(lines))-n, 0)\n242\t\tfor i := range end {\n243\t\t\tif _, err := w.Write(lines[i]); err != nil {\n244\t\t\t\treturn err\n245\t\t\t}\n246\t\t}\n247\t\treturn nil\n248\t}\n249\t"}]},"parent_tool_use_id":null,"session_id":"da4faa5c-0f1e-406c-be26-9d1ebc8f2b9c","uuid":"b81eae30-8004-4126-af09-3c48de5ce2e8","timestamp":"2026-05-14T12:53:13.721Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5165/cmd/head/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: head [OPTION]... [FILE]...\nPrint the first 10 lines of each FILE to standard output.\nWith more than one FILE, precede each with a header giving the file name.\n\nWith no FILE, or when FILE is -, read standard input.\n\nMandatory arguments to long options are mandatory for short options too.\n  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n                             with the leading '-', print all but the last\n                             NUM bytes of each file\n  -n, --lines=[-]NUM       output the first NUM lines instead of the first 10;\n                             with the leading '-', output all but the last\n                             NUM lines of each file\n  -q, --quiet, --silent    never print headers giving file names\n  -v, --verbose            always print headers giving file names\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `head (go-unix-utils) dev\n`\n\ntype countMode int\n\nconst (\n\tmodeLines countMode = iota\n\tmodeBytes\n)\n\ntype options struct {\n\tmode  countMode\n\tcount int64\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'head --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\texitCode := 0\n\tfor _, file := range files {\n\t\tif err := processFile(opts, file); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\topts := options{count: 10}\n\tvar files []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\tfiles = append(files, arg)\n\t\ti++\n\t}\n\n\treturn opts, files, nil\n}\n\nfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--lines\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--lines' requires an argument\")\n\t\t}\n\t\tcount, err := parseLineCount(remaining[1])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeLines\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--lines=\"):\n\t\tcount, err := parseLineCount(flag[len(\"--lines=\"):])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeLines\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 'n':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'n'\")\n\t\t\t}\n\t\t\tcount, err := parseLineCount(val)\n\t\t\tif err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t\topts.count = count\n\t\t\topts.mode = modeLines\n\t\t\treturn consumed, nil\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn consumed, nil\n}\n\nfunc parseLineCount(s string) (int64, error) {\n\tn, err := strconv.ParseInt(s, 10, 64)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc processFile(opts options, name string) error {\n\tr, closer, err := openInput(name)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif closer != nil {\n\t\tdefer closer.Close()\n\t}\n\treturn headLines(r, os.Stdout, opts.count)\n}\n\nfunc openInput(name string) (io.Reader, io.Closer, error) {\n\tif name == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc headLines(r io.Reader, w io.Writer, count int64) error {\n\tif count == 0 {\n\t\treturn nil\n\t}\n\tif count < 0 {\n\t\treturn headLinesFromEnd(r, w, -count)\n\t}\n\treturn headLinesFromStart(r, w, count)\n}\n\nfunc headLinesFromStart(r io.Reader, w io.Writer, n int64) error {\n\tbr := bufio.NewReader(r)\n\tfor range n {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tif _, werr := w.Write(line); werr != nil {\n\t\t\t\treturn werr\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn nil\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc headLinesFromEnd(r io.Reader, w io.Writer, n int64) error {\n\tbr := bufio.NewReader(r)\n\tvar lines [][]byte\n\tfor {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tlines = append(lines, line)\n\t\t}\n\t\tif err != nil {\n\t\t\tbreak\n\t\t}\n\t}\n\tend := max(int64(len(lines))-n, 0)\n\tfor i := range end {\n\t\tif _, err := w.Write(lines[i]); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n","numLines":249,"startLine":1,"totalLines":249}}}
