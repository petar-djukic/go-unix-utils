out; SIGPIPE handler may not be installed\")\n\t}\n\tif err != nil {\n\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n\t}\n}\n\nfunc writeFile(t *testing.T, dir, name, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n","structuredPatch":[{"oldStart":342,"oldLines":12,"newStart":342,"newLines":6,"lines":["       WorkDir: dir,","       Env:     env,","     },","-    {","-      Name:    \"r3_4_output_delimiter_empty\",","-      Args:    []string{\"--output-delimiter=\", \"file1.txt\", \"file2.txt\"},","-      WorkDir: dir,","-      Env:     env,","-    },","   }"," ","   testutils.RunDiffTests(t, goBin, refBin, tests)"]}],"userModified":false,"replaceAll":false}}
