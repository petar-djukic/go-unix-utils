ormation.\")\n72\t\t\t\tos.Exit(1)\n73\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n74\t\t\t\tparseFlagBundle(arg[1:])\n75\t\t\tdefault:\n76\t\t\t\tusers = append(users, arg)\n77\t\t\t}\n78\t\t}\n79\t\treturn users\n80\t}\n81\t\n82\tfunc parseFlagBundle(flags string) {\n83\t\tfor _, ch := range flags {\n84\t\t\tswitch ch {\n85\t\t\tcase 's':\n86\t\t\t\t// -s forces short format, which is the default.\n87\t\t\tdefault:\n88\t\t\t\tfmt.Fprintf(os.Stderr, \"pinky: invalid option -- '%c'\\n\", ch)\n89\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'pinky --help' for more information.\")\n90\t\t\t\tos.Exit(1)\n91\t\t\t}\n92\t\t}\n93\t}\n94\t\n95\tfunc printShort(users []string) error {\n96\t\tentries := readEntries(users)\n97\t\thdr := fmt.Sprintf(\"%-9s%-21s%-9s%-7s%-17s%s\",\n98\t\t\t\"Login\", \"Name\", \"TTY\", \"Idle\", \"When\", \"Where\")\n99\t\tif _, err := fmt.Fprintln(os.Stdout, hdr); err != nil {\n100\t\t\treturn err\n101\t\t}\n102\t\tfor _, e := range entries {\n103\t\t\tif err := printEntry(e); err != nil {\n104\t\t\t\treturn err\n105\t\t\t}\n106\t\t}\n107\t\treturn nil\n108\t}\n109\t\n110\tfunc printEntry(e utmpEntry) error {\n111\t\tname := lookupGecos(e.user)\n112\t\tidle := idleString(e.line)\n113\t\twhen := formatLoginTime(e.time)\n114\t\tvar line string\n115\t\tif e.host != \"\" {\n116\t\t\tline = fmt.Sprintf(\"%-9s%-21s%-9s%-7s%-17s%s\",\n117\t\t\t\te.user, name, e.line, idle, when, e.host)\n118\t\t} else {\n119\t\t\tline = fmt.Sprintf(\"%-9s%-21s%-9s%-7s%s\",\n120\t\t\t\te.user, name, e.line, idle, when)\n121\t\t}\n122\t\t_, err := fmt.Fprintln(os.Stdout, line)\n123\t\treturn err\n124\t}\n125\t\n126\tfunc readEntries(users []string) []utmpEntry {\n127\t\tC.setutxent()\n128\t\tdefer C.endutxent()\n129\t\tfilter := make(map[string]bool, len(users))\n130\t\tfor _, u := range users {\n131\t\t\tfilter[u] = true\n132\t\t}\n133\t\tvar entries []utmpEntry\n134\t\tfor {\n135\t\t\tent := C.getutxent()\n136\t\t\tif ent == nil {\n137\t\t\t\tbreak\n138\t\t\t}\n139\t\t\tif ent.ut_type != C.USER_PROCESS {\n140\t\t\t\tcontinue\n141\t\t\t}\n142\t\t\tuser := C.GoString(&ent.ut_user[0])\n143\t\t\tif len(filter) > 0 && !filter[user] {\n144\t\t\t\tcontinue\n145\t\t\t}\n146\t\t\tentries = append(entries, utmpEntry{\n147\t\t\t\tuser: user,\n148\t\t\t\tline: C.GoString(&ent.ut_line[0]),\n149\t\t\t\thost: C.GoString(&ent.ut_host[0]),\n150\t\t\t\ttime: int64(ent.ut_tv.tv_sec),\n151\t\t\t})\n152\t\t}\n153\t\treturn entries\n154\t}\n155\t\n156\tfunc idleString(ttyName string) string {\n157\t\tfi, err := sys.Stat(\"/dev/\" + ttyName)\n158\t\tif err != nil {\n159\t\t\treturn \"?\"\n160\t\t}\n161\t\tsecs := int(time.Since(fi.AccessTime).Seconds())\n162\t\tif secs < 60 {\n163\t\t\treturn \"\"\n164\t\t}\n165\t\tif secs < 24*60*60 {\n166\t\t\treturn fmt.Sprintf(\"%02d:%02d\", secs/3600, (secs%3600)/60)\n167\t\t}\n168\t\treturn fmt.Sprintf(\"%dd\", secs/(24*60*60))\n169\t}\n170\t\n171\tfunc formatLoginTime(sec int64) string {\n172\t\treturn time.Unix(sec, 0).Format(\"2006-01-02 15:04\")\n173\t}\n174\t\n175\tfunc lookupGecos(user string) string {\n176\t\tcuser := C.CString(user)\n177\t\tdefer C.free(unsafe.Pointer(cuser))\n178\t\tpw := C.getpwnam(cuser)\n179\t\tif pw == nil {\n180\t\t\treturn \"???\"\n181\t\t}\n182\t\tgecos := C.GoString(pw.pw_gecos)\n183\t\tname, _, _ := strings.Cut(gecos, \",\")\n184\t\treturn name\n185\t}\n186\t"}]},"parent_tool_use_id":null,"session_id":"fd2a7807-abd7-4366-bdbe-94cf099e533b","uuid":"cf8edbf8-bf82-4908-8245-c30fc6d325a6","timestamp":"2026-05-24T04:00:21.324Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5572/cmd/pinky/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd098-pinky R1.1, R1.2, R1.3.\npackage main\n\n/*\n#include <utmpx.h>\n#include <pwd.h>\n#include <stdlib.h>\n*/\nimport \"C\"\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n\t\"time\"\n\t\"unsafe\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: pinky [OPTION]... [USER]...\n\n  -s     do short format output, this is the default\n      --help     display this help and exit\n      --version  output version information and exit\n\nA lightweight 'finger' program;  print user information.\nThe utmp file will be /var/run/utmpx.\n`\n\nconst versionText = `pinky (go-unix-utils) dev\n`\n\ntype utmpEntry struct {\n\tuser string\n\tline string\n\thost string\n\ttime int64\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tusers := parseArgs(os.Args[1:])\n\tif err := printShort(users); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) []string {\n\tvar users []string\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tusers = append(users, arg)\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\tendOfFlags = true\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"pinky: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'pinky --help' for more information.\")\n\t\t\tos.Exit(1)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseFlagBundle(arg[1:])\n\t\tdefault:\n\t\t\tusers = append(users, arg)\n\t\t}\n\t}\n\treturn users\n}\n\nfunc parseFlagBundle(flags string) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase 's':\n\t\t\t// -s forces short format, which is the default.\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"pinky: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'pinky --help' for more information.\")\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n}\n\nfunc printShort(users []string) error {\n\tentries := readEntries(users)\n\thdr := fmt.Sprintf(\"%-9s%-21s%-9s%-7s%-17s%s\",\n\t\t\"Login\", \"Name\", \"TTY\", \"Idle\", \"When\", \"Where\")\n\tif _, err := fmt.Fprintln(os.Stdout, hdr); err != nil {\n\t\treturn err\n\t}\n\tfor _, e := range entries {\n\t\tif err := printEntry(e); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc printEntry(e utmpEntry) error {\n\tname := lookupGecos(e.user)\n\tidle := idleString(e.line)\n\twhen := formatLoginTime(e.time)\n\tvar line string\n\tif e.host != \"\" {\n\t\tline = fmt.Sprintf(\"%-9s%-21s%-9s%-7s%-17s%s\",\n\t\t\te.user, name, e.line, idle, when, e.host)\n\t} else {\n\t\tline = fmt.Sprintf(\"%-9s%-21s%-9s%-7s%s\",\n\t\t\te.user, name, e.line, idle, when)\n\t}\n\t_, err := fmt.Fprintln(os.Stdout, line)\n\treturn err\n}\n\nfunc readEntries(users []string) []utmpEntry {\n\tC.setutxent()\n\tdefer C.endutxent()\n\tfilter := make(map[string]bool, len(users))\n\tfor _, u := range users {\n\t\tfilter[u] = true\n\t}\n\tvar entries []utmpEntry\n\tfor {\n\t\tent := C.getutxent()\n\t\tif ent == nil {\n\t\t\tbreak\n\t\t}\n\t\tif ent.ut_type != C.USER_PROCESS {\n\t\t\tcontinue\n\t\t}\n\t\tuser := C.GoString(&ent.ut_user[0])\n\t\tif len(filter) > 0 && !filter[user] {\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, utmpEntry{\n\t\t\tuser: user,\n\t\t\tline: C.GoString(&ent.ut_line[0]),\n\t\t\thost: C.GoString(&ent.ut_host[0]),\n\t\t\ttime: int64(ent.ut_tv.tv_sec),\n\t\t})\n\t}\n\treturn entries\n}\n\nfunc idleString(ttyName string) string {\n\tfi, err := sys.Stat(\"/dev/\" + ttyName)\n\tif err != nil {\n\t\treturn \"?\"\n\t}\n\tsecs := int(time.Since(fi.AccessTime).Seconds())\n\tif secs < 60 {\n\t\treturn \"\"\n\t}\n\tif secs < 24*60*60 {\n\t\treturn fmt.Sprintf(\"%02d:%02d\", secs/3600, (secs%3600)/60)\n\t}\n\treturn fmt.Sprintf(\"%dd\", secs/(24*60*60))\n}\n\nfunc formatLoginTime(sec int64) string {\n\treturn time.Unix(sec, 0).Format(\"2006-01-02 15:04\")\n}\n\nfunc lookupGecos(user string) string {\n\tcuser := C.CString(user)\n\tdefer C.free(unsafe.Pointer(cuser))\n\tpw := C.getpwnam(cuser)\n\tif pw == nil {\n\t\treturn \"???\"\n\t}\n\tgecos := C.GoString(pw.pw_gecos)\n\tname, _, _ := strings.Cut(gecos, \",\")\n\treturn name\n}\n","numLines":186,"startLine":1,"totalLines":186}}}
