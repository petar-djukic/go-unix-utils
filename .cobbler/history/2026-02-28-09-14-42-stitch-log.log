int64(st.Blksize),\n\t\tModTime: fi.ModTime(),\n\t\tSys:     fi,\n\t}, nil\n}\n\n// TerminalWidth returns the current terminal column count via TIOCGWINSZ ioctl.\n// Returns an error when stdout is not a terminal.\n// Per prd002-sys R1.1.\nfunc TerminalWidth() (int, error) {\n\tws, err := unix.IoctlGetWinsize(int(os.Stdout.Fd()), unix.TIOCGWINSZ)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"querying terminal width: %w\", err)\n\t}\n\treturn int(ws.Col), nil\n}\n\n// IsTerminal returns true when w is an *os.File whose file descriptor is a terminal.\n// Per prd002-sys R1.3.\nfunc IsTerminal(w io.Writer) bool {\n\tf, ok := w.(*os.File)\n\tif !ok {\n\t\treturn false\n\t}\n\t_, err := unix.IoctlGetWinsize(int(f.Fd()), unix.TIOCGWINSZ)\n\treturn err == nil\n}\n\n// InstallSIGPIPEHandler installs a SIGPIPE handler that exits 0 on broken pipe.\n// Per prd002-sys R3.1.\nfunc InstallSIGPIPEHandler() {\n\tc := make(chan os.Signal, 1)\n\tsignal.Notify(c, syscall.SIGPIPE)\n\tgo func() {\n\t\t<-c\n\t\tos.Exit(0)\n\t}()\n}\n\nvar (\n\tresizeMu        sync.Mutex\n\tresizeCallbacks  []func(width int)\n\tresizeInstalled  bool\n)\n\n// OnTerminalResize registers a callback invoked when the terminal is resized.\n// Per prd002-sys R4.1.\nfunc OnTerminalResize(callback func(width int)) {\n\tresizeMu.Lock()\n\tresizeCallbacks = append(resizeCallbacks, callback)\n\tneedInstall := !resizeInstalled\n\tresizeInstalled = true\n\tresizeMu.Unlock()\n\n\tif needInstall {\n\t\tc := make(chan os.Signal, 1)\n\t\tsignal.Notify(c, syscall.SIGWINCH)\n\t\tgo func() {\n\t\t\tfor range c {\n\t\t\t\twidth, err := TerminalWidth()\n\t\t\t\tif err != nil {\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tresizeMu.Lock()\n\t\t\t\tcbs := make([]func(int), len(resizeCallbacks))\n\t\t\t\tcopy(cbs, resizeCallbacks)\n\t\t\t\tresizeMu.Unlock()\n\t\t\t\tfor _, cb := range cbs {\n\t\t\t\t\tcb(width)\n\t\t\t\t}\n\t\t\t}\n\t\t}()\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_t