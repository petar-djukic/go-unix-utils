{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01LZ9QDe1tthU2mAbn7TL1fD","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01D7Nb4ThZYpYGxoktRxvQfY","name":"Write","input":{"file_path":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/generation-2026-02-27-21-48-32-21v/pkg/testutils/testutils.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides a differential testing harness for go-unix-utils.\n// Implements prd001-testutils.\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"testing\"\n\t\"time\"\n)\n\n// NormalizeFunc transforms raw output bytes for comparison.\n// Per prd001-testutils R1.4.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest defines a single differential test case.\n// Per prd001-testutils R1.1.\ntype DiffTest struct {\n\tName          string\n\tArgs          []string\n\tStdin         []byte\n\tEnv           []string\n\tExitCode      int\n\tNormalize     []func([]byte) []byte\n\tExpectedFiles map[string][]byte\n}\n\n// RunDiffTests runs each DiffTest as a named subtest comparing goBinary and refBinary.\n// Per prd001-testutils R2.1.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\n\tif _, err := exec.LookPath(refBinary); err != nil {\n\t\tt.Skipf(\"reference binary %s not found: %v\", refBinary, err)\n\t}\n\n\tfor _, test := range tests {\n\t\tt.Run(test.Name, func(t *testing.T) {\n\t\t\ttimeout := 10 * time.Second\n\n\t\t\trefOut, refErr, refExit := runBinary(t, refBinary, test, timeout)\n\t\t\tgoOut, goErr, goExit := runBinary(t, goBinary, test, timeout)\n\n\t\t\tfor _, norm := range test.Normalize {\n\t\t\t\trefOut = norm(refOut)\n\t\t\t\tgoOut = norm(goOut)\n\t\t\t\trefErr = norm(refErr)\n\t\t\t\tgoErr = norm(goErr)\n\t\t\t}\n\n\t\t\tif !bytes.Equal(refOut, goOut) {\n\t\t\t\tt.Fatalf(\"stdout mismatch\\nargs: %v\\nstdin: %q\\nref stdout:\\n%s\\ngo stdout:\\n%s\\nref stderr:\\n%s\\ngo stderr:\\n%s\\nref exit: %d\\ngo exit: %d\",\n\t\t\t\t\ttest.Args, truncateBytes(test.Stdin, 256),\n\t\t\t\t\trefOut, goOut, refErr, goErr, refExit, goExit)\n\t\t\t}\n\n\t\t\tif !bytes.Equal(refErr, goErr) {\n\t\t\t\tt.Fatalf(\"stderr mismatch\\nargs: %v\\nref stderr:\\n%s\\ngo stderr:\\n%s\",\n\t\t\t\t\ttest.Args, refErr, goErr)\n\t\t\t}\n\n\t\t\tif refExit != goExit {\n\t\t\t\tt.Fatalf(\"exit code mismatch\\nargs: %v\\nref exit: %d\\ngo exit: %d\",\n\t\t\t\t\ttest.Args, refExit, goExit)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc runBinary(t *testing.T, binary string, test DiffTest, timeout time.Duration) (stdout, stderr []byte, exitCode int) {\n\tt.Helper()\n\n\tcmd := exec.Command(binary, test.Args...)\n\n\tif test.Stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(test.Stdin)\n\t}\n\n\tif test.Env != nil {\n\t\tcmd.Env = test.Env\n\t} else {\n\t\tcmd.Env = os.Environ()\n\t}\n\n\tvar outBuf, errBuf bytes.Buffer\n\tcmd.Stdout = &outBuf\n\tcmd.Stderr = &errBuf\n\n\tif err := cmd.Start(); err != nil {\n\t\tt.Fatalf(\"failed to start %s: %v\", binary, err)\n\t}\n\n\tdone := make(chan error, 1)\n\tgo func() {\n\t\tdone <- cmd.Wait()\n\t}()\n\n\tselect {\n\tcase err := <-done:\n\t\tif err != nil {\n\t\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\t\texitCode = exitErr.ExitCode()\n\t\t\t} else {\n\t\t\t\tt.Fatalf(\"failed to run %s: %v\", binary, err)\n\t\t\t}\n\t\t}\n\tcase <-time.After(timeout):\n\t\t_ = cmd.Process.Kill() // best-effort cleanup\n\t\tt.Fatalf(\"binary %s timed out after %s\", binary, timeout)\n\t}\n\n\treturn outBuf.Bytes(), errBuf.Bytes(), exitCode\n}\n\nfunc truncateBytes(b []byte, maxLen int) []byte {\n\tif len(b) > maxLen {\n\t\treturn b[:maxLen]\n\t}\n\treturn b\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1516,"cache_read_input_tokens":108265,"cache_creation":{"ephemeral_5m_input_tokens":0,"e