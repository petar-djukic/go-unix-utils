ring{\"-d\", \"-p\", tmpdir},\n109\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n110\t\t\t\t},\n111\t\t\t})\n112\t\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n113\t\t})\n114\t\n115\t\tt.Run(\"directory_tmpdir_eq\", func(t *testing.T) {\n116\t\t\ttmpdir := t.TempDir()\n117\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n118\t\t\t\t{\n119\t\t\t\t\tName:      \"d_tmpdir_eq\",\n120\t\t\t\t\tArgs:      []string{\"-d\", \"--tmpdir=\" + tmpdir},\n121\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n122\t\t\t\t},\n123\t\t\t})\n124\t\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n125\t\t})\n126\t\n127\t\tt.Run(\"directory_tmpdir_no_value\", func(t *testing.T) {\n128\t\t\ttmpdir := t.TempDir()\n129\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n130\t\t\t\t{\n131\t\t\t\t\tName:      \"d_tmpdir_nv\",\n132\t\t\t\t\tArgs:      []string{\"-d\", \"--tmpdir\"},\n133\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n134\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n135\t\t\t\t},\n136\t\t\t})\n137\t\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n138\t\t})\n139\t\n140\t\tt.Run(\"p_flag_explicit_dir\", func(t *testing.T) {\n141\t\t\ttmpdir := t.TempDir()\n142\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n143\t\t\t\t{\n144\t\t\t\t\tName:      \"p_dir\",\n145\t\t\t\t\tArgs:      []string{\"-p\", tmpdir, \"myXXXXXX\"},\n146\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n147\t\t\t\t},\n148\t\t\t})\n149\t\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n150\t\t})\n151\t\n152\t\tt.Run(\"tmpdir_equals_dir\", func(t *testing.T) {\n153\t\t\ttmpdir := t.TempDir()\n154\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n155\t\t\t\t{\n156\t\t\t\t\tName:      \"tmpdir_eq\",\n157\t\t\t\t\tArgs:      []string{\"--tmpdir=\" + tmpdir, \"myXXXXXX\"},\n158\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n159\t\t\t\t},\n160\t\t\t})\n161\t\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n162\t\t})\n163\t\n164\t\tt.Run(\"tmpdir_no_value\", func(t *testing.T) {\n165\t\t\ttmpdir := t.TempDir()\n166\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n167\t\t\t\t{\n168\t\t\t\t\tName:      \"tmpdir_no_val\",\n169\t\t\t\t\tArgs:      []string{\"--tmpdir\", \"myXXXXXX\"},\n170\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n171\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n172\t\t\t\t},\n173\t\t\t})\n174\t\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n175\t\t})\n176\t\n177\t\tt.Run(\"suffix\", func(t *testing.T) {\n178\t\t\ttmpdir := t.TempDir()\n179\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n180\t\t\t\t{\n181\t\t\t\t\tName:      \"suffix_txt\",\n182\t\t\t\t\tArgs:      []string{\"--suffix=.txt\"},\n183\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n184\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n185\t\t\t\t},\n186\t\t\t})\n187\t\t\tverifySuffix(t, tmpdir, \".txt\")\n188\t\t})\n189\t\n190\t\tt.Run(\"suffix_with_dir\", func(t *testing.T) {\n191\t\t\ttmpdir := t.TempDir()\n192\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n193\t\t\t\t{\n194\t\t\t\t\tName:      \"suffix_p\",\n195\t\t\t\t\tArgs:      []string{\"-d\", \"-p\", tmpdir, \"--suffix=.d\", \"testXXXXXX\"},\n196\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"test\", 6)},\n197\t\t\t\t},\n198\t\t\t})\n199\t\t\tverifySuffix(t, tmpdir, \".d\")\n200\t\t\tverifyCreatedWithSuffix(t, tmpdir, \"test\", 6, \".d\", 0o700, true)\n201\t\t})\n202\t\n203\t\tt.Run(\"t_legacy_mode\", func(t *testing.T) {\n204\t\t\ttmpdir := t.TempDir()\n205\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n206\t\t\t\t{\n207\t\t\t\t\tName:      \"t_flag\",\n208\t\t\t\t\tArgs:      []string{\"-t\", \"myXXXXXX\"},\n209\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n210\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n211\t\t\t\t},\n212\t\t\t})\n213\t\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n214\t\t})\n215\t\n216\t\tt.Run(\"error_suffix_slash\", func(t *testing.T) {\n217\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n218\t\t\t\t{\n219\t\t\t\t\tName:      \"suffix_slash\",\n220\t\t\t\t\tArgs:      []string{\"--suffix=/bad\"},\n221\t\t\t\t\tExitCode:  1,\n222\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n223\t\t\t\t},\n224\t\t\t})\n225\t\t})\n226\t\n227\t\tt.Run(\"error_too_few_xs\", func(t *testing.T) {\n228\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n229\t\t\t\t{\n230\t\t\t\t\tName:      \"two_xs\",\n231\t\t\t\t\tArgs:      []string{\"fooXX\"},\n232\t\t\t\t\tExitCode:  1,\n233\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n234\t\t\t\t},\n235\t\t\t\t{\n236\t\t\t\t\tName:      \"one_x\",\n237\t\t\t\t\tArgs:      []string{\"fooX\"},\n238\t\t\t\t\tExitCode:  1,\n239\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n240\t\t\t\t},\n241\t\t\t\t{\n242\t\t\t\t\tName:      \"no_xs\",\n243\t\t\t\t\tArgs:      []string{\"foo\"},\n244\t\t\t\t\tExitCode:  1,\n245\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n246\t\t\t\t},\n247\t\t\t})\n248\t\t})\n249\t\n250\t\tt.Run(\"error_too_many_templates\", func(t *testing.T) {\n251\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n252\t\t\t\t{\n253\t\t\t\t\tName:      \"two_templates\",\n254\t\t\t\t\tArgs:      []string{\"fooXXX\", \"barXXX\"},\n255\t\t\t\t\tExitCode:  1,\n256\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n257\t\t\t\t},\n258\t\t\t})\n259\t\t})\n260\t}\n261\t\n262\tfunc makeTemplateNormalizer(prefix string, xCount int) testutils.NormalizeFunc {\n263\t\tpattern := regexp.MustCompile(\n264\t\t\tregexp.QuoteMeta(prefix) + `[A-Za-z0-9]{` + fmt.Sprintf(\"%d\", xCount) + `}`,\n265\t\t)\n266\t\treplacement := []byte(prefix + strings.Repeat(\"X\", xCount))\n267\t\treturn func(b []byte) []byte {\n268\t\t\treturn pattern.ReplaceAll(b, replacement)\n269\t\t}\n270\t}\n271\t\n272\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mktemp\\b`)\n273\t\n274\tfunc normalizeBinaryName(b []byte) []byte {\n275\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mktemp\"))\n276\t}\n277\t\n278\tfunc verifyCreated(t *testing.T, dir, prefix string, suffixLen int, mode os.FileMode, expectDir bool) {\n279\t\tt.Helper()\n280\t\tentries, err := os.ReadDir(dir)\n281\t\tif err != nil {\n282\t\t\tt.Fatalf(\"readdir: %v\", err)\n283\t\t}\n284\t\tfound := 0\n285\t\tfor _, e := range entries {\n286\t\t\tname := e.Name()\n287\t\t\tif !strings.HasPrefix(name, prefix) {\n288\t\t\t\tcontinue\n289\t\t\t}\n290\t\t\tfound++\n291\t\t\tsuffix := name[len(prefix):]\n292\t\t\tif len(suffix) != suffixLen {\n293\t\t\t\tt.Errorf(\"entry %q: expected %d random chars, got %d\", name, suffixLen, len(suffix))\n294\t\t\t}\n295\t\t\tfor _, c := range suffix {\n296\t\t\t\tif !isAlphanumeric(c) {\n297\t\t\t\t\tt.Errorf(\"entry %q: non-alphanumeric char %q in suffix\", name, c)\n298\t\t\t\t}\n299\t\t\t}\n300\t\t\tpath := filepath.Join(dir, name)\n301\t\t\tinfo, err := os.Lstat(path)\n302\t\t\tif err != nil {\n303\t\t\t\tt.Fatalf(\"stat %q: %v\", name, err)\n304\t\t\t}\n305\t\t\tif expectDir {\n306\t\t\t\tif !info.IsDir() {\n307\t\t\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n308\t\t\t\t}\n309\t\t\t} else {\n310\t\t\t\tif !info.Mode().IsRegular() {\n311\t\t\t\t\tt.Errorf(\"entry %q: expected regular file\", name)\n312\t\t\t\t}\n313\t\t\t}\n314\t\t\tif perm := info.Mode().Perm(); perm != mode {\n315\t\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n316\t\t\t}\n317\t\t}\n318\t\tif found == 0 {\n319\t\t\tt.Fatal(\"no matching entries created in temp dir\")\n320\t\t}\n321\t}\n322\t\n323\tfunc verifyCreatedWithSuffix(\n324\t\tt *testing.T, dir, prefix string, randomLen int, fileSuffix string,\n325\t\tmode os.FileMode, expectDir bool,\n326\t) {\n327\t\tt.Helper()\n328\t\tentries, err := os.ReadDir(dir)\n329\t\tif err != nil {\n330\t\t\tt.Fatalf(\"readdir: %v\", err)\n331\t\t}\n332\t\tfound := 0\n333\t\tfor _, e := range entries {\n334\t\t\tname := e.Name()\n335\t\t\tif !strings.HasPrefix(name, prefix) || !strings.HasSuffix(name, fileSuffix) {\n336\t\t\t\tcontinue\n337\t\t\t}\n338\t\t\tfound++\n339\t\t\tmiddle := name[len(prefix) : len(name)-len(fileSuffix)]\n340\t\t\tif len(middle) != randomLen {\n341\t\t\t\tt.Errorf(\"entry %q: expected %d random chars, got %d\", name, randomLen, len(middle))\n342\t\t\t}\n343\t\t\tpath := filepath.Join(dir, name)\n344\t\t\tinfo, err := os.Lstat(path)\n345\t\t\tif err != nil {\n346\t\t\t\tt.Fatalf(\"stat %q: %v\", name, err)\n347\t\t\t}\n348\t\t\tif expectDir && !info.IsDir() {\n349\t\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n350\t\t\t}\n351\t\t\tif perm := info.Mode().Perm(); perm != mode {\n352\t\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n353\t\t\t}\n354\t\t}\n355\t\tif found == 0 {\n356\t\t\tt.Fatal(\"no matching entries created in temp dir\")\n357\t\t}\n358\t}\n359\t\n360\tfunc verifySuffix(t *testing.T, dir, expectedSuffix string) {\n361\t\tt.Helper()\n362\t\tentries, err := os.ReadDir(dir)\n363\t\tif err != nil {\n364\t\t\tt.Fatalf(\"readdir: %v\", err)\n365\t\t}\n366\t\tfor _, e := range entries {\n367\t\t\tif strings.HasSuffix(e.Name(), expectedSuffix) {\n368\t\t\t\treturn\n369\t\t\t}\n370\t\t}\n371\t\tt.Fatalf(\"no entry with suffix %q found in %s\", expectedSuffix, dir)\n372\t}\n373\t\n374\tfunc isAlphanumeric(c rune) bool {\n375\t\treturn (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')\n376\t}\n377\t"}]},"parent_tool_use_id":null,"session_id":"7ee43029-eddb-436b-9bcb-30302bda44ca","uuid":"8f919e73-2431-4fdb-b215-073b9e7913e9","timestamp":"2026-05-20T12:29:58.730Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5348/cmd/mktemp/mktemp_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd036-mktemp R4.1, R4.2, R4.3, R4.4.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gmktemp\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gmktemp not found\")\n\t}\n\n\tt.Run(\"default_no_args\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"default\",\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o600, false)\n\t})\n\n\tt.Run(\"custom_template\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttemplate := filepath.Join(tmpdir, \"myfileXXXXXX\")\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"custom\",\n\t\t\t\tArgs:      []string{template},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"myfile\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"myfile\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"custom_template_min_xs\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttemplate := filepath.Join(tmpdir, \"fooXXX\")\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"min_xs\",\n\t\t\t\tArgs:      []string{template},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"foo\", 3)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"foo\", 3, 0o600, false)\n\t})\n\n\tt.Run(\"directory_short_flag\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_flag\",\n\t\t\t\tArgs:      []string{\"-d\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"directory_long_flag\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"directory_flag\",\n\t\t\t\tArgs:      []string{\"--directory\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"directory_custom_template\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttemplate := filepath.Join(tmpdir, \"myXXXXXX\")\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_custom\",\n\t\t\t\tArgs:      []string{\"-d\", template},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o700, true)\n\t})\n\n\tt.Run(\"directory_p_flag\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_p\",\n\t\t\t\tArgs:      []string{\"-d\", \"-p\", tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"directory_tmpdir_eq\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_tmpdir_eq\",\n\t\t\t\tArgs:      []string{\"-d\", \"--tmpdir=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"directory_tmpdir_no_value\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_tmpdir_nv\",\n\t\t\t\tArgs:      []string{\"-d\", \"--tmpdir\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"p_flag_explicit_dir\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"p_dir\",\n\t\t\t\tArgs:      []string{\"-p\", tmpdir, \"myXXXXXX\"},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"tmpdir_equals_dir\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"tmpdir_eq\",\n\t\t\t\tArgs:      []string{\"--tmpdir=\" + tmpdir, \"myXXXXXX\"},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"tmpdir_no_value\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"tmpdir_no_val\",\n\t\t\t\tArgs:      []string{\"--tmpdir\", \"myXXXXXX\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"suffix\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"suffix_txt\",\n\t\t\t\tArgs:      []string{\"--suffix=.txt\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifySuffix(t, tmpdir, \".txt\")\n\t})\n\n\tt.Run(\"suffix_with_dir\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"suffix_p\",\n\t\t\t\tArgs:      []string{\"-d\", \"-p\", tmpdir, \"--suffix=.d\", \"testXXXXXX\"},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"test\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifySuffix(t, tmpdir, \".d\")\n\t\tverifyCreatedWithSuffix(t, tmpdir, \"test\", 6, \".d\", 0o700, true)\n\t})\n\n\tt.Run(\"t_legacy_mode\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"t_flag\",\n\t\t\t\tArgs:      []string{\"-t\", \"myXXXXXX\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"error_suffix_slash\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"suffix_slash\",\n\t\t\t\tArgs:      []string{\"--suffix=/bad\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"error_too_few_xs\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"two_xs\",\n\t\t\t\tArgs:      []string{\"fooXX\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t\t{\n\t\t\t\tName:      \"one_x\",\n\t\t\t\tArgs:      []string{\"fooX\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t\t{\n\t\t\t\tName:      \"no_xs\",\n\t\t\t\tArgs:      []string{\"foo\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"error_too_many_templates\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"two_templates\",\n\t\t\t\tArgs:      []string{\"fooXXX\", \"barXXX\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n}\n\nfunc makeTemplateNormalizer(prefix string, xCount int) testutils.NormalizeFunc {\n\tpattern := regexp.MustCompile(\n\t\tregexp.QuoteMeta(prefix) + `[A-Za-z0-9]{` + fmt.Sprintf(\"%d\", xCount) + `}`,\n\t)\n\treplacement := []byte(prefix + strings.Repeat(\"X\", xCount))\n\treturn func(b []byte) []byte {\n\t\treturn pattern.ReplaceAll(b, replacement)\n\t}\n}\n\nvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mktemp\\b`)\n\nfunc normalizeBinaryName(b []byte) []byte {\n\treturn binaryNameRe.ReplaceAll(b, []byte(\"mktemp\"))\n}\n\nfunc verifyCreated(t *testing.T, dir, prefix string, suffixLen int, mode os.FileMode, expectDir bool) {\n\tt.Helper()\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"readdir: %v\", err)\n\t}\n\tfound := 0\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif !strings.HasPrefix(name, prefix) {\n\t\t\tcontinue\n\t\t}\n\t\tfound++\n\t\tsuffix := name[len(prefix):]\n\t\tif len(suffix) != suffixLen {\n\t\t\tt.Errorf(\"entry %q: expected %d random chars, got %d\", name, suffixLen, len(suffix))\n\t\t}\n\t\tfor _, c := range suffix {\n\t\t\tif !isAlphanumeric(c) {\n\t\t\t\tt.Errorf(\"entry %q: non-alphanumeric char %q in suffix\", name, c)\n\t\t\t}\n\t\t}\n\t\tpath := filepath.Join(dir, name)\n\t\tinfo, err := os.Lstat(path)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"stat %q: %v\", name, err)\n\t\t}\n\t\tif expectDir {\n\t\t\tif !info.IsDir() {\n\t\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n\t\t\t}\n\t\t} else {\n\t\t\tif !info.Mode().IsRegular() {\n\t\t\t\tt.Errorf(\"entry %q: expected regular file\", name)\n\t\t\t}\n\t\t}\n\t\tif perm := info.Mode().Perm(); perm != mode {\n\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n\t\t}\n\t}\n\tif found == 0 {\n\t\tt.Fatal(\"no matching entries created in temp dir\")\n\t}\n}\n\nfunc verifyCreatedWithSuffix(\n\tt *testing.T, dir, prefix string, randomLen int, fileSuffix string,\n\tmode os.FileMode, expectDir bool,\n) {\n\tt.Helper()\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"readdir: %v\", err)\n\t}\n\tfound := 0\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif !strings.HasPrefix(name, prefix) || !strings.HasSuffix(name, fileSuffix) {\n\t\t\tcontinue\n\t\t}\n\t\tfound++\n\t\tmiddle := name[len(prefix) : len(name)-len(fileSuffix)]\n\t\tif len(middle) != randomLen {\n\t\t\tt.Errorf(\"entry %q: expected %d random chars, got %d\", name, randomLen, len(middle))\n\t\t}\n\t\tpath := filepath.Join(dir, name)\n\t\tinfo, err := os.Lstat(path)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"stat %q: %v\", name, err)\n\t\t}\n\t\tif expectDir && !info.IsDir() {\n\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n\t\t}\n\t\tif perm := info.Mode().Perm(); perm != mode {\n\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n\t\t}\n\t}\n\tif found == 0 {\n\t\tt.Fatal(\"no matching entries created in temp dir\")\n\t}\n}\n\nfunc verifySuffix(t *testing.T, dir, expectedSuffix string) {\n\tt.Helper()\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"readdir: %v\", err)\n\t}\n\tfor _, e := range entries {\n\t\tif strings.HasSuffix(e.Name(), expectedSuffix) {\n\t\t\treturn\n\t\t}\n\t}\n\tt.Fatalf(\"no entry with suffix %q found in %s\", expectedSuffix, dir)\n}\n\nfunc isAlphanumeric(c rune) bool {\n\treturn (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')\n}\n","numLines":377,"startLine":1,"totalLines":377}}}
