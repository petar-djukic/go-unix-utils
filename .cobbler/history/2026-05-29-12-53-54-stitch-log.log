0\t\t\tr = f\n81\t\t\tfilename = path\n82\t\t\tmodTime = info.ModTime()\n83\t\t}\n84\t\treturn paginate(r, filename, modTime, w)\n85\t}\n86\t\n87\tfunc paginate(r io.Reader, filename string, modTime time.Time, w *bufio.Writer) error {\n88\t\tscanner := bufio.NewScanner(r)\n89\t\tdate := modTime.Format(\"2006-01-02 15:04\")\n90\t\tpageNum := 1\n91\t\tfor {\n92\t\t\tlines, eof := readBody(scanner, bodySize)\n93\t\t\tif len(lines) == 0 && eof {\n94\t\t\t\tbreak\n95\t\t\t}\n96\t\t\tif err := writeHeader(w, date, filename, pageNum); err != nil {\n97\t\t\t\treturn err\n98\t\t\t}\n99\t\t\tif err := writeBody(w, lines); err != nil {\n100\t\t\t\treturn err\n101\t\t\t}\n102\t\t\tif err := writeFooter(w); err != nil {\n103\t\t\t\treturn err\n104\t\t\t}\n105\t\t\tpageNum++\n106\t\t\tif eof {\n107\t\t\t\tbreak\n108\t\t\t}\n109\t\t}\n110\t\treturn scanner.Err()\n111\t}\n112\t\n113\tfunc readBody(scanner *bufio.Scanner, n int) ([]string, bool) {\n114\t\tvar lines []string\n115\t\tfor range n {\n116\t\t\tif !scanner.Scan() {\n117\t\t\t\treturn lines, true\n118\t\t\t}\n119\t\t\tlines = append(lines, scanner.Text())\n120\t\t}\n121\t\treturn lines, false\n122\t}\n123\t\n124\tfunc writeHeader(w *bufio.Writer, date, filename string, pageNum int) error {\n125\t\tif _, err := fmt.Fprint(w, \"\\n\\n\"); err != nil {\n126\t\t\treturn err\n127\t\t}\n128\t\tif _, err := fmt.Fprintf(w, \"%s  %s  Page %d\\n\", date, filename, pageNum); err != nil {\n129\t\t\treturn err\n130\t\t}\n131\t\t_, err := fmt.Fprint(w, \"\\n\\n\")\n132\t\treturn err\n133\t}\n134\t\n135\tfunc writeBody(w *bufio.Writer, lines []string) error {\n136\t\tfor _, line := range lines {\n137\t\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", line); err != nil {\n138\t\t\t\treturn err\n139\t\t\t}\n140\t\t}\n141\t\tfor range bodySize - len(lines) {\n142\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n143\t\t\t\treturn err\n144\t\t\t}\n145\t\t}\n146\t\treturn nil\n147\t}\n148\t\n149\tfunc writeFooter(w *bufio.Writer) error {\n150\