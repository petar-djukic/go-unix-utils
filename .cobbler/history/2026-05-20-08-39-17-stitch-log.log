{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M8P65pwJ2Fn3oaCpABts2b","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd036-mktemp R1.1, R1.2, R1.3, R1.4, R1.5, R2.1, R2.2, R2.3,\n5\t// R3.1, R3.2, R3.3, R3.4.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"crypto/rand\"\n10\t\t\"fmt\"\n11\t\t\"math/big\"\n12\t\t\"os\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst defaultTemplate = \"tmp.XXXXXXXXXX\"\n19\tconst charset = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\"\n20\t\n21\ttype options struct {\n22\t\tdirectory bool\n23\t\tparentDir string\n24\t\tuseTmpdir bool\n25\t\tsuffix    string\n26\t}\n27\t\n28\tfunc main() {\n29\t\tsys.InstallSIGPIPEHandler()\n30\t\n31\t\topts, template, useDefaultDir, err := parseArgs(os.Args[1:])\n32\t\tif err != nil {\n33\t\t\tfmt.Fprintf(os.Stderr, \"mktemp: %s\\n\", err)\n34\t\t\tfmt.Fprintf(os.Stderr, \"Try 'mktemp --help' for more information.\\n\")\n35\t\t\tos.Exit(1)\n36\t\t}\n37\t\n38\t\tif err := run(opts, template, useDefaultDir); err != nil {\n39\t\t\tfmt.Fprintf(os.Stderr, \"mktemp: %s\\n\", err)\n40\t\t\tos.Exit(1)\n41\t\t}\n42\t}\n43\t\n44\tfunc parseArgs(args []string) (options, string, bool, error) {\n45\t\tvar opts options\n46\t\tvar templates []string\n47\t\n48\t\ti := 0\n49\t\tfor i < len(args) {\n50\t\t\targ := args[i]\n51\t\t\tif arg == \"--\" {\n52\t\t\t\ttemplates = append(templates, args[i+1:]...)\n53\t\t\t\tbreak\n54\t\t\t}\n55\t\t\tif strings.HasPrefix(arg, \"--\") {\n56\t\t\t\tconsumed, err := parseLongFlag(arg, args[i+1:], &opts)\n57\t\t\t\tif err != nil {\n58\t\t\t\t\treturn opts, \"\", false, err\n59\t\t\t\t}\n60\t\t\t\ti += consumed\n61\t\t\t\tcontinue\n62\t\t\t}\n63\t\t\tif len(arg) > 1 && arg[0] == '-' {\n64\t\t\t\tconsumed, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n65\t\t\t\tif err != nil {\n66\t\t\t\t\treturn opts, \"\", false, err\n67\t\t\t\t}\n68\t\t\t\ti += 1 + consumed\n69\t\t\t\tcontinue\n70\t\t\t}\n71\t\t\ttemplates = append(templates, arg)\n72\t\t\ti++\n73\t\t}\n74\t\n75\t\tswitch len(templates) {\n76\t\tcase 0:\n77\t\t\treturn opts, defaultTemplate, true, nil\n78\t\tcase 1:\n79\t\t\treturn opts, templates[0], false, nil\n80\t\tdefault:\n81\t\t\treturn opts, \"\", false, fmt.Errorf(\"too many templates\")\n82\t\t}\n83\t}\n84\t\n85\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n86\t\tswitch {\n87\t\tcase flag == \"--directory\":\n88\t\t\topts.directory = true\n89\t\t\treturn 1, nil\n90\t\tcase flag == \"--tmpdir\":\n91\t\t\topts.useTmpdir = true\n92\t\t\treturn 1, nil\n93\t\tcase strings.HasPrefix(flag, \"--tmpdir=\"):\n94\t\t\topts.parentDir = flag[len(\"--tmpdir=\"):]\n95\t\t\treturn 1, nil\n96\t\tcase flag == \"--suffix\":\n97\t\t\tif len(remaining) == 0 {\n98\t\t\t\treturn 0, fmt.Errorf(\"option '--suffix' requires an argument\")\n99\t\t\t}\n100\t\t\topts.suffix = remaining[0]\n101\t\t\treturn 2, nil\n102\t\tcase strings.HasPrefix(flag, \"--suffix=\"):\n103\t\t\topts.suffix = flag[len(\"--suffix=\"):]\n104\t\t\treturn 1, nil\n105\t\tdefault:\n106\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n107\t\t}\n108\t}\n109\t\n110\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n111\t\tconsumed := 0\n112\t\tfor j := range len(flags) {\n113\t\t\tswitch flags[j] {\n114\t\t\tcase 'd':\n115\t\t\t\topts.directory = true\n116\t\t\tcase 't':\n117\t\t\t\topts.useTmpdir = true\n118\t\t\tcase 'p':\n119\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n120\t\t\t\t\topts.parentDir = rest\n121\t\t\t\t} else if len(remaining) > consumed {\n122\t\t\t\t\topts.parentDir = remaining[consumed]\n123\t\t\t\t\tconsumed++\n124\t\t\t\t} else {\n125\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'p'\")\n126\t\t\t\t}\n127\t\t\t\treturn consumed, nil\n128\t\t\tdefault:\n129\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n130\t\t\t}\n131\t\t}\n132\t\treturn consumed, nil\n133\t}\n134\t\n135\tfunc run(opts options, template string, useDefaultDir bool) error {\n136\t\tif opts.suffix != \"\" && strings.Contains(opts.suffix, \"/\") {\n137\t\t\treturn fmt.Errorf(\"invalid suffix '%s', contains directory separator\", opts.suffix)\n138\t\t}\n139\t\n140\t\tfullTemplate := resolveTemplate(opts, template, useDefaultDir)\n141\t\n142\t\txCount := countTrailingX(fullTemplate)\n143\t\tif xCount < 3 {\n144\t\t\treturn fmt.Errorf(\"too few X's in template '%s'\", fullTemplate)\n145\t\t}\n146\t\n147\t\tprefix := fullTemplate[:len(fullTemplate)-xCount]\n148\t\n149\t\tfor range 100 {\n150\t\t\tsuffix, err := randomString(xCount)\n151\t\t\tif err != nil {\n152\t\t\t\treturn err\n153\t\t\t}\n154\t\t\tpath := prefix + suffix + opts.suffix\n155\t\t\tif opts.directory {\n156\t\t\t\terr = os.Mkdir(path, 0o700)\n157\t\t\t} else {\n158\t\t\t\tvar fd *os.File\n159\t\t\t\tfd, err = os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)\n160\t\t\t\tif err == nil {\n161\t\t\t\t\tfd.Close()\n162\t\t\t\t}\n163\t\t\t}\n164\t\t\tif err != nil {\n165\t\t\t\tif os.IsExist(err) {\n166\t\t\t\t\tcontinue\n167\t\t\t\t}\n168\t\t\t\treturn fmt.Errorf(\"failed to create %s via template '%s': %s\",\n169\t\t\t\t\tentityKind(opts.directory), fullTemplate, unwrapErr(err))\n170\t\t\t}\n171\t\t\tfmt.Println(path)\n172\t\t\treturn nil\n173\t\t}\n174\t\n175\t\treturn fmt.Errorf(\"failed to create %s via template '%s': too many collisions\",\n176\t\t\tentityKind(opts.directory), fullTemplate)\n177\t}\n178\t\n179\tfunc resolveTemplate(opts options, template string, useDefaultDir bool) string {\n180\t\tif opts.parentDir != \"\" {\n181\t\t\treturn opts.parentDir + \"/\" + template\n182\t\t}\n183\t\tif useDefaultDir || opts.useTmpdir {\n184\t\t\tdir := os.Getenv(\"TMPDIR\")\n185\t\t\tif dir == \"\" {\n186\t\t\t\tdir = \"/tmp\"\n187\t\t\t}\n188\t\t\treturn dir + \"/\" + template\n189\t\t}\n190\t\treturn template\n191\t}\n192\t\n193\tfunc entityKind(isDir bool) string {\n194\t\tif isDir {\n195\t\t\treturn \"directory\"\n196\t\t}\n197\t\treturn \"file\"\n198\t}\n199\t\n200\tfunc countTrailingX(s string) int {\n201\t\tcount := 0\n202\t\tfor i := len(s) - 1; i >= 0; i-- {\n203\t\t\tif s[i] != 'X' {\n204\t\t\t\tbreak\n205\t\t\t}\n206\t\t\tcount++\n207\t\t}\n208\t\treturn count\n209\t}\n210\t\n211\tfunc randomString(n int) (string, error) {\n212\t\tb := make([]byte, n)\n213\t\tmax := big.NewInt(int64(len(charset)))\n214\t\tfor i := range b {\n215\t\t\tidx, err := rand.Int(rand.Reader, max)\n216\t\t\tif err != nil {\n217\t\t\t\treturn \"\", err\n218\t\t\t}\n219\t\t\tb[i] = charset[idx.Int64()]\n220\t\t}\n221\t\treturn string(b), nil\n222\t}\n223\t\n224\tfunc unwrapErr(err error) string {\n225\t\tpe, ok := err.(*os.PathError)\n226\t\tif !ok {\n227\t\t\treturn err.Error()\n228\t\t}\n229\t\treturn pe.Err.Error()\n230\t}\n231\t"}]},"parent_tool_use_id":null,"session_id":"f4e8139c-6d6d-4e2e-b5cc-154a8b8d25d3","uuid":"364b7b2f-12c0-4290-9d08-9ab66d4a4a04","timestamp":"2026-05-20T12:39:39.905Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5350/cmd/mktemp/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd036-mktemp R1.1, R1.2, R1.3, R1.4, R1.5, R2.1, R2.2, R2.3,\n// R3.1, R3.2, R3.3, R3.4.\npackage main\n\nimport (\n\t\"crypto/rand\"\n\t\"fmt\"\n\t\"math/big\"\n\t\"os\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst defaultTemplate = \"tmp.XXXXXXXXXX\"\nconst charset = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\"\n\ntype options struct {\n\tdirectory bool\n\tparentDir string\n\tuseTmpdir bool\n\tsuffix    string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, template, useDefaultDir, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"mktemp: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'mktemp --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tif err := run(opts, template, useDefaultDir); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"mktemp: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) (options, string, bool, error) {\n\tvar opts options\n\tvar templates []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ttemplates = append(templates, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tconsumed, err := parseLongFlag(arg, args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, \"\", false, err\n\t\t\t}\n\t\t\ti += consumed\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tconsumed, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, \"\", false, err\n\t\t\t}\n\t\t\ti += 1 + consumed\n\t\t\tcontinue\n\t\t}\n\t\ttemplates = append(templates, arg)\n\t\ti++\n\t}\n\n\tswitch len(templates) {\n\tcase 0:\n\t\treturn opts, defaultTemplate, true, nil\n\tcase 1:\n\t\treturn opts, templates[0], false, nil\n\tdefault:\n\t\treturn opts, \"\", false, fmt.Errorf(\"too many templates\")\n\t}\n}\n\nfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--directory\":\n\t\topts.directory = true\n\t\treturn 1, nil\n\tcase flag == \"--tmpdir\":\n\t\topts.useTmpdir = true\n\t\treturn 1, nil\n\tcase strings.HasPrefix(flag, \"--tmpdir=\"):\n\t\topts.parentDir = flag[len(\"--tmpdir=\"):]\n\t\treturn 1, nil\n\tcase flag == \"--suffix\":\n\t\tif len(remaining) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '--suffix' requires an argument\")\n\t\t}\n\t\topts.suffix = remaining[0]\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--suffix=\"):\n\t\topts.suffix = flag[len(\"--suffix=\"):]\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := range len(flags) {\n\t\tswitch flags[j] {\n\t\tcase 'd':\n\t\t\topts.directory = true\n\t\tcase 't':\n\t\t\topts.useTmpdir = true\n\t\tcase 'p':\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\topts.parentDir = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\topts.parentDir = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'p'\")\n\t\t\t}\n\t\t\treturn consumed, nil\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn consumed, nil\n}\n\nfunc run(opts options, template string, useDefaultDir bool) error {\n\tif opts.suffix != \"\" && strings.Contains(opts.suffix, \"/\") {\n\t\treturn fmt.Errorf(\"invalid suffix '%s', contains directory separator\", opts.suffix)\n\t}\n\n\tfullTemplate := resolveTemplate(opts, template, useDefaultDir)\n\n\txCount := countTrailingX(fullTemplate)\n\tif xCount < 3 {\n\t\treturn fmt.Errorf(\"too few X's in template '%s'\", fullTemplate)\n\t}\n\n\tprefix := fullTemplate[:len(fullTemplate)-xCount]\n\n\tfor range 100 {\n\t\tsuffix, err := randomString(xCount)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tpath := prefix + suffix + opts.suffix\n\t\tif opts.directory {\n\t\t\terr = os.Mkdir(path, 0o700)\n\t\t} else {\n\t\t\tvar fd *os.File\n\t\t\tfd, err = os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)\n\t\t\tif err == nil {\n\t\t\t\tfd.Close()\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\tif os.IsExist(err) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\treturn fmt.Errorf(\"failed to create %s via template '%s': %s\",\n\t\t\t\tentityKind(opts.directory), fullTemplate, unwrapErr(err))\n\t\t}\n\t\tfmt.Println(path)\n\t\treturn nil\n\t}\n\n\treturn fmt.Errorf(\"failed to create %s via template '%s': too many collisions\",\n\t\tentityKind(opts.directory), fullTemplate)\n}\n\nfunc resolveTemplate(opts options, template string, useDefaultDir bool) string {\n\tif opts.parentDir != \"\" {\n\t\treturn opts.parentDir + \"/\" + template\n\t}\n\tif useDefaultDir || opts.useTmpdir {\n\t\tdir := os.Getenv(\"TMPDIR\")\n\t\tif dir == \"\" {\n\t\t\tdir = \"/tmp\"\n\t\t}\n\t\treturn dir + \"/\" + template\n\t}\n\treturn template\n}\n\nfunc entityKind(isDir bool) string {\n\tif isDir {\n\t\treturn \"directory\"\n\t}\n\treturn \"file\"\n}\n\nfunc countTrailingX(s string) int {\n\tcount := 0\n\tfor i := len(s) - 1; i >= 0; i-- {\n\t\tif s[i] != 'X' {\n\t\t\tbreak\n\t\t}\n\t\tcount++\n\t}\n\treturn count\n}\n\nfunc randomString(n int) (string, error) {\n\tb := make([]byte, n)\n\tmax := big.NewInt(int64(len(charset)))\n\tfor i := range b {\n\t\tidx, err := rand.Int(rand.Reader, max)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tb[i] = charset[idx.Int64()]\n\t}\n\treturn string(b), nil\n}\n\nfunc unwrapErr(err error) string {\n\tpe, ok := err.(*os.PathError)\n\tif !ok {\n\t\treturn err.Error()\n\t}\n\treturn pe.Err.Error()\n}\n","numLines":231,"startLine":1,"totalLines":231}}}
