{\n138\t\t\t\t\t\topts.targetDir = rest\n139\t\t\t\t\t} else {\n140\t\t\t\t\t\ti++\n141\t\t\t\t\t\tif i < len(args) {\n142\t\t\t\t\t\t\topts.targetDir = args[i]\n143\t\t\t\t\t\t}\n144\t\t\t\t\t}\n145\t\t\t\t\tj = len(chars)\n146\t\t\t\t}\n147\t\t\t}\n148\t\t}\n149\t\treturn files, opts\n150\t}\n151\t\n152\tfunc moveSingle(src, dest string, opts options) int {\n153\t\tif !opts.noTargetDir {\n154\t\t\tinfo, err := os.Stat(dest)\n155\t\t\tif err == nil && info.IsDir() {\n156\t\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n157\t\t\t}\n158\t\t}\n159\t\tswitch checkOverwrite(dest, opts.mode) {\n160\t\tcase owSkip:\n161\t\t\treturn 0\n162\t\tcase owSkipError:\n163\t\t\treturn 1\n164\t\t}\n165\t\trenamed, err := moveFile(src, dest)\n166\t\tif err != nil {\n167\t\t\tfmt.Fprintf(os.Stderr, \"mv: %s\\n\", err)\n168\t\t\treturn 1\n169\t\t}\n170\t\tif opts.verbose {\n171\t\t\tprintVerbose(src, dest, renamed)\n172\t\t}\n173\t\treturn 0\n174\t}\n175\t\n176\tfunc moveMultiple(sources []string, dest string, opts options) int {\n177\t\tinfo, err := os.Stat(dest)\n178\t\tif err != nil || !info.IsDir() {\n179\t\t\tfmt.Fprintf(os.Stderr, \"mv: target '%s': not a directory\\n\", dest)\n180\t\t\treturn 1\n181\t\t}\n182\t\tcode := 0\n183\t\tfor _, src := range sources {\n184\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n185\t\t\tswitch checkOverwrite(target, opts.mode) {\n186\t\t\tcase owSkip:\n187\t\t\t\tcontinue\n188\t\t\tcase owSkipError:\n189\t\t\t\tcode = 1\n190\t\t\t\tcontinue\n191\t\t\t}\n192\t\t\trenamed, err := moveFile(src, target)\n193\t\t\tif err != nil {\n194\t\t\t\tfmt.Fprintf(os.Stderr, \"mv: %s\\n\", err)\n195\t\t\t\tcode = 1\n196\t\t\t\tcontinue\n197\t\t\t}\n198\t\t\tif opts.verbose {\n199\t\t\t\tprintVerbose(src, target, renamed)\n200\t\t\t}\n201\t\t}\n202\t\treturn code\n203\t}\n204\t\n205\ttype overwriteAction int\n206\t\n207\tconst (\n208\t\towProceed   overwriteAction = iota\n209\t\towSkip\n210\t\towSkipError\n211\t)\n212\t\n213\tfunc checkOverwrite(dest string, mode overwriteMode) overwriteAction {\n214\t\tif _, err := os.Lstat(dest); err != nil {\n215\t\t\treturn owProceed\n216\t\t}\n217\t\tswitch mode {\n218\t\tcase modeNoClobber:\n219\t\t\treturn owSkip\n220\t\tcase modeInteractive:\n221\t\t\tif promptOverwrite(dest) {\n222\t\t\t\treturn owProceed\n223\t\t\t}\n224\t\t\treturn owSkipError\n225\t\t}\n226\t\treturn owProceed\n227\t}\n228\t\n229\tfunc promptOverwrite(dest string) bool {\n230\t\tfmt.Fprintf(os.Stderr, \"mv: overwrite '%s'? \", dest)\n231\t\tif !stdinScanner.Scan() {\n232\t\t\treturn false\n233\t\t}\n234\t\tline := stdinScanner.Text()\n235\t\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n236\t}\n237\t\n238\tfunc moveFile(src, dest string) (bool, error) {\n239\t\tsrcInfo, err := os.Lstat(src)\n240\t\tif err != nil {\n241\t\t\treturn false, fmtPathErr(\"cannot stat\", src, err)\n242\t\t}\n243\t\terr = os.Rename(src, dest)\n244\t\tif err == nil {\n245\t\t\treturn true, nil\n246\t\t}\n247\t\tif isCrossDevice(err) {\n248\t\t\treturn false, crossDeviceMove(src, dest)\n249\t\t}\n250\t\tif srcInfo.IsDir() && isDirExistsErr(err) {\n251\t\t\tif rmErr := os.Remove(dest); rmErr == nil {\n252\t\t\t\tif err2 := os.Rename(src, dest); err2 == nil {\n253\t\t\t\t\treturn true, nil\n254\t\t\t\t}\n255\t\t\t}\n256\t\t}\n257\t\tif !srcInfo.IsDir() {\n258\t\t\tif di, derr := os.Lstat(dest); derr == nil && di.IsDir() {\n259\t\t\t\treturn false, fmt.Errorf(\n260\t\t\t\t\t\"cannot overwrite directory '%s' with non-directory '%s'\", dest, src)\n261\t\t\t}\n262\t\t}\n263\t\treturn false, fmtMoveErr(src, dest, err)\n264\t}\n265\t\n266\tfunc printVerbose(src, dest string, renamed bool) {\n267\t\tif renamed {\n268\t\t\tfmt.Printf(\"renamed '%s' -> '%s'\\n\", src, dest)\n269\t\t} else {\n270\t\t\tfmt.Printf(\"'%s' -> '%s'\\n\", src, dest)\n271\t\t}\n272\t}\n273\t\n274\tfunc isCrossDevice(err error) bool {\n275\t\tif linkErr, ok := errors.AsType[*os.LinkError](err); ok {\n276\t\t\treturn errors.Is(linkErr.Err, syscall.EXDEV)\n277\t\t}\n278\t\treturn false\n279\t}\n280\t\n281\tfunc isDirExistsErr(err error) bool {\n282\t\tif linkErr, ok := errors.AsType[*os.LinkError](err); ok {\n283\t\t\treturn errors.Is(linkErr.Err, syscall.EEXIST) ||\n284\t\t\t\terrors.Is(linkErr.Err, syscall.ENOTEMPTY)\n285\t\t}\n286\t\treturn false\n287\t}\n288\t\n289\tfunc crossDeviceMove(src, dest string) error {\n290\t\tif err := copyTree(src, dest); err != nil {\n291\t\t\treturn err\n292\t\t}\n293\t\tif err := os.RemoveAll(src); err != nil {\n294\t\t\treturn fmtPathErr(\"cannot remove\", src, err)\n295\t\t}\n296\t\treturn nil\n297\t}\n298\t\n299\tfunc copyTree(src, dest string) error {\n300\t\tinfo, err := os.Lstat(src)\n301\t\tif err != nil {\n302\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n303\t\t}\n304\t\tif info.IsDir() {\n305\t\t\treturn copyDir(src, dest, info)\n306\t\t}\n307\t\tif info.Mode()&os.ModeSymlink != 0 {\n308\t\t\treturn copySymlink(src, dest)\n309\t\t}\n310\t\treturn copyRegular(src, dest, info.Mode())\n311\t}\n312\t\n313\tfunc copyDir(src, dest string, info os.FileInfo) error {\n314\t\tif err := os.Mkdir(dest, info.Mode().Perm()); err != nil {\n315\t\t\treturn fmtPathErr(\"cannot create directory\", dest, err)\n316\t\t}\n317\t\tentries, err := os.ReadDir(src)\n318\t\tif err != nil {\n319\t\t\treturn fmtPathErr(\"cannot read directory\", src, err)\n320\t\t}\n321\t\tfor _, e := range entries {\n322\t\t\ts := filepath.Join(src, e.Name())\n323\t\t\td := filepath.Join(dest, e.Name())\n324\t\t\tif err := copyTree(s, d); err != nil {\n325\t\t\t\treturn err\n326\t\t\t}\n327\t\t}\n328\t\treturn nil\n329\t}\n330\t\n331\tfunc copySymlink(src, dest string) error {\n332\t\ttarget, err := os.Readlink(src)\n333\t\tif err != nil {\n334\t\t\treturn fmtPathErr(\"cannot readlink\", src, err)\n335\t\t}\n336\t\treturn os.Symlink(target, dest)\n337\t}\n338\t\n339\tfunc copyRegular(src, dest string, mode os.FileMode) error {\n340\t\tin, err := os.Open(src)\n341\t\tif err != nil {\n342\t\t\treturn fmtPathErr(\"cannot open\", src, err)\n343\t\t}\n344\t\tdefer in.Close()\n345\t\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n346\t\tif err != nil {\n347\t\t\treturn fmtPathErr(\"cannot create\", dest, err)\n348\t\t}\n349\t\tdefer out.Close()\n350\t\tif _, err := io.Copy(out, in); err != nil {\n351\t\t\treturn err\n352\t\t}\n353\t\treturn out.Close()\n354\t}\n355\t\n356\tfunc fmtPathErr(verb, path string, err error) error {\n357\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n358\t\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n359\t\t}\n360\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n361\t}\n362\t\n363\tfunc fmtMoveErr(src, dest string, err error) error {\n364\t\tif le, ok := errors.AsType[*os.LinkError](err); ok {\n365\t\t\treturn fmt.Errorf(\"cannot move '%s' to '%s': %s\", src, dest, le.Err)\n366\t\t}\n367\t\treturn fmt.Errorf(\"cannot move '%s' to '%s': %s\", src, dest, err)\n368\t}\n369\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01Ue8cbbAapwv8A1sCLeSouv","session_id":"d3781725-c8fe-478c-afba-9a79c345d7fe","uuid":"75a547a3-5605-41fd-b7e5-84dcfb52ab2e","timestamp":"2026-05-24T01:14:05.924Z"}
