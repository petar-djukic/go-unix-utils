{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018vTmoP88mjcLadjx6PUqv9","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/cp implements srd056-cp: copy files and directories.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"path/filepath\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\ttype overwriteMode int\n20\t\n21\tconst (\n22\t\towDefault   overwriteMode = iota\n23\t\towAskUser                 // -i\n24\t\towNoClobber               // -n\n25\t)\n26\t\n27\ttype derefMode int\n28\t\n29\tconst (\n30\t\tderefDefault derefMode = iota\n31\t\tderefAlways\n32\t\tderefNever\n33\t)\n34\t\n35\tvar (\n36\t\towMode      overwriteMode\n37\t\tunlinkDest  bool\n38\t\trecursive   bool\n39\t\tderef       derefMode\n40\t\tstdinReader = bufio.NewReader(os.Stdin)\n41\t\terrDeclined = errors.New(\"declined\")\n42\t\terrPartial         = errors.New(\"partial failure\")\n43\t\tpreserveMode       bool\n44\t\tpreserveOwnership  bool\n45\t\tpreserveTimestamps bool\n46\t\tverbose            bool\n47\t\ttargetDir          string\n48\t)\n49\t\n50\tfunc main() {\n51\t\tsys.InstallSIGPIPEHandler()\n52\t\targs := parseFlags(os.Args[1:])\n53\t\tif targetDir != \"\" {\n54\t\t\tif len(args) == 0 {\n55\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n56\t\t\t\tos.Exit(1)\n57\t\t\t}\n58\t\t\tcode := copyMultiple(args, targetDir)\n59\t\t\tif code != 0 {\n60\t\t\t\tos.Exit(code)\n61\t\t\t}\n62\t\t\treturn\n63\t\t}\n64\t\tif len(args) == 0 {\n65\t\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n66\t\t\tos.Exit(1)\n67\t\t}\n68\t\tif len(args) == 1 {\n69\t\t\tfmt.Fprintf(os.Stderr,\n70\t\t\t\t\"cp: missing destination file operand after '%s'\\n\", args[0])\n71\t\t\tos.Exit(1)\n72\t\t}\n73\t\tdest := args[len(args)-1]\n74\t\tsources := args[:len(args)-1]\n75\t\tcode := 0\n76\t\tif len(sources) > 1 {\n77\t\t\tcode = copyMultiple(sources, dest)\n78\t\t} else {\n79\t\t\tcode = copySingle(sources[0], dest)\n80\t\t}\n81\t\tif code != 0 {\n82\t\t\tos.Exit(code)\n83\t\t}\n84\t}\n85\t\n86\tfunc parseFlags(args []string) []string {\n87\t\tvar files []string\n88\t\tendOfFlags := false\n89\t\tfor i := 0; i < len(args); i++ {\n90\t\t\targ := args[i]\n91\t\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n92\t\t\t\tfiles = append(files, arg)\n93\t\t\t\tcontinue\n94\t\t\t}\n95\t\t\tif arg == \"--\" {\n96\t\t\t\tendOfFlags = true\n97\t\t\t\tcontinue\n98\t\t\t}\n99\t\t\tif strings.HasPrefix(arg, \"--\") {\n100\t\t\t\tapplyLongFlag(arg[2:])\n101\t\t\t\tcontinue\n102\t\t\t}\n103\t\t\trest := arg[1:]\n104\t\t\tfor j, c := range rest {\n105\t\t\t\tif c == 't' {\n106\t\t\t\t\tsuffix := rest[j+1:]\n107\t\t\t\t\tif suffix != \"\" {\n108\t\t\t\t\t\ttargetDir = suffix\n109\t\t\t\t\t} else if i+1 < len(args) {\n110\t\t\t\t\t\ti++\n111\t\t\t\t\t\ttargetDir = args[i]\n112\t\t\t\t\t}\n113\t\t\t\t\tbreak\n114\t\t\t\t}\n115\t\t\t\tapplyFlag(c)\n116\t\t\t}\n117\t\t}\n118\t\treturn files\n119\t}\n120\t\n121\tfunc applyFlag(c rune) {\n122\t\tswitch c {\n123\t\tcase 'f':\n124\t\t\towMode = owDefault\n125\t\t\tunlinkDest = true\n126\t\tcase 'i':\n127\t\t\towMode = owAskUser\n128\t\t\tunlinkDest = false\n129\t\tcase 'n':\n130\t\t\towMode = owNoClobber\n131\t\tcase 'r', 'R':\n132\t\t\trecursive = true\n133\t\tcase 'L':\n134\t\t\tderef = derefAlways\n135\t\tcase 'P':\n136\t\t\tderef = derefNever\n137\t\tcase 'p':\n138\t\t\tpreserveMode = true\n139\t\t\tpreserveOwnership = true\n140\t\t\tpreserveTimestamps = true\n141\t\tcase 'a':\n142\t\t\tapplyArchive()\n143\t\tcase 'v':\n144\t\t\tverbose = true\n145\t\t}\n146\t}\n147\t\n148\tfunc applyLongFlag(name string) {\n149\t\tif attr, ok := strings.CutPrefix(name, \"preserve=\"); ok {\n150\t\t\tparsePreserve(attr)\n151\t\t\treturn\n152\t\t}\n153\t\tif dir, ok := strings.CutPrefix(name, \"target-directory=\"); ok {\n154\t\t\ttargetDir = dir\n155\t\t\treturn\n156\t\t}\n157\t\tswitch name {\n158\t\tcase \"force\":\n159\t\t\towMode = owDefault\n160\t\t\tunlinkDest = true\n161\t\tcase \"interactive\":\n162\t\t\towMode = owAskUser\n163\t\t\tunlinkDest = false\n164\t\tcase \"no-clobber\":\n165\t\t\towMode = owNoClobber\n166\t\tcase \"recursive\":\n167\t\t\trecursive = true\n168\t\tcase \"dereference\":\n169\t\t\tderef = derefAlways\n170\t\tcase \"no-dereference\":\n171\t\t\tderef = derefNever\n172\t\tcase \"preserve\":\n173\t\t\tparsePreserve(\"mode,ownership,timestamps\")\n174\t\tcase \"archive\":\n175\t\t\tapplyArchive()\n176\t\tcase \"verbose\":\n177\t\t\tverbose = true\n178\t\t}\n179\t}\n180\t\n181\tfunc applyArchive() {\n182\t\trecursive = true\n183\t\tderef = derefNever\n184\t\tpreserveMode = true\n185\t\tpreserveOwnership = true\n186\t\tpreserveTimestamps = true\n187\t}\n188\t\n189\tfunc parsePreserve(attrList string) {\n190\t\tfor attr := range strings.SplitSeq(attrList, \",\") {\n191\t\t\tswitch attr {\n192\t\t\tcase \"mode\":\n193\t\t\t\tpreserveMode = true\n194\t\t\tcase \"ownership\":\n195\t\t\t\tpreserveOwnership = true\n196\t\t\tcase \"timestamps\":\n197\t\t\t\tpreserveTimestamps = true\n198\t\t\tcase \"all\":\n199\t\t\t\tpreserveMode = true\n200\t\t\t\tpreserveOwnership = true\n201\t\t\t\tpreserveTimestamps = true\n202\t\t\t}\n203\t\t}\n204\t}\n205\t\n206\tfunc shouldDeref() bool {\n207\t\tswitch deref {\n208\t\tcase derefAlways:\n209\t\t\treturn true\n210\t\tcase derefNever:\n211\t\t\treturn false\n212\t\tdefault:\n213\t\t\treturn !recursive\n214\t\t}\n215\t}\n216\t\n217\tfunc statSource(path string) (os.FileInfo, error) {\n218\t\tif shouldDeref() {\n219\t\t\treturn os.Stat(path)\n220\t\t}\n221\t\treturn os.Lstat(path)\n222\t}\n223\t\n224\tfunc copySingle(src, dest string) int {\n225\t\tinfo, err := os.Stat(dest)\n226\t\tif err == nil && info.IsDir() {\n227\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n228\t\t}\n229\t\tif err := copyFile(src, dest); err != nil {\n230\t\t\tif err != errDeclined && err != errPartial {\n231\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n232\t\t\t}\n233\t\t\treturn 1\n234\t\t}\n235\t\treturn 0\n236\t}\n237\t\n238\tfunc copyMultiple(sources []string, dest string) int {\n239\t\tinfo, err := os.Stat(dest)\n240\t\tif err != nil || !info.IsDir() {\n241\t\t\tfmt.Fprintf(os.Stderr, \"cp: target '%s': not a directory\\n\", dest)\n242\t\t\treturn 1\n243\t\t}\n244\t\tcode := 0\n245\t\tfor _, src := range sources {\n246\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n247\t\t\tif err := copyFile(src, target); err != nil {\n248\t\t\t\tif err != errDeclined && err != errPartial {\n249\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n250\t\t\t\t}\n251\t\t\t\tcode = 1\n252\t\t\t}\n253\t\t}\n254\t\treturn code\n255\t}\n256\t\n257\tfunc copyFile(src, dest string) error {\n258\t\tsrcInfo, err := statSource(src)\n259\t\tif err != nil {\n260\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n261\t\t}\n262\t\tif srcInfo.IsDir() {\n263\t\t\tif !recursive {\n264\t\t\t\treturn fmt.Errorf(\"-r not specified; omitting directory '%s'\", src)\n265\t\t\t}\n266\t\t\treturn copyDir(src, dest)\n267\t\t}\n268\t\tisLink := srcInfo.Mode()&os.ModeSymlink != 0\n269\t\tif destInfo, err := os.Stat(dest); err == nil {\n270\t\t\tif !isLink && os.SameFile(srcInfo, destInfo) {\n271\t\t\t\treturn fmt.Errorf(\"'%s' and '%s' are the same file\", src, dest)\n272\t\t\t}\n273\t\t\tswitch owMode {\n274\t\t\tcase owNoClobber:\n275\t\t\t\treturn nil\n276\t\t\tcase owAskUser:\n277\t\t\t\tif !confirmOverwrite(dest) {\n278\t\t\t\t\treturn errDeclined\n279\t\t\t\t}\n280\t\t\t}\n281\t\t}\n282\t\tif isLink {\n283\t\t\treturn copyLink(src, dest)\n284\t\t}\n285\t\treturn doCopy(src, dest, srcInfo.Mode())\n286\t}\n287\t\n288\tfunc copyDir(src, dest string) error {\n289\t\tsrcInfo, err := os.Stat(src)\n290\t\tif err != nil {\n291\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n292\t\t}\n293\t\tif err := os.Mkdir