t}\n353\t\tif err := out.Close(); err != nil {\n354\t\t\treturn err\n355\t\t}\n356\t\tprintVerbose(src, dest)\n357\t\treturn preserveAttrs(src, dest)\n358\t}\n359\t\n360\tfunc confirmOverwrite(dest string) bool {\n361\t\tfmt.Fprintf(os.Stderr, \"cp: overwrite '%s'? \", dest)\n362\t\tline, _ := stdinReader.ReadString('\\n')\n363\t\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n364\t}\n365\t\n366\tfunc fmtPathErr(verb, path string, err error) error {\n367\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n368\t\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n369\t\t}\n370\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n371\t}\n372\t\n373\tfunc preserveAttrs(src, dest string) error {\n374\t\tif !preserveMode && !preserveOwnership && !preserveTimestamps {\n375\t\t\treturn nil\n376\t\t}\n377\t\tfi, err := sys.Lstat(src)\n378\t\tif err != nil {\n379\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n380\t\t}\n381\t\tisLink := fi.Mode&os.ModeSymlink != 0\n382\t\tif preserveMode && !isLink {\n383\t\t\tperm := fi.Mode & (os.ModePerm | os.ModeSetuid | os.ModeSetgid | os.ModeSticky)\n384\t\t\tif err := os.Chmod(dest, perm); err != nil {\n385\t\t\t\treturn fmtPathErr(\"preserving permissions for\", dest, err)\n386\t\t\t}\n387\t\t}\n388\t\tif preserveTimestamps && !isLink {\n389\t\t\tif err := os.Chtimes(dest, fi.AccessTime, fi.ModTime); err != nil {\n390\t\t\t\treturn fmtPathErr(\"preserving times for\", dest, err)\n391\t\t\t}\n392\t\t}\n393\t\tif preserveOwnership {\n394\t\t\tif err := os.Lchown(dest, int(fi.Uid), int(fi.Gid)); err != nil {\n395\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\",\n396\t\t\t\t\tfmtPathErr(\"preserving ownership for\", dest, err))\n397\t\t\t}\n398\t\t}\n399\t\treturn nil\n400\t}\n401\t\n402\tfunc printVerbose(src, dest string) {\n403\t\tif verbose {\n404\t\t\tfmt.Printf(\"'%s' -> '%s'\\n\", src, dest)\n405\t\t}\n406\t}\n407\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be c