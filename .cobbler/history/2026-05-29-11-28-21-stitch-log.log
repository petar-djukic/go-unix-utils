{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PoTySKcYbvPKb3rpcsj25T","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd105-stty R1.1.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"strings\"\n12\t\n13\t\t\"golang.org/x/sys/unix\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst helpText = `Usage: stty [-F DEVICE | --file=DEVICE] [SETTING]...\n19\t  or:  stty [-F DEVICE | --file=DEVICE] [-a|--all]\n20\t  or:  stty [-F DEVICE | --file=DEVICE] [-g|--save]\n21\tPrint or change terminal line settings.\n22\t\n23\t      --help     display this help and exit\n24\t      --version  output version information and exit\n25\t`\n26\t\n27\tconst versionText = `stty (go-unix-utils) dev\n28\t`\n29\t\n30\ttype flagDef struct {\n31\t\tname string\n32\t\tmask uint64\n33\t\tsane int8 // 1=should be set in sane mode, -1=should be unset, 0=no check\n34\t}\n35\t\n36\ttype ccDef struct {\n37\t\tname    string\n38\t\tindex   int\n39\t\tsaneVal uint8\n40\t\tisNum   bool\n41\t}\n42\t\n43\tconst vdisable = 0xff\n44\t\n45\tvar iflags = []flagDef{\n46\t\t{\"ignbrk\", unix.IGNBRK, -1},\n47\t\t{\"brkint\", unix.BRKINT, 1},\n48\t\t{\"ignpar\", unix.IGNPAR, -1},\n49\t\t{\"parmrk\", unix.PARMRK, -1},\n50\t\t{\"inpck\", unix.INPCK, -1},\n51\t\t{\"istrip\", unix.ISTRIP, -1},\n52\t\t{\"inlcr\", unix.INLCR, -1},\n53\t\t{\"igncr\", unix.IGNCR, -1},\n54\t\t{\"icrnl\", unix.ICRNL, 1},\n55\t\t{\"ixon\", unix.IXON, 1},\n56\t\t{\"ixoff\", unix.IXOFF, -1},\n57\t\t{\"ixany\", unix.IXANY, -1},\n58\t\t{\"imaxbel\", unix.IMAXBEL, 1},\n59\t}\n60\t\n61\tvar oflags = []flagDef{\n62\t\t{\"opost\", unix.OPOST, 1},\n63\t\t{\"onlcr\", unix.ONLCR, 1},\n64\t\t{\"ocrnl\", unix.OCRNL, -1},\n65\t\t{\"onocr\", unix.ONOCR, -1},\n66\t\t{\"onlret\", unix.ONLRET, -1},\n67\t}\n68\t\n69\tvar cflags = []flagDef{\n70\t\t{\"cstopb\", unix.CSTOPB, 0},\n71\t\t{\"cread\", unix.CREAD, 1},\n72\t\t{\"parenb\", unix.PARENB, 0},\n73\t\t{\"parodd\", unix.PARODD, 0},\n74\t\t{\"hupcl\", unix.HUPCL, 0},\n75\t\t{\"clocal\", unix.CLOCAL, 0},\n76\t}\n77\t\n78\tvar lflags = []flagDef{\n79\t\t{\"isig\", unix.ISIG, 1},\n80\t\t{\"icanon\", unix.ICANON, 1},\n81\t\t{\"echo\", unix.ECHO, 1},\n82\t\t{\"echoe\", unix.ECHOE, 1},\n83\t\t{\"echok\", unix.ECHOK, 1},\n84\t\t{\"echonl\", unix.ECHONL, -1},\n85\t\t{\"noflsh\", unix.NOFLSH, -1},\n86\t\t{\"tostop\", unix.TOSTOP, -1},\n87\t\t{\"echoctl\", unix.ECHOCTL, 1},\n88\t\t{\"echoprt\", unix.ECHOPRT, -1},\n89\t\t{\"echoke\", unix.ECHOKE, 1},\n90\t\t{\"flusho\", unix.FLUSHO, -1},\n91\t\t{\"pendin\", unix.PENDIN, -1},\n92\t\t{\"iexten\", unix.IEXTEN, 1},\n93\t}\n94\t\n95\tvar controlChars = []ccDef{\n96\t\t{\"intr\", unix.VINTR, 0x03, false},\n97\t\t{\"quit\", unix.VQUIT, 0x1c, false},\n98\t\t{\"erase\", unix.VERASE, 0x7f, false},\n99\t\t{\"kill\", unix.VKILL, 0x15, false},\n100\t\t{\"eof\", unix.VEOF, 0x04, false},\n101\t\t{\"eol\", unix.VEOL, vdisable, false},\n102\t\t{\"eol2\", unix.VEOL2, vdisable, false},\n103\t\t{\"start\", unix.VSTART, 0x11, false},\n104\t\t{\"stop\", unix.VSTOP, 0x13, false},\n105\t\t{\"susp\", unix.VSUSP, 0x1a, false},\n106\t\t{\"dsusp\", unix.VDSUSP, 0x19, false},\n107\t\t{\"reprint\", unix.VREPRINT, 0x12, false},\n108\t\t{\"werase\", unix.VWERASE, 0x17, false},\n109\t\t{\"lnext\", unix.VLNEXT, 0x16, false},\n110\t\t{\"discard\", unix.VDISCARD, 0x0f, false},\n111\t\t{\"status\", unix.VSTATUS, 0x14, false},\n112\t\t{\"min\", unix.VMIN, 1, true},\n113\t\t{\"time\", unix.VTIME, 0, true},\n114\t}\n115\t\n116\tfunc main() {\n117\t\tsys.InstallSIGPIPEHandler()\n118\t\tparseArgs(os.Args[1:])\n119\t\n120\t\tfd := int(os.Stdin.Fd())\n121\t\tt, err := unix.IoctlGetTermios(fd, unix.TIOCGETA)\n122\t\tif err != nil {\n123\t\t\tfmt.Fprintf(os.Stderr, \"stty: 'standard input': %v\\n\", err)\n124\t\t\tos.Exit(1)\n125\t\t}\n126\t\n127\t\trows, cols := getWinSize(fd)\n128\t\tif err := printDefaultDisplay(os.Stdout, t, rows, cols); err != nil {\n129\t\t\tos.Exit(1)\n130\t\t}\n131\t}\n132\t\n133\tfunc parseArgs(args []string) {\n134\t\tfor _, arg := range args {\n135\t\t\tswitch arg {\n136\t\t\tcase \"--help\":\n137\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n138\t\t\t\tos.Exit(0)\n139\t\t\tcase \"--version\":\n140\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n141\t\t\t\tos.Exit(0)\n142\t\t\tdefault:\n143\t\t\t\tfmt.Fprintf(os.Stderr, \"stty: invalid argument '%s'\\n\", arg)\n144\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'stty --help' for more information.\")\n145\t\t\t\tos.Exit(1)\n146\t\t\t}\n147\t\t}\n148\t}\n149\t\n150\tfunc getWinSize(fd int) (int, int) {\n151\t\tws, err := unix.IoctlGetWinsize(fd, unix.TIOCGWINSZ)\n152\t\tif err != nil {\n153\t\t\treturn 0, 0\n154\t\t}\n155\t\treturn int(ws.Row), int(ws.Col)\n156\t}\n157\t\n158\tfunc printDefaultDisplay(w io.Writer, t *unix.Termios, rows, cols int) error {\n159\t\tif _, err := fmt.Fprint(w, speedLine(t, rows, cols)); err != nil {\n160\t\t\treturn err\n161\t\t}\n162\t\n163\t\tvar changed []string\n164\t\tif cs := csizeStr(t.Cflag); cs != \"\" {\n165\t\t\tchanged = append(changed, cs)\n166\t\t}\n167\t\tchanged = append(changed, diffFlags(t.Cflag, cflags)...)\n168\t\tchanged = append(changed, diffFlags(t.Iflag, iflags)...)\n169\t\tchanged = append(changed, diffFlags(t.Oflag, oflags)...)\n170\t\tchanged = append(changed, diffFlags(t.Lflag, lflags)...)\n171\t\tchanged = append(changed, diffCC(t.Cc[:])...)\n172\t\n173\t\tif len(changed) > 0 {\n174\t\t\tif _, err := fmt.Fprintln(w, strings.Join(changed, \" \")); err != nil {\n175\t\t\t\treturn err\n176\t\t\t}\n177\t\t}\n178\t\treturn nil\n179\t}\n180\t\n181\tfunc speedLine(t *unix.Termios, rows, cols int) string {\n182\t\tif t.Ispeed != t.Ospeed && t.Ispeed != 0 {\n183\t\t\treturn fmt.Sprintf(\"ispeed %d baud; ospeed %d baud; rows %d; columns %d;\\n\",\n184\t\t\t\tt.Ispeed, t.Ospeed, rows, cols)\n185\t\t}\n186\t\treturn fmt.Sprintf(\"speed %d baud; rows %d; columns %d;\\n\", t.Ospeed, rows, cols)\n187\t}\n188\t\n189\tfunc csizeStr(cflag uint64) string {\n190\t\tswitch cflag & unix.CSIZE {\n191\t\tcase unix.CS5:\n192\t\t\treturn \"cs5\"\n193\t\tcase unix.CS6:\n194\t\t\treturn \"cs6\"\n195\t\tcase unix.CS7:\n196\t\t\treturn \"cs7\"\n197\t\tdefault:\n198\t\t\treturn \"\"\n199\t\t}\n200\t}\n201\t\n202\tfunc diffFlags(current uint64, flags []flagDef) []string {\n203\t\tvar result []string\n204\t\tfor _, f := range flags {\n205\t\t\tif f.sane == 0 {\n206\t\t\t\tcontinue\n207\t\t\t}\n208\t\t\tset := current&f.mask != 0\n209\t\t\tif f.sane == 1 && !set {\n210\t\t\t\tresult = append(result, \"-\"+f.name)\n211\t\t\t} else if f.sane == -1 && set {\n212\t\t\t\tresult = append(result, f.name)\n213\t\t\t}\n214\t\t}\n215\t\treturn result\n216\t}\n217\t\n218\tfunc diffCC(cc []uint8) []string {\n219\t\tvar result []string\n220\t\tfor _, c := range controlChars {\n221\t\t\tif cc[c.index] != c.saneVal {\n222\t\t\t\tresult = append(result, c.name+\" = \"+formatCC(cc[c.index], c.isNum)+\";\")\n223\t\t\t}\n224\t\t}\n225\t\treturn result\n226\t}\n227\t\n228\tfunc formatCC(val uint8, isNum bool) string {\n229\t\tif isNum {\n230\t\t\treturn fmt.Sprintf(\"%d\", val)\n231\t\t}\n232\t\tif val == vdisable {\n233\t\t\treturn \"<undef>\"\n234\t\t}\n235\t\tif val == 0x7f {\n236\t\t\treturn \"^?\"\n237\t\t}\n238\t\tif val < 0x20 {\n239\t\t\treturn \"^\" + string(rune(val+'@'))\n240\t\t}\n241\t\treturn string(rune(val))\n242\t}\n243\t"}]},"parent_tool_use_id":null,"session_id":"134b6010-6885-4f08-8e6f-190349c7e60e","uuid":"58baaa72-e7c9-4c02-9e8b-ff9af0f7611e","timestamp":"2026-05-29T15:28:39.666Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5644/cmd/stty/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd105-stty R1.1.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\n\t\"golang.org/x/sys/unix\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: stty [-F DEVICE | --file=DEVICE] [SETTING]...\n  or:  stty [-F DEVICE | --file=DEVICE] [-a|--all]\n  or:  stty [-F DEVICE | --file=DEVICE] [-g|--save]\nPrint or change terminal line settings.\n\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `stty (go-unix-utils) dev\n`\n\ntype flagDef struct {\n\tname string\n\tmask uint64\n\tsane int8 // 1=should be set in sane mode, -1=should be unset, 0=no check\n}\n\ntype ccDef struct {\n\tname    string\n\tindex   int\n\tsaneVal uint8\n\tisNum   bool\n}\n\nconst vdisable = 0xff\n\nvar iflags = []flagDef{\n\t{\"ignbrk\", unix.IGNBRK, -1},\n\t{\"brkint\", unix.BRKINT, 1},\n\t{\"ignpar\", unix.IGNPAR, -1},\n\t{\"parmrk\", unix.PARMRK, -1},\n\t{\"inpck\", unix.INPCK, -1},\n\t{\"istrip\", unix.ISTRIP, -1},\n\t{\"inlcr\", unix.INLCR, -1},\n\t{\"igncr\", unix.IGNCR, -1},\n\t{\"icrnl\", unix.ICRNL, 1},\n\t{\"ixon\", unix.IXON, 1},\n\t{\"ixoff\", unix.IXOFF, -1},\n\t{\"ixany\", unix.IXANY, -1},\n\t{\"imaxbel\", unix.IMAXBEL, 1},\n}\n\nvar oflags = []flagDef{\n\t{\"opost\", unix.OPOST, 1},\n\t{\"onlcr\", unix.ONLCR, 1},\n\t{\"ocrnl\", unix.OCRNL, -1},\n\t{\"onocr\", unix.ONOCR, -1},\n\t{\"onlret\", unix.ONLRET, -1},\n}\n\nvar cflags = []flagDef{\n\t{\"cstopb\", unix.CSTOPB, 0},\n\t{\"cread\", unix.CREAD, 1},\n\t{\"parenb\", unix.PARENB, 0},\n\t{\"parodd\", unix.PARODD, 0},\n\t{\"hupcl\", unix.HUPCL, 0},\n\t{\"clocal\", unix.CLOCAL, 0},\n}\n\nvar lflags = []flagDef{\n\t{\"isig\", unix.ISIG, 1},\n\t{\"icanon\", unix.ICANON, 1},\n\t{\"echo\", unix.ECHO, 1},\n\t{\"echoe\", unix.ECHOE, 1},\n\t{\"echok\", unix.ECHOK, 1},\n\t{\"echonl\", unix.ECHONL, -1},\n\t{\"noflsh\", unix.NOFLSH, -1},\n\t{\"tostop\", unix.TOSTOP, -1},\n\t{\"echoctl\", unix.ECHOCTL, 1},\n\t{\"echoprt\", unix.ECHOPRT, -1},\n\t{\"echoke\", unix.ECHOKE, 1},\n\t{\"flusho\", unix.FLUSHO, -1},\n\t{\"pendin\", unix.PENDIN, -1},\n\t{\"iexten\", unix.IEXTEN, 1},\n}\n\nvar controlChars = []ccDef{\n\t{\"intr\", unix.VINTR, 0x03, false},\n\t{\"quit\", unix.VQUIT, 0x1c, false},\n\t{\"erase\", unix.VERASE, 0x7f, false},\n\t{\"kill\", unix.VKILL, 0x15, false},\n\t{\"eof\", unix.VEOF, 0x04, false},\n\t{\"eol\", unix.VEOL, vdisable, false},\n\t{\"eol2\", unix.VEOL2, vdisable, false},\n\t{\"start\", unix.VSTART, 0x11, false},\n\t{\"stop\", unix.VSTOP, 0x13, false},\n\t{\"susp\", unix.VSUSP, 0x1a, false},\n\t{\"dsusp\", unix.VDSUSP, 0x19, false},\n\t{\"reprint\", unix.VREPRINT, 0x12, false},\n\t{\"werase\", unix.VWERASE, 0x17, false},\n\t{\"lnext\", unix.VLNEXT, 0x16, false},\n\t{\"discard\", unix.VDISCARD, 0x0f, false},\n\t{\"status\", unix.VSTATUS, 0x14, false},\n\t{\"min\", unix.VMIN, 1, true},\n\t{\"time\", unix.VTIME, 0, true},\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tparseArgs(os.Args[1:])\n\n\tfd := int(os.Stdin.Fd())\n\tt, err := unix.IoctlGetTermios(fd, unix.TIOCGETA)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"stty: 'standard input': %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\trows, cols := getWinSize(fd)\n\tif err := printDefaultDisplay(os.Stdout, t, rows, cols); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) {\n\tfor _, arg := range args {\n\t\tswitch arg {\n\t\tcase \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"stty: invalid argument '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'stty --help' for more information.\")\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n}\n\nfunc getWinSize(fd int) (int, int) {\n\tws, err := unix.IoctlGetWinsize(fd, unix.TIOCGWINSZ)\n\tif err != nil {\n\t\treturn 0, 0\n\t}\n\treturn int(ws.Row), int(ws.Col)\n}\n\nfunc printDefaultDisplay(w io.Writer, t *unix.Termios, rows, cols int) error {\n\tif _, err := fmt.Fprint(w, speedLine(t, rows, cols)); err != nil {\n\t\treturn err\n\t}\n\n\tvar changed []string\n\tif cs := csizeStr(t.Cflag); cs != \"\" {\n\t\tchanged = append(changed, cs)\n\t}\n\tchanged = append(changed, diffFlags(t.Cflag, cflags)...)\n\tchanged = append(changed, diffFlags(t.Iflag, iflags)...)\n\tchanged = append(changed, diffFlags(t.Oflag, oflags)...)\n\tchanged = append(changed, diffFlags(t.Lflag, lflags)...)\n\tchanged = append(changed, diffCC(t.Cc[:])...)\n\n\tif len(changed) > 0 {\n\t\tif _, err := fmt.Fprintln(w, strings.Join(changed, \" \")); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc speedLine(t *unix.Termios, rows, cols int) string {\n\tif t.Ispeed != t.Ospeed && t.Ispeed != 0 {\n\t\treturn fmt.Sprintf(\"ispeed %d baud; ospeed %d baud; rows %d; columns %d;\\n\",\n\t\t\tt.Ispeed, t.Ospeed, rows, cols)\n\t}\n\treturn fmt.Sprintf(\"speed %d baud; rows %d; columns %d;\\n\", t.Ospeed, rows, cols)\n}\n\nfunc csizeStr(cflag uint64) string {\n\tswitch cflag & unix.CSIZE {\n\tcase unix.CS5:\n\t\treturn \"cs5\"\n\tcase unix.CS6:\n\t\treturn \"cs6\"\n\tcase unix.CS7:\n\t\treturn \"cs7\"\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\nfunc diffFlags(current uint64, flags []flagDef) []string {\n\tvar result []string\n\tfor _, f := range flags {\n\t\tif f.sane == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tset := current&f.mask != 0\n\t\tif f.sane == 1 && !set {\n\t\t\tresult = append(result, \"-\"+f.name)\n\t\t} else if f.sane == -1 && set {\n\t\t\tresult = append(result, f.name)\n\t\t}\n\t}\n\treturn result\n}\n\nfunc diffCC(cc []uint8) []string {\n\tvar result []string\n\tfor _, c := range controlChars {\n\t\tif cc[c.index] != c.saneVal {\n\t\t\tresult = append(result, c.name+\" = \"+formatCC(cc[c.index], c.isNum)+\";\")\n\t\t}\n\t}\n\treturn result\n}\n\nfunc formatCC(val uint8, isNum bool) string {\n\tif isNum {\n\t\treturn fmt.Sprintf(\"%d\", val)\n\t}\n\tif val == vdisable {\n\t\treturn \"<undef>\"\n\t}\n\tif val == 0x7f {\n\t\treturn \"^?\"\n\t}\n\tif val < 0x20 {\n\t\treturn \"^\" + string(rune(val+'@'))\n\t}\n\treturn string(rune(val))\n}\n","numLines":243,"startLine":1,"totalLines":243}}}
