{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UQ8BHaW5NBwRFpt5csA16N","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"encoding/base32\"\n8\t\t\"encoding/base64\"\n9\t\t\"encoding/hex\"\n10\t\t\"errors\"\n11\t\t\"fmt\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\n17\t\t\"github.com/petar-djukic/go-unix-utils/pkg/encutil\"\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n19\t)\n20\t\n21\tconst z85Alphabet = \"0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#\"\n22\t\n23\tvar z85Decode [256]byte\n24\t\n25\tfunc init() {\n26\t\tfor i := range z85Decode {\n27\t\t\tz85Decode[i] = 0xFF\n28\t\t}\n29\t\tfor i := range len(z85Alphabet) {\n30\t\t\tz85Decode[z85Alphabet[i]] = byte(i)\n31\t\t}\n32\t}\n33\t\n34\tvar encodingFlags = map[string]string{\n35\t\t\"--base64\":    \"base64\",\n36\t\t\"--base64url\": \"base64url\",\n37\t\t\"--base32\":    \"base32\",\n38\t\t\"--base32hex\": \"base32hex\",\n39\t\t\"--base16\":    \"base16\",\n40\t\t\"--z85\":       \"z85\",\n41\t}\n42\t\n43\ttype options struct {\n44\t\tencoding      string\n45\t\tdecode        bool\n46\t\tignoreGarbage bool\n47\t\twrap          int\n48\t}\n49\t\n50\tfunc main() {\n51\t\tsys.InstallSIGPIPEHandler()\n52\t\topts, file := parseArgs(os.Args[1:])\n53\t\n54\t\tif opts.encoding == \"\" {\n55\t\t\tfmt.Fprintf(os.Stderr, \"basenc: missing encoding type\\n\")\n56\t\t\tos.Exit(1)\n57\t\t}\n58\t\n59\t\trc, err := encutil.OpenInput(file)\n60\t\tif err != nil {\n61\t\t\tfmt.Fprintf(os.Stderr, \"basenc: %s: %s\\n\", file, err.Error())\n62\t\t\tos.Exit(1)\n63\t\t}\n64\t\tdefer rc.Close()\n65\t\n66\t\tif opts.decode {\n67\t\t\terr = encutil.Decode(rc, os.Stdout, encutil.DecoderConfig{\n68\t\t\t\tDecode:        decoderFor(opts.encoding),\n69\t\t\t\tIgnoreGarbage: opts.ignoreGarbage,\n70\t\t\t