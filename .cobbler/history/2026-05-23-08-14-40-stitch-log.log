 | uint32(data[i+1])<<16 | uint32(data[i+2])<<8 | uint32(data[i+3])\n130\t\t\tfor j := 4; j >= 0; j-- {\n131\t\t\t\tchars[j] = z85Alphabet[val%85]\n132\t\t\t\tval /= 85\n133\t\t\t}\n134\t\t\tbuf.Write(chars[:])\n135\t\t}\n136\t\treturn buf.String()\n137\t}\n138\t\n139\tfunc decodeZ85(s string) ([]byte, error) {\n140\t\tif len(s)%5 != 0 {\n141\t\t\treturn nil, fmt.Errorf(\"invalid input\")\n142\t\t}\n143\t\tout := make([]byte, len(s)*4/5)\n144\t\tfor i := 0; i < len(s); i += 5 {\n145\t\t\tvar val uint32\n146\t\t\tfor j := range 5 {\n147\t\t\t\tv := z85Decode[s[i+j]]\n148\t\t\t\tif v == 0xFF {\n149\t\t\t\t\treturn nil, fmt.Errorf(\"invalid input\")\n150\t\t\t\t}\n151\t\t\t\tval = val*85 + uint32(v)\n152\t\t\t}\n153\t\t\tk := i / 5 * 4\n154\t\t\tout[k] = byte(val >> 24)\n155\t\t\tout[k+1] = byte(val >> 16)\n156\t\t\tout[k+2] = byte(val >> 8)\n157\t\t\tout[k+3] = byte(val)\n158\t\t}\n159\t\treturn out, nil\n160\t}\n161\t\n162\tfunc parseArgs(args []string) (options, string) {\n163\t\topts := options{wrap: 76}\n164\t\tvar file string\n165\t\ti := 0\n166\t\tfor i < len(args) {\n167\t\t\targ := args[i]\n168\t\t\tif arg == \"--\" {\n169\t\t\t\tif i+1 < len(args) {\n170\t\t\t\t\tfile = args[i+1]\n171\t\t\t\t}\n172\t\t\t\tbreak\n173\t\t\t}\n174\t\t\tif handled, advance := parseLongFlag(args[i:], &opts); handled {\n175\t\t\t\ti += advance\n176\t\t\t\tcontinue\n177\t\t\t}\n178\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n179\t\t\t\tfile = arg\n180\t\t\t\ti++\n181\t\t\t\tcontinue\n182\t\t\t}\n183\t\t\ti += parseShortFlags(args[i:], &opts)\n184\t\t}\n185\t\treturn opts, file\n186\t}\n187\t\n188\tfunc parseLongFlag(remaining []string, opts *options) (bool, int) {\n189\t\targ := remaining[0]\n190\t\tif !strings.HasPrefix(arg, \"--\") {\n191\t\t\treturn false, 0\n192\t\t}\n193\t\tif arg == \"--wrap\" || strings.HasPrefix(arg, \"--wrap=\") {\n194\t\t\treturn parseWrapFlag(remaining, opts)\n195\t\t}\n196\t\tif enc, ok := encodingFlags[arg]; ok {\n197\t\t\tif opts.encoding