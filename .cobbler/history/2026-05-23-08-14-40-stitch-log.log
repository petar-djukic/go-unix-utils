 ExitCode: 1, Normalize: []testutils.NormalizeFunc{discardStderr}, Env: []string{\"LC_ALL=C\"}},\n81\t\t\t{Name: \"missing-file\", Args: []string{\"--base64\", filepath.Join(tmpDir, \"nonexistent.txt\")}, ExitCode: 1, Normalize: []testutils.NormalizeFunc{discardStderr}, Env: []string{\"LC_ALL=C\"}},\n82\t\t\t{Name: \"decode-invalid-input\", Args: []string{\"--base64\", \"-d\"}, Stdin: []byte(\"!!!invalid!!!\\n\"), ExitCode: 1, Normalize: []testutils.NormalizeFunc{discardStderr}, Env: []string{\"LC_ALL=C\"}},\n83\t\t\t{Name: \"z85-decode-invalid\", Args: []string{\"--z85\", \"-d\"}, Stdin: []byte(\"abc\\n\"), ExitCode: 1, Normalize: []testutils.NormalizeFunc{discardStderr}, Env: []string{\"LC_ALL=C\"}},\n84\t\t}\n85\t\n86\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n87\t}\n88\t\n89\tfunc TestSIGPIPE(t *testing.T) {\n90\t\tgoBin := testutils.BuildBinary(t, \".\")\n91\t\tdir := t.TempDir()\n92\t\tlargePath := filepath.Join(dir, \"large.dat\")\n93\t\tif err := os.WriteFile(largePath, bytes.Repeat([]byte(\"x\"), 100000), 0o644); err != nil {\n94\t\t\tt.Fatal(err)\n95\t\t}\n96\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n97\t\tdefer cancel()\n98\t\tcmd := exec.CommandContext(ctx, goBin, \"--base64\", largePath)\n99\t\tstdout, err := cmd.StdoutPipe()\n100\t\tif err != nil {\n101\t\t\tt.Fatal(err)\n102\t\t}\n103\t\tif err := cmd.Start(); err != nil {\n104\t\t\tt.Fatal(err)\n105\t\t}\n106\t\tbuf := make([]byte, 1)\n107\t\tif _, err := io.ReadFull(stdout, buf); err != nil {\n108\t\t\tt.Fatal(err)\n109\t\t}\n110\t\tstdout.Close()\n111\t\tif err := cmd.Wait(); err != nil {\n112\t\t\tif ctx.Err() == context.DeadlineExceeded {\n113\t\t\t\tt.Fatalf(\"timed out; SIGPIPE handler may not be installed\")\n114\t\t\t}\n115\t\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n116\t\t}\n117\t}\n118\t\n119\tfunc writeFile(t *testing.T, path, content string) {\n120\t\tt.Helper()\n121\t\tif err := os.WriteFile(path, []byte(content), 0o644); err !