{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DD5weCUjS62j183xeJTcek","type":"tool_result","content":"30\t// DiffTest defines a single differential test case.\n31\t//\n32\t// R1.1: Name identifies the subtest (used with t.Run). Args holds command-line\n33\t// arguments passed to both binaries.\n34\t//\n35\t// R1.2: Stdin nil means both binaries receive EOF immediately. An empty non-nil\n36\t// slice ([]byte{}) also produces no bytes but represents an open stdin that is\n37\t// immediately closed. ExitCode defaults to 0 when left as the zero value.\n38\t//\n39\t// R1.3: Env nil means both binaries inherit the test process environment with\n40\t// LC_ALL=C applied as a default override. When non-nil, KEY=VALUE pairs are\n41\t// merged into the inherited environment: matching keys are overridden, new keys\n42\t// are added.\n43\t//\n44\t// R1.4: Normalize holds a slice of NormalizeFunc applied in order to stdout and\n45\t// stderr of both binaries before comparison. Nil or empty means no normalization.\n46\ttype DiffTest struct {\n47\t\tName          string\n48\t\tArgs          []string\n49\t\tStdin         []byte\n50\t\tEnv           []string\n51\t\tWorkDir       string\n52\t\tExitCode      int\n53\t\tNormalize     []NormalizeFunc\n54\t\tExpectedFiles map[string][]byte\n55\t}\n56\t\n57\tvar tsPatterns = []*regexp.Regexp{\n58\t\tregexp.MustCompile(`[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}`),\n59\t\tregexp.MustCompile(`\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}`),\n60\t\tregexp.MustCompile(`\\d{2}:\\d{2}:\\d{2}`),\n61\t}\n62\t\n63\t// TimestampNormalizer replaces common strftime timestamp patterns with a fixed\n64\t// placeholder string.\n65\t// R4.2: built-in normalizer for cmd/ts tests.\n66\tvar TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n67\t\tresult := b\n68\t\tfor _, pat := range tsPatterns {\n69\t\t\tresult = pat.ReplaceAll(result, []byte(\"<TIMESTAMP>\"))\n70\t\t}\n71\t\treturn result\n72\t}\n73\t\n74\ttype binaryResult struct {\n75\t\tstdout   []byte\n76\t\tstderr   []byte\n77\t\texitCode int\n78\t}\n79\t\n80\t// RunDiffTests runs each DiffTest as a named subtest, executing goBinary and\n81\t// refBinary with identical inputs and comparing their outputs.\n82\t// R2.1: accepts paths to Go and reference binaries plus test cases.\n83\tfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n84\t\tt.Helper()\n85\t\tfor _, tc := range tests {\n86\t\t\tt.Run(tc.Name, func(t *testing.T) {\n87\t\t\t\trunSubtest(t, goBinary, refBinary, tc)\n88\t\t\t})\n89\t\t}\n90\t}\n91\t\n92\tfunc runSubtest(t *testing.T, goBinary, refBinary string, tc DiffTest) {\n93\t\tt.Helper()\n94\t\tworkDir := tc.WorkDir\n95\t\tif workDir == \"\" {\n96\t\t\tworkDir = t.TempDir()\n97\t\t}\n98\t\tenv := buildEnv(tc.Env)\n99\t\tgoRes := runBinary(t, goBinary, tc.Args, tc.Stdin, env, workDir)"}]},"parent_tool_use_id":null,"session_id":"a3eabc76-d363-4d82-9921-dd26e42727d9","uuid":"1d2cdada-af83-408a-bc04-60e4a19fcfee","timestamp":"2026-05-21T13:18:41.194Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5405/pkg/testutils/difftest.go","content":"// DiffTest defines a single differential test case.\n//\n// R1.1: Name identifies the subtest (used with t.Run). Args holds command-line\n// arguments passed to both binaries.\n//\n// R1.2: Stdin nil means both binaries receive EOF immediately. An empty non-nil\n// slice ([]byte{}) also produces no bytes but represents an open stdin that is\n// immediately closed. ExitCode defaults to 0 when left as the zero value.\n//\n// R1.3: Env nil means both binaries inherit the test process environment with\n// LC_ALL=C applied as a default override. When non-nil, KEY=VALUE pairs are\n// merged into the inherited environment: matching keys are overridden, new keys\n// are added.\n//\n// R1.4: Normalize holds a slice of NormalizeFunc applied in order to stdout and\n// stderr of both binaries before comparison. Nil or empty means no normalization.\ntype DiffTest struct {\n\tName          string\n\tArgs          []string\n\tStdin         []byte\n\tEnv           []string\n\tWorkDir       string\n\tExitCode      int\n\tNormalize     []NormalizeFunc\n\tExpectedFiles map[string][]byte\n}\n\nvar tsPatterns = []*regexp.Regexp{\n\tregexp.MustCompile(`[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}`),\n\tregexp.MustCompile(`\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}`),\n\tregexp.MustCompile(`\\d{2}:\\d{2}:\\d{2}`),\n}\n\n// TimestampNormalizer replaces common strftime timestamp patterns with a fixed\n// placeholder string.\n// R4.2: built-in normalizer for cmd/ts tests.\nvar TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n\tresult := b\n\tfor _, pat := range tsPatterns {\n\t\tresult = pat.ReplaceAll(result, []byte(\"<TIMESTAMP>\"))\n\t}\n\treturn result\n}\n\ntype binaryResult struct {\n\tstdout   []byte\n\tstderr   []byte\n\texitCode int\n}\n\n// RunDiffTests runs each DiffTest as a named subtest, executing goBinary and\n// refBinary with identical inputs and comparing their outputs.\n// R2.1: accepts paths to Go and reference binaries plus test cases.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\trunSubtest(t, goBinary, refBinary, tc)\n\t\t})\n\t}\n}\n\nfunc runSubtest(t *testing.T, goBinary, refBinary string, tc DiffTest) {\n\tt.Helper()\n\tworkDir := tc.WorkDir\n\tif workDir == \"\" {\n\t\tworkDir = t.TempDir()\n\t}\n\tenv := buildEnv(tc.Env)\n\tgoRes := runBinary(t, goBinary, tc.Args, tc.Stdin, env, workDir)","numLines":70,"startLine":30,"totalLines":241}}}
