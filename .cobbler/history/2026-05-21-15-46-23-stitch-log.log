HasPrefix(arg, \"--\") {\n79\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n80\t\t\t\tif err != nil {\n81\t\t\t\t\treturn opts, \"\", err\n82\t\t\t\t}\n83\t\t\t\ti += n\n84\t\t\t\tcontinue\n85\t\t\t}\n86\t\t\tif len(arg) > 1 && arg[0] == '-' {\n87\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n88\t\t\t\tif err != nil {\n89\t\t\t\t\treturn opts, \"\", err\n90\t\t\t\t}\n91\t\t\t\ti += 1 + n\n92\t\t\t\tcontinue\n93\t\t\t}\n94\t\t\tpositional = append(positional, arg)\n95\t\t\ti++\n96\t\t}\n97\t\n98\t\treturn assignPositional(opts, positional)\n99\t}\n100\t\n101\tfunc assignPositional(opts options, pos []string) (options, string, error) {\n102\t\tfile := \"-\"\n103\t\tif len(pos) >= 1 {\n104\t\t\tfile = pos[0]\n105\t\t}\n106\t\tif len(pos) >= 2 {\n107\t\t\topts.prefix = pos[1]\n108\t\t}\n109\t\tif len(pos) > 2 {\n110\t\t\treturn opts, \"\", fmt.Errorf(\"extra operand '%s'\", pos[2])\n111\t\t}\n112\t\treturn opts, file, nil\n113\t}\n114\t\n115\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n116\t\tswitch {\n117\t\tcase flag == \"--lines\" || strings.HasPrefix(flag, \"--lines=\"):\n118\t\t\tval, n, err := longOptValue(flag, \"--lines\", remaining)\n119\t\t\tif err != nil {\n120\t\t\t\treturn 0, err\n121\t\t\t}\n122\t\t\treturn n, setLineMode(opts, val)\n123\t\tcase flag == \"--bytes\" || strings.HasPrefix(flag, \"--bytes=\"):\n124\t\t\tval, n, err := longOptValue(flag, \"--bytes\", remaining)\n125\t\t\tif err != nil {\n126\t\t\t\treturn 0, err\n127\t\t\t}\n128\t\t\treturn n, setBytesMode(opts, val)\n129\t\tcase flag == \"--line-bytes\" || strings.HasPrefix(flag, \"--line-bytes=\"):\n130\t\t\tval, n, err := longOptValue(flag, \"--line-bytes\", remaining)\n131\t\t\tif err != nil {\n132\t\t\t\treturn 0, err\n133\t\t\t}\n134\t\t\treturn n, setLineBytesMode(opts, val)\n135\t\tcase flag == \"--number\" || strings.HasPrefix(flag, \"--number=\"):\n136\t\t\tval, n, err := longOptValue(flag, \"--number\", remaining)\n137\t\t\tif err != nil {\n138\t\t\t\treturn 0, err\n139\t\t\t}\n140\t\t\treturn n, setChunksMode(opts, val)\n141\t\tcase flag == \"--suffix-length\" || strings.HasPrefix(flag, \"--suffix-length=\"):\n142\t\t\tval, n, err := longOptValue(flag, \"--suffix-length\", remaining)\n143\t\t\tif err != nil {\n144\t\t\t\treturn 0, err\n145\t\t\t}\n146\t\t\treturn n, setSuffixLen(opts, val)\n147\t\tcase flag == \"--numeric-suffixes\":\n148\t\t\topts.numeric = true\n149\t\t\treturn 1, nil\n150\t\tcase flag == \"--additional-suffix\" || strings.HasPrefix(flag, \"--additional-suffix=\"):\n151\t\t\tval, n, err := longOptValue(flag, \"--additional-suffix\", remaining)\n152\t\t\tif err != nil {\n153\t\t\t\treturn 0, err\n154\t\t\t}\n155\t\t\topts.additionalSuffix = val\n156\t\t\treturn n, nil\n157\t\tcase flag == \"--filter\" || strings.HasPrefix(flag, \"--filter=\"):\n158\t\t\tval, n, err := longOptValue(flag, \"--filter\", remaining)\n159\t\t\tif err != nil {\n160\t\t\t\treturn 0, err\n161\t\t\t}\n162\t\t\topts.filter = val\n163\t\t\treturn n, nil\n164\t\tdefault:\n165\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n166\t\t}\n167\t}\n168\t\n169\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n170\t\tconsumed := 0\n171\t\tfor j := 0; j < len(flags); j++ {\n172\t\t\tif isBoolFlag(flags[j]) {\n173\t\t\t\tif err := setBoolFlag(opts, flags[j]); err != nil {\n174\t\t\t\t\treturn 0, err\n175\t\t\t\t}\n176\t\t\t\tcontinue\n177\t\t\t}\n178\t\t\tsetter, ok := shortFlagSetter(flags[j])\n179\t\t\tif !ok {\n180\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n181\t\t\t}\n182\t\t\tval, extra, err := extractFlagValue(flags[j+1:], remaining, consumed, flags[j])\n183\t\t\tif err != nil {\n184\t\t\t\treturn 0, err\n185\t\t\t}\n186\t\t\tif err := setter(opts, val); err != nil {\n187\t\t\t\treturn 0, err\n188\t\t\t}\n189\t\t\treturn consumed + extra, nil\n190\t\t}\n191\t\treturn consumed, nil\n192\t}\n193\t\n194\tfunc setBoolFlag(opts *options, ch byte) error {\n195\t\tswitch ch {\n196\t\tcase 'd':\n197\t\t\topts.numeric = true\n198\t\t\treturn nil\n199\t\tdefault:\n200\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", ch)\n201\t\t}\n202\t}\n203\t\n204\tfunc shortFlagSetter(ch byte) (func(*options, string) error, bool) {\n205\t\tswitch ch {\n206\t\tcase 'l':\n207\t\t\treturn setLineMode, true\n208\t\tcase 'b':\n209\t\t\treturn setBytesMode, true\n210\t\tcase 'C':\n211\t\t\treturn setLineBytesMode, true\n212\t\tcase 'n':\n213\t\t\treturn setChunksMode, true\n214\t\tcase 'a':\n215\t\t\treturn setSuffixLen, true\n216\t\tdefault:\n217\t\t\treturn nil, false\n218\t\t}\n219\t}\n220\t\n221\tfunc isBoolFlag(ch byte) bool {\n222\t\treturn ch == 'd'\n223\t}\n224\t\n225\tfunc extractFlagValue(rest string, remaining []string, consumed int, flag byte) (string, int, error) {\n226\t\tif rest != \"\" {\n227\t\t\treturn rest, 0, nil\n228\t\t}\n229\t\tif len(remaining) > consumed {\n230\t\t\treturn remaining[consumed], 1, nil\n231\t\t}\n232\t\treturn \"\", 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n233\t}\n234\t\n235\tfunc parseLineCount(s string) (int, error) {\n236\t\tn, err := strconv.Atoi(s)\n237\t\tif err != nil || n <= 0 {\n238\t\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n239\t\t}\n240\t\treturn n, nil\n241\t}\n242\t\n243\tfunc openInput(name string) (io.Reader, io.Closer, error) {\n244\t\tif name == \"-\" {\n245\t\t\treturn os.Stdin, nil, nil\n246\t\t}\n247\t\tf, err := os.Open(name)\n248\t\tif err != nil {\n249\t\t\treturn nil, nil, err\n250\t\t}\n251\t\treturn f, f, nil\n252\t}\n253\t\n254\tfunc splitLines(r io.Reader, so suffixOpts, linesPerPiece int) error {\n255\t\tbr := bufio.NewReader(r)\n256\t\tlineCount := 0\n257\t\tpieceIndex := 0\n258\t\tvar pw *pieceWriter\n259\t\n260\t\tfor {\n261\t\t\tline, readErr := br.ReadBytes('\\n')\n262\t\t\tif len(line) > 0 {\n263\t\t\t\tif lineCount%linesPerPiece == 0 {\n264\t\t\t\t\tif pw != nil {\n265\t\t\t\t\t\tpw.Close()\n266\t\t\t\t\t}\n267\t\t\t\t\tvar err error\n268\t\t\t\t\tpw, err = newPieceWriter(so, pieceIndex)\n269\t\t\t\t\tif err != nil {\n270\t\t\t\t\t\treturn err\n271\t\t\t\t\t}\n272\t\t\t\t\tpieceIndex++\n273\t\t\t\t}\n274\t\t\t\tif _, err := pw.Write(line); err != nil {\n275\t\t\t\t\tpw.Close()\n276\t\t\t\t\treturn err\n277\t\t\t\t}\n278\t\t\t\tlineCount++\n279\t\t\t}\n280\t\t\tif readErr != nil {\n281\t\t\t\tif pw != nil {\n282\t\t\t\t\tpw.Close()\n283\t\t\t\t}\n284\t\t\t\tif readErr != io.EOF {\n285\t\t\t\t\treturn readErr\n286\t\t\t\t}\n287\t\t\t\treturn nil\n288\t\t\t}\n289\t\t}\n290\t}\n291\t\n292\ttype suffixOpts struct {\n293\t\tprefix           string\n294\t\tsuffixLen        int\n295\t\tnumeric          bool\n296\t\tadditionalSuffix string\n297\t\tfilter           string\n298\t}\n299\t\n300\tfunc newSuffixOpts(opts options) suffixOpts {\n301\t\treturn suffixOpts{\n302\t\t\tprefix:           opts.prefix,\n303\t\t\tsuffixLen:        opts.suffixLen,\n304\t\t\tnumeric:          opts.numeric,\n305\t\t\tadditionalSuffix: opts.additionalSuffix,\n306\t\t\tfilter:           opts.filter,\n307\t\t}\n308\t}\n309\t\n310\tfunc pieceName(so suffixOpts, index int) (string, error) {\n311\t\tvar suffix string\n312\t\tvar err error\n313\t\tif so.numeric {\n314\t\t\tsuffix, err = numericSuffix(index, so.suffixLen)\n315\t\t} else {\n316\t\t\tsuffix, err = alphabeticSuffix(index, so.suffixLen)\n317\t\t}\n318\t\tif err != nil {\n319\t\t\treturn \"\", err\n320\t\t}\n321\t\treturn so.prefix + suffix + so.additionalSuffix, nil\n322\t}\n323\t\n324\tfunc numericSuffix(index, length int) (string, error) {\n325\t\ts := strconv.Itoa(index)\n326\t\tif len(s) > length {\n327\t\t\treturn \"\", fmt.Errorf(\"output file suffixes exhausted\")\n328\t\t}\n329\t\treturn strings.Repeat(\"0\", length-len(s)) + s, nil\n330\t}\n331\t\n332\tfunc setSuffixLen(opts *options, val string) error {\n333\t\tn, err := strconv.Atoi(val)\n334\t\tif err != nil || n <= 0 {\n335\t\t\treturn fmt.Errorf(\"invalid suffix length: '%s'\", val)\n336\t\t}\n337\t\topts.suffixLen = n\n338\t\treturn nil\n339\t}\n340\t\n341\tfunc alphabeticSuffix(index, length int) (string, error) {\n342\t\tmaxPieces := 1\n343\t\tfor range length {\n344\t\t\tmaxPieces *= 26\n345\t\t}\n346\t\tif index >= maxPieces {\n347\t\t\treturn \"\", fmt.Errorf(\"output file suffixes exhausted\")\n348\t\t}\n349\t\tbuf := make([]byte, length)\n350\t\tfor i := length - 1; i >= 0; i-- {\n351\t\t\tbuf[i] = 'a' + byte(index%26)\n352\t\t\tindex /= 26\n353\t\t}\n354\t\treturn string(buf), nil\n355\t}\n356\t\n357\tfunc run(r io.Reader, opts options) error {\n358\t\tso := newSuffixOpts(opts)\n359\t\tswitch opts.mode {\n360\t\tcase modeBytes:\n361\t\t\treturn splitBytes(r, so, opts.bytesVal)\n362\t\tcase modeLineBytes:\n363\t\t\treturn splitLineBytes(r, so, opts.lineBytes)\n364\t\tcase modeChunks:\n365\t\t\treturn splitChunks(r, so, opts.chunks)\n366\t\tdefault:\n367\t\t\treturn splitLines(r, so, opts.lines)\n368\t\t}\n369\t}\n370\t\n371\tfunc setMode(opts *options, mode splitMode) error {\n372\t\tif opts.modeSet && opts.mode != mode {\n373\t\t\treturn fmt.Errorf(\"cannot split in more than one way\")\n374\t\t}\n375\t\topts.mode = mode\n376\t\topts.modeSet = true\n377\t\treturn nil\n378\t}\n379\t\n380\tfunc setLineMode(opts *options, val string) error {\n381\t\tn, err := parseLineCount(val)\n382\t\tif err != nil {\n383\t\t\treturn err\n384\t\t}\n385\t\tif err := setMode(opts, modeLines); err != nil {\n386\t\t\treturn err\n387\t\t}\n388\t\topts.lines = n\n389\t\treturn nil\n390\t}\n391\t\n392\tfunc setBytesMode(opts *options, val string) error {\n393\t\tn, err := parseByteCount(val)\n394\t\tif err != nil {\n395\t\t\treturn err\n396\t\t}\n397\t\tif err := setMode(opts, modeBytes); err != nil {\n398\t\t\treturn err\n399\t\t}\n400\t\topts.bytesVal = n\n401\t\treturn nil\n402\t}\n403\t\n404\tfunc setLineBytesMode(opts *options, val string) error {\n405\t\tn, err := parseByteCount(val)\n406\t\tif err != nil {\n407\t\t\treturn err\n408\t\t}\n409\t\tif err := setMode(opts, modeLineBytes); err != nil {\n410\t\t\treturn err\n411\t\t}\n412\t\topts.lineBytes = n\n413\t\treturn nil\n414\t}\n415\t\n416\tfunc setChunksMode(opts *options, val string) error {\n417\t\tif err := setMode(opts, modeChunks); err != nil {\n418\t\t\treturn err\n419\t\t}\n420\t\topts.chunks = val\n421\t\treturn nil\n422\t}\n423\t\n424\tfunc longOptValue(flag, name string, remaining []string) (string, int, error) {\n425\t\tif strings.HasPrefix(flag, name+\"=\") {\n426\t\t\treturn flag[len(name)+1:], 1, nil\n427\t\t}\n428\t\tif len(remaining) < 2 {\n429\t\t\treturn \"\", 0, fmt.Errorf(\"option '%s' requires an argument\", name)\n430\t\t}\n431\t\treturn remaining[1], 2, nil\n432\t}\n433\t\n434\tfunc parseByteCount(s string) (int64, error) {\n435\t\tn, err := sizeparse.Parse(s)\n436\t\tif err != nil || n <= 0 {\n437\t\t\treturn 0, fmt.Errorf(\"invalid number of bytes: '%s'\", s)\n438\t\t}\n439\t\treturn n, nil\n440\t}\n441\t\n442\tfunc splitBytes(r io.Reader, so suffixOpts, size int64) error {\n443\t\tpieceIndex := 0\n444\t\tfor {\n445\t\t\tpw, err := newPieceWriter(so, pieceIndex)\n446\t\t\tif err != nil {\n447\t\t\t\treturn err\n448\t\t\t}\n449\t\t\twritten, copyErr := io.CopyN(pw, r, size)\n450\t\t\tcloseErr := pw.Close()\n451\t\t\tif written == 0 {\n452\t\t\t\tpw.Remove()\n453\t\t\t}\n454\t\t\tif copyErr != nil {\n455\t\t\t\tif copyErr == io.EOF {\n456\t\t\t\t\treturn nil\n457\t\t\t\t}\n458\t\t\t\treturn copyErr\n459\t\t\t}\n460\t\t\tif closeErr != nil {\n461\t\t\t\treturn closeErr\n462\t\t\t}\n463\t\t\tpieceIndex++\n464\t\t}\n465\t}\n466\t\n467\tfunc splitLineBytes(r io.Reader, so suffixOpts, maxBytes int64) error {\n468\t\tsz := int(maxBytes)\n469\t\tbr := bufio.NewReaderSize(r, sz)\n470\t\tpieceIndex := 0\n471\t\n472\t\tfor {\n473\t\t\tdata, err := readLineBytesChunk(br, sz)\n474\t\t\tif len(data) > 0 {\n475\t\t\t\tif werr := writePiece(so, pieceIndex, data); werr != nil {\n476\t\t\t\t\treturn werr\n477\t\t\t\t}\n478\t\t\t\tpieceIndex++\n479\t\t\t}\n480\t\t\tif err != nil {\n481\t\t\t\tif err == io.EOF {\n482\t\t\t\t\treturn nil\n483\t\t\t\t}\n484\t\t\t\treturn err\n485\t\t\t}\n486\t\t}\n487\t}\n488\t\n489\tfunc readLineBytesChunk(br *bufio.Reader, sz int) ([]byte, error) {\n490\t\tbuf, _ := br.Peek(sz)\n491\t\tif len(buf) == 0 {\n492\t\t\treturn nil, io.EOF\n493\t\t}\n494\t\twriteLen := len(buf)\n495\t\tif len(buf) >= sz {\n496\t\t\tif lastNL := bytes.LastIndexByte(buf, '\\n'); lastNL >= 0 {\n497\t\t\t\twriteLen = lastNL + 1\n498\t\t\t}\n499\t\t}\n500\t\tdata := make([]byte, writeLen)\n501\t\t_, err := br.Read(data)\n502\t\treturn data, err\n503\t}\n504\t\n505\tfunc splitChunks(r io.Reader, so suffixOpts, spec string) error {\n506\t\tmode, n, err := parseChunkSpec(spec)\n507\t\tif err != nil {\n508\t\t\treturn err\n509\t\t}\n510\t\tdata, err := io.ReadAll(r)\n511\t\tif err != nil {\n512\t\t\treturn err\n513\t\t}\n514\t\tswitch mode {\n515\t\tcase \"\":\n516\t\t\treturn splitByteChunks(data, so, n)\n517\t\tcase \"l\":\n518\t\t\treturn splitLineChunks(data, so, n)\n519\t\tcase \"r\":\n520\t\t\treturn splitRoundRobin(data, so, n)\n521\t\tdefault:\n522\t\t\treturn fmt.Errorf(\"invalid number of chunks: '%s'\", spec)\n523\t\t}\n524\t}\n525\t\n526\tfunc parseChunkSpec(spec string) (string, int, error) {\n527\t\tnumStr := spec\n528\t\tmode := \"\"\n529\t\tif strings.HasPrefix(spec, \"l/\") {\n530\t\t\tmode = \"l\"\n531\t\t\tnumStr = spec[2:]\n532\t\t} else if strings.HasPrefix(spec, \"r/\") {\n533\t\t\tmode = \"r\"\n534\t\t\tnumStr = spec[2:]\n535\t\t}\n536\t\tn, err := strconv.Atoi(numStr)\n537\t\tif err != nil || n <= 0 {\n538\t\t\treturn \"\", 0, fmt.Errorf(\"invalid number of chunks: '%s'\", spec)\n539\t\t}\n540\t\treturn mode, n, nil\n541\t}\n542\t\n543\tfunc splitByteChunks(data []byte, so suffixOpts, n int) error {\n544\t\ttotal := len(data)\n545\t\tbaseSize := total / n\n546\t\tremainder := total % n\n547\t\toffset := 0\n548\t\tfor i := range n {\n549\t\t\tsize := baseSize\n550\t\t\tif i < remainder {\n551\t\t\t\tsize++\n552\t\t\t}\n553\t\t\tif err := writePiece(so, i, data[offset:offset+size]); err != nil {\n554\t\t\t\treturn err\n555\t\t\t}\n556\t\t\toffset += size\n557\t\t}\n558\t\treturn nil\n559\t}\n560\t\n561\tfunc splitLineChunks(data []byte, so suffixOpts, n int) error {\n562\t\ttotal := int64(len(data))\n563\t\toffset := int64(0)\n564\t\tfor i := range n {\n565\t\t\ttarget := total * int64(i+1) / int64(n)\n566\t\t\tend := offset\n567\t\t\tif target > offset {\n568\t\t\t\tend = findLineEnd(data, target)\n569\t\t\t}\n570\t\t\tif err := writePiece(so, i, data[offset:end]); err != nil {\n571\t\t\t\treturn err\n572\t\t\t}\n573\t\t\toffset = end\n574\t\t}\n575\t\treturn nil\n576\t}\n577\t\n578\tfunc findLineEnd(data []byte, pos int64) int64 {\n579\t\tif pos <= 0 {\n580\t\t\treturn 0\n581\t\t}\n582\t\tif pos >= int64(len(data)) {\n583\t\t\treturn int64(len(data))\n584\t\t}\n585\t\tif data[pos-1] == '\\n' {\n586\t\t\treturn pos\n587\t\t}\n588\t\tidx := bytes.IndexByte(data[pos:], '\\n')\n589\t\tif idx < 0 {\n590\t\t\treturn int64(len(data))\n591\t\t}\n592\t\treturn pos + int64(idx) + 1\n593\t}\n594\t\n595\tfunc splitRoundRobin(data []byte, so suffixOpts, n int) error {\n596\t\tlines := splitIntoLines(data)\n597\t\tbufs := make([]bytes.Buffer, n)\n598\t\tfor i, line := range lines {\n599\t\t\tbufs[i%n].Write(line)\n600\t\t}\n601\t\tfor i := range n {\n602\t\t\tif err := writePiece(so, i, bufs[i].Bytes()); err != nil {\n603\t\t\t\treturn err\n604\t\t\t}\n605\t\t}\n606\t\treturn nil\n607\t}\n608\t\n609\tfunc writePiece(so suffixOpts, index int, data []byte) error {\n610\t\tpw, err := newPieceWriter(so, index)\n611\t\tif err != nil {\n612\t\t\treturn err\n613\t\t}\n614\t\tif len(data) > 0 {\n615\t\t\tif _, err := pw.Write(data); err != nil {\n616\t\t\t\tpw.Close()\n617\t\t\t\treturn err\n618\t\t\t}\n619\t\t}\n620\t\treturn pw.Close()\n621\t}\n622\t\n623\ttype pieceWriter struct {\n624\t\tfile *os.File\n625\t\tcmd  *exec.Cmd\n626\t\tpipe io.WriteCloser\n627\t\tname string\n628\t}\n629\t\n630\tfunc newPieceWriter(so suffixOpts, index int) (*pieceWriter, error) {\n631\t\tname, err := pieceName(so, index)\n632\t\tif err != nil {\n633\t\t\treturn nil, err\n634\t\t}\n635\t\tif so.filter != \"\" {\n636\t\t\treturn newFilterWriter(so.filter, name)\n637\t\t}\n638\t\tf, err := os.Create(name)\n639\t\tif err != nil {\n640\t\t\treturn nil, err\n641\t\t}\n642\t\treturn &pieceWriter{file: f, name: name}, nil\n643\t}\n644\t\n645\tfunc newFilterWriter(command, filename string) (*pieceWriter, error) {\n646\t\tcmd := exec.Command(\"sh\", \"-c\", command)\n647\t\tcmd.Env = append(os.Environ(), \"FILE=\"+filename)\n648\t\tcmd.Stdout = os.Stdout\n649\t\tcmd.Stderr = os.Stderr\n650\t\tpipe, err := cmd.StdinPipe()\n651\t\tif err != nil {\n652\t\t\treturn nil, err\n653\t\t}\n654\t\tif err := cmd.Start(); err != nil {\n655\t\t\treturn nil, err\n656\t\t}\n657\t\treturn &pieceWriter{cmd: cmd, pipe: pipe, name: filename}, nil\n658\t}\n659\t\n660\tfunc (pw *pieceWriter) Write(p []byte) (int, error) {\n661\t\tif pw.pipe != nil {\n662\t\t\treturn pw.pipe.Write(p)\n663\t\t}\n664\t\treturn pw.file.Write(p)\n665\t}\n666\t\n667\tfunc (pw *pieceWriter) Close() error {\n668\t\tif pw.pipe != nil {\n669\t\t\tpw.pipe.Close()\n670\t\t\treturn pw.cmd.Wait()\n671\t\t}\n672\t\treturn pw.file.Close()\n673\t}\n674\t\n675\tfunc (pw *pieceWriter) Remove() {\n676\t\tif pw.file != nil {\n677\t\t\tos.Remove(pw.name)\n678\t\t}\n679\t}\n680\t\n681\tfunc splitIntoLines(data []byte) [][]byte {\n682\t\tvar lines [][]byte\n683\t\tfor len(data) > 0 {\n684\t\t\tidx := bytes.IndexByte(data, '\\n')\n685\t\t\tif idx < 0 {\n686\t\t\t\tlines = append(lines, data)\n687\t\t\t\tbreak\n688\t\t\t}\n689\t\t\tlines = append(lines, data[:idx+1])\n690\t\t\tdata = data[idx+1:]\n691\t\t}\n692\t\treturn lines\n693\t}\n694\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doi