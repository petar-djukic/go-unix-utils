strings.TrimSpace(scanner.Text())\n\t\tif line == \"\" {\n\t\t\tcontinue\n\t\t}\n\t\tif err := factorize(line); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"factor: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc factorize(input string) error {\n\tn, err := strconv.ParseInt(input, 10, 64)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"'%s' is not a valid positive integer\", input)\n\t}\n\tif n < 0 {\n\t\treturn fmt.Errorf(\"'%s' is not a valid positive integer\", input)\n\t}\n\n\tfactors := primeFactors(n)\n\tprintFactors(n, factors)\n\treturn nil\n}\n\nfunc primeFactors(n int64) []int64 {\n\tif n <= 1 {\n\t\treturn nil\n\t}\n\tvar factors []int64\n\tfor n%2 == 0 {\n\t\tfactors = append(factors, 2)\n\t\tn /= 2\n\t}\n\tlimit := int64(math.Sqrt(float64(n)))\n\tfor d := int64(3); d <= limit; d += 2 {\n\t\tfor n%d == 0 {\n\t\t\tfactors = append(factors, d)\n\t\t\tn /= d\n\t\t}\n\t\tlimit = int64(math.Sqrt(float64(n)))\n\t}\n\tif n > 1 {\n\t\tfactors = append(factors, n)\n\t}\n\treturn factors\n}\n\nfunc printFactors(n int64, factors []int64) {\n\tvar b strings.Builder\n\tfmt.Fprintf(&b, \"%d:\", n)\n\tfor _, f := range factors {\n\t\tfmt.Fprintf(&b, \" %d\", f)\n\t}\n\tfmt.Println(b.String())\n}\n","structuredPatch":[{"oldStart":3,"oldLines":7,"newStart":3,"newLines":7,"lines":[" "," // factor prints the prime factorization of each integer."," //","-// Specification: srd065-factor R1.1-R1.4","+// Specification: srd065-factor R1.1-R1.4, R2.1-R2.4"," package main"," "," import ("]}],"userModified":false,"replaceAll":false}}
