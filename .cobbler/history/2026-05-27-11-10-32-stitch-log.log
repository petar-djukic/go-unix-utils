{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NHFjGwnpzPQowSCKJPe7Hy","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/install implements srd101-install R1.1-R1.4, R2.1-R2.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\n17\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n18\t)\n19\t\n20\tconst helpText = `Usage: install [OPTION]... [-T] SOURCE DEST\n21\t  or:  install [OPTION]... SOURCE... DIRECTORY\n22\t  or:  install [OPTION]... -d DIRECTORY...\n23\t\n24\tCopy files and set attributes.\n25\t\n26\t  -b                  make a backup of each existing destination file\n27\t  -c                  (ignored)\n28\t  -d, --directory     treat all arguments as directory names; create all\n29\t                        components of the specified directories\n30\t  -D                  create all leading components of DEST except the last,\n31\t                        or all components of --target-directory, then copy SOURCE to DEST\n32\t  -g GROUP            set group ownership\n33\t  -m MODE             set permission mode (as in chmod), instead of rwxr-xr-x\n34\t  -o OWNER            set ownership\n35\t      --backup        make a backup of each existing destination file\n36\t      --suffix=SUFFIX override the usual backup suffix\n37\t  -v, --verbose       print the name of each directory as it is created\n38\t      --help          display this help and exit\n39\t      --version       output version information and exit\n40\t`\n41\t\n42\tconst versionText = `install (go-unix-utils) dev\n43\t`\n44\t\n45\ttype options struct {\n46\t\tmode      string\n47\t\towner     string\n48\t\tgroup     string\n49\t\tdirectory bool\n50\t\tcreateDir bool\n51\t\tbackup    bool\n52\t\tsuffix    string\n53\t\tverbose   bool\n54\t}\n55\t\n56\tfunc main() {\n57\t\tsys.InstallSIGPIPEHandler()\n58\t\n59\t\topts, args := parseArgs(os.Args[1:])\n60\t\tif opts.suffix == \"\" {\n61\t\t\topts.suffix = \"~\"\n62\t\t}\n63\t\tif len(args) == 0 {\n64\t\t\tfmt.Fprintln(os.Stderr, \"install: missing file operand\")\n65\t\t\tos.Exit(1)\n66\t\t}\n67\t\tif opts.directory {\n68\t\t\tos.Exit(createDirectories(opts, args))\n69\t\t}\n70\t\tif len(args) == 1 {\n71\t\t\tfmt.Fprintf(os.Stderr,\n72\t\t\t\t\"install: missing destination file operand after '%s'\\n\", args[0])\n73\t\t\tos.Exit(1)\n74\t\t}\n75\t\n76\t\tdest := args[len(args)-1]\n77\t\tsources := args[:len(args)-1]\n78\t\n79\t\texitCode := 0\n80\t\tif len(sources) > 1 {\n81\t\t\texitCode = installMultiple(opts, sources, dest)\n82\t\t} else {\n83\t\t\tif err := installSingle(opts, sources[0], dest); err != nil {\n84\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n85\t\t\t\texitCode = 1\n86\t\t\t}\n87\t\t}\n88\t\tif exitCode != 0 {\n89\t\t\tos.Exit(exitCode)\n90\t\t}\n91\t}\n92\t\n93\tfunc createDirectories(opts options, dirs []string) int {\n94\t\texitCode := 0\n95\t\tfor _, dir := range dirs {\n96\t\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n97\t\t\t\tfmt.Fprintf(os.Stderr, \"install: cannot create directory '%s': %s\\n\",\n98\t\t\t\t\tdir, unwrapErr(err))\n99\t\t\t\texitCode = 1\n100\t\t\t\tcontinue\n101\t\t\t}\n102\t\t\tif err := setMode(opts, dir); err != nil {\n103\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n104\t\t\t\texitCode = 1\n105\t\t\t\tcontinue\n106\t\t\t}\n107\t\t\tif err := setOwnership(opts, dir); err != nil {\n108\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n109\t\t\t\texitCode = 1\n110\t\t\t\tcontinue\n111\t\t\t}\n112\t\t\tif opts.verbose {\n113\t\t\t\tfmt.Fprintf(os.Stdout,\n114\t\t\t\t\t\"install: creating directory '%s'\\n\", dir)\n115\t\t\t}\n116\t\t}\n117\t\treturn exitCode\n118\t}\n119\t\n120\tfunc installMultiple(opts options, sources []string, dest string) int {\n121\t\tfi, err := os.Stat(dest)\n122\t\tif err != nil || !fi.IsDir() {\n123\t\t\tfmt.Fprintf(os.Stderr,\n124\t\t\t\t\"install: target '%s' is not a directory\\n\", dest)\n125\t\t\treturn 1\n126\t\t}\n127\t\texitCode := 0\n128\t\tfor _, src := range sources {\n129\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n130\t\t\tif err := installSingle(opts, src, target); err != nil {\n131\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n132\t\t\t\texitCode = 1\n133\t\t\t}\n134\t\t}\n135\t\treturn exitCode\n136\t}\n137\t\n138\tfunc installSingle(opts options, src, dest string) error {\n139\t\tsrcInfo, err := os.Stat(src)\n140\t\tif err != nil {\n141\t\t\treturn fmt.Errorf(\"cannot stat '%s': %s\", src, unwrapErr(err))\n142\t\t}\n143\t\tif srcInfo.IsDir() {\n144\t\t\treturn fmt.Errorf(\"omitting directory '%s'\", src)\n145\t\t}\n146\t\tif fi, err := os.Stat(dest); err == nil && fi.IsDir() {\n147\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n148\t\t}\n149\t\tif opts.createDir {\n150\t\t\tdir := filepath.Dir(dest)\n151\t\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n152\t\t\t\treturn fmt.Errorf(\"cannot create directory '%s': %s\",\n153\t\t\t\t\tdir, unwrapErr(err))\n154\t\t\t}\n155\t\t}\n156\t\tif opts.backup {\n157\t\t\tif err := backupFile(dest, opts.suffix); err != nil {\n158\t\t\t\treturn err\n159\t\t\t}\n160\t\t}\n161\t\tif err := copyFile(src, dest); err != nil {\n162\t\t\treturn err\n163\t\t}\n164\t\tif err := setMode(opts, dest); err != nil {\n165\t\t\treturn err\n166\t\t}\n167\t\tif err := setOwnership(opts, dest); err != nil {\n168\t\t\treturn err\n169\t\t}\n170\t\tif opts.verbose {\n171\t\t\tfmt.Fprintf(os.Stdout, \"'%s' -> '%s'\\n\", src, dest)\n172\t\t}\n173\t\treturn nil\n174\t}\n175\t\n176\tfunc backupFile(dest, suffix string) error {\n177\t\tif _, err := os.Stat(dest); err != nil {\n178\t\t\treturn nil\n179\t\t}\n180\t\tbackup := dest + suffix\n181\t\tif err := os.Rename(dest, backup); err != nil {\n182\t\t\treturn fmt.Errorf(\"cannot backup '%s': %s\", dest, unwrapErr(err))\n183\t\t}\n184\t\treturn nil\n185\t}\n186\t\n187\tfunc copyFile(src, dest string) error {\n188\t\tsf, err := os.Open(src)\n189\t\tif err != nil {\n190\t\t\treturn fmt.Errorf(\"cannot open '%s': %s\", src, unwrapErr(err))\n191\t\t}\n192\t\tdefer sf.Close()\n193\t\n194\t\tdf, err := os.Create(dest)\n195\t\tif err != nil {\n196\t\t\treturn fmt.Errorf(\"cannot create regular file '%s': %s\",\n197\t\t\t\tdest, unwrapErr(err))\n198\t\t}\n199\t\tdefer df.Close()\n200\t\n201\t\tif _, err := io.Copy(df, sf); err != nil {\n202\t\t\treturn fmt.Errorf(\"writing '%s': %s\", dest, unwrapErr(err))\n203\t\t}\n204\t\treturn df.Close()\n205\t}\n206\t\n207\tfunc setMode(opts options, path string) error {\n208\t\tif opts.mode == \"\" {\n209\t\t\treturn os.Chmod(path, 0755)\n210\t\t}\n211\t\tperm, err := resolveMode(opts.mode)\n212\t\tif err != nil {\n213\t\t\treturn fmt.Errorf(\"invalid mode '%s'\", opts.mode)\n214\t\t}\n215\t\treturn os.Chmod(path, perm)\n216\t}\n217\t\n218\tfunc resolveMode(mode string) (os.FileMode, error) {\n219\t\tif isOctalMode(mode) {\n220\t\t\tval, err := strconv.ParseUint(mode, 8, 32)\n221\t\t\tif err != nil {\n222\t\t\t\treturn 0, err\n223\t\t\t}\n224\t\t\treturn os.FileMode(val), nil\n225\t\t}\n226\t\treturn evalSymbolic(mode, 0, getUmask())\n227\t}\n228\t\n229\tfunc getUmask() os.FileMode {\n230\t\told := syscall.Umask(0)\n231\t\tsyscall.Umask(old)\n232\t\treturn os.FileMode(old)\n233\t}\n234\t\n235\tfunc setOwnership(opts options, path string) error {\n236\t\tuid, gid := -1, -1\n237\t\tif opts.owner != \"\" {\n238\t\t\tvar err error\n239\t\t\tuid, err = lookupUser(opts.owner)\n240\t\t\tif err != nil {\n241\t\t\t\treturn err\n242\t\t\t}\n243\t\t}\n244\t\tif opts.group != \"\" {\n245\t\t\tvar err error\n246\t\t\tgid, err = lookupGroup(opts.group)\n247\t\t\tif err != nil {\n248\t\t\t\treturn err\n249\t\t\t}\n250\t\t}\n251\t\tif uid == -1 && gid == -1 {\n252\t\t\treturn nil\n253\t\t}\n254\t\tif err := os.Chown(path, uid, gid); err != nil {\n255\t\t\treturn fmt.Errorf(\"cannot change ownership of '%s': %s\",\n256\t\t\t\tpath, unwrapErr(err))\n257\t\t}\n258\t\treturn nil\n259\t}\n260\t\n261\tfunc lookupUser(name string) (int, error) {\n262\t\tif uid, err := strconv.Atoi(name); err == nil {\n263\t\t\treturn uid, nil\n264\t\t}\n265\t\tu, err := user.Lookup(name)\n266\t\tif err != nil {\n267\t\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n268\t\t}\n269\t\tuid, err := strconv.Atoi(u.Uid)\n270\t\tif err != nil {\n271\t\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n272\t\t}\n273\t\treturn uid, nil\n274\t}\n275\t\n276\tfunc lookupGroup(name string) (int, error) {\n277\t\tif gid, err := strconv.Atoi(name); err == nil {\n278\t\t\treturn gid, nil\n279\t\t}\n280\t\tg, err := user.LookupGroup(name)\n281\t\tif err != nil {\n282\t\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n283\t\t}\n284\t\tgid, err := strconv.Atoi(g.Gid)\n285\t\tif err != nil {\n286\t\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n287\t\t}\n288\t\treturn gid, nil\n289\t}\n290\t\n291\tfunc unwrapErr(err error) string {\n292\t\tif pe, ok := err.(*os.PathError); ok {\n293\t\t\treturn pe.Err.Error()\n294\t\t}\n295\t\treturn err.Error()\n296\t}\n297\t\n298\tfunc parseArgs(args []string) (options, []string) {\n299\t\tvar opts options\n300\t\tvar operands []string\n301\t\tendOfFlags := false\n302\t\ti := 0\n303\t\tfor i < len(args) {\n304\t\t\targ := args[i]\n305\t\t\tif endOfFlags {\n306\t\t\t\toperands = append(operands, arg)\n307\t\t\t\ti++\n308\t\t\t\tcontinue\n309\t\t\t}\n310\t\t\tif arg == \"--\" {\n311\t\t\t\tendOfFlags = true\n312\t\t\t\ti++\n313\t\t\t\tcontinue\n314\t\t\t}\n315\t\t\tif strings.HasPrefix(arg, \"--\") {\n316\t\t\t\ti = parseLongFlag(args, i, &opts)\n317\t\t\t\tcontinue\n318\t\t\t}\n319\t\t\tif strings.HasPrefix(arg, \"-\") && len(arg) > 1 {\n320\t\t\t\ti = parseShortFlags(args, i, &opts)\n321\t\t\t\tcontinue\n322\t\t\t}\n323\t\t\toperands = append(operands, arg)\n324\t\t\ti++\n325\t\t}\n326\t\treturn opts, operands\n327\t}\n328\t\n329\tfunc parseLongFlag(args []string, i int, opts *options) int {\n330\t\targ := args[i]\n331\t\tswitch {\n332\t\tcase arg == \"--help\":\n333\t\t\tfmt.Fprint(os.Stdout, helpText)\n334\t\t\tos.Exit(0)\n335\t\tcase arg == \"--version\":\n336\t\t\tfmt.Fprint(os.Stdout, versionText)\n337\t\t\tos.Exit(0)\n338\t\tcase arg == \"--directory\":\n339\t\t\topts.directory = true\n340\t\tcase arg == \"--backup\":\n341\t\t\topts.backup = true\n342\t\tcase arg == \"--verbose\":\n343\t\t\topts.verbose = true\n344\t\tcase strings.HasPrefix(arg, \"--mode=\"):\n345\t\t\topts.mode = arg[len(\"--mode=\"):]\n346\t\tcase strings.HasPrefix(arg, \"--owner=\"):\n347\t\t\topts.owner = arg[len(\"--owner=\"):]\n348\t\tcase strings.HasPrefix(arg, \"--group=\"):\n349\t\t\topts.group = arg[len(\"--group=\"):]\n350\t\tcase strings.HasPrefix(arg, \"--suffix=\"):\n351\t\t\topts.suffix = arg[len(\"--suffix=\"):]\n352\t\t}\n353\t\treturn i + 1\n354\t}\n355\t\n356\tfunc parseShortFlags(args []string, i int, opts *options) int {\n357\t\tflags := args[i][1:]\n358\t\tj := 0\n359\t\tfor j < len(flags) {\n360\t\t\tswitch flags[j] {\n361\t\t\tcase 'm':\n362\t\t\t\topts.mode = consumeValue(flags, j+1, args, &i)\n363\t\t\t\treturn i + 1\n364\t\t\tcase 'o':\n365\t\t\t\topts.owner = consumeValue(flags, j+1, args, &i)\n366\t\t\t\treturn i + 1\n367\t\t\tcase 'g':\n368\t\t\t\topts.group = consumeValue(flags, j+1, args, &i)\n369\t\t\t\treturn i + 1\n370\t\t\tcase 'd':\n371\t\t\t\topts.directory = true\n372\t\t\tcase 'D':\n373\t\t\t\topts.createDir = true\n374\t\t\tcase 'b':\n375\t\t\t\topts.backup = true\n376\t\t\tcase 'v':\n377\t\t\t\topts.verbose = true\n378\t\t\tcase 'c':\n379\t\t\t\tj++\n380\t\t\t\tcontinue\n381\t\t\tdefault:\n382\t\t\t\tfmt.Fprintf(os.Stderr,\n383\t\t\t\t\t\"install: invalid option -- '%c'\\n\", flags[j])\n384\t\t\t\tos.Exit(1)\n385\t\t\t}\n386\t\t\tj++\n387\t\t}\n388\t\treturn i + 1\n389\t}\n390\t\n391\tfunc consumeValue(flags string, pos int, args []string, i *int) string {\n392\t\tif pos < len(flags) {\n393\t\t\treturn flags[pos:]\n394\t\t}\n395\t\tif *i+1 < len(args) {\n396\t\t\t*i++\n397\t\t\treturn args[*i]\n398\t\t}\n399\t\treturn \"\"\n400\t}\n401\t"}]},"parent_tool_use_id":null,"session_id":"81dea4c7-429d-4c2f-9db0-26c45684447d","uuid":"44c0b895-fc44-405d-8571-556e4e8454f0","timestamp":"2026-05-27T15:10:42.604Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5594/cmd/install/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/install implements srd101-install R1.1-R1.4, R2.1-R2.4.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: install [OPTION]... [-T] SOURCE DEST\n  or:  install [OPTION]... SOURCE... DIRECTORY\n  or:  install [OPTION]... -d DIRECTORY...\n\nCopy files and set attributes.\n\n  -b                  make a backup of each existing destination file\n  -c                  (ignored)\n  -d, --directory     treat all arguments as directory names; create all\n                        components of the specified directories\n  -D                  create all leading components of DEST except the last,\n                        or all components of --target-directory, then copy SOURCE to DEST\n  -g GROUP            set group ownership\n  -m MODE             set permission mode (as in chmod), instead of rwxr-xr-x\n  -o OWNER            set ownership\n      --backup        make a backup of each existing destination file\n      --suffix=SUFFIX override the usual backup suffix\n  -v, --verbose       print the name of each directory as it is created\n      --help          display this help and exit\n      --version       output version information and exit\n`\n\nconst versionText = `install (go-unix-utils) dev\n`\n\ntype options struct {\n\tmode      string\n\towner     string\n\tgroup     string\n\tdirectory bool\n\tcreateDir bool\n\tbackup    bool\n\tsuffix    string\n\tverbose   bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, args := parseArgs(os.Args[1:])\n\tif opts.suffix == \"\" {\n\t\topts.suffix = \"~\"\n\t}\n\tif len(args) == 0 {\n\t\tfmt.Fprintln(os.Stderr, \"install: missing file operand\")\n\t\tos.Exit(1)\n\t}\n\tif opts.directory {\n\t\tos.Exit(createDirectories(opts, args))\n\t}\n\tif len(args) == 1 {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"install: missing destination file operand after '%s'\\n\", args[0])\n\t\tos.Exit(1)\n\t}\n\n\tdest := args[len(args)-1]\n\tsources := args[:len(args)-1]\n\n\texitCode := 0\n\tif len(sources) > 1 {\n\t\texitCode = installMultiple(opts, sources, dest)\n\t} else {\n\t\tif err := installSingle(opts, sources[0], dest); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc createDirectories(opts options, dirs []string) int {\n\texitCode := 0\n\tfor _, dir := range dirs {\n\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: cannot create directory '%s': %s\\n\",\n\t\t\t\tdir, unwrapErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif err := setMode(opts, dir); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif err := setOwnership(opts, dir); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif opts.verbose {\n\t\t\tfmt.Fprintf(os.Stdout,\n\t\t\t\t\"install: creating directory '%s'\\n\", dir)\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc installMultiple(opts options, sources []string, dest string) int {\n\tfi, err := os.Stat(dest)\n\tif err != nil || !fi.IsDir() {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"install: target '%s' is not a directory\\n\", dest)\n\t\treturn 1\n\t}\n\texitCode := 0\n\tfor _, src := range sources {\n\t\ttarget := filepath.Join(dest, filepath.Base(src))\n\t\tif err := installSingle(opts, src, target); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc installSingle(opts options, src, dest string) error {\n\tsrcInfo, err := os.Stat(src)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cannot stat '%s': %s\", src, unwrapErr(err))\n\t}\n\tif srcInfo.IsDir() {\n\t\treturn fmt.Errorf(\"omitting directory '%s'\", src)\n\t}\n\tif fi, err := os.Stat(dest); err == nil && fi.IsDir() {\n\t\tdest = filepath.Join(dest, filepath.Base(src))\n\t}\n\tif opts.createDir {\n\t\tdir := filepath.Dir(dest)\n\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n\t\t\treturn fmt.Errorf(\"cannot create directory '%s': %s\",\n\t\t\t\tdir, unwrapErr(err))\n\t\t}\n\t}\n\tif opts.backup {\n\t\tif err := backupFile(dest, opts.suffix); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := copyFile(src, dest); err != nil {\n\t\treturn err\n\t}\n\tif err := setMode(opts, dest); err != nil {\n\t\treturn err\n\t}\n\tif err := setOwnership(opts, dest); err != nil {\n\t\treturn err\n\t}\n\tif opts.verbose {\n\t\tfmt.Fprintf(os.Stdout, \"'%s' -> '%s'\\n\", src, dest)\n\t}\n\treturn nil\n}\n\nfunc backupFile(dest, suffix string) error {\n\tif _, err := os.Stat(dest); err != nil {\n\t\treturn nil\n\t}\n\tbackup := dest + suffix\n\tif err := os.Rename(dest, backup); err != nil {\n\t\treturn fmt.Errorf(\"cannot backup '%s': %s\", dest, unwrapErr(err))\n\t}\n\treturn nil\n}\n\nfunc copyFile(src, dest string) error {\n\tsf, err := os.Open(src)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cannot open '%s': %s\", src, unwrapErr(err))\n\t}\n\tdefer sf.Close()\n\n\tdf, err := os.Create(dest)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cannot create regular file '%s': %s\",\n\t\t\tdest, unwrapErr(err))\n\t}\n\tdefer df.Close()\n\n\tif _, err := io.Copy(df, sf); err != nil {\n\t\treturn fmt.Errorf(\"writing '%s': %s\", dest, unwrapErr(err))\n\t}\n\treturn df.Close()\n}\n\nfunc setMode(opts options, path string) error {\n\tif opts.mode == \"\" {\n\t\treturn os.Chmod(path, 0755)\n\t}\n\tperm, err := resolveMode(opts.mode)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid mode '%s'\", opts.mode)\n\t}\n\treturn os.Chmod(path, perm)\n}\n\nfunc resolveMode(mode string) (os.FileMode, error) {\n\tif isOctalMode(mode) {\n\t\tval, err := strconv.ParseUint(mode, 8, 32)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\treturn os.FileMode(val), nil\n\t}\n\treturn evalSymbolic(mode, 0, getUmask())\n}\n\nfunc getUmask() os.FileMode {\n\told := syscall.Umask(0)\n\tsyscall.Umask(old)\n\treturn os.FileMode(old)\n}\n\nfunc setOwnership(opts options, path string) error {\n\tuid, gid := -1, -1\n\tif opts.owner != \"\" {\n\t\tvar err error\n\t\tuid, err = lookupUser(opts.owner)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif opts.group != \"\" {\n\t\tvar err error\n\t\tgid, err = lookupGroup(opts.group)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif uid == -1 && gid == -1 {\n\t\treturn nil\n\t}\n\tif err := os.Chown(path, uid, gid); err != nil {\n\t\treturn fmt.Errorf(\"cannot change ownership of '%s': %s\",\n\t\t\tpath, unwrapErr(err))\n\t}\n\treturn nil\n}\n\nfunc lookupUser(name string) (int, error) {\n\tif uid, err := strconv.Atoi(name); err == nil {\n\t\treturn uid, nil\n\t}\n\tu, err := user.Lookup(name)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n\t}\n\tuid, err := strconv.Atoi(u.Uid)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n\t}\n\treturn uid, nil\n}\n\nfunc lookupGroup(name string) (int, error) {\n\tif gid, err := strconv.Atoi(name); err == nil {\n\t\treturn gid, nil\n\t}\n\tg, err := user.LookupGroup(name)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n\t}\n\tgid, err := strconv.Atoi(g.Gid)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n\t}\n\treturn gid, nil\n}\n\nfunc unwrapErr(err error) string {\n\tif pe, ok := err.(*os.PathError); ok {\n\t\treturn pe.Err.Error()\n\t}\n\treturn err.Error()\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar operands []string\n\tendOfFlags := false\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif endOfFlags {\n\t\t\toperands = append(operands, arg)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\ti = parseLongFlag(args, i, &opts)\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"-\") && len(arg) > 1 {\n\t\t\ti = parseShortFlags(args, i, &opts)\n\t\t\tcontinue\n\t\t}\n\t\toperands = append(operands, arg)\n\t\ti++\n\t}\n\treturn opts, operands\n}\n\nfunc parseLongFlag(args []string, i int, opts *options) int {\n\targ := args[i]\n\tswitch {\n\tcase arg == \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase arg == \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase arg == \"--directory\":\n\t\topts.directory = true\n\tcase arg == \"--backup\":\n\t\topts.backup = true\n\tcase arg == \"--verbose\":\n\t\topts.verbose = true\n\tcase strings.HasPrefix(arg, \"--mode=\"):\n\t\topts.mode = arg[len(\"--mode=\"):]\n\tcase strings.HasPrefix(arg, \"--owner=\"):\n\t\topts.owner = arg[len(\"--owner=\"):]\n\tcase strings.HasPrefix(arg, \"--group=\"):\n\t\topts.group = arg[len(\"--group=\"):]\n\tcase strings.HasPrefix(arg, \"--suffix=\"):\n\t\topts.suffix = arg[len(\"--suffix=\"):]\n\t}\n\treturn i + 1\n}\n\nfunc parseShortFlags(args []string, i int, opts *options) int {\n\tflags := args[i][1:]\n\tj := 0\n\tfor j < len(flags) {\n\t\tswitch flags[j] {\n\t\tcase 'm':\n\t\t\topts.mode = consumeValue(flags, j+1, args, &i)\n\t\t\treturn i + 1\n\t\tcase 'o':\n\t\t\topts.owner = consumeValue(flags, j+1,