{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P5b64A4NHuL17VDyk5F5mE","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/install implements srd101-install R1.1-R1.4, R2.1-R2.4, R3.1-R3.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"os/user\"\n13\t\t\"path/filepath\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"syscall\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n19\t)\n20\t\n21\tconst helpText = `Usage: install [OPTION]... [-T] SOURCE DEST\n22\t  or:  install [OPTION]... SOURCE... DIRECTORY\n23\t  or:  install [OPTION]... -d DIRECTORY...\n24\t\n25\tCopy files and set attributes.\n26\t\n27\t  -b                  make a backup of each existing destination file\n28\t  -C, --compare       compare source and destination files, and if the\n29\t                        destination has the same content and any specified\n30\t                        owner, group, and permissions, do not modify it\n31\t  -c                  (ignored)\n32\t  -d, --directory     treat all arguments as directory names; create all\n33\t                        components of the specified directories\n34\t  -D                  create all leading components of DEST except the last,\n35\t                        or all components of --target-directory, then copy SOURCE to DEST\n36\t  -g GROUP            set group ownership\n37\t  -m MODE             set permission mode (as in chmod), instead of rwxr-xr-x\n38\t  -o OWNER            set ownership\n39\t      --backup        make a backup of each existing destination file\n40\t      --suffix=SUFFIX override the usual backup suffix\n41\t  -v, --verbose       print the name of each directory as it is created\n42\t      --help          display this help and exit\n43\t      --version       output version information and exit\n44\t`\n45\t\n46\tconst versionText = `install (go-unix-utils) dev\n47\t`\n48\t\n49\ttype options struct {\n50\t\tmode      string\n51\t\towner     string\n52\t\tgroup     string\n53\t\tdirectory bool\n54\t\tcreateDir bool\n55\t\tcompare   bool\n56\t\tbackup    bool\n57\t\tsuffix    string\n58\t\tverbose   bool\n59\t}\n60\t\n61\tfunc main() {\n62\t\tsys.InstallSIGPIPEHandler()\n63\t\n64\t\topts, args := parseArgs(os.Args[1:])\n65\t\tif opts.suffix == \"\" {\n66\t\t\topts.suffix = \"~\"\n67\t\t}\n68\t\tif len(args) == 0 {\n69\t\t\tfmt.Fprintln(os.Stderr, \"install: missing file operand\")\n70\t\t\tos.Exit(1)\n71\t\t}\n72\t\tif opts.directory {\n73\t\t\tos.Exit(createDirectories(opts, args))\n74\t\t}\n75\t\tif len(args) == 1 {\n76\t\t\tfmt.Fprintf(os.Stderr,\n77\t\t\t\t\"install: missing destination file operand after '%s'\\n\", args[0])\n78\t\t\tos.Exit(1)\n79\t\t}\n80\t\n81\t\tdest := args[len(args)-1]\n82\t\tsources := args[:len(args)-1]\n83\t\n84\t\texitCode := 0\n85\t\tif len(sources) > 1 {\n86\t\t\texitCode = installMultiple(opts, sources, dest)\n87\t\t} else {\n88\t\t\tif err := installSingle(opts, sources[0], dest); err != nil {\n89\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n90\t\t\t\texitCode = 1\n91\t\t\t}\n92\t\t}\n93\t\tif exitCode != 0 {\n94\t\t\tos.Exit(exitCode)\n95\t\t}\n96\t}\n97\t\n98\tfunc createDirectories(opts options, dirs []string) int {\n99\t\texitCode := 0\n100\t\tfor _, dir := range dirs {\n101\t\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n102\t\t\t\tfmt.Fprintf(os.Stderr, \"install: cannot create directory '%s': %s\\n\",\n103\t\t\t\t\tdir, unwrapErr(err))\n104\t\t\t\texitCode = 1\n105\t\t\t\tcontinue\n106\t\t\t}\n107\t\t\tif err := setMode(opts, dir); err != nil {\n108\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n109\t\t\t\texitCode = 1\n110\t\t\t\tcontinue\n111\t\t\t}\n112\t\t\tif err := setOwnership(opts, dir); err != nil {\n113\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n114\t\t\t\texitCode = 1\n115\t\t\t\tcontinue\n116\t\t\t}\n117\t\t\tif opts.verbose {\n118\t\t\t\tfmt.Fprintf(os.Stdout,\n119\t\t\t\t\t\"install: creating directory '%s'\\n\", dir)\n120\t\t\t}\n121\t\t}\n122\t\treturn exitCode\n123\t}\n124\t\n125\tfunc installMultiple(opts options, sources []string, dest string) int {\n126\t\tfi, err := os.Stat(dest)\n127\t\tif err != nil || !fi.IsDir() {\n128\t\t\tfmt.Fprintf(os.Stderr,\n129\t\t\t\t\"install: target '%s' is not a directory\\n\", dest)\n130\t\t\treturn 1\n131\t\t}\n132\t\texitCode := 0\n133\t\tfor _, src := range sources {\n134\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n135\t\t\tif err := installSingle(opts, src, target); err != nil {\n136\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n137\t\t\t\texitCode = 1\n138\t\t\t}\n139\t\t}\n140\t\treturn exitCode\n141\t}\n142\t\n143\tfunc installSingle(opts options, src, dest string) error {\n144\t\tsrcInfo, err := os.Stat(src)\n145\t\tif err != nil {\n146\t\t\treturn fmt.Errorf(\"cannot stat '%s': %s\", src, unwrapErr(err))\n147\t\t}\n148\t\tif srcInfo.IsDir() {\n149\t\t\treturn fmt.Errorf(\"omitting directory '%s'\", src)\n150\t\t}\n151\t\tif fi, err := os.Stat(dest); err == nil && fi.IsDir() {\n152\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n153\t\t}\n154\t\tif opts.createDir {\n155\t\t\tdir := filepath.Dir(dest)\n156\t\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n157\t\t\t\treturn fmt.Errorf(\"cannot create directory '%s': %s\",\n158\t\t\t\t\tdir, unwrapErr(err))\n159\t\t\t}\n160\t\t}\n161\t\tif opts.compare && filesIdentical(src, dest, opts) {\n162\t\t\treturn nil\n163\t\t}\n164\t\tif opts.backup {\n165\t\t\tif err := backupFile(dest, opts.suffix); err != nil {\n166\t\t\t\treturn err\n167\t\t\t}\n168\t\t}\n169\t\tif err := copyFile(src, dest); err != nil {\n170\t\t\treturn err\n171\t\t}\n172\t\tif err := setMode(opts, dest); err != nil {\n173\t\t\treturn err\n174\t\t}\n175\t\tif err := setOwnership(opts, dest); err != nil {\n176\t\t\treturn err\n177\t\t}\n178\t\tif opts.verbose {\n179\t\t\tfmt.Fprintf(os.Stdout, \"'%s' -> '%s'\\n\", src, dest)\n180\t\t}\n181\t\treturn nil\n182\t}\n183\t\n184\tfunc backupFile(dest, suffix string) error {\n185\t\tif _, err := os.Stat(dest); err != nil {\n186\t\t\treturn nil\n187\t\t}\n188\t\tbackup := dest + suffix\n189\t\tif err := os.Rename(dest, backup); err != nil {\n190\t\t\treturn fmt.Errorf(\"cannot backup '%s': %s\", dest, unwrapErr(err))\n191\t\t}\n192\t\treturn nil\n193\t}\n194\t\n195\tfunc filesIdentical(src, dest string, opts options) bool {\n196\t\tdfi, err := os.Stat(dest)\n197\t\tif err != nil {\n198\t\t\treturn false\n199\t\t}\n200\t\tsfi, err := os.Stat(src)\n201\t\tif err != nil {\n202\t\t\treturn false\n203\t\t}\n204\t\tif sfi.Size() != dfi.Size() {\n205\t\t\treturn false\n206\t\t}\n207\t\tif dfi.Mode().Perm() != targetMode(opts) {\n208\t\t\treturn false\n209\t\t}\n210\t\treturn contentsEqual(src, dest)\n211\t}\n212\t\n213\tfunc targetMode(opts options) os.FileMode {\n214\t\tif opts.mode == \"\" {\n215\t\t\treturn 0755\n216\t\t}\n217\t\tperm, err := resolveMode(opts.mode)\n218\t\tif err != nil {\n219\t\t\treturn 0755\n220\t\t}\n221\t\treturn perm.Perm()\n222\t}\n223\t\n224\tfunc contentsEqual(a, b string) bool {\n225\t\taf, err := os.Open(a)\n226\t\tif err != nil {\n227\t\t\treturn false\n228\t\t}\n229\t\tdefer af.Close()\n230\t\tbf, err := os.Open(b)\n231\t\tif err != nil {\n232\t\t\treturn false\n233\t\t}\n234\t\tdefer bf.Close()\n235\t\tconst bufSize = 32 * 1024\n236\t\tabuf := make([]byte, bufSize)\n237\t\tbbuf := make([]byte, bufSize)\n238\t\tfor {\n239\t\t\tan, aerr := io.ReadFull(af, abuf)\n240\t\t\tbn, berr := io.ReadFull(bf, bbuf)\n241\t\t\tif !bytes.Equal(abuf[:an], bbuf[:bn]) {\n242\t\t\t\treturn false\n243\t\t\t}\n244\t\t\tif aerr == io.EOF && berr == io.EOF {\n245\t\t\t\treturn true\n246\t\t\t}\n247\t\t\tif aerr != nil && aerr != io.ErrUnexpectedEOF {\n248\t\t\t\treturn false\n249\t\t\t}\n250\t\t\tif berr != nil && berr != io.ErrUnexpectedEOF {\n251\t\t\t\treturn false\n252\t\t\t}\n253\t\t\tif an != bn {\n254\t\t\t\treturn false\n255\t\t\t}\n256\t\t}\n257\t}\n258\t\n259\tfunc copyFile(src, dest string) error {\n260\t\tsf, err := os.Open(src)\n261\t\tif err != nil {\n262\t\t\treturn fmt.Errorf(\"cannot open '%s': %s\", src, unwrapErr(err))\n263\t\t}\n264\t\tdefer sf.Close()\n265\t\n266\t\tdf, err := os.Create(dest)\n267\t\tif err != nil {\n268\t\t\treturn fmt.Errorf(\"cannot create regular file '%s': %s\",\n269\t\t\t\tdest, unwrapErr(err))\n270\t\t}\n271\t\tdefer df.Close()\n272\t\n273\t\tif _, err := io.Copy(df, sf); err != nil {\n274\t\t\treturn fmt.Errorf(\"writing '%s': %s\", dest, unwrapErr(err))\n275\t\t}\n276\t\treturn df.Close()\n277\t}\n278\t\n279\tfunc setMode(opts options, path string) error {\n280\t\tif opts.mode == \"\" {\n281\t\t\treturn os.Chmod(path, 0755)\n282\t\t}\n283\t\tperm, err := resolveMode(opts.mode)\n284\t\tif err != nil {\n285\t\t\treturn fmt.Errorf(\"invalid mode '%s'\", opts.mode)\n286\t\t}\n287\t\treturn os.Chmod(path, perm)\n288\t}\n289\t\n290\tfunc resolveMode(mode string) (os.FileMode, error) {\n291\t\tif isOctalMode(mode) {\n292\t\t\tval, err := strconv.ParseUint(mode, 8, 32)\n293\t\t\tif err != nil {\n294\t\t\t\treturn 0, err\n295\t\t\t}\n296\t\t\treturn os.FileMode(val), nil\n297\t\t}\n298\t\treturn evalSymbolic(mode, 0, getUmask())\n299\t}\n300\t\n301\tfunc getUmask() os.FileMode {\n302\t\told := syscall.Umask(0)\n303\t\tsyscall.Umask(old)\n304\t\treturn os.FileMode(old)\n305\t}\n306\t\n307\tfunc setOwnership(opts options, path string) error {\n308\t\tuid, gid := -1, -1\n309\t\tif opts.owner != \"\" {\n310\t\t\tvar err error\n311\t\t\tuid, err = lookupUser(opts.owner)\n312\t\t\tif err != nil {\n313\t\t\t\treturn err\n314\t\t\t}\n315\t\t}\n316\t\tif opts.group != \"\" {\n317\t\t\tvar err error\n318\t\t\tgid, err = lookupGroup(opts.group)\n319\t\t\tif err != nil {\n320\t\t\t\treturn err\n321\t\t\t}\n322\t\t}\n323\t\tif uid == -1 && gid == -1 {\n324\t\t\treturn nil\n325\t\t}\n326\t\tif err := os.Chown(path, uid, gid); err != nil {\n327\t\t\treturn fmt.Errorf(\"cannot change ownership of '%s': %s\",\n328\t\t\t\tpath, unwrapErr(err))\n329\t\t}\n330\t\treturn nil\n331\t}\n332\t\n333\tfunc lookupUser(name string) (int, error) {\n334\t\tif uid, err := strconv.Atoi(name); err == nil {\n335\t\t\treturn uid, nil\n336\t\t}\n337\t\tu, err := user.Lookup(name)\n338\t\tif err != nil {\n339\t\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n340\t\t}\n341\t\tuid, err := strconv.Atoi(u.Uid)\n342\t\tif err != nil {\n343\t\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n344\t\t}\n345\t\treturn uid, nil\n346\t}\n347\t\n348\tfunc lookupGroup(name string) (int, error) {\n349\t\tif gid, err := strconv.Atoi(name); err == nil {\n350\t\t\treturn gid, nil\n351\t\t}\n352\t\tg, err := user.LookupGroup(name)\n353\t\tif err != nil {\n354\t\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n355\t\t}\n356\t\tgid, err := strconv.Atoi(g.Gid)\n357\t\tif err != nil {\n358\t\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n359\t\t}\n360\t\treturn gid, nil\n361\t}\n362\t\n363\tfunc unwrapErr(err error) string {\n364\t\tif pe, ok := err.(*os.PathError); ok {\n365\t\t\treturn pe.Err.Error()\n366\t\t}\n367\t\treturn err.Error()\n368\t}\n369\t\n370\tfunc parseArgs(args []string) (options, []string) {\n371\t\tvar opts options\n372\t\tvar operands []string\n373\t\tendOfFlags := false\n374\t\ti := 0\n375\t\tfor i < len(args) {\n376\t\t\targ := args[i]\n377\t\t\tif endOfFlags {\n378\t\t\t\toperands = append(operands, arg)\n379\t\t\t\ti++\n380\t\t\t\tcontinue\n381\t\t\t}\n382\t\t\tif arg == \"--\" {\n383\t\t\t\tendOfFlags = true\n384\t\t\t\ti++\n385\t\t\t\tcontinue\n386\t\t\t}\n387\t\t\tif strings.HasPrefix(arg, \"--\") {\n388\t\t\t\ti = parseLongFlag(args, i, &opts)\n389\t\t\t\tcontinue\n390\t\t\t}\n391\t\t\tif strings.HasPrefix(arg, \"-\") && len(arg) > 1 {\n392\t\t\t\ti = parseShortFlags(args, i, &opts)\n393\t\t\t\tcontinue\n394\t\t\t}\n395\t\t\toperands = append(operands, arg)\n396\t\t\ti++\n397\t\t}\n398\t\treturn opts, operands\n399\t}\n400\t\n401\tfunc parseLongFlag(args []string, i int, opts *options) int {\n402\t\targ := args[i]\n403\t\tswitch {\n404\t\tcase arg == \"--help\":\n405\t\t\tfmt.Fprint(os.Stdout, helpText)\n406\t\t\tos.Exit(0)\n407\t\tcase arg == \"--version\":\n408\t\t\tfmt.Fprint(os.Stdout, versionText)\n409\t\t\tos.Exit(0)\n410\t\tcase arg == \"--directory\":\n411\t\t\topts.directory = true\n412\t\tcase arg == \"--compare\":\n413\t\t\topts.compare = true\n414\t\tcase arg == \"--backup\":\n415\t\t\topts.backup = true\n416\t\tcase arg == \"--verbose\":\n417\t\t\topts.verbose = true\n418\t\tcase strings.HasPrefix(arg, \"--mode=\"):\n419\t\t\topts.mode = arg[len(\"--mode=\"):]\n420\t\tcase strings.HasPrefix(arg, \"--owner=\"):\n421\t\t\topts.owner = arg[len(\"--owner=\"):]\n422\t\tcase strings.HasPrefix(arg, \"--group=\"):\n423\t\t\topts.group = arg[len(\"--group=\"):]\n424\t\tcase strings.HasPrefix(arg, \"--suffix=\"):\n425\t\t\topts.suffix = arg[len(\"--suffix=\"):]\n426\t\t}\n427\t\treturn i + 1\n428\t}\n429\t\n430\tfunc parseShortFlags(args []string, i int, opts *options) int {\n431\t\tflags := args[i][1:]\n432\t\tj := 0\n433\t\tfor j < len(flags) {\n434\t\t\tswitch flags[j] {\n435\t\t\tcase 'm':\n436\t\t\t\topts.mode = consumeValue(flags, j+1, args, &i)\n437\t\t\t\treturn i + 1\n438\t\t\tcase 'o':\n439\t\t\t\topts.owner = consumeValue(flags, j+1, args, &i)\n440\t\t\t\treturn i + 1\n441\t\t\tcase 'g':\n442\t\t\t\topts.group = consumeValue(flags, j+1, args, &i)\n443\t\t\t\treturn i + 1\n444\t\t\tcase 'd':\n445\t\t\t\topts.directory = true\n446\t\t\tcase 'C':\n447\t\t\t\topts.compare = true\n448\t\t\tcase 'D':\n449\t\t\t\topts.createDir = true\n450\t\t\tcase 'b':\n451\t\t\t\topts.backup = true\n452\t\t\tcase 'v':\n453\t\t\t\topts.verbose = true\n454\t\t\tcase 'c':\n455\t\t\t\tj++\n456\t\t\t\tcontinue\n457\t\t\tdefault:\n458\t\t\t\tfmt.Fprintf(os.Stderr,\n459\t\t\t\t\t\"install: invalid option -- '%c'\\n\", flags[j])\n460\t\t\t\tos.Exit(1)\n461\t\t\t}\n462\t\t\tj++\n463\t\t}\n464\t\treturn i + 1\n465\t}\n466\t\n467\tfunc consumeValue(flags string, pos int, args []string, i *int) string {\n468\t\tif pos < len(flags) {\n469\t\t\treturn flags[pos:]\n470\t\t}\n471\t\tif *i+1 < len(args) {\n472\t\t\t*i++\n473\t\t\treturn args[*i]\n474\t\t}\n475\t\treturn \"\"\n476\t}\n477\t"}]},"parent_tool_use_id":null,"session_id":"81dea4c7-429d-4c2f-9db0-26c45684447d","uuid":"05aff947-8ebe-440c-ba60-4cdac43f9852","timestamp":"2026-05-27T15:12:32.485Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5594/cmd/install/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/install implements srd101-install R1.1-R1.4, R2.1-R2.4, R3.1-R3.3.\npackage main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: install [OPTION]... [-T] SOURCE DEST\n  or:  install [OPTION]... SOURCE... DIRECTORY\n  or:  install [OPTION]... -d DIRECTORY...\n\nCopy files and set attributes.\n\n  -b                  make a backup of each existing destination file\n  -C, --compare       compare source and destination files, and if the\n                        destination has the same content and any specified\n                        owner, group, and permissions, do not modify it\n  -c                  (ignored)\n  -d, --directory     treat all arguments as directory names; create all\n                        components of the specified directories\n  -D                  create all leading components of DEST except the last,\n                        or all components of --target-directory, then copy SOURCE to DEST\n  -g GROUP            set group ownership\n  -m MODE             set permission mode (as in chmod), instead of rwxr-xr-x\n  -o OWNER            set ownership\n      --backup        make a backup of each existing destination file\n      --suffix=SUFFIX override the usual backup suffix\n  -v, --verbose       print the name of each directory as it is created\n      --help          display this help and exit\n      --version       output version information and exit\n`\n\nconst versionText = `install (go-unix-utils) dev\n`\n\ntype options struct {\n\tmode      string\n\towner     string\n\tgroup     string\n\tdirectory bool\n\tcreateDir bool\n\tcompare   bool\n\tbackup    bool\n\tsuffix    string\n\tverbose   bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, args := parseArgs(os.Args[1:])\n\tif opts.suffix == \"\" {\n\t\topts.suffix = \"~\"\n\t}\n\tif len(args) == 0 {\n\t\tfmt.Fprintln(os.Stderr, \"install: missing file operand\")\n\t\tos.Exit(1)\n\t}\n\tif opts.directory {\n\t\tos.Exit(createDirectories(opts, args))\n\t}\n\tif len(args) == 1 {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"install: missing destination file operand after '%s'\\n\", args[0])\n\t\tos.Exit(1)\n\t}\n\n\tdest := args[len(args)-1]\n\tsources := args[:len(args)-1]\n\n\texitCode := 0\n\tif len(sources) > 1 {\n\t\texitCode = installMultiple(opts, sources, dest)\n\t} else {\n\t\tif err := installSingle(opts, sources[0], dest); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc createDirectories(opts options, dirs []string) int {\n\texitCode := 0\n\tfor _, dir := range dirs {\n\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: cannot create directory '%s': %s\\n\",\n\t\t\t\tdir, unwrapErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif err := setMode(opts, dir); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif err := setOwnership(opts, dir); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif opts.verbose {\n\t\t\tfmt.Fprintf(os.Stdout,\n\t\t\t\t\"install: creating directory '%s'\\n\", dir)\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc installMultiple(opts options, sources []string, dest string) int {\n\tfi, err := os.Stat(dest)\n\tif err != nil || !fi.IsDir() {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"install: target '%s' is not a directory\\n\", dest)\n\t\treturn 1\n\t}\n\texitCode := 0\n\tfor _, src := range sources {\n\t\ttarget := filepath.Join(dest, filepath.Base(src))\n\t\tif err := installSingle(opts, src, target); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc installSingle(opts options, src, dest string) error {\n\tsrcInfo, err := os.Stat(src)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cannot stat '%s': %s\", src, unwrapErr(err))\n\t}\n\tif srcInfo.IsDir() {\n\t\treturn fmt.Errorf(\"omitting directory '%s'\", src)\n\t}\n\tif fi, err := os.Stat(dest); err == nil && fi.IsDir() {\n\t\tdest = filepath.Join(dest, filepath.Base(src))\n\t}\n\tif opts.createDir {\n\t\tdir := filepath.Dir(dest)\n\t\tif err := os.MkdirAll(dir, 0755); err != nil {\n\t\t\treturn fmt.Errorf(\"cannot create directory '%s': %s\",\n\t\t\t\tdir, unwrapErr(err))\n\t\t}\n\t}\n\tif opts.compare && filesIdentical(src, dest, opts) {\n\t\treturn nil\n\t}\n\tif opts.backup {\n\t\tif err := backupFile(dest, opts.suffix); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := copyFile(src, dest); err != nil {\n\t\treturn err\n\t}\n\tif err := setMode(opts, dest); err != nil {\n\t\treturn err\n\t}\n\tif err := setOwnership(opts, dest); err != nil {\n\t\treturn err\n\t}\n\tif opts.verbose {\n\t\tfmt.Fprintf(os.Stdout, \"'%s' -> '%s'\\n\", src, dest)\n\t}\n\treturn nil\n}\n\nfunc backupFile(dest, suffix string) error {\n\tif _, err := os.Stat(dest); err != nil {\n\t\treturn nil\n\t}\n\tbackup := dest + suffix\n\tif err := os.Rename(dest, backup); err != nil {\n\t\treturn fmt.Errorf(\"cannot backup '%s': %s\", dest, unwrapErr(err))\n\t}\n\treturn nil\n}\n\nfunc filesIdentical(src, dest string, opts options) bool {\n\tdfi, err := os.Stat(dest)\n\tif err != nil {\n\t\treturn false\n\t}\n\tsfi, err := os.Stat(src)\n\tif err != nil {\n\t\treturn false\n\t}\n\tif sfi.Size() != dfi.Size() {\n\t\treturn false\n\t}\n\tif dfi.Mode().Perm() != targetMode(opts) {\n\t\treturn false\n\t}\n\treturn contentsEqual(src, dest)\n}\n\nfunc targetMode(opts options) os.FileMode {\n\tif opts.mode == \"\" {\n\t\treturn 0755\n\t}\n\tperm, err := resolveMode(opts.mode)\n\tif err != nil {\n\t\treturn 0755\n\t}\n\treturn perm.Perm()\n}\n\nfunc contentsEqual(a, b string) bool {\n\taf, err := os.Open(a)\n\tif err != nil {\n\t\treturn false\n\t}\n\tdefer af.Close()\n\tbf, err := os.Open(b)\n\tif err != nil {\n\t\treturn false\n\t}\n\tdefer bf.Close()\n\tconst bufSize = 32 * 1024\n\tabuf := make([]byte, bufSize)\n\tbbuf := make([]byte, bufSize)\n\tfor {\n\t\tan, aerr := io.ReadFull(af, abuf)\n\t\tbn, berr := io.ReadFull(bf, bbuf)\n\t\tif !bytes.Equal(abuf[:an], bbuf[:bn]) {\n\t\t\treturn false\n\t\t}\n\t\tif aerr == io.EOF && berr == io.EOF {\n\t\t\treturn true\n\t\t}\n\t\tif aerr != nil && aerr != io.ErrUnexpectedEOF {\n\t\t\treturn false\n\t\t}\n\t\tif berr != nil && berr != io.ErrUnexpectedEOF {\n\t\t\treturn false\n\t\t}\n\t\tif an != bn {\n\t\t\treturn false\n\t\t}\n\t}\n}\n\nfunc copyFile(src, dest string) error {\n\tsf, err := os.Open(src)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cannot open '%s': %s\", src, unwrapErr(err))\n\t}\n\tdefer sf.Close()\n\n\tdf, err := os.Create(dest)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cannot create regular file '%s': %s\",\n\t\t\tdest, unwrapErr(err))\n\t}\n\tdefer df.Close()\n\n\tif _, err := io.Copy(df, sf); err != nil {\n\t\treturn fmt.Errorf(\"writing '%s': %s\", dest, unwrapErr(err))\n\t}\n\treturn df.Close()\n}\n\nfunc setMode(opts options, path string) error {\n\tif opts.mode == \"\" {\n\t\treturn os.Chmod(path, 0755)\n\t}\n\tperm, err := resolveMode(opts.mode)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid mode '%s'\", opts.mode)\n\t}\n\treturn os.Chmod(path, perm)\n}\n\nfunc resolveMode(mode string) (os.FileMode, error) {\n\tif isOctalMode(mode) {\n\t\tval, err := strconv.ParseUint(mode, 8, 32)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\treturn os.FileMode(val), nil\n\t}\n\treturn evalSymbolic(mode, 0, getUmask())\n}\n\nfunc getUmask() os.FileMode {\n\told := syscall.Umask(0)\n\tsyscall.Umask(old)\n\treturn os.FileMode(old)\n}\n\nfunc setOwnership(opts options, path string) error {\n\tuid, gid := -1, -1\n\tif opts.owner != \"\" {\n\t\tvar err error\n\t\tuid, err = lookupUser(opts.owner)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif opts.group != \"\" {\n\t\tvar err error\n\t\tgid, err = lookupGroup(opts.group)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif uid == -1 && gid == -1 {\n\t\treturn nil\n\t}\n\tif err := os.Chown(path, uid, gid); err != nil {\n\t\treturn fmt.Errorf(\"cannot change ownership of '%s': %s\",\n\t\t\tpath, unwrapErr(err))\n\t}\n\treturn nil\n}\n\nfunc lookupUser(name string) (int, error) {\n\tif uid, err := strconv.Atoi(name); err == nil {\n\t\treturn uid, nil\n\t}\n\tu, err := user.Lookup(name)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n\t}\n\tuid, err := strconv.Atoi(u.Uid)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n\t}\n\treturn uid, nil\n}\n\nfunc lookupGroup(name string) (int, error) {\n\tif gid, err := strconv.Atoi(name); err == nil {\n\t\treturn gid, nil\n\t}\n\tg, err := user.LookupGroup(name)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n\t}\n\tgid, err := strconv.Atoi(g.Gid)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n\t}\n\treturn gid, nil\n}\n\nfunc unwrapErr(err error) string {\n\tif pe, ok := err.(*os.PathError); ok {\n\t\treturn pe.Err.Error()\n\t}\n\treturn err.Error()\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar operands []string\n\tendOfFlags := false\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif endOfFlags {\n\t\t\toperands = append(operands, arg)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\ti = parseLongFlag(args, i, &opts)\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"-\") && len(arg) > 1 {\n\t\t\ti = parseShortFlags(args, i, &opts)\n\t\t\tcontinue\n\t\t}\n\t\toperands = append(operands, arg)\n\t\ti++\n\t}\n\treturn opts, operands\n}\n\nfunc parseLongFlag(args []string, i int, opts *options) int {\n\targ := args[i]\n\tswitch {\n\tcase arg == \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase arg == \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase arg == \"--directory\":\n\t\topts.directory = true\n\tcase arg == \"--compare\":\n\t\topts.compare = true\n\tcase arg == \"--backup\":\n\t\topts.backup = true\n\tcase arg == \"--verbose\":\n\t\topts.verbose = true\n\tcase strings.HasPrefix(arg, \"--mode=\"):\n\t\topts.mode = arg[len(\"--mode=\"):]\n\tcase strings.HasPrefix(arg, \"--owner=\"):\n\t\topts.owner = arg[len(\"--owner=\"):]\n\tcase strings.HasPrefix(arg, \"--group=\"):\n\t\topts.group = arg[len(\"--group=\"):]\n\tcase strings.HasPrefix(arg, \"--suffix=\"):\n\t\topts.suffix = arg[len(\"--suffix=\"):]\n\t}\n\treturn i + 1\n}\n\nfunc parseShortFlags(args []string, i int, opts *options) int {\n\tflags := args[i][1:]\n\tj := 0\n\tfor j < len(flags) {\n\t\tswitch flags[j] {\n\t\tcase 'm':\n\t\t\topts.mode = consumeValue(flags, j+1, args, &i)\n\t\t\treturn i + 1\n\t\tcase 'o':\n\t\t\topts.owner = consumeValue(flags, j+1, args, &i)\n\t\t\treturn i + 1\n\t\tcase 'g':\n\t\t\topts.group = consumeValue(flags, j+1, args, &i)\n\t\t\treturn i + 1\n\t\tcase 'd':\n\t\t\topts.directory = true\n\t\tcase 'C':\n\t\t\topts.compare = true\n\t\tcase 'D':\n\t\t\topts.createDir = true\n\t\tcase 'b':\n\t\t\topts.backup = true\n\t\tcase 'v':\n\t\t\topts.verbose = true\n\t\tcase 'c':\n\t\t\tj++\n\t\t\tcontinue\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\t\"install: invalid option -- '%c'\\n\", flags[j])\n\t\t\tos.Exit(1)\n\t\t}\n\t\tj++\n\t}\n\treturn i + 1\n}\n\nfunc consumeValue(flags string, pos int, args []string, i *int) string {\n\tif pos < len(flags) {\n\t\treturn flags[pos:]\n\t}\n\tif *i+1 < len(args) {\n\t\t*i++\n\t\treturn args[*i]\n\t}\n\treturn \"\"\n}\n","numLines":477,"startLine":1,"totalLines":477}}}
