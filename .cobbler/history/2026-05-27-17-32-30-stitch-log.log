{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MUrtXW394162n94EnoBrmM","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd108-vdir R1.1-R1.6, R2.1-R2.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n20\t)\n21\t\n22\tconst helpText = `Usage: vdir [OPTION]... [FILE]...\n23\tList directory contents.\n24\t\n25\t  -a             do not ignore entries starting with .\n26\t  -A             do not list implied . and ..\n27\t  -C             list entries by columns\n28\t  -d             list directories themselves, not their contents\n29\t  -F             append indicator (one of */=>@|) to entries\n30\t  -h             with -l and/or -s, print human readable sizes\n31\t  -i             print the index number of each file\n32\t  -l             use a long listing format\n33\t  -n             like -l, but list numeric user and group IDs\n34\t  -R             list subdirectories recursively\n35\t  -r             reverse order while sorting\n36\t  -s             print the allocated size of each file, in blocks\n37\t  -S             sort by file size, largest first\n38\t  -t             sort by modification time, newest first\n39\t  -U             do not sort; list entries in directory order\n40\t  -v             natural sort of (version) numbers within text\n41\t  -x             list entries by lines instead of by columns\n42\t  -1             list one file per line\n43\t      --color[=WHEN]  colorize the output; WHEN can be 'always'\n44\t                         (default if omitted), 'auto', or 'never'\n45\t      --help     display this help and exit\n46\t      --version  output version information and exit\n47\t`\n48\t\n49\tconst versionText = `vdir (go-unix-utils) dev\n50\t`\n51\t\n52\ttype options struct {\n53\t\tsingleColumn   bool\n54\t\tlongFormat     bool\n55\t\tforceColumns   bool\n56\t\thorizontalSort bool\n57\t\tshowAll        bool\n58\t\tshowAlmostAll  bool\n59\t\tdirAsEntry     bool\n60\t\tsortByTime     bool\n61\t\tsortBySize     bool\n62\t\treverseSort    bool\n63\t\tunsorted       bool\n64\t\tversionSort    bool\n65\t\tshowInode      bool\n66\t\tshowBlocks     bool\n67\t\tnumericIds     bool\n68\t\thumanReadable  bool\n69\t\tclassify       bool\n70\t\trecursive      bool\n71\t\tcolorMode      string\n72\t}\n73\t\n74\ttype fileEntry struct {\n75\t\tname string\n76\t\tinfo *sys.FileInfo\n77\t\tlink string\n78\t}\n79\t\n80\ttype longRow struct {\n81\t\tmode, nlink, owner, group, size, time, name string\n82\t}\n83\t\n84\tfunc main() {\n85\t\tsys.InstallSIGPIPEHandler()\n86\t\topts, paths := parseArgs(os.Args[1:])\n87\t\tos.Exit(run(paths, opts))\n88\t}\n89\t\n90\tfunc parseArgs(args []string) (options, []string) {\n91\t\topts := options{longFormat: true}\n92\t\tvar paths []string\n93\t\tfor len(args) > 0 {\n94\t\t\targ := args[0]\n95\t\t\targs = args[1:]\n96\t\t\tswitch {\n97\t\t\tcase arg == \"--help\":\n98\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n99\t\t\t\tos.Exit(0)\n100\t\t\tcase arg == \"--version\":\n101\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n102\t\t\t\tos.Exit(0)\n103\t\t\tcase arg == \"--\":\n104\t\t\t\treturn opts, append(paths, args...)\n105\t\t\tcase arg == \"--color\":\n106\t\t\t\topts.colorMode = \"always\"\n107\t\t\tcase strings.HasPrefix(arg, \"--color=\"):\n108\t\t\t\topts.colorMode = parseColorValue(arg)\n109\t\t\tcase strings.HasPrefix(arg, \"--\"):\n110\t\t\t\tfmt.Fprintf(os.Stderr, \"vdir: unrecognized option '%s'\\n\", arg)\n111\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'vdir --help' for more information.\")\n112\t\t\t\tos.Exit(2)\n113\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n114\t\t\t\tparseShortFlags(arg[1:], &opts)\n115\t\t\tdefault:\n116\t\t\t\tpaths = append(paths, arg)\n117\t\t\t}\n118\t\t}\n119\t\treturn opts, paths\n120\t}\n121\t\n122\tfunc parseShortFlags(flags string, opts *options) {\n123\t\tfor _, ch := range flags {\n124\t\t\tswitch ch {\n125\t\t\tcase '1':\n126\t\t\t\topts.forceColumns = false\n127\t\t\t\topts.horizontalSort = false\n128\t\t\t\tif !opts.longFormat {\n129\t\t\t\t\topts.singleColumn = true\n130\t\t\t\t}\n131\t\t\tcase 'l', 'g', 'n':\n132\t\t\t\tif ch == 'n' {\n133\t\t\t\t\topts.numericIds = true\n134\t\t\t\t}\n135\t\t\t\topts.longFormat = true\n136\t\t\t\topts.singleColumn = false\n137\t\t\t\topts.forceColumns = false\n138\t\t\t\topts.horizontalSort = false\n139\t\t\tcase 'C', 'x':\n140\t\t\t\topts.forceColumns = true\n141\t\t\t\topts.horizontalSort = ch == 'x'\n142\t\t\t\topts.longFormat = false\n143\t\t\t\topts.singleColumn = false\n144\t\t\tcase 'a':\n145\t\t\t\topts.showAll = true\n146\t\t\t\topts.showAlmostAll = false\n147\t\t\tcase 'A':\n148\t\t\t\topts.showAlmostAll = true\n149\t\t\t\topts.showAll = false\n150\t\t\tcase 'b', 'B', 'c', 'G', 'H', 'k', 'L', 'm', 'N',\n151\t\t\t\t'o', 'p', 'q', 'Q', 'u', 'X', 'Z':\n152\t\t\tcase 'd':\n153\t\t\t\topts.dirAsEntry = true\n154\t\t\tcase 'f':\n155\t\t\t\topts.showAll = true\n156\t\t\t\topts.showAlmostAll = false\n157\t\t\t\topts.unsorted = true\n158\t\t\t\topts.sortByTime = false\n159\t\t\t\topts.sortBySize = false\n160\t\t\t\topts.versionSort = false\n161\t\t\tcase 'F':\n162\t\t\t\topts.classify = true\n163\t\t\tcase 'h':\n164\t\t\t\topts.humanReadable = true\n165\t\t\tcase 'i':\n166\t\t\t\topts.showInode = true\n167\t\t\tcase 'R':\n168\t\t\t\topts.recursive = true\n169\t\t\tcase 'r':\n170\t\t\t\topts.reverseSort = true\n171\t\t\tcase 's':\n172\t\t\t\topts.showBlocks = true\n173\t\t\tcase 't', 'S', 'U', 'v':\n174\t\t\t\topts.sortByTime = ch == 't'\n175\t\t\t\topts.sortBySize = ch == 'S'\n176\t\t\t\topts.unsorted = ch == 'U'\n177\t\t\t\topts.versionSort = ch == 'v'\n178\t\t\tdefault:\n179\t\t\t\tfmt.Fprintf(os.Stderr, \"vdir: invalid option -- '%c'\\n\", ch)\n180\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'vdir --help' for more information.\")\n181\t\t\t\tos.Exit(2)\n182\t\t\t}\n183\t\t}\n184\t}\n185\t\n186\tfunc parseColorValue(arg string) string {\n187\t\tval := arg[len(\"--color=\"):]\n188\t\tswitch val {\n189\t\tcase \"always\", \"auto\", \"never\":\n190\t\t\treturn val\n191\t\tdefault:\n192\t\t\tfmt.Fprintf(os.Stderr, \"vdir: invalid argument '%s' for '--color'\\n\", val)\n193\t\t\tfmt.Fprintln(os.Stderr, \"Try 'vdir --help' for more information.\")\n194\t\t\tos.Exit(2)\n195\t\t\treturn \"\"\n196\t\t}\n197\t}\n198\t\n199\tfunc classifyPaths(paths []string, opts options) ([]fileEntry, []string, int) {\n200\t\tvar files []fileEntry\n201\t\tvar dirs []string\n202\t\texitCode := 0\n203\t\tfor _, p := range paths {\n204\t\t\tfi, err := sys.Lstat(p)\n205\t\t\tif err != nil {\n206\t\t\t\tfmt.Fprintf(os.Stderr, \"vdir: cannot access '%s': %s\\n\", p, sysErrMsg(err))\n207\t\t\t\texitCode = 1\n208\t\t\t\tcontinue\n209\t\t\t}\n210\t\t\tif fi.Mode.IsDir() && !opts.dirAsEntry {\n211\t\t\t\tdirs = append(dirs, p)\n212\t\t\t} else {\n213\t\t\t\tlink := \"\"\n214\t\t\t\tif fi.Mode&os.ModeSymlink != 0 {\n215\t\t\t\t\tlink, _ = os.Readlink(p)\n216\t\t\t\t}\n217\t\t\t\tfiles = append(files, fileEntry{name: p, info: fi, link: link})\n218\t\t\t}\n219\t\t}\n220\t\treturn files, dirs, exitCode\n221\t}\n222\t\n223\tfunc run(paths []string, opts options) int {\n224\t\tif len(paths) == 0 {\n225\t\t\tpaths = []string{\".\"}\n226\t\t}\n227\t\tfiles, dirs, exitCode := classifyPaths(paths, opts)\n228\t\tshowHeaders := len(dirs) > 1 || len(files) > 0 || opts.recursive\n229\t\tprinted := false\n230\t\tif len(files) > 0 {\n231\t\t\tsortEntries(files, opts)\n232\t\t\twriteOutput(files, -1, opts)\n233\t\t\tprinted = true\n234\t\t}\n235\t\tfor _, d := range dirs {\n236\t\t\tif printed {\n237\t\t\t\tfmt.Println()\n238\t\t\t}\n239\t\t\tif showHeaders {\n240\t\t\t\tfmt.Printf(\"%s:\\n\", d)\n241\t\t\t}\n242\t\t\tentries, totalBlocks, err := listDir(d, opts)\n243\t\t\tif err != nil {\n244\t\t\t\tfmt.Fprintf(os.Stderr, \"vdir: cannot open directory '%s': %s\\n\", d, sysErrMsg(err))\n245\t\t\t\texitCode = 1\n246\t\t\t\tprinted = true\n247\t\t\t\tcontinue\n248\t\t\t}\n249\t\t\twriteOutput(entries, totalBlocks, opts)\n250\t\t\tprinted = true\n251\t\t}\n252\t\treturn exitCode\n253\t}\n254\t\n255\tfunc listDir(path string, opts options) ([]fileEntry, int64, error) {\n256\t\tdirEntries, err := os.ReadDir(path)\n257\t\tif err != nil {\n258\t\t\treturn nil, 0, err\n259\t\t}\n260\t\tentries := make([]fileEntry, 0, len(dirEntries)+2)\n261\t\tif opts.showAll {\n262\t\t\tif fi, e := sys.Lstat(path); e == nil {\n263\t\t\t\tentries = append(entries, fileEntry{name: \".\", info: fi})\n264\t\t\t}\n265\t\t\tif fi, e := sys.Lstat(filepath.Join(path, \"..\")); e == nil {\n266\t\t\t\tentries = append(entries, fileEntry{name: \"..\", info: fi})\n267\t\t\t}\n268\t\t}\n269\t\tfor _, de := range dirEntries {\n270\t\t\tname := de.Name()\n271\t\t\tif len(name) > 0 && name[0] == '.' && !opts.showAll && !opts.showAlmostAll {\n272\t\t\t\tcontinue\n273\t\t\t}\n274\t\t\tfullPath := filepath.Join(path, name)\n275\t\t\tfi, err := sys.Lstat(fullPath)\n276\t\t\tif err != nil {\n277\t\t\t\tcontinue\n278\t\t\t}\n279\t\t\tlink := \"\"\n280\t\t\tif fi.Mode&os.ModeSymlink != 0 {\n281\t\t\t\tlink, _ = os.Readlink(fullPath)\n282\t\t\t}\n283\t\t\tentries = append(entries, fileEntry{name: name, info: fi, link: link})\n284\t\t}\n285\t\tsortEntries(entries, opts)\n286\t\tvar totalBlocks int64\n287\t\tfor _, e := range entries {\n288\t\t\ttotalBlocks += e.info.Blocks\n289\t\t}\n290\t\treturn entries, totalBlocks / 2, nil\n291\t}\n292\t\n293\tfunc sortEntries(entries []fileEntry, opts options) {\n294\t\tif opts.unsorted {\n295\t\t\treturn\n296\t\t}\n297\t\tless := nameLess\n298\t\tif opts.sortByTime {\n299\t\t\tless = timeLess\n300\t\t} else if opts.sortBySize {\n301\t\t\tless = sizeLess\n302\t\t}\n303\t\tif opts.reverseSort {\n304\t\t\tfwd := less\n305\t\t\tless = func(a, b fileEntry) bool { return fwd(b, a) }\n306\t\t}\n307\t\tsort.SliceStable(entries, func(i, j int) bool {\n308\t\t\treturn less(entries[i], entries[j])\n309\t\t})\n310\t}\n311\t\n312\tfunc nameLess(a, b fileEntry) bool { return a.name < b.name }\n313\tfunc timeLess(a, b fileEntry) bool { return a.info.ModTime.After(b.info.ModTime) }\n314\tfunc sizeLess(a, b fileEntry) bool { return a.info.Size > b.info.Size }\n315\t\n316\tfunc writeOutput(entries []fileEntry, totalBlocks int64, opts options) {\n317\t\tif opts.longFormat {\n318\t\t\twriteLong(entries, totalBlocks, opts)\n319\t\t\treturn\n320\t\t}\n321\t\tfor _, e := range entries {\n322\t\t\tfmt.Println(escapeC(e.name))\n323\t\t}\n324\t}\n325\t\n326\tfunc writeLong(entries []fileEntry, totalBlocks int64, opts options) {\n327\t\tif totalBlocks >= 0 {\n328\t\t\tfmt.Printf(\"total %d\\n\", totalBlocks)\n329\t\t}\n330\t\tif len(entries) == 0 {\n331\t\t\treturn\n332\t\t}\n333\t\trows := make([]longRow, len(entries))\n334\t\tvar wN, wO, wG, wS int\n335\t\tfor i, e := range entries {\n336\t\t\trows[i] = buildRow(e, opts)\n337\t\t\twN = max(wN, len(rows[i].nlink))\n338\t\t\twO = max(wO, len(rows[i].owner))\n339\t\t\twG = max(wG, len(rows[i].group))\n340\t\t\twS = max(wS, len(rows[i].size))\n341\t\t}\n342\t\tfor _, r := range rows {\n343\t\t\tfmt.Printf(\"%s %s %s %s %s %s %s\\n\", r.mode,\n344\t\t\t\tformat.PadLeft(r.nlink, wN), format.PadRight(r.owner, wO),\n345\t\t\t\tformat.PadRight(r.group, wG), format.PadLeft(r.size, wS),\n346\t\t\t\tr.time, r.name)\n347\t\t}\n348\t}\n349\t\n350\tfunc buildRow(e fileEntry, opts options) longRow {\n351\t\tfi := e.info\n352\t\towner, group := lookupName(fi.Uid, true), lookupName(fi.Gid, false)\n353\t\tif opts.numericIds {\n354\t\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n355\t\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n356\t\t}\n357\t\tsize := strconv.FormatInt(fi.Size, 10)\n358\t\tif opts.humanReadable {\n359\t\t\tsize = format.HumanSize(fi.Size, format.HumanSizeOpts{Binary: true})\n360\t\t}\n361\t\tname := escapeC(e.name)\n362\t\tif e.link != \"\" {\n363\t\t\tname += \" -> \" + escapeC(e.link)\n364\t\t}\n365\t\treturn longRow{\n366\t\t\tmode:  formatMode(fi.Mode),\n367\t\t\tnlink: strconv.FormatUint(fi.Nlink, 10),\n368\t\t\towner: owner, group: group,\n369\t\t\tsize: size, time: formatTime(fi.ModTime),\n370\t\t\tname: name,\n371\t\t}\n372\t}\n373\t\n374\tfunc formatMode(mode os.FileMode) string {\n375\t\tvar buf [10]byte\n376\t\tswitch {\n377\t\tcase mode&os.ModeDir != 0:\n378\t\t\tbuf[0] = 'd'\n379\t\tcase mode&os.ModeSymlink != 0:\n380\t\t\tbuf[0] = 'l'\n381\t\tcase mode&os.ModeNamedPipe != 0:\n382\t\t\tbuf[0] = 'p'\n383\t\tcase mode&os.ModeSocket != 0:\n384\t\t\tbuf[0] = 's'\n385\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n386\t\t\tbuf[0] = 'c'\n387\t\tcase mode&os.ModeDevice != 0:\n388\t\t\tbuf[0] = 'b'\n389\t\tdefault:\n390\t\t\tbuf[0] = '-'\n391\t\t}\n392\t\tconst rwx = \"rwxrwxrwx\"\n393\t\tfor i, c := range rwx {\n394\t\t\tif mode&(1<<uint(8-i)) != 0 {\n395\t\t\t\tbuf[1+i] = byte(c)\n396\t\t\t} else {\n397\t\t\t\tbuf[1+i] = '-'\n398\t\t\t}\n399\t\t}\n400\t\tsetSpecial := func(pos int, withX, withoutX byte) {\n401\t\t\tif buf[pos] == 'x' {\n402\t\t\t\tbuf[pos] = withX\n403\t\t\t} else {\n404\t\t\t\tbuf[pos] = withoutX\n405\t\t\t}\n406\t\t}\n407\t\tif mode&os.ModeSetuid != 0 {\n408\t\t\tsetSpecial(3, 's', 'S')\n409\t\t}\n410\t\tif mode&os.ModeSetgid != 0 {\n411\t\t\tsetSpecial(6, 's', 'S')\n412\t\t}\n413\t\tif mode&os.ModeSticky != 0 {\n414\t\t\tsetSpecial(9, 't', 'T')\n415\t\t}\n416\t\treturn string(buf[:])\n417\t}\n418\t\n419\tfunc formatTime(t time.Time) string {\n420\t\tnow := time.Now()\n421\t\tsixMonths := 365 * 24 * time.Hour / 2\n422\t\tif t.After(now.Add(-sixMonths)) && !t.After(now) {\n423\t\t\treturn t.Format(\"Jan _2 15:04\")\n424\t\t}\n425\t\treturn t.Format(\"Jan _2  2006\")\n426\t}\n427\t\n428\tfunc lookupName(id uint32, isUser bool) string {\n429\t\ts := strconv.FormatUint(uint64(id), 10)\n430\t\tif isUser {\n431\t\t\tu, err := user.LookupId(s)\n432\t\t\tif err == nil {\n433\t\t\t\treturn u.Username\n434\t\t\t}\n435\t\t} else {\n436\t\t\tg, err := user.LookupGroupId(s)\n437\t\t\tif err == nil {\n438\t\t\t\treturn g.Name\n439\t\t\t}\n440\t\t}\n441\t\treturn s\n442\t}\n443\t\n444\tfunc escapeC(s string) string {\n445\t\tvar b strings.Builder\n446\t\tb.Grow(len(s) * 2)\n447\t\tfor i := 0; i < len(s); i++ {\n448\t\t\tc := s[i]\n449\t\t\tswitch c {\n450\t\t\tcase '\\\\':\n451\t\t\t\tb.WriteString(\"\\\\\\\\\")\n452\t\t\tcase '\\a':\n453\t\t\t\tb.WriteString(\"\\\\a\")\n454\t\t\tcase '\\b':\n455\t\t\t\tb.WriteString(\"\\\\b\")\n456\t\t\tcase '\\t':\n457\t\t\t\tb.WriteString(\"\\\\t\")\n458\t\t\tcase '\\n':\n459\t\t\t\tb.WriteString(\"\\\\n\")\n460\t\t\tcase '\\v':\n461\t\t\t\tb.WriteString(\"\\\\v\")\n462\t\t\tcase '\\f':\n463\t\t\t\tb.WriteString(\"\\\\f\")\n464\t\t\tcase '\\r':\n465\t\t\t\tb.WriteString(\"\\\\r\")\n466\t\t\tcase ' ':\n467\t\t\t\tb.WriteString(\"\\\\ \")\n468\t\t\tdefault:\n469\t\t\t\tif c < 0x20 || c >= 0x7f {\n470\t\t\t\t\tb.WriteByte('\\\\')\n471\t\t\t\t\tb.WriteByte('0' + c>>6)\n472\t\t\t\t\tb.WriteByte('0' + (c>>3)&7)\n473\t\t\t\t\tb.WriteByte('0' + c&7)\n474\t\t\t\t} else {\n475\t\t\t\t\tb.WriteByte(c)\n476\t\t\t\t}\n477\t\t\t}\n478\t\t}\n479\t\treturn b.String()\n480\t}\n481\t\n482\tfunc sysErrMsg(err error) string {\n483\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n484\t\t\treturn capitalize(pe.Err.Error())\n485\t\t}\n486\t\treturn capitalize(err.Error())\n487\t}\n488\t\n489\tfunc capitalize(s string) string {\n490\t\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n491\t\t\treturn strings.ToUpper(s[:1]) + s[1:]\n492\t\t}\n493\t\treturn s\n494\t}\n495\t"}]},"parent_tool_use_id":null,"session_id":"f1d392bd-5d4d-4f03-9f3e-6208317b53d5","uuid":"a18f60b2-b0cd-4c72-89d5-ef6ecb716199","timestamp":"2026-05-27T21:32:40.284Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5618/cmd/vdir/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd108-vdir R1.1-R1.6, R2.1-R2.4.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: vdir [OPTION]... [FILE]...\nList directory contents.\n\n  -a             do not ignore entries starting with .\n  -A             do not list implied . and ..\n  -C             list entries by columns\n  -d             list directories themselves, not their contents\n  -F             append indicator (one of */=>@|) to entries\n  -h             with -l and/or -s, print human readable sizes\n  -i             print the index number of each file\n  -l             use a long listing format\n  -n             like -l, but list numeric user and group IDs\n  -R             list subdirectories recursively\n  -r             reverse order while sorting\n  -s             print the allocated size of each file, in blocks\n  -S             sort by file size, largest first\n  -t             sort by modification time, newest first\n  -U             do not sort; list entries in directory order\n  -v             natural sort of (version) numbers within text\n  -x             list entries by lines instead of by columns\n  -1             list one file per line\n      --color[=WHEN]  colorize the output; WHEN can be 'always'\n                         (default if omitted), 'auto', or 'never'\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `vdir (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn   bool\n\tlongFormat     bool\n\tforceColumns   bool\n\thorizontalSort bool\n\tshowAll        bool\n\tshowAlmostAll  bool\n\tdirAsEntry     bool\n\tsortByTime     bool\n\tsortBySize     bool\n\treverseSort    bool\n\tunsorted       bool\n\tversionSort    bool\n\tshowInode      bool\n\tshowBlocks     bool\n\tnumericIds     bool\n\thumanReadable  bool\n\tclassify       bool\n\trecursive      bool\n\tcolorMode      string\n}\n\ntype fileEntry struct {\n\tname string\n\tinfo *sys.FileInfo\n\tlink string\n}\n\ntype longRow struct {\n\tmode, nlink, owner, group, size, time, name string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\topts := options{longFormat: true}\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase arg == \"--color\":\n\t\t\topts.colorMode = \"always\"\n\t\tcase strings.HasPrefix(arg, \"--color=\"):\n\t\t\topts.colorMode = parseColorValue(arg)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"vdir: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'vdir --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l', 'g', 'n':\n\t\t\tif ch == 'n' {\n\t\t\t\topts.numericIds = true\n\t\t\t}\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'C', 'x':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = ch == 'x'\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'a':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\tcase 'A':\n\t\t\topts.showAlmostAll = true\n\t\t\topts.showAll = false\n\t\tcase 'b', 'B', 'c', 'G', 'H', 'k', 'L', 'm', 'N',\n\t\t\t'o', 'p', 'q', 'Q', 'u', 'X', 'Z':\n\t\tcase 'd':\n\t\t\topts.dirAsEntry = true\n\t\tcase 'f':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\t\topts.unsorted = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.versionSort = false\n\t\tcase 'F':\n\t\t\topts.classify = true\n\t\tcase 'h':\n\t\t\topts.humanReadable = true\n\t\tcase 'i':\n\t\t\topts.showInode = true\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tcase 'r':\n\t\t\topts.reverseSort = true\n\t\tcase 's':\n\t\t\topts.showBlocks = true\n\t\tcase 't', 'S', 'U', 'v':\n\t\t\topts.sortByTime = ch == 't'\n\t\t\topts.sortBySize = ch == 'S'\n\t\t\topts.unsorted = ch == 'U'\n\t\t\topts.versionSort = ch == 'v'\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"vdir: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'vdir --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc parseColorValue(arg string) string {\n\tval := arg[len(\"--color=\"):]\n\tswitch val {\n\tcase \"always\", \"auto\", \"never\":\n\t\treturn val\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"vdir: invalid argument '%s' for '--color'\\n\", val)\n\t\tfmt.Fprintln(os.Stderr, \"Try 'vdir --help' for more information.\")\n\t\tos.Exit(2)\n\t\treturn \"\"\n\t}\n}\n\nfunc classifyPaths(paths []string, opts options) ([]fileEntry, []string, int) {\n\tvar files []fileEntry\n\tvar dirs []string\n\texitCode := 0\n\tfor _, p := range paths {\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"vdir: cannot access '%s': %s\\n\", p, sysErrMsg(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif fi.Mode.IsDir() && !opts.dirAsEntry {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tlink := \"\"\n\t\t\tif fi.Mode&os.ModeSymlink != 0 {\n\t\t\t\tlink, _ = os.Readlink(p)\n\t\t\t}\n\t\t\tfiles = append(files, fileEntry{name: p, info: fi, link: link})\n\t\t}\n\t}\n\treturn files, dirs, exitCode\n}\n\nfunc run(paths []string, opts options) int {\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tfiles, dirs, exitCode := classifyPaths(paths, opts)\n\tshowHeaders := len(dirs) > 1 || len(files) > 0 || opts.recursive\n\tprinted := false\n\tif len(files) > 0 {\n\t\tsortEntries(files, opts)\n\t\twriteOutput(files, -1, opts)\n\t\tprinted = true\n\t}\n\tfor _, d := range dirs {\n\t\tif printed {\n\t\t\tfmt.Println()\n\t\t}\n\t\tif showHeaders {\n\t\t\tfmt.Printf(\"%s:\\n\", d)\n\t\t}\n\t\tentries, totalBlocks, err := listDir(d, opts)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"vdir: cannot open directory '%s': %s\\n\", d, sysErrMsg(err))\n\t\t\texitCode = 1\n\t\t\tprinted = true\n\t\t\tcontinue\n\t\t}\n\t\twriteOutput(entries, totalBlocks, opts)\n\t\tprinted = true\n\t}\n\treturn exitCode\n}\n\nfunc listDir(path string, opts options) ([]fileEntry, int64, error) {\n\tdirEntries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, 0, err\n\t}\n\tentries := make([]fileEntry, 0, len(dirEntries)+2)\n\tif opts.showAll {\n\t\tif fi, e := sys.Lstat(path); e == nil {\n\t\t\tentries = append(entries, fileEntry{name: \".\", info: fi})\n\t\t}\n\t\tif fi, e := sys.Lstat(filepath.Join(path, \"..\")); e == nil {\n\t\t\tentries = append(entries, fileEntry{name: \"..\", info: fi})\n\t\t}\n\t}\n\tfor _, de := range dirEntries {\n\t\tname := de.Name()\n\t\tif len(name) > 0 && name[0] == '.' && !opts.showAll && !opts.showAlmostAll {\n\t\t\tcontinue\n\t\t}\n\t\tfullPath := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(fullPath)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tlink := \"\"\n\t\tif fi.Mode&os.ModeSymlink != 0 {\n\t\t\tlink, _ = os.Readlink(fullPath)\n\t\t}\n\t\tentries = append(entries, fileEntry{name: name, info: fi, link: link})\n\t}\n\tsortEntries(entries, opts)\n\tvar totalBlocks int64\n\tfor _, e := range entries {\n\t\ttotalBlocks += e.info.Blocks\n\t}\n\treturn entries, totalBlocks / 2, nil\n}\n\nfunc sortEntries(entries []fileEntry, opts options) {\n\tif opts.unsorted {\n\t\treturn\n\t}\n\tless := nameLess\n\tif opts.sortByTime {\n\t\tless = timeLess\n\t} else if opts.sortBySize {\n\t\tless = sizeLess\n\t}\n\tif opts.reverseSort {\n\t\tfwd := less\n\t\tless = func(a, b fileEntry) bool { return fwd(b, a) }\n\t}\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\treturn less(entries[i], entries[j])\n\t})\n}\n\nfunc nameLess(a, b fileEntry) bool { return a.name < b.name }\nfunc timeLess(a, b fileEntry) bool { return a.info.ModTime.After(b.info.ModTime) }\nfunc sizeLess(a, b fileEntry) bool { return a.info.Size > b.info.Size }\n\nfunc writeOutput(entries []fileEntry, totalBlocks int64, opts options) {\n\tif opts.longFormat {\n\t\twriteLong(entries, totalBlocks, opts)\n\t\treturn\n\t}\n\tfor _, e := range entries {\n\t\tfmt.Println(escapeC(e.name))\n\t}\n}\n\nfunc writeLong(entries []fileEntry, totalBlocks int64, opts options) {\n\tif totalBlocks >= 0 {\n\t\tfmt.Printf(\"total %d\\n\", totalBlocks)\n\t}\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\trows := make([]longRow, len(entries))\n\tvar wN, wO, wG, wS int\n\tfor i, e := range entries {\n\t\trows[i] = buildRow(e, opts)\n\t\twN = max(wN, len(rows[i].nlink))\n\t\twO = max(wO, len(rows[i].owner))\n\t\twG = max(wG, len(rows[i].group))\n\t\twS = max(wS, len(rows[i].size))\n\t}\n\tfor _, r := range rows {\n\t\tfmt.Printf(\"%s %s %s %s %s %s %s\\n\", r.mode,\n\t\t\tformat.PadLeft(r.nlink, wN), format.PadRight(r.owner, wO),\n\t\t\tformat.PadRight(r.group, wG), format.PadLeft(r.size, wS),\n\t\t\tr.time, r.name)\n\t}\n}\n\nfunc buildRow(e fileEntry, opts options) longRow {\n\tfi := e.info\n\towner, group := lookupName(fi.Uid, true), lookupName(fi.Gid, false)\n\tif opts.numericIds {\n\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n\t}\n\tsize := strconv.FormatInt(fi.Size, 10)\n\tif opts.humanReadable {\n\t\tsize = format.HumanSize(fi.Size, format.HumanSizeOpts{Binary: true})\n\t}\n\tname := escapeC(e.name)\n\tif e.link != \"\" {\n\t\tname += \" -> \" + escapeC(e.link)\n\t}\n\treturn longRow{\n\t\tmode:  formatMode(fi.Mode),\n\t\tnlink: strconv.FormatUint(fi.Nlink, 10),\n\t\towner: owner, group: group,\n\t\tsize: size, time: formatTime(fi.ModTime),\n\t\tname: name,\n\t}\n}\n\nfunc formatMode(mode os.FileMode) string {\n\tvar buf [10]byte\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\tbuf[0] = 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\tbuf[0] = 'l'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\tbuf[0] = 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\tbuf[0] = 's'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\tbuf[0] = 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\tbuf[0] = 'b'\n\tdefault:\n\t\tbuf[0] = '-'\n\t}\n\tconst rwx = \"rwxrwxrwx\"\n\tfor i, c := range rwx {\n\t\tif mode&(1<<uint(8-i)) != 0 {\n\t\t\tbuf[1+i] = byte(c)\n\t\t} else {\n\t\t\tbuf[1+i] = '-'\n\t\t}\n\t}\n\tsetSpecial := func(pos int, withX, withoutX byte) {\n\t\tif buf[pos] == 'x' {\n\t\t\tbuf[pos] = withX\n\t\t} else {\n\t\t\tbuf[pos] = withoutX\n\t\t}\n\t}\n\tif mode&os.ModeSetuid != 0 {\n\t\tsetSpecial(3, 's', 'S')\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tsetSpecial(6, 's', 'S')\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tsetSpecial(9, 't', 'T')\n\t}\n\treturn string(buf[:])\n}\n\nfunc formatTime(t time.Time) string {\n\tnow := time.Now()\n\tsixMonths := 365 * 24 * time.Hour / 2\n\tif t.After(now.Add(-sixMonths)) && !t.After(now) {\n\t\treturn t.Format(\"Jan _2 15:04\")\n\t}\n\treturn t.Format(\"Jan _2  2006\")\n}\n\nfunc lookupName(id uint32, isUser bool) string {\n\ts := strconv.FormatUint(uint64(id), 10)\n\tif isUser {\n\t\tu, err := user.LookupId(s)\n\t\tif err == nil {\n\t\t\treturn u.Username\n\t\t}\n\t} else {\n\t\tg, err := user.LookupGroupId(s)\n\t\tif err == nil {\n\t\t\treturn g.Name\n\t\t}\n\t}\n\treturn s\n}\n\nfunc escapeC(s string) string {\n\tvar b strings.Builder\n\tb.Grow(len(s) * 2)\n\tfor i := 0; i < len(s); i++ {\n\t\tc := s[i]\n\t\tswitch c {\n\t\tcase '\\\\':\n\t\t\tb.WriteString(\"\\\\\\\\\")\n\t\tcase '\\a':\n\t\t\tb.WriteString(\"\\\\a\")\n\t\tcase '\\b':\n\t\t\tb.WriteString(\"\\\\b\")\n\t\tcase '\\t':\n\t\t\tb.WriteString(\"\\\\t\")\n\t\tcase '\\n':\n\t\t\tb.WriteString(\"\\\\n\")\n\t\tcase '\\v':\n\t\t\tb.WriteString(\"\\\\v\")\n\t\tcase '\\f':\n\t\t\tb.WriteString(\"\\\\f\")\n\t\tcase '\\r':\n\t\t\tb.WriteString(\"\\\\r\")\n\t\tcase ' ':\n\t\t\tb.WriteString(\"\\\\ \")\n\t\tdefault:\n\t\t\tif c < 0x20 || c >= 0x7f {\n\t\t\t\tb.WriteByte('\\\\')\n\t\t\t\tb.WriteByte('0' + c>>6)\n\t\t\t\tb.WriteByte('0' + (c>>3)&7)\n\t\t\t\tb.WriteByte('0' + c&7)\n\t\t\t} else {\n\t\t\t\tb.WriteByte(c)\n\t\t\t}\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc sysErrMsg(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn capitalize(pe.Err.Error())\n\t}\n\treturn capitalize(err.Error())\n}\n\nfunc capitalize(s string) string {\n\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n\t\treturn strings.ToUpper(s[:1]) + s[1:]\n\t}\n\treturn s\n}\n","numLines":495,"startLine":1,"totalLines":495}}}
