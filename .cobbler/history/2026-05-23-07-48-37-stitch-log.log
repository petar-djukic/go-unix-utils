{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JfHPqduGDFmfTzXy2uthws","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"encoding/base64\"\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"syscall\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/encutil\"\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tfunc main() {\n20\t\tsys.InstallSIGPIPEHandler()\n21\t\twrap, file := parseArgs(os.Args[1:])\n22\t\n23\t\trc, err := encutil.OpenInput(file)\n24\t\tif err != nil {\n25\t\t\tfmt.Fprintf(os.Stderr, \"base64: %s: %s\\n\", file, err.Error())\n26\t\t\tos.Exit(1)\n27\t\t}\n28\t\tdefer rc.Close()\n29\t\n30\t\terr = encutil.Encode(rc, os.Stdout, encutil.EncoderConfig{\n31\t\t\tEncode:  encodeBase64,\n32\t\t\tWrapCol: wrap,\n33\t\t})\n34\t\tif err != nil {\n35\t\t\tif errors.Is(err, syscall.EPIPE) {\n36\t\t\t\tos.Exit(0)\n37\t\t\t}\n38\t\t\tfmt.Fprintf(os.Stderr, \"base64: %s\\n\", err.Error())\n39\t\t\tos.Exit(1)\n40\t\t}\n41\t}\n42\t\n43\tfunc encodeBase64(data []byte) string {\n44\t\treturn base64.StdEncoding.EncodeToString(data)\n45\t}\n46\t\n47\tfunc parseArgs(args []string) (int, string) {\n48\t\twrap := 76\n49\t\tvar file string\n50\t\ti := 0\n51\t\tfor i < len(args) {\n52\t\t\targ := args[i]\n53\t\t\tif arg == \"--\" {\n54\t\t\t\tif i+1 < len(args) {\n55\t\t\t\t\tfile = args[i+1]\n56\t\t\t\t}\n57\t\t\t\tbreak\n58\t\t\t}\n59\t\t\tif handled, advance := parseLongFlag(args[i:], &wrap); handled {\n60\t\t\t\ti += advance\n61\t\t\t\tcontinue\n62\t\t\t}\n63\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n64\t\t\t\tfile = arg\n65\t\t\t\ti++\n66\t\t\t\tcontinue\n67\t\t\t}\n68\t\t\ti += parseShortFlags(args[i:], &wrap)\n69\t\t}\n70\t\treturn wrap, file\n71\t}\n72\t\n73\tfunc parseLongFlag(remaining []string, wrap *int) (bool, int) {\n74\t\t