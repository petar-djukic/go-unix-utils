{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01785M2t14Ln8PeTQNFaTHCr","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"hash\"\n9\t\t\"os\"\n10\t\t\"strconv\"\n11\t\t\"strings\"\n12\t\n13\t\t\"golang.org/x/crypto/blake2b\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tfunc newBLAKE2b(size int) func() hash.Hash {\n20\t\treturn func() hash.Hash {\n21\t\t\th, _ := blake2b.New(size, nil)\n22\t\t\treturn h\n23\t\t}\n24\t}\n25\t\n26\tfunc main() {\n27\t\tsys.InstallSIGPIPEHandler()\n28\t\topts, files := parseArgs(os.Args[1:])\n29\t\n30\t\tif opts.length == 0 {\n31\t\t\topts.length = 512\n32\t\t}\n33\t\tif opts.length <= 0 || opts.length%8 != 0 || opts.length > 512 {\n34\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: invalid length: %d\\n\", opts.length)\n35\t\t\tos.Exit(1)\n36\t\t}\n37\t\n38\t\tdigestBytes := opts.length / 8\n39\t\talgorithm := \"BLAKE2b\"\n40\t\tif opts.length != 512 {\n41\t\t\talgorithm = fmt.Sprintf(\"BLAKE2b-%d\", opts.length)\n42\t\t}\n43\t\n44\t\tcfg := hashutil.HashConfig{\n45\t\t\tAlgorithm: algorithm,\n46\t\t\tNewHash:   newBLAKE2b(digestBytes),\n47\t\t\tDigestLen: digestBytes,\n48\t\t}\n49\t\tif opts.check {\n50\t\t\tcheckOpts := hashutil.CheckOptions{\n51\t\t\t\tWarn:   opts.warn,\n52\t\t\t\tQuiet:  opts.quiet,\n53\t\t\t\tStatus: opts.status,\n54\t\t\t}\n55\t\t\texitCode := 0\n56\t\t\tfor _, f := range files {\n57\t\t\t\tok, err := hashutil.VerifyChecksums(f, cfg, checkOpts, os.Stdout, os.Stderr)\n58\t\t\t\tif err != nil {\n59\t\t\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: %s\\n\", err)\n60\t\t\t\t\texitCode = 1\n61\t\t\t\t} else if !ok {\n62\t\t\t\t\texitCode = 1\n63\t\t\t\t}\n64\t\t\t}\n65\t\t\tos.Exit(exitCode)\n66\t\t}\n67\t\tos.Exit(hashutil.DigestFiles(files, cfg, opts.binary, opts.tag, os.Stdout, os.Stderr))\n68\t}\n69\t\n70\ttype options struct {\n71\t\tbinary bool\n72\t\ttag    bool\n73\t\tcheck  bool\n74\t\twarn   bool\n75\t\tquiet  bool\n76\t\tstatus bool\n77\t\tlength int\n78\t}\n79\t\n80\tfunc parseArgs(args []string) (options, []string) {\n81\t\tvar opts options\n82\t\tvar files []string\n83\t\ti := 0\n84\t\tfor i < len(args) {\n85\t\t\targ := args[i]\n86\t\t\tif arg == \"--\" {\n87\t\t\t\tfiles = append(files, args[i+1:]...)\n88\t\t\t\tbreak\n89\t\t\t}\n90\t\t\tif handled, advance := parseLongFlag(args[i:], &opts); handled {\n91\t\t\t\ti += advance\n92\t\t\t\tcontinue\n93\t\t\t}\n94\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n95\t\t\t\tfiles = append(files, arg)\n96\t\t\t\ti++\n97\t\t\t\tcontinue\n98\t\t\t}\n99\t\t\ti += parseShortFlags(arg[1:], &opts)\n100\t\t}\n101\t\treturn opts, files\n102\t}\n103\t\n104\tfunc parseLongFlag(remaining []string, opts *options) (bool, int) {\n105\t\targ := remaining[0]\n106\t\tif !strings.HasPrefix(arg, \"--\") {\n107\t\t\treturn false, 0\n108\t\t}\n109\t\tif arg == \"--length\" || strings.HasPrefix(arg, \"--length=\") {\n110\t\t\treturn parseLengthFlag(remaining, opts)\n111\t\t}\n112\t\tswitch arg {\n113\t\tcase \"--binary\":\n114\t\t\topts.binary = true\n115\t\tcase \"--text\":\n116\t\t\topts.binary = false\n117\t\tcase \"--tag\":\n118\t\t\topts.tag = true\n119\t\tcase \"--check\":\n120\t\t\topts.check = true\n121\t\tcase \"--warn\":\n122\t\t\topts.warn = true\n123\t\tcase \"--quiet\":\n124\t\t\topts.quiet = true\n125\t\tcase \"--status\":\n126\t\t\topts.status = true\n127\t\tdefault:\n128\t\t\treturn false, 0\n129\t\t}\n130\t\treturn true, 1\n131\t}\n132\t\n133\tfunc parseLengthFlag(remaining []string, opts *options) (bool, int) {\n134\t\targ := remaining[0]\n135\t\tif strings.HasPrefix(arg, \"--length=\") {\n136\t\t\tval := arg[len(\"--length=\"):]\n137\t\t\tn, err := strconv.Atoi(val)\n138\t\t\tif err != nil {\n139\t\t\t\tfmt.Fprintf(os.Stderr, \"b2sum: invalid length: '%s'\\n\", val)\n140\t\