{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JD5SPgbwjV8BBPG4AkSya4","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\t\"syscall\"\n12\t\n13\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: truncate OPTION... FILE...\n18\tShrink or extend the size of each FILE to the specified size\n19\t\n20\tA FILE argument that does not exist is created.\n21\t\n22\tIf a FILE is larger than the specified size, the extra data is lost.\n23\tIf a FILE is shorter, it is extended and the sparse extended part (hole)\n24\treads as zero bytes.\n25\t\n26\tMandatory arguments to long options are mandatory for short options too.\n27\t  -c, --no-create        do not create any files\n28\t  -o, --io-blocks        treat SIZE as number of IO blocks instead of bytes\n29\t  -r, --reference=RFILE  base size on RFILE\n30\t  -s, --size=SIZE        set or adjust the file size by SIZE bytes\n31\t      --help     display this help and exit\n32\t      --version  output version information and exit\n33\t\n34\tThe SIZE argument is an integer and optional unit (example: 10K is 10*1024).\n35\tUnits are K,M,G,T,P,E,Z,Y,R,Q (powers of 1024) or KB,MB,... (powers of 1000).\n36\tBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\n37\t\n38\tSIZE may also be prefixed by one of the following modifying characters:\n39\t'+' extend by, '-' reduce by, '<' at most, '>' at least,\n40\t'/' round down to multiple of, '%' round up to multiple of.\n41\t`\n42\t\n43\tconst versionText = `truncate (go-unix-utils) dev\n44\t`\n45\t\n46\ttype options struct {\n47\t\tnoCreate  bool\n48\t\tioBlocks  bool\n49\t\treference string\n50\t\tsizeStr   string\n51\t\tsizeSet   bool\n52\t}\n53\t\n54\tfunc main() {\n55\t\tsys.InstallSIGPIPEHandler()\n56\t\topts, files, err := parseArgs(os.Args[1:])\n57\t\tif err != nil {\n58\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n59\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n60\t\t\tos.Exit(1)\n61\t\t}\n62\t\tif !opts.sizeSet && opts.reference == \"\" {\n63\t\t\tfmt.Fprintf(os.Stderr, \"truncate: you must specify either '--size' or '--reference'\\n\")\n64\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n65\t\t\tos.Exit(1)\n66\t\t}\n67\t\tif len(files) == 0 {\n68\t\t\tfmt.Fprintf(os.Stderr, \"truncate: missing file operand\\n\")\n69\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n70\t\t\tos.Exit(1)\n71\t\t}\n72\t\tos.Exit(run(opts, files))\n73\t}\n74\t\n75\tfunc run(opts options, files []string) int {\n76\t\tvar baseSize int64\n77\t\tif opts.reference != \"\" {\n78\t\t\tfi, err := os.Stat(opts.reference)\n79\t\t\tif err != nil {\n80\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: cannot stat %s: %s\\n\",\n81\t\t\t\t\tquote(opts.reference), errMsg(err))\n82\t\t\t\treturn 1\n83\t\t\t}\n84\t\t\tbaseSize = fi.Size()\n85\t\t}\n86\t\n87\t\tvar modifier byte\n88\t\tvar sizeVal int64\n89\t\tif opts.sizeSet {\n90\t\t\tvar err error\n91\t\t\tmodifier, sizeVal, err = parseSize(opts.sizeStr)\n92\t\t\tif err != nil {\n93\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n94\t\t\t\treturn 1\n95\t\t\t}\n96\t\t\tif opts.ioBlocks {\n97\t\t\t\tsizeVal *= ioBlockSize(files[0])\n98\t\t\t}\n99\t\t}\n100\t\n101\t\texitCode := 0\n102\t\tfor _, path := range files {\n103\t\t\tif err := truncateFile(opts, path, baseSize, modifier, sizeVal); err != nil {\n104\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n105\t\t\t\texitCode = 1\n106\t\t\t}\n107\t\t}\n108\t\treturn exitCode\n109\t}\n110\t\n111\tfunc truncateFile(opts options, path string, baseSize int64, modifier byte, sizeVal int64) error {\n112\t\tfi, err := ensureFile(opts, path)\n113\t\tif err != nil {\n114\t\t\treturn err\n115\t\t}\n116\t\tif fi == nil {\n117\t\t\treturn nil\n118\t\t}\n119\t\tnewSize, err := computeSize(opts, fi.Size(), baseSize, modifier, sizeVal)\n120\t\tif err != nil {\n121\t\t\treturn err\n122\t\t}\n123\t\tif err := os.Truncate(path, newSize); err != nil {\n124\t\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n125\t\t\t\tquote(path), errMsg(err))\n126\t\t}\n127\t\treturn nil\n128\t}\n129\t\n130\tfunc ensureFile(opts options, path string) (os.FileInfo, error) {\n131\t\tfi, err := os.Stat(path)\n132\t\tif err != nil && os.IsNotExist(err) {\n133\t\t\tif opts.noCreate {\n134\t\t\t\treturn nil, nil\n135\t\t\t}\n136\t\t\tf, createErr := os.Create(path)\n137\t\t\tif createErr != nil {\n138\t\t\t\treturn nil, fmt.Errorf(\"cannot open %s for writing: %s\",\n139\t\t\t\t\tquote(path), errMsg(createErr))\n140\t\t\t}\n141\t\t\tf.Close()\n142\t\t\tfi, err = os.Stat(path)\n143\t\t}\n144\t\tif err != nil {\n145\t\t\treturn nil, fmt.Errorf(\"cannot open %s for writing: %s\",\n146\t\t\t\tquote(path), errMsg(err))\n147\t\t}\n148\t\treturn fi, nil\n149\t}\n150\t\n151\tfunc computeSize(opts options, currentSize, baseSize int64, modifier byte, sizeVal int64) (int64, error) {\n152\t\tif opts.reference != \"\" && !opts.sizeSet {\n153\t\t\treturn baseSize, nil\n154\t\t}\n155\t\tbase := baseSize\n156\t\tif opts.reference == \"\" {\n157\t\t\tbase = currentSize\n158\t\t}\n159\t\tresult, err := applySize(base, modifier, sizeVal)\n160\t\tif err != nil {\n161\t\t\treturn 0, err\n162\t\t}\n163\t\tif result < 0 {\n164\t\t\treturn 0, nil\n165\t\t}\n166\t\treturn result, nil\n167\t}\n168\t\n169\tfunc applySize(current int64, modifier byte, size int64) (int64, error) {\n170\t\tswitch modifier {\n171\t\tcase 0:\n172\t\t\treturn size, nil\n173\t\tcase '+':\n174\t\t\treturn current + size, nil\n175\t\tcase '-':\n176\t\t\treturn current - size, nil\n177\t\tcase '<':\n178\t\t\tif current < size {\n179\t\t\t\treturn current, nil\n180\t\t\t}\n181\t\t\treturn size, nil\n182\t\tcase '>':\n183\t\t\tif current > size {\n184\t\t\t\treturn current, nil\n185\t\t\t}\n186\t\t\treturn size, nil\n187\t\tcase '/':\n188\t\t\tif size == 0 {\n189\t\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n190\t\t\t}\n191\t\t\treturn (current / size) * size, nil\n192\t\tcase '%':\n193\t\t\tif size == 0 {\n194\t\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n195\t\t\t}\n196\t\t\treturn ((current + size - 1) / size) * size, nil\n197\t\t}\n198\t\treturn size, nil\n199\t}\n200\t\n201\tfunc parseSize(s string) (byte, int64, error) {\n202\t\tif s == \"\" {\n203\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n204\t\t}\n205\t\tvar modifier byte\n206\t\trest := s\n207\t\tif len(rest) > 0 {\n208\t\t\tswitch rest[0] {\n209\t\t\tcase '+', '-', '<', '>', '/', '%':\n210\t\t\t\tmodifier = rest[0]\n211\t\t\t\trest = rest[1:]\n212\t\t\t}\n213\t\t}\n214\t\tif rest == \"\" {\n215\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n216\t\t}\n217\t\tval, err := sizeparse.Parse(rest)\n218\t\tif err != nil {\n219\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n220\t\t}\n221\t\treturn modifier, val, nil\n222\t}\n223\t\n224\tfunc parseArgs(args []string) (options, []string, error) {\n225\t\tvar opts options\n226\t\tvar files []string\n227\t\tendFlags := false\n228\t\tfor i := 0; i < len(args); i++ {\n229\t\t\targ := args[i]\n230\t\t\tif endFlags || !strings.HasPrefix(arg, \"-\") {\n231\t\t\t\tfiles = append(files, arg)\n232\t\t\t\tcontinue\n233\t\t\t}\n234\t\t\tif arg == \"--\" {\n235\t\t\t\tendFlags = true\n236\t\t\t\tcontinue\n237\t\t\t}\n238\t\t\tif strings.HasPrefix(arg, \"--\") {\n239\t\t\t\tadv, err := parseLongFlag(arg, args[i+1:], &opts)\n240\t\t\t\tif err != nil {\n241\t\t\t\t\treturn options{}, nil, err\n242\t\t\t\t}\n243\t\t\t\ti += adv\n244\t\t\t\tcontinue\n245\t\t\t}\n246\t\t\tadv, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n247\t\t\tif err != nil {\n248\t\t\t\treturn options{}, nil, err\n249\t\t\t}\n250\t\t\ti += adv\n251\t\t}\n252\t\treturn opts, files, nil\n253\t}\n254\t\n255\tfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n256\t\tif strings.HasPrefix(flag, \"--size=\") {\n257\t\t\topts.sizeStr = flag[len(\"--size=\"):]\n258\t\t\topts.sizeSet = true\n259\t\t\treturn 0, nil\n260\t\t}\n261\t\tif strings.HasPrefix(flag, \"--reference=\") {\n262\t\t\topts.reference = flag[len(\"--reference=\"):]\n263\t\t\treturn 0, nil\n264\t\t}\n265\t\tswitch flag {\n266\t\tcase \"--size\":\n267\t\t\tif len(rest) == 0 {\n268\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n269\t\t\t}\n270\t\t\topts.sizeStr = rest[0]\n271\t\t\topts.sizeSet = true\n272\t\t\treturn 1, nil\n273\t\tcase \"--reference\":\n274\t\t\tif len(rest) == 0 {\n275\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n276\t\t\t}\n277\t\t\topts.reference = rest[0]\n278\t\t\treturn 1, nil\n279\t\tcase \"--no-create\":\n280\t\t\topts.noCreate = true\n281\t\tcase \"--io-blocks\":\n282\t\t\topts.ioBlocks = true\n283\t\tcase \"--help\":\n284\t\t\tfmt.Fprint(os.Stdout, helpText)\n285\t\t\tos.Exit(0)\n286\t\tcase \"--version\":\n287\t\t\tfmt.Fprint(os.Stdout, versionText)\n288\t\t\tos.Exit(0)\n289\t\tdefault:\n290\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n291\t\t}\n292\t\treturn 0, nil\n293\t}\n294\t\n295\tfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n296\t\tfor i, ch := range flags {\n297\t\t\tswitch ch {\n298\t\t\tcase 'c':\n299\t\t\t\topts.noCreate = true\n300\t\t\tcase 'o':\n301\t\t\t\topts.ioBlocks = true\n302\t\t\tcase 's':\n303\t\t\t\topts.sizeSet = true\n304\t\t\t\tremaining := flags[i+1:]\n305\t\t\t\tif remaining != \"\" {\n306\t\t\t\t\topts.sizeStr = remaining\n307\t\t\t\t\treturn 0, nil\n308\t\t\t\t}\n309\t\t\t\tif len(rest) == 0 {\n310\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n311\t\t\t\t}\n312\t\t\t\topts.sizeStr = rest[0]\n313\t\t\t\treturn 1, nil\n314\t\t\tcase 'r':\n315\t\t\t\tremaining := flags[i+1:]\n316\t\t\t\tif remaining != \"\" {\n317\t\t\t\t\topts.reference = remaining\n318\t\t\t\t\treturn 0, nil\n319\t\t\t\t}\n320\t\t\t\tif len(rest) == 0 {\n321\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'r'\")\n322\t\t\t\t}\n323\t\t\t\topts.reference = rest[0]\n324\t\t\t\treturn 1, nil\n325\t\t\tdefault:\n326\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", ch)\n327\t\t\t}\n328\t\t}\n329\t\treturn 0, nil\n330\t}\n331\t\n332\tfunc ioBlockSize(path string) int64 {\n333\t\tdir := filepath.Dir(path)\n334\t\tvar fs syscall.Statfs_t\n335\t\tif err := syscall.Statfs(dir, &fs); err != nil {\n336\t\t\treturn 512\n337\t\t}\n338\t\treturn int64(fs.Bsize)\n339\t}\n340\t\n341\tfunc quote(s string) string {\n342\t\treturn \"'\" + s + \"'\"\n343\t}\n344\t\n345\tfunc errMsg(err error) string {\n346\t\tmsg := err.Error()\n347\t\tfor _, prefix := range []string{\"stat \", \"open \", \"truncate \"} {\n348\t\t\tif strings.HasPrefix(msg, prefix) {\n349\t\t\t\tidx := strings.LastIndex(msg, \": \")\n350\t\t\t\tif idx >= 0 {\n351\t\t\t\t\treturn capitalizeFirst(msg[idx+2:])\n352\t\t\t\t}\n353\t\t\t}\n354\t\t}\n355\t\treturn capitalizeFirst(msg)\n356\t}\n357\t\n358\tfunc capitalizeFirst(s string) string {\n359\t\tif len(s) == 0 {\n360\t\t\treturn s\n361\t\t}\n362\t\treturn strings.ToUpper(s[:1]) + s[1:]\n363\t}\n364\t"}]},"parent_tool_use_id":null,"session_id":"ede6aa71-a717-43ea-b101-79b7e0fd4eff","uuid":"a33b6d7c-9a41-4fd4-a927-36a39bb27c25","timestamp":"2026-05-23T15:56:46.933Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5540/cmd/truncate/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: truncate OPTION... FILE...\nShrink or extend the size of each FILE to the specified size\n\nA FILE argument that does not exist is created.\n\nIf a FILE is larger than the specified size, the extra data is lost.\nIf a FILE is shorter, it is extended and the sparse extended part (hole)\nreads as zero bytes.\n\nMandatory arguments to long options are mandatory for short options too.\n  -c, --no-create        do not create any files\n  -o, --io-blocks        treat SIZE as number of IO blocks instead of bytes\n  -r, --reference=RFILE  base size on RFILE\n  -s, --size=SIZE        set or adjust the file size by SIZE bytes\n      --help     display this help and exit\n      --version  output version information and exit\n\nThe SIZE argument is an integer and optional unit (example: 10K is 10*1024).\nUnits are K,M,G,T,P,E,Z,Y,R,Q (powers of 1024) or KB,MB,... (powers of 1000).\nBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\n\nSIZE may also be prefixed by one of the following modifying characters:\n'+' extend by, '-' reduce by, '<' at most, '>' at least,\n'/' round down to multiple of, '%' round up to multiple of.\n`\n\nconst versionText = `truncate (go-unix-utils) dev\n`\n\ntype options struct {\n\tnoCreate  bool\n\tioBlocks  bool\n\treference string\n\tsizeStr   string\n\tsizeSet   bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\tif !opts.sizeSet && opts.reference == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"truncate: you must specify either '--size' or '--reference'\\n\")\n\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\tif len(files) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"truncate: missing file operand\\n\")\n\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\tos.Exit(run(opts, files))\n}\n\nfunc run(opts options, files []string) int {\n\tvar baseSize int64\n\tif opts.reference != \"\" {\n\t\tfi, err := os.Stat(opts.reference)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"truncate: cannot stat %s: %s\\n\",\n\t\t\t\tquote(opts.reference), errMsg(err))\n\t\t\treturn 1\n\t\t}\n\t\tbaseSize = fi.Size()\n\t}\n\n\tvar modifier byte\n\tvar sizeVal int64\n\tif opts.sizeSet {\n\t\tvar err error\n\t\tmodifier, sizeVal, err = parseSize(opts.sizeStr)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tif opts.ioBlocks {\n\t\t\tsizeVal *= ioBlockSize(files[0])\n\t\t}\n\t}\n\n\texitCode := 0\n\tfor _, path := range files {\n\t\tif err := truncateFile(opts, path, baseSize, modifier, sizeVal); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc truncateFile(opts options, path string, baseSize int64, modifier byte, sizeVal int64) error {\n\tfi, err := ensureFile(opts, path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif fi == nil {\n\t\treturn nil\n\t}\n\tnewSize, err := computeSize(opts, fi.Size(), baseSize, modifier, sizeVal)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif err := os.Truncate(path, newSize); err != nil {\n\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n\t\t\tquote(path), errMsg(err))\n\t}\n\treturn nil\n}\n\nfunc ensureFile(opts options, path string) (os.FileInfo, error) {\n\tfi, err := os.Stat(path)\n\tif err != nil && os.IsNotExist(err) {\n\t\tif opts.noCreate {\n\t\t\treturn nil, nil\n\t\t}\n\t\tf, createErr := os.Create(path)\n\t\tif createErr != nil {\n\t\t\treturn nil, fmt.Errorf(\"cannot open %s for writing: %s\",\n\t\t\t\tquote(path), errMsg(createErr))\n\t\t}\n\t\tf.Close()\n\t\tfi, err = os.Stat(path)\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"cannot open %s for writing: %s\",\n\t\t\tquote(path), errMsg(err))\n\t}\n\treturn fi, nil\n}\n\nfunc computeSize(opts options, currentSize, baseSize int64, modifier byte, sizeVal int64) (int64, error) {\n\tif opts.reference != \"\" && !opts.sizeSet {\n\t\treturn baseSize, nil\n\t}\n\tbase := baseSize\n\tif opts.reference == \"\" {\n\t\tbase = currentSize\n\t}\n\tresult, err := applySize(base, modifier, sizeVal)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tif result < 0 {\n\t\treturn 0, nil\n\t}\n\treturn result, nil\n}\n\nfunc applySize(current int64, modifier byte, size int64) (int64, error) {\n\tswitch modifier {\n\tcase 0:\n\t\treturn size, nil\n\tcase '+':\n\t\treturn current + size, nil\n\tcase '-':\n\t\treturn current - size, nil\n\tcase '<':\n\t\tif current < size {\n\t\t\treturn current, nil\n\t\t}\n\t\treturn size, nil\n\tcase '>':\n\t\tif current > size {\n\t\t\treturn current, nil\n\t\t}\n\t\treturn size, nil\n\tcase '/':\n\t\tif size == 0 {\n\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n\t\t}\n\t\treturn (current / size) * size, nil\n\tcase '%':\n\t\tif size == 0 {\n\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n\t\t}\n\t\treturn ((current + size - 1) / size) * size, nil\n\t}\n\treturn size, nil\n}\n\nfunc parseSize(s string) (byte, int64, error) {\n\tif s == \"\" {\n\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n\t}\n\tvar modifier byte\n\trest := s\n\tif len(rest) > 0 {\n\t\tswitch rest[0] {\n\t\tcase '+', '-', '<', '>', '/', '%':\n\t\t\tmodifier = rest[0]\n\t\t\trest = rest[1:]\n\t\t}\n\t}\n\tif rest == \"\" {\n\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n\t}\n\tval, err := sizeparse.Parse(rest)\n\tif err != nil {\n\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n\t}\n\treturn modifier, val, nil\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar files []string\n\tendFlags := false\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif endFlags || !strings.HasPrefix(arg, \"-\") {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tadv, err := parseLongFlag(arg, args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn options{}, nil, err\n\t\t\t}\n\t\t\ti += adv\n\t\t\tcontinue\n\t\t}\n\t\tadv, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\tif err != nil {\n\t\t\treturn options{}, nil, err\n\t\t}\n\t\ti += adv\n\t}\n\treturn opts, files, nil\n}\n\nfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n\tif strings.HasPrefix(flag, \"--size=\") {\n\t\topts.sizeStr = flag[len(\"--size=\"):]\n\t\topts.sizeSet = true\n\t\treturn 0, nil\n\t}\n\tif strings.HasPrefix(flag, \"--reference=\") {\n\t\topts.reference = flag[len(\"--reference=\"):]\n\t\treturn 0, nil\n\t}\n\tswitch flag {\n\tcase \"--size\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\topts.sizeStr = rest[0]\n\t\topts.sizeSet = true\n\t\treturn 1, nil\n\tcase \"--reference\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\topts.reference = rest[0]\n\t\treturn 1, nil\n\tcase \"--no-create\":\n\t\topts.noCreate = true\n\tcase \"--io-blocks\":\n\t\topts.ioBlocks = true\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n\treturn 0, nil\n}\n\nfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n\tfor i, ch := range flags {\n\t\tswitch ch {\n\t\tcase 'c':\n\t\t\topts.noCreate = true\n\t\tcase 'o':\n\t\t\topts.ioBlocks = true\n\t\tcase 's':\n\t\t\topts.sizeSet = true\n\t\t\tremaining := flags[i+1:]\n\t\t\tif remaining != \"\" {\n\t\t\t\topts.sizeStr = remaining\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(rest) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n\t\t\t}\n\t\t\topts.sizeStr = rest[0]\n\t\t\treturn 1, nil\n\t\tcase 'r':\n\t\t\tremaining := flags[i+1:]\n\t\t\tif remaining != \"\" {\n\t\t\t\topts.reference = remaining\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(rest) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'r'\")\n\t\t\t}\n\t\t\topts.reference = rest[0]\n\t\t\treturn 1, nil\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", ch)\n\t\t}\n\t}\n\treturn 0, nil\n}\n\nfunc ioBlockSize(path string) int64 {\n\tdir := filepath.Dir(path)\n\tvar fs syscall.Statfs_t\n\tif err := syscall.Statfs(dir, &fs); err != nil {\n\t\treturn 512\n\t}\n\treturn int64(fs.Bsize)\n}\n\nfunc quote(s string) string {\n\treturn \"'\" + s + \"'\"\n}\n\nfunc errMsg(err error) string {\n\tmsg := err.Error()\n\tfor _, prefix := range []string{\"stat \", \"open \", \"truncate \"} {\n\t\tif strings.HasPrefix(msg, prefix) {\n\t\t\tidx := strings.LastIndex(msg, \": \")\n\t\t\tif idx >= 0 {\n\t\t\t\treturn capitalizeFirst(msg[idx+2:])\n\t\t\t}\n\t\t}\n\t}\n\treturn capitalizeFirst(msg)\n}\n\nfunc capitalizeFirst(s string) string {\n\tif len(s) == 0 {\n\t\treturn s\n\t}\n\treturn strings.ToUpper(s[:1]) + s[1:]\n}\n","numLines":364,"startLine":1,"totalLines":364}}}
