{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018yjK2rxH5J41gZP71r6DKp","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst helpText = `Usage: head [OPTION]... [FILE]...\n19\tPrint the first 10 lines of each FILE to standard output.\n20\tWith more than one FILE, precede each with a header giving the file name.\n21\t\n22\tWith no FILE, or when FILE is -, read standard input.\n23\t\n24\tMandatory arguments to long options are mandatory for short options too.\n25\t  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n26\t                             with the leading '-', print all but the last\n27\t                             NUM bytes of each file\n28\t  -n, --lines=[-]NUM       output the first NUM lines instead of the first 10;\n29\t                             with the leading '-', output all but the last\n30\t                             NUM lines of each file\n31\t  -q, --quiet, --silent    never print headers giving file names\n32\t  -v, --verbose            always print headers giving file names\n33\t      --help        display this help and exit\n34\t      --version     output version information and exit\n35\t`\n36\t\n37\tconst versionText = `head (go-unix-utils) dev\n38\t`\n39\t\n40\ttype countMode int\n41\t\n42\tconst (\n43\t\tmodeLines countMode = iota\n44\t\tmodeBytes\n45\t)\n46\t\n47\ttype headerMode int\n48\t\n49\tconst (\n50\t\theaderAuto headerMode = iota\n51\t\theaderAlways\n52\t\theaderNever\n53\t)\n54\t\n55\ttype options struct {\n56\t\tmode   countMode\n57\t\tcount  int64\n58\t\theader headerMode\n59\t}\n60\t\n61\tfunc main() {\n62\t\tsys.InstallSIGPIPEHandler()\n63\t\n64\t\topts, files, err := parseArgs(os.Args[1:])\n65\t\tif err != nil {\n66\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n67\t\t\tfmt.Fprintf(os.Stderr, \"Try 'head --help' for more information.\\n\")\n68\t\t\tos.Exit(1)\n69\t\t}\n70\t\n71\t\tif len(files) == 0 {\n72\t\t\tfiles = []string{\"-\"}\n73\t\t}\n74\t\n75\t\tshowHeaders := opts.header == headerAlways ||\n76\t\t\t(opts.header == headerAuto && len(files) > 1)\n77\t\n78\t\texitCode := 0\n79\t\tfirstOutput := true\n80\t\tfor _, file := range files {\n81\t\t\tr, closer, err := openInput(file)\n82\t\t\tif err != nil {\n83\t\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n84\t\t\t\texitCode = 1\n85\t\t\t\tcontinue\n86\t\t\t}\n87\t\t\tif showHeaders {\n88\t\t\t\tprintHeader(file, !firstOutput)\n89\t\t\t}\n90\t\t\tfirstOutput = false\n91\t\t\tif err := processInput(opts, r, os.Stdout); err != nil {\n92\t\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n93\t\t\t\texitCode = 1\n94\t\t\t}\n95\t\t\tif closer != nil {\n96\t\t\t\tcloser.Close()\n97\t\t\t}\n98\t\t}\n99\t\tif exitCode != 0 {\n100\t\t\tos.Exit(exitCode)\n101\t\t}\n102\t}\n103\t\n104\tfunc printHeader(name string, needsBlank bool) {\n105\t\tif needsBlank {\n106\t\t\tfmt.Fprintln(os.Stdout)\n107\t\t}\n108\t\tfmt.Fprintf(os.Stdout, \"==> %s <==\\n\", name)\n109\t}\n110\t\n111\tfunc parseArgs(args []string) (options, []string, error) {\n112\t\topts := options{count: 10}\n113\t\tvar files []string\n114\t\n115\t\ti := 0\n116\t\tfor i < len(args) {\n117\t\t\targ := args[i]\n118\t\t\tif arg == \"--\" {\n119\t\t\t\tfiles = append(files, args[i+1:]...)\n120\t\t\t\tbreak\n121\t\t\t}\n122\t\t\tif strings.HasPrefix(arg, \"--\") {\n123\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n124\t\t\t\tif err != nil {\n125\t\t\t\t\treturn opts, nil, err\n126\t\t\t\t}\n127\t\t\t\ti += n\n128\t\t\t\tcontinue\n129\t\t\t}\n130\t\t\tif len(arg) > 1 && arg[0] == '-' {\n131\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n132\t\t\t\tif err != nil {\n133\t\t\t\t\treturn opts, nil, err\n134\t\t\t\t}\n135\t\t\t\ti += 1 + n\n136\t\t\t\tcontinue\n137\t\t\t}\n138\t\t\tfiles = append(files, arg)\n139\t\t\ti++\n140\t\t}\n141\t\n142\t\treturn opts, files, nil\n143\t}\n144\t\n145\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n146\t\tswitch {\n147\t\tcase flag == \"--help\":\n148\t\t\tfmt.Fprint(os.Stdout, helpText)\n149\t\t\tos.Exit(0)\n150\t\t\treturn 0, nil\n151\t\tcase flag == \"--version\":\n152\t\t\tfmt.Fprint(os.Stdout, versionText)\n153\t\t\tos.Exit(0)\n154\t\t\treturn 0, nil\n155\t\tcase flag == \"--lines\":\n156\t\t\tif len(remaining) < 2 {\n157\t\t\t\treturn 0, fmt.Errorf(\"option '--lines' requires an argument\")\n158\t\t\t}\n159\t\t\tcount, err := parseLineCount(remaining[1])\n160\t\t\tif err != nil {\n161\t\t\t\treturn 0, err\n162\t\t\t}\n163\t\t\topts.count = count\n164\t\t\topts.mode = modeLines\n165\t\t\treturn 2, nil\n166\t\tcase strings.HasPrefix(flag, \"--lines=\"):\n167\t\t\tcount, err := parseLineCount(flag[len(\"--lines=\"):])\n168\t\t\tif err != nil {\n169\t\t\t\treturn 0, err\n170\t\t\t}\n171\t\t\topts.count = count\n172\t\t\topts.mode = modeLines\n173\t\t\treturn 1, nil\n174\t\tcase flag == \"--bytes\":\n175\t\t\tif len(remaining) < 2 {\n176\t\t\t\treturn 0, fmt.Errorf(\"option '--bytes' requires an argument\")\n177\t\t\t}\n178\t\t\tcount, err := parseByteCount(remaining[1])\n179\t\t\tif err != nil {\n180\t\t\t\treturn 0, err\n181\t\t\t}\n182\t\t\topts.count = count\n183\t\t\topts.mode = modeBytes\n184\t\t\treturn 2, nil\n185\t\tcase strings.HasPrefix(flag, \"--bytes=\"):\n186\t\t\tcount, err := parseByteCount(flag[len(\"--bytes=\"):])\n187\t\t\tif err != nil {\n188\t\t\t\treturn 0, err\n189\t\t\t}\n190\t\t\topts.count = count\n191\t\t\topts.mode = modeBytes\n192\t\t\treturn 1, nil\n193\t\tcase flag == \"--quiet\" || flag == \"--silent\":\n194\t\t\topts.header = headerNever\n195\t\t\treturn 1, nil\n196\t\tcase flag == \"--verbose\":\n197\t\t\topts.header = headerAlways\n198\t\t\treturn 1, nil\n199\t\tdefault:\n200\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n201\t\t}\n202\t}\n203\t\n204\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n205\t\tconsumed := 0\n206\t\tfor j := 0; j < len(flags); j++ {\n207\t\t\tswitch flags[j] {\n208\t\t\tcase 'n':\n209\t\t\t\tvar val string\n210\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n211\t\t\t\t\tval = rest\n212\t\t\t\t} else if len(remaining) > consumed {\n213\t\t\t\t\tval = remaining[consumed]\n214\t\t\t\t\tconsumed++\n215\t\t\t\t} else {\n216\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'n'\")\n217\t\t\t\t}\n218\t\t\t\tcount, err := parseLineCount(val)\n219\t\t\t\tif err != nil {\n220\t\t\t\t\treturn 0, err\n221\t\t\t\t}\n222\t\t\t\topts.count = count\n223\t\t\t\topts.mode = modeLines\n224\t\t\t\treturn consumed, nil\n225\t\t\tcase 'c':\n226\t\t\t\tvar val string\n227\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n228\t\t\t\t\tval = rest\n229\t\t\t\t} else if len(remaining) > consumed {\n230\t\t\t\t\tval = remaining[consumed]\n231\t\t\t\t\tconsumed++\n232\t\t\t\t} else {\n233\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'c'\")\n234\t\t\t\t}\n235\t\t\t\tcount, err := parseByteCount(val)\n236\t\t\t\tif err != nil {\n237\t\t\t\t\treturn 0, err\n238\t\t\t\t}\n239\t\t\t\topts.count = count\n240\t\t\t\topts.mode = modeBytes\n241\t\t\t\treturn consumed, nil\n242\t\t\tcase 'q':\n243\t\t\t\topts.header = headerNever\n244\t\t\tcase 'v':\n245\t\t\t\topts.header = headerAlways\n246\t\t\tdefault:\n247\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n248\t\t\t}\n249\t\t}\n250\t\treturn consumed, nil\n251\t}\n252\t\n253\tfunc parseLineCount(s string) (int64, error) {\n254\t\tn, err := strconv.ParseInt(s, 10, 64)\n255\t\tif err != nil {\n256\t\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n257\t\t}\n258\t\treturn n, nil\n259\t}\n260\t\n261\tfunc parseByteCount(s string) (int64, error) {\n262\t\tn, err := sizeparse.ParseWithOptions(s, sizeparse.ParseOptions{AllowSign: true})\n263\t\tif err != nil {\n264\t\t\treturn 0, fmt.Errorf(\"invalid number of bytes: '%s'\", s)\n265\t\t}\n266\t\treturn n, nil\n267\t}\n268\t\n269\tfunc processInput(opts options, r io.Reader, w io.Writer) error {\n270\t\tswitch opts.mode {\n271\t\tcase modeBytes:\n272\t\t\treturn headBytes(r, w, opts.count)\n273\t\tdefault:\n274\t\t\treturn headLines(r, w, opts.count)\n275\t\t}\n276\t}\n277\t\n278\tfunc openInput(name string) (io.Reader, io.Closer, error) {\n279\t\tif name == \"-\" {\n280\t\t\treturn os.Stdin, nil, nil\n281\t\t}\n282\t\tf, err := os.Open(name)\n283\t\tif err != nil {\n284\t\t\treturn nil, nil, err\n285\t\t}\n286\t\treturn f, f, nil\n287\t}\n288\t\n289\tfunc headLines(r io.Reader, w io.Writer, count int64) error {\n290\t\tif count == 0 {\n291\t\t\treturn nil\n292\t\t}\n293\t\tif count < 0 {\n294\t\t\treturn headLinesFromEnd(r, w, -count)\n295\t\t}\n296\t\treturn headLinesFromStart(r, w, count)\n297\t}\n298\t\n299\tfunc headLinesFromStart(r io.Reader, w io.Writer, n int64) error {\n300\t\tbr := bufio.NewReader(r)\n301\t\tfor range n {\n302\t\t\tline, err := br.ReadBytes('\\n')\n303\t\t\tif len(line) > 0 {\n304\t\t\t\tif _, werr := w.Write(line); werr != nil {\n305\t\t\t\t\treturn werr\n306\t\t\t\t}\n307\t\t\t}\n308\t\t\tif err != nil {\n309\t\t\t\treturn nil\n310\t\t\t}\n311\t\t}\n312\t\treturn nil\n313\t}\n314\t\n315\tfunc headLinesFromEnd(r io.Reader, w io.Writer, n int64) error {\n316\t\tbr := bufio.NewReader(r)\n317\t\tvar lines [][]byte\n318\t\tfor {\n319\t\t\tline, err := br.ReadBytes('\\n')\n320\t\t\tif len(line) > 0 {\n321\t\t\t\tlines = append(lines, line)\n322\t\t\t}\n323\t\t\tif err != nil {\n324\t\t\t\tbreak\n325\t\t\t}\n326\t\t}\n327\t\tend := max(int64(len(lines))-n, 0)\n328\t\tfor i := range end {\n329\t\t\tif _, err := w.Write(lines[i]); err != nil {\n330\t\t\t\treturn err\n331\t\t\t}\n332\t\t}\n333\t\treturn nil\n334\t}\n335\t\n336\tfunc headBytes(r io.Reader, w io.Writer, count int64) error {\n337\t\tif count == 0 {\n338\t\t\treturn nil\n339\t\t}\n340\t\tif count < 0 {\n341\t\t\treturn headBytesFromEnd(r, w, -count)\n342\t\t}\n343\t\treturn headBytesFromStart(r, w, count)\n344\t}\n345\t\n346\tfunc headBytesFromStart(r io.Reader, w io.Writer, n int64) error {\n347\t\t_, err := io.CopyN(w, r, n)\n348\t\tif err == io.EOF {\n349\t\t\treturn nil\n350\t\t}\n351\t\treturn err\n352\t}\n353\t\n354\tfunc headBytesFromEnd(r io.Reader, w io.Writer, n int64) error {\n355\t\tdata, err := io.ReadAll(r)\n356\t\tif err != nil {\n357\t\t\treturn err\n358\t\t}\n359\t\tend := int64(len(data)) - n\n360\t\tif end <= 0 {\n361\t\t\treturn nil\n362\t\t}\n363\t\t_, err = w.Write(data[:end])\n364\t\treturn err\n365\t}\n366\t"}]},"parent_tool_use_id":null,"session_id":"712b3c0a-6d67-4325-96d0-05fbcefa3c92","uuid":"000f63d6-a12d-4124-ae08-dc9a899d3922","timestamp":"2026-05-21T19:10:48.014Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5444/cmd/head/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: head [OPTION]... [FILE]...\nPrint the first 10 lines of each FILE to standard output.\nWith more than one FILE, precede each with a header giving the file name.\n\nWith no FILE, or when FILE is -, read standard input.\n\nMandatory arguments to long options are mandatory for short options too.\n  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n                             with the leading '-', print all but the last\n                             NUM bytes of each file\n  -n, --lines=[-]NUM       output the first NUM lines instead of the first 10;\n                             with the leading '-', output all but the last\n                             NUM lines of each file\n  -q, --quiet, --silent    never print headers giving file names\n  -v, --verbose            always print headers giving file names\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `head (go-unix-utils) dev\n`\n\ntype countMode int\n\nconst (\n\tmodeLines countMode = iota\n\tmodeBytes\n)\n\ntype headerMode int\n\nconst (\n\theaderAuto headerMode = iota\n\theaderAlways\n\theaderNever\n)\n\ntype options struct {\n\tmode   countMode\n\tcount  int64\n\theader headerMode\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'head --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\tshowHeaders := opts.header == headerAlways ||\n\t\t(opts.header == headerAuto && len(files) > 1)\n\n\texitCode := 0\n\tfirstOutput := true\n\tfor _, file := range files {\n\t\tr, closer, err := openInput(file)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif showHeaders {\n\t\t\tprintHeader(file, !firstOutput)\n\t\t}\n\t\tfirstOutput = false\n\t\tif err := processInput(opts, r, os.Stdout); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"head: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t\tif closer != nil {\n\t\t\tcloser.Close()\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc printHeader(name string, needsBlank bool) {\n\tif needsBlank {\n\t\tfmt.Fprintln(os.Stdout)\n\t}\n\tfmt.Fprintf(os.Stdout, \"==> %s <==\\n\", name)\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\topts := options{count: 10}\n\tvar files []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\tfiles = append(files, arg)\n\t\ti++\n\t}\n\n\treturn opts, files, nil\n}\n\nfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--lines\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--lines' requires an argument\")\n\t\t}\n\t\tcount, err := parseLineCount(remaining[1])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeLines\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--lines=\"):\n\t\tcount, err := parseLineCount(flag[len(\"--lines=\"):])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeLines\n\t\treturn 1, nil\n\tcase flag == \"--bytes\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--bytes' requires an argument\")\n\t\t}\n\t\tcount, err := parseByteCount(remaining[1])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeBytes\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--bytes=\"):\n\t\tcount, err := parseByteCount(flag[len(\"--bytes=\"):])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.count = count\n\t\topts.mode = modeBytes\n\t\treturn 1, nil\n\tcase flag == \"--quiet\" || flag == \"--silent\":\n\t\topts.header = headerNever\n\t\treturn 1, nil\n\tcase flag == \"--verbose\":\n\t\topts.header = headerAlways\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 'n':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'n'\")\n\t\t\t}\n\t\t\tcount, err := parseLineCount(val)\n\t\t\tif err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t\topts.count = count\n\t\t\topts.mode = modeLines\n\t\t\treturn consumed, nil\n\t\tcase 'c':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'c'\")\n\t\t\t}\n\t\t\tcount, err := parseByteCount(val)\n\t\t\tif err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t\topts.count = count\n\t\t\topts.mode = modeBytes\n\t\t\treturn consumed, nil\n\t\tcase 'q':\n\t\t\topts.header = headerNever\n\t\tcase 'v':\n\t\t\topts.header = headerAlways\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn consumed, nil\n}\n\nfunc parseLineCount(s string) (int64, error) {\n\tn, err := strconv.ParseInt(s, 10, 64)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid number of lines: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc parseByteCount(s string) (int64, error) {\n\tn, err := sizeparse.ParseWithOptions(s, sizeparse.ParseOptions{AllowSign: true})\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid number of bytes: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc processInput(opts options, r io.Reader, w io.Writer) error {\n\tswitch opts.mode {\n\tcase modeBytes:\n\t\treturn headBytes(r, w, opts.count)\n\tdefault:\n\t\treturn headLines(r, w, opts.count)\n\t}\n}\n\nfunc openInput(name string) (io.Reader, io.Closer, error) {\n\tif name == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc headLines(r io.Reader, w io.Writer, count int64) error {\n\tif count == 0 {\n\t\treturn nil\n\t}\n\tif count < 0 {\n\t\treturn headLinesFromEnd(r, w, -count)\n\t}\n\treturn headLinesFromStart(r, w, count)\n}\n\nfunc headLinesFromStart(r io.Reader, w io.Writer, n int64) error {\n\tbr := bufio.NewReader(r)\n\tfor range n {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tif _, werr := w.Write(line); werr != nil {\n\t\t\t\treturn werr\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\treturn nil\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc headLinesFromEnd(r io.Reader, w io.Writer, n int64) error {\n\tbr := bufio.NewReader(r)\n\tvar lines [][]byte\n\tfor {\n\t\tline, err := br.ReadBytes('\\n')\n\t\tif len(line) > 0 {\n\t\t\tlines = append(lines, line)\n\t\t}\n\t\tif err != nil {\n\t\t\tbreak\n\t\t}\n\t}\n\tend := max(int64(len(lines))-n, 0)\n\tfor i := range end {\n\t\tif _, err := w.Write(lines[i]); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc headBytes(r io.Reader, w io.Writer, count int64) error {\n\tif count == 0 {\n\t\treturn nil\n\t}\n\tif count < 0 {\n\t\treturn headBytesFromEnd(r, w, -count)\n\t}\n\treturn headBytesFromStart(r, w, count)\n}\n\nfunc headBytesFromStart(r io.Reader, w io.Writer, n int64) error {\n\t_, err := io.CopyN(w, r, n)\n\tif err == io.EOF {\n\t\treturn nil\n\t}\n\treturn err\n}\n\nfunc headBytesFromEnd(r io.Reader, w io.Writer, n int64) error {\n\tdata, err := io.ReadAll(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tend := int64(len(data)) - n\n\tif end <= 0 {\n\t\treturn nil\n\t}\n\t_, err = w.Write(data[:end])\n\treturn err\n}\n","numLines":366,"startLine":1,"totalLines":366}}}
