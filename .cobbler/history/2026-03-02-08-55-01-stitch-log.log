seNormalizers returns a single NormalizeFunc that applies the given\n// functions in order. (prd001-testutils R4.4)\nfunc ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n\treturn func(b []byte) []byte {\n\t\tfor _, fn := range fns {\n\t\t\tb = fn(b)\n\t\t}\n\t\treturn b\n\t}\n}\n","structuredPatch":[],"originalFile":null}}
