ding/hex\n9879\t            - bufio\n9880\t            - strings\n9881\t            - regexp\n9882\t        import_constraints:\n9883\t            - Must not import any cmd/ package.\n9884\t            - Must not import any other pkg/ package.\n9885\t    - srd_id: srd087-sizeparse\n9886\t      contract:\n9887\t        exports:\n9888\t            - name: ParseOptions\n9889\t              signature: type ParseOptions struct { AllowSign bool; DefaultUnit int64 }\n9890\t            - name: Parse\n9891\t              signature: func Parse(s string) (int64, error)\n9892\t            - name: ParseWithOptions\n9893\t              signature: func ParseWithOptions(s string, opts ParseOptions) (int64, error)\n9894\t        imports:\n9895\t            - fmt\n9896\t            - strconv\n9897\t            - strings\n9898\t        import_constraints:\n9899\t            - Must not import any cmd/ package.\n9900\t            - Must not import any other pkg/ package.\n9901\t    - srd_id: srd088-encutil\n9902\t      contract:\n9903\t        exports:\n9904\t            - name: EncoderConfig\n9905\t              signature: type EncoderConfig struct { Encode func([]byte) string; WrapCol int }\n9906\t            - name: DecoderConfig\n9907\t              signature: type DecoderConfig struct { Decode func(string) ([]byte, error); IgnoreGarbage bool }\n9908\t            - name: Encode\n9909\t              signature: func Encode(r io.Reader, w io.Writer, cfg EncoderConfig) error\n9910\t            - name: Decode\n9911\t              signature: func Decode(r io.Reader, w io.Writer, cfg DecoderConfig) error\n9912\t            - name: OpenInput\n9913\t              signature: func OpenInput(filename string) (io.ReadCloser, error)\n9914\t        imports:\n9915\t            - io\n9916\t            - os\n9917\t            - bufio\n9918\t            - strings\n9919\t        import_constraints:\n9920\t            - Must not import any cmd/ package.\n9921\t            - Must not import any other pkg