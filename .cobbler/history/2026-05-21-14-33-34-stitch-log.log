{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016excdU5w2iqH1BDnvf6rzm","type":"tool_result","content":"1\tpackage main\n2\t\n3\timport (\n4\t\t\"bufio\"\n5\t\t\"bytes\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"math/rand/v2\"\n9\t\t\"os\"\n10\t\t\"strconv\"\n11\t\t\"strings\"\n12\t\n13\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n14\t)\n15\t\n16\ttype options struct {\n17\t\tinputRange   [2]int\n18\t\thasRange     bool\n19\t\theadCount    int\n20\t\thasHead      bool\n21\t\trepeat       bool\n22\t\toutputFile   string\n23\t\trandomSource string\n24\t\tzeroTerm     bool\n25\t\techo         bool\n26\t}\n27\t\n28\tfunc main() {\n29\t\tsys.InstallSIGPIPEHandler()\n30\t\n31\t\topts, files, err := parseArgs(os.Args[1:])\n32\t\tif err != nil {\n33\t\t\tfmt.Fprintf(os.Stderr, \"shuf: %v\\n\", err)\n34\t\t\tos.Exit(1)\n35\t\t}\n36\t\n37\t\tif opts.hasRange && (opts.echo || len(files) > 0) {\n38\t\t\tif opts.echo {\n39\t\t\t\tfmt.Fprintf(os.Stderr, \"shuf: cannot combine -e and -i options\\n\")\n40\t\t\t} else {\n41\t\t\t\tfmt.Fprintf(os.Stderr, \"shuf: extra operand %q\\n\", files[0])\n42\t\t\t}\n43\t\t\tos.Exit(1)\n44\t\t}\n45\t\n46\t\trng, err := makeRNG(opts)\n47\t\tif err != nil {\n48\t\t\tfmt.Fprintf(os.Stderr, \"shuf: %v\\n\", err)\n49\t\t\tos.Exit(1)\n50\t\t}\n51\t\n52\t\tlines, err := collectLines(opts, files)\n53\t\tif err != nil {\n54\t\t\tfmt.Fprintf(os.Stderr, \"shuf: %v\\n\", err)\n55\t\t\tos.Exit(1)\n56\t\t}\n57\t\n58\t\tw, closer, err := openOutput(opts)\n59\t\tif err != nil {\n60\t\t\tfmt.Fprintf(os.Stderr, \"shuf: %v\\n\", err)\n61\t\t\tos.Exit(1)\n62\t\t}\n63\t\n64\t\tif err := writeOutput(w, lines, opts, rng); err != nil {\n65\t\t\tfmt.Fprintf(os.Stderr, \"shuf: write error: %v\\n\", err)\n66\t\t\tos.Exit(1)\n67\t\t}\n68\t\n69\t\tif closer != nil {\n70\t\t\tif err := closer.Close(); err != nil {\n71\t\t\t\tfmt.Fprintf(os.Stderr, \"shuf: write error: %v\\n\", err)\n72\t\t\t\tos.Exit(1)\n73\t\t\t}\n74\t\t}\n75\t}\n76\t\n77\tfunc makeRNG(opts options) (*rand.Rand, error) {\n78\t\tif opts.randomSource == \"\" {\n79\t\t\treturn nil, nil\n80\t\t}\n81\t\tdata, err := os.ReadFile(opts.randomSource)\n82\t\tif err != nil {\n83\t\t\treturn nil, err\n84\t\t}\n85\t\tvar seed [32]byte\n86\t\tcopy(seed[:], data)\n87\t\tsrc := rand.NewChaCha8(seed)\n88\t\treturn rand.New(src), nil\n89\t}\n90\t\n91\tfunc randShuffle(rng *rand.Rand, n int, swap func(i, j int)) {\n92\t\tif rng != nil {\n93\t\t\trng.Shuffle(n, swap)\n94\t\t} else {\n95\t\t\trand.Shuffle(n, swap)\n96\t\t}\n97\t}\n98\t\n99\tfunc randIntN(rng *rand.Rand, n int) int {\n100\t\tif rng != nil {\n101\t\t\treturn rng.IntN(n)\n102\t\t}\n103\t\treturn rand.IntN(n)\n104\t}\n105\t\n106\tfunc collectLines(opts options, files []string) ([]string, error) {\n107\t\tif opts.hasRange {\n108\t\t\tlo, hi := opts.inputRange[0], opts.inputRange[1]\n109\t\t\tlines := make([]string, 0, hi-lo+1)\n110\t\t\tfor i := lo; i <= hi; i++ {\n111\t\t\t\tlines = append(lines, strconv.Itoa(i))\n112\t\t\t}\n113\t\t\treturn lines, nil\n114\t\t}\n115\t\tif opts.echo {\n116\t\t\treturn files, nil\n117\t\t}\n118\t\treturn readLines(files, opts.zeroTerm)\n119\t}\n120\t\n121\tfunc openOutput(opts options) (*bufio.Writer, *os.File, error) {\n122\t\tif opts.outputFile == \"\" {\n123\t\t\treturn bufio.NewWriter(os.Stdout), nil, nil\n124\t\t}\n125\t\tf, err := os.Create(opts.outputFile)\n126\t\tif err != nil {\n127\t\t\treturn nil, nil, err\n128\t\t}\n129\t\treturn bufio.NewWriter(f), f, nil\n130\t}\n131\t\n132\tfunc writeLine(w *bufio.Writer, line string, zeroTerm bool) error {\n133\t\tif _, err := w.WriteString(line); err != nil {\n134\t\t\treturn err\n135\t\t}\n136\t\tif zeroTerm {\n137\t\t\treturn w.WriteByte(0)\n138\t\t}\n139\t\treturn w.WriteByte('\\n')\n140\t}\n141\t\n142\tfunc writeOutput(w *bufio.Writer, lines []string, opts options, rng *rand.Rand) error {\n143\t\tif len(lines) == 0 {\n144\t\t\treturn w.Flush()\n145\t\t}\n146\t\n147\t\tif opts.repeat {\n148\t\t\treturn writeRepeat(w, lines, opts, rng)\n149\t\t}\n150\t\n151\t\trandShuffle(rng, len(lines), func(i, j int) {\n152\t\t\tlines[i], lines[j] = lines[j], lines[i]\n153\t\t})\n154\t\n155\t\tn := len(lines)\n156\t\tif opts.hasHead && opts.headCount < n {\n157\t\t\tn = opts.headCount\n158\t\t}\n159\t\n160\t\tfor i := range n {\n161\t\t\tif err := writeLine(w, lines[i], opts.zeroTerm); err != nil {\n162\t\t\t\treturn err\n163\t\t\t}\n164\t\t}\n165\t\treturn w.Flush()\n166\t}\n167\t\n168\tfunc writeRepeat(w *bufio.Writer, lines []string, opts options, rng *rand.Rand) error {\n169\t\tif opts.hasHead {\n170\t\t\tfor range opts.headCount {\n171\t\t\t\tif err := writeLine(w, lines[randIntN(rng, len(lines))], opts.zeroTerm); err != nil {\n172\t\t\t\t\treturn err\n173\t\t\t\t}\n174\t\t\t}\n175\t\t\treturn w.Flush()\n176\t\t}\n177\t\tfor {\n178\t\t\tif err := writeLine(w, lines[randIntN(rng, len(lines))], opts.zeroTerm); err != nil {\n179\t\t\t\treturn err\n180\t\t\t}\n181\t\t\tif err := w.Flush(); err != nil {\n182\t\t\t\treturn err\n183\t\t\t}\n184\t\t}\n185\t}\n186\t\n187\tfunc parseArgs(args []string) (options, []string, error) {\n188\t\tvar opts options\n189\t\tvar files []string\n190\t\n191\t\tfor i := 0; i < len(args); i++ {\n192\t\t\targ := args[i]\n193\t\t\tif arg == \"--\" {\n194\t\t\t\tfiles = append(files, args[i+1:]...)\n195\t\t\t\tbreak\n196\t\t\t}\n197\t\t\tif strings.HasPrefix(arg, \"--\") {\n198\t\t\t\tn, err := parseLongFlag(arg, args[i+1:], &opts)\n199\t\t\t\tif err != nil {\n200\t\t\t\t\treturn opts, nil, err\n201\t\t\t\t}\n202\t\t\t\ti += n\n203\t\t\t\tcontinue\n204\t\t\t}\n205\t\t\tif arg != \"-\" && strings.HasPrefix(arg, \"-\") {\n206\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n207\t\t\t\tif err != nil {\n208\t\t\t\t\treturn opts, nil, err\n209\t\t\t\t}\n210\t\t\t\ti += n\n211\t\t\t\tcontinue\n212\t\t\t}\n213\t\t\tfiles = append(files, arg)\n214\t\t}\n215\t\treturn opts, files, nil\n216\t}\n217\t\n218\tfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n219\t\tswitch {\n220\t\tcase flag == \"--input-range\":\n221\t\t\tif len(rest) == 0 {\n222\t\t\t\treturn 0, fmt.Errorf(\"option '--input-range' requires an argument\")\n223\t\t\t}\n224\t\t\treturn 1, parseRange(rest[0], opts)\n225\t\tcase strings.HasPrefix(flag, \"--input-range=\"):\n226\t\t\treturn 0, parseRange(flag[len(\"--input-range=\"):], opts)\n227\t\tcase flag == \"--head-count\":\n228\t\t\tif len(rest) == 0 {\n229\t\t\t\treturn 0, fmt.Errorf(\"option '--head-count' requires an argument\")\n230\t\t\t}\n231\t\t\treturn 1, parseHeadCount(rest[0], opts)\n232\t\tcase strings.HasPrefix(flag, \"--head-count=\"):\n233\t\t\treturn 0, parseHeadCount(flag[len(\"--head-count=\"):], opts)\n234\t\tcase flag == \"--repeat\":\n235\t\t\topts.repeat = true\n236\t\t\treturn 0, nil\n237\t\tcase flag == \"--output\":\n238\t\t\tif len(rest) == 0 {\n239\t\t\t\treturn 0, fmt.Errorf(\"option '--output' requires an argument\")\n240\t\t\t}\n241\t\t\topts.outputFile = rest[0]\n242\t\t\treturn 1, nil\n243\t\tcase strings.HasPrefix(flag, \"--output=\"):\n244\t\t\topts.outputFile = flag[len(\"--output=\"):]\n245\t\t\treturn 0, nil\n246\t\tcase flag == \"--random-source\":\n247\t\t\tif len(rest) == 0 {\n248\t\t\t\treturn 0, fmt.Errorf(\"option '--random-source' requires an argument\")\n249\t\t\t}\n250\t\t\topts.randomSource = rest[0]\n251\t\t\treturn 1, nil\n252\t\tcase strings.HasPrefix(flag, \"--random-source=\"):\n253\t\t\topts.randomSource = flag[len(\"--random-source=\"):]\n254\t\t\treturn 0, nil\n255\t\tcase flag == \"--zero-terminated\":\n256\t\t\topts.zeroTerm = true\n257\t\t\treturn 0, nil\n258\t\tcase flag == \"--echo\":\n259\t\t\topts.echo = true\n260\t\t\treturn 0, nil\n261\t\tdefault:\n262\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n263\t\t}\n264\t}\n265\t\n266\tfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n267\t\tconsumed := 0\n268\t\tfor j := 0; j < len(flags); j++ {\n269\t\t\tswitch flags[j] {\n270\t\t\tcase 'i':\n271\t\t\t\tval, n, err := shortFlagValue(flags[j+1:], rest, consumed, \"-i\")\n272\t\t\t\tif err != nil {\n273\t\t\t\t\treturn 0, err\n274\t\t\t\t}\n275\t\t\t\tconsumed += n\n276\t\t\t\treturn consumed, parseRange(val, opts)\n277\t\t\tcase 'n':\n278\t\t\t\tval, n, err := shortFlagValue(flags[j+1:], rest, consumed, \"-n\")\n279\t\t\t\tif err != nil {\n280\t\t\t\t\treturn 0, err\n281\t\t\t\t}\n282\t\t\t\tconsumed += n\n283\t\t\t\treturn consumed, parseHeadCount(val, opts)\n284\t\t\tcase 'o':\n285\t\t\t\tval, n, err := shortFlagValue(flags[j+1:], rest, consumed, \"-o\")\n286\t\t\t\tif err != nil {\n287\t\t\t\t\treturn 0, err\n288\t\t\t\t}\n289\t\t\t\tconsumed += n\n290\t\t\t\topts.outputFile = val\n291\t\t\t\treturn consumed, nil\n292\t\t\tcase 'r':\n293\t\t\t\topts.repeat = true\n294\t\t\tcase 'z':\n295\t\t\t\topts.zeroTerm = true\n296\t\t\tcase 'e':\n297\t\t\t\topts.echo = true\n298\t\t\tdefault:\n299\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n300\t\t\t}\n301\t\t}\n302\t\treturn consumed, nil\n303\t}\n304\t\n305\tfunc shortFlagValue(tail string, rest []string, consumed int, name string) (string, int, error) {\n306\t\tif tail != \"\" {\n307\t\t\treturn tail, 0, nil\n308\t\t}\n309\t\tif consumed < len(rest) {\n310\t\t\treturn rest[consumed], 1, nil\n311\t\t}\n312\t\treturn \"\", 0, fmt.Errorf(\"option '%s' requires an argument\", name)\n313\t}\n314\t\n315\tfunc parseRange(s string, opts *options) error {\n316\t\tlo, hi, ok := splitRange(s)\n317\t\tif !ok {\n318\t\t\treturn fmt.Errorf(\"invalid input range: %q\", s)\n319\t\t}\n320\t\tif lo > hi {\n321\t\t\treturn fmt.Errorf(\"invalid input range: %q\", s)\n322\t\t}\n323\t\topts.inputRange = [2]int{lo, hi}\n324\t\topts.hasRange = true\n325\t\treturn nil\n326\t}\n327\t\n328\tfunc splitRange(s string) (int, int, bool) {\n329\t\tidx := strings.Index(s, \"-\")\n330\t\tif idx < 0 {\n331\t\t\treturn 0, 0, false\n332\t\t}\n333\t\tif idx == 0 {\n334\t\t\tidx = strings.Index(s[1:], \"-\")\n335\t\t\tif idx < 0 {\n336\t\t\t\treturn 0, 0, false\n337\t\t\t}\n338\t\t\tidx++\n339\t\t}\n340\t\tlo, err := strconv.Atoi(s[:idx])\n341\t\tif err != nil {\n342\t\t\treturn 0, 0, false\n343\t\t}\n344\t\thi, err := strconv.Atoi(s[idx+1:])\n345\t\tif err != nil {\n346\t\t\treturn 0, 0, false\n347\t\t}\n348\t\treturn lo, hi, true\n349\t}\n350\t\n351\tfunc parseHeadCount(s string, opts *options) error {\n352\t\tn, err := strconv.Atoi(s)\n353\t\tif err != nil || n < 0 {\n354\t\t\treturn fmt.Errorf(\"invalid line count: %q\", s)\n355\t\t}\n356\t\topts.headCount = n\n357\t\topts.hasHead = true\n358\t\treturn nil\n359\t}\n360\t\n361\tfunc readLines(args []string, zeroTerm bool) ([]string, error) {\n362\t\tif len(args) == 0 {\n363\t\t\targs = []string{\"-\"}\n364\t\t}\n365\t\n366\t\tvar lines []string\n367\t\tfor _, name := range args {\n368\t\t\tls, err := readFileLines(name, zeroTerm)\n369\t\t\tif err != nil {\n370\t\t\t\treturn nil, err\n371\t\t\t}\n372\t\t\tlines = append(lines, ls...)\n373\t\t}\n374\t\treturn lines, nil\n375\t}\n376\t\n377\tfunc readFileLines(name string, zeroTerm bool) ([]string, error) {\n378\t\tvar f *os.File\n379\t\tif name == \"-\" {\n380\t\t\tf = os.Stdin\n381\t\t} else {\n382\t\t\tvar err error\n383\t\t\tf, err = os.Open(name)\n384\t\t\tif err != nil {\n385\t\t\t\treturn nil, err\n386\t\t\t}\n387\t\t\tdefer f.Close()\n388\t\t}\n389\t\n390\t\tdata, err := io.ReadAll(f)\n391\t\tif err != nil {\n392\t\t\treturn nil, err\n393\t\t}\n394\t\n395\t\tif len(data) == 0 {\n396\t\t\treturn nil, nil\n397\t\t}\n398\t\n399\t\tvar delim byte = '\\n'\n400\t\tif zeroTerm {\n401\t\t\tdelim = 0\n402\t\t}\n403\t\n404\t\t// Remove trailing delimiter if present\n405\t\tdata = bytes.TrimSuffix(data, []byte{delim})\n406\t\tif len(data) == 0 {\n407\t\t\treturn []string{\"\"}, nil\n408\t\t}\n409\t\n410\t\tparts := bytes.Split(data, []byte{delim})\n411\t\tlines := make([]string, len(parts))\n412\t\tfor i, p := range parts {\n413\t\t\tlines[i] = string(p)\n414\t\t}\n415\t\treturn lines, nil\n416\t}\n417\t\n418\t"}]},"parent_tool_use_id":null,"session_id":"78073c1a-ebc5-4b9f-bc7d-14f2b828e657","uuid":"6b8511f3-e065-439e-8a5e-090404f087eb","timestamp":"2026-05-21T18:33:45.548Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5435/cmd/shuf/main.go","content":"package main\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"math/rand/v2\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype options struct {\n\tinputRange   [2]int\n\thasRange     bool\n\theadCount    int\n\thasHead      bool\n\trepeat       bool\n\toutputFile   string\n\trandomSource string\n\tzeroTerm     bool\n\techo         bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"shuf: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tif opts.hasRange && (opts.echo || len(files) > 0) {\n\t\tif opts.echo {\n\t\t\tfmt.Fprintf(os.Stderr, \"shuf: cannot combine -e and -i options\\n\")\n\t\t} else {\n\t\t\tfmt.Fprintf(os.Stderr, \"shuf: extra operand %q\\n\", files[0])\n\t\t}\n\t\tos.Exit(1)\n\t}\n\n\trng, err := makeRNG(opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"shuf: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tlines, err := collectLines(opts, files)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"shuf: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tw, closer, err := openOutput(opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"shuf: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tif err := writeOutput(w, lines, opts, rng); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"shuf: write error: %v\\n\", err)\n\t\tos.Exit(1)\n\t}\n\n\tif closer != nil {\n\t\tif err := closer.Close(); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"shuf: write error: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n}\n\nfunc makeRNG(opts options) (*rand.Rand, error) {\n\tif opts.randomSource == \"\" {\n\t\treturn nil, nil\n\t}\n\tdata, err := os.ReadFile(opts.randomSource)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tvar seed [32]byte\n\tcopy(seed[:], data)\n\tsrc := rand.NewChaCha8(seed)\n\treturn rand.New(src), nil\n}\n\nfunc randShuffle(rng *rand.Rand, n int, swap func(i, j int)) {\n\tif rng != nil {\n\t\trng.Shuffle(n, swap)\n\t} else {\n\t\trand.Shuffle(n, swap)\n\t}\n}\n\nfunc randIntN(rng *rand.Rand, n int) int {\n\tif rng != nil {\n\t\treturn rng.IntN(n)\n\t}\n\treturn rand.IntN(n)\n}\n\nfunc collectLines(opts options, files []string) ([]string, error) {\n\tif opts.hasRange {\n\t\tlo, hi := opts.inputRange[0], opts.inputRange[1]\n\t\tlines := make([]string, 0, hi-lo+1)\n\t\tfor i := lo; i <= hi; i++ {\n\t\t\tlines = append(lines, strconv.Itoa(i))\n\t\t}\n\t\treturn lines, nil\n\t}\n\tif opts.echo {\n\t\treturn files, nil\n\t}\n\treturn readLines(files, opts.zeroTerm)\n}\n\nfunc openOutput(opts options) (*bufio.Writer, *os.File, error) {\n\tif opts.outputFile == \"\" {\n\t\treturn bufio.NewWriter(os.Stdout), nil, nil\n\t}\n\tf, err := os.Create(opts.outputFile)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn bufio.NewWriter(f), f, nil\n}\n\nfunc writeLine(w *bufio.Writer, line string, zeroTerm bool) error {\n\tif _, err := w.WriteString(line); err != nil {\n\t\treturn err\n\t}\n\tif zeroTerm {\n\t\treturn w.WriteByte(0)\n\t}\n\treturn w.WriteByte('\\n')\n}\n\nfunc writeOutput(w *bufio.Writer, lines []string, opts options, rng *rand.Rand) error {\n\tif len(lines) == 0 {\n\t\treturn w.Flush()\n\t}\n\n\tif opts.repeat {\n\t\treturn writeRepeat(w, lines, opts, rng)\n\t}\n\n\trandShuffle(rng, len(lines), func(i, j int) {\n\t\tlines[i], lines[j] = lines[j], lines[i]\n\t})\n\n\tn := len(lines)\n\tif opts.hasHead && opts.headCount < n {\n\t\tn = opts.headCount\n\t}\n\n\tfor i := range n {\n\t\tif err := writeLine(w, lines[i], opts.zeroTerm); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn w.Flush()\n}\n\nfunc writeRepeat(w *bufio.Writer, lines []string, opts options, rng *rand.Rand) error {\n\tif opts.hasHead {\n\t\tfor range opts.headCount {\n\t\t\tif err := writeLine(w, lines[randIntN(rng, len(lines))], opts.zeroTerm); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\treturn w.Flush()\n\t}\n\tfor {\n\t\tif err := writeLine(w, lines[randIntN(rng, len(lines))], opts.zeroTerm); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif err := w.Flush(); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar files []string\n\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif arg != \"-\" && strings.HasPrefix(arg, \"-\") {\n\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tfiles = append(files, arg)\n\t}\n\treturn opts, files, nil\n}\n\nfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--input-range\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '--input-range' requires an argument\")\n\t\t}\n\t\treturn 1, parseRange(rest[0], opts)\n\tcase strings.HasPrefix(flag, \"--input-range=\"):\n\t\treturn 0, parseRange(flag[len(\"--input-range=\"):], opts)\n\tcase flag == \"--head-count\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '--head-count' requires an argument\")\n\t\t}\n\t\treturn 1, parseHeadCount(rest[0], opts)\n\tcase strings.HasPrefix(flag, \"--head-count=\"):\n\t\treturn 0, parseHeadCount(flag[len(\"--head-count=\"):], opts)\n\tcase flag == \"--repeat\":\n\t\topts.repeat = true\n\t\treturn 0, nil\n\tcase flag == \"--output\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '--output' requires an argument\")\n\t\t}\n\t\topts.outputFile = rest[0]\n\t\treturn 1, nil\n\tcase strings.HasPrefix(flag, \"--output=\"):\n\t\topts.outputFile = flag[len(\"--output=\"):]\n\t\treturn 0, nil\n\tcase flag == \"--random-source\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '--random-source' requires an argument\")\n\t\t}\n\t\topts.randomSource = rest[0]\n\t\treturn 1, nil\n\tcase strings.HasPrefix(flag, \"--random-source=\"):\n\t\topts.randomSource = flag[len(\"--random-source=\"):]\n\t\treturn 0, nil\n\tcase flag == \"--zero-terminated\":\n\t\topts.zeroTerm = true\n\t\treturn 0, nil\n\tcase flag == \"--echo\":\n\t\topts.echo = true\n\t\treturn 0, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 'i':\n\t\t\tval, n, err := shortFlagValue(flags[j+1:], rest, consumed, \"-i\")\n\t\t\tif err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t\tconsumed += n\n\t\t\treturn consumed, parseRange(val, opts)\n\t\tcase 'n':\n\t\t\tval, n, err := shortFlagValue(flags[j+1:], rest, consumed, \"-n\")\n\t\t\tif err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t\tconsumed += n\n\t\t\treturn consumed, parseHeadCount(val, opts)\n\t\tcase 'o':\n\t\t\tval, n, err := shortFlagValue(flags[j+1:], rest, consumed, \"-o\")\n\t\t\tif err != nil {\n\t\t\t\treturn 0, err\n\t\t\t}\n\t\t\tconsumed += n\n\t\t\topts.outputFile = val\n\t\t\treturn consumed, nil\n\t\tcase 'r':\n\t\t\topts.repeat = true\n\t\tcase 'z':\n\t\t\topts.zeroTerm = true\n\t\tcase 'e':\n\t\t\topts.echo = true\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn consumed, nil\n}\n\nfunc shortFlagValue(tail string, rest []string, consumed int, name string) (string, int, error) {\n\tif tail != \"\" {\n\t\treturn tail, 0, nil\n\t}\n\tif consumed < len(rest) {\n\t\treturn rest[consumed], 1, nil\n\t}\n\treturn \"\", 0, fmt.Errorf(\"option '%s' requires an argument\", name)\n}\n\nfunc parseRange(s string, opts *options) error {\n\tlo, hi, ok := splitRange(s)\n\tif !ok {\n\t\treturn fmt.Errorf(\"invalid input range: %q\", s)\n\t}\n\tif lo > hi {\n\t\treturn fmt.Errorf(\"invalid input range: %q\", s)\n\t}\n\topts.inputRange = [2]int{lo, hi}\n\topts.hasRange = true\n\treturn nil\n}\n\nfunc splitRange(s string) (int, int, bool) {\n\tidx := strings.Index(s, \"-\")\n\tif idx < 0 {\n\t\treturn 0, 0, false\n\t}\n\tif idx == 0 {\n\t\tidx = strings.Index(s[1:], \"-\")\n\t\tif idx < 0 {\n\t\t\treturn 0, 0, false\n\t\t}\n\t\tidx++\n\t}\n\tlo, err := strconv.Atoi(s[:idx])\n\tif err != nil {\n\t\treturn 0, 0, false\n\t}\n\thi, err := strconv.Atoi(s[idx+1:])\n\tif err != nil {\n\t\treturn 0, 0, false\n\t}\n\treturn lo, hi, true\n}\n\nfunc parseHeadCount(s string, opts *options) error {\n\tn, err := strconv.Atoi(s)\n\tif err != nil || n < 0 {\n\t\treturn fmt.Errorf(\"invalid line count: %q\", s)\n\t}\n\topts.headCount = n\n\topts.hasHead = true\n\treturn nil\n}\n\nfunc readLines(args []string, zeroTerm bool) ([]string, error) {\n\tif len(args) == 0 {\n\t\targs = []string{\"-\"}\n\t}\n\n\tvar lines []string\n\tfor _, name := range args {\n\t\tls, err := readFileLines(name, zeroTerm)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tlines = append(lines, ls...)\n\t}\n\treturn lines, nil\n}\n\nfunc readFileLines(name string, zeroTerm bool) ([]string, error) {\n\tvar f *os.File\n\tif name == \"-\" {\n\t\tf = os.Stdin\n\t} else {\n\t\tvar err error\n\t\tf, err = os.Open(name)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tdefer f.Close()\n\t}\n\n\tdata, err := io.ReadAll(f)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tif len(data) == 0 {\n\t\treturn nil, nil\n\t}\n\n\tvar delim byte = '\\n'\n\tif zeroTerm {\n\t\tdelim = 0\n\t}\n\n\t// Remove trailing delimiter if present\n\tdata = bytes.TrimSuffix(data, []byte{delim})\n\tif len(data) == 0 {\n\t\treturn []string{\"\"}, nil\n\t}\n\n\tparts := bytes.Split(data, []byte{delim})\n\tlines := make([]string, len(parts))\n\tfor i, p := range parts {\n\t\tlines[i] = string(p)\n\t}\n\treturn lines, nil\n}\n\n","numLines":418,"startLine":1,"totalLines":418}}}
