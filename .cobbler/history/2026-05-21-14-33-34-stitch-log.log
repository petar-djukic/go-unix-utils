\t\t}\n69\t\n70\t\tdir := t.TempDir()\n71\t\tf := filepath.Join(dir, \"input.txt\")\n72\t\tif err := os.WriteFile(f, []byte(\"one\\ntwo\\nthree\\n\"), 0o644); err != nil {\n73\t\t\tt.Fatal(err)\n74\t\t}\n75\t\n76\t\ttests := []testutils.DiffTest{\n77\t\t\t{\n78\t\t\t\tName:      \"file_argument\",\n79\t\t\t\tArgs:      []string{f},\n80\t\t\t\tExitCode:  0,\n81\t\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n82\t\t\t},\n83\t\t}\n84\t\n85\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n86\t}\n87\t\n88\t// R1.1: multiple file arguments concatenate lines then shuffle\n89\tfunc TestMultipleFiles(t *testing.T) {\n90\t\tbin := testutils.BuildBinary(t, \".\")\n91\t\n92\t\tdir := t.TempDir()\n93\t\tf1 := filepath.Join(dir, \"a.txt\")\n94\t\tf2 := filepath.Join(dir, \"b.txt\")\n95\t\tif err := os.WriteFile(f1, []byte(\"a\\nb\\n\"), 0o644); err != nil {\n96\t\t\tt.Fatal(err)\n97\t\t}\n98\t\tif err := os.WriteFile(f2, []byte(\"c\\nd\\n\"), 0o644); err != nil {\n99\t\t\tt.Fatal(err)\n100\t\t}\n101\t\n102\t\tcmd := exec.Command(bin, f1, f2)\n103\t\tout, err := cmd.Output()\n104\t\tif err != nil {\n105\t\t\tt.Fatalf(\"shuf failed: %v\", err)\n106\t\t}\n107\t\n108\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n109\t\twant := []string{\"a\", \"b\", \"c\", \"d\"}\n110\t\n111\t\tif len(got) != len(want) {\n112\t\t\tt.Fatalf(\"expected %d lines, got %d\", len(want), len(got))\n113\t\t}\n114\t\n115\t\tsorted := slices.Clone(got)\n116\t\tsort.Strings(sorted)\n117\t\tif !slices.Equal(sorted, want) {\n118\t\t\tt.Errorf(\"output is not a permutation of combined input: got %v\", got)\n119\t\t}\n120\t}\n121\t\n122\tfunc TestDiffStdinDash(t *testing.T) {\n123\t\tgoBin := testutils.BuildBinary(t, \".\")\n124\t\trefBin, err := exec.LookPath(\"gshuf\")\n125\t\tif err != nil {\n126\t\t\tt.Skip(\"reference binary not found\")\n127\t\t}\n128\t\n129\t\ttests := []testutils.DiffTest{\n130\t\t\t{\n131\t\t\t\tName:      \"stdin_via_dash\",\n132\t\t\t\tArgs:      []string{\"-\"},\n133\t\t\t\tStdin:     []byte(\"p\\nq\\nr\\n\"),\n134\t\t\t\tExitCode:  0,\n135\t\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n136\t\t\t},\n137\t\t}\n138\t\n139\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n140\t}\n141\t\n142\t// R1.3: structural verification that output is a permutation\n143\tfunc TestPermutation(t *testing.T) {\n144\t\tbin := testutils.BuildBinary(t, \".\")\n145\t\n146\t\tinput := \"line1\\nline2\\nline3\\nline4\\nline5\\n\"\n147\t\tcmd := exec.Command(bin)\n148\t\tcmd.Stdin = strings.NewReader(input)\n149\t\tout, err := cmd.Output()\n150\t\tif err != nil {\n151\t\t\tt.Fatalf(\"shuf failed: %v\", err)\n152\t\t}\n153\t\n154\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n155\t\twant := []string{\"line1\", \"line2\", \"line3\", \"line4\", \"line5\"}\n156\t\n157\t\tif len(got) != len(want) {\n158\t\t\tt.Fatalf(\"expected %d lines, got %d\", len(want), len(got))\n159\t\t}\n160\t\n161\t\tsorted := slices.Clone(got)\n162\t\tsort.Strings(sorted)\n163\t\tif !slices.Equal(sorted, want) {\n164\t\t\tt.Errorf(\"output is not a permutation of input: got %v\", got)\n165\t\t}\n166\t}\n167\t\n168\t// R1.4: last line without trailing newline is included\n169\tfunc TestNoTrailingNewline(t *testing.T) {\n170\t\tbin := testutils.BuildBinary(t, \".\")\n171\t\n172\t\tinput := \"a\\nb\\nc\"\n173\t\tcmd := exec.Command(bin)\n174\t\tcmd.Stdin = strings.NewReader(input)\n175\t\tout, err := cmd.Output()\n176\t\tif err != nil {\n177\t\t\tt.Fatalf(\"shuf failed: %v\", err)\n178\t\t}\n179\t\n180\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n181\t\twant := []string{\"a\", \"b\", \"c\"}\n182\t\n183\t\tif len(got) != len(want) {\n184\t\t\tt.Fatalf(\"expected %d lines, got %d: %v\", len(want), len(got), got)\n185\t\t}\n186\t\n187\t\tsorted := slices.Clone(got)\n188\t\tsort.Strings(sorted)\n189\t\tif !slices.Equal(sorted, want) {\n190\t\t\tt.Errorf(\"output is not a permutation of input: got %v\", got)\n191\t\t}\n192\t}\n193\t\n194\t// R2.1: -i LO-HI generates and shuffles integers from LO to HI inclusive\n195\tfunc TestRangeMode(t *testing.T) {\n196\t\tbin := testutils.BuildBinary(t, \".\")\n197\t\n198\t\tcmd := exec.Command(bin, \"-i\", \"1-10\")\n199\t\tout, err := cmd.Output()\n200\t\tif err != nil {\n201\t\t\tt.Fatalf(\"shuf -i 1-10 failed: %v\", err)\n202\t\t}\n203\t\n204\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n205\t\tif len(got) != 10 {\n206\t\t\tt.Fatalf(\"expected 10 lines, got %d\", len(got))\n207\t\t}\n208\t\n209\t\tseen := make(map[int]bool)\n210\t\tfor _, line := range got {\n211\t\t\tv, err := strconv.Atoi(line)\n212\t\t\tif err != nil {\n213\t\t\t\tt.Fatalf(\"non-integer in output: %q\", line)\n214\t\t\t}\n215\t\t\tif v < 1 || v > 10 {\n216\t\t\t\tt.Errorf(\"value %d out of range [1,10]\", v)\n217\t\t\t}\n218\t\t\tif seen[v] {\n219\t\t\t\tt.Errorf(\"duplicate value %d without -r\", v)\n220\t\t\t}\n221\t\t\tseen[v] = true\n222\t\t}\n223\t}\n224\t\n225\t// R2.1: --input-range=LO-HI long form\n226\tfunc TestRangeModeLong(t *testing.T) {\n227\t\tbin := testutils.BuildBinary(t, \".\")\n228\t\n229\t\tcmd := exec.Command(bin, \"--input-range=3-7\")\n230\t\tout, err := cmd.Output()\n231\t\tif err != nil {\n232\t\t\tt.Fatalf(\"shuf --input-range=3-7 failed: %v\", err)\n233\t\t}\n234\t\n235\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n236\t\tif len(got) != 5 {\n237\t\t\tt.Fatalf(\"expected 5 lines, got %d\", len(got))\n238\t\t}\n239\t\n240\t\tsorted := slices.Clone(got)\n241\t\tsort.Strings(sorted)\n242\t\twant := []string{\"3\", \"4\", \"5\", \"6\", \"7\"}\n243\t\tsort.Strings(want)\n244\t\tif !slices.Equal(sorted, want) {\n245\t\t\tt.Errorf(\"output is not a permutation of 3..7: got %v\", got)\n246\t\t}\n247\t}\n248\t\n249\t// R2.1: -i must not be combined with file arguments\n250\tfunc TestRangeWithFileError(t *testing.T) {\n251\t\tbin := testutils.BuildBinary(t, \".\")\n252\t\n253\t\tcmd := exec.Command(bin, \"-i\", \"1-5\", \"somefile\")\n254\t\tout, err := cmd.CombinedOutput()\n255\t\tif err == nil {\n256\t\t\tt.Fatal(\"expected error when combining -i with file args\")\n257\t\t}\n258\t\tif !strings.Contains(string(out), \"extra operand\") {\n259\t\t\tt.Errorf(\"expected 'extra operand' error, got: %s\", out)\n260\t\t}\n261\t}\n262\t\n263\t// R2.2: -n COUNT limits output to at most COUNT lines\n264\tfunc TestHeadCount(t *testing.T) {\n265\t\tbin := testutils.BuildBinary(t, \".\")\n266\t\n267\t\tinput := \"a\\nb\\nc\\nd\\ne\\nf\\ng\\nh\\ni\\nj\\n\"\n268\t\tcmd := exec.Command(bin, \"-n\", \"3\")\n269\t\tcmd.Stdin = strings.NewReader(input)\n270\t\tout, err := cmd.Output()\n271\t\tif err != nil {\n272\t\t\tt.Fatalf(\"shuf -n 3 failed: %v\", err)\n273\t\t}\n274\t\n275\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n276\t\tif len(got) != 3 {\n277\t\t\tt.Fatalf(\"expected 3 lines, got %d\", len(got))\n278\t\t}\n279\t\n280\t\tvalid := map[string]bool{\n281\t\t\t\"a\": true, \"b\": true, \"c\": true, \"d\": true, \"e\": true,\n282\t\t\t\"f\": true, \"g\": true, \"h\": true, \"i\": true, \"j\": true,\n283\t\t}\n284\t\tfor _, line := range got {\n285\t\t\tif !valid[line] {\n286\t\t\t\tt.Errorf(\"unexpected output line: %q\", line)\n287\t\t\t}\n288\t\t}\n289\t}\n290\t\n291\t// R2.2: -n COUNT with range mode\n292\tfunc TestHeadCountRange(t *testing.T) {\n293\t\tbin := testutils.BuildBinary(t, \".\")\n294\t\n295\t\tcmd := exec.Command(bin, \"-i\", \"1-100\", \"-n\", \"5\")\n296\t\tout, err := cmd.Output()\n297\t\tif err != nil {\n298\t\t\tt.Fatalf(\"shuf -i 1-100 -n 5 failed: %v\", err)\n299\t\t}\n300\t\n301\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n302\t\tif len(got) != 5 {\n303\t\t\tt.Fatalf(\"expected 5 lines, got %d\", len(got))\n304\t\t}\n305\t\n306\t\tseen := make(map[int]bool)\n307\t\tfor _, line := range got {\n308\t\t\tv, err := strconv.Atoi(line)\n309\t\t\tif err != nil {\n310\t\t\t\tt.Fatalf(\"non-integer: %q\", line)\n311\t\t\t}\n312\t\t\tif v < 1 || v > 100 {\n313\t\t\t\tt.Errorf(\"value %d out of range [1,100]\", v)\n314\t\t\t}\n315\t\t\tif seen[v] {\n316\t\t\t\tt.Errorf(\"duplicate value %d without -r\", v)\n317\t\t\t}\n318\t\t\tseen[v] = true\n319\t\t}\n320\t}\n321\t\n322\t// R2.2: -n larger than input produces all lines\n323\tfunc TestHeadCountLargerThanInput(t *testing.T) {\n324\t\tbin := testutils.BuildBinary(t, \".\")\n325\t\n326\t\tinput := \"x\\ny\\n\"\n327\t\tcmd := exec.Command(bin, \"-n\", \"100\")\n328\t\tcmd.Stdin = strings.NewReader(input)\n329\t\tout, err := cmd.Output()\n330\t\tif err != nil {\n331\t\t\tt.Fatalf(\"shuf -n 100 failed: %v\", err)\n332\t\t}\n333\t\n334\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n335\t\tif len(got) != 2 {\n336\t\t\tt.Fatalf(\"expected 2 lines (all input), got %d\", len(got))\n337\t\t}\n338\t}\n339\t\n340\t// R2.3: -r with -n produces exactly n lines with possible duplicates\n341\tfunc TestRepeatWithHead(t *testing.T) {\n342\t\tbin := testutils.BuildBinary(t, \".\")\n343\t\n344\t\tcmd := exec.Command(bin, \"-i\", \"1-3\", \"-r\", \"-n\", \"20\")\n345\t\tout, err := cmd.Output()\n346\t\tif err != nil {\n347\t\t\tt.Fatalf(\"shuf -i 1-3 -r -n 20 failed: %v\", err)\n348\t\t}\n349\t\n350\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n351\t\tif len(got) != 20 {\n352\t\t\tt.Fatalf(\"expected 20 lines, got %d\", len(got))\n353\t\t}\n354\t\n355\t\tfor _, line := range got {\n356\t\t\tv, err := strconv.Atoi(line)\n357\t\t\tif err != nil {\n358\t\t\t\tt.Fatalf(\"non-integer: %q\", line)\n359\t\t\t}\n360\t\t\tif v < 1 || v > 3 {\n361\t\t\t\tt.Errorf(\"value %d out of range [1,3]\", v)\n362\t\t\t}\n363\t\t}\n364\t}\n365\t\n366\t// R2.3: -r with stdin input\n367\tfunc TestRepeatStdin(t *testing.T) {\n368\t\tbin := testutils.BuildBinary(t, \".\")\n369\t\n370\t\tcmd := exec.Command(bin, \"-r\", \"-n\", \"15\")\n371\t\tcmd.Stdin = strings.NewReader(\"alpha\\nbeta\\n\")\n372\t\tout, err := cmd.Output()\n373\t\tif err != nil {\n374\t\t\tt.Fatalf(\"shuf -r -n 15 failed: %v\", err)\n375\t\t}\n376\t\n377\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n378\t\tif len(got) != 15 {\n379\t\t\tt.Fatalf(\"expected 15 lines, got %d\", len(got))\n380\t\t}\n381\t\n382\t\tvalid := map[string]bool{\"alpha\": true, \"beta\": true}\n383\t\tfor _, line := range got {\n384\t\t\tif !valid[line] {\n385\t\t\t\tt.Errorf(\"unexpected output: %q\", line)\n386\t\t\t}\n387\t\t}\n388\t}\n389\t\n390\t// R2.4: -o FILE writes output to file instead of stdout\n391\tfunc TestOutputFile(t *testing.T) {\n392\t\tbin := testutils.BuildBinary(t, \".\")\n393\t\n394\t\tdir := t.TempDir()\n395\t\toutFile := filepath.Join(dir, \"out.txt\")\n396\t\n397\t\tcmd := exec.Command(bin, \"-i\", \"1-5\", \"-o\", outFile)\n398\t\tif err := cmd.Run(); err != nil {\n399\t\t\tt.Fatalf(\"shuf -o failed: %v\", err)\n400\t\t}\n401\t\n402\t\tdata, err := os.ReadFile(outFile)\n403\t\tif err != nil {\n404\t\t\tt.Fatalf(\"reading output file: %v\", err)\n405\t\t}\n406\t\n407\t\tgot := strings.Split(strings.TrimSuffix(string(data), \"\\n\"), \"\\n\")\n408\t\tif len(got) != 5 {\n409\t\t\tt.Fatalf(\"expected 5 lines, got %d\", len(got))\n410\t\t}\n411\t\n412\t\tsorted := slices.Clone(got)\n413\t\tsort.Strings(sorted)\n414\t\twant := []string{\"1\", \"2\", \"3\", \"4\", \"5\"}\n415\t\tsort.Strings(want)\n416\t\tif !slices.Equal(sorted, want) {\n417\t\t\tt.Errorf(\"output is not a permutation of 1..5: got %v\", got)\n418\t\t}\n419\t}\n420\t\n421\t// R2.4: --output=FILE long form\n422\tfunc TestOutputFileLong(t *testing.T) {\n423\t\tbin := testutils.BuildBinary(t, \".\")\n424\t\n425\t\tdir := t.TempDir()\n426\t\toutFile := filepath.Join(dir, \"out.txt\")\n427\t\n428\t\tinput := \"foo\\nbar\\nbaz\\n\"\n429\t\tcmd := exec.Command(bin, \"--output=\"+outFile)\n430\t\tcmd.Stdin = strings.NewReader(input)\n431\t\tif err := cmd.Run(); err != nil {\n432\t\t\tt.Fatalf(\"shuf --output failed: %v\", err)\n433\t\t}\n434\t\n435\t\tdata, err := os.ReadFile(outFile)\n436\t\tif err != nil {\n437\t\t\tt.Fatalf(\"reading output file: %v\", err)\n438\t\t}\n439\t\n440\t\tgot := strings.Split(strings.TrimSuffix(string(data), \"\\n\"), \"\\n\")\n441\t\tif len(got) != 3 {\n442\t\t\tt.Fatalf(\"expected 3 lines, got %d\", len(got))\n443\t\t}\n444\t\n445\t\tsorted := slices.Clone(got)\n446\t\tsort.Strings(sorted)\n447\t\twant := []string{\"bar\", \"baz\", \"foo\"}\n448\t\tif !slices.Equal(sorted, want) {\n449\t\t\tt.Errorf(\"output is not a permutation of input: got %v\", got)\n450\t\t}\n451\t}\n452\t\n453\t// R2.1: invalid range format\n454\tfunc TestInvalidRange(t *testing.T) {\n455\t\tbin := testutils.BuildBinary(t, \".\")\n456\t\n457\t\tcmd := exec.Command(bin, \"-i\", \"abc\")\n458\t\tout, err := cmd.CombinedOutput()\n459\t\tif err == nil {\n460\t\t\tt.Fatal(\"expected error for invalid range\")\n461\t\t}\n462\t\tif !strings.Contains(string(out), \"invalid input range\") {\n463\t\t\tt.Errorf(\"expected 'invalid input range' error, got: %s\", out)\n464\t\t}\n465\t}\n466\t\n467\t// R2.1: reversed range (LO > HI)\n468\tfunc TestReversedRange(t *testing.T) {\n469\t\tbin := testutils.BuildBinary(t, \".\")\n470\t\n471\t\tcmd := exec.Command(bin, \"-i\", \"10-5\")\n472\t\tout, err := cmd.CombinedOutput()\n473\t\tif err == nil {\n474\t\t\tt.Fatal(\"expected error for reversed range\")\n475\t\t}\n476\t\tif !strings.Contains(string(out), \"invalid input range\") {\n477\t\t\tt.Errorf(\"expected 'invalid input range' error, got: %s\", out)\n478\t\t}\n479\t}\n480\t\n481\t// R2.2: -n 0 produces no output\n482\tfunc TestHeadCountZero(t *testing.T) {\n483\t\tbin := testutils.BuildBinary(t, \".\")\n484\t\n485\t\tcmd := exec.Command(bin, \"-i\", \"1-10\", \"-n\", \"0\")\n486\t\tout, err := cmd.Output()\n487\t\tif err != nil {\n488\t\t\tt.Fatalf(\"shuf -n 0 failed: %v\", err)\n489\t\t}\n490\t\tif len(out) != 0 {\n491\t\t\tt.Errorf(\"expected empty output, got: %q\", out)\n492\t\t}\n493\t}\n494\t\n495\t// R2.1: differential test for range mode (structural)\n496\tfunc TestDiffRange(t *testing.T) {\n497\t\tgoBin := testutils.BuildBinary(t, \".\")\n498\t\trefBin, err := exec.LookPath(\"gshuf\")\n499\t\tif err != nil {\n500\t\t\tt.Skip(\"reference binary not found\")\n501\t\t}\n502\t\n503\t\ttests := []testutils.DiffTest{\n504\t\t\t{\n505\t\t\t\tName:      \"range_1_5\",\n506\t\t\t\tArgs:      []string{\"-i\", \"1-5\"},\n507\t\t\t\tExitCode:  0,\n508\t\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n509\t\t\t},\n510\t\t\t{\n511\t\t\t\tName:      \"range_with_head\",\n512\t\t\t\tArgs:      []string{\"-i\", \"1-100\", \"-n\", \"3\"},\n513\t\t\t\tExitCode:  0,\n514\t\t\t\tNormalize: []testutils.NormalizeFunc{lineCount},\n515\t\t\t},\n516\t\t}\n517\t\n518\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n519\t}\n520\t\n521\tfunc lineCount(b []byte) []byte {\n522\t\ts := strings.TrimSuffix(string(b), \"\\n\")\n523\t\tif s == \"\" {\n524\t\t\treturn []byte(\"0\\n\")\n525\t\t}\n526\t\tn := len(strings.Split(s, \"\\n\"))\n527\t\treturn []byte(strconv.Itoa(n) + \"\\n\")\n528\t}\n529\t\n530\t// R3.1: --random-source=FILE reads random bytes from file\n531\tfunc TestRandomSource(t *testing.T) {\n532\t\tbin := testutils.BuildBinary(t, \".\")\n533\t\n534\t\tdir := t.TempDir()\n535\t\trsFile := filepath.Join(dir, \"rand.bin\")\n536\t\tseed := make([]byte, 64)\n537\t\tfor i := range seed {\n538\t\t\tseed[i] = byte(i * 7)\n539\t\t}\n540\t\tif err := os.WriteFile(rsFile, seed, 0o644); err != nil {\n541\t\t\tt.Fatal(err)\n542\t\t}\n543\t\n544\t\tcmd := exec.Command(bin, \"--random-source=\"+rsFile, \"-i\", \"1-10\")\n545\t\tout, err := cmd.Output()\n546\t\tif err != nil {\n547\t\t\tt.Fatalf(\"shuf --random-source failed: %v\", err)\n548\t\t}\n549\t\n550\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n551\t\tif len(got) != 10 {\n552\t\t\tt.Fatalf(\"expected 10 lines, got %d\", len(got))\n553\t\t}\n554\t\n555\t\tseen := make(map[int]bool)\n556\t\tfor _, line := range got {\n557\t\t\tv, err := strconv.Atoi(line)\n558\t\t\tif err != nil {\n559\t\t\t\tt.Fatalf(\"non-integer: %q\", line)\n560\t\t\t}\n561\t\t\tif v < 1 || v > 10 {\n562\t\t\t\tt.Errorf(\"value %d out of range\", v)\n563\t\t\t}\n564\t\t\tif seen[v] {\n565\t\t\t\tt.Errorf(\"duplicate: %d\", v)\n566\t\t\t}\n567\t\t\tseen[v] = true\n568\t\t}\n569\t\n570\t\tcmd2 := exec.Command(bin, \"--random-source=\"+rsFile, \"-i\", \"1-10\")\n571\t\tout2, err := cmd2.Output()\n572\t\tif err != nil {\n573\t\t\tt.Fatalf(\"second run failed: %v\", err)\n574\t\t}\n575\t\tif string(out) != string(out2) {\n576\t\t\tt.Errorf(\"same random source should produce same output\")\n577\t\t}\n578\t}\n579\t\n580\t// R3.1: --random-source with missing file\n581\tfunc TestRandomSourceMissing(t *testing.T) {\n582\t\tbin := testutils.BuildBinary(t, \".\")\n583\t\n584\t\tcmd := exec.Command(bin, \"--random-source=/nonexistent\", \"-i\", \"1-5\")\n585\t\terr := cmd.Run()\n586\t\tif err == nil {\n587\t\t\tt.Fatal(\"expected error for missing random source file\")\n588\t\t}\n589\t}\n590\t\n591\t// R3.2: -z uses NUL as delimiter for both input and output\n592\tfunc TestZeroTerminated(t *testing.T) {\n593\t\tbin := testutils.BuildBinary(t, \".\")\n594\t\n595\t\tinput := \"alpha\\x00beta\\x00gamma\\x00\"\n596\t\tcmd := exec.Command(bin, \"-z\")\n597\t\tcmd.Stdin = strings.NewReader(input)\n598\t\tout, err := cmd.Output()\n599\t\tif err != nil {\n600\t\t\tt.Fatalf(\"shuf -z failed: %v\", err)\n601\t\t}\n602\t\n603\t\traw := string(out)\n604\t\traw = strings.TrimSuffix(raw, \"\\x00\")\n605\t\tgot := strings.Split(raw, \"\\x00\")\n606\t\tif len(got) != 3 {\n607\t\t\tt.Fatalf(\"expected 3 NUL-separated entries, got %d: %q\", len(got), out)\n608\t\t}\n609\t\n610\t\tsorted := slices.Clone(got)\n611\t\tsort.Strings(sorted)\n612\t\twant := []string{\"alpha\", \"beta\", \"gamma\"}\n613\t\tif !slices.Equal(sorted, want) {\n614\t\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n615\t\t}\n616\t}\n617\t\n618\t// R3.2: --zero-terminated long form\n619\tfunc TestZeroTerminatedLong(t *testing.T) {\n620\t\tbin := testutils.BuildBinary(t, \".\")\n621\t\n622\t\tinput := \"x\\x00y\\x00z\\x00\"\n623\t\tcmd := exec.Command(bin, \"--zero-terminated\")\n624\t\tcmd.Stdin = strings.NewReader(input)\n625\t\tout, err := cmd.Output()\n626\t\tif err != nil {\n627\t\t\tt.Fatalf(\"shuf --zero-terminated failed: %v\", err)\n628\t\t}\n629\t\n630\t\traw := strings.TrimSuffix(string(out), \"\\x00\")\n631\t\tgot := strings.Split(raw, \"\\x00\")\n632\t\tif len(got) != 3 {\n633\t\t\tt.Fatalf(\"expected 3 entries, got %d\", len(got))\n634\t\t}\n635\t\n636\t\tsorted := slices.Clone(got)\n637\t\tsort.Strings(sorted)\n638\t\twant := []string{\"x\", \"y\", \"z\"}\n639\t\tif !slices.Equal(sorted, want) {\n640\t\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n641\t\t}\n642\t}\n643\t\n644\t// R3.2: -z with range mode\n645\tfunc TestZeroTerminatedRange(t *testing.T) {\n646\t\tbin := testutils.BuildBinary(t, \".\")\n647\t\n648\t\tcmd := exec.Command(bin, \"-z\", \"-i\", \"1-3\")\n649\t\tout, err := cmd.Output()\n650\t\tif err != nil {\n651\t\t\tt.Fatalf(\"shuf -z -i 1-3 failed: %v\", err)\n652\t\t}\n653\t\n654\t\traw := strings.TrimSuffix(string(out), \"\\x00\")\n655\t\tgot := strings.Split(raw, \"\\x00\")\n656\t\tif len(got) != 3 {\n657\t\t\tt.Fatalf(\"expected 3 entries, got %d\", len(got))\n658\t\t}\n659\t\n660\t\tsorted := slices.Clone(got)\n661\t\tsort.Strings(sorted)\n662\t\twant := []string{\"1\", \"2\", \"3\"}\n663\t\tif !slices.Equal(sorted, want) {\n664\t\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n665\t\t}\n666\t}\n667\t\n668\t// R3.3: -e treats each argument as an input line\n669\tfunc TestEchoMode(t *testing.T) {\n670\t\tbin := testutils.BuildBinary(t, \".\")\n671\t\n672\t\tcmd := exec.Command(bin, \"-e\", \"alpha\", \"beta\", \"gamma\")\n673\t\tout, err := cmd.Output()\n674\t\tif err != nil {\n675\t\t\tt.Fatalf(\"shuf -e failed: %v\", err)\n676\t\t}\n677\t\n678\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n679\t\tif len(got) != 3 {\n680\t\t\tt.Fatalf(\"expected 3 lines, got %d\", len(got))\n681\t\t}\n682\t\n683\t\tsorted := slices.Clone(got)\n684\t\tsort.Strings(sorted)\n685\t\twant := []string{\"alpha\", \"beta\", \"gamma\"}\n686\t\tif !slices.Equal(sorted, want) {\n687\t\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n688\t\t}\n689\t}\n690\t\n691\t// R3.3: --echo long form\n692\tfunc TestEchoModeLong(t *testing.T) {\n693\t\tbin := testutils.BuildBinary(t, \".\")\n694\t\n695\t\tcmd := exec.Command(bin, \"--echo\", \"one\", \"two\")\n696\t\tout, err := cmd.Output()\n697\t\tif err != nil {\n698\t\t\tt.Fatalf(\"shuf --echo failed: %v\", err)\n699\t\t}\n700\t\n701\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n702\t\tif len(got) != 2 {\n703\t\t\tt.Fatalf(\"expected 2 lines, got %d\", len(got))\n704\t\t}\n705\t\n706\t\tsorted := slices.Clone(got)\n707\t\tsort.Strings(sorted)\n708\t\twant := []string{\"one\", \"two\"}\n709\t\tif !slices.Equal(sorted, want) {\n710\t\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n711\t\t}\n712\t}\n713\t\n714\t// R3.3: -e with -n limits output\n715\tfunc TestEchoModeWithHead(t *testing.T) {\n716\t\tbin := testutils.BuildBinary(t, \".\")\n717\t\n718\t\tcmd := exec.Command(bin, \"-e\", \"-n\", \"2\", \"a\", \"b\", \"c\", \"d\")\n719\t\tout, err := cmd.Output()\n720\t\tif err != nil {\n721\t\t\tt.Fatalf(\"shuf -e -n 2 failed: %v\", err)\n722\t\t}\n723\t\n724\t\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n725\t\tif len(got) != 2 {\n726\t\t\tt.Fatalf(\"expected 2 lines, got %d\", len(got))\n727\t\t}\n728\t\n729\t\tvalid := map[string]bool{\"a\": true, \"b\": true, \"c\": true, \"d\": true}\n730\t\tfor _, line := range got {\n731\t\t\tif !valid[line] {\n732\t\t\t\tt.Errorf(\"unexpected output: %q\", line)\n733\t\t\t}\n734\t\t}\n735\t}\n736\t\n737\t// R3.3: -e with -i is an error\n738\tfunc TestEchoWithRangeError(t *testing.T) {\n739\t\tbin := testutils.BuildBinary(t, \".\")\n740\t\n741\t\tcmd := exec.Command(bin, \"-e\", \"-i\", \"1-5\", \"foo\")\n742\t\tout, err := cmd.CombinedOutput()\n743\t\tif err == nil {\n744\t\t\tt.Fatal(\"expected error combining -e and -i\")\n745\t\t}\n746\t\tif !strings.Contains(string(out), \"cannot combine\") {\n747\t\t\tt.Errorf(\"expected 'cannot combine' error, got: %s\", out)\n748\t\t}\n749\t}\n750\t\n751\t// R3.4: empty input produces no output and exits 0\n752\tfunc TestEmptyInput(t *testing.T) {\n753\t\tbin := testutils.BuildBinary(t, \".\")\n754\t\n755\t\tcmd := exec.Command(bin)\n756\t\tcmd.Stdin = strings.NewReader(\"\")\n757\t\tout, err := cmd.Output()\n758\t\tif err != nil {\n759\t\t\tt.Fatalf(\"shuf with empty input failed: %v\", err)\n760\t\t}\n761\t\tif len(out) != 0 {\n762\t\t\tt.Errorf(\"expected no output, got: %q\", out)\n763\t\t}\n764\t}\n765\t\n766\t// R3.4: -e with no args produces no output\n767\tfunc TestEchoModeEmpty(t *testing.T) {\n768\t\tbin := testutils.BuildBinary(t, \".\")\n769\t\n770\t\tcmd := exec.Command(bin, \"-e\")\n771\t\tout, err := cmd.Output()\n772\t\tif err != nil {\n773\t\t\tt.Fatalf(\"shuf -e with no args failed: %v\", err)\n774\t\t}\n775\t\tif len(out) != 0 {\n776\t\t\tt.Errorf(\"expected no output, got: %q\", out)\n777\t\t}\n778\t}\n779\t\n780\t// R3.3: differential test for echo mode\n781\tfunc TestDiffEcho(t *testing.T) {\n782\t\tgoBin := testutils.BuildBinary(t, \".\")\n783\t\trefBin, err := exec.LookPath(\"gshuf\")\n784\t\tif err != nil {\n785\t\t\tt.Skip(\"reference binary not found\")\n786\t\t}\n787\t\n788\t\ttests := []testutils.DiffTest{\n789\t\t\t{\n790\t\t\t\tName:      \"echo_three_words\",\n791\t\t\t\tArgs:      []string{\"-e\", \"alpha\", \"beta\", \"gamma\"},\n792\t\t\t\tExitCode:  0,\n793\t\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n794\t\t\t},\n795\t\t\t{\n796\t\t\t\tName:      \"echo_empty\",\n797\t\t\t\tArgs:      []string{\"-e\"},\n798\t\t\t\tExitCode:  0,\n799\t\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n800\t\t\t},\n801\t\t\t{\n802\t\t\t\tName:      \"echo_with_head\",\n803\t\t\t\tArgs:      []string{\"-e\", \"-n\", \"2\", \"a\", \"b\", \"c\"},\n804\t\t\t\tExitCode:  0,\n805\t\t\t\tNormalize: []testutils.NormalizeFunc{lineCount},\n806\t\t\t},\n807\t\t}\n808\t\n809\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n810\t}\n811\t\n812\t// R3.2: differential test for zero-terminated mode\n813\tfunc TestDiffZeroTerminated(t *testing.T) {\n814\t\tgoBin := testutils.BuildBinary(t, \".\")\n815\t\trefBin, err := exec.LookPath(\"gshuf\")\n816\t\tif err != nil {\n817\t\t\tt.Skip(\"reference binary not found\")\n818\t\t}\n819\t\n820\t\tsortNulLines := func(b []byte) []byte {\n821\t\t\ts := strings.TrimSuffix(string(b), \"\\x00\")\n822\t\t\tif s == \"\" {\n823\t\t\t\treturn b\n824\t\t\t}\n825\t\t\tparts := strings.Split(s, \"\\x00\")\n826\t\t\tsort.Strings(parts)\n827\t\t\treturn []byte(strings.Join(parts, \"\\x00\") + \"\\x00\")\n828\t\t}\n829\t\n830\t\ttests := []testutils.DiffTest{\n831\t\t\t{\n832\t\t\t\tName:      \"zero_terminated_stdin\",\n833\t\t\t\tArgs:      []string{\"-z\"},\n834\t\t\t\tStdin:     []byte(\"a\\x00b\\x00c\\x00\"),\n835\t\t\t\tExitCode:  0,\n836\t\t\t\tNormalize: []testutils.NormalizeFunc{sortNulLines},\n837\t\t\t},\n838\t\t\t{\n839\t\t\t\tName:      \"zero_terminated_range\",\n840\t\t\t\tArgs:      []string{\"-z\", \"-i\", \"1-3\"},\n841\t\t\t\tExitCode:  0,\n842\t\t\t\tNormalize: []testutils.NormalizeFunc{sortNulLines},\n843\t\t\t},\n844\t\t}\n845\t\n846\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n847\t}\n848\t"}]},"parent_tool_use_id":null,"session_id":"78073c1a-ebc5-4b9f-bc7d-14f2b828e657","uuid":"9d703fd2-6f1e-4a18-8a75-eb5750ed5931","timestamp":"2026-05-21T18:33:46.083Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5435/cmd/shuf/shuf_test.go","content":"package main\n\nimport (\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"slices\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc sortLines(b []byte) []byte {\n\ts := strings.TrimSuffix(string(b), \"\\n\")\n\tif s == \"\" {\n\t\treturn b\n\t}\n\tlines := strings.Split(s, \"\\n\")\n\tsort.Strings(lines)\n\treturn []byte(strings.Join(lines, \"\\n\") + \"\\n\")\n}\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gshuf\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:      \"empty_input\",\n\t\t\tStdin:     []byte(\"\"),\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t\t{\n\t\t\tName:      \"single_line\",\n\t\t\tStdin:     []byte(\"hello\\n\"),\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t\t{\n\t\t\tName:      \"multiple_lines\",\n\t\t\tStdin:     []byte(\"alpha\\nbeta\\ngamma\\n\"),\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t\t{\n\t\t\tName:      \"no_trailing_newline\",\n\t\t\tStdin:     []byte(\"x\\ny\\nz\"),\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc TestDiffFile(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gshuf\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\tdir := t.TempDir()\n\tf := filepath.Join(dir, \"input.txt\")\n\tif err := os.WriteFile(f, []byte(\"one\\ntwo\\nthree\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:      \"file_argument\",\n\t\t\tArgs:      []string{f},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\n// R1.1: multiple file arguments concatenate lines then shuffle\nfunc TestMultipleFiles(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tdir := t.TempDir()\n\tf1 := filepath.Join(dir, \"a.txt\")\n\tf2 := filepath.Join(dir, \"b.txt\")\n\tif err := os.WriteFile(f1, []byte(\"a\\nb\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := os.WriteFile(f2, []byte(\"c\\nd\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tcmd := exec.Command(bin, f1, f2)\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\twant := []string{\"a\", \"b\", \"c\", \"d\"}\n\n\tif len(got) != len(want) {\n\t\tt.Fatalf(\"expected %d lines, got %d\", len(want), len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"output is not a permutation of combined input: got %v\", got)\n\t}\n}\n\nfunc TestDiffStdinDash(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gshuf\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:      \"stdin_via_dash\",\n\t\t\tArgs:      []string{\"-\"},\n\t\t\tStdin:     []byte(\"p\\nq\\nr\\n\"),\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\n// R1.3: structural verification that output is a permutation\nfunc TestPermutation(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tinput := \"line1\\nline2\\nline3\\nline4\\nline5\\n\"\n\tcmd := exec.Command(bin)\n\tcmd.Stdin = strings.NewReader(input)\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\twant := []string{\"line1\", \"line2\", \"line3\", \"line4\", \"line5\"}\n\n\tif len(got) != len(want) {\n\t\tt.Fatalf(\"expected %d lines, got %d\", len(want), len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"output is not a permutation of input: got %v\", got)\n\t}\n}\n\n// R1.4: last line without trailing newline is included\nfunc TestNoTrailingNewline(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tinput := \"a\\nb\\nc\"\n\tcmd := exec.Command(bin)\n\tcmd.Stdin = strings.NewReader(input)\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\twant := []string{\"a\", \"b\", \"c\"}\n\n\tif len(got) != len(want) {\n\t\tt.Fatalf(\"expected %d lines, got %d: %v\", len(want), len(got), got)\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"output is not a permutation of input: got %v\", got)\n\t}\n}\n\n// R2.1: -i LO-HI generates and shuffles integers from LO to HI inclusive\nfunc TestRangeMode(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-i\", \"1-10\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -i 1-10 failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 10 {\n\t\tt.Fatalf(\"expected 10 lines, got %d\", len(got))\n\t}\n\n\tseen := make(map[int]bool)\n\tfor _, line := range got {\n\t\tv, err := strconv.Atoi(line)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"non-integer in output: %q\", line)\n\t\t}\n\t\tif v < 1 || v > 10 {\n\t\t\tt.Errorf(\"value %d out of range [1,10]\", v)\n\t\t}\n\t\tif seen[v] {\n\t\t\tt.Errorf(\"duplicate value %d without -r\", v)\n\t\t}\n\t\tseen[v] = true\n\t}\n}\n\n// R2.1: --input-range=LO-HI long form\nfunc TestRangeModeLong(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"--input-range=3-7\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf --input-range=3-7 failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 5 {\n\t\tt.Fatalf(\"expected 5 lines, got %d\", len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\twant := []string{\"3\", \"4\", \"5\", \"6\", \"7\"}\n\tsort.Strings(want)\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"output is not a permutation of 3..7: got %v\", got)\n\t}\n}\n\n// R2.1: -i must not be combined with file arguments\nfunc TestRangeWithFileError(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-i\", \"1-5\", \"somefile\")\n\tout, err := cmd.CombinedOutput()\n\tif err == nil {\n\t\tt.Fatal(\"expected error when combining -i with file args\")\n\t}\n\tif !strings.Contains(string(out), \"extra operand\") {\n\t\tt.Errorf(\"expected 'extra operand' error, got: %s\", out)\n\t}\n}\n\n// R2.2: -n COUNT limits output to at most COUNT lines\nfunc TestHeadCount(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tinput := \"a\\nb\\nc\\nd\\ne\\nf\\ng\\nh\\ni\\nj\\n\"\n\tcmd := exec.Command(bin, \"-n\", \"3\")\n\tcmd.Stdin = strings.NewReader(input)\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -n 3 failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 3 {\n\t\tt.Fatalf(\"expected 3 lines, got %d\", len(got))\n\t}\n\n\tvalid := map[string]bool{\n\t\t\"a\": true, \"b\": true, \"c\": true, \"d\": true, \"e\": true,\n\t\t\"f\": true, \"g\": true, \"h\": true, \"i\": true, \"j\": true,\n\t}\n\tfor _, line := range got {\n\t\tif !valid[line] {\n\t\t\tt.Errorf(\"unexpected output line: %q\", line)\n\t\t}\n\t}\n}\n\n// R2.2: -n COUNT with range mode\nfunc TestHeadCountRange(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-i\", \"1-100\", \"-n\", \"5\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -i 1-100 -n 5 failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 5 {\n\t\tt.Fatalf(\"expected 5 lines, got %d\", len(got))\n\t}\n\n\tseen := make(map[int]bool)\n\tfor _, line := range got {\n\t\tv, err := strconv.Atoi(line)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"non-integer: %q\", line)\n\t\t}\n\t\tif v < 1 || v > 100 {\n\t\t\tt.Errorf(\"value %d out of range [1,100]\", v)\n\t\t}\n\t\tif seen[v] {\n\t\t\tt.Errorf(\"duplicate value %d without -r\", v)\n\t\t}\n\t\tseen[v] = true\n\t}\n}\n\n// R2.2: -n larger than input produces all lines\nfunc TestHeadCountLargerThanInput(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tinput := \"x\\ny\\n\"\n\tcmd := exec.Command(bin, \"-n\", \"100\")\n\tcmd.Stdin = strings.NewReader(input)\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -n 100 failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 2 {\n\t\tt.Fatalf(\"expected 2 lines (all input), got %d\", len(got))\n\t}\n}\n\n// R2.3: -r with -n produces exactly n lines with possible duplicates\nfunc TestRepeatWithHead(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-i\", \"1-3\", \"-r\", \"-n\", \"20\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -i 1-3 -r -n 20 failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 20 {\n\t\tt.Fatalf(\"expected 20 lines, got %d\", len(got))\n\t}\n\n\tfor _, line := range got {\n\t\tv, err := strconv.Atoi(line)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"non-integer: %q\", line)\n\t\t}\n\t\tif v < 1 || v > 3 {\n\t\t\tt.Errorf(\"value %d out of range [1,3]\", v)\n\t\t}\n\t}\n}\n\n// R2.3: -r with stdin input\nfunc TestRepeatStdin(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-r\", \"-n\", \"15\")\n\tcmd.Stdin = strings.NewReader(\"alpha\\nbeta\\n\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -r -n 15 failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 15 {\n\t\tt.Fatalf(\"expected 15 lines, got %d\", len(got))\n\t}\n\n\tvalid := map[string]bool{\"alpha\": true, \"beta\": true}\n\tfor _, line := range got {\n\t\tif !valid[line] {\n\t\t\tt.Errorf(\"unexpected output: %q\", line)\n\t\t}\n\t}\n}\n\n// R2.4: -o FILE writes output to file instead of stdout\nfunc TestOutputFile(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tdir := t.TempDir()\n\toutFile := filepath.Join(dir, \"out.txt\")\n\n\tcmd := exec.Command(bin, \"-i\", \"1-5\", \"-o\", outFile)\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"shuf -o failed: %v\", err)\n\t}\n\n\tdata, err := os.ReadFile(outFile)\n\tif err != nil {\n\t\tt.Fatalf(\"reading output file: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(data), \"\\n\"), \"\\n\")\n\tif len(got) != 5 {\n\t\tt.Fatalf(\"expected 5 lines, got %d\", len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\twant := []string{\"1\", \"2\", \"3\", \"4\", \"5\"}\n\tsort.Strings(want)\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"output is not a permutation of 1..5: got %v\", got)\n\t}\n}\n\n// R2.4: --output=FILE long form\nfunc TestOutputFileLong(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tdir := t.TempDir()\n\toutFile := filepath.Join(dir, \"out.txt\")\n\n\tinput := \"foo\\nbar\\nbaz\\n\"\n\tcmd := exec.Command(bin, \"--output=\"+outFile)\n\tcmd.Stdin = strings.NewReader(input)\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"shuf --output failed: %v\", err)\n\t}\n\n\tdata, err := os.ReadFile(outFile)\n\tif err != nil {\n\t\tt.Fatalf(\"reading output file: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(data), \"\\n\"), \"\\n\")\n\tif len(got) != 3 {\n\t\tt.Fatalf(\"expected 3 lines, got %d\", len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\twant := []string{\"bar\", \"baz\", \"foo\"}\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"output is not a permutation of input: got %v\", got)\n\t}\n}\n\n// R2.1: invalid range format\nfunc TestInvalidRange(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-i\", \"abc\")\n\tout, err := cmd.CombinedOutput()\n\tif err == nil {\n\t\tt.Fatal(\"expected error for invalid range\")\n\t}\n\tif !strings.Contains(string(out), \"invalid input range\") {\n\t\tt.Errorf(\"expected 'invalid input range' error, got: %s\", out)\n\t}\n}\n\n// R2.1: reversed range (LO > HI)\nfunc TestReversedRange(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-i\", \"10-5\")\n\tout, err := cmd.CombinedOutput()\n\tif err == nil {\n\t\tt.Fatal(\"expected error for reversed range\")\n\t}\n\tif !strings.Contains(string(out), \"invalid input range\") {\n\t\tt.Errorf(\"expected 'invalid input range' error, got: %s\", out)\n\t}\n}\n\n// R2.2: -n 0 produces no output\nfunc TestHeadCountZero(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-i\", \"1-10\", \"-n\", \"0\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -n 0 failed: %v\", err)\n\t}\n\tif len(out) != 0 {\n\t\tt.Errorf(\"expected empty output, got: %q\", out)\n\t}\n}\n\n// R2.1: differential test for range mode (structural)\nfunc TestDiffRange(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gshuf\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:      \"range_1_5\",\n\t\t\tArgs:      []string{\"-i\", \"1-5\"},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t\t{\n\t\t\tName:      \"range_with_head\",\n\t\t\tArgs:      []string{\"-i\", \"1-100\", \"-n\", \"3\"},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{lineCount},\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc lineCount(b []byte) []byte {\n\ts := strings.TrimSuffix(string(b), \"\\n\")\n\tif s == \"\" {\n\t\treturn []byte(\"0\\n\")\n\t}\n\tn := len(strings.Split(s, \"\\n\"))\n\treturn []byte(strconv.Itoa(n) + \"\\n\")\n}\n\n// R3.1: --random-source=FILE reads random bytes from file\nfunc TestRandomSource(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tdir := t.TempDir()\n\trsFile := filepath.Join(dir, \"rand.bin\")\n\tseed := make([]byte, 64)\n\tfor i := range seed {\n\t\tseed[i] = byte(i * 7)\n\t}\n\tif err := os.WriteFile(rsFile, seed, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tcmd := exec.Command(bin, \"--random-source=\"+rsFile, \"-i\", \"1-10\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf --random-source failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 10 {\n\t\tt.Fatalf(\"expected 10 lines, got %d\", len(got))\n\t}\n\n\tseen := make(map[int]bool)\n\tfor _, line := range got {\n\t\tv, err := strconv.Atoi(line)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"non-integer: %q\", line)\n\t\t}\n\t\tif v < 1 || v > 10 {\n\t\t\tt.Errorf(\"value %d out of range\", v)\n\t\t}\n\t\tif seen[v] {\n\t\t\tt.Errorf(\"duplicate: %d\", v)\n\t\t}\n\t\tseen[v] = true\n\t}\n\n\tcmd2 := exec.Command(bin, \"--random-source=\"+rsFile, \"-i\", \"1-10\")\n\tout2, err := cmd2.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"second run failed: %v\", err)\n\t}\n\tif string(out) != string(out2) {\n\t\tt.Errorf(\"same random source should produce same output\")\n\t}\n}\n\n// R3.1: --random-source with missing file\nfunc TestRandomSourceMissing(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"--random-source=/nonexistent\", \"-i\", \"1-5\")\n\terr := cmd.Run()\n\tif err == nil {\n\t\tt.Fatal(\"expected error for missing random source file\")\n\t}\n}\n\n// R3.2: -z uses NUL as delimiter for both input and output\nfunc TestZeroTerminated(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tinput := \"alpha\\x00beta\\x00gamma\\x00\"\n\tcmd := exec.Command(bin, \"-z\")\n\tcmd.Stdin = strings.NewReader(input)\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -z failed: %v\", err)\n\t}\n\n\traw := string(out)\n\traw = strings.TrimSuffix(raw, \"\\x00\")\n\tgot := strings.Split(raw, \"\\x00\")\n\tif len(got) != 3 {\n\t\tt.Fatalf(\"expected 3 NUL-separated entries, got %d: %q\", len(got), out)\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\twant := []string{\"alpha\", \"beta\", \"gamma\"}\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n\t}\n}\n\n// R3.2: --zero-terminated long form\nfunc TestZeroTerminatedLong(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tinput := \"x\\x00y\\x00z\\x00\"\n\tcmd := exec.Command(bin, \"--zero-terminated\")\n\tcmd.Stdin = strings.NewReader(input)\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf --zero-terminated failed: %v\", err)\n\t}\n\n\traw := strings.TrimSuffix(string(out), \"\\x00\")\n\tgot := strings.Split(raw, \"\\x00\")\n\tif len(got) != 3 {\n\t\tt.Fatalf(\"expected 3 entries, got %d\", len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\twant := []string{\"x\", \"y\", \"z\"}\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n\t}\n}\n\n// R3.2: -z with range mode\nfunc TestZeroTerminatedRange(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-z\", \"-i\", \"1-3\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -z -i 1-3 failed: %v\", err)\n\t}\n\n\traw := strings.TrimSuffix(string(out), \"\\x00\")\n\tgot := strings.Split(raw, \"\\x00\")\n\tif len(got) != 3 {\n\t\tt.Fatalf(\"expected 3 entries, got %d\", len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\twant := []string{\"1\", \"2\", \"3\"}\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n\t}\n}\n\n// R3.3: -e treats each argument as an input line\nfunc TestEchoMode(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-e\", \"alpha\", \"beta\", \"gamma\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -e failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 3 {\n\t\tt.Fatalf(\"expected 3 lines, got %d\", len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\twant := []string{\"alpha\", \"beta\", \"gamma\"}\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n\t}\n}\n\n// R3.3: --echo long form\nfunc TestEchoModeLong(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"--echo\", \"one\", \"two\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf --echo failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 2 {\n\t\tt.Fatalf(\"expected 2 lines, got %d\", len(got))\n\t}\n\n\tsorted := slices.Clone(got)\n\tsort.Strings(sorted)\n\twant := []string{\"one\", \"two\"}\n\tif !slices.Equal(sorted, want) {\n\t\tt.Errorf(\"expected permutation of %v, got %v\", want, got)\n\t}\n}\n\n// R3.3: -e with -n limits output\nfunc TestEchoModeWithHead(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-e\", \"-n\", \"2\", \"a\", \"b\", \"c\", \"d\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -e -n 2 failed: %v\", err)\n\t}\n\n\tgot := strings.Split(strings.TrimSuffix(string(out), \"\\n\"), \"\\n\")\n\tif len(got) != 2 {\n\t\tt.Fatalf(\"expected 2 lines, got %d\", len(got))\n\t}\n\n\tvalid := map[string]bool{\"a\": true, \"b\": true, \"c\": true, \"d\": true}\n\tfor _, line := range got {\n\t\tif !valid[line] {\n\t\t\tt.Errorf(\"unexpected output: %q\", line)\n\t\t}\n\t}\n}\n\n// R3.3: -e with -i is an error\nfunc TestEchoWithRangeError(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-e\", \"-i\", \"1-5\", \"foo\")\n\tout, err := cmd.CombinedOutput()\n\tif err == nil {\n\t\tt.Fatal(\"expected error combining -e and -i\")\n\t}\n\tif !strings.Contains(string(out), \"cannot combine\") {\n\t\tt.Errorf(\"expected 'cannot combine' error, got: %s\", out)\n\t}\n}\n\n// R3.4: empty input produces no output and exits 0\nfunc TestEmptyInput(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin)\n\tcmd.Stdin = strings.NewReader(\"\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf with empty input failed: %v\", err)\n\t}\n\tif len(out) != 0 {\n\t\tt.Errorf(\"expected no output, got: %q\", out)\n\t}\n}\n\n// R3.4: -e with no args produces no output\nfunc TestEchoModeEmpty(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\n\tcmd := exec.Command(bin, \"-e\")\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"shuf -e with no args failed: %v\", err)\n\t}\n\tif len(out) != 0 {\n\t\tt.Errorf(\"expected no output, got: %q\", out)\n\t}\n}\n\n// R3.3: differential test for echo mode\nfunc TestDiffEcho(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gshuf\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:      \"echo_three_words\",\n\t\t\tArgs:      []string{\"-e\", \"alpha\", \"beta\", \"gamma\"},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t\t{\n\t\t\tName:      \"echo_empty\",\n\t\t\tArgs:      []string{\"-e\"},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortLines},\n\t\t},\n\t\t{\n\t\t\tName:      \"echo_with_head\",\n\t\t\tArgs:      []string{\"-e\", \"-n\", \"2\", \"a\", \"b\", \"c\"},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{lineCount},\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\n// R3.2: differential test for zero-terminated mode\nfunc TestDiffZeroTerminated(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gshuf\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\tsortNulLines := func(b []byte) []byte {\n\t\ts := strings.TrimSuffix(string(b), \"\\x00\")\n\t\tif s == \"\" {\n\t\t\treturn b\n\t\t}\n\t\tparts := strings.Split(s, \"\\x00\")\n\t\tsort.Strings(parts)\n\t\treturn []byte(strings.Join(parts, \"\\x00\") + \"\\x00\")\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName:      \"zero_terminated_stdin\",\n\t\t\tArgs:      []string{\"-z\"},\n\t\t\tStdin:     []byte(\"a\\x00b\\x00c\\x00\"),\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortNulLines},\n\t\t},\n\t\t{\n\t\t\tName:      \"zero_terminated_range\",\n\t\t\tArgs:      []string{\"-z\", \"-i\", \"1-3\"},\n\t\t\tExitCode:  0,\n\t\t\tNormalize: []testutils.NormalizeFunc{sortNulLines},\n\t\t},\n\t}\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n","numLines":848,"startLine":1,"totalLines":848}}}
