{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T3WeLxuBPWAM39md5YmK8B","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd092-mkfifo R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"strings\"\n11\t\t\"syscall\"\n12\t\n13\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n14\t)\n15\t\n16\tconst helpText = `Usage: mkfifo [OPTION]... NAME...\n17\tCreate named pipes (FIFOs) with the given NAMEs.\n18\t\n19\tMandatory arguments to long options are mandatory for short options too.\n20\t  -m, --mode=MODE    set file permission bits to MODE, not a=rw - umask\n21\t      --help         display this help and exit\n22\t      --version      output version information and exit\n23\t`\n24\t\n25\tconst versionText = `mkfifo (go-unix-utils) dev\n26\t`\n27\t\n28\tfunc main() {\n29\t\tsys.InstallSIGPIPEHandler()\n30\t\tmodeStr, names, err := parseArgs(os.Args[1:])\n31\t\tif err != nil {\n32\t\t\tfmt.Fprintf(os.Stderr, \"mkfifo: %s\\n\", err)\n33\t\t\tfmt.Fprintf(os.Stderr, \"Try 'mkfifo --help' for more information.\\n\")\n34\t\t\tos.Exit(1)\n35\t\t}\n36\t\tos.Exit(run(modeStr, names))\n37\t}\n38\t\n39\tfunc run(modeStr string, names []string) int {\n40\t\tvar mode os.FileMode\n41\t\tvar modeSet bool\n42\t\tif modeStr != \"\" {\n43\t\t\tvar err error\n44\t\t\tmode, err = parseMode(modeStr)\n45\t\t\tif err != nil {\n46\t\t\t\tfmt.Fprintf(os.Stderr, \"mkfifo: invalid mode\\n\")\n47\t\t\t\treturn 1\n48\t\t\t}\n49\t\t\tmodeSet = true\n50\t\t}\n51\t\texitCode := 0\n52\t\tfor _, name := range names {\n53\t\t\tif err := syscall.Mkfifo(name, 0o666); err != nil {\n54\t\t\t\tfmt.Fprintf(os.Stderr, \"mkfifo: cannot create fifo '%s': %s\\n\",\n55\t\t\t\t\tname, sysErrMsg(err))\n56\t\t\t\texitCode = 1\n57\t\t\t\tcontinue\n58\t\t\t}\n59\t\t\tif modeSet {\n60\t\t\t\tif err := os.Chmod(name, mode); err != nil {\n61\t\t\t\t\tfmt.Fprintf(os.Stderr, \"mkfifo: cannot create fifo '%s': %s\\n\",\n62\t\t\t\t\t\tname, sysErrMsg(err))\n63\t\t\t\t\texitCode = 1\n64\t\t\t\t}\n65\t\t\t}\n66\t\t}\n67\t\treturn exitCode\n68\t}\n69\t\n70\tfunc sysErrMsg(err error) string {\n71\t\tif pe, ok := err.(*os.PathError); ok {\n72\t\t\terr = pe.Err\n73\t\t}\n74\t\tse, ok := err.(syscall.Errno)\n75\t\tif !ok {\n76\t\t\treturn err.Error()\n77\t\t}\n78\t\tswitch se {\n79\t\tcase syscall.EEXIST:\n80\t\t\treturn \"File exists\"\n81\t\tcase syscall.ENOENT:\n82\t\t\treturn \"No such file or directory\"\n83\t\tcase syscall.EACCES:\n84\t\t\treturn \"Permission denied\"\n85\t\tcase syscall.ENOTDIR:\n86\t\t\treturn \"Not a directory\"\n87\t\tdefault:\n88\t\t\treturn se.Error()\n89\t\t}\n90\t}\n91\t\n92\tfunc parseArgs(args []string) (string, []string, error) {\n93\t\tvar modeStr string\n94\t\tvar names []string\n95\t\ti := 0\n96\t\tfor i < len(args) {\n97\t\t\targ := args[i]\n98\t\t\tif arg == \"--\" {\n99\t\t\t\tnames = append(names, args[i+1:]...)\n100\t\t\t\tbreak\n101\t\t\t}\n102\t\t\tif strings.HasPrefix(arg, \"--\") {\n103\t\t\t\tn, err := parseLongFlag(args, i, &modeStr)\n104\t\t\t\tif err != nil {\n105\t\t\t\t\treturn \"\", nil, err\n106\t\t\t\t}\n107\t\t\t\ti += n\n108\t\t\t\tcontinue\n109\t\t\t}\n110\t\t\tif len(arg) > 1 && arg[0] == '-' {\n111\t\t\t\tn, err := parseShortFlag(args, i, &modeStr)\n112\t\t\t\tif err != nil {\n113\t\t\t\t\treturn \"\", nil, err\n114\t\t\t\t}\n115\t\t\t\ti += n\n116\t\t\t\tcontinue\n117\t\t\t}\n118\t\t\tnames = append(names, arg)\n119\t\t\ti++\n120\t\t}\n121\t\tif len(names) == 0 {\n122\t\t\treturn \"\", nil, fmt.Errorf(\"missing operand\")\n123\t\t}\n124\t\treturn modeStr, names, nil\n125\t}\n126\t\n127\tfunc parseLongFlag(args []string, idx int, modeStr *string) (int, error) {\n128\t\tflag := args[idx]\n129\t\tif strings.HasPrefix(flag, \"--mode=\") {\n130\t\t\t*modeStr = flag[7:]\n131\t\t\treturn 1, nil\n132\t\t}\n133\t\tswitch flag {\n134\t\tcase \"--help\":\n135\t\t\tfmt.Fprint(os.Stdout, helpText)\n136\t\t\tos.Exit(0)\n137\t\tcase \"--version\":\n138\t\t\tfmt.Fprint(os.Stdout, versionText)\n139\t\t\tos.Exit(0)\n140\t\tcase \"--mode\":\n141\t\t\tif idx+1 >= len(args) {\n142\t\t\t\treturn 0, fmt.Errorf(\"option '--mode' requires an argument\")\n143\t\t\t}\n144\t\t\t*modeStr = args[idx+1]\n145\t\t\treturn 2, nil\n146\t\tdefault:\n147\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n148\t\t}\n149\t\treturn 0, nil\n150\t}\n151\t\n152\tfunc parseShortFlag(args []string, idx int, modeStr *string) (int, error) {\n153\t\tflags := args[idx][1:]\n154\t\tif flags[0] != 'm' {\n155\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[0])\n156\t\t}\n157\t\trest := flags[1:]\n158\t\tif rest != \"\" {\n159\t\t\t*modeStr = rest\n160\t\t\treturn 1, nil\n161\t\t}\n162\t\tif idx+1 >= len(args) {\n163\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'm'\")\n164\t\t}\n165\t\t*modeStr = args[idx+1]\n166\t\treturn 2, nil\n167\t}\n168\t\n169\tfunc parseMode(modeStr string) (os.FileMode, error) {\n170\t\tif len(modeStr) == 0 {\n171\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", modeStr)\n172\t\t}\n173\t\tif modeStr[0] >= '0' && modeStr[0] <= '7' {\n174\t\t\treturn parseOctalMode(modeStr)\n175\t\t}\n176\t\treturn parseSymbolicMode(modeStr)\n177\t}\n178\t\n179\tfunc parseOctalMode(s string) (os.FileMode, error) {\n180\t\tvar val uint64\n181\t\tfor _, c := range s {\n182\t\t\tif c < '0' || c > '7' {\n183\t\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", s)\n184\t\t\t}\n185\t\t\tval = val*8 + uint64(c-'0')\n186\t\t\tif val > 07777 {\n187\t\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", s)\n188\t\t\t}\n189\t\t}\n190\t\tmode := os.FileMode(val & 0o777)\n191\t\tif val&0o4000 != 0 {\n192\t\t\tmode |= os.ModeSetuid\n193\t\t}\n194\t\tif val&0o2000 != 0 {\n195\t\t\tmode |= os.ModeSetgid\n196\t\t}\n197\t\tif val&0o1000 != 0 {\n198\t\t\tmode |= os.ModeSticky\n199\t\t}\n200\t\treturn mode, nil\n201\t}\n202\t\n203\tfunc parseSymbolicMode(modeStr string) (os.FileMode, error) {\n204\t\tumaskVal := currentUmask()\n205\t\tmode := os.FileMode(0o666)\n206\t\tfor clause := range strings.SplitSeq(modeStr, \",\") {\n207\t\t\tvar err error\n208\t\t\tmode, err = applySymbolicClause(clause, mode, umaskVal)\n209\t\t\tif err != nil {\n210\t\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", modeStr)\n211\t\t\t}\n212\t\t}\n213\t\treturn mode, nil\n214\t}\n215\t\n216\tfunc currentUmask() int {\n217\t\told := syscall.Umask(0)\n218\t\tsyscall.Umask(old)\n219\t\treturn old\n220\t}\n221\t\n222\tfunc applySymbolicClause(clause string, mode os.FileMode, umask int) (os.FileMode, error) {\n223\t\ti, whoMask, explicit := parseWhoChars(clause)\n224\t\tif i >= len(clause) {\n225\t\t\treturn 0, fmt.Errorf(\"missing operator\")\n226\t\t}\n227\t\top := clause[i]\n228\t\tif op != '+' && op != '-' && op != '=' {\n229\t\t\treturn 0, fmt.Errorf(\"invalid operator\")\n230\t\t}\n231\t\tpermBits, specialBits := parsePermChars(clause[i+1:], whoMask)\n232\t\teffectivePerms := permBits\n233\t\tif !explicit {\n234\t\t\teffectivePerms &^= os.FileMode(umask)\n235\t\t}\n236\t\treturn applyModeOp(mode, op, whoMask, effectivePerms, specialBits, explicit), nil\n237\t}\n238\t\n239\tfunc parseWhoChars(clause string) (int, os.FileMode, bool) {\n240\t\tvar whoMask os.FileMode\n241\t\texplicit := false\n242\t\ti := 0\n243\t\tfor i < len(clause) {\n244\t\t\tswitch clause[i] {\n245\t\t\tcase 'u':\n246\t\t\t\twhoMask |= 0o700\n247\t\t\t\texplicit = true\n248\t\t\tcase 'g':\n249\t\t\t\twhoMask |= 0o070\n250\t\t\t\texplicit = true\n251\t\t\tcase 'o':\n252\t\t\t\twhoMask |= 0o007\n253\t\t\t\texplicit = true\n254\t\t\tcase 'a':\n255\t\t\t\twhoMask |= 0o777\n256\t\t\t\texplicit = true\n257\t\t\tdefault:\n258\t\t\t\tif !explicit {\n259\t\t\t\t\twhoMask = 0o777\n260\t\t\t\t}\n261\t\t\t\treturn i, whoMask, explicit\n262\t\t\t}\n263\t\t\ti++\n264\t\t}\n265\t\tif !explicit {\n266\t\t\twhoMask = 0o777\n267\t\t}\n268\t\treturn i, whoMask, explicit\n269\