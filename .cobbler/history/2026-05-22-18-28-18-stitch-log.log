{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RfWtQmoGQ9f6GuPQJjK1Ym","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd071-numfmt R1.1-R1.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"flag\"\n10\t\t\"fmt\"\n11\t\t\"math\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tvar (\n20\t\tsiSuffixes   = []string{\"\", \"k\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n21\t\tiecSuffixes  = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n22\t\tieciSuffixes = []string{\"\", \"Ki\", \"Mi\", \"Gi\", \"Ti\", \"Pi\", \"Ei\"}\n23\t)\n24\t\n25\tfunc main() {\n26\t\tsys.InstallSIGPIPEHandler()\n27\t\ttoUnit := flag.String(\"to\", \"none\", \"\")\n28\t\tfromUnit := flag.String(\"from\", \"none\", \"\")\n29\t\tflag.Parse()\n30\t\n31\t\tif !isValidUnit(*toUnit) || !isValidUnit(*fromUnit) {\n32\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: invalid unit\\n\")\n33\t\t\tos.Exit(1)\n34\t\t}\n35\t\n36\t\thasError := false\n37\t\tif flag.NArg() > 0 {\n38\t\t\tfor _, arg := range flag.Args() {\n39\t\t\t\tif err := processToken(arg, *fromUnit, *toUnit); err != nil {\n40\t\t\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: %v\\n\", err)\n41\t\t\t\t\thasError = true\n42\t\t\t\t}\n43\t\t\t}\n44\t\t} else {\n45\t\t\tscanner := bufio.NewScanner(os.Stdin)\n46\t\t\tfor scanner.Scan() {\n47\t\t\t\tline := scanner.Text()\n48\t\t\t\tif err := processLine(line, *fromUnit, *toUnit); err != nil {\n49\t\t\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: %v\\n\", err)\n50\t\t\t\t\thasError = true\n51\t\t\t\t}\n52\t\t\t}\n53\t\t}\n54\t\tif hasError {\n55\t\t\tos.Exit(2)\n56\t\t}\n57\t}\n58\t\n59\tfunc isValidUnit(u string) bool {\n60\t\tswitch u {\n61\t\tcase \"none\", \"si\", \"iec\", \"iec-i\":\n62\t\t\treturn true\n63\t\t}\n64\t\treturn false\n65\t}\n66\t\n67\tfunc processLine(line, fromUnit, toUnit string) error {\n68\t\tprefix, token, trailing := splitWhitespace(line)\n69\t\tif token == \"\" {\n70\t\t\treturn fmt.Errorf(\"invalid number: %q\", \"\")\n71\t\t}\n72\t\tval, err := parseNumber(token, fromUnit)\n73\t\tif err != nil {\n74\t\t\treturn err\n75\t\t}\n76\t\tout := formatNumber(val, toUnit)\n77\t\tif prefix != \"\" {\n78\t\t\tfieldWidth := len(prefix) + len(token)\n79\t\t\tif len(out) < fieldWidth {\n80\t\t\t\tout = strings.Repeat(\" \", fieldWidth-len(out)) + out\n81\t\t\t}\n82\t\t}\n83\t\tfmt.Printf(\"%s%s\\n\", out, trailing)\n84\t\treturn nil\n85\t}\n86\t\n87\tfunc processToken(token, fromUnit, toUnit string) error {\n88\t\tval, err := parseNumber(token, fromUnit)\n89\t\tif err != nil {\n90\t\t\treturn err\n91\t\t}\n92\t\tout := formatNumber(val, toUnit)\n93\t\tfmt.Println(out)\n94\t\treturn nil\n95\t}\n96\t\n97\tfunc splitWhitespace(s string) (prefix, body, suffix string) {\n98\t\ttrimLeft := strings.TrimLeft(s, \" \\t\")\n99\t\tprefix = s[:len(s)-len(trimLeft)]\n100\t\ttrimRight := strings.TrimRight(trimLeft, \" \\t\")\n101\t\tsuffix = trimLeft[len(trimRight):]\n102\t\tbody = trimRight\n103\t\treturn\n104\t}\n105\t\n106\tfunc parseNumber(s, unit string) (float64, error) {\n107\t\tif unit == \"none\" {\n108\t\t\tval, err := strconv.ParseFloat(s, 64)\n109\t\t\tif err != nil {\n110\t\t\t\tif hasSuffix(s) {\n111\t\t\t\t\treturn 0, fmt.Errorf(\n112\t\t\t\t\t\t\"rejecting suffix in input: '%s' (consider using --from)\", s)\n113\t\t\t\t}\n114\t\t\t\treturn 0, fmt.Errorf(\"invalid number: '%s'\", s)\n115\t\t\t}\n116\t\t\treturn val, nil\n117\t\t}\n118\t\tnumStr, mult, err := extractSuffix(s, unit)\n119\t\tif err != nil {\n120\t\t\treturn 0, err\n121\t\t}\n122\t\tval, err := strconv.ParseFloat(numStr, 64)\n123\t\tif err != nil {\n124\t\t\treturn 0, fmt.Errorf(\"invalid number: '%s'\", s)\n125\t\t}\n126\t\treturn val * mult, nil\n127\t}\n128\t\n129\tfunc hasSuffix(s string) bool {\n130\t\tif len(s) == 0 {\n131\t\t\treturn false\n132\t\t}\n133\t\tif len(s) >= 2 {