{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DxKd7A8wNLTvEmtMPyCuTD","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd036-mktemp R1.1, R1.2, R1.3, R1.4, R1.5, R2.1, R2.2, R2.3,\n5\t// R3.1, R3.2, R3.3, R3.4, R3.5, R3.6.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"crypto/rand\"\n10\t\t\"errors\"\n11\t\t\"fmt\"\n12\t\t\"math/big\"\n13\t\t\"os\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tvar errQuiet = errors.New(\"\")\n20\t\n21\tconst defaultTemplate = \"tmp.XXXXXXXXXX\"\n22\tconst charset = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\"\n23\t\n24\ttype options struct {\n25\t\tdirectory bool\n26\t\tparentDir string\n27\t\tuseTmpdir bool\n28\t\tsuffix    string\n29\t\tdryRun    bool\n30\t\tquiet     bool\n31\t}\n32\t\n33\tfunc main() {\n34\t\tsys.InstallSIGPIPEHandler()\n35\t\n36\t\topts, template, useDefaultDir, err := parseArgs(os.Args[1:])\n37\t\tif err != nil {\n38\t\t\tfmt.Fprintf(os.Stderr, \"mktemp: %s\\n\", err)\n39\t\t\tfmt.Fprintf(os.Stderr, \"Try 'mktemp --help' for more information.\\n\")\n40\t\t\tos.Exit(1)\n41\t\t}\n42\t\n43\t\tif err := run(opts, template, useDefaultDir); err != nil {\n44\t\t\tif err != errQuiet {\n45\t\t\t\tfmt.Fprintf(os.Stderr, \"mktemp: %s\\n\", err)\n46\t\t\t}\n47\t\t\tos.Exit(1)\n48\t\t}\n49\t}\n50\t\n51\tfunc parseArgs(args []string) (options, string, bool, error) {\n52\t\tvar opts options\n53\t\tvar templates []string\n54\t\n55\t\ti := 0\n56\t\tfor i < len(args) {\n57\t\t\targ := args[i]\n58\t\t\tif arg == \"--\" {\n59\t\t\t\ttemplates = append(templates, args[i+1:]...)\n60\t\t\t\tbreak\n61\t\t\t}\n62\t\t\tif strings.HasPrefix(arg, \"--\") {\n63\t\t\t\tconsumed, err := parseLongFlag(arg, args[i+1:], &opts)\n64\t\t\t\tif err != nil {\n65\t\t\t\t\treturn opts, \"\", false, err\n66\t\t\t\t}\n67\t\t\t\ti += consumed\n68\t\t\t\tcontinue\n69\t\t\t}\n70\t\t\tif len(arg) > 1 && arg[0] == '-' {\n71\t\t\t\tconsumed, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n72\t\t\t\tif err != nil {\n73\t\t\t\t\treturn opts, \"\", false, err\n74\t\t\t\t}\n75\t\t\t\ti += 1 + consumed\n76\t\t\t\tcontinue\n77\t\t\t}\n78\t\t\ttemplates = append(templates, arg)\n79\t\t\ti++\n80\t\t}\n81\t\n82\t\tswitch len(templates) {\n83\t\tcase 0:\n84\t\t\treturn opts, defaultTemplate, true, nil\n85\t\tcase 1:\n86\t\t\treturn opts, templates[0], false, nil\n87\t\tdefault:\n88\t\t\treturn opts, \"\", false, fmt.Errorf(\"too many templates\")\n89\t\t}\n90\t}\n91\t\n92\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n93\t\tswitch {\n94\t\tcase flag == \"--directory\":\n95\t\t\topts.directory = true\n96\t\t\treturn 1, nil\n97\t\tcase flag == \"--dry-run\":\n98\t\t\topts.dryRun = true\n99\t\t\treturn 1, nil\n100\t\tcase flag == \"--quiet\":\n101\t\t\topts.quiet = true\n102\t\t\treturn 1, nil\n103\t\tcase flag == \"--tmpdir\":\n104\t\t\topts.useTmpdir = true\n105\t\t\treturn 1, nil\n106\t\tcase strings.HasPrefix(flag, \"--tmpdir=\"):\n107\t\t\topts.parentDir = flag[len(\"--tmpdir=\"):]\n108\t\t\treturn 1, nil\n109\t\tcase flag == \"--suffix\":\n110\t\t\tif len(remaining) == 0 {\n111\t\t\t\treturn 0, fmt.Errorf(\"option '--suffix' requires an argument\")\n112\t\t\t}\n113\t\t\topts.suffix = remaining[0]\n114\t\t\treturn 2, nil\n115\t\tcase strings.HasPrefix(flag, \"--suffix=\"):\n116\t\t\topts.suffix = flag[len(\"--suffix=\"):]\n117\t\t\treturn 1, nil\n118\t\tdefault:\n119\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n120\t\t}\n121\t}\n122\t\n123\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n124\t\tconsumed := 0\n125\t\tfor j := range len(flags) {\n126\t\t\tswitch flags[j] {\n127\t\t\tcase 'd':\n128\t\t\t\topts.directory = true\n129\t\t\tcase 'u':\n130\t\t\t\topts.dryRun = true\n131\t\t\tcase 'q':\n132\t\t\t\topts.quiet = true\n133\t\t\tcase 't':\n134\t\t\t\topts.useTmpdir = true\n135\t\t\tcase 'p':\n136\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n137\t\t\t\t\topts.parentDir = rest\n138\t\t\t\t} else if len(remaining) > consumed {\n139\t\t\t\t\topts.parentDir = remaining[consumed]\n140\t\t\t\t\tconsumed++\n141\t\t\t\t} else {\n142\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'p'\")\n143\t\t\t\t}\n144\t\t\t\treturn consumed, nil\n145\t\t\tdefault:\n146\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n147\t\t\t}\n148\t\t}\n149\t\treturn consumed, nil\n150\t}\n151\t\n152\tfunc run(opts options, template string, useDefaultDir bool) error {\n153\t\tif opts.suffix != \"\" && strings.Contains(opts.suffix, \"/\") {\n154\t\t\treturn fmt.Errorf(\"invalid suffix '%s', contains directory separator\", opts.suffix)\n155\t\t}\n156\t\n157\t\tfullTemplate := resolveTemplate(opts, template, useDefaultDir)\n158\t\n159\t\txCount := countTrailingX(fullTemplate)\n160\t\tif xCount < 3 {\n161\t\t\treturn fmt.Errorf(\"too few X's in template '%s'\", fullTemplate)\n162\t\t}\n163\t\n164\t\tprefix := fullTemplate[:len(fullTemplate)-xCount]\n165\t\n166\t\tif opts.dryRun {\n167\t\t\tsuffix, err := randomString(xCount)\n168\t\t\tif err != nil {\n169\t\t\t\treturn err\n170\t\t\t}\n171\t\t\tpath := prefix + suffix + opts.suffix\n172\t\t\tfmt.Println(path)\n173\t\t\tfmt.Fprintln(os.Stderr, \"mktemp: warning: --dry-run is discouraged\")\n174\t\t\treturn nil\n175\t\t}\n176\t\n177\t\tfor range 100 {\n178\t\t\tsuffix, err := randomString(xCount)\n179\t\t\tif err != nil {\n180\t\t\t\treturn err\n181\t\t\t}\n182\t\t\tpath := prefix + suffix + opts.suffix\n183\t\t\tif opts.directory {\n184\t\t\t\terr = os.Mkdir(path, 0o700)\n185\t\t\t} else {\n186\t\t\t\tvar fd *os.File\n187\t\t\t\tfd, err = os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)\n188\t\t\t\tif err == nil {\n189\t\t\t\t\tfd.Close()\n190\t\t\t\t}\n191\t\t\t}\n192\t\t\tif err != nil {\n193\t\t\t\tif os.IsExist(err) {\n194\t\t\t\t\tcontinue\n195\t\t\t\t}\n196\t\t\t\tif opts.quiet {\n197\t\t\t\t\treturn errQuiet\n198\t\t\t\t}\n199\t\t\t\treturn fmt.Errorf(\"failed to create %s via template '%s': %s\",\n200\t\t\t\t\tentityKind(opts.directory), fullTemplate, unwrapErr(err))\n201\t\t\t}\n202\t\t\tfmt.Println(path)\n203\t\t\treturn nil\n204\t\t}\n205\t\n206\t\tif opts.quiet {\n207\t\t\treturn errQuiet\n208\t\t}\n209\t\treturn fmt.Errorf(\"failed to create %s via template '%s': too many collisions\",\n210\t\t\tentityKind(opts.directory), fullTemplate)\n211\t}\n212\t\n213\tfunc resolveTemplate(opts options, template string, useDefaultDir bool) string {\n214\t\tif opts.parentDir != \"\" {\n215\t\t\treturn opts.parentDir + \"/\" + template\n216\t\t}\n217\t\tif useDefaultDir || opts.useTmpdir {\n218\t\t\tdir := os.Getenv(\"TMPDIR\")\n219\t\t\tif dir == \"\" {\n220\t\t\t\tdir = \"/tmp\"\n221\t\t\t}\n222\t\t\treturn dir + \"/\" + template\n223\t\t}\n224\t\treturn template\n225\t}\n226\t\n227\tfunc entityKind(isDir bool) string {\n228\t\tif isDir {\n229\t\t\treturn \"directory\"\n230\t\t}\n231\t\treturn \"file\"\n232\t}\n233\t\n234\tfunc countTrailingX(s string) int {\n235\t\tcount := 0\n236\t\tfor i := len(s) - 1; i >= 0; i-- {\n237\t\t\tif s[i] != 'X' {\n238\t\t\t\tbreak\n239\t\t\t}\n240\t\t\tcount++\n241\t\t}\n242\t\treturn count\n243\t}\n244\t\n245\tfunc randomString(n int) (string, error) {\n246\t\tb := make([]byte, n)\n247\t\tmax := big.NewInt(int64(len(charset)))\n248\t\tfor i := range b {\n249\t\t\tidx, err := rand.Int(rand.Reader, max)\n250\t\t\tif err != nil {\n251\t\t\t\treturn \"\", err\n252\t\t\t}\n253\t\t\tb[i] = charset[idx.Int64()]\n254\t\t}\n255\t\treturn string(b), nil\n256\t}\n257\t\n258\tfunc unwrapErr(err error) string {\n259\t\tpe, ok := err.(*os.PathError)\n260\t\tif !ok {\n261\t\t\treturn err.Error()\n262\t\t}\n263\t\treturn pe.Err.Error()\n264\t}\n265\t"}]},"parent_tool_use_id":null,"session_id":"edf60472-4efc-4511-8c9a-36f71bb61d1e","uuid":"4fe7d0a2-4db0-4cf4-9e2f-e6a787454fe6",