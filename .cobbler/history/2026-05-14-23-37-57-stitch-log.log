\t\t}\n197\t\treturn 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n198\t}\n199\t\n200\tfunc processFile(path string, opts options, state *nlState, w *bufio.Writer) error {\n201\t\tvar r io.Reader\n202\t\tif path == \"-\" {\n203\t\t\tr = os.Stdin\n204\t\t} else {\n205\t\t\tf, err := os.Open(path)\n206\t\t\tif err != nil {\n207\t\t\t\treturn err\n208\t\t\t}\n209\t\t\tdefer f.Close()\n210\t\t\tr = f\n211\t\t}\n212\t\treturn processInput(r, opts, state, w)\n213\t}\n214\t\n215\tfunc sectionStyle(section string, opts options) string {\n216\t\tswitch section {\n217\t\tcase \"header\":\n218\t\t\treturn opts.headerStyle\n219\t\tcase \"footer\":\n220\t\t\treturn opts.footerStyle\n221\t\tdefault:\n222\t\t\treturn opts.bodyStyle\n223\t\t}\n224\t}\n225\t\n226\tfunc shouldNumber(style string, line string, blankCount int, joinBlankCount int) bool {\n227\t\tempty := line == \"\"\n228\t\tswitch {\n229\t\tcase style == \"a\":\n230\t\t\tif !empty {\n231\t\t\t\treturn true\n232\t\t\t}\n233\t\t\treturn blankCount >= joinBlankCount\n234\t\tcase style == \"t\":\n235\t\t\treturn !empty\n236\t\tcase style == \"n\":\n237\t\t\treturn false\n238\t\tcase strings.HasPrefix(style, \"p\"):\n239\t\t\tif empty {\n240\t\t\t\treturn false\n241\t\t\t}\n242\t\t\tre, err := regexp.Compile(style[1:])\n243\t\t\tif err != nil {\n244\t\t\t\treturn false\n245\t\t\t}\n246\t\t\treturn re.MatchString(line)\n247\t\t}\n248\t\treturn false\n249\t}\n250\t\n251\tfunc formatNumber(num int, width int, format string) string {\n252\t\tswitch format {\n253\t\tcase \"ln\":\n254\t\t\treturn fmt.Sprintf(\"%-*d\", width, num)\n255\t\tcase \"rz\":\n256\t\t\treturn fmt.Sprintf(\"%0*d\", width, num)\n257\t\tdefault:\n258\t\t\treturn fmt.Sprintf(\"%*d\", width, num)\n259\t\t}\n260\t}\n261\t\n262\tfunc processInput(r io.Reader, opts options, state *nlState, w *bufio.Writer) error {\n263\t\tscanner := bufio.NewScanner(r)\n264\t\n265\t\theaderDelim := opts.delimiter + opts.delimiter + opts.delimiter\n266\t\tbodyDelim