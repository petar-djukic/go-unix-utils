{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Hof3kXDyFMomYLpNu2rzA7","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd023-fold R1.1-R1.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"syscall\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tfunc main() {\n20\t\tsys.InstallSIGPIPEHandler()\n21\t\tos.Exit(run(os.Args[1:]))\n22\t}\n23\t\n24\ttype options struct {\n25\t\twidth     int\n26\t\tbyteMode  bool\n27\t\tspaceMode bool\n28\t}\n29\t\n30\tfunc defaultOptions() options {\n31\t\treturn options{\n32\t\t\twidth: 80,\n33\t\t}\n34\t}\n35\t\n36\tfunc run(args []string) int {\n37\t\topts, files, err := parseArgs(args)\n38\t\tif err != nil {\n39\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n40\t\t\treturn 1\n41\t\t}\n42\t\tif len(files) == 0 {\n43\t\t\tfiles = []string{\"-\"}\n44\t\t}\n45\t\tw := bufio.NewWriter(os.Stdout)\n46\t\texitCode := 0\n47\t\tfor _, f := range files {\n48\t\t\tif err := processFile(f, opts, w); err != nil {\n49\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n50\t\t\t\t\tos.Exit(0)\n51\t\t\t\t}\n52\t\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n53\t\t\t\texitCode = 1\n54\t\t\t}\n55\t\t}\n56\t\tif err := w.Flush(); err != nil {\n57\t\t\tif errors.Is(err, syscall.EPIPE) {\n58\t\t\t\tos.Exit(0)\n59\t\t\t}\n60\t\t\tfmt.Fprintf(os.Stderr, \"fold: %s\\n\", err)\n61\t\t\texitCode = 1\n62\t\t}\n63\t\treturn exitCode\n64\t}\n65\t\n66\tfunc parseArgs(args []string) (options, []string, error) {\n67\t\topts := defaultOptions()\n68\t\tvar files []string\n69\t\ti := 0\n70\t\tfor i < len(args) {\n71\t\t\targ := args[i]\n72\t\t\tif arg == \"--\" {\n73\t\t\t\tfiles = append(files, args[i+1:]...)\n74\t\t\t\tbreak\n75\t\t\t}\n76\t\t\tif arg == \"-\" {\n77\t\t\t\tfiles = append(files, arg)\n78\t\t\t\ti++\n79\t\t\t\tcontinue\n80\t\t\t}\n81\t\t\tif len(arg) > 1 && arg[0] == '-' {\n82\t\t\t\tconsumed, err := parseFlag(arg, args[i+1:], &opts)\n83\t\t\t\tif err != nil {\n84\t\t\t\t\treturn opts, nil, err\n85\t\t\t\t}\n86\t\t\t\ti += 1 + consumed\n87\t\t\t\tcontinue\n88\t\t\t}\n89\t\t\tfiles = append(files, arg)\n90\t\t\ti++\n91\t\t}\n92\t\treturn opts, files, nil\n93\t}\n94\t\n95\tfunc parseFlag(arg string, remaining []string, opts *options) (int, error) {\n96\t\tflag := arg[1:]\n97\t\tswitch {\n98\t\tcase flag == \"b\":\n99\t\t\topts.byteMode = true\n100\t\t\treturn 0, nil\n101\t\tcase flag == \"s\":\n102\t\t\topts.spaceMode = true\n103\t\t\treturn 0, nil\n104\t\tcase flag == \"bs\" || flag == \"sb\":\n105\t\t\topts.byteMode = true\n106\t\t\topts.spaceMode = true\n107\t\t\treturn 0, nil\n108\t\tcase len(flag) > 1 && flag[0] == 'w':\n109\t\t\treturn setWidth(flag[1:], nil, opts)\n110\t\tcase flag == \"w\":\n111\t\t\treturn setWidth(\"\", remaining, opts)\n112\t\tdefault:\n113\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%s'\", flag)\n114\t\t}\n115\t}\n116\t\n117\tfunc setWidth(val string, remaining []string, opts *options) (int, error) {\n118\t\tif val == \"\" {\n119\t\t\tif len(remaining) > 0 {\n120\t\t\t\tval = remaining[0]\n121\t\t\t} else {\n122\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'w'\")\n123\t\t\t}\n124\t\t\tn, err := strconv.Atoi(val)\n125\t\t\tif err != nil || n <= 0 {\n126\t\t\t\treturn 0, fmt.Errorf(\"invalid number of columns: '%s'\", val)\n127\t\t\t}\n128\t\t\topts.width = n\n129\t\t\treturn 1, nil\n130\t\t}\n131\t\tn, err := strconv.Atoi(val)\n132\t\tif err != nil || n <= 0 {\n133\t\t\treturn 0, fmt.Errorf(\"invalid number of columns: '%s'\", val)\n134\t\t}\n135\t\topts.width = n\n136\t\treturn 0, nil\n137\t}\n138\t\n139\tfunc processFile(path string, opts options, w *bufio.Writer) error {\n140\t\tvar r io.Reader\n141\t\tif path == \"-\" {\n142\t\t\tr = os.Stdin\n143\t\t} else {\n144\t\t\tf, err := os.Open(path)\n145\t\t\tif err != 