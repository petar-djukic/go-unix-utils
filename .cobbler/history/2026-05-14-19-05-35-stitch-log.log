\tt.Fatal(err)\n267\t\t\t}\n268\t\t\tmt := base.Add(time.Duration(i) * time.Hour)\n269\t\t\tif err := os.Chtimes(p, mt, mt); err != nil {\n270\t\t\t\tt.Fatal(err)\n271\t\t\t}\n272\t\t}\n273\t\treturn dir\n274\t}\n275\t\n276\tfunc setupHumanSizeDir(t *testing.T) string {\n277\t\tt.Helper()\n278\t\tdir := t.TempDir()\n279\t\tfor _, f := range []struct {\n280\t\t\tname string\n281\t\t\tsize int\n282\t\t}{\n283\t\t\t{\"big\", 10240},\n284\t\t\t{\"medium\", 2048},\n285\t\t\t{\"tiny\", 10},\n286\t\t} {\n287\t\t\tp := filepath.Join(dir, f.name)\n288\t\t\tif err := os.WriteFile(p, make([]byte, f.size), 0644); err != nil {\n289\t\t\t\tt.Fatal(err)\n290\t\t\t}\n291\t\t}\n292\t\treturn dir\n293\t}\n294\t\n295\tfunc setupSizeSortDir(t *testing.T) string {\n296\t\tt.Helper()\n297\t\tdir := t.TempDir()\n298\t\tfor _, f := range []struct {\n299\t\t\tname string\n300\t\t\tsize int\n301\t\t}{\n302\t\t\t{\"large\", 300}, {\"medium\", 200}, {\"small\", 100},\n303\t\t} {\n304\t\t\tp := filepath.Join(dir, f.name)\n305\t\t\tif err := os.WriteFile(p, make([]byte, f.size), 0644); err != nil {\n306\t\t\t\tt.Fatal(err)\n307\t\t\t}\n308\t\t}\n309\t\treturn dir\n310\t}\n311\t\n312\tfunc setupClassifyDir(t *testing.T) string {\n313\t\tt.Helper()\n314\t\tdir := t.TempDir()\n315\t\tif err := os.WriteFile(filepath.Join(dir, \"regular\"), nil, 0644); err != nil {\n316\t\t\tt.Fatal(err)\n317\t\t}\n318\t\tif err := os.WriteFile(filepath.Join(dir, \"executable\"), nil, 0755); err != nil {\n319\t\t\tt.Fatal(err)\n320\t\t}\n321\t\tif err := os.Mkdir(filepath.Join(dir, \"subdir\"), 0755); err != nil {\n322\t\t\tt.Fatal(err)\n323\t\t}\n324\t\tif err := os.Symlink(\"regular\", filepath.Join(dir, \"symlink\")); err != nil {\n325\t\t\tt.Fatal(err)\n326\t\t}\n327\t\tif err := syscall.Mkfifo(filepath.Join(dir, \"pipe\"), 0644); err != nil {\n328\t\t\tt.Fatal(err)\n329\t\t}\n330\t\treturn dir\n331\t}\n332\t\n333\tfunc setupRecursiveDir(t *testing.T) string {\n334\t\tt.Helper()\n335\t\tdir := t.TempDir()\n336\t\tif err := os.WriteFile(filepath.Join(dir, \"file1\"), nil, 0644); err != nil {\n337\t\t\tt.Fatal(err)\n338\t\t}\n339\t\tsub := filepath.Join(dir, \"subdir\")\n340\t\tif err := os.Mkdir(sub, 0755); err != nil {\n341\t\t\tt.Fatal(err)\n342\t\t}\n343\t\tif err := os.WriteFile(filepath.Join(sub, \"file2\"), nil, 0644); err != nil {\n344\t\t\tt.Fatal(err)\n345\t\t}\n346\t\tif err := os.WriteFile(filepath.Join(sub, \".hidden\"), nil, 0644); err != nil {\n347\t\t\tt.Fatal(err)\n348\t\t}\n349\t\tnested := filepath.Join(sub, \"nested\")\n350\t\tif err := os.Mkdir(nested, 0755); err != nil {\n351\t\t\tt.Fatal(err)\n352\t\t}\n353\t\tif err := os.WriteFile(filepath.Join(nested, \"file3\"), nil, 0644); err != nil {\n354\t\t\tt.Fatal(err)\n355\t\t}\n356\t\treturn dir\n357\t}\n358\t\n359\tfunc setupRecursiveSymlinkDir(t *testing.T) string {\n360\t\tt.Helper()\n361\t\tdir := t.TempDir()\n362\t\tif err := os.WriteFile(filepath.Join(dir, \"file1\"), nil, 0644); err != nil {\n363\t\t\tt.Fatal(err)\n364\t\t}\n365\t\treal := filepath.Join(dir, \"realdir\")\n366\t\tif err := os.Mkdir(real, 0755); err != nil {\n367\t\t\tt.Fatal(err)\n368\t\t}\n369\t\tif err := os.WriteFile(filepath.Join(real, \"file2\"), nil, 0644); err != nil {\n370\t\t\tt.Fatal(err)\n371\t\t}\n372\t\tif err := os.Symlink(\"realdir\", filepath.Join(dir, \"linkdir\")); err != nil {\n373\t\t\tt.Fatal(err)\n374\t\t}\n375\t\treturn dir\n376\t}\n377\t\n378\tfunc setupRecursiveTimeSortDir(t *testing.T) string {\n379\t\tt.Helper()\n380\t\tdir := t.TempDir()\n381\t\tbase := time.Date(2025, 6, 1, 12, 0, 0, 0, time.UTC)\n382\t\tfor i, name := range []string{\"alpha\", \"beta\"} {\n383\t\t\tsub := filepath.Join(dir, name)\n384\t\t\tif err := os.Mkdir(sub, 0755); err != nil {\n385\t\t\t\tt.Fatal(err)\n386\t\t\t}\n387\t\t\tmt := base.Add(time.Duration(i) * time.Hour)\n388\t\t\tif err := os.Chtimes(sub, mt, mt); err != nil {\n389\t\t\t\tt.Fatal(err)\n390\t\t\t}\n391\t\t\tif err := os.WriteFile(filepath.Join(sub, \"child\"), nil, 0644