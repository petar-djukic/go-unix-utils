{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01323QTHbPQHVubaBkxi211j","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd008-ls R1.1-R1.14, R2.1-R2.15, R3.1-R3.15, R4.1-R4.8.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\t\"unicode/utf8\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n21\t)\n22\t\n23\tconst helpText = `Usage: ls [OPTION]... [FILE]...\n24\tList information about the FILEs (the current directory by default).\n25\tSort entries alphabetically if no flags given.\n26\t\n27\t  -a             do not ignore entries starting with .\n28\t  -A             do not list implied . and ..\n29\t  -C             list entries by columns\n30\t  -d             list directories themselves, not their contents\n31\t  -F             append indicator (one of */=>@|) to entries\n32\t  -h             with -l and/or -s, print human readable sizes\n33\t  -i             print the index number of each file\n34\t  -l             use a long listing format\n35\t  -n             like -l, but list numeric user and group IDs\n36\t  -R             list subdirectories recursively\n37\t  -r             reverse order while sorting\n38\t  -s             print the allocated size of each file, in blocks\n39\t  -S             sort by file size, largest first\n40\t  -t             sort by modification time, newest first\n41\t  -U             do not sort; list entries in directory order\n42\t  -v             natural sort of (version) numbers within text\n43\t  -x             list entries by lines instead of by columns\n44\t  -1             list one file per line\n45\t      --color[=WHEN]  colorize the output; WHEN can be 'always'\n46\t                         (default if omitted), 'auto', or 'never'\n47\t      --help     display this help and exit\n48\t      --version  output version information and exit\n49\t`\n50\t\n51\tconst versionText = `ls (go-unix-utils) dev\n52\t`\n53\t\n54\ttype options struct {\n55\t\tsingleColumn  bool\n56\t\tlongFormat    bool\n57\t\tforceColumns  bool\n58\t\thorizontalSort bool\n59\t\tshowAll       bool\n60\t\tshowAlmostAll bool\n61\t\tdirAsEntry    bool\n62\t\tsortByTime    bool\n63\t\tsortBySize    bool\n64\t\treverseSort   bool\n65\t\tunsorted      bool\n66\t\tversionSort   bool\n67\t\tshowInode     bool\n68\t\tshowBlocks    bool\n69\t\tnumericIds    bool\n70\t\thumanReadable bool\n71\t\tclassify      bool\n72\t\trecursive     bool\n73\t\tcolorMode     string\n74\t}\n75\t\n76\tvar termWidth int\n77\t\n78\tfunc main() {\n79\t\tsys.InstallSIGPIPEHandler()\n80\t\ttermWidth = queryTermWidth()\n81\t\tsys.OnTerminalResize(func(w int) { termWidth = w })\n82\t\topts, paths := parseArgs(os.Args[1:])\n83\t\tif len(paths) == 0 {\n84\t\t\tpaths = []string{\".\"}\n85\t\t}\n86\t\tos.Exit(run(paths, opts))\n87\t}\n88\t\n89\tfunc queryTermWidth() int {\n90\t\tw, err := sys.TerminalWidth()\n91\t\tif err != nil {\n92\t\t\treturn 80\n93\t\t}\n94\t\treturn w\n95\t}\n96\t\n97\tfunc parseArgs(args []string) (options, []string) {\n98\t\tvar opts options\n99\t\tvar paths []string\n100\t\tfor len(args) > 0 {\n101\t\t\targ := args[0]\n102\t\t\targs = args[1:]\n103\t\t\tswitch {\n104\t\t\tcase arg == \"--help\":\n105\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n106\t\t\t\tos.Exit(0)\n107\t\t\tcase arg == \"--version\":\n108\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n109\t\t\t\tos.Exit(0)\n110\t\t\tcase arg == \"--\":\n111\t\t\t\treturn opts, append(paths, args...)\n112\t\t\tcase arg == \"--color\":\n113\t\t\t\topts.colorMode = \"always\"\n114\t\t\tcase strings.HasPrefix(arg, \"--color=\"):\n115\t\t\t\topts.colorMode = parseColorValue(arg)\n116\t\t\tcase strings.HasPrefix(arg, \"--\"):\n117\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n118\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n119\t\t\t\tos.Exit(2)\n120\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n121\t\t\t\tparseShortFlags(arg[1:], &opts)\n122\t\t\tdefault:\n123\t\t\t\tpaths = append(paths, arg)\n124\t\t\t}\n125\t\t}\n126\t\treturn opts, paths\n127\t}\n128\t\n129\tfunc parseShortFlags(flags string, opts *options) {\n130\t\tfor _, ch := range flags {\n131\t\t\tswitch ch {\n132\t\t\tcase '1':\n133\t\t\t\topts.forceColumns = false\n134\t\t\t\topts.horizontalSort = false\n135\t\t\t\tif !opts.longFormat {\n136\t\t\t\t\topts.singleColumn = true\n137\t\t\t\t}\n138\t\t\tcase 'l':\n139\t\t\t\topts.longFormat = true\n140\t\t\t\topts.singleColumn = false\n141\t\t\t\topts.forceColumns = false\n142\t\t\t\topts.horizontalSort = false\n143\t\t\tcase 'C':\n144\t\t\t\topts.forceColumns = true\n145\t\t\t\topts.horizontalSort = false\n146\t\t\t\topts.longFormat = false\n147\t\t\t\topts.singleColumn = false\n148\t\t\tcase 'x':\n149\t\t\t\topts.forceColumns = true\n150\t\t\t\topts.horizontalSort = true\n151\t\t\t\topts.longFormat = false\n152\t\t\t\topts.singleColumn = false\n153\t\t\tcase 'a':\n154\t\t\t\topts.showAll = true\n155\t\t\t\topts.showAlmostAll = false\n156\t\t\tcase 'A':\n157\t\t\t\topts.showAlmostAll = true\n158\t\t\t\topts.showAll = false\n159\t\t\tcase 'd':\n160\t\t\t\topts.dirAsEntry = true\n161\t\t\tcase 'F':\n162\t\t\t\topts.classify = true\n163\t\t\tcase 'h':\n164\t\t\t\topts.humanReadable = true\n165\t\t\tcase 'i':\n166\t\t\t\topts.showInode = true\n167\t\t\tcase 'n':\n168\t\t\t\topts.numericIds = true\n169\t\t\t\topts.longFormat = true\n170\t\t\t\topts.singleColumn = false\n171\t\t\t\topts.forceColumns = false\n172\t\t\t\topts.horizontalSort = false\n173\t\t\tcase 'R':\n174\t\t\t\topts.recursive = true\n175\t\t\tcase 'r':\n176\t\t\t\topts.reverseSort = true\n177\t\t\tcase 's':\n178\t\t\t\topts.showBlocks = true\n179\t\t\tcase 't':\n180\t\t\t\topts.sortByTime = true\n181\t\t\t\topts.sortBySize = false\n182\t\t\t\topts.unsorted = false\n183\t\t\t\topts.versionSort = false\n184\t\t\tcase 'S':\n185\t\t\t\topts.sortBySize = true\n186\t\t\t\topts.sortByTime = false\n187\t\t\t\topts.unsorted = false\n188\t\t\t\topts.versionSort = false\n189\t\t\tcase 'U':\n190\t\t\t\topts.unsorted = true\n191\t\t\t\topts.sortByTime = false\n192\t\t\t\topts.sortBySize = false\n193\t\t\t\topts.versionSort = false\n194\t\t\tcase 'v':\n195\t\t\t\topts.versionSort = true\n196\t\t\t\topts.sortByTime = false\n197\t\t\t\topts.sortBySize = false\n198\t\t\t\topts.unsorted = false\n199\t\t\tdefault:\n200\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n201\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n202\t\t\t\tos.Exit(2)\n203\t\t\t}\n204\t\t}\n205\t}\n206\t\n207\tfunc parseColorValue(arg string) string {\n208\t\tval := arg[len(\"--color=\"):]\n209\t\tswitch val {\n210\t\tcase \"always\", \"auto\", \"never\":\n211\t\t\treturn val\n212\t\tdefault:\n213\t\t\tfmt.Fprintf(os.Stderr,\n214\t\t\t\t\"ls: invalid argument '%s' for '--color'\\n\", val)\n215\t\t\tfmt.Fprintln(os.Stderr,\n216\t\t\t\t\"Try 'ls --help' for more information.\")\n217\t\t\tos.Exit(2)\n218\t\t\treturn \"\"\n219\t\t}\n220\t}\n221\t\n222\tfunc setupColor(opts options) {\n223\t\tswitch opts.colorMode {\n224\t\tcase \"always\":\n225\t\t\tformat.SetColorEnabled(true)\n226\t\tcase \"auto\":\n227\t\t\tformat.SetColorEnabled(sys.IsTerminal(os.Stdout.Fd()))\n228\t\tdefault:\n229\t\t\tformat.SetColorEnabled(false)\n230\t\t}\n231\t}\n232\t\n233\tfunc run(paths []string, opts options) int {\n234\t\tsetupColor(opts)\n235\t\texitCode := 0\n236\t\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n237\t\tneedSep := false\n238\t\tif len(files) > 0 {\n239\t\t\tsortEntries(files, \"\", opts)\n240\t\t\tif opts.longFormat {\n241\t\t\t\texitCode = maxCode(exitCode, writeLongFiles(files, opts))\n242\t\t\t} else {\n243\t\t\t\tdisplay := buildDisplayNames(files, \"\", opts)\n244\t\t\t\twriteEntries(display, opts)\n245\t\t\t}\n246\t\t\tneedSep = true\n247\t\t}\n248\t\tshowHeader := len(dirs) > 1 || len(files) > 0 || opts.recursive\n249\t\tsortEntries(dirs, \"\", opts)\n250\t\tfor _, dir := range dirs {\n251\t\t\tif needSep {\n252\t\t\t\tfmt.Fprintln(os.Stdout)\n253\t\t\t}\n254\t\t\tif showHeader {\n255\t\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n256\t\t\t}\n257\t\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n258\t\t\tneedSep = true\n259\t\t}\n260\t\treturn exitCode\n261\t}\n262\t\n263\tfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n264\t\tvar files, dirs []string\n265\t\tfor _, p := range paths {\n266\t\t\tinfo, err := os.Lstat(p)\n267\t\t\tif err != nil {\n268\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n269\t\t\t\t*exitCode = 1\n270\t\t\t\tcontinue\n271\t\t\t}\n272\t\t\tif info.IsDir() && !dirAsEntry {\n273\t\t\t\tdirs = append(dirs, p)\n274\t\t\t} else {\n275\t\t\t\tfiles = append(files, p)\n276\t\t\t}\n277\t\t}\n278\t\treturn files, dirs\n279\t}\n280\t\n281\tfunc maxCode(a, b int) int {\n282\t\tif a > b {\n283\t\t\treturn a\n284\t\t}\n285\t\treturn b\n286\t}\n287\t\n288\tfunc listDir(path string, opts options) int {\n289\t\tnames, err := readNames(path, opts)\n290\t\tif err != nil {\n291\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n292\t\t\t\tpath, sysError(err))\n293\t\t\treturn 1\n294\t\t}\n295\t\tcode := 0\n296\t\tif opts.longFormat {\n297\t\t\tcode = writeLongDir(path, names, opts)\n298\t\t} else {\n299\t\t\tif opts.showBlocks {\n300\t\t\t\twriteTotalLine(path, names, opts)\n301\t\t\t}\n302\t\t\tdisplay := buildDisplayNames(names, path, opts)\n303\t\t\twriteEntries(display, opts)\n304\t\t}\n305\t\tif opts.recursive {\n306\t\t\tcode = maxCode(code, recurseSubdirs(path, names, opts))\n307\t\t}\n308\t\treturn code\n309\t}\n310\t\n311\tfunc recurseSubdirs(path string, names []string, opts options) int {\n312\t\tcode := 0\n313\t\tfor _, name := range names {\n314\t\t\tif name == \".\" || name == \"..\" {\n315\t\t\t\tcontinue\n316\t\t\t}\n317\t\t\tfull := filepath.Join(path, name)\n318\t\t\tfi, err := os.Lstat(full)\n319\t\t\tif err != nil || !fi.IsDir() {\n320\t\t\t\tcontinue\n321\t\t\t}\n322\t\t\tfmt.Fprintln(os.Stdout)\n323\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", full)\n324\t\t\tcode = maxCode(code, listDir(full, opts))\n325\t\t}\n326\t\treturn code\n327\t}\n328\t\n329\tfunc readNames(path string, opts options) ([]string, error) {\n330\t\tentries, err := os.ReadDir(path)\n331\t\tif err != nil {\n332\t\t\treturn nil, err\n333\t\t}\n334\t\tnames := make([]string, 0, len(entries))\n335\t\tif opts.showAll {\n336\t\t\tnames = append(names, \".\", \"..\")\n337\t\t}\n338\t\tfor _, e := range entries {\n339\t\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n340\t\t\t\tcontinue\n341\t\t\t}\n342\t\t\tnames = append(names, e.Name())\n343\t\t}\n344\t\tsortEntries(names, path, opts)\n345\t\treturn names, nil\n346\t}\n347\t\n348\tfunc sortEntries(names []string, basePath string, opts options) {\n349\t\tif opts.unsorted {\n350\t\t\treturn\n351\t\t}\n352\t\tif opts.versionSort {\n353\t\t\tsort.SliceStable(names, func(i, j int) bool {\n354\t\t\t\treturn strverscmp(names[i], names[j]) < 0\n355\t\t\t})\n356\t\t\tif opts.reverseSort {\n357\t\t\t\treverseSlice(names)\n358\t\t\t}\n359\t\t\treturn\n360\t\t}\n361\t\tif !opts.sortByTime && !opts.sortBySize {\n362\t\t\tsort.Strings(names)\n363\t\t\tif opts.reverseSort {\n364\t\t\t\treverseSlice(names)\n365\t\t\t}\n366\t\t\treturn\n367\t\t}\n368\t\ttype entry struct {\n369\t\t\tname    string\n370\t\t\tmodTime time.Time\n371\t\t\tsize    int64\n372\t\t}\n373\t\tentries := make([]entry, len(names))\n374\t\tfor i, name := range names {\n375\t\t\tentries[i].name = name\n376\t\t\tp := name\n377\t\t\tif basePath != \"\" {\n378\t\t\t\tp = filepath.Join(basePath, name)\n379\t\t\t}\n380\t\t\tif fi, err := sys.Lstat(p); err == nil {\n381\t\t\t\tentries[i].modTime = fi.ModTime\n382\t\t\t\tentries[i].size = fi.Size\n383\t\t\t}\n384\t\t}\n385\t\tsort.SliceStable(entries, func(i, j int) bool {\n386\t\t\tif opts.sortByTime {\n387\t\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n388\t\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n389\t\t\t\t}\n390\t\t\t\treturn entries[i].name < entries[j].name\n391\t\t\t}\n392\t\t\tif entries[i].size != entries[j].size {\n393\t\t\t\treturn entries[i].size > entries[j].size\n394\t\t\t}\n395\t\t\treturn entries[i].name < entries[j].name\n396\t\t})\n397\t\tfor i, e := range entries {\n398\t\t\tnames[i] = e.name\n399\t\t}\n400\t\tif opts.reverseSort {\n401\t\t\treverseSlice(names)\n402\t\t}\n403\t}\n404\t\n405\ttype entryInfo struct {\n406\t\tinode  uint64\n407\t\tblocks int64\n408\t\tmode   os.FileMode\n409\t}\n410\t\n411\tfunc statDisplayEntries(names []string, basePath string, opts options) ([]entryInfo, int, int) {\n412\t\tinfos := make([]entryInfo, len(names))\n413\t\tvar inodeW, blocksW int\n414\t\tfor i, name := range names {\n415\t\t\tp := name\n416\t\t\tif basePath != \"\" {\n417\t\t\t\tp = filepath.Join(basePath, name)\n418\t\t\t}\n419\t\t\tfi, err := sys.Lstat(p)\n420\t\t\tif err != nil {\n421\t\t\t\tcontinue\n422\t\t\t}\n423\t\t\tinfos[i] = entryInfo{fi.Ino, fi.Blocks / 2, fi.Mode}\n424\t\t\tif n := len(strconv.FormatUint(fi.Ino, 10)); n > inodeW {\n425\t\t\t\tinodeW = n\n426\t\t\t}\n427\t\t\tbstr := formatBlocks(infos[i].blocks, opts.humanReadable)\n428\t\t\tif n := len(bstr); n > blocksW {\n429\t\t\t\tblocksW = n\n430\t\t\t}\n431\t\t}\n432\t\treturn infos, inodeW, blocksW\n433\t}\n434\t\n435\tfunc buildDisplayNames(names []string, basePath string, opts options) []string {\n436\t\tneedPrefix := opts.showInode || opts.showBlocks\n437\t\tneedColor := format.FileTypeColor(os.ModeDir) != \"\"\n438\t\tif !needPrefix && !needColor && !opts.classify {\n439\t\t\treturn names\n440\t\t}\n441\t\tinfos, inodeW, blocksW := statDisplayEntries(names, basePath, opts)\n442\t\tresult := make([]string, len(names))\n443\t\tfor i, name := range names {\n444\t\t\tvar b strings.Builder\n445\t\t\tif opts.showInode {\n446\t\t\t\tb.WriteString(format.PadLeft(strconv.FormatUint(infos[i].inode, 10), inodeW))\n447\t\t\t\tb.WriteByte(' ')\n448\t\t\t}\n449\t\t\tif opts.showBlocks {\n450\t\t\t\tbstr := formatBlocks(infos[i].blocks, opts.humanReadable)\n451\t\t\t\tb.WriteString(format.PadLeft(bstr, blocksW))\n452\t\t\t\tb.WriteByte(' ')\n453\t\t\t}\n454\t\t\tb.WriteString(colorEntry(name, infos[i].mode, opts.classify))\n455\t\t\tresult[i] = b.String()\n456\t\t}\n457\t\treturn result\n458\t}\n459\t\n460\tfunc colorEntry(name string, mode os.FileMode, classify bool) string {\n461\t\tindicator := \"\"\n462\t\tif classify {\n463\t\t\tindicator = classifyIndicator(mode)\n464\t\t}\n465\t\tc := format.FileTypeColor(mode)\n466\t\tif c == \"\" {\n467\t\t\treturn name + indicator\n468\t\t}\n469\t\treturn c + name + format.Reset() + indicator\n470\t}\n471\t\n472\tfunc classifyIndicator(mode os.FileMode) string {\n473\t\tswitch {\n474\t\tcase mode&os.ModeDir != 0:\n475\t\t\treturn \"/\"\n476\t\tcase mode&os.ModeSymlink != 0:\n477\t\t\treturn \"@\"\n478\t\tcase mode&os.ModeNamedPipe != 0:\n479\t\t\treturn \"|\"\n480\t\tcase mode&os.ModeSocket != 0:\n481\t\t\treturn \"=\"\n482\t\tcase mode.IsRegular() && mode&0111 != 0:\n483\t\t\treturn \"*\"\n484\t\tdefault:\n485\t\t\treturn \"\"\n486\t\t}\n487\t}\n488\t\n489\tfunc writeEntries(names []string, opts options) {\n490\t\tif len(names) == 0 {\n491\t\t\treturn\n492\t\t}\n493\t\tif opts.forceColumns {\n494\t\t\tif opts.horizontalSort {\n495\t\t\t\twriteHorizontalColumns(names, 0)\n496\t\t\t} else {\n497\t\t\t\twriteColumnsWidth(names, 0)\n498\t\t\t}\n499\t\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n500\t\t\twriteLines(names)\n501\t\t} else {\n502\t\t\twriteColumnsWidth(names, 0)\n503\t\t}\n504\t}\n505\t\n506\tfunc writeColumnsWidth(names []string, width int) {\n507\t\tif width <= 0 {\n508\t\t\twidth = termWidth\n509\t\t}\n510\t\tgrid := format.Columns(names, width)\n511\t\twidths := gridColumnWidths(grid)\n512\t\tfor _, row := range grid {\n513\t\t\twriteGridRow(row, widths)\n514\t\t}\n515\t}\n516\t\n517\tfunc writeHorizontalColumns(names []string, width int) {\n518\t\tif width <= 0 {\n519\t\t\twidth = termWidth\n520\t\t}\n521\t\tnumCols := findHorizontalMaxCols(names, width)\n522\t\trows := (len(names) + numCols - 1) / numCols\n523\t\tcolWidths := make([]int, numCols)\n524\t\tfor c := 0; c < numCols; c++ {\n525\t\t\tfor r := 0; r < rows; r++ {\n526\t\t\t\tidx := r*numCols + c\n527\t\t\t\tif idx >= len(names) {\n528\t\t\t\t\tbreak\n529\t\t\t\t}\n530\t\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n531\t\t\t\t\tcolWidths[c] = w\n532\t\t\t\t}\n533\t\t\t}\n534\t\t}\n535\t\tfor r := 0; r < rows; r++ {\n536\t\t\tvar row []string\n537\t\t\tfor c := 0; c < numCols; c++ {\n538\t\t\t\tidx := r*numCols + c\n539\t\t\t\tif idx >= len(names) {\n540\t\t\t\t\tbreak\n541\t\t\t\t}\n542\t\t\t\trow = append(row, names[idx])\n543\t\t\t}\n544\t\t\twriteGridRow(row, colWidths)\n545\t\t}\n546\t}\n547\t\n548\tfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n549\t\tn := len(entries)\n550\t\tfor cols := n; cols > 1; cols-- {\n551\t\t\tif horizontalGridFits(entries, cols, termWidth) {\n552\t\t\t\treturn cols\n553\t\t\t}\n554\t\t}\n555\t\treturn 1\n556\t}\n557\t\n558\tfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n559\t\trows := (len(entries) + cols - 1) / cols\n560\t\tcolWidths := make([]int, cols)\n561\t\tfor c := 0; c < cols; c++ {\n562\t\t\tfor r := 0; r < rows; r++ {\n563\t\t\t\tidx := r*cols + c\n564\t\t\t\tif idx >= len(entries) {\n565\t\t\t\t\tbreak\n566\t\t\t\t}\n567\t\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n568\t\t\t\t\tcolWidths[c] = w\n569\t\t\t\t}\n570\t\t\t}\n571\t\t}\n572\t\ttotal := 0\n573\t\tfor c := 0; c < cols; c++ {\n574\t\t\tif c < cols-1 {\n575\t\t\t\ttotal += colWidths[c] + 2\n576\t\t\t} else {\n577\t\t\t\ttotal += colWidths[c]\n578\t\t\t}\n579\t\t\tif total > termWidth {\n580\t\t\t\treturn false\n581\t\t\t}\n582\t\t}\n583\t\treturn true\n584\t}\n585\t\n586\tfunc writeLines(names []string) {\n587\t\tfor _, name := range names {\n588\t\t\twriteLine(name)\n589\t\t}\n590\t}\n591\t\n592\tfunc gridColumnWidths(grid [][]string) []int {\n593\t\tif len(grid) == 0 {\n594\t\t\treturn nil\n595\t\t}\n596\t\twidths := make([]int, len(grid[0]))\n597\t\tfor _, row := range grid {\n598\t\t\tfor c, cell := range row {\n599\t\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n600\t\t\t\t\twidths[c] = w\n601\t\t\t\t}\n602\t\t\t}\n603\t\t}\n604\t\treturn widths\n605\t}\n606\t\n607\tfunc writeGridRow(row []string, widths []int) {\n608\t\tvar b strings.Builder\n609\t\tfor i, cell := range row {\n610\t\t\tif i < len(row)-1 {\n611\t\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n612\t\t\t\tb.WriteString(\"  \")\n613\t\t\t} else {\n614\t\t\t\tb.WriteString(cell)\n615\t\t\t}\n616\t\t}\n617\t\twriteLine(b.String())\n618\t}\n619\t\n620\ttype longEntry struct {\n621\t\tname  string\n622\t\tpath  string\n623\t\tinfo  *sys.FileInfo\n624\t\towner string\n625\t\tgroup string\n626\t}\n627\t\n628\ttype longWidths struct {\n629\t\tinode  int\n630\t\tblocks int\n631\t\tnlink  int\n632\t\towner  int\n633\t\tgroup  int\n634\t\tsize   int\n635\t}\n636\t\n637\tfunc writeLongFiles(paths []string, opts options) int {\n638\t\tentries := make([]longEntry, 0, len(paths))\n639\t\tcode := 0\n640\t\tfor _, p := range paths {\n641\t\t\tfi, err := sys.Lstat(p)\n642\t\t\tif err != nil {\n643\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n644\t\t\t\tcode = 1\n645\t\t\t\tcontinue\n646\t\t\t}\n647\t\t\tentries = append(entries, newLongEntry(p, p, fi, opts))\n648\t\t}\n649\t\twriteLongEntries(entries, opts)\n650\t\treturn code\n651\t}\n652\t\n653\tfunc writeTotalLine(path string, names []string, opts options) {\n654\t\ttotal := int64(0)\n655\t\tfor _, name := range names {\n656\t\t\tp := filepath.Join(path, name)\n657\t\t\tfi, err := sys.Lstat(p)\n658\t\t\tif err != nil {\n659\t\t\t\tcontinue\n660\t\t\t}\n661\t\t\ttotal += fi.Blocks\n662\t\t}\n663\t\twriteLine(fmt.Sprintf(\"total %s\", formatBlocks(total/2, opts.humanReadable)))\n664\t}\n665\t\n666\tfunc writeLongDir(path string, names []string, opts options) int {\n667\t\tentries := make([]longEntry, 0, len(names))\n668\t\tcode := 0\n669\t\tfor _, name := range names {\n670\t\t\tfull := filepath.Join(path, name)\n671\t\t\tfi, err := sys.Lstat(full)\n672\t\t\tif err != nil {\n673\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n674\t\t\t\tcode = 1\n675\t\t\t\tcontinue\n676\t\t\t}\n677\t\t\tentries = append(entries, newLongEntry(name, full, fi, opts))\n678\t\t}\n679\t\ttotalBlocks := int64(0)\n680\t\tfor _, e := range entries {\n681\t\t\ttotalBlocks += e.info.Blocks\n682\t\t}\n683\t\ttotal := formatBlocks(totalBlocks/2, opts.humanReadable)\n684\t\twriteLine(fmt.Sprintf(\"total %s\", total))\n685\t\twriteLongEntries(entries, opts)\n686\t\treturn code\n687\t}\n688\t\n689\tfunc newLongEntry(name, path string, fi *sys.FileInfo, opts options) longEntry {\n690\t\towner := resolveOwner(fi.Uid)\n691\t\tgroup := resolveGroup(fi.Gid)\n692\t\tif opts.numericIds {\n693\t\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n694\t\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n695\t\t}\n696\t\treturn longEntry{\n697\t\t\tname:  name,\n698\t\t\tpath:  path,\n699\t\t\tinfo:  fi,\n700\t\t\towner: owner,\n701\t\t\tgroup: group,\n702\t\t}\n703\t}\n704\t\n705\tfunc writeLongEntries(entries []longEntry, opts options) {\n706\t\tif len(entries) == 0 {\n707\t\t\treturn\n708\t\t}\n709\t\tw := computeLongWidths(entries, opts)\n710\t\tfor _, e := range entries {\n711\t\t\twriteLine(formatLongLine(e, w, opts))\n712\t\t}\n713\t}\n714\t\n715\tfunc computeLongWidths(entries []longEntry, opts options) longWidths {\n716\t\tvar w longWidths\n717\t\tfor _, e := range entries {\n718\t\t\tif opts.showInode {\n719\t\t\t\tif n := len(strconv.FormatUint(e.info.Ino, 10)); n > w.inode {\n720\t\t\t\t\tw.inode = n\n721\t\t\t\t}\n722\t\t\t}\n723\t\t\tif opts.showBlocks {\n724\t\t\t\tbstr := formatBlocks(e.info.Blocks/2, opts.humanReadable)\n725\t\t\t\tif n := len(bstr); n > w.blocks {\n726\t\t\t\t\tw.blocks = n\n727\t\t\t\t}\n728\t\t\t}\n729\t\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n730\t\t\t\tw.nlink = n\n731\t\t\t}\n732\t\t\tif n := len(e.owner); n > w.owner {\n733\t\t\t\tw.owner = n\n734\t\t\t}\n735\t\t\tif n := len(e.group); n > w.group {\n736\t\t\t\tw.group = n\n737\t\t\t}\n738\t\t\tsstr := formatSize(e.info.Size, opts.humanReadable)\n739\t\t\tif n := len(sstr); n > w.size {\n740\t\t\t\tw.size = n\n741\t\t\t}\n742\t\t}\n743\t\treturn w\n744\t}\n745\t\n746\tfunc formatLongLine(e longEntry, w longWidths, opts options) string {\n747\t\tvar prefix string\n748\t\tif opts.showInode {\n749\t\t\tprefix += format.PadLeft(strconv.FormatUint(e.info.Ino, 10), w.inode) + \" \"\n750\t\t}\n751\t\tif opts.showBlocks {\n752\t\t\tbstr := formatBlocks(e.info.Blocks/2, opts.humanReadable)\n753\t\t\tprefix += format.PadLeft(bstr, w.blocks) + \" \"\n754\t\t}\n755\t\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n756\t\tsize := formatSize(e.info.Size, opts.humanReadable)\n757\t\tclassifyName := opts.classify && e.info.Mode&os.ModeSymlink == 0\n758\t\tname := colorEntry(e.name, e.info.Mode, classifyName)\n759\t\tif e.info.Mode&os.ModeSymlink != 0 {\n760\t\t\tif target, err := os.Readlink(e.path); err == nil {\n761\t\t\t\tname += \" -> \" + target\n762\t\t\t}\n763\t\t}\n764\t\treturn prefix +\n765\t\t\tpermString(e.info.Mode) + \" \" +\n766\t\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n767\t\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n768\t\t\tformat.PadRight(e.group, w.group) + \" \" +\n769\t\t\tformat.PadLeft(size, w.size) + \" \" +\n770\t\t\tformatMtime(e.info.ModTime) + \" \" +\n771\t\t\tname\n772\t}\n773\t\n774\tfunc formatBlocks(blocks int64, human bool) string {\n775\t\tif !human {\n776\t\t\treturn strconv.FormatInt(blocks, 10)\n777\t\t}\n778\t\treturn format.HumanSize(blocks*1024, format.HumanSizeOpts{Binary: true})\n779\t}\n780\t\n781\tfunc formatSize(size int64, human bool) string {\n782\t\tif !human {\n783\t\t\treturn strconv.FormatInt(size, 10)\n784\t\t}\n785\t\treturn format.HumanSize(size, format.HumanSizeOpts{Binary: true})\n786\t}\n787\t\n788\tfunc permString(mode os.FileMode) string {\n789\t\tvar b [10]byte\n790\t\tb[0] = fileTypeChar(mode)\n791\t\tconst rwx = \"rwx\"\n792\t\tperm := mode.Perm()\n793\t\tfor i := 0; i < 9; i++ {\n794\t\t\tif perm&(1<<uint(8-i)) != 0 {\n795\t\t\t\tb[1+i] = rwx[i%3]\n796\t\t\t} else {\n797\t\t\t\tb[1+i] = '-'\n798\t\t\t}\n799\t\t}\n800\t\tapplySpecialBits(mode, &b)\n801\t\treturn string(b[:])\n802\t}\n803\t\n804\tfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n805\t\tif mode&os.ModeSetuid != 0 {\n806\t\t\tif b[3] == 'x' {\n807\t\t\t\tb[3] = 's'\n808\t\t\t} else {\n809\t\t\t\tb[3] = 'S'\n810\t\t\t}\n811\t\t}\n812\t\tif mode&os.ModeSetgid != 0 {\n813\t\t\tif b[6] == 'x' {\n814\t\t\t\tb[6] = 's'\n815\t\t\t} else {\n816\t\t\t\tb[6] = 'S'\n817\t\t\t}\n818\t\t}\n819\t\tif mode&os.ModeSticky != 0 {\n820\t\t\tif b[9] == 'x' {\n821\t\t\t\tb[9] = 't'\n822\t\t\t} else {\n823\t\t\t\tb[9] = 'T'\n824\t\t\t}\n825\t\t}\n826\t}\n827\t\n828\tfunc fileTypeChar(mode os.FileMode) byte {\n829\t\tswitch {\n830\t\tcase mode&os.ModeDir != 0:\n831\t\t\treturn 'd'\n832\t\tcase mode&os.ModeSymlink != 0:\n833\t\t\treturn 'l'\n834\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n835\t\t\treturn 'c'\n836\t\tcase mode&os.ModeDevice != 0:\n837\t\t\treturn 'b'\n838\t\tcase mode&os.ModeNamedPipe != 0:\n839\t\t\treturn 'p'\n840\t\tcase mode&os.ModeSocket != 0:\n841\t\t\treturn 's'\n842\t\tdefault:\n843\t\t\treturn '-'\n844\t\t}\n845\t}\n846\t\n847\tfunc resolveOwner(uid uint32) string {\n848\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n849\t\tif err != nil {\n850\t\t\treturn strconv.FormatUint(uint64(uid), 10)\n851\t\t}\n852\t\treturn u.Username\n853\t}\n854\t\n855\tfunc resolveGroup(gid uint32) string {\n856\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n857\t\tif err != nil {\n858\t\t\treturn strconv.FormatUint(uint64(gid), 10)\n859\t\t}\n860\t\treturn g.Name\n861\t}\n862\t\n863\tfunc formatMtime(t time.Time) string {\n864\t\tsixMonths := 6 * 30 * 24 * time.Hour\n865\t\tago := time.Since(t)\n866\t\tif ago >= 0 && ago < sixMonths {\n867\t\t\treturn t.Format(\"Jan _2 15:04\")\n868\t\t}\n869\t\treturn t.Format(\"Jan _2  2006\")\n870\t}\n871\t\n872\tfunc writeLine(s string) {\n873\t\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n874\t\t\tos.Exit(1)\n875\t\t}\n876\t}\n877\t\n878\tfunc sysError(err error) string {\n879\t\tvar pathErr *os.PathError\n880\t\tif errors.As(err, &pathErr) {\n881\t\t\treturn pathErr.Err.Error()\n882\t\t}\n883\t\treturn err.Error()\n884\t}\n885\t"}]},"parent_tool_use_id":null,"session_id":"a4f33632-7054-4942-b764-2cf5fa4c4252","uuid":"c0bd4237-0976-46f6-90f5-ed841ac9d1e2","timestamp":"2026-05-14T23:06:55.415Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5226/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd008-ls R1.1-R1.14, R2.1-R2.15, R3.1-R3.15, R4.1-R4.8.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n  -a             do not ignore entries starting with .\n  -A             do not list implied . and ..\n  -C             list entries by columns\n  -d             list directories themselves, not their contents\n  -F             append indicator (one of */=>@|) to entries\n  -h             with -l and/or -s, print human readable sizes\n  -i             print the index number of each file\n  -l             use a long listing format\n  -n             like -l, but list numeric user and group IDs\n  -R             list subdirectories recursively\n  -r             reverse order while sorting\n  -s             print the allocated size of each file, in blocks\n  -S             sort by file size, largest first\n  -t             sort by modification time, newest first\n  -U             do not sort; list entries in directory order\n  -v             natural sort of (version) numbers within text\n  -x             list entries by lines instead of by columns\n  -1             list one file per line\n      --color[=WHEN]  colorize the output; WHEN can be 'always'\n                         (default if omitted), 'auto', or 'never'\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn  bool\n\tlongFormat    bool\n\tforceColumns  bool\n\thorizontalSort bool\n\tshowAll       bool\n\tshowAlmostAll bool\n\tdirAsEntry    bool\n\tsortByTime    bool\n\tsortBySize    bool\n\treverseSort   bool\n\tunsorted      bool\n\tversionSort   bool\n\tshowInode     bool\n\tshowBlocks    bool\n\tnumericIds    bool\n\thumanReadable bool\n\tclassify      bool\n\trecursive     bool\n\tcolorMode     string\n}\n\nvar termWidth int\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\ttermWidth = queryTermWidth()\n\tsys.OnTerminalResize(func(w int) { termWidth = w })\n\topts, paths := parseArgs(os.Args[1:])\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tos.Exit(run(paths, opts))\n}\n\nfunc queryTermWidth() int {\n\tw, err := sys.TerminalWidth()\n\tif err != nil {\n\t\treturn 80\n\t}\n\treturn w\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase arg == \"--color\":\n\t\t\topts.colorMode = \"always\"\n\t\tcase strings.HasPrefix(arg, \"--color=\"):\n\t\t\topts.colorMode = parseColorValue(arg)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'C':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = false\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'x':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = true\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'a':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\tcase 'A':\n\t\t\topts.showAlmostAll = true\n\t\t\topts.showAll = false\n\t\tcase 'd':\n\t\t\topts.dirAsEntry = true\n\t\tcase 'F':\n\t\t\topts.classify = true\n\t\tcase 'h':\n\t\t\topts.humanReadable = true\n\t\tcase 'i':\n\t\t\topts.showInode = true\n\t\tcase 'n':\n\t\t\topts.numericIds = true\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tcase 'r':\n\t\t\topts.reverseSort = true\n\t\tcase 's':\n\t\t\topts.showBlocks = true\n\t\tcase 't':\n\t\t\topts.sortByTime = true\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'S':\n\t\t\topts.sortBySize = true\n\t\t\topts.sortByTime = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'U':\n\t\t\topts.unsorted = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.versionSort = false\n\t\tcase 'v':\n\t\t\topts.versionSort = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc parseColorValue(arg string) string {\n\tval := arg[len(\"--color=\"):]\n\tswitch val {\n\tcase \"always\", \"auto\", \"never\":\n\t\treturn val\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"ls: invalid argument '%s' for '--color'\\n\", val)\n\t\tfmt.Fprintln(os.Stderr,\n\t\t\t\"Try 'ls --help' for more information.\")\n\t\tos.Exit(2)\n\t\treturn \"\"\n\t}\n}\n\nfunc setupColor(opts options) {\n\tswitch opts.colorMode {\n\tcase \"always\":\n\t\tformat.SetColorEnabled(true)\n\tcase \"auto\":\n\t\tformat.SetColorEnabled(sys.IsTerminal(os.Stdout.Fd()))\n\tdefault:\n\t\tformat.SetColorEnabled(false)\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\tsetupColor(opts)\n\texitCode := 0\n\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n\tneedSep := false\n\tif len(files) > 0 {\n\t\tsortEntries(files, \"\", opts)\n\t\tif opts.longFormat {\n\t\t\texitCode = maxCode(exitCode, writeLongFiles(files, opts))\n\t\t} else {\n\t\t\tdisplay := buildDisplayNames(files, \"\", opts)\n\t\t\twriteEntries(display, opts)\n\t\t}\n\t\tneedSep = true\n\t}\n\tshowHeader := len(dirs) > 1 || len(files) > 0 || opts.recursive\n\tsortEntries(dirs, \"\", opts)\n\tfor _, dir := range dirs {\n\t\tif needSep {\n\t\t\tfmt.Fprintln(os.Stdout)\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n\t\t}\n\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n\t\tneedSep = true\n\t}\n\treturn exitCode\n}\n\nfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n\tvar files, dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\t*exitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() && !dirAsEntry {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\treturn files, dirs\n}\n\nfunc maxCode(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc listDir(path string, opts options) int {\n\tnames, err := readNames(path, opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n\t\t\tpath, sysError(err))\n\t\treturn 1\n\t}\n\tcode := 0\n\tif opts.longFormat {\n\t\tcode = writeLongDir(path, names, opts)\n\t} else {\n\t\tif opts.showBlocks {\n\t\t\twriteTotalLine(path, names, opts)\n\t\t}\n\t\tdisplay := buildDisplayNames(names, path, opts)\n\t\twriteEntries(display, opts)\n\t}\n\tif opts.recursive {\n\t\tcode = maxCode(code, recurseSubdirs(path, names, opts))\n\t}\n\treturn code\n}\n\nfunc recurseSubdirs(path string, names []string, opts options) int {\n\tcode := 0\n\tfor _, name := range names {\n\t\tif name == \".\" || name == \"..\" {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := os.Lstat(full)\n\t\tif err != nil || !fi.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tfmt.Fprintln(os.Stdout)\n\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", full)\n\t\tcode = maxCode(code, listDir(full, opts))\n\t}\n\treturn code\n}\n\nfunc readNames(path string, opts options) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tif opts.showAll {\n\t\tnames = append(names, \".\", \"..\")\n\t}\n\tfor _, e := range entries {\n\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name())\n\t}\n\tsortEntries(names, path, opts)\n\treturn names, nil\n}\n\nfunc sortEntries(names []string, basePath string, opts options) {\n\tif opts.unsorted {\n\t\treturn\n\t}\n\tif opts.versionSort {\n\t\tsort.SliceStable(names, func(i, j int) bool {\n\t\t\treturn strverscmp(names[i], names[j]) < 0\n\t\t})\n\t\tif opts.reverseSort {\n\t\t\treverseSlice(names)\n\t\t}\n\t\treturn\n\t}\n\tif !opts.sortByTime && !opts.sortBySize {\n\t\tsort.Strings(names)\n\t\tif opts.reverseSort {\n\t\t\treverseSlice(names)\n\t\t}\n\t\treturn\n\t}\n\ttype entry struct {\n\t\tname    string\n\t\tmodTime time.Time\n\t\tsize    int64\n\t}\n\tentries := make([]entry, len(names))\n\tfor i, name := range names {\n\t\tentries[i].name = name\n\t\tp := name\n\t\tif basePath != \"\" {\n\t\t\tp = filepath.Join(basePath, name)\n\t\t}\n\t\tif fi, err := sys.Lstat(p); err == nil {\n\t\t\tentries[i].modTime = fi.ModTime\n\t\t\tentries[i].size = fi.Size\n\t\t}\n\t}\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\tif opts.sortByTime {\n\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n\t\t\t}\n\t\t\treturn entries[i].name < entries[j].name\n\t\t}\n\t\tif entries[i].size != entries[j].size {\n\t\t\treturn entries[i].size > entries[j].size\n\t\t}\n\t\tretur