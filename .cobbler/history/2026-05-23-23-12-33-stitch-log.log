{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01831JqBFbb2CtcSpZkjWKa2","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd094-nice R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"context\"\n9\t\t\"io\"\n10\t\t\"os/exec\"\n11\t\t\"regexp\"\n12\t\t\"testing\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n16\t)\n17\t\n18\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?nice\\b`)\n19\t\n20\tfunc normalizeBinaryName(b []byte) []byte {\n21\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"nice\"))\n22\t}\n23\t\n24\tfunc TestDiff(t *testing.T) {\n25\t\tgoBin := testutils.BuildBinary(t, \".\")\n26\t\trefBin, err := exec.LookPath(\"gnice\")\n27\t\tif err != nil {\n28\t\t\tt.Skip(\"reference binary not found\")\n29\t\t}\n30\t\n31\t\tt.Run(\"no_command_prints_niceness\", func(t *testing.T) {\n32\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n33\t\t\t\t{\n34\t\t\t\t\tName:     \"no_args\",\n35\t\t\t\t\tArgs:     []string{},\n36\t\t\t\t\tExitCode: 0,\n37\t\t\t\t},\n38\t\t\t})\n39\t\t})\n40\t\n41\t\tt.Run(\"default_adjustment\", func(t *testing.T) {\n42\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n43\t\t\t\t{\n44\t\t\t\t\tName:     \"echo_with_default\",\n45\t\t\t\t\tArgs:     []string{\"echo\", \"hello\"},\n46\t\t\t\t\tExitCode: 0,\n47\t\t\t\t},\n48\t\t\t})\n49\t\t})\n50\t\n51\t\tt.Run(\"custom_adjustment_n5\", func(t *testing.T) {\n52\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n53\t\t\t\t{\n54\t\t\t\t\tName:     \"n5_echo\",\n55\t\t\t\t\tArgs:     []string{\"-n\", \"5\", \"echo\", \"hello\"},\n56\t\t\t\t\tExitCode: 0,\n57\t\t\t\t},\n58\t\t\t})\n59\t\t})\n60\t\n61\t\tt.Run(\"custom_adjustment_n0\", func(t *testing.T) {\n62\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n63\t\t\t\t{\n64\