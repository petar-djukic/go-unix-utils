{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0189FNZnzmj2SSBtyQqYV38y","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"regexp\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype patternKind int\n19\t\n20\tconst (\n21\t\tkindRegexp patternKind = iota\n22\t\tkindSkip\n23\t\tkindInteger\n24\t)\n25\t\n26\ttype pattern struct {\n27\t\tkind    patternKind\n28\t\tregex   *regexp.Regexp\n29\t\tlineNum int\n30\t\toffset  int\n31\t\trepeat  int // 0 = no repeat, >0 = repeat N times, -1 = repeat until exhausted\n32\t\traw     string\n33\t}\n34\t\n35\ttype splitter struct {\n36\t\tlines      []string\n37\t\tpos        int\n38\t\tfileNum    int\n39\t\tprefix     string\n40\t\tdigits     int\n41\t\telideEmpty bool\n42\t\tcreated    []string\n43\t\tatMatch    bool\n44\t}\n45\t\n46\tfunc main() {\n47\t\tsys.InstallSIGPIPEHandler()\n48\t\tif err := run(os.Args[1:]); err != nil {\n49\t\t\tfmt.Fprintf(os.Stderr, \"%s\\n\", err)\n50\t\t\tos.Exit(1)\n51\t\t}\n52\t}\n53\t\n54\tfunc run(args []string) error {\n55\t\tprefix, digits, elideEmpty, rest, err := parseFlags(args)\n56\t\tif err != nil {\n57\t\t\treturn err\n58\t\t}\n59\t\tif len(rest) < 2 {\n60\t\t\tif len(rest) == 0 {\n61\t\t\t\treturn fmt.Errorf(\"csplit: missing operand\")\n62\t\t\t}\n63\t\t\treturn fmt.Errorf(\"csplit: missing operand after '%s'\", rest[0])\n64\t\t}\n65\t\tpats, err := parsePatterns(rest[1:])\n66\t\tif err != nil {\n67\t\t\treturn err\n68\t\t}\n69\t\tdata, err := readInput(rest[0])\n70\t\tif err != nil {\n71\t\t\treturn err\n72\t\t}\n73\t\ts := &splitter{\n74\t\t\tlines:      splitToLines(data),\n75\t\t\tprefix:     prefix,\n76\t\t\tdigits:     digits,\n77\t\t\telideEmpty: elideEmpty,\n78\t\t}\n79\t\treturn s.process(pats)\n80\t}\n81\t\n82\tfunc readInput(filename string) ([]byte, error) {\n83\t\tif filename == \"-\" {\n84\t\t\tdata, err := io.ReadAll(os.Stdin)\n85\t\t\tif err != nil {\n86\t\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n87\t\t\t}\n88\t\t\treturn data, nil\n89\t\t}\n90\t\tdata, err := os.ReadFile(filename)\n91\t\tif err != nil {\n92\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n93\t\t}\n94\t\treturn data, nil\n95\t}\n96\t\n97\tfunc splitToLines(data []byte) []string {\n98\t\tif len(data) == 0 {\n99\t\t\treturn nil\n100\t\t}\n101\t\tvar lines []string\n102\t\tfor len(data) > 0 {\n103\t\t\tidx := bytes.IndexByte(data, '\\n')\n104\t\t\tif idx < 0 {\n105\t\t\t\tlines = append(lines, string(data))\n106\t\t\t\tbreak\n107\t\t\t}\n108\t\t\tlines = append(lines, string(data[:idx+1]))\n109\t\t\tdata = data[idx+1:]\n110\t\t}\n111\t\treturn lines\n112\t}\n113\t\n114\tfunc parseFlags(args []string) (prefix string, digits int, elideEmpty bool, rest []string, err error) {\n115\t\tprefix = \"xx\"\n116\t\tdigits = 2\n117\t\tfor i := 0; i < len(args); i++ {\n118\t\t\ta := args[i]\n119\t\t\tif a == \"--\" {\n120\t\t\t\trest = append(rest, args[i+1:]...)\n121\t\t\t\treturn\n122\t\t\t}\n123\t\t\tif a == \"-z\" || a == \"--elide-empty-files\" {\n124\t\t\t\telideEmpty = true\n125\t\t\t\tcontinue\n126\t\t\t}\n127\t\t\tif a == \"-f\" {\n128\t\t\t\ti++\n129\t\t\t\tif i >= len(args) {\n130\t\t\t\t\terr = fmt.Errorf(\"csplit: option requires an argument -- 'f'\")\n131\t\t\t\t\treturn\n132\t\t\t\t}\n133\t\t\t\tprefix = args[i]\n134\t\t\t\tcontinue\n135\t\t\t}\n136\t\t\tif strings.HasPrefix(a, \"-f\") && len(a) > 2 {\n137\t\t\t\tprefix = a[2:]\n138\t\t\t\tcontinue\n139\t\t\t}\n140\t\t\tif strings.HasPrefix(a, \"--prefix=\") {\n141\t\t\t\tprefix = a[len(\"--prefix=\"):]\n142\t\t\t\tcontinue\n143\t\t\t}\n144\t\t\tif a == \"-n\" {\n145\t\t\t\ti++\n146\t\t\t\tif i >= len(args) {\n147\t\t\t\t\terr = fmt.Errorf(\"csplit: option requires an argument -- 'n'\")\n148\t\t\t\t\treturn\n149\t\t\t\t}\n150\t\t\t\tvar n int\n151\t\t\t\tn, err = strconv.Atoi(args[i])\n152\t\t\t\tif err != nil || n < 1 {\n153\t\t\t\t\terr = fmt.Errorf(\"csplit: invalid number of digits: '%s'\", args[i])\n154\t\t\t\t\treturn\n155\t\t\t\t}\n156\t\t\t\tdigits = n\n157\t\t\t\tcontinue\n158\t\t\t}\n159\t\t\tif strings.HasPrefix(a, \"-n\") && len(a) > 2 {\n160\t\t\t\tval := a[2:]\n161\t\t\t\tvar n int\n162\t\t\t\tn, err = strconv.Atoi(val)\n163\t\t\t\tif err != nil || n < 1 {\n164\t\t\t\t\terr = fmt.Errorf(\"csplit: invalid number of digits: '%s'\", val)\n165\t\t\t\t\treturn\n166\t\t\t\t}\n167\t\t\t\tdigits = n\n168\t\t\t\tcontinue\n169\t\t\t}\n170\t\t\tif strings.HasPrefix(a, \"--digits=\") {\n171\t\t\t\tval := a[len(\"--digits=\"):]\n172\t\t\t\tvar n int\n173\t\t\t\tn, err = strconv.Atoi(val)\n174\t\t\t\tif err != nil || n < 1 {\n175\t\t\t\t\terr = fmt.Errorf(\"csplit: invalid number of digits: '%s'\", val)\n176\t\t\t\t\treturn\n177\t\t\t\t}\n178\t\t\t\tdigits = n\n179\t\t\t\tcontinue\n180\t\t\t}\n181\t\t\trest = append(rest, a)\n182\t\t}\n183\t\treturn\n184\t}\n185\t\n186\tfunc parsePatterns(args []string) ([]pattern, error) {\n187\t\tpats := make([]pattern, 0, len(args))\n188\t\tfor _, arg := range args {\n189\t\t\tif rep, ok := parseRepeat(arg); ok {\n190\t\t\t\tif len(pats) == 0 {\n191\t\t\t\t\treturn nil, fmt.Errorf(\"csplit: '%s': no preceding pattern\", arg)\n192\t\t\t\t}\n193\t\t\t\tpats[len(pats)-1].repeat = rep\n194\t\t\t\tcontinue\n195\t\t\t}\n196\t\t\tp, err := parsePattern(arg)\n197\t\t\tif err != nil {\n198\t\t\t\treturn nil, err\n199\t\t\t}\n200\t\t\tpats = append(pats, p)\n201\t\t}\n202\t\treturn pats, nil\n203\t}\n204\t\n205\tfunc parseRepeat(arg string) (int, bool) {\n206\t\tif len(arg) < 3 || arg[0] != '{' || arg[len(arg)-1] != '}' {\n207\t\t\treturn 0, false\n208\t\t}\n209\t\tinner := arg[1 : len(arg)-1]\n210\t\tif inner == \"*\" {\n211\t\t\treturn -1, true\n212\t\t}\n213\t\tn, err := strconv.Atoi(inner)\n214\t\tif err != nil || n < 0 {\n215\t\t\treturn 0, false\n216\t\t}\n217\t\treturn n, true\n218\t}\n219\t\n220\tfunc parsePattern(arg string) (pattern, error) {\n221\t\tif expr, offset, ok := parseDelimitedWithOffset(arg, '/'); ok {\n222\t\t\tre, err := regexp.Compile(expr)\n223\t\t\tif err != nil {\n224\t\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n225\t\t\t}\n226\t\t\treturn pattern{kind: kindRegexp, regex: re, offset: offset, raw: arg}, nil\n227\t\t}\n228\t\tif expr, offset, ok := parseDelimitedWithOffset(arg, '%'); ok {\n229\t\t\tre, err := regexp.Compile(expr)\n230\t\t\tif err != nil {\n231\t\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n232\t\t\t}\n233\t\t\treturn pattern{kind: kindSkip, regex: re, offset: offset, raw: arg}, nil\n234\t\t}\n235\t\tn, err := strconv.Atoi(arg)\n236\t\tif err == nil && n >= 0 {\n237\t\t\treturn pattern{kind: kindInteger, lineNum: n, raw: arg}, nil\n238\t\t}\n239\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': invalid pattern\", arg)\n240\t}\n241\t\n242\tfunc parseDelimitedWithOffset(arg string, delim byte) (string, int, bool) {\n243\t\tif len(arg) < 2 || arg[0] != delim {\n244\t\t\treturn \"\", 0, false\n245\t\t}\n246\t\tend := strings.LastIndexByte(arg[1:], delim)\n247\t\tif end < 0 {\n248\t\t\treturn \"\", 0, false\n249\t\t}\n250\t\tend += 1\n251\t\texpr := arg[1:end]\n252\t\trest := arg[end+1:]\n253\t\toffset := 0\n254\t\tif rest != \"\" {\n255\t\t\tn, err := strconv.Atoi(rest)\n256\t\t\tif err != nil {\n257\t\t\t\treturn \"\", 0, false\n258\t\t\t}\n259\t\t\toffset = n\n260\t\t}\n261\t\treturn expr, offset, true\n262\t}\n263\t\n264\tfunc (s *splitter) process(pats []pattern) error {\n265\t\tfor _, pat := range pats {\n266\t\t\tif pat.repeat == 0 {\n267\t\t\t\tif err := s.apply(pat, false); err != nil {\n268\t\t\t\t\tremoveFiles(s.created)\n269\t\t\t\t\treturn err\n270\t\t\t\t}\n271\t\t\t} else if pat.repeat == -1 {\n272\t\t\t\tif err := s.applyNoEmitOnFail(pat, false); err != nil {\n273\t\t\t\t\tbreak\n274\t\t\t\t}\n275\t\t\t\tfor {\n276\t\t\t\t\tif err := s.applyNoEmitOnFail(pat, true); err != nil {\n277\t\t\t\t\t\tbreak\n278\t\t\t\t\t}\n279\t\t\t\t}\n280\t\t\t} else {\n281\t\t\t\tif err := s.apply(pat, false); err != nil {\n282\t\t\t\t\tremoveFiles(s.created)\n283\t\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found on repetition 0\", pat.raw)\n284\t\t\t\t}\n285\t\t\t\tfor i := 1; i <= pat.repeat; i++ {\n286\t\t\t\t\tif err := s.apply(pat, true); err != nil {\n287\t\t\t\t\t\tremoveFiles(s.created)\n288\t\t\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found on repetition %d\", pat.raw, i)\n289\t\t\t\t\t}\n290\t\t\t\t}\n291\t\t\t}\n292\t\t}\n293\t\tif err := s.emitPiece(len(s.lines)); err != nil {\n294\t\t\tremoveFiles(s.created)\n295\t\t\treturn err\n296\t\t}\n297\t\treturn nil\n298\t}\n299\t\n300\tfunc (s *splitter) applyNoEmitOnFail(pat pattern, repeated bool) error {\n301\t\tswitch pat.kind {\n302\t\tcase kindRegexp:\n303\t\t\tstart := s.pos\n304\t\t\tif s.atMatch {\n305\t\t\t\tstart = s.pos + 1\n306\t\t\t}\n307\t\t\tidx := matchRegexp(s.lines, start, pat.regex)\n308\t\t\tif idx < 0 {\n309\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n310\t\t\t}\n311\t\t\ttarget := idx + pat.offset\n312\t\t\tif target < s.pos {\n313\t\t\t\ttarget = s.pos\n314\t\t\t}\n315\t\t\tif target > len(s.lines) {\n316\t\t\t\ttarget = len(s.lines)\n317\t\t\t}\n318\t\t\ts.atMatch = true\n319\t\t\treturn s.emitPiece(target)\n320\t\tcase kindSkip:\n321\t\t\tstart := s.pos\n322\t\t\tif s.atMatch {\n323\t\t\t\tstart = s.pos + 1\n324\t\t\t}\n325\t\t\tidx := matchRegexp(s.lines, start, pat.regex)\n326\t\t\tif idx < 0 {\n327\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n328\t\t\t}\n329\t\t\ttarget := idx + pat.offset\n330\t\t\tif target < s.pos {\n331\t\t\t\ttarget = s.pos\n332\t\t\t}\n333\t\t\tif target > len(s.lines) {\n334\t\t\t\ttarget = len(s.lines)\n335\t\t\t}\n336\t\t\ts.pos = target\n337\t\t\ts.atMatch = true\n338\t\t\treturn nil\n339\t\tdefault:\n340\t\t\tvar target int\n341\t\t\tif repeated {\n342\t\t\t\ttarget = s.pos + pat.lineNum\n343\t\t\t} else {\n344\t\t\t\ttarget = pat.lineNum - 1\n345\t\t\t}\n346\t\t\tif target > len(s.lines) || target < s.pos {\n347\t\t\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n348\t\t\t}\n349\t\t\ts.atMatch = false\n350\t\t\treturn s.emitPiece(target)\n351\t\t}\n352\t}\n353\t\n354\tfunc (s *splitter) apply(pat pattern, repeated bool) error {\n355\t\tswitch pat.kind {\n356\t\tcase kindRegexp:\n357\t\t\tstart := s.pos\n358\t\t\tif s.atMatch {\n359\t\t\t\tstart = s.pos + 1\n360\t\t\t}\n361\t\t\tidx := matchRegexp(s.lines, start, pat.regex)\n362\t\t\tif idx < 0 {\n363\t\t\t\ts.emitPiece(len(s.lines))\n364\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n365\t\t\t}\n366\t\t\ttarget := idx + pat.offset\n367\t\t\tif target < s.pos {\n368\t\t\t\ttarget = s.pos\n369\t\t\t}\n370\t\t\tif target > len(s.lines) {\n371\t\t\t\ttarget = len(s.lines)\n372\t\t\t}\n373\t\t\ts.atMatch = true\n374\t\t\treturn s.emitPiece(target)\n375\t\tcase kindSkip:\n376\t\t\tstart := s.pos\n377\t\t\tif s.atMatch {\n378\t\t\t\tstart = s.pos + 1\n379\t\t\t}\n380\t\t\tidx := matchRegexp(s.lines, start, pat.regex)\n381\t\t\tif idx < 0 {\n382\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n383\t\t\t}\n384\t\t\ttarget := idx + pat.offset\n385\t\t\tif target < s.pos {\n386\t\t\t\ttarget = s.pos\n387\t\t\t}\n388\t\t\tif target > len(s.lines) {\n389\t\t\t\ttarget = len(s.lines)\n390\t\t\t}\n391\t\t\ts.pos = target\n392\t\t\ts.atMatch = true\n393\t\t\treturn nil\n394\t\tdefault:\n395\t\t\treturn s.applyInteger(pat, repeated)\n396\t\t}\n397\t}\n398\t\n399\tfunc (s *splitter) applyInteger(pat pattern, repeated bool) error {\n400\t\tvar target int\n401\t\tif repeated {\n402\t\t\ttarget = s.pos + pat.lineNum\n403\t\t} else {\n404\t\t\ttarget = pat.lineNum - 1\n405\t\t}\n406\t\tif target < s.pos || target > len(s.lines) {\n407\t\t\ts.emitPiece(len(s.lines))\n408\t\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n409\t\t}\n410\t\ts.atMatch = false\n411\t\treturn s.emitPiece(target)\n412\t}\n413\t\n414\tfunc (s *splitter) emitPiece(to int) error {\n415\t\tpiece := s.lines[s.pos:to]\n416\t\tcontent := strings.Join(piece, \"\")\n417\t\tname := fmt.Sprintf(\"%s%0*d\", s.prefix, s.digits, s.fileNum)\n418\t\ts.fileNum++\n419\t\ts.pos = to\n420\t\tif s.elideEmpty && len(content) == 0 {\n421\t\t\treturn nil\n422\t\t}\n423\t\ts.created = append(s.created, name)\n424\t\tif err := os.WriteFile(name, []byte(content), 0666); err != nil {\n425\t\t\treturn fmt.Errorf(\"csplit: %v\", err)\n426\t\t}\n427\t\tfmt.Println(len(content))\n428\t\treturn nil\n429\t}\n430\t\n431\tfunc matchRegexp(lines []string, start int, re *regexp.Regexp) int {\n432\t\tfor i := start; i < len(lines); i++ {\n433\t\t\tline := strings.TrimSuffix(lines[i], \"\\n\")\n434\t\t\tif re.MatchString(line) {\n435\t\t\t\treturn i\n436\t\t\t}\n437\t\t}\n438\t\treturn -1\n439\t}\n440\t\n441\tfunc removeFiles(files []string) {\n442\t\tfor _, f := range files {\n443\t\t\tos.Remove(f)\n444\t\t}\n445\t}\n446\t"}]},"parent_tool_use_id":null,"session_id":"9885cd55-a14f-42b5-88c0-58b53a0ce59f","uuid":"f4ca84f1-03f3-4e12-be19-73642334eaaf","timestamp":"2026-05-21T20:24:22.722Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5453/cmd/csplit/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype patternKind int\n\nconst (\n\tkindRegexp patternKind = iota\n\tkindSkip\n\tkindInteger\n)\n\ntype pattern struct {\n\tkind    patternKind\n\tregex   *regexp.Regexp\n\tlineNum int\n\toffset  int\n\trepeat  int // 0 = no repeat, >0 = repeat N times, -1 = repeat until exhausted\n\traw     string\n}\n\ntype splitter struct {\n\tlines      []string\n\tpos        int\n\tfileNum    int\n\tprefix     string\n\tdigits     int\n\telideEmpty bool\n\tcreated    []string\n\tatMatch    bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tif err := run(os.Args[1:]); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"%s\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc run(args []string) error {\n\tprefix, digits, elideEmpty, rest, err := parseFlags(args)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif len(rest) < 2 {\n\t\tif len(rest) == 0 {\n\t\t\treturn fmt.Errorf(\"csplit: missing operand\")\n\t\t}\n\t\treturn fmt.Errorf(\"csplit: missing operand after '%s'\", rest[0])\n\t}\n\tpats, err := parsePatterns(rest[1:])\n\tif err != nil {\n\t\treturn err\n\t}\n\tdata, err := readInput(rest[0])\n\tif err != nil {\n\t\treturn err\n\t}\n\ts := &splitter{\n\t\tlines:      splitToLines(data),\n\t\tprefix:     prefix,\n\t\tdigits:     digits,\n\t\telideEmpty: elideEmpty,\n\t}\n\treturn s.process(pats)\n}\n\nfunc readInput(filename string) ([]byte, error) {\n\tif filename == \"-\" {\n\t\tdata, err := io.ReadAll(os.Stdin)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n\t\t}\n\t\treturn data, nil\n\t}\n\tdata, err := os.ReadFile(filename)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n\t}\n\treturn data, nil\n}\n\nfunc splitToLines(data []byte) []string {\n\tif len(data) == 0 {\n\t\treturn nil\n\t}\n\tvar lines []string\n\tfor len(data) > 0 {\n\t\tidx := bytes.IndexByte(data, '\\n')\n\t\tif idx < 0 {\n\t\t\tlines = append(lines, string(data))\n\t\t\tbreak\n\t\t}\n\t\tlines = append(lines, string(data[:idx+1]))\n\t\tdata = data[idx+1:]\n\t}\n\treturn lines\n}\n\nfunc parseFlags(args []string) (prefix string, digits int, elideEmpty bool, rest []string, err error) {\n\tprefix = \"xx\"\n\tdigits = 2\n\tfor i := 0; i < len(args); i++ {\n\t\ta := args[i]\n\t\tif a == \"--\" {\n\t\t\trest = append(rest, args[i+1:]...)\n\t\t\treturn\n\t\t}\n\t\tif a == \"-z\" || a == \"--elide-empty-files\" {\n\t\t\telideEmpty = true\n\t\t\tcontinue\n\t\t}\n\t\tif a == \"-f\" {\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\terr = fmt.Errorf(\"csplit: option requires an argument -- 'f'\")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tprefix = args[i]\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(a, \"-f\") && len(a) > 2 {\n\t\t\tprefix = a[2:]\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(a, \"--prefix=\") {\n\t\t\tprefix = a[len(\"--prefix=\"):]\n\t\t\tcontinue\n\t\t}\n\t\tif a == \"-n\" {\n\t\t\ti++\n\t\t\tif i >= len(args) {\n\t\t\t\terr = fmt.Errorf(\"csplit: option requires an argument -- 'n'\")\n\t\t\t\treturn\n\t\t\t}\n\t\t\tvar n int\n\t\t\tn, err = strconv.Atoi(args[i])\n\t\t\tif err != nil || n < 1 {\n\t\t\t\terr = fmt.Errorf(\"csplit: invalid number of digits: '%s'\", args[i])\n\t\t\t\treturn\n\t\t\t}\n\t\t\tdigits = n\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(a, \"-n\") && len(a) > 2 {\n\t\t\tval := a[2:]\n\t\t\tvar n int\n\t\t\tn, err = strconv.Atoi(val)\n\t\t\tif err != nil || n < 1 {\n\t\t\t\terr = fmt.Errorf(\"csplit: invalid number of digits: '%s'\", val)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tdigits = n\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(a, \"--digits=\") {\n\t\t\tval := a[len(\"--digits=\"):]\n\t\t\tvar n int\n\t\t\tn, err = strconv.Atoi(val)\n\t\t\tif err != nil || n < 1 {\n\t\t\t\terr = fmt.Errorf(\"csplit: invalid number of digits: '%s'\", val)\n\t\t\t\treturn\n\t\t\t}\n\t\t\tdigits = n\n\t\t\tcontinue\n\t\t}\n\t\trest = append(rest, a)\n\t}\n\treturn\n}\n\nfunc parsePatterns(args []string) ([]pattern, error) {\n\tpats := make([]pattern, 0, len(args))\n\tfor _, arg := range args {\n\t\tif rep, ok := parseRepeat(arg); ok {\n\t\t\tif len(pats) == 0 {\n\t\t\t\treturn nil, fmt.Errorf(\"csplit: '%s': no preceding pattern\", arg)\n\t\t\t}\n\t\t\tpats[len(pats)-1].repeat = rep\n\t\t\tcontinue\n\t\t}\n\t\tp, err := parsePattern(arg)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tpats = append(pats, p)\n\t}\n\treturn pats, nil\n}\n\nfunc parseRepeat(arg string) (int, bool) {\n\tif len(arg) < 3 || arg[0] != '{' || arg[len(arg)-1] != '}' {\n\t\treturn 0, false\n\t}\n\tinner := arg[1 : len(arg)-1]\n\tif inner == \"*\" {\n\t\treturn -1, true\n\t}\n\tn, err := strconv.Atoi(inner)\n\tif err != nil || n < 0 {\n\t\treturn 0, false\n\t}\n\treturn n, true\n}\n\nfunc parsePattern(arg string) (pattern, error) {\n\tif expr, offset, ok := parseDelimitedWithOffset(arg, '/'); ok {\n\t\tre, err := regexp.Compile(expr)\n\t\tif err != nil {\n\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n\t\t}\n\t\treturn pattern{kind: kindRegexp, regex: re, offset: offset, raw: arg}, nil\n\t}\n\tif expr, offset, ok := parseDelimitedWithOffset(arg, '%'); ok {\n\t\tre, err := regexp.Compile(expr)\n\t\tif err != nil {\n\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n\t\t}\n\t\treturn pattern{kind: kindSkip, regex: re, offset: offset, raw: arg}, nil\n\t}\n\tn, err := strconv.Atoi(arg)\n\tif err == nil && n >= 0 {\n\t\treturn pattern{kind: kindInteger, lineNum: n, raw: arg}, nil\n\t}\n\treturn pattern{}, fmt.Errorf(\"csplit: '%s': invalid pattern\", arg)\n}\n\nfunc parseDelimitedWithOffset(arg string, delim byte) (string, int, bool) {\n\tif len(arg) < 2 || arg[0] != delim {\n\t\treturn \"\", 0, false\n\t}\n\tend := strings.LastIndexByte(arg[1:], delim)\n\tif end < 0 {\n\t\treturn \"\", 0, false\n\t}\n\tend += 1\n\texpr := arg[1:end]\n\trest := arg[end+1:]\n\toffset := 0\n\tif rest != \"\" {\n\t\tn, err := strconv.Atoi(rest)\n\t\tif err != nil {\n\t\t\treturn \"\", 0, false\n\t\t}\n\t\toffset = n\n\t}\n\treturn expr, offset, true\n}\n\nfunc (s *splitter) process(pats []pattern) error {\n\tfor _, pat := range pats {\n\t\tif pat.repeat == 0 {\n\t\t\tif err := s.apply(pat, false); err != nil {\n\t\t\t\tremoveFiles(s.created)\n\t\t\t\treturn err\n\t\t\t}\n\t\t} else if pat.repeat == -1 {\n\t\t\tif err := s.applyNoEmitOnFail(pat, false); err != nil {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tfor {\n\t\t\t\tif err := s.applyNoEmitOnFail(pat, true); err != nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t} else {\n\t\t\tif err := s.apply(pat, false); err != nil {\n\t\t\t\tremoveFiles(s.created)\n\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found on repetition 0\", pat.raw)\n\t\t\t}\n\t\t\tfor i := 1; i <= pat.repeat; i++ {\n\t\t\t\tif err := s.apply(pat, true); err != nil {\n\t\t\t\t\tremoveFiles(s.created)\n\t\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found on repetition %d\", pat.raw, i)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif err := s.emitPiece(len(s.lines)); err != nil {\n\t\tremoveFiles(s.created)\n\t\treturn err\n\t}\n\treturn nil\n}\n\nfunc (s *splitter) applyNoEmitOnFail(pat pattern, repeated bool) error {\n\tswitch pat.kind {\n\tcase kindRegexp:\n\t\tstart := s.pos\n\t\tif s.atMatch {\n\t\t\tstart = s.pos + 1\n\t\t}\n\t\tidx := matchRegexp(s.lines, start, pat.regex)\n\t\tif idx < 0 {\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ttarget := idx + pat.offset\n\t\tif target < s.pos {\n\t\t\ttarget = s.pos\n\t\t}\n\t\tif target > len(s.lines) {\n\t\t\ttarget = len(s.lines)\n\t\t}\n\t\ts.atMatch = true\n\t\treturn s.emitPiece(target)\n\tcase kindSkip:\n\t\tstart := s.pos\n\t\tif s.atMatch {\n\t\t\tstart = s.pos + 1\n\t\t}\n\t\tidx := matchRegexp(s.lines, start, pat.regex)\n\t\tif idx < 0 {\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ttarget := idx + pat.offset\n\t\tif target < s.pos {\n\t\t\ttarget = s.pos\n\t\t}\n\t\tif target > len(s.lines) {\n\t\t\ttarget = len(s.lines)\n\t\t}\n\t\ts.pos = target\n\t\ts.atMatch = true\n\t\treturn nil\n\tdefault:\n\t\tvar target int\n\t\tif repeated {\n\t\t\ttarget = s.pos + pat.lineNum\n\t\t} else {\n\t\t\ttarget = pat.lineNum - 1\n\t\t}\n\t\tif target > len(s.lines) || target < s.pos {\n\t\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n\t\t}\n\t\ts.atMatch = false\n\t\treturn s.emitPiece(target)\n\t}\n}\n\nfunc (s *splitter) apply(pat pattern, repeated bool) error {\n\tswitch pat.kind {\n\tcase kindRegexp:\n\t\tstart := s.pos\n\t\tif s.atMatch {\n\t\t\tstart = s.pos + 1\n\t\t}\n\t\tidx := matchRegexp(s.lines, start, pat.regex)\n\t\tif idx < 0 {\n\t\t\ts.emitPiece(len(s.lines))\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ttarget := idx + pat.offset\n\t\tif target < s.pos {\n\t\t\ttarget = s.pos\n\t\t}\n\t\tif target > len(s.lines) {\n\t\t\ttarget = len(s.lines)\n\t\t}\n\t\ts.atMatch = true\n\t\treturn s.emitPiece(target)\n\tcase kindSkip:\n\t\tstart := s.pos\n\t\tif s.atMatch {\n\t\t\tstart = s.pos + 1\n\t\t}\n\t\tidx := matchRegexp(s.lines, start, pat.regex)\n\t\tif idx < 0 {\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ttarget := idx + pat.offset\n\t\tif target < s.pos {\n\t\t\ttarget = s.pos\n\t\t}\n\t\tif target > len(s.lines) {\n\t\t\ttarget = len(s.lines)\n\t\t}\n\t\ts.pos = target\n\t\ts.atMatch = true\n\t\treturn nil\n\tdefault:\n\t\treturn s.applyInteger(pat, repeated)\n\t}\n}\n\nfunc (s *splitter) applyInteger(pat pattern, repeated bool) error {\n\tvar target int\n\tif repeated {\n\t\ttarget = s.pos + pat.lineNum\n\t} else {\n\t\ttarget = pat.lineNum - 1\n\t}\n\tif target < s.pos || target > len(s.lines) {\n\t\ts.emitPiece(len(s.lines))\n\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n\t}\n\ts.atMatch = false\n\treturn s.emitPiece(target)\n}\n\nfunc (s *splitter) emitPiece(to int) error {\n\tpiece := s.lines[s.pos:to]\n\tcontent := strings.Join(piece, \"\")\n\tname := fmt.Sprintf(\"%s%0*d\", s.prefix, s.digits, s.fileNum)\n\ts.fileNum++\n\ts.pos = to\n\tif s.elideEmpty && len(content) == 0 {\n\t\treturn nil\n\t}\n\ts.created = append(s.created, name)\n\tif err := os.WriteFile(name, []byte(content), 0666); err != nil {\n\t\treturn fmt.Errorf(\"csplit: %v\", err)\n\t}\n\tfmt.Println(len(content))\n\treturn nil\n}\n\nfunc matchRegexp(lines []string, start int, re *regexp.Regexp) int {\n\tfor i := start; i < len(lines); i++ {\n\t\tline := strings.TrimSuffix(lines[i], \"\\n\")\n\t\tif re.MatchString(line) {\n\t\t\treturn i\n\t\t}\n\t}\n\treturn -1\n}\n\nfunc removeFiles(files []string) {\n\tfor _, f := range files {\n\t\tos.Remove(f)\n\t}\n}\n","numLines":446,"startLine":1,"totalLines":446}}}
