{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qgyb8Fw7jgwmFwg5Bbu3CK","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd057-mv R1.1, R1.2, R1.3, R1.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"context\"\n10\t\t\"errors\"\n11\t\t\"os\"\n12\t\t\"os/exec\"\n13\t\t\"path/filepath\"\n14\t\t\"regexp\"\n15\t\t\"strings\"\n16\t\t\"testing\"\n17\t\t\"time\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n20\t)\n21\t\n22\ttype cmdResult struct {\n23\t\tstdout   []byte\n24\t\tstderr   []byte\n25\t\texitCode int\n26\t}\n27\t\n28\tfunc TestDiff(t *testing.T) {\n29\t\tgoBin := testutils.BuildBinary(t, \".\")\n30\t\trefBin, err := exec.LookPath(\"gmv\")\n31\t\tif err != nil {\n32\t\t\tt.Skip(\"reference binary gmv not found\")\n33\t\t}\n34\t\n35\t\tbinaryNameRe := regexp.MustCompile(`(?m)^(?:/\\S+/)?g?mv:`)\n36\t\tnormBin := testutils.NormalizeFunc(func(b []byte) []byte {\n37\t\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mv:\"))\n38\t\t})\n39\t\tnormCase := testutils.NormalizeFunc(func(b []byte) []byte {\n40\t\t\treturn bytes.ToLower(b)\n41\t\t})\n42\t\tnormTry := testutils.NormalizeFunc(func(b []byte) []byte {\n43\t\t\tvar out [][]byte\n44\t\t\tfor line := range bytes.SplitSeq(b, []byte(\"\\n\")) {\n45\t\t\t\tif !bytes.HasPrefix(bytes.TrimSpace(bytes.ToLower(line)), []byte(\"try \")) {\n46\t\t\t\t\tout = append(out, bytes.Clone(line))\n47\t\t\t\t}\n48\t\t\t}\n49\t\t\treturn bytes.Join(out, []byte(\"\\n\"))\n50\t\t})\n51\t\terrNorm := []testutils.NormalizeFunc{normBin, normCase, normTry}\n52\t\n53\t\tt.Run(\"r1_1_rename_file\", func(t *testing.T) {\n54\t\t\tsetup := func(t *testing.T, dir string) {\n55\t\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n56\t\t\t}\n57\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n58\t\t\t\t[]string{\"src.txt\", \"dest.txt\"}, nil)\n59\t\t\tcheckFile(t, goDir, \"dest.txt\", \"hello\\n\")\n60\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n61\t\t})\n62\t\n63\t\tt.Run(\"r1_1_overwrite_existing\", func(t *testing.T) {\n64\t\t\tsetup := func(t *testing.T, dir string) {\n65\t\t\t\twriteFile(t, dir, \"src.txt\", \"new\\n\")\n66\t\t\t\twriteFile(t, dir, \"dest.txt\", \"old\\n\")\n67\t\t\t}\n68\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n69\t\t\t\t[]string{\"src.txt\", \"dest.txt\"}, nil)\n70\t\t\tcheckFile(t, goDir, \"dest.txt\", \"new\\n\")\n71\t\t\tcheckAbsent(t, goDir, \"src.txt\")\n72\t\t})\n73\t\n74\t\tt.Run(\"r1_2_multi_file_into_dir\", func(t *testing.T) {\n75\t\t\tsetup := func(t *testing.T, dir string) {\n76\t\t\t\twriteFile(t, dir, \"a.txt\", \"aaa\\n\")\n77\t\t\t\twriteFile(t, dir, \"b.txt\", \"bbb\\n\")\n78\t\t\t\tos.Mkdir(filepath.Join(dir, \"dest\"), 0o755)\n79\t\t\t}\n80\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n81\t\t\t\t[]string{\"a.txt\", \"b.txt\", \"dest\"}, nil)\n82\t\t\tcheckFile(t, goDir, \"dest/a.txt\", \"aaa\\n\")\n83\t\t\tcheckFile(t, goDir, \"dest/b.txt\", \"bbb\\n\")\n84\t\t\tcheckAbsent(t, goDir, \"a.txt\")\n85\t\t\tcheckAbsent(t, goDir, \"b.txt\")\n86\t\t})\n87\t\n88\t\tt.Run(\"r1_3_move_directory\", func(t *testing.T) {\n89\t\t\tsetup := func(t *testing.T, dir string) {\n90\t\t\t\tos.Mkdir(filepath.Join(dir, \"srcdir\"), 0o755)\n91\t\t\t\twriteFile(t, dir, \"srcdir/file.txt\", \"inside\\n\")\n92\t\t\t}\n93\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n94\t\t\t\t[]string{\"srcdir\", \"destdir\"}, nil)\n95\t\t\tcheckFile(t, goDir, \"destdir/file.txt\", \"inside\\n\")\n96\t\t\tcheckAbsent(t, goDir, \"srcdir\")\n97\t\t})\n98\t\n99\t\tt.Run(\"r1_4_dest_is_directory\", func(t *testing.T) {\n100\t\t\tsetup := func(t *testing.T, dir string) {\n101\t\t\t\twriteFile(t, dir, \"file.txt\", \"content\\n\")\n102\t\t\t\tos.Mkdir(filepath.Join(dir, \"destdir\"), 0o755)\n103\t\t\t}\n104\t\t\tgoDir := runMvTest(t, goBin, refBin, setup,\n105\t\t\t\t[]string{\"file.txt\", \"destdir\"}, nil)\n106\t\t\tcheckFile(t, goDir, \"destdir/file.txt\", \"content\\n\")\n107\t\t\tcheckAbsent(t, goDir, \"file.txt\")\n108\t\t})\n109\t\n110\t\tt.Run(\"r1_1_source_not_found\", func(t *testing.T) {\n111\t\t\tsetup := func(t *testing.T, dir string) {}\n112\t\t\trunMvTest(t, goBin, refBin, setup,\n113\t\t\t\t[]string{\"nonexistent.txt\", \"dest.txt\"}, errNorm)\n114\t\t})\n115\t\n116\t\tt.Run(\"r1_2_target_not_directory\", func(t *testing.T) {\n117\t\t\tsetup := func(t *testing.T, dir string) {\n118\t\t\t\twriteFile(t, dir, \"a.txt\", \"a\\n\")\n119\t\t\t\twriteFile(t, dir, \"b.txt\", \"b\\n\")\n120\t\t\t\twriteFile(t, dir, \"notadir\", \"x\\n\")\n121\t\t\t}\n122\t\t\trunMvTest(t, goBin, refBin, setup,\n123\t\t\t\t[]string{\"a.txt\", \"b.txt\", \"notadir\"}, errNorm)\n124\t\t})\n125\t}\n126\t\n127\tfunc runMvTest(\n128\t\tt *testing.T, goBin, refBin string,\n129\t\tsetup func(t *testing.T, dir string),\n130\t\targs []string,\n131\t\tnorm []testutils.NormalizeFunc,\n132\t) string {\n133\t\tt.Helper()\n134\t\tgoDir := t.TempDir()\n135\t\trefDir := t.TempDir()\n136\t\tsetup(t, goDir)\n137\t\tsetup(t, refDir)\n138\t\tenv := buildTestEnv()\n139\t\tgoRes := runCmd(t, goBin, args, env, goDir)\n140\t\trefRes := runCmd(t, refBin, args, env, refDir)\n141\t\tcompareResults(t, goRes, refRes, norm)\n142\t\treturn goDir\n143\t}\n144\t\n145\tfunc runCmd(\n146\t\tt *testing.T, bin string, args, env []string, dir string,\n147\t) cmdResult {\n148\t\tt.Helper()\n149\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n150\t\tdefer cancel()\n151\t\tcmd := exec.CommandContext(ctx, bin, args...)\n152\t\tcmd.Dir = dir\n153\t\tcmd.Env = env\n154\t\tvar stdout, stderr bytes.Buffer\n155\t\tcmd.Stdout = &stdout\n156\t\tcmd.Stderr = &stderr\n157\t\terr := cmd.Run()\n158\t\tif ctx.Err() == context.DeadlineExceeded {\n159\t\t\tt.Fatalf(\"binary %s timed out\", bin)\n160\t\t}\n161\t\tif err == nil {\n162\t\t\treturn cmdResult{stdout: stdout.Bytes(), stderr: stderr.Bytes()}\n163\t\t}\n164\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n165\t\t\treturn cmdResult{\n166\t\t\t\tstdout:   stdout.Bytes(),\n167\t\t\t\tstderr:   stderr.Bytes(),\n168\t\t\t\texitCode: exitErr.ExitCode(),\n169\t\t\t}\n170\t\t}\n171\t\tt.Fatalf(\"failed to run %s: %v\", bin, err)\n172\t\treturn cmdResult{}\n173\t}\n174\t\n175\tfunc buildTestEnv() []string {\n176\t\tenvMap := make(map[string]string)\n177\t\tfor _, entry := range os.Environ() {\n178\t\t\tkey, val, _ := strings.Cut(entry, \"=\")\n179\t\t\tenvMap[key] = val\n180\t\t}\n181\t\tenvMap[\"LC_ALL\"] = \"C\"\n182\t\tout := make([]string, 0, len(envMap))\n183\t\tfor k, v := range envMap {\n184\t\t\tout = append(out, k+\"=\"+v)\n185\t\t}\n186\t\treturn out\n187\t}\n188\t\n189\tfunc compareResults(\n190\t\tt *testing.T, goRes, refRes cmdResult, norm []testutils.NormalizeFunc,\n191\t) {\n192\t\tt.Helper()\n193\t\tgoOut, goErr := goRes.stdout, goRes.stderr\n194\t\trefOut, refErr := refRes.stdout, refRes.stderr\n195\t\tfor _, fn := range norm {\n196\t\t\tgoOut = fn(goOut)\n197\t\t\trefOut = fn(refOut)\n198\t\t\tgoErr = fn(goErr)\n199\t\t\trefErr = fn(refErr)\n200\t\t}\n201\t\tif !bytes.Equal(goOut, refOut) {\n202\t\t\tt.Errorf(\"stdout differs\\n  go:  %q\\n  ref: %q\", goOut, refOut)\n203\t\t}\n204\t\tif !bytes.Equal(goErr, refErr) {\n205\t\t\tt.Errorf(\"stderr differs\\n  go:  %q\\n  ref: %q\", goErr, refErr)\n206\t\t}\n207\t\tif goRes.exitCode != refRes.exitCode {\n208\t\t\tt.Errorf(\"exit code differs: go=%d ref=%d\",\n209\t\t\t\tgoRes.exitCode, refRes.exitCode)\n210\t\t}\n211\t}\n212\t\n213\tfunc writeFile(t *testing.T, dir, name, content string) {\n214\t\tt.Helper()\n215\t\tpath := filepath.Join(dir, name)\n216\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n217\t\t\tt.Fatal(err)\n218\t\t}\n219\t}\n220\t\n221\tfunc checkFile(t *testing.T, dir, name, want string) {\n222\t\tt.Helper()\n223\t\tgot, err := os.ReadFile(filepath.Join(dir, name))\n224\t\tif err != nil {\n225\t\t\tt.Fatalf(\"expected file %s: %