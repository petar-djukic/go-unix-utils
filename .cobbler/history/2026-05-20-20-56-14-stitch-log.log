{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PST27ihstSbSYeEShqdTEw","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/mv implements srd057-mv: move or rename files.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"path/filepath\"\n13\t\t\"syscall\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tfunc main() {\n19\t\tsys.InstallSIGPIPEHandler()\n20\t\targs := parseFlags(os.Args[1:])\n21\t\tif len(args) == 0 {\n22\t\t\tfmt.Fprintf(os.Stderr, \"mv: missing file operand\\n\")\n23\t\t\tos.Exit(1)\n24\t\t}\n25\t\tif len(args) == 1 {\n26\t\t\tfmt.Fprintf(os.Stderr,\n27\t\t\t\t\"mv: missing destination file operand after '%s'\\n\", args[0])\n28\t\t\tos.Exit(1)\n29\t\t}\n30\t\tdest := args[len(args)-1]\n31\t\tsources := args[:len(args)-1]\n32\t\tcode := 0\n33\t\tif len(sources) > 1 {\n34\t\t\tcode = moveMultiple(sources, dest)\n35\t\t} else {\n36\t\t\tcode = moveSingle(sources[0], dest)\n37\t\t}\n38\t\tif code != 0 {\n39\t\t\tos.Exit(code)\n40\t\t}\n41\t}\n42\t\n43\tfunc parseFlags(args []string) []string {\n44\t\tvar files []string\n45\t\tendOfFlags := false\n46\t\tfor _, arg := range args {\n47\t\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n48\t\t\t\tfiles = append(files, arg)\n49\t\t\t\tcontinue\n50\t\t\t}\n51\t\t\tif arg == \"--\" {\n52\t\t\t\tendOfFlags = true\n53\t\t\t\tcontinue\n54\t\t\t}\n55\t\t}\n56\t\treturn files\n57\t}\n58\t\n59\tfunc moveSingle(src, dest string) int {\n60\t\tinfo, err := os.Stat(dest)\n61\t\tif err == nil && info.IsDir() {\n62\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n63\t\t}\n64\t\tif err := moveFile(src, dest); err != nil {\n65\t\t\tfmt.Fprintf(os.Stderr, \"mv: %s\\n\", err)\n66\t\t\treturn 1\n67\t\t}\n68\t\treturn 0\n69\t}\n70\t\n71\tfunc moveMultiple(sources []string, dest string) int {\n72\t\tinfo, err := os.Stat(dest)\n73\t\tif err != nil || !info.IsDir() {\n74\t\t\tfmt.Fprintf(os.Stderr, \"mv: target '%s': not a directory\\n\", dest)\n75\t\t\treturn 1\n76\t\t}\n77\t\tcode := 0\n78\t\tfor _, src := range sources {\n79\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n80\t\t\tif err := moveFile(src, target); err != nil {\n81\t\t\t\tfmt.Fprintf(os.Stderr, \"mv: %s\\n\", err)\n82\t\t\t\tcode = 1\n83\t\t\t}\n84\t\t}\n85\t\treturn code\n86\t}\n87\t\n88\tfunc moveFile(src, dest string) error {\n89\t\tif _, err := os.Lstat(src); err != nil {\n90\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n91\t\t}\n92\t\terr := os.Rename(src, dest)\n93\t\tif err == nil {\n94\t\t\treturn nil\n95\t\t}\n96\t\tif isCrossDevice(err) {\n97\t\t\treturn crossDeviceMove(src, dest)\n98\t\t}\n99\t\treturn fmtPathErr(\"cannot move\", src, err)\n100\t}\n101\t\n102\tfunc isCrossDevice(err error) bool {\n103\t\tif linkErr, ok := errors.AsType[*os.LinkError](err); ok {\n104\t\t\treturn errors.Is(linkErr.Err, syscall.EXDEV)\n105\t\t}\n106\t\treturn false\n107\t}\n108\t\n109\tfunc crossDeviceMove(src, dest string) error {\n110\t\tif err := copyTree(src, dest); err != nil {\n111\t\t\treturn err\n112\t\t}\n113\t\tif err := os.RemoveAll(src); err != nil {\n114\t\t\treturn fmtPathErr(\"cannot remove\", src, err)\n115\t\t}\n116\t\treturn nil\n117\t}\n118\t\n119\tfunc copyTree(src, dest string) error {\n120\t\tinfo, err := os.Lstat(src)\n121\t\tif err != nil {\n122\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n123\t\t}\n124\t\tif info.IsDir() {\n125\t\t\treturn copyDir(src, dest, info)\n126\t\t}\n127\t\tif info.Mode()&os.ModeSymlink != 0 {\n128\t\t\treturn copySymlink(src, dest)\n129\t\t}\n130\t\treturn copyRegular(src, dest, info.Mode())\n131\t}\n132\t\n133\tfunc copyDir(src, dest string, info os.FileInfo) error {\n134\t\tif err := os.Mkdir(dest, info.Mode().Perm()); err != nil {\n135\t\t\treturn fmtPathErr(\"cannot create directory\", dest, err)\n136\t\t}\n137\t\tentries, err := os.ReadDir(src)\n138\t\tif err != nil {\n139\t\t\treturn fmtPathErr(\"cannot read directory\", src, err)\n140\t\t}\n141\t\tfor _, e := range entries {\n142\t\t\ts := filepath.Join(src, e.Name())\n143\t\t\td := filepath.Join(dest, e.Name())\n144\t\t\tif err := copyTree(s, d); err != nil {\n145\t\t\t\treturn err\n146\t\t\t}\n147\t\t}\n148\t\treturn nil\n149\t}\n150\t\n151\tfunc copySymlink(src, dest string) error {\n152\t\ttarget, err := os.Readlink(src)\n153\t\tif err != nil {\n154\t\t\treturn fmtPathErr(\"cannot readlink\", src, err)\n155\t\t}\n156\t\treturn os.Symlink(target, dest)\n157\t}\n158\t\n159\tfunc copyRegular(src, dest string, mode os.FileMode) error {\n160\t\tin, err := os.Open(src)\n161\t\tif err != nil {\n162\t\t\treturn fmtPathErr(\"cannot open\", src, err)\n163\t\t}\n164\t\tdefer in.Close()\n165\t\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n166\t\tif err != nil {\n167\t\t\treturn fmtPathErr(\"cannot create\", dest, err)\n168\t\t}\n169\t\tdefer out.Close()\n170\t\tif _, err := io.Copy(out, in); err != nil {\n171\t\t\treturn err\n172\t\t}\n173\t\treturn out.Close()\n174\t}\n175\t\n176\tfunc fmtPathErr(verb, path string, err error) error {\n177\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n178\t\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n179\t\t}\n180\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n181\t}\n182\t"}]},"parent_tool_use_id":null,"session_id":"c7329244-7fc2-4cb9-9e7f-d8795e4d93f2","uuid":"4112d304-13ca-48be-b975-dacd07b96316","timestamp":"2026-05-21T00:56:26.723Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5397/cmd/mv/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/mv implements srd057-mv: move or rename files.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\targs := parseFlags(os.Args[1:])\n\tif len(args) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"mv: missing file operand\\n\")\n\t\tos.Exit(1)\n\t}\n\tif len(args) == 1 {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"mv: missing destination file operand after '%s'\\n\", args[0])\n\t\tos.Exit(1)\n\t}\n\tdest := args[len(args)-1]\n\tsources := args[:len(args)-1]\n\tcode := 0\n\tif len(sources) > 1 {\n\t\tcode = moveMultiple(sources, dest)\n\t} else {\n\t\tcode = moveSingle(sources[0], dest)\n\t}\n\tif code != 0 {\n\t\tos.Exit(code)\n\t}\n}\n\nfunc parseFlags(args []string) []string {\n\tvar files []string\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t}\n\treturn files\n}\n\nfunc moveSingle(src, dest string) int {\n\tinfo, err := os.Stat(dest)\n\tif err == nil && info.IsDir() {\n\t\tdest = filepath.Join(dest, filepath.Base(src))\n\t}\n\tif err := moveFile(src, dest); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"mv: %s\\n\", err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc moveMultiple(sources []string, dest string) int {\n\tinfo, err := os.Stat(dest)\n\tif err != nil || !info.IsDir() {\n\t\tfmt.Fprintf(os.Stderr, \"mv: target '%s': not a directory\\n\", dest)\n\t\treturn 1\n\t}\n\tcode := 0\n\tfor _, src := range sources {\n\t\ttarget := filepath.Join(dest, filepath.Base(src))\n\t\tif err := moveFile(src, target); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"mv: %s\\n\", err)\n\t\t\tcode = 1\n\t\t}\n\t}\n\treturn code\n}\n\nfunc moveFile(src, dest string) error {\n\tif _, err := os.Lstat(src); err != nil {\n\t\treturn fmtPathErr(\"cannot stat\", src, err)\n\t}\n\terr := os.Rename(src, dest)\n\tif err == nil {\n\t\treturn nil\n\t}\n\tif isCrossDevice(err) {\n\t\treturn crossDeviceMove(src, dest)\n\t}\n\treturn fmtPathErr(\"cannot move\", src, err)\n}\n\nfunc isCrossDevice(err error) bool {\n\tif linkErr, ok := errors.AsType[*os.LinkError](err); ok {\n\t\treturn errors.Is(linkErr.Err, syscall.EXDEV)\n\t}\n\treturn false\n}\n\nfunc crossDeviceMove(src, dest string) error {\n\tif err := copyTree(src, dest); err != nil {\n\t\treturn err\n\t}\n\tif err := os.RemoveAll(src); err != nil {\n\t\treturn fmtPathErr(\"cannot remove\", src, err)\n\t}\n\treturn nil\n}\n\nfunc copyTree(src, dest string) error {\n\tinfo, err := os.Lstat(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot stat\", src, err)\n\t}\n\tif info.IsDir() {\n\t\treturn copyDir(src, dest, info)\n\t}\n\tif info.Mode()&os.ModeSymlink != 0 {\n\t\treturn copySymlink(src, dest)\n\t}\n\treturn copyRegular(src, dest, info.Mode())\n}\n\nfunc copyDir(src, dest string, info os.FileInfo) error {\n\tif err := os.Mkdir(dest, info.Mode().Perm()); err != nil {\n\t\treturn fmtPathErr(\"cannot create directory\", dest, err)\n\t}\n\tentries, err := os.ReadDir(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot read directory\", src, err)\n\t}\n\tfor _, e := range entries {\n\t\ts := filepath.Join(src, e.Name())\n\t\td := filepath.Join(dest, e.Name())\n\t\tif err := copyTree(s, d); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc copySymlink(src, dest string) error {\n\ttarget, err := os.Readlink(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot readlink\", src, err)\n\t}\n\treturn os.Symlink(target, dest)\n}\n\nfunc copyRegular(src, dest string, mode os.FileMode) error {\n\tin, err := os.Open(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot open\", src, err)\n\t}\n\tdefer in.Close()\n\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot create\", dest, err)\n\t}\n\tdefer out.Close()\n\tif _, err := io.Copy(out, in); err != nil {\n\t\treturn err\n\t}\n\treturn out.Close()\n}\n\nfunc fmtPathErr(verb, path string, err error) error {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n\t}\n\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n}\n","numLines":182,"startLine":1,"totalLines":182}}}
