tion: none\n    33→    expected:\n    34→      exit_code: 0\n    35→      stdout_structure: entries in columns, fitting within 80 characters\n    36→      stderr: \"\"\n    37→    traces:\n    38→      - prd010-ls-extended R1.1\n    39→      - prd010-ls-extended R1.2\n    40→\n    41→  - name: horizontal_layout\n    42→    description: -x sorts entries horizontally (across, then down).\n    43→    inputs:\n    44→      args: [\"-x\", \"--color=never\", \"-w\", \"80\", \"testdata/ls-extended-fixture/\"]\n    45→      stdin: null\n    46→      env: [\"LC_ALL=C\"]\n    47→    normalization: none\n    48→    expected:\n    49→      exit_code: 0\n    50→      stdout_structure: entries arranged across rows first, then down\n    51→      stderr: \"\"\n    52→    traces:\n    53→      - prd010-ls-extended R1.3\n    54→\n    55→  - name: sort_by_mtime\n    56→    description: '-t sorts by modification time, newest first. Fixture files have distinct mtimes set via os.Chtimes: newest_file (mtime = now), middle_file (mtime = now - 1h), oldest_file (mtime = now - 2h)'\n    57→    inputs:\n    58→      args: [\"-1t\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n    59→      stdin: null\n    60→      env: [\"LC_ALL=C\"]\n    61→    normalization: none\n    62→    expected:\n    63→      exit_code: 0\n    64→      stdout_structure: entries ordered newest to oldest\n    65→      stderr: \"\"\n    66→    traces:\n    67→      - prd010-ls-extended R2.1\n    68→\n    69→  - name: sort_by_size\n    70→    description: -S sorts by size, largest first.\n    71→    inputs:\n    72→      args: [\"-1S\", \"--color=never\", \"testdata/ls-extended-fixture/\"]\n    73→      stdin: null\n    74→      env: [\"LC_ALL=C\"]\n    75→    normalization: none\n    76→    expected:\n    77→      exit_code: 0\n    78→      stdout_structure: entries ordered largest to smallest by file size\n    79→      stderr: \"\"\n    80→    traces:\n    81→      - prd010-ls-extended R2.2\n    82→\n    83→  -