{"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_011MXm8Wg7WJzYc32H1wDtWu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01AjCfXV97s3jgBnMwTtnZkE","name":"Write","input":{"file_path":"/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/generation-2026-02-27-21-48-32-21v/pkg/format/format.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package format provides output formatting shared across utilities.\n// Implements prd003-format: column alignment, ANSI color, human-readable sizes.\npackage format\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\t\"sync\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\n// displayWidth returns the display width (rune count) of a string.\n// Implements prd003-format R1.3.\nfunc displayWidth(s string) int {\n\treturn utf8.RuneCountInString(s)\n}\n\n// Columns distributes entries into the maximum number of columns fitting\n// within termWidth. Column widths are per-column maxima.\n// Implements prd003-format R1.1.\nfunc Columns(entries []string, termWidth int) [][]string {\n\tif len(entries) == 0 {\n\t\treturn nil\n\t}\n\tn := len(entries)\n\t// Try from max columns down to 1\n\tfor numCols := n; numCols >= 1; numCols-- {\n\t\tnumRows := (n + numCols - 1) / numCols\n\t\tcolWidths := make([]int, numCols)\n\t\tfor col := 0; col < numCols; col++ {\n\t\t\tfor row := 0; row < numRows; row++ {\n\t\t\t\tidx := row + col*numRows\n\t\t\t\tif idx < n {\n\t\t\t\t\tw := displayWidth(entries[idx])\n\t\t\t\t\tif w > colWidths[col] {\n\t\t\t\t\t\tcolWidths[col] = w\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\ttotalWidth := 0\n\t\tfor i, w := range colWidths {\n\t\t\ttotalWidth += w\n\t\t\tif i < numCols-1 {\n\t\t\t\ttotalWidth += 2 // two-space gap between columns\n\t\t\t}\n\t\t}\n\t\tif totalWidth <= termWidth {\n\t\t\trows := make([][]string, numRows)\n\t\t\tfor row := 0; row < numRows; row++ {\n\t\t\t\tvar line []string\n\t\t\t\tfor col := 0; col < numCols; col++ {\n\t\t\t\t\tidx := row + col*numRows\n\t\t\t\t\tif idx < n {\n\t\t\t\t\t\tif col < numCols-1 {\n\t\t\t\t\t\t\tline = append(line, PadRight(entries[idx], colWidths[col]))\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\tline = append(line, entries[idx])\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\trows[row] = line\n\t\t\t}\n\t\t\treturn rows\n\t\t}\n\t}\n\t// Fallback: single column\n\trows := make([][]string, n)\n\tfor i, e := range entries {\n\t\trows[i] = []string{e}\n\t}\n\treturn rows\n}\n\n// PadRight pads s with trailing spaces to width (by rune count).\n// Implements prd003-format R1.2.\nfunc PadRight(s string, width int) string {\n\tw := displayWidth(s)\n\tif w >= width {\n\t\treturn s\n\t}\n\treturn s + strings.Repeat(\" \", width-w)\n}\n\n// PadLeft pads s with leading spaces to width (by rune count).\n// Implements prd003-format R1.2.\nfunc PadLeft(s string, width int) string {\n\tw := displayWidth(s)\n\tif w >= width {\n\t\treturn s\n\t}\n\treturn strings.Repeat(\" \", width-w) + s\n}\n\n// ANSI color codes matching GNU ls LS_COLORS defaults.\n// Implements prd003-format R2.4.\nconst (\n\tcolorDirectory = \"\\033[34m\"\n\tcolorSymlink   = \"\\033[36m\"\n\tcolorExec      = \"\\033[32m\"\n\tcolorBlockDev  = \"\\033[33;1m\"\n\tcolorCharDev   = \"\\033[33;1m\"\n\tcolorSocket    = \"\\033[35m\"\n\tcolorPipe      = \"\\033[33m\"\n\tcolorReset     = \"\\033[0m\"\n)\n\nvar (\n\tcolorMu       sync.Mutex\n\tcolorOverride *bool // nil = auto, non-nil = forced value\n)\n\n// SetColorEnabled overrides automatic TTY detection.\n// Implements prd003-format R2.6.\nfunc SetColorEnabled(enabled bool) {\n\tcolorMu.Lock()\n\tdefer colorMu.Unlock()\n\tcolorOverride = &enabled\n}\n\n// ResetColorEnabled clears any override set by SetColorEnabled.\n// Implements prd003-format R2.7.\nfunc ResetColorEnabled() {\n\tcolorMu.Lock()\n\tdefer colorMu.Unlock()\n\tcolorOverride = nil\n}\n\n// ColorEnabled returns true when w is a TTY, respecting any override.\n// Implements prd003-format R2.3.\nfunc ColorEnabled(w io.Writer) bool {\n\tcolorMu.Lock()\n\tdefer colorMu.Unlock()\n\tif colorOverride != nil {\n\t\treturn *colorOverride\n\t}\n\tf, ok := w.(*os.File)\n\tif !ok {\n\t\treturn false\n\t}\n\treturn sys.IsTerminal(f.Fd())\n}\n\nfunc isColorEnabled() bool {\n\tcolorMu.Lock()\n\tdefer colorMu.Unlock()\n\tif colorOverride != nil {\n\t\treturn *colorOverride\n\t}\n\treturn false\n}\n\n// FileTypeColor returns the ANSI escape sequence for a file's type.\n// Implements prd003-format R2.1.\nfunc FileTypeColor(mode os.FileMode) string {\n\tif !isColorEnabled() {\n\t\treturn \"\"\n\t}\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn colorDirectory\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn colorSymlink\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn colorCharDev\n\tcase mode&os.ModeDevice != 0:\n\t\treturn colorBlockDev\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn colorPipe\n\tcase mode&os.ModeSocket != 0:\n\t\treturn colorSocket\n\tcase mode.IsRegular() && mode&0o111 != 0:\n\t\treturn colorExec\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\n// Reset returns the ANSI reset sequence, or empty if color is disabled.\n// Implements prd003-format R2.2.\nfunc Reset() string {\n\tif !isColorEnabled() {\n\t\treturn \"\"\n\t}\n\treturn colorReset\n}\n\n// HumanSizeOpts configures HumanSize behavior.\ntype HumanSizeOpts struct {\n\tBinary bool // true = 1024-based (K/M/G), false = SI 1000-based (kB/MB/GB)\n}\n\n// HumanSize converts a byte count to a human-readable string.\n// Implements prd003-format R3.1.\nfunc HumanSize(bytes int64, opts HumanSizeOpts) string {\n\tif bytes == 0 {\n\t\treturn \"0\"\n\t}\n\tvar base float64\n\tvar suffixes []string\n\tif opts.Binary {\n\t\tbase = 1024\n\t\tsuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\t} else {\n\t\tbase = 1000\n\t\tsuffixes = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n\t}\n\tf := float64(bytes)\n\ti := 0\n\tfor f >= base && i < len(suffixes)-1 {\n\t\tf /= base\n\t\ti++\n\t}\n\tif i == 0 {\n\t\treturn fmt.Sprintf(\"%d\", bytes)\n\t}\n\tif f == float64(int64(f)) {\n\t\treturn fmt.Sprintf(\"%d%s\", int64(f), suffixes[i])\n\t}\n\treturn fmt.Sprintf(\"%.1f%s\", f, suffixes[i])\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":916,"cache_read_input_tokens":106779,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":916},"output_tokens":25,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"b3986247-14f1-40ab-8591-8e0beb64d116","uuid":"bb779773-cf44-49ce-9b1f-a5b5bc56c8f6"}
