r stdout, stderr bytes.Buffer","+  cmd.Stdout = &stdout","+  cmd.Stderr = &stderr","+  err := cmd.Run()","+  if ctx.Err() == context.DeadlineExceeded {","+    t.Fatalf(\"binary %s timed out\", binary)","   }","-  target := filepath.Join(dir, tc.Args[0])","-  if _, err := os.Lstat(target); !os.IsNotExist(err) {","-    t.Fatalf(\"expected %s to be removed, but it still exists\", tc.Args[0])","+  exitCode := 0","+  if err != nil {","+    var exitErr *exec.ExitError","+    if errors.As(err, &exitErr) {","+      exitCode = exitErr.ExitCode()","+    } else {","+      t.Fatalf(\"failed to start binary %s: %v\", binary, err)","+    }","   }","+  return binResult{stdout: stdout.Bytes(), stderr: stderr.Bytes(), exitCode: exitCode}"," }","+","+func compareResults(t *testing.T, args []string, goRes, refRes binResult) {","+  t.Helper()","+  goStdout := normBinaryName(goRes.stdout)","+  refStdout := normBinaryName(refRes.stdout)","+  goStderr := normBinaryName(goRes.stderr)","+  refStderr := normBinaryName(refRes.stderr)","+","+  if !bytes.Equal(goStdout, refStdout) ||","+    !bytes.Equal(goStderr, refStderr) ||","+    goRes.exitCode != refRes.exitCode {","+    t.Fatalf(\"divergence detected\\n\"+","+      \"  args:       %v\\n\"+","+      \"  ref stdout: %q\\n\"+","+      \"  go  stdout: %q\\n\"+","+      \"  ref stderr: %q\\n\"+","+      \"  go  stderr: %q\\n\"+","+      \"  ref exit:   %d\\n\"+","+      \"  go  exit:   %d\\n\",","+      args, refStdout, goStdout, refStderr, goStderr, refRes.exitCode, goRes.exitCode)","+  }","+}"]}],"originalFile":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gunlink\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\tdiscardStdout := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n\n\tbinaryNameRe := regexp.MustCompile(`(?:/\\S+/)?g?unlink`)\n\tnormalizeBinaryName := testutils.NormalizeFunc(func(b []byte) []byte {\n\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"unlink\"))\n\t})\n\n\tsetupRegularFile := func(t *testing.T, dir string) {\n\t\tt.Helper()\n\t\tif err := os.WriteFile(filepath.Join(dir, \"target\"), []byte(\"x\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\n\tsetupSymlink := func(t *testing.T, dir string) {\n\t\tt.Helper()\n\t\treal := filepath.Join(dir, \"real\")\n\t\tif err := os.WriteFile(real, []byte(\"x\"), 0o644); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\tif err := os.Symlink(real, filepath.Join(dir, \"link\")); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\n\tsetupDir := func(t *testing.T, dir string) {\n\t\tt.Helper()\n\t\tif err := os.Mkdir(filepath.Join(dir, \"subdir\"), 0o755); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\n\ttests := []testutils.DiffTest{\n\t\t{\n\t\t\tName: \"remove-regular-file\",\n\t\t\tArgs: []string{\"target\"},\n\t\t\tExpectedFiles: map[string][]byte{},\n\t\t},\n\t\t{\n\t\t\tName: \"remove-symlink\",\n\t\t\tArgs: []string{\"link\"},\n\t\t},\n\t\t{\n\t\t\tName:      \"zero-args\",\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t},\n\t\t{\n\t\t\tName:      \"extra-operand\",\n\t\t\tArgs:      []string{\"a\", \"b\"},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t},\n\t\t{\n\t\t\tName:      \"nonexistent-file\",\n\t\t\tArgs:      []string{\"nosuchfile\"},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t},\n\t\t{\n\t\t\tName:      \"directory-arg\",\n\t\t\tArgs:      []string{\"subdir\"},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t},\n\t\t{\n\t\t\tName:      \"help\",\n\t\t\tArgs:      []string{\"--help\"},\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStdout},\n\t\t},\n\t\t{\n\t\t\tName:      \"version\",\n\t\t\tArgs:      []string{\"--version\"},\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStdout},\n\t\t},\n\t}\n\n\tfor i := range tests {\n\t\ttc := &tests[i]\n\t\torigWorkDir := tc.WorkDir\n\t\tswitch tc.Name {\n\t\tcase \"remove-regular-file\":\n\t\t\ttc.WorkDir = \"\" // will be set per-binary below\n\t\tcase \"remove-symlink\":\n\t\t\ttc.WorkDir = \"\"\n\t\tcase \"directory-arg\":\n\t\t\ttc.WorkDir = \"\"\n\t\t}\n\t\t_ = origWorkDir\n\t}\n\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\tswitch tc.Name {\n\t\t\tcase \"remove-regular-file\":\n\t\t\t\trunWithSetup(t, goBin, refBin, tc, setupRegularFile)\n\t\t\tcase \"remove-symlink\":\n\t\t\t\trunWithSetup(t, goBin, refBin, tc, setupSymlink)\n\t\t\tcase \"directory-arg\":\n\t\t\t\trunWithSetup(t, goBin, refBin, tc, setupDir)\n\t\t\tdefault:\n\t\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{tc})\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc runWithSetup(\n\tt *testing.T, goBin, refBin string,\n\ttc testutils.DiffTest,\n\tsetup func(*testing.T, string),\n) {\n\tt.Helper()\n\tgoDir := t.TempDir()\n\tsetup(t, goDir)\n\trefDir := t.TempDir()\n\tsetup(t, refDir)\n\n\tgoTC := tc\n\tgoTC.WorkDir = goDir\n\trefTC := tc\n\trefTC.WorkDir = refDir\n\n\ttestutils.RunDiffTests(t, goBin, refBin,\n\t\t[]testutils.DiffTest{goTC})\n\n\tverifyRemoval(t, tc, goDir)\n}\n\nfunc verifyRemoval(t *testing.T, tc testutils.DiffTest, dir string) {\n\tt.Helper()\n\tif len(tc.Args) == 0 || tc.ExitCode != 0 {\n\t\treturn\n\t}\n\ttarget := filepath.Join(dir, tc.Args[0])\n\tif _, err := os.Lstat(target); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"expected %s to be removed, but it still exists\", tc.Args[0])\n\t}\n}\n","userModified":false}}
