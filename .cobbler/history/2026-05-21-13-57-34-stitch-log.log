{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0114W76Ytq5yK9p8wyBXZ6Fe","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"strconv\"\n11\t\t\"strings\"\n12\t\t\"syscall\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype options struct {\n19\t\tsignal         syscall.Signal\n20\t\tkillAfter      time.Duration\n21\t\tforeground     bool\n22\t\tpreserveStatus bool\n23\t\tduration       time.Duration\n24\t\tcmdArgs        []string\n25\t}\n26\t\n27\tfunc main() {\n28\t\tsys.InstallSIGPIPEHandler()\n29\t\n30\t\topts, exitCode := parseArgs(os.Args[1:])\n31\t\tif exitCode >= 0 {\n32\t\t\tos.Exit(exitCode)\n33\t\t}\n34\t\n35\t\tcmd := exec.Command(opts.cmdArgs[0], opts.cmdArgs[1:]...)\n36\t\tcmd.Stdin = os.Stdin\n37\t\tcmd.Stdout = os.Stdout\n38\t\tcmd.Stderr = os.Stderr\n39\t\tif !opts.foreground {\n40\t\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n41\t\t}\n42\t\n43\t\tif err := cmd.Start(); err != nil {\n44\t\t\tif isNotFound(err) {\n45\t\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", opts.cmdArgs[0], err)\n46\t\t\t\tos.Exit(127)\n47\t\t\t}\n48\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", opts.cmdArgs[0], err)\n49\t\t\tos.Exit(126)\n50\t\t}\n51\t\n52\t\tos.Exit(runWithTimeout(cmd, opts))\n53\t}\n54\t\n55\tfunc runWithTimeout(cmd *exec.Cmd, opts options) int {\n56\t\ttimedOut := false\n57\t\tvar timer *time.Timer\n58\t\tvar killTimer *time.Timer\n59\t\n60\t\tif opts.duration > 0 {\n61\t\t\ttimer = time.AfterFunc(opts.duration, func() {\n62\t\t\t\ttimedOut = true\n63\t\t\t\tsendSignal(cmd, opts.signal, opts.foreground)\n64\t\t\t\tif opts.signal == syscall.SIGKILL {\n65\t\t\t\t\t_ = syscall.Kill(os.Getpid(), syscall.SIGKILL)\n66\t\t\t\t}\n67\t\t\t\tif opts.killAfter > 0 {\n68\t\t\t\t\tkillTimer = time.AfterFunc(opts.killAfter, func() {\n69\t\t\t\t\t\tsendSignal(cmd, syscall.SIGKILL, opts.foreground)\n70\t\t\t\t\t})\n71\t\t\t\t}\n72\t\t\t})\n73\t\t}\n74\t\n75\t\twaitErr := cmd.Wait()\n76\t\tif timer != nil {\n77\t\t\ttimer.Stop()\n78\t\t}\n79\t\tif killTimer != nil {\n80\t\t\tkillTimer.Stop()\n81\t\t}\n82\t\n83\t\tif waitErr == nil {\n84\t\t\treturn 0\n85\t\t}\n86\t\n87\t\treturn exitCode(waitErr, timedOut, opts)\n88\t}\n89\t\n90\tfunc exitCode(waitErr error, timedOut bool, opts options) int {\n91\t\texitErr, ok := waitErr.(*exec.ExitError)\n92\t\tif !ok {\n93\t\t\tfmt.Fprintf(os.Stderr, \"timeout: %v\\n\", waitErr)\n94\t\t\treturn 125\n95\t\t}\n96\t\n97\t\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n98\t\tif !ok {\n99\t\t\treturn exitErr.ExitCode()\n100\t\t}\n101\t\n102\t\tif status.Signaled() {\n103\t\t\tsignum := int(status.Signal())\n104\t\t\tif timedOut && status.Signal() == opts.signal {\n105\t\t\t\tif opts.preserveStatus {\n106\t\t\t\t\treturn 128 + signum\n107\t\t\t\t}\n108\t\t\t\treturn 124\n109\t\t\t}\n110\t\t\treturn 128 + signum\n111\t\t}\n112\t\n113\t\treturn exitErr.ExitCode()\n114\t}\n115\t\n116\tfunc sendSignal(cmd *exec.Cmd, sig syscall.Signal, foreground bool) {\n117\t\tif foreground {\n118\t\t\t_ = cmd.Process.Signal(sig)\n119\t\t} else {\n120\t\t\t_ = syscall.Kill(-cmd.Process.Pid, sig)\n121\t\t}\n122\t}\n123\t\n124\tfunc parseArgs(args []string) (options, int) {\n125\t\topts := options{signal: syscall.SIGTERM, killAfter: 0}\n126\t\ti := 0\n127\t\n128\t\tfor i < len(args) {\n129\t\t\targ := args[i]\n130\t\t\tif arg == \"--\" {\n131\t\t\t\ti++\n132\t\t\t\tbreak\n133\t\t\t}\n134\t\t\tif !strings.HasPrefix(arg, \"-\") {\n135\t\t\t\tbreak\n136\t\t\t}\n137\t\t\tconsumed := parseLongFlag(arg, args, i, &opts)\n138\t\t\tif consumed < 0 {\n139\t\t\t\treturn opts, 125\n140\t\t\t}\n141\t\t\tif consumed > 0 {\n142\t\t\t\ti += consumed\n143\t\t\t\tcontinue\n144\t\t\t}\n145\t\t\tconsumed = parseShortFlags(arg, args, i, &opts)\n146\t\t\tif consumed < 0 {\n147\t\t\t\treturn opts, 125\n148\t\t\t}\n149\t\t\ti += consumed\n150\t\t}\n151\t\n152\t\tremaining := args[i:]\n153\t\tif len(remaining) < 2 {\n154\t\t\tfmt.Fprintf(os.Stderr, \"timeout: missing operand\\nTry 'timeout --help' for more information.\\n\")\n155\t\t\treturn opts, 125\n156\t\t}\n157\t\n158\t\tdur, err := parseDuration(remaining[0])\n159\t\tif err != nil {\n160\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", remaining[0])\n161\t\t\treturn opts, 125\n162\t\t}\n163\t\topts.duration = dur\n164\t\topts.cmdArgs = remaining[1:]\n165\t\treturn opts, -1\n166\t}\n167\t\n168\tfunc parseLongFlag(arg string, args []string, i int, opts *options) int {\n169\t\tswitch {\n170\t\tcase arg == \"--foreground\":\n171\t\t\topts.foreground = true\n172\t\t\treturn 1\n173\t\tcase arg == \"--preserve-status\":\n174\t\t\topts.preserveStatus = true\n175\t\t\treturn 1\n176\t\tcase arg == \"--signal\":\n177\t\t\treturn parseLongValue(\"--signal\", args, i, func(v string) int {\n178\t\t\t\treturn applySignal(v, opts)\n179\t\t\t})\n180\t\tcase strings.HasPrefix(arg, \"--signal=\"):\n181\t\t\treturn applySignal(arg[len(\"--signal=\"):], opts)\n182\t\tcase arg == \"--kill-after\":\n183\t\t\treturn parseLongValue(\"--kill-after\", args, i, func(v string) int {\n184\t\t\t\treturn applyKillAfter(v, opts)\n185\t\t\t})\n186\t\tcase strings.HasPrefix(arg, \"--kill-after=\"):\n187\t\t\treturn applyKillAfter(arg[len(\"--kill-after=\"):], opts)\n188\t\t}\n189\t\treturn 0\n190\t}\n191\t\n192\tfunc parseLongValue(name string, args []string, i int, apply func(string) int) int {\n193\t\tif i+1 >= len(args) {\n194\t\t\tfmt.Fprintf(os.Stderr, \"timeout: option %q requires an argument\\n\", name)\n195\t\t\treturn -1\n196\t\t}\n197\t\tresult := apply(args[i+1])\n198\t\tif result < 0 {\n199\t\t\treturn -1\n200\t\t}\n201\t\treturn 2\n202\t}\n203\t\n204\tfunc parseShortFlags(arg string, args []string, i int, opts *options) int {\n205\t\tflags := arg[1:]\n206\t\tfor j := 0; j < len(flags); j++ {\n207\t\t\tswitch flags[j] {\n208\t\t\tcase 's':\n209\t\t\t\treturn parseShortValue('s', flags[j+1:], args, i, func(v string) int {\n210\t\t\t\t\treturn applySignal(v, opts)\n211\t\t\t\t})\n212\t\t\tcase 'k':\n213\t\t\t\treturn parseShortValue('k', flags[j+1:], args, i, func(v string) int {\n214\t\t\t\t\treturn applyKillAfter(v, opts)\n215\t\t\t\t})\n216\t\t\tdefault:\n217\t\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid option -- '%c'\\n\", flags[j])\n218\t\t\t\treturn -1\n219\t\t\t}\n220\t\t}\n221\t\treturn 1\n222\t}\n223\t\n224\tfunc parseShortValue(flag byte, rest string, args []string, i int, apply func(string) int) int {\n225\t\tif rest != \"\" {\n226\t\t\tresult := apply(rest)\n227\t\t\tif result < 0 {\n228\t\t\t\treturn -1\n229\t\t\t}\n230\t\t\treturn 1\n231\t\t}\n232\t\tif i+1 >= len(args) {\n233\t\t\tfmt.Fprintf(os.Stderr, \"timeout: option requires an argument -- '%c'\\n\", flag)\n234\t\t\treturn -1\n235\t\t}\n236\t\tresult := apply(args[i+1])\n237\t\tif result < 0 {\n238\t\t\treturn -1\n239\t\t}\n240\t\treturn 2\n241\t}\n242\t\n243\tfunc applySignal(val string, opts *options) int {\n244\t\tsig, err := parseSignal(val)\n245\t\tif err != nil {\n246\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid signal %q\\n\", val)\n247\t\t\treturn -1\n248\t\t}\n249\t\topts.signal = sig\n250\t\treturn 1\n251\t}\n252\t\n253\tfunc applyKillAfter(val string, opts *options) int {\n254\t\tdur, err := parseDuration(val)\n255\t\tif err != nil {\n256\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", val)\n257\t\t\treturn -1\n258\t\t}\n259\t\topts.killAfter = dur\n260\t\treturn 1\n261\t}\n262\t\n263\tfunc parseSignal(s string) (syscall.Signal, error) {\n264\t\ts = strings.TrimPrefix(strings.ToUpper(s), \"SIG\")\n265\t\tif num, err := strconv.Atoi(s); err == nil {\n266\t\t\tif num < 0 {\n267\t\t\t\treturn 0, fmt.Errorf(\"invalid signal number: %d\", num)\n268\t\t\t}\n269\t\t\treturn syscall.Signal(num), nil\n270\t\t}\n271\t\tsig, ok := signalMap[s]\n272\t\tif !ok {\n273\t\t\treturn 0, fmt.Errorf(\"unknown signal: %s\", s)\n274\t\t}\n275\t\treturn sig, nil\n276\t}\n277\t\n278\tvar signalMap = map[string]syscall.Signal{\n279\t\t\"HUP\":    syscall.SIGHUP,\n280\t\t\"INT\":    syscall.SIGINT,\n281\t\t\"QUIT\":   syscall.SIGQUIT,\n282\t\t\"ILL\":    syscall.SIGILL,\n283\t\t\"TRAP\":   syscall.SIGTRAP,\n284\t\t\"ABRT\":   syscall.SIGABRT,\n285\t\t\"BUS\":    syscall.SIGBUS,\n286\t\t\"FPE\":    syscall.SIGFPE,\n287\t\t\"KILL\":   syscall.SIGKILL,\n288\t\t\"USR1\":   syscall.SIGUSR1,\n289\t\t\"SEGV\":   syscall.SIGSEGV,\n290\t\t\"USR2\":   syscall.SIGUSR2,\n291\t\t\"PIPE\":   syscall.SIGPIPE,\n292\t\t\"ALRM\":   syscall.SIGALRM,\n293\t\t\"TERM\":   syscall.SIGTERM,\n294\t\t\"CHLD\":   syscall.SIGCHLD,\n295\t\t\"CONT\":   syscall.SIGCONT,\n296\t\t\"STOP\":   syscall.SIGSTOP,\n297\t\t\"TSTP\":   syscall.SIGTSTP,\n298\t\t\"TTIN\":   syscall.SIGTTIN,\n299\t\t\"TTOU\":   syscall.SIGTTOU,\n300\t\t\"URG\":    syscall.SIGURG,\n301\t\t\"XCPU\":   syscall.SIGXCPU,\n302\t\t\"XFSZ\":   syscall.SIGXFSZ,\n303\t\t\"VTALRM\": syscall.SIGVTALRM,\n304\t\t\"PROF\":   syscall.SIGPROF,\n305\t\t\"WINCH\":  syscall.SIGWINCH,\n306\t\t\"IO\":     syscall.SIGIO,\n307\t\t\"SYS\":    syscall.SIGSYS,\n308\t}\n309\t\n310\tfunc parseDuration(s string) (time.Duration, error) {\n311\t\tif s == \"\" {\n312\t\t\treturn 0, fmt.Errorf(\"empty duration\")\n313\t\t}\n314\t\n315\t\tmultiplier := time.Second\n316\t\tnumStr := s\n317\t\n318\t\tif len(s) > 0 {\n319\t\t\tlast := s[len(s)-1]\n320\t\t\tswitch last {\n321\t\t\tcase 's':\n322\t\t\t\tmultiplier = time.Second\n323\t\t\t\tnumStr = s[:len(s)-1]\n324\t\t\tcase 'm':\n325\t\t\t\tmultiplier = time.Minute\n326\t\t\t\tnumStr = s[:len(s)-1]\n327\t\t\tcase 'h':\n328\t\t\t\tmultiplier = time.Hour\n329\t\t\t\tnumStr = s[:len(s)-1]\n330\t\t\tcase 'd':\n331\t\t\t\tmultiplier = 24 * time.Hour\n332\t\t\t\tnumStr = s[:len(s)-1]\n333\t\t\t}\n334\t\t}\n335\t\n336\t\tif numStr == \"\" {\n337\t\t\tnumStr = \"1\"\n338\t\t}\n339\t\n340\t\tval, err := strconv.ParseFloat(numStr, 64)\n341\t\tif err != nil {\n342\t\t\treturn 0, err\n343\t\t}\n344\t\n345\t\tif val < 0 {\n346\t\t\treturn 0, fmt.Errorf(\"negative duration\")\n347\t\t}\n348\t\n349\t\treturn time.Duration(val * float64(multiplier)), nil\n350\t}\n351\t\n352\tfunc isNotFound(err error) bool {\n353\t\treturn strings.Contains(err.Error(), exec.ErrNotFound.Error())\n354\t}\n355\t"}]},"parent_tool_use_id":null,"session_id":"b8854d2c-587c-4d04-b6c4-9a7d2677a20e","uuid":"be5796ea-2508-468b-902b-984aa1c1774f","timestamp":"2026-05-21T17:57:44.325Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5430/cmd/timeout/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype options struct {\n\tsignal         syscall.Signal\n\tkillAfter      time.Duration\n\tforeground     bool\n\tpreserveStatus bool\n\tduration       time.Duration\n\tcmdArgs        []string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, exitCode := parseArgs(os.Args[1:])\n\tif exitCode >= 0 {\n\t\tos.Exit(exitCode)\n\t}\n\n\tcmd := exec.Command(opts.cmdArgs[0], opts.cmdArgs[1:]...)\n\tcmd.Stdin = os.Stdin\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\tif !opts.foreground {\n\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n\t}\n\n\tif err := cmd.Start(); err != nil {\n\t\tif isNotFound(err) {\n\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", opts.cmdArgs[0], err)\n\t\t\tos.Exit(127)\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", opts.cmdArgs[0], err)\n\t\tos.Exit(126)\n\t}\n\n\tos.Exit(runWithTimeout(cmd, opts))\n}\n\nfunc runWithTimeout(cmd *exec.Cmd, opts options) int {\n\ttimedOut := false\n\tvar timer *time.Timer\n\tvar killTimer *time.Timer\n\n\tif opts.duration > 0 {\n\t\ttimer = time.AfterFunc(opts.duration, func() {\n\t\t\ttimedOut = true\n\t\t\tsendSignal(cmd, opts.signal, opts.foreground)\n\t\t\tif opts.signal == syscall.SIGKILL {\n\t\t\t\t_ = syscall.Kill(os.Getpid(), syscall.SIGKILL)\n\t\t\t}\n\t\t\tif opts.killAfter > 0 {\n\t\t\t\tkillTimer = time.AfterFunc(opts.killAfter, func() {\n\t\t\t\t\tsendSignal(cmd, syscall.SIGKILL, opts.foreground)\n\t\t\t\t})\n\t\t\t}\n\t\t})\n\t}\n\n\twaitErr := cmd.Wait()\n\tif timer != nil {\n\t\ttimer.Stop()\n\t}\n\tif killTimer != nil {\n\t\tkillTimer.Stop()\n\t}\n\n\tif waitErr == nil {\n\t\treturn 0\n\t}\n\n\treturn exitCode(waitErr, timedOut, opts)\n}\n\nfunc exitCode(waitErr error, timedOut bool, opts options) int {\n\texitErr, ok := waitErr.(*exec.ExitError)\n\tif !ok {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: %v\\n\", waitErr)\n\t\treturn 125\n\t}\n\n\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n\tif !ok {\n\t\treturn exitErr.ExitCode()\n\t}\n\n\tif status.Signaled() {\n\t\tsignum := int(status.Signal())\n\t\tif timedOut && status.Signal() == opts.signal {\n\t\t\tif opts.preserveStatus {\n\t\t\t\treturn 128 + signum\n\t\t\t}\n\t\t\treturn 124\n\t\t}\n\t\treturn 128 + signum\n\t}\n\n\treturn exitErr.ExitCode()\n}\n\nfunc sendSignal(cmd *exec.Cmd, sig syscall.Signal, foreground bool) {\n\tif foreground {\n\t\t_ = cmd.Process.Signal(sig)\n\t} else {\n\t\t_ = syscall.Kill(-cmd.Process.Pid, sig)\n\t}\n}\n\nfunc parseArgs(args []string) (options, int) {\n\topts := options{signal: syscall.SIGTERM, killAfter: 0}\n\ti := 0\n\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ti++\n\t\t\tbreak\n\t\t}\n\t\tif !strings.HasPrefix(arg, \"-\") {\n\t\t\tbreak\n\t\t}\n\t\tconsumed := parseLongFlag(arg, args, i, &opts)\n\t\tif consumed < 0 {\n\t\t\treturn opts, 125\n\t\t}\n\t\tif consumed > 0 {\n\t\t\ti += consumed\n\t\t\tcontinue\n\t\t}\n\t\tconsumed = parseShortFlags(arg, args, i, &opts)\n\t\tif consumed < 0 {\n\t\t\treturn opts, 125\n\t\t}\n\t\ti += consumed\n\t}\n\n\tremaining := args[i:]\n\tif len(remaining) < 2 {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: missing operand\\nTry 'timeout --help' for more information.\\n\")\n\t\treturn opts, 125\n\t}\n\n\tdur, err := parseDuration(remaining[0])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", remaining[0])\n\t\treturn opts, 125\n\t}\n\topts.duration = dur\n\topts.cmdArgs = remaining[1:]\n\treturn opts, -1\n}\n\nfunc parseLongFlag(arg string, args []string, i int, opts *options) int {\n\tswitch {\n\tcase arg == \"--foreground\":\n\t\topts.foreground = true\n\t\treturn 1\n\tcase arg == \"--preserve-status\":\n\t\topts.preserveStatus = true\n\t\treturn 1\n\tcase arg == \"--signal\":\n\t\treturn parseLongValue(\"--signal\", args, i, func(v string) int {\n\t\t\treturn applySignal(v, opts)\n\t\t})\n\tcase strings.HasPrefix(arg, \"--signal=\"):\n\t\treturn applySignal(arg[len(\"--signal=\"):], opts)\n\tcase arg == \"--kill-after\":\n\t\treturn parseLongValue(\"--kill-after\", args, i, func(v string) int {\n\t\t\treturn applyKillAfter(v, opts)\n\t\t})\n\tcase strings.HasPrefix(arg, \"--kill-after=\"):\n\t\treturn applyKillAfter(arg[len(\"--kill-after=\"):], opts)\n\t}\n\treturn 0\n}\n\nfunc parseLongValue(name string, args []string, i int, apply func(string) int) int {\n\tif i+1 >= len(args) {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: option %q requires an argument\\n\", name)\n\t\treturn -1\n\t}\n\tresult := apply(args[i+1])\n\tif result < 0 {\n\t\treturn -1\n\t}\n\treturn 2\n}\n\nfunc parseShortFlags(arg string, args []string, i int, opts *options) int {\n\tflags := arg[1:]\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 's':\n\t\t\treturn parseShortValue('s', flags[j+1:], args, i, func(v string) int {\n\t\t\t\treturn applySignal(v, opts)\n\t\t\t})\n\t\tcase 'k':\n\t\t\treturn parseShortValue('k', flags[j+1:], args, i, func(v string) int {\n\t\t\t\treturn applyKillAfter(v, opts)\n\t\t\t})\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid option -- '%c'\\n\", flags[j])\n\t\t\treturn -1\n\t\t}\n\t}\n\treturn 1\n}\n\nfunc parseShortValue(flag byte, rest string, args []string, i int, apply func(string) int) int {\n\tif rest != \"\" {\n\t\tresult := apply(rest)\n\t\tif result < 0 {\n\t\t\treturn -1\n\t\t}\n\t\treturn 1\n\t}\n\tif i+1 >= len(args) {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: option requires an argument -- '%c'\\n\", flag)\n\t\treturn -1\n\t}\n\tresult := apply(args[i+1])\n\tif result < 0 {\n\t\treturn -1\n\t}\n\treturn 2\n}\n\nfunc applySignal(val string, opts *options) int {\n\tsig, err := parseSignal(val)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid signal %q\\n\", val)\n\t\treturn -1\n\t}\n\topts.signal = sig\n\treturn 1\n}\n\nfunc applyKillAfter(val string, opts *options) int {\n\tdur, err := parseDuration(val)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", val)\n\t\treturn -1\n\t}\n\topts.killAfter = dur\n\treturn 1\n}\n\nfunc parseSignal(s string) (syscall.Signal, error) {\n\ts = strings.TrimPrefix(strings.ToUpper(s), \"SIG\")\n\tif num, err := strconv.Atoi(s); err == nil {\n\t\tif num < 0 {\n\t\t\treturn 0, fmt.Errorf(\"invalid signal number: %d\", num)\n\t\t}\n\t\treturn syscall.Signal(num), nil\n\t}\n\tsig, ok := signalMap[s]\n\tif !ok {\n\t\treturn 0, fmt.Errorf(\"unknown signal: %s\", s)\n\t}\n\treturn sig, nil\n}\n\nvar signalMap = map[string]syscall.Signal{\n\t\"HUP\":    syscall.SIGHUP,\n\t\"INT\":    syscall.SIGINT,\n\t\"QUIT\":   syscall.SIGQUIT,\n\t\"ILL\":    syscall.SIGILL,\n\t\"TRAP\":   syscall.SIGTRAP,\n\t\"ABRT\":   syscall.SIGABRT,\n\t\"BUS\":    syscall.SIGBUS,\n\t\"FPE\":    syscall.SIGFPE,\n\t\"KILL\":   syscall.SIGKILL,\n\t\"USR1\":   syscall.SIGUSR1,\n\t\"SEGV\":   syscall.SIGSEGV,\n\t\"USR2\":   syscall.SIGUSR2,\n\t\"PIPE\":   syscall.SIGPIPE,\n\t\"ALRM\":   syscall.SIGALRM,\n\t\"TERM\":   syscall.SIGTERM,\n\t\"CHLD\":   syscall.SIGCHLD,\n\t\"CONT\":   syscall.SIGCONT,\n\t\"STOP\":   syscall.SIGSTOP,\n\t\"TSTP\":   syscall.SIGTSTP,\n\t\"TTIN\":   syscall.SIGTTIN,\n\t\"TTOU\":   syscall.SIGTTOU,\n\t\"URG\":    syscall.SIGURG,\n\t\"XCPU\":   syscall.SIGXCPU,\n\t\"XFSZ\":   syscall.SIGXFSZ,\n\t\"VTALRM\": syscall.SIGVTALRM,\n\t\"PROF\":   syscall.SIGPROF,\n\t\"WINCH\":  syscall.SIGWINCH,\n\t\"IO\":     syscall.SIGIO,\n\t\"SYS\":    syscall.SIGSYS,\n}\n\nfunc parseDuration(s string) (time.Duration, error) {\n\tif s == \"\" {\n\t\treturn 0, fmt.Errorf(\"empty duration\")\n\t}\n\n\tmultiplier := time.Second\n\tnumStr := s\n\n\tif len(s) > 0 {\n\t\tlast := s[len(s)-1]\n\t\tswitch last {\n\t\tcase 's':\n\t\t\tmultiplier = time.Second\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'm':\n\t\t\tmultiplier = time.Minute\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'h':\n\t\t\tmultiplier = time.Hour\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'd':\n\t\t\tmultiplier = 24 * time.Hour\n\t\t\tnumStr = s[:len(s)-1]\n\t\t}\n\t}\n\n\tif numStr == \"\" {\n\t\tnumStr = \"1\"\n\t}\n\n\tval, err := strconv.ParseFloat(numStr, 64)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\tif val < 0 {\n\t\treturn 0, fmt.Errorf(\"negative duration\")\n\t}\n\n\treturn time.Duration(val * float64(multiplier)), nil\n}\n\nfunc isNotFound(err error) bool {\n\treturn strings.Contains(err.Error(), exec.ErrNotFound.Error())\n}\n","numLines":355,"startLine":1,"totalLines":355}}}
