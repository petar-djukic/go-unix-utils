fter > 0 {\n68\t\t\t\t\tkillTimer = time.AfterFunc(opts.killAfter, func() {\n69\t\t\t\t\t\tsendSignal(cmd, syscall.SIGKILL, opts.foreground)\n70\t\t\t\t\t})\n71\t\t\t\t}\n72\t\t\t})\n73\t\t}\n74\t\n75\t\twaitErr := cmd.Wait()\n76\t\tif timer != nil {\n77\t\t\ttimer.Stop()\n78\t\t}\n79\t\tif killTimer != nil {\n80\t\t\tkillTimer.Stop()\n81\t\t}\n82\t\n83\t\tif waitErr == nil {\n84\t\t\treturn 0\n85\t\t}\n86\t\n87\t\treturn exitCode(waitErr, timedOut, opts)\n88\t}\n89\t\n90\tfunc exitCode(waitErr error, timedOut bool, opts options) int {\n91\t\texitErr, ok := waitErr.(*exec.ExitError)\n92\t\tif !ok {\n93\t\t\tfmt.Fprintf(os.Stderr, \"timeout: %v\\n\", waitErr)\n94\t\t\treturn 125\n95\t\t}\n96\t\n97\t\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n98\t\tif !ok {\n99\t\t\treturn exitErr.ExitCode()\n100\t\t}\n101\t\n102\t\tif status.Signaled() {\n103\t\t\tsignum := int(status.Signal())\n104\t\t\tif timedOut && status.Signal() == opts.signal {\n105\t\t\t\tif opts.preserveStatus {\n106\t\t\t\t\treturn 128 + signum\n107\t\t\t\t}\n108\t\t\t\treturn 124\n109\t\t\t}\n110\t\t\treraiseSignal(status.Signal())\n111\t\t\treturn 128 + signum\n112\t\t}\n113\t\n114\t\treturn exitErr.ExitCode()\n115\t}\n116\t\n117\tfunc sendSignal(cmd *exec.Cmd, sig syscall.Signal, foreground bool) {\n118\t\tif foreground {\n119\t\t\t_ = cmd.Process.Signal(sig)\n120\t\t} else {\n121\t\t\t_ = syscall.Kill(-cmd.Process.Pid, sig)\n122\t\t}\n123\t}\n124\t\n125\tfunc reraiseSignal(sig syscall.Signal) {\n126\t\tsyscall.Exec(\"/bin/sh\", []string{\"sh\", \"-c\",\n127\t\t\tfmt.Sprintf(\"kill -%d $$\", sig)}, os.Environ())\n128\t}\n129\t\n130\tfunc parseArgs(args []string) (options, int) {\n131\t\topts := options{signal: syscall.SIGTERM, killAfter: 0}\n132\t\ti := 0\n133\t\n134\t\tfor i < len(args) {\n135\t\t\targ := args[i]\n136\t\t\tif arg == \"--\" {\n137\t\t\t\ti++\n138\t\t\t\tbreak\n139\t\t\t}\n140\t\t\tif !strings.HasPrefix(arg, \"-\") {\n141\t\t\t\tbreak\n142\t\t\t}\n143\t\t\tconsumed := parseLongFlag(arg, args, i, &opts)\n144\t\t\tif consumed < 0 {\n145\t\t\t\treturn opts, 125\n146\t\t\t}\n147\t\t\tif consumed > 0 {\n148\t\t\t\ti += consumed\n149\t\t\t\tcontinue\n150\t\t\t}\n151\t\t\tconsumed = parseShortFlags(arg, args, i, &opts)\n152\t\t\tif consumed < 0 {\n153\t\t\t\treturn opts, 125\n154\t\t\t}\n155\t\t\ti += consumed\n156\t\t}\n157\t\n158\t\tremaining := args[i:]\n159\t\tif len(remaining) < 2 {\n160\t\t\tfmt.Fprintf(os.Stderr, \"timeout: missing operand\\nTry 'timeout --help' for more information.\\n\")\n161\t\t\treturn opts, 125\n162\t\t}\n163\t\n164\t\tdur, err := parseDuration(remaining[0])\n165\t\tif err != nil {\n166\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", remaining[0])\n167\t\t\treturn opts, 125\n168\t\t}\n169\t\topts.duration = dur\n170\t\topts.cmdArgs = remaining[1:]\n171\t\treturn opts, -1\n172\t}\n173\t\n174\tfunc parseLongFlag(arg string, args []string, i int, opts *options) int {\n175\t\tswitch {\n176\t\tcase arg == \"--foreground\":\n177\t\t\topts.foreground = true\n178\t\t\treturn 1\n179\t\tcase arg == \"--preserve-status\":\n180\t\t\topts.preserveStatus = true\n181\t\t\treturn 1\n182\t\tcase arg == \"--signal\":\n183\t\t\treturn parseLongValue(\"--signal\", args, i, func(v string) int {\n184\t\t\t\treturn applySignal(v, opts)\n185\t\t\t})\n186\t\tcase strings.HasPrefix(arg, \"--signal=\"):\n187\t\t\treturn applySignal(arg[len(\"--signal=\"):], opts)\n188\t\tcase arg == \"--kill-after\":\n189\t\t\treturn parseLongValue(\"--kill-after\", args, i, func(v string) int {\n190\t\t\t\treturn applyKillAfter(v, opts)\n191\t\t\t})\n192\t\tcase strings.HasPrefix(arg, \"--kill-after=\"):\n193\t\t\treturn applyKillAfter(arg[len(\"--kill-after=\"):], opts)\n194\t\t}\n195\t\treturn 0\n196\t}\n197\t\n198\tfunc parseLongValue(name string, args []string, i int, apply func(string) int) int {\n199\t\tif i+1 >= len(args) {\n200\t\t\tfmt.Fprintf(os.Stderr, \"timeout: option %q requires an argument\\n\", name)\n201\t\t\treturn -1\n202\t\t}\n203\t\tresult := apply(args[i+1])\n204\t\tif result < 0 {\n205\t\t\treturn -1\n206\t\t}\n207\t\treturn 2\n208\t}\n209\t\n210\tfunc parseShortFlags(arg string, args []string, i int, opts *options) int {\n211\t\tflags := arg[1:]\n212\t\tfor j := 0; j < len(flags); j++ {\n213\t\t\tswitch flags[j] {\n214\t\t\tcase 's':\n215\t\t\t\treturn parseShortValue('s', flags[j+1:], args, i, func(v string) int {\n216\t\t\t\t\treturn applySignal(v, opts)\n217\t\t\t\t})\n218\t\t\tcase 'k':\n219\t\t\t\treturn parseShortValue('k', flags[j+1:], args, i, func(v string) int {\n220\t\t\t\t\treturn applyKillAfter(v, opts)\n221\t\t\t\t})\n222\t\t\tdefault:\n223\t\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid option -- '%c'\\n\", flags[j])\n224\t\t\t\treturn -1\n225\t\t\t}\n226\t\t}\n227\t\treturn 1\n228\t}\n229\t\n230\tfunc parseShortValue(flag byte, rest string, args []string, i int, apply func(string) int) int {\n231\t\tif rest != \"\" {\n232\t\t\tresult := apply(rest)\n233\t\t\tif result < 0 {\n234\t\t\t\treturn -1\n235\t\t\t}\n236\t\t\treturn 1\n237\t\t}\n238\t\tif i+1 >= len(args) {\n239\t\t\tfmt.Fprintf(os.Stderr, \"timeout: option requires an argument -- '%c'\\n\", flag)\n240\t\t\treturn -1\n241\t\t}\n242\t\tresult := apply(args[i+1])\n243\t\tif result < 0 {\n244\t\t\treturn -1\n245\t\t}\n246\t\treturn 2\n247\t}\n248\t\n249\tfunc applySignal(val string, opts *options) int {\n250\t\tsig, err := parseSignal(val)\n251\t\tif err != nil {\n252\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid signal %q\\n\", val)\n253\t\t\treturn -1\n254\t\t}\n255\t\topts.signal = sig\n256\t\treturn 1\n257\t}\n258\t\n259\tfunc applyKillAfter(val string, opts *options) int {\n260\t\tdur, err := parseDuration(val)\n261\t\tif err != nil {\n262\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", val)\n263\t\t\treturn -1\n264\t\t}\n265\t\topts.killAfter = dur\n266\t\treturn 1\n267\t}\n268\t\n269\tfunc parseSignal(s string) (syscall.Signal, error) {\n270\t\ts = strings.TrimPrefix(strings.ToUpper(s), \"SIG\")\n271\t\tif num, err := strconv.Atoi(s); err == nil {\n272\t\t\tif num < 0 {\n273\t\t\t\treturn 0, fmt.Errorf(\"invalid signal number: %d\", num)\n274\t\t\t}\n275\t\t\treturn syscall.Signal(num), nil\n276\t\t}\n277\t\tsig, ok := signalMap[s]\n278\t\tif !ok {\n279\t\t\treturn 0, fmt.Errorf(\"unknown signal: %s\", s)\n280\t\t}\n281\t\treturn sig, nil\n282\t}\n283\t\n284\tvar signalMap = map[string]syscall.Signal{\n285\t\t\"HUP\":    syscall.SIGHUP,\n286\t\t\"INT\":    syscall.SIGINT,\n287\t\t\"QUIT\":   syscall.SIGQUIT,\n288\t\t\"ILL\":    syscall.SIGILL,\n289\t\t\"TRAP\":   syscall.SIGTRAP,\n290\t\t\"ABRT\":   syscall.SIGABRT,\n291\t\t\"BUS\":    syscall.SIGBUS,\n292\t\t\"FPE\":    syscall.SIGFPE,\n293\t\t\"KILL\":   syscall.SIGKILL,\n294\t\t\"USR1\":   syscall.SIGUSR1,\n295\t\t\"SEGV\":   syscall.SIGSEGV,\n296\t\t\"USR2\":   syscall.SIGUSR2,\n297\t\t\"PIPE\":   syscall.SIGPIPE,\n298\t\t\"ALRM\":   syscall.SIGALRM,\n299\t\t\"TERM\":   syscall.SIGTERM,\n300\t\t\"CHLD\":   syscall.SIGCHLD,\n301\t\t\"CONT\":   syscall.SIGCONT,\n302\t\t\"STOP\":   syscall.SIGSTOP,\n303\t\t\"TSTP\":   syscall.SIGTSTP,\n304\t\t\"TTIN\":   syscall.SIGTTIN,\n305\t\t\"TTOU\":   syscall.SIGTTOU,\n306\t\t\"URG\":    syscall.SIGURG,\n307\t\t\"XCPU\":   syscall.SIGXCPU,\n308\t\t\"XFSZ\":   syscall.SIGXFSZ,\n309\t\t\"VTALRM\": syscall.SIGVTALRM,\n310\t\t\"PROF\":   syscall.SIGPROF,\n311\t\t\"WINCH\":  syscall.SIGWINCH,\n312\t\t\"IO\":     syscall.SIGIO,\n313\t\t\"SYS\":    syscall.SIGSYS,\n314\t}\n315\t\n316\tfunc parseDuration(s string) (time.Duration, error) {\n317\t\tif s == \"\" {\n318\t\t\treturn 0, fmt.Errorf(\"empty duration\")\n319\t\t}\n320\t\n321\t\tmultiplier := time.Second\n322\t\tnumStr := s\n323\t\n324\t\tif len(s) > 0 {\n325\t\t\tlast := s[len(s)-1]\n326\t\t\tswitch last {\n327\t\t\tcase 's':\n328\t\t\t\tmultiplier = time.Second\n329\t\t\t\tnumStr = s[:len(s)-1]\n330\t\t\tcase 'm':\n331\t\t\t\tmultiplier = time.Minute\n332\t\t\t\tnumStr = s[:len(s)-1]\n333\t\t\tcase 'h':\n334\t\t\t\tmultiplier = time.Hour\n335\t\t\t\tnumStr = s[:len(s)-1]\n336\t\t\tcase 'd':\n337\t\t\t\tmultiplier = 24 * time.Hour\n338\t\t\t\tnumStr = s[:len(s)-1]\n339\t\t\t}\n340\t\t}\n341\t\n342\t\tif numStr == \"\" {\n343\t\t\tnumStr = \"1\"\n344\t\t}\n345\t\n346\t\tval, err := strconv.ParseFloat(numStr, 64)\n347\t\tif err != nil {\n348\t\t\treturn 0, err\n349\t\t}\n350\t\n351\t\tif val < 0 {\n352\t\t\treturn 0, fmt.Errorf(\"negative duration\")\n353\t\t}\n354\t\n355\t\treturn time.Duration(val * float64(multiplier)), nil\n356\t}\n357\t\n358\tfunc isNotFound(err error) bool {\n359\t\treturn strings.Contains(err.Error(), exec.ErrNotFound.Error())\n360\t}\n361\t"}]},"parent_tool_use_id":null,"session_id":"b8854d2c-587c-4d04-b6c4-9a7d2677a20e","uuid":"ca75dfec-5d16-4f96-9195-b87b0f124921","timestamp":"2026-05-21T18:15:24.777Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5430/cmd/timeout/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype options struct {\n\tsignal         syscall.Signal\n\tkillAfter      time.Duration\n\tforeground     bool\n\tpreserveStatus bool\n\tduration       time.Duration\n\tcmdArgs        []string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, exitCode := parseArgs(os.Args[1:])\n\tif exitCode >= 0 {\n\t\tos.Exit(exitCode)\n\t}\n\n\tcmd := exec.Command(opts.cmdArgs[0], opts.cmdArgs[1:]...)\n\tcmd.Stdin = os.Stdin\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\tif !opts.foreground {\n\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n\t}\n\n\tif err := cmd.Start(); err != nil {\n\t\tif isNotFound(err) {\n\t\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", opts.cmdArgs[0], err)\n\t\t\tos.Exit(127)\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, \"timeout: failed to run command %q: %v\\n\", opts.cmdArgs[0], err)\n\t\tos.Exit(126)\n\t}\n\n\tos.Exit(runWithTimeout(cmd, opts))\n}\n\nfunc runWithTimeout(cmd *exec.Cmd, opts options) int {\n\ttimedOut := false\n\tvar timer *time.Timer\n\tvar killTimer *time.Timer\n\n\tif opts.duration > 0 {\n\t\ttimer = time.AfterFunc(opts.duration, func() {\n\t\t\ttimedOut = true\n\t\t\tsendSignal(cmd, opts.signal, opts.foreground)\n\t\t\tif opts.signal == syscall.SIGKILL {\n\t\t\t\t_ = syscall.Kill(os.Getpid(), syscall.SIGKILL)\n\t\t\t}\n\t\t\tif opts.killAfter > 0 {\n\t\t\t\tkillTimer = time.AfterFunc(opts.killAfter, func() {\n\t\t\t\t\tsendSignal(cmd, syscall.SIGKILL, opts.foreground)\n\t\t\t\t})\n\t\t\t}\n\t\t})\n\t}\n\n\twaitErr := cmd.Wait()\n\tif timer != nil {\n\t\ttimer.Stop()\n\t}\n\tif killTimer != nil {\n\t\tkillTimer.Stop()\n\t}\n\n\tif waitErr == nil {\n\t\treturn 0\n\t}\n\n\treturn exitCode(waitErr, timedOut, opts)\n}\n\nfunc exitCode(waitErr error, timedOut bool, opts options) int {\n\texitErr, ok := waitErr.(*exec.ExitError)\n\tif !ok {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: %v\\n\", waitErr)\n\t\treturn 125\n\t}\n\n\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n\tif !ok {\n\t\treturn exitErr.ExitCode()\n\t}\n\n\tif status.Signaled() {\n\t\tsignum := int(status.Signal())\n\t\tif timedOut && status.Signal() == opts.signal {\n\t\t\tif opts.preserveStatus {\n\t\t\t\treturn 128 + signum\n\t\t\t}\n\t\t\treturn 124\n\t\t}\n\t\treraiseSignal(status.Signal())\n\t\treturn 128 + signum\n\t}\n\n\treturn exitErr.ExitCode()\n}\n\nfunc sendSignal(cmd *exec.Cmd, sig syscall.Signal, foreground bool) {\n\tif foreground {\n\t\t_ = cmd.Process.Signal(sig)\n\t} else {\n\t\t_ = syscall.Kill(-cmd.Process.Pid, sig)\n\t}\n}\n\nfunc reraiseSignal(sig syscall.Signal) {\n\tsyscall.Exec(\"/bin/sh\", []string{\"sh\", \"-c\",\n\t\tfmt.Sprintf(\"kill -%d $$\", sig)}, os.Environ())\n}\n\nfunc parseArgs(args []string) (options, int) {\n\topts := options{signal: syscall.SIGTERM, killAfter: 0}\n\ti := 0\n\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ti++\n\t\t\tbreak\n\t\t}\n\t\tif !strings.HasPrefix(arg, \"-\") {\n\t\t\tbreak\n\t\t}\n\t\tconsumed := parseLongFlag(arg, args, i, &opts)\n\t\tif consumed < 0 {\n\t\t\treturn opts, 125\n\t\t}\n\t\tif consumed > 0 {\n\t\t\ti += consumed\n\t\t\tcontinue\n\t\t}\n\t\tconsumed = parseShortFlags(arg, args, i, &opts)\n\t\tif consumed < 0 {\n\t\t\treturn opts, 125\n\t\t}\n\t\ti += consumed\n\t}\n\n\tremaining := args[i:]\n\tif len(remaining) < 2 {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: missing operand\\nTry 'timeout --help' for more information.\\n\")\n\t\treturn opts, 125\n\t}\n\n\tdur, err := parseDuration(remaining[0])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", remaining[0])\n\t\treturn opts, 125\n\t}\n\topts.duration = dur\n\topts.cmdArgs = remaining[1:]\n\treturn opts, -1\n}\n\nfunc parseLongFlag(arg string, args []string, i int, opts *options) int {\n\tswitch {\n\tcase arg == \"--foreground\":\n\t\topts.foreground = true\n\t\treturn 1\n\tcase arg == \"--preserve-status\":\n\t\topts.preserveStatus = true\n\t\treturn 1\n\tcase arg == \"--signal\":\n\t\treturn parseLongValue(\"--signal\", args, i, func(v string) int {\n\t\t\treturn applySignal(v, opts)\n\t\t})\n\tcase strings.HasPrefix(arg, \"--signal=\"):\n\t\treturn applySignal(arg[len(\"--signal=\"):], opts)\n\tcase arg == \"--kill-after\":\n\t\treturn parseLongValue(\"--kill-after\", args, i, func(v string) int {\n\t\t\treturn applyKillAfter(v, opts)\n\t\t})\n\tcase strings.HasPrefix(arg, \"--kill-after=\"):\n\t\treturn applyKillAfter(arg[len(\"--kill-after=\"):], opts)\n\t}\n\treturn 0\n}\n\nfunc parseLongValue(name string, args []string, i int, apply func(string) int) int {\n\tif i+1 >= len(args) {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: option %q requires an argument\\n\", name)\n\t\treturn -1\n\t}\n\tresult := apply(args[i+1])\n\tif result < 0 {\n\t\treturn -1\n\t}\n\treturn 2\n}\n\nfunc parseShortFlags(arg string, args []string, i int, opts *options) int {\n\tflags := arg[1:]\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 's':\n\t\t\treturn parseShortValue('s', flags[j+1:], args, i, func(v string) int {\n\t\t\t\treturn applySignal(v, opts)\n\t\t\t})\n\t\tcase 'k':\n\t\t\treturn parseShortValue('k', flags[j+1:], args, i, func(v string) int {\n\t\t\t\treturn applyKillAfter(v, opts)\n\t\t\t})\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid option -- '%c'\\n\", flags[j])\n\t\t\treturn -1\n\t\t}\n\t}\n\treturn 1\n}\n\nfunc parseShortValue(flag byte, rest string, args []string, i int, apply func(string) int) int {\n\tif rest != \"\" {\n\t\tresult := apply(rest)\n\t\tif result < 0 {\n\t\t\treturn -1\n\t\t}\n\t\treturn 1\n\t}\n\tif i+1 >= len(args) {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: option requires an argument -- '%c'\\n\", flag)\n\t\treturn -1\n\t}\n\tresult := apply(args[i+1])\n\tif result < 0 {\n\t\treturn -1\n\t}\n\treturn 2\n}\n\nfunc applySignal(val string, opts *options) int {\n\tsig, err := parseSignal(val)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid signal %q\\n\", val)\n\t\treturn -1\n\t}\n\topts.signal = sig\n\treturn 1\n}\n\nfunc applyKillAfter(val string, opts *options) int {\n\tdur, err := parseDuration(val)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"timeout: invalid time interval %q\\n\", val)\n\t\treturn -1\n\t}\n\topts.killAfter = dur\n\treturn 1\n}\n\nfunc parseSignal(s string) (syscall.Signal, error) {\n\ts = strings.TrimPrefix(strings.ToUpper(s), \"SIG\")\n\tif num, err := strconv.Atoi(s); err == nil {\n\t\tif num < 0 {\n\t\t\treturn 0, fmt.Errorf(\"invalid signal number: %d\", num)\n\t\t}\n\t\treturn syscall.Signal(num), nil\n\t}\n\tsig, ok := signalMap[s]\n\tif !ok {\n\t\treturn 0, fmt.Errorf(\"unknown signal: %s\", s)\n\t}\n\treturn sig, nil\n}\n\nvar signalMap = map[string]syscall.Signal{\n\t\"HUP\":    syscall.SIGHUP,\n\t\"INT\":    syscall.SIGINT,\n\t\"QUIT\":   syscall.SIGQUIT,\n\t\"ILL\":    syscall.SIGILL,\n\t\"TRAP\":   syscall.SIGTRAP,\n\t\"ABRT\":   syscall.SIGABRT,\n\t\"BUS\":    syscall.SIGBUS,\n\t\"FPE\":    syscall.SIGFPE,\n\t\"KILL\":   syscall.SIGKILL,\n\t\"USR1\":   syscall.SIGUSR1,\n\t\"SEGV\":   syscall.SIGSEGV,\n\t\"USR2\":   syscall.SIGUSR2,\n\t\"PIPE\":   syscall.SIGPIPE,\n\t\"ALRM\":   syscall.SIGALRM,\n\t\"TERM\":   syscall.SIGTERM,\n\t\"CHLD\":   syscall.SIGCHLD,\n\t\"CONT\":   syscall.SIGCONT,\n\t\"STOP\":   syscall.SIGSTOP,\n\t\"TSTP\":   syscall.SIGTSTP,\n\t\"TTIN\":   syscall.SIGTTIN,\n\t\"TTOU\":   syscall.SIGTTOU,\n\t\"URG\":    syscall.SIGURG,\n\t\"XCPU\":   syscall.SIGXCPU,\n\t\"XFSZ\":   syscall.SIGXFSZ,\n\t\"VTALRM\": syscall.SIGVTALRM,\n\t\"PROF\":   syscall.SIGPROF,\n\t\"WINCH\":  syscall.SIGWINCH,\n\t\"IO\":     syscall.SIGIO,\n\t\"SYS\":    syscall.SIGSYS,\n}\n\nfunc parseDuration(s string) (time.Duration, error) {\n\tif s == \"\" {\n\t\treturn 0, fmt.Errorf(\"empty duration\")\n\t}\n\n\tmultiplier := time.Second\n\tnumStr := s\n\n\tif len(s) > 0 {\n\t\tlast := s[len(s)-1]\n\t\tswitch last {\n\t\tcase 's':\n\t\t\tmultiplier = time.Second\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'm':\n\t\t\tmultiplier = time.Minute\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'h':\n\t\t\tmultiplier = time.Hour\n\t\t\tnumStr = s[:len(s)-1]\n\t\tcase 'd':\n\t\t\tmultiplier = 24 * time.Hour\n\t\t\tnumStr = s[:len(s)-1]\n\t\t}\n\t}\n\n\tif numStr == \"\" {\n\t\tnumStr = \"1\"\n\t}\n\n\tval, err := strconv.ParseFloat(numStr, 64)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\n\tif val < 0 {\n\t\treturn 0, fmt.Errorf(\"negative duration\")\n\t}\n\n\treturn time.Duration(val * float64(multiplier)), nil\n}\n\nfunc isNotFound(err error) bool {\n\treturn strings.Contains(err.Error(), exec.ErrNotFound.Error())\n}\n","numLines":361,"startLine":1,"totalLines":361}}}
