{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013hnQGSntyar7Z7TQHD9BBg","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage sys\n5\t\n6\timport (\n7\t\t\"os\"\n8\t\t\"os/signal\"\n9\t\t\"sync\"\n10\t\t\"syscall\"\n11\t)\n12\t\n13\tvar (\n14\t\tresizeMu        sync.Mutex\n15\t\tresizeCallbacks  []func(width int)\n16\t\tresizeSetupOnce  sync.Once\n17\t)\n18\t\n19\t// OnTerminalResize registers a callback invoked with the new terminal width\n20\t// when a SIGWINCH signal is received.\n21\t// R3.1: calls TerminalWidth() on SIGWINCH and invokes callback with the new width.\n22\t// R3.2: supports multiple callbacks called in registration order.\n23\tfunc OnTerminalResize(callback func(width int)) {\n24\t\tresizeMu.Lock()\n25\t\tresizeCallbacks = append(resizeCallbacks, callback)\n26\t\tresizeMu.Unlock()\n27\t\n28\t\tresizeSetupOnce.Do(startResizeListener)\n29\t}\n30\t\n31\tfunc startResizeListener() {\n32\t\tc := make(chan os.Signal, 1)\n33\t\tsignal.Notify(c, syscall.SIGWINCH)\n34\t\tgo handleResizeSignals(c)\n35\t}\n36\t\n37\tfunc handleResizeSignals(c <-chan os.Signal) {\n38\t\tfor range c {\n39\t\t\twidth, err := TerminalWidth()\n40\t\t\tif err != nil {\n41\t\t\t\tcontinue\n42\t\t\t}\n43\t\t\tresizeMu.Lock()\n44\t\t\tcbs := make([]func(int), len(resizeCallbacks))\n45\t\t\tcopy(cbs, resizeCallbacks)\n46\t\t\tresizeMu.Unlock()\n47\t\t\tfor _, cb := range cbs {\n48\t\t\t\tcb(width)\n49\t\t\t}\n50\t\t}\n51\t}\n52\t"}]},"parent_tool_use_id":null,"session_id":"b8854d2c-587c-4d04-b6c4-9a7d2677a20e","uuid":"f32f1789-ef7b-4282-ad9a-81cc03af2c3b","timestamp":"2026-05-21T18:05:33.229Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5430/pkg/sys/signal.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage sys\n\nimport (\n\t\"os\"\n\t\"os/signal\"\n\t\"sync\"\n\t\"syscall\"\n)\n\nvar (\n\tresizeMu        sync.Mutex\n\tresizeCallbacks  []func(width int)\n\tresizeSetupOnce  sync.Once\n)\n\n// OnTerminalResize registers a callback invoked with the new terminal width\n// when a SIGWINCH signal is received.\n// R3.1: calls TerminalWidth() on SIGWINCH and invokes callback with the new width.\n// R3.2: supports multiple callbacks called in registration order.\nfunc OnTerminalResize(callback func(width int)) {\n\tresizeMu.Lock()\n\tresizeCallbacks = append(resizeCallbacks, callback)\n\tresizeMu.Unlock()\n\n\tresizeSetupOnce.Do(startResizeListener)\n}\n\nfunc startResizeListener() {\n\tc := make(chan os.Signal, 1)\n\tsignal.Notify(c, syscall.SIGWINCH)\n\tgo handleResizeSignals(c)\n}\n\nfunc handleResizeSignals(c <-chan os.Signal) {\n\tfor range c {\n\t\twidth, err := TerminalWidth()\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tresizeMu.Lock()\n\t\tcbs := make([]func(int), len(resizeCallbacks))\n\t\tcopy(cbs, resizeCallbacks)\n\t\tresizeMu.Unlock()\n\t\tfor _, cb := range cbs {\n\t\t\tcb(width)\n\t\t}\n\t}\n}\n","numLines":52,"startLine":1,"totalLines":52}}}
