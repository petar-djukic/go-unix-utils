ests\"\n      - id: AC4\n        text: \"go test ./cmd/dirname/ -count=1 passes with error-case test cases\"\n\n- index: 3\n  title: \"[stitch] cmd/dirname: version, help, and unknown options (srd016-dirname R4.1-R4.3)\"\n  dependency: 2\n  description: |\n    deliverable_type: code\n\n    required_reading:\n      - docs/specs/software-requirements/srd016-dirname.yaml (requirements R4.1, R4.2, R4.3)\n      - cmd/dirname/main.go (existing implementation)\n      - cmd/dirname/dirname_test.go (existing tests)\n\n    files:\n      - path: cmd/dirname/main.go\n        action: modify\n        note: add --version and --help output, unknown option error handling\n      - path: cmd/dirname/dirname_test.go\n        action: modify\n        note: add differential test cases for version, help, and unknown options\n\n    requirements:\n      - id: R1\n        text: \"Implement srd016-dirname R4.1 -- --version flag prints version information to stdout and exits 0\"\n      - id: R2\n        text: \"Implement srd016-dirname R4.2 -- --help flag prints usage information to stdout and exits 0\"\n      - id: R3\n        text: \"Implement srd016-dirname R4.3 -- unknown options print error to stderr and exit non-zero\"\n\n    design_decisions:\n      - id: D1\n        text: \"Version and help output format follows GNU coreutils convention\"\n      - id: D2\n        text: \"Unknown option error message matches GNU dirname format for differential test parity\"\n\n    acceptance_criteria:\n      - id: AC1\n        text: \"dirname --version prints version info to stdout and exits 0\"\n      - id: AC2\n        text: \"dirname --help prints usage to stdout and exits 0\"\n      - id: AC3\n        text: \"dirname --invalid-option prints error to stderr and exits non-zero\"\n      - id: AC4\n        text: \"go test ./cmd/dirname/ -count=1 passes with all test cases\"\n      - id: AC5\n        text: \"All srd016-dirname requirements R1.1 through R4.3 are fully implemented and verified\"\n```"}],"st