on about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\targs := os.Args[1:]\n\tvar paths []string\n\n\tfor len(args) > 0 {\n\t\tswitch args[0] {\n\t\tcase \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase \"--\":\n\t\t\targs = args[1:]\n\t\t\tpaths = append(paths, args...)\n\t\t\tgoto done\n\t\tdefault:\n\t\t\tif strings.HasPrefix(args[0], \"-\") && len(args[0]) > 1 {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", args[0])\n\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\t\tos.Exit(2)\n\t\t\t}\n\t\t\tpaths = append(paths, args[0])\n\t\t}\n\t\targs = args[1:]\n\t}\ndone:\n\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\n\texitCode := 0\n\tmultiDir := len(paths) > 1\n\n\tfor i, path := range paths {\n\t\tif multiDir {\n\t\t\tif i > 0 {\n\t\t\t\tfmt.Fprintln(os.Stdout)\n\t\t\t}\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", path)\n\t\t}\n\t\tif err := listDir(path); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: %v\\n\", err)\n\t\t\texitCode = 2\n\t\t}\n\t}\n\n\tos.Exit(exitCode)\n}\n\nfunc listDir(path string) error {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn formatReadDirError(err)\n\t}\n\n\tnames := filterAndSort(entries)\n\n\tif sys.IsTerminal(os.Stdout.Fd()) {\n\t\treturn printColumns(names)\n\t}\n\treturn printLines(names)\n}\n\nfunc filterAndSort(entries []os.DirEntry) []string {\n\tnames := make([]string, 0, len(entries))\n\tfor _, e := range entries {\n\t\tif strings.HasPrefix(e.Name(), \".\") {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name())\n\t}\n\tsort.Strings(names)\n\treturn names\n}\n\nfunc printColumns(names []string) error {\n\tif len(names) == 0 {\n\t\treturn nil\n\t}\n\ttermWidth, err := sys.TerminalWidth()\n\tif err != nil {\n\t\ttermWidth = 80\n\t}\n\tgrid := format.Columns(names, termWidth)\n\tfor _, row := range grid {\n\t\tline := formatRow(row, names, termWidth)\n\t\tif _, err := fmt.Fprintln(os.Stdout, line); err != nil {\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc formatRow(row []string, allNames []string, termWidth int) string {\n\tif len(row) == 0 {\n\t\treturn \"\"\n\t}\n\tnumCols := len(format.Columns(allNames, termWidth)[0])\n\tvar b strings.Builder\n\tfor i, cell := range row {\n\t\tif i < numCols-1 {\n\t\t\tb.WriteString(format.PadRight(cell, colWidth(allNames, i, numCols)))\n\t\t\tb.WriteString(\"  \")\n\t\t} else {\n\t\t\tb.WriteString(cell)\n\t\t}\n\t}\n\treturn strings.TrimRight(b.String(), \" \")\n}\n\nfunc colWidth(names []string, col, numCols int) int {\n\trows := (len(names) + numCols - 1) / numCols\n\tmaxW := 0\n\tfor row := 0; row < rows; row++ {\n\t\tidx := col*rows + row\n\t\tif idx >= len(names) {\n\t\t\tbreak\n\t\t}\n\t\tw := len(names[idx])\n\t\tif w > maxW {\n\t\t\tmaxW = w\n\t\t}\n\t}\n\treturn maxW\n}\n\nfunc printLines(names []string) error {\n\tfor _, name := range names {\n\t\tif _, err := fmt.Fprintln(os.Stdout, name); err != nil {\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc formatReadDirError(err error) error {\n\tvar pathErr *os.PathError\n\tif ok := false; func() { _, ok = err.(*os.PathError); pathErr, _ = err.(*os.PathError) }(); ok {\n\t\t_ = pathErr\n\t}\n\treturn err\n}\n","userModified":false}}
