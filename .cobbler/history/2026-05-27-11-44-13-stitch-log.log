{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L9TwJ5xxBW7KdPV5k9ME3A","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"strconv\"\n11\t\t\"syscall\"\n12\t\n13\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n14\t)\n15\t\n16\tvar progName = \"test\"\n17\t\n18\tfunc main() {\n19\t\tsys.InstallSIGPIPEHandler()\n20\t\targs := os.Args[1:]\n21\t\n22\t\tif filepath.Base(os.Args[0]) == \"[\" {\n23\t\t\tprogName = \"[\"\n24\t\t\tif len(args) == 0 || args[len(args)-1] != \"]\" {\n25\t\t\t\texitError(\"missing ']'\")\n26\t\t\t}\n27\t\t\targs = args[:len(args)-1]\n28\t\t}\n29\t\n30\t\tif len(args) == 0 {\n31\t\t\tos.Exit(1)\n32\t\t}\n33\t\n34\t\tp := &parser{args: args}\n35\t\tresult := p.expr()\n36\t\n37\t\tif p.pos < len(p.args) {\n38\t\t\texitError(\"extra argument '%s'\", p.args[p.pos])\n39\t\t}\n40\t\n41\t\tif result {\n42\t\t\tos.Exit(0)\n43\t\t}\n44\t\tos.Exit(1)\n45\t}\n46\t\n47\tfunc exitError(format string, args ...any) {\n48\t\tfmt.Fprintf(os.Stderr, progName+\": \"+format+\"\\n\", args...)\n49\t\tos.Exit(2)\n50\t}\n51\t\n52\ttype parser struct {\n53\t\targs []string\n54\t\tpos  int\n55\t}\n56\t\n57\tfunc (p *parser) peek() string {\n58\t\tif p.pos >= len(p.args) {\n59\t\t\treturn \"\"\n60\t\t}\n61\t\treturn p.args[p.pos]\n62\t}\n63\t\n64\tfunc (p *parser) advance() string {\n65\t\ts := p.args[p.pos]\n66\t\tp.pos++\n67\t\treturn s\n68\t}\n69\t\n70\tfunc (p *parser) remaining() int {\n71\t\treturn len(p.args) - p.pos\n72\t}\n73\t\n74\tfunc (p *parser) expr() bool {\n75\t\treturn p.primary()\n76\t}\n77\t\n78\tfunc (p *parser) primary() bool {\n79\t\tif p.remaining() == 0 {\n80\t\t\texitError(\"missing argument\")\n81\t\t}\n82\t\n83\t\tif p.remaining() >= 3 && isBinaryOp(p.args[p.pos+1]) {\n84\t\t\tleft := p.advance()\n85\t\t\top := p.advance()\n86\t\t\tright := p.advance()\n87\t\t\treturn evalBinary(left, op, right)\n88\t\t}\n89\t\n90\t\ttok := p.peek()\n91\t\n92\t\tif isUnaryOp(tok) && p.remaining() >= 2 {\n93\t\t\tp.advance()\n94\t\t\targ := p.advance()\n95\t\t\treturn evalUnary(tok, arg)\n96\t\t}\n97\t\n98\t\tp.advance()\n99\t\treturn tok != \"\"\n100\t}\n101\t\n102\tfunc isUnaryOp(op string) bool {\n103\t\tswitch op {\n104\t\tcase \"-e\", \"-f\", \"-d\", \"-s\", \"-r\", \"-w\", \"-x\",\n105\t\t\t\"-L\", \"-h\", \"-b\", \"-c\", \"-p\", \"-S\",\n106\t\t\t\"-g\", \"-u\", \"-k\", \"-G\", \"-O\", \"-t\",\n107\t\t\t\"-z\", \"-n\":\n108\t\t\treturn true\n109\t\t}\n110\t\treturn false\n111\t}\n112\t\n113\tfunc isBinaryOp(op string) bool {\n114\t\tswitch op {\n115\t\tcase \"=\", \"!=\",\n116\t\t\t\"-eq\", \"-ne\", \"-lt\", \"-le\", \"-gt\", \"-ge\",\n117\t\t\t\"-nt\", \"-ot\", \"-ef\":\n118\t\t\treturn true\n119\t\t}\n120\t\treturn false\n121\t}\n122\t\n123\tfunc evalUnary(op, arg string) bool {\n124\t\tswitch op {\n125\t\tcase \"-z\":\n126\t\t\treturn len(arg) == 0\n127\t\tcase \"-n\":\n128\t\t\treturn len(arg) > 0\n129\t\tcase \"-t\":\n130\t\t\tfd, err := strconv.Atoi(arg)\n131\t\t\tif err != nil {\n132\t\t\t\treturn false\n133\t\t\t}\n134\t\t\treturn sys.IsTerminal(uintptr(fd))\n135\t\tcase \"-r\":\n136\t\t\treturn syscall.Access(arg, syscall.R_OK) == nil\n137\t\tcase \"-w\":\n138\t\t\treturn syscall.Access(arg, syscall.W_OK) == nil\n139\t\tcase \"-x\":\n140\t\t\treturn syscall.Access(arg, syscall.X_OK) == nil\n141\t\tdefault:\n142\t\t\treturn fileStatTest(op, arg)\n143\t\t}\n144\t}\n145\t\n146\tfunc evalBinary(left, op, right string) bool {\n147\t\tswitch op {\n148\t\tcase \"=\":\n149\t\t\treturn left == right\n150\t\tcase \"!=\":\n151\t\t\treturn left != right\n152\t\tcase \"-eq\", \"-ne\", \"-lt\", \"-le\", \"-gt\", \"-ge\":\n153\t\t\treturn intCompare(left, op, right)\n154\t\tcase \"-nt\", \"-ot\", \"-ef\":\n155\t\t\treturn fileCompare(left, op, right)\n156\t\t}\n157\t\treturn false\n158\t}\n159\t\n160\tfunc fileStatTest(op, path string) bool {\n161\t\tvar fi *sys.FileInfo\n162\t\tvar err error\n163\t\tif op == \"-L\" || op == \"-h\" {\n164\t\t\tfi, err = sys.Lstat(path)\n165\t\t} else {\n166\t\t\tfi, err = sys.Stat(path)\n167\t\t}\n168\t\tif err != nil {\n169\t\t\treturn false\n170\t\t}\n171\t\treturn evalStatOp(op, fi)\n172\t}\n173\t\n174\tfunc evalStatOp(op string, fi *sys.FileInfo) bool {\n175\t\tm := fi.Mode\n176\t\tswitch op {\n177\t\tcase \"-e\":\n178\t\t\treturn true\n179\t\tcase \"-f\":\n180\t\t\treturn m.IsRegular()\n181\t\tcase \"-d\":\n182\t\t\treturn m.IsDir()\n183\t\tcase \"-s\":\n184\t\t\treturn fi.Size > 0\n185\t\tcase \"-L\", \"-h\":\n186\t\t\treturn m&os.ModeSymlink != 0\n187\t\tcase \"-b\":\n188\t\t\treturn m&os.ModeDevice != 0 && m&os.ModeCharDevice == 0\n189\t\tcase \"-c\":\n190\t\t\treturn m&os.ModeCharDevice != 0\n191\t\tcase \"-p\":\n192\t\t\treturn m&os.ModeNamedPipe != 0\n193\t\tcase \"-S\":\n194\t\t\treturn m&os.ModeSocket != 0\n195\t\tcase \"-g\":\n196\t\t\treturn m&os.ModeSetgid != 0\n197\t\tcase \"-u\":\n198\t\t\treturn m&os.ModeSetuid != 0\n199\t\tcase \"-k\":\n200\t\t\treturn m&os.ModeSticky != 0\n201\t\tcase \"-G\":\n202\t\t\treturn fi.Gid == uint32(os.Getegid())\n203\t\tcase \"-O\":\n204\t\t\treturn fi.Uid == uint32(os.Geteuid())\n205\t\t}\n206\t\treturn false\n207\t}\n208\t\n209\tfunc fileCompare(left, op, right string) bool {\n210\t\tswitch op {\n211\t\tcase \"-nt\":\n212\t\t\treturn isNewer(left, right)\n213\t\tcase \"-ot\":\n214\t\t\treturn isNewer(right, left)\n215\t\tcase \"-ef\":\n216\t\t\treturn sameFile(left, right)\n217\t\t}\n218\t\treturn false\n219\t}\n220\t\n221\tfunc isNewer(a, b string) bool {\n222\t\tai, aErr := os.Stat(a)\n223\t\tbi, bErr := os.Stat(b)\n224\t\tif aErr != nil {\n225\t\t\treturn false\n226\t\t}\n227\t\tif bErr != nil {\n228\t\t\treturn true\n229\t\t}\n230\t\treturn ai.ModTime().After(bi.ModTime())\n231\t}\n232\t\n233\tfunc sameFile(a, b string) bool {\n234\t\tafi, err := sys.Stat(a)\n235\t\tif err != nil {\n236\t\t\treturn false\n237\t\t}\n238\t\tbfi, err := sys.Stat(b)\n239\t\tif err != nil {\n240\t\t\treturn false\n241\t\t}\n242\t\treturn afi.Dev == bfi.Dev && afi.Ino == bfi.Ino\n243\t}\n244\t\n245\tfunc intCompare(left, op, right string) bool {\n246\t\tl, lErr := strconv.ParseInt(left, 10, 64)\n247\t\tif lErr != nil {\n248\t\t\texitError(\"invalid integer '%s'\", left)\n249\t\t}\n250\t\tr, rErr := strconv.ParseInt(right, 10, 64)\n251\t\tif rErr != nil {\n252\t\t\texitError(\"invalid integer '%s'\", right)\n253\t\t}\n254\t\tswitch op {\n255\t\tcase \"-eq\":\n256\t\t\treturn l == r\n257\t\tcase \"-ne\":\n258\t\t\treturn l != r\n259\t\tcase \"-lt\":\n260\t\t\treturn l < r\n261\t\tcase \"-le\":\n262\t\t\treturn l <= r\n263\t\tcase \"-gt\":\n264\t\t\treturn l > r\n265\t\tcase \"-ge\":\n266\t\t\treturn l >= r\n267\t\t}\n268\t\treturn false\n269\t}\n270\t"}]},"parent_tool_use_id":null,"session_id":"8480b89f-18fc-4679-98ec-87305aa69d35","uuid":"5c51ae0f-6aaa-406b-87d4-c81e5072a9a8","timestamp":"2026-05-27T15:53:20.723Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5602/cmd/test/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar progName = \"test\"\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\targs := os.Args[1:]\n\n\tif filepath.Base(os.Args[0]) == \"[\" {\n\t\tprogName = \"[\"\n\t\tif len(args) == 0 || args[len(args)-1] != \"]\" {\n\t\t\texitError(\"missing ']'\")\n\t\t}\n\t\targs = args[:len(args)-1]\n\t}\n\n\tif len(args) == 0 {\n\t\tos.Exit(1)\n\t}\n\n\tp := &parser{args: args}\n\tresult := p.expr()\n\n\tif p.pos < len(p.args) {\n\t\texitError(\"extra argument '%s'\", p.args[p.pos])\n\t}\n\n\tif result {\n\t\tos.Exit(0)\n\t}\n\tos.Exit(1)\n}\n\nfunc exitError(format string, args ...any) {\n\tfmt.Fprintf(os.Stderr, progName+\": \"+format+\"\\n\", args...)\n\tos.Exit(2)\n}\n\ntype parser struct {\n\targs []string\n\tpos  int\n}\n\nfunc (p *parser) peek() string {\n\tif p.pos >= len(p.args) {\n\t\treturn \"\"\n\t}\n\treturn p.args[p.pos]\n}\n\nfunc (p *parser) advance() string {\n\ts := p.args[p.pos]\n\tp.pos++\n\treturn s\n}\n\nfunc (p *parser) remaining() int {\n\treturn len(p.args) - p.pos\n}\n\nfunc (p *parser) expr() bool {\n\treturn p.primary()\n}\n\nfunc (p *parser) primary() bool {\n\tif p.remaining() == 0 {\n\t\texitError(\"missing argument\")\n\t}\n\n\tif p.remaining() >= 3 && isBinaryOp(p.args[p.pos+1]) {\n\t\tleft := p.advance()\n\t\top := p.advance()\n\t\tright := p.advance()\n\t\treturn evalBinary(left, op, right)\n\t}\n\n\ttok := p.peek()\n\n\tif isUnaryOp(tok) && p.remaining() >= 2 {\n\t\tp.advance()\n\t\targ := p.advance()\n\t\treturn evalUnary(tok, arg)\n\t}\n\n\tp.advance()\n\treturn tok != \"\"\n}\n\nfunc isUnaryOp(op string) bool {\n\tswitch op {\n\tcase \"-e\", \"-f\", \"-d\", \"-s\", \"-r\", \"-w\", \"-x\",\n\t\t\"-L\", \"-h\", \"-b\", \"-c\", \"-p\", \"-S\",\n\t\t\"-g\", \"-u\", \"-k\", \"-G\", \"-O\", \"-t\",\n\t\t\"-z\", \"-n\":\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc isBinaryOp(op string) bool {\n\tswitch op {\n\tcase \"=\", \"!=\",\n\t\t\"-eq\", \"-ne\", \"-lt\", \"-le\", \"-gt\", \"-ge\",\n\t\t\"-nt\", \"-ot\", \"-ef\":\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc evalUnary(op, arg string) bool {\n\tswitch op {\n\tcase \"-z\":\n\t\treturn len(arg) == 0\n\tcase \"-n\":\n\t\treturn len(arg) > 0\n\tcase \"-t\":\n\t\tfd, err := strconv.Atoi(arg)\n\t\tif err != nil {\n\t\t\treturn false\n\t\t}\n\t\treturn sys.IsTerminal(uintptr(fd))\n\tcase \"-r\":\n\t\treturn syscall.Access(arg, syscall.R_OK) == nil\n\tcase \"-w\":\n\t\treturn syscall.Access(arg, syscall.W_OK) == nil\n\tcase \"-x\":\n\t\treturn syscall.Access(arg, syscall.X_OK) == nil\n\tdefault:\n\t\treturn fileStatTest(op, arg)\n\t}\n}\n\nfunc evalBinary(left, op, right string) bool {\n\tswitch op {\n\tcase \"=\":\n\t\treturn left == right\n\tcase \"!=\":\n\t\treturn left != right\n\tcase \"-eq\", \"-ne\", \"-lt\", \"-le\", \"-gt\", \"-ge\":\n\t\treturn intCompare(left, op, right)\n\tcase \"-nt\", \"-ot\", \"-ef\":\n\t\treturn fileCompare(left, op, right)\n\t}\n\treturn false\n}\n\nfunc fileStatTest(op, path string) bool {\n\tvar fi *sys.FileInfo\n\tvar err error\n\tif op == \"-L\" || op == \"-h\" {\n\t\tfi, err = sys.Lstat(path)\n\t} else {\n\t\tfi, err = sys.Stat(path)\n\t}\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn evalStatOp(op, fi)\n}\n\nfunc evalStatOp(op string, fi *sys.FileInfo) bool {\n\tm := fi.Mode\n\tswitch op {\n\tcase \"-e\":\n\t\treturn true\n\tcase \"-f\":\n\t\treturn m.IsRegular()\n\tcase \"-d\":\n\t\treturn m.IsDir()\n\tcase \"-s\":\n\t\treturn fi.Size > 0\n\tcase \"-L\", \"-h\":\n\t\treturn m&os.ModeSymlink != 0\n\tcase \"-b\":\n\t\treturn m&os.ModeDevice != 0 && m&os.ModeCharDevice == 0\n\tcase \"-c\":\n\t\treturn m&os.ModeCharDevice != 0\n\tcase \"-p\":\n\t\treturn m&os.ModeNamedPipe != 0\n\tcase \"-S\":\n\t\treturn m&os.ModeSocket != 0\n\tcase \"-g\":\n\t\treturn m&os.ModeSetgid != 0\n\tcase \"-u\":\n\t\treturn m&os.ModeSetuid != 0\n\tcase \"-k\":\n\t\treturn m&os.ModeSticky != 0\n\tcase \"-G\":\n\t\treturn fi.Gid == uint32(os.Getegid())\n\tcase \"-O\":\n\t\treturn fi.Uid == uint32(os.Geteuid())\n\t}\n\treturn false\n}\n\nfunc fileCompare(left, op, right string) bool {\n\tswitch op {\n\tcase \"-nt\":\n\t\treturn isNewer(left, right)\n\tcase \"-ot\":\n\t\treturn isNewer(right, left)\n\tcase \"-ef\":\n\t\treturn sameFile(left, right)\n\t}\n\treturn false\n}\n\nfunc isNewer(a, b string) bool {\n\tai, aErr := os.Stat(a)\n\tbi, bErr := os.Stat(b)\n\tif aErr != nil {\n\t\treturn false\n\t}\n\tif bErr != nil {\n\t\treturn true\n\t}\n\treturn ai.ModTime().After(bi.ModTime())\n}\n\nfunc sameFile(a, b string) bool {\n\tafi, err := sys.Stat(a)\n\tif err != nil {\n\t\treturn false\n\t}\n\tbfi, err := sys.Stat(b)\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn afi.Dev == bfi.Dev && afi.Ino == bfi.Ino\n}\n\nfunc intCompare(left, op, right string) bool {\n\tl, lErr := strconv.ParseInt(left, 10, 64)\n\tif lErr != nil {\n\t\texitError(\"invalid integer '%s'\", left)\n\t}\n\tr, rErr := strconv.ParseInt(right, 10, 64)\n\tif rErr != nil {\n\t\texitError(\"invalid integer '%s'\", right)\n\t}\n\tswitch op {\n\tcase \"-eq\":\n\t\treturn l == r\n\tcase \"-ne\":\n\t\treturn l != r\n\tcase \"-lt\":\n\t\treturn l < r\n\tcase \"-le\":\n\t\treturn l <= r\n\tcase \"-gt\":\n\t\treturn l > r\n\tcase \"-ge\":\n\t\treturn l >= r\n\t}\n\treturn false\n}\n","numLines":270,"startLine":1,"totalLines":270}}}
