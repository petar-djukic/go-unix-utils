{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D9XLxWknzks4WxSp8LQzMS","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd034-mkdir R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3, R3.1, R3.2, R3.3, R3.4, R4.1, R4.2, R4.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"syscall\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: mkdir [OPTION]... DIRECTORY...\n18\tCreate the DIRECTORY(ies), if they do not already exist.\n19\t\n20\tMandatory arguments to long options are mandatory for short options too.\n21\t  -m, --mode=MODE   set file mode (as in chmod), not a=rwx - umask\n22\t  -p, --parents     no error if existing, make parent directories as needed,\n23\t                    with their file modes unaffected by any -m option\n24\t  -v, --verbose     print a message for each created directory\n25\t  -Z                set SELinux security context of each created directory\n26\t                    to the default type\n27\t      --context[=CTX]  like -Z, or if CTX is specified then set the\n28\t                    SELinux or SMACK security context to CTX\n29\t      --help        display this help and exit\n30\t      --version     output version information and exit\n31\t`\n32\t\n33\tconst versionText = `mkdir (go-unix-utils) dev\n34\t`\n35\t\n36\ttype options struct {\n37\t\tparents bool\n38\t\tverbose bool\n39\t\tmode    string\n40\t\tmodeSet bool\n41\t}\n42\t\n43\tfunc main() {\n44\t\tsys.InstallSIGPIPEHandler()\n45\t\n46\t\topts, dirs, err := parseArgs(os.Args[1:])\n47\t\tif err != nil {\n48\t\t\tfmt.Fprintf(os.Stderr, \"mkdir: %s\\n\", err)\n49\t\t\tfmt.Fprintf(os.Stderr, \"Try 'mkdir --help' for more information.\\n\")\n50\t\t\tos.Exit(1)\n51\t\t}\n52\t\n53\t\tos.Exit(run(opts, dirs))\n54\t}\n55\t\n56\tfunc run(opts options, dirs []string) int {\n57\t\tvar mode os.FileMode\n58\t\tif opts.modeSet {\n59\t\t\tvar err error\n60\t\t\tmode, err = parseMode(opts.mode)\n61\t\t\tif err != nil {\n62\t\t\t\tfmt.Fprintf(os.Stderr, \"mkdir: %s\\n\", err)\n63\t\t\t\treturn 1\n64\t\t\t}\n65\t\t}\n66\t\texitCode := 0\n67\t\tfor _, dir := range dirs {\n68\t\t\tvar err error\n69\t\t\tif opts.parents {\n70\t\t\t\terr = mkdirParents(dir, opts.verbose, opts.modeSet, mode)\n71\t\t\t} else {\n72\t\t\t\terr = mkdirSingle(dir, opts.verbose, opts.modeSet, mode)\n73\t\t\t}\n74\t\t\tif err != nil {\n75\t\t\t\tfailPath := dir\n76\t\t\t\tif pe, ok := err.(*os.PathError); ok {\n77\t\t\t\t\tfailPath = pe.Path\n78\t\t\t\t}\n79\t\t\t\tfmt.Fprintf(os.Stderr, \"mkdir: cannot create directory '%s': %s\\n\",\n80\t\t\t\t\tfailPath, sysErrMsg(err))\n81\t\t\t\texitCode = 1\n82\t\t\t}\n83\t\t}\n84\t\treturn exitCode\n85\t}\n86\t\n87\tfunc mkdirSingle(dir string, verbose, modeSet bool, mode os.FileMode) error {\n88\t\tif err := os.Mkdir(dir, 0o777); err != nil {\n89\t\t\treturn err\n90\t\t}\n91\t\tif modeSet {\n92\t\t\tif err := os.Chmod(dir, mode); err != nil {\n93\t\t\t\treturn err\n94\t\t\t}\n95\t\t}\n96\t\tif verbose {\n97\t\t\tfmt.Fprintf(os.Stdout, \"mkdir: created directory '%s'\\n\", dir)\n98\t\t}\n99\t\treturn nil\n100\t}\n101\t\n102\tfunc mkdirParents(dir string, verbose, modeSet bool, mode os.FileMode) error {\n103\t\tif verbose {\n104\t\t\tif err := mkdirAllVerbose(dir); err != nil {\n105\t\t\t\treturn err\n106\t\t\t}\n107\t\t} else {\n108\t\t\tif err := os.MkdirAll(dir, 0o777); err != nil {\n109\t\t\t\treturn err\n110\t\t\t}\n111\t\t}\n112\t\tif modeSet {\n113\t\t\treturn os.Chmod(dir, mode)\n114\t\t}\n115\t\treturn nil\n116\t}\n117\t\n118\tfunc mkdirAllVerbose(dir string) error {\n119\t\tfi, err := os.Stat(dir)\n120\t\tif err == nil {\n121\t\t\tif fi.IsDir() {\n122\t\t\t\treturn nil\n123\t\t\t}\n124\t\t\treturn &os.PathError{Op: \"mkdir\", Path: dir, Err: syscall.ENOTDIR}\n125\t\t}\n126\t\tparent := filepath.Dir(dir)\n127\t\tif parent != dir {\n128\t\t\tif fi, err := os.Stat(parent); err != nil {\n129\t\t\t\tif err := mkdirAllVerbose(parent); err != nil {\n130\t\t\t\t\treturn err\n131\t\t\t\t}\n132\t\t\t} else if !fi.IsDir() {\n133\t\t\t\treturn &os.PathError{Op: \"mkdir\", Path: parent, Err: syscall.ENOTDIR}\n134\t\t\t}\n135\t\t}\n136\t\tif err := os.Mkdir(dir, 0o777); err != nil {\n137\t\t\tif os.IsExist(err) {\n138\t\t\t\treturn nil\n139\t\t\t}\n140\t\t\treturn err\n141\t\t}\n142\t\tfmt.Fprintf(os.Stdout, \"mkdir: created directory '%s'\\n\", dir)\n143\t\treturn nil\n144\t}\n145\t\n146\tfunc sysErrMsg(err error) string {\n147\t\tpe, ok := err.(*os.PathError)\n148\t\tif !ok {\n149\t\t\treturn err.Error()\n150\t\t}\n151\t\tse, ok := pe.Err.(syscall.Errno)\n152\t\tif !ok {\n153\t\t\treturn pe.Err.Error()\n154\t\t}\n155\t\tswitch se {\n156\t\tcase syscall.EEXIST:\n157\t\t\treturn \"File exists\"\n158\t\tcase syscall.ENOENT:\n159\t\t\treturn \"No such file or directory\"\n160\t\tcase syscall.EACCES:\n161\t\t\treturn \"Permission denied\"\n162\t\tcase syscall.ENOTDIR:\n163\t\t\treturn \"Not a directory\"\n164\t\tdefault:\n165\t\t\treturn se.Error()\n166\t\t}\n167\t}\n168\t\n169\tfunc parseArgs(args []string) (options, []string, error) {\n170\t\tvar opts options\n171\t\tvar dirs []string\n172\t\ti := 0\n173\t\tfor i < len(args) {\n174\t\t\targ := args[i]\n175\t\t\tif arg == \"--\" {\n176\t\t\t\tdirs = append(dirs, args[i+1:]...)\n177\t\t\t\tbreak\n178\t\t\t}\n179\t\t\tif strings.HasPrefix(arg, \"--\") {\n180\t\t\t\tn, err := parseLongFlag(args, i, &opts)\n181\t\t\t\tif err != nil {\n182\t\t\t\t\treturn opts, nil, err\n183\t\t\t\t}\n184\t\t\t\ti += n\n185\t\t\t\tcontinue\n186\t\t\t}\n187\t\t\tif len(arg) > 1 && arg[0] == '-' {\n188\t\t\t\tn, err := parseShortFlagGroup(args, i, &opts)\n189\t\t\t\tif err != nil {\n190\t\t\t\t\treturn opts, nil, err\n191\t\t\t\t}\n192\t\t\t\ti += n\n193\t\t\t\tcontinue\n194\t\t\t}\n195\t\t\tdirs = append(dirs, arg)\n196\t\t\ti++\n197\t\t}\n198\t\tif len(dirs) == 0 {\n199\t\t\treturn opts, nil, fmt.Errorf(\"missing operand\")\n200\t\t}\n201\t\treturn opts, dirs, nil\n202\t}\n203\t\n204\tfunc parseShortFlagGroup(args []string, i int, opts *options) (int, error) {\n205\t\tmodeVal, hasMode, err := parseShortFlags(args[i][1:], opts)\n206\t\tif err != nil {\n207\t\t\treturn 0, err\n208\t\t}\n209\t\tif !hasMode {\n210\t\t\treturn 1, nil\n211\t\t}\n212\t\tif modeVal != \"\" {\n213\t\t\topts.mode = modeVal\n214\t\t\topts.modeSet = true\n215\t\t\treturn 1, nil\n216\t\t}\n217\t\tif i+1 >= len(args) {\n218\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'm'\")\n219\t\t}\n220\t\topts.mode = args[i+1]\n221\t\topts.modeSet = true\n222\t\treturn 2, nil\n223\t}\n224\t\n225\tfunc parseLongFlag(args []string, idx int, opts *options) (int, error) {\n226\t\tflag := args[idx]\n227\t\tif strings.HasPrefix(flag, \"--mode=\") {\n228\t\t\topts.mode = flag[7:]\n229\t\t\topts.modeSet = true\n230\t\t\treturn 1, nil\n231\t\t}\n232\t\tswitch flag {\n233\t\tcase \"--help\":\n234\t\t\tfmt.Fprint(os.Stdout, helpText)\n235\t\t\tos.Exit(0)\n236\t\t\treturn 0, nil\n237\t\tcase \"--version\":\n238\t\t\tfmt.Fprint(os.Stdout, versionText)\n239\t\t\tos.Exit(0)\n240\t\t\treturn 0, nil\n241\t\tcase \"--parents\":\n242\t\t\topts.parents = true\n243\t\t\treturn 1, nil\n244\t\tcase \"--verbose\":\n245\t\t\topts.verbose = true\n246\t\t\treturn 1, nil\n247\t\tcase \"--mode\":\n248\t\t\tif idx+1 >= len(args) {\n249\t\t\t\treturn 0, fmt.Errorf(\"option '--mode' requires an argument\")\n250\t\t\t}\n251\t\t\topts.mode = args[idx+1]\n252\t\t\topts.modeSet = true\n253\t\t\treturn 2, nil\n254\t\tdefault:\n255\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n256\t\t}\n257\t}\n258\t\n259\tfunc parseShortFlags(flags string, opts *options) (string, bool, error) {\n260\t\tfor j := 0; j < len(flags); j++ {\n261\t\t\tswitch flags[j] {\n262\t\t\tcase 'p':\n263\t\t\t\topts.parents = true\n264\t\t\tcase 'v':\n265\t\t\t\topts.verbose = true\n266\t\t\tcase 'm':\n267\t\t\t\treturn flags[j+1:], true, nil\n268\t\t\tdefault:\n269\t\t\t\treturn \"\", false, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n270\t\t\t}\n271\t\t}\n272\t\treturn \"\", false, nil\n273\t}\n274\t\n275\tfunc parseMode(modeStr string) (os.FileMode, error) {\n276\t\tif len(modeStr) == 0 {\n277\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", modeStr)\n278\t\t}\n279\t\tif modeStr[0] >= '0' && modeStr[0] <= '7' {\n280\t\t\treturn parseOctalMode(modeStr)\n281\t\t}\n282\t\treturn parseSymbolicMode(modeStr)\n283\t}\n284\t\n285\tfunc parseOctalMode(s string) (os.FileMode, error) {\n286\t\tvar val uint64\n287\t\tfor _, c := range s {\n288\t\t\tif c < '0' || c > '7' {\n289\t\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", s)\n290\t\t\t}\n291\t\t\tval = val*8 + uint64(c-'0')\n292\t\t\tif val > 07777 {\n293\t\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", s)\n294\t\t\t}\n295\t\t}\n296\t\tmode := os.FileMode(val & 0o777)\n297\t\tif val&0o4000 != 0 {\n298\t\t\tmode |= os.ModeSetuid\n299\t\t}\n300\t\tif val&0o2000 != 0 {\n301\t\t\tmode |= os.ModeSetgid\n302\t\t}\n303\t\tif val&0o1000 != 0 {\n304\t\t\tmode |= os.ModeSticky\n305\t\t}\n306\t\treturn mode, nil\n307\t}\n308\t\n309\tfunc parseSymbolicMode(modeStr string) (os.FileMode, error) {\n310\t\tumaskVal := currentUmask()\n311\t\tmode := os.FileMode(0o777)\n312\t\tfor clause := range strings.SplitSeq(modeStr, \",\") {\n313\t\t\tvar err error\n314\t\t\tmode, err = applySymbolicClause(clause, mode, umaskVal)\n315\t\t\tif err != nil {\n316\t\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", modeStr)\n317\t\t\t}\n318\t\t}\n319\t\treturn mode, nil\n320\t}\n321\t\n322\tfunc currentUmask() int {\n323\t\told := syscall.Umask(0)\n324\t\tsyscall.Umask(old)\n325\t\treturn old\n326\t}\n327\t\n328\tfunc applySymbolicClause(clause string, mode os.FileMode, umask int) (os.FileMode, error) {\n329\t\ti, whoMask, explicit := parseWhoChars(clause)\n330\t\tif i >= len(clause) {\n331\t\t\treturn 0, fmt.Errorf(\"missing operator\")\n332\t\t}\n333\t\top := clause[i]\n334\t\tif op != '+' && op != '-' && op != '=' {\n335\t\t\treturn 0, fmt.Errorf(\"invalid operator\")\n336\t\t}\n337\t\tpermBits, specialBits := parsePermChars(clause[i+1:], whoMask)\n338\t\teffectivePerms := permBits\n339\t\tif !explicit {\n340\t\t\teffectivePerms &^= os.FileMode(umask)\n341\t\t}\n342\t\treturn applyModeOp(mode, op, whoMask, effectivePerms, specialBits, explicit), nil\n343\t}\n344\t\n345\tfunc parseWhoChars(clause string) (int, os.FileMode, bool) {\n346\t\tvar whoMask os.FileMode\n347\t\texplicit := false\n348\t\ti := 0\n349\t\tfor i < len(clause) {\n350\t\t\tswitch clause[i] {\n351\t\t\tcase 'u':\n352\t\t\t\twhoMask |= 0o700\n353\t\t\t\texplicit = true\n354\t\t\tcase 'g':\n355\t\t\t\twhoMask |= 0o070\n356\t\t\t\texplicit = true\n357\t\t\tcase 'o':\n358\t\t\t\twhoMask |= 0o007\n359\t\t\t\texplicit = true\n360\t\t\tcase 'a':\n361\t\t\t\twhoMask |= 0o777\n362\t\t\t\texplicit = true\n363\t\t\tdefault:\n364\t\t\t\tif !explicit {\n365\t\t\t\t\twhoMask = 0o777\n366\t\t\t\t}\n367\t\t\t\treturn i, whoMask, explicit\n368\t\t\t}\n369\t\t\ti++\n370\t\t}\n371\t\tif !explicit {\n372\t\t\twhoMask = 0o777\n373\t\t}\n374\t\treturn i, whoMask, explicit\n375\t}\n376\t\n377\tfunc parsePermChars(s string, whoMask os.FileMode) (os.FileMode, os.FileMode) {\n378\t\tvar permBits, specialBits os.FileMode\n379\t\tfor _, c := range s {\n380\t\t\tswitch c {\n381\t\t\tcase 'r':\n382\t\t\t\tpermBits |= 0o444 & whoMask\n383\t\t\tcase 'w':\n384\t\t\t\tpermBits |= 0o222 & whoMask\n385\t\t\tcase 'x', 'X':\n386\t\t\t\tpermBits |= 0o111 & whoMask\n387\t\t\tcase 's':\n388\t\t\t\tif whoMask&0o700 != 0 {\n389\t\t\t\t\tspecialBits |= os.ModeSetuid\n390\t\t\t\t}\n391\t\t\t\tif whoMask&0o070 != 0 {\n392\t\t\t\t\tspecialBits |= os.ModeSetgid\n393\t\t\t\t}\n394\t\t\tcase 't':\n395\t\t\t\tspecialBits |= os.ModeSticky\n396\t\t\t}\n397\t\t}\n398\t\treturn permBits, specialBits\n399\t}\n400\t\n401\tfunc applyModeOp(mode os.FileMode, op byte, whoMask, perms, special os.FileMode, explicit bool) os.FileMode {\n402\t\tregular := mode & 0o777\n403\t\textra := mode &^ os.FileMode(0o777)\n404\t\tswitch op {\n405\t\tcase '=':\n406\t\t\tregular = (regular &^ whoMask) | perms\n407\t\t\tif explicit {\n408\t\t\t\tif whoMask&0o700 != 0 {\n409\t\t\t\t\textra &^= os.ModeSetuid\n410\t\t\t\t}\n411\t\t\t\tif whoMask&0o070 != 0 {\n412\t\t\t\t\textra &^= os.ModeSetgid\n413\t\t\t\t}\n414\t\t\t} else {\n415\t\t\t\textra &^= os.ModeSetuid | os.ModeSetgid\n416\t\t\t}\n417\t\t\textra |= special\n418\t\tcase '+':\n419\t\t\tregular |= perms\n420\t\t\textra |= special\n421\t\tcase '-':\n422\t\t\tregular &^= perms\n423\t\t\textra &^= special\n424\t\t}\n425\t\treturn regular | extra\n426\t}\n427\t"}]},"parent_tool_use_id":null,"session_id":"2fc66413-5509-443d-b291-04e23843da1d","uuid":"247867ec-e8b7-43a9-bc55-4384f1081a4f","timestamp":"2026-05-20T11:27:16.937Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5340/cmd/mkdir/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd034-mkdir R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3, R3.1, R3.2, R3.3, R3.4, R4.1, R4.2, R4.3.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: mkdir [OPTION]... DIRECTORY...\nCreate the DIRECTORY(ies), if they do not already exist.\n\nMandatory arguments to long options are mandatory for short options too.\n  -m, --mode=MODE   set file mode (as in chmod), not a=rwx - umask\n  -p, --parents     no error if existing, make parent directories as needed,\n                    with their file modes unaffected by any -m option\n  -v, --verbose     print a message for each created directory\n  -Z                set SELinux security context of each created directory\n                    to the default type\n      --context[=CTX]  like -Z, or if CTX is specified then set the\n                    SELinux or SMACK security context to CTX\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `mkdir (go-unix-utils) dev\n`\n\ntype options struct {\n\tparents bool\n\tverbose bool\n\tmode    string\n\tmodeSet bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, dirs, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"mkdir: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'mkdir --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tos.Exit(run(opts, dirs))\n}\n\nfunc run(opts options, dirs []string) int {\n\tvar mode os.FileMode\n\tif opts.modeSet {\n\t\tvar err error\n\t\tmode, err = parseMode(opts.mode)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"mkdir: %s\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t}\n\texitCode := 0\n\tfor _, dir := range dirs {\n\t\tvar err error\n\t\tif opts.parents {\n\t\t\terr = mkdirParents(dir, opts.verbose, opts.modeSet, mode)\n\t\t} else {\n\t\t\terr = mkdirSingle(dir, opts.verbose, opts.modeSet, mode)\n\t\t}\n\t\tif err != nil {\n\t\t\tfailPath := dir\n\t\t\tif pe, ok := err.(*os.PathError); ok {\n\t\t\t\tfailPath = pe.Path\n\t\t\t}\n\t\t\tfmt.Fprintf(os.Stderr, \"mkdir: cannot create directory '%s': %s\\n\",\n\t\t\t\tfailPath, sysErrMsg(err))\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc mkdirSingle(dir string, verbose, modeSet bool, mode os.FileMode) error {\n\tif err := os.Mkdir(dir, 0o777); err != nil {\n\t\treturn err\n\t}\n\tif modeSet {\n\t\tif err := os.Chmod(dir, mode); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif verbose {\n\t\tfmt.Fprintf(os.Stdout, \"mkdir: created directory '%s'\\n\", dir)\n\t}\n\treturn nil\n}\n\nfunc mkdirParents(dir string, verbose, modeSet bool, mode os.FileMode) error {\n\tif verbose {\n\t\tif err := mkdirAllVerbose(dir); err != nil {\n\t\t\treturn err\n\t\t}\n\t} else {\n\t\tif err := os.MkdirAll(dir, 0o777); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\tif modeSet {\n\t\treturn os.Chmod(dir, mode)\n\t}\n\treturn nil\n}\n\nfunc mkdirAllVerbose(dir string) error {\n\tfi, err := os.Stat(dir)\n\tif err == nil {\n\t\tif fi.IsDir() {\n\t\t\treturn nil\n\t\t}\n\t\treturn &os.PathError{Op: \"mkdir\", Path: dir, Err: syscall.ENOTDIR}\n\t}\n\tparent := filepath.Dir(dir)\n\tif parent != dir {\n\t\tif fi, err := os.Stat(parent); err != nil {\n\t\t\tif err := mkdirAllVerbose(parent); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t} else if !fi.IsDir() {\n\t\t\treturn &os.PathError{Op: \"mkdir\", Path: parent, Err: syscall.ENOTDIR}\n\t\t}\n\t}\n\tif err := os.Mkdir(dir, 0o777); err != nil {\n\t\tif os.IsExist(err) {\n\t\t\treturn nil\n\t\t}\n\t\treturn err\n\t}\n\tfmt.Fprintf(os.Stdout, \"mkdir: created directory '%s'\\n\", dir)\n\treturn nil\n}\n\nfunc sysErrMsg(err error) string {\n\tpe, ok := err.(*os.PathError)\n\tif !ok {\n\t\treturn err.Error()\n\t}\n\tse, ok := pe.Err.(syscall.Errno)\n\tif !ok {\n\t\treturn pe.Err.Error()\n\t}\n\tswitch se {\n\tcase syscall.EEXIST:\n\t\treturn \"File exists\"\n\tcase syscall.ENOENT:\n\t\treturn \"No such file or directory\"\n\tcase syscall.EACCES:\n\t\treturn \"Permission denied\"\n\tcase syscall.ENOTDIR:\n\t\treturn \"Not a directory\"\n\tdefault:\n\t\treturn se.Error()\n\t}\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar dirs []string\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tdirs = append(dirs, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(args, i, &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tn, err := parseShortFlagGroup(args, i, &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tdirs = append(dirs, arg)\n\t\ti++\n\t}\n\tif len(dirs) == 0 {\n\t\treturn opts, nil, fmt.Errorf(\"missing operand\")\n\t}\n\treturn opts, dirs, nil\n}\n\nfunc parseShortFlagGroup(args []string, i int, opts *options) (int, error) {\n\tmodeVal, hasMode, err := parseShortFlags(args[i][1:], opts)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tif !hasMode {\n\t\treturn 1, nil\n\t}\n\tif modeVal != \"\" {\n\t\topts.mode = modeVal\n\t\topts.modeSet = true\n\t\treturn 1, nil\n\t}\n\tif i+1 >= len(args) {\n\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'm'\")\n\t}\n\topts.mode = args[i+1]\n\topts.modeSet = true\n\treturn 2, nil\n}\n\nfunc parseLongFlag(args []string, idx int, opts *options) (int, error) {\n\tflag := args[idx]\n\tif strings.HasPrefix(flag, \"--mode=\") {\n\t\topts.mode = flag[7:]\n\t\topts.modeSet = true\n\t\treturn 1, nil\n\t}\n\tswitch flag {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase \"--parents\":\n\t\topts.parents = true\n\t\treturn 1, nil\n\tcase \"--verbose\":\n\t\topts.verbose = true\n\t\treturn 1, nil\n\tcase \"--mode\":\n\t\tif idx+1 >= len(args) {\n\t\t\treturn 0, fmt.Errorf(\"option '--mode' requires an argument\")\n\t\t}\n\t\topts.mode = args[idx+1]\n\t\topts.modeSet = true\n\t\treturn 2, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, opts *options) (string, bool, error) {\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 'p':\n\t\t\topts.parents = true\n\t\tcase 'v':\n\t\t\topts.verbose = true\n\t\tcase 'm':\n\t\t\treturn flags[j+1:], true, nil\n\t\tdefault:\n\t\t\treturn \"\", false, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn \"\", false, nil\n}\n\nfunc parseMode(modeStr string) (os.FileMode, error) {\n\tif len(modeStr) == 0 {\n\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", modeStr)\n\t}\n\tif modeStr[0] >= '0' && modeStr[0] <= '7' {\n\t\treturn parseOctalMode(modeStr)\n\t}\n\treturn parseSymbolicMode(modeStr)\n}\n\nfunc parseOctalMode(s string) (os.FileMode, error) {\n\tvar val uint64\n\tfor _, c := range s {\n\t\tif c < '0' || c > '7' {\n\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", s)\n\t\t}\n\t\tval = val*8 + uint64(c-'0')\n\t\tif val > 07777 {\n\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", s)\n\t\t}\n\t}\n\tmode := os.FileMode(val & 0o777)\n\tif val&0o4000 != 0 {\n\t\tmode |= os.ModeSetuid\n\t}\n\tif val&0o2000 != 0 {\n\t\tmode |= os.ModeSetgid\n\t}\n\tif val&0o1000 != 0 {\n\t\tmode |= os.ModeSticky\n\t}\n\treturn mode, nil\n}\n\nfunc parseSymbolicMode(modeStr string) (os.FileMode, error) {\n\tumaskVal := currentUmask()\n\tmode := os.FileMode(0o777)\n\tfor clause := range strings.SplitSeq(modeStr, \",\") {\n\t\tvar err error\n\t\tmode, err = applySymbolicClause(clause, mode, umaskVal)\n\t\tif err != nil {\n\t\t\treturn 0, fmt.Errorf(\"invalid mode '%s'\", modeStr)\n\t\t}\n\t}\n\treturn mode, nil\n}\n\nfunc currentUmask() int {\n\told := syscall.Umask(0)\n\tsyscall.Umask(old)\n\treturn old\n}\n\nfunc applySymbolicClause(clause string, mode os.FileMode, umask int) (os.FileMode, error) {\n\ti, whoMask, explicit := parseWhoChars(clause)\n\tif i >= len(clause) {\n\t\treturn 0, fmt.Errorf(\"missing operator\")\n\t}\n\top := clause[i]\n\tif op != '+' && op != '-' && op != '=' {\n\t\treturn 0, fmt.Errorf(\"invalid operator\")\n\t}\n\tpermBits, specialBits := parsePermChars(clause[i+1:], whoMask)\n\teffectivePerms := permBits\n\tif !explicit {\n\t\teffectivePerms &^= os.FileMode(umask)\n\t}\n\treturn applyModeOp(mode, op, whoMask, effectivePerms, specialBits, explicit), nil\n}\n\nfunc parseWhoChars(clause string) (int, os.FileMode, bool) {\n\tvar whoMask os.FileMode\n\texplicit := false\n\ti := 0\n\tfor i < len(clause) {\n\t\tswitch clause[i] {\n\t\tcase 'u':\n\t\t\twhoMask |= 0o700\n\t\t\texplicit = true\n\t\tcase 'g':\n\t\t\twhoMask |= 0o070\n\t\t\texplicit = true\n\t\tcase 'o':\n\t\t\twhoMask |= 0o007\n\t\t\texplicit = true\n\t\tcase 'a':\n\t\t\twhoMask |= 0o777\n\t\t\texplicit = true\n\t\tdefault:\n\t\t\tif !explicit {\n\t\t\t\twhoMask = 0o777\n\t\t\t}\n\t\t\treturn i, whoMask, explicit\n\t\t}\n\t\ti++\n\t}\n\tif !explicit {\n\t\twhoMask = 0o777\n\t}\n\treturn i, whoMask, explicit\n}\n\nfunc parsePermChars(s string, whoMask os.FileMode) (os.FileMode, os.FileMode) {\n\tvar permBits, specialBits os.FileMode\n\tfor _, c := range s {\n\t\tswitch c {\n\t\tcase 'r':\n\t\t\tpermBits |= 0o444 & whoMask\n\t\tcase 'w':\n\t\t\tpermBits |= 0o222 & whoMask\n\t\tcase 'x', 'X':\n\t\t\tpermBits |= 0o111 & whoMask\n\t\tcase 's':\n\t\t\tif whoMask&0o700 != 0 {\n\t\t\t\tspecialBits |= os.ModeSetuid\n\t\t\t}\n\t\t\tif whoMask&0o070 != 0 {\n\t\t\t\tspecialBits |= os.ModeSetgid\n\t\t\t}\n\t\tcase 't':\n\t\t\tspecialBits |= os.ModeSticky\n\t\t}\n\t}\n\treturn permBits, specialBits\n}\n\nfunc applyModeOp(mode os.FileMode, op byte, whoMask, perms, special os.FileMode, explicit bool) os.FileMode {\n\tregular := mode & 0o777\n\textra := mode &^ os.FileMode(0o777)\n\tswitch op {\n\tcase '=':\n\t\tregular = (regular &^ whoMask) | perms\n\t\tif explicit {\n\t\t\tif whoMask&0o700 != 0 {\n\t\t\t\textra &^= os.ModeSetuid\n\t\t\t}\n\t\t\tif whoMask&0o070 != 0 {\n\t\t\t\textra &^= os.ModeSetgid\n\t\t\t}\n\t\t} else {\n\t\t\textra &^= os.ModeSetuid | os.ModeSetgid\n\t\t}\n\t\textra |= special\n\tcase '+':\n\t\tregular |= perms\n\t\textra |= special\n\tcase '-':\n\t\tregular &^= perms\n\t\textra &^= special\n\t}\n\treturn regular | extra\n}\n","numLines":427,"startLine":1,"totalLines":427}}}
