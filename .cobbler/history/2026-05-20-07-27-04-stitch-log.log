{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BvracHFr9Ja8sZwYpZUVVH","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"errors\"\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\n13\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n14\t)\n15\t\n16\tconst helpText = `Usage: ln [OPTION]... TARGET LINK_NAME\n17\t  or:  ln [OPTION]... TARGET\n18\t  or:  ln [OPTION]... TARGET... DIRECTORY\n19\tIn the 1st form, create a link to TARGET with the name LINK_NAME.\n20\tIn the 2nd form, create a link to TARGET in the current directory.\n21\tIn the 3rd form, create links to each TARGET in DIRECTORY.\n22\t\n23\t  -s, --symbolic  make symbolic links instead of hard links\n24\t      --help      display this help and exit\n25\t      --version   output version information and exit\n26\t`\n27\t\n28\tconst versionText = `ln (go-unix-utils) dev\n29\t`\n30\t\n31\ttype options struct {\n32\t\tsymbolic bool\n33\t}\n34\t\n35\tfunc main() {\n36\t\tsys.InstallSIGPIPEHandler()\n37\t\n38\t\topts, targets, err := parseArgs(os.Args[1:])\n39\t\tif err != nil {\n40\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n41\t\t\tfmt.Fprintf(os.Stderr, \"Try 'ln --help' for more information.\\n\")\n42\t\t\tos.Exit(1)\n43\t\t}\n44\t\n45\t\tos.Exit(run(opts, targets))\n46\t}\n47\t\n48\tfunc run(opts options, targets []string) int {\n49\t\texitCode := 0\n50\t\tlast := targets[len(targets)-1]\n51\t\n52\t\tswitch {\n53\t\tcase len(targets) == 1:\n54\t\t\tlinkName := filepath.Base(targets[0])\n55\t\t\tif err := createLink(targets[0], linkName, opts); err != nil {\n56\t\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n57\t\t\t\texitCode = 1\n58\t\t\t}\n59\t\tcase isDirectory(last):\n60\t\t\tfor _, target := range targets[:len(targets)-1] {\n61\t\t\t\tlinkName := filepath.Join(last, filepath.Base(target))\n62\t\t\t\tif err := createLink(target, linkName, opts); err != nil {\n63\t\t\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n64\t\t\t\t\texitCode = 1\n65\t\t\t\t}\n66\t\t\t}\n67\t\tcase len(targets) == 2:\n68\t\t\tif err := createLink(targets[0], targets[1], opts); err != nil {\n69\t\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n70\t\t\t\texitCode = 1\n71\t\t\t}\n72\t\tdefault:\n73\t\t\tfmt.Fprintf(os.Stderr, \"ln: target '%s' is not a directory\\n\", last)\n74\t\t\texitCode = 1\n75\t\t}\n76\t\n77\t\treturn exitCode\n78\t}\n79\t\n80\tfunc createLink(target, linkName string, opts options) error {\n81\t\tif opts.symbolic {\n82\t\t\tif err := os.Symlink(target, linkName); err != nil {\n83\t\t\t\treturn fmt.Errorf(\"failed to create symbolic link '%s': %s\",\n84\t\t\t\t\tlinkName, sysError(err))\n85\t\t\t}\n86\t\t\treturn nil\n87\t\t}\n88\t\treturn createHardLink(target, linkName)\n89\t}\n90\t\n91\tfunc createHardLink(target, linkName string) error {\n92\t\tfi, err := os.Stat(target)\n93\t\tif err != nil {\n94\t\t\treturn fmt.Errorf(\"failed to access '%s': %s\", target, sysError(err))\n95\t\t}\n96\t\tif fi.IsDir() {\n97\t\t\treturn fmt.Errorf(\"'%s': hard link not allowed for directory\", target)\n98\t\t}\n99\t\tif err := os.Link(target, linkName); err != nil {\n100\t\t\treturn fmt.Errorf(\"failed to create hard link '%s': %s\",\n101\t\t\t\tlinkName, sysError(err))\n102\t\t}\n103\t\treturn nil\n104\t}\n105\t\n106\tfunc isDirectory(path string) bool {\n107\t\tfi, err := os.Stat(path)\n108\t\tif err != nil {\n109\t\t\treturn false\n110\t\t}\n111\t\treturn fi.IsDir()\n112\t}\n113\t\n114\tfunc sysError(err error) string {\n115\t\tfor u := errors.Unwrap(err); u != nil; u = errors.Unwrap(err) {\n116\t\t\terr = u\n117\t\t}\n118\t\treturn err.Error()\n119\t}\n120\t\n121\tfunc parseArgs(args []string) (options, []string, error) {\n122\t\tvar opts options\n123\t\tvar targets []string\n124\t\n125\t\ti := 0\n126\t\tfor i < len(args) {\n127\t\t\targ := args[i]\n128\t\t\tif arg == \"--\" {\n129\t\t\t\ttargets = append(targets, args[i+1:]...)\n130\t\t\t\tbreak\n131\t\t\t}\n132\t\t\tif strings.HasPrefix(arg, \"--\") {\n133\t\t\t\tn, err := parseLongFlag(arg, &opts)\n134\t\t\t\tif err != nil {\n135\t\t\t\t\treturn opts, nil, err\n136\t\t\t\t}\n137\t\t\t\ti += n\n138\t\t\t\tcontinue\n139\t\t\t}\n140\t\t\tif len(arg) > 1 && arg[0] == '-' {\n141\t\t\t\tif err := parseShortFlags(arg[1:], &opts); err != nil {\n142\t\t\t\t\treturn opts, nil, err\n143\t\t\t\t}\n144\t\t\t\ti++\n145\t\t\t\tcontinue\n146\t\t\t}\n147\t\t\ttargets = append(targets, arg)\n148\t\t\ti++\n149\t\t}\n150\t\n151\t\tif len(targets) == 0 {\n152\t\t\treturn opts, nil, fmt.Errorf(\"missing file operand\")\n153\t\t}\n154\t\n155\t\treturn opts, targets, nil\n156\t}\n157\t\n158\tfunc parseLongFlag(flag string, opts *options) (int, error) {\n159\t\tswitch flag {\n160\t\tcase \"--help\":\n161\t\t\tfmt.Fprint(os.Stdout, helpText)\n162\t\t\tos.Exit(0)\n163\t\t\treturn 0, nil\n164\t\tcase \"--version\":\n165\t\t\tfmt.Fprint(os.Stdout, versionText)\n166\t\t\tos.Exit(0)\n167\t\t\treturn 0, nil\n168\t\tcase \"--symbolic\":\n169\t\t\topts.symbolic = true\n170\t\t\treturn 1, nil\n171\t\tdefault:\n172\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n173\t\t}\n174\t}\n175\t\n176\tfunc parseShortFlags(flags string, opts *options) error {\n177\t\tfor j := 0; j < len(flags); j++ {\n178\t\t\tswitch flags[j] {\n179\t\t\tcase 's':\n180\t\t\t\topts.symbolic = true\n181\t\t\tdefault:\n182\t\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n183\t\t\t}\n184\t\t}\n185\t\treturn nil\n186\t}\n187\t"}]},"parent_tool_use_id":null,"session_id":"2fc66413-5509-443d-b291-04e23843da1d","uuid":"5be80922-f847-49d6-aebe-bccebb2368fc","timestamp":"2026-05-20T11:28:21.901Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5340/cmd/ln/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ln [OPTION]... TARGET LINK_NAME\n  or:  ln [OPTION]... TARGET\n  or:  ln [OPTION]... TARGET... DIRECTORY\nIn the 1st form, create a link to TARGET with the name LINK_NAME.\nIn the 2nd form, create a link to TARGET in the current directory.\nIn the 3rd form, create links to each TARGET in DIRECTORY.\n\n  -s, --symbolic  make symbolic links instead of hard links\n      --help      display this help and exit\n      --version   output version information and exit\n`\n\nconst versionText = `ln (go-unix-utils) dev\n`\n\ntype options struct {\n\tsymbolic bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, targets, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'ln --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tos.Exit(run(opts, targets))\n}\n\nfunc run(opts options, targets []string) int {\n\texitCode := 0\n\tlast := targets[len(targets)-1]\n\n\tswitch {\n\tcase len(targets) == 1:\n\t\tlinkName := filepath.Base(targets[0])\n\t\tif err := createLink(targets[0], linkName, opts); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\tcase isDirectory(last):\n\t\tfor _, target := range targets[:len(targets)-1] {\n\t\t\tlinkName := filepath.Join(last, filepath.Base(target))\n\t\t\tif err := createLink(target, linkName, opts); err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\t\t\texitCode = 1\n\t\t\t}\n\t\t}\n\tcase len(targets) == 2:\n\t\tif err := createLink(targets[0], targets[1], opts); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"ln: target '%s' is not a directory\\n\", last)\n\t\texitCode = 1\n\t}\n\n\treturn exitCode\n}\n\nfunc createLink(target, linkName string, opts options) error {\n\tif opts.symbolic {\n\t\tif err := os.Symlink(target, linkName); err != nil {\n\t\t\treturn fmt.Errorf(\"failed to create symbolic link '%s': %s\",\n\t\t\t\tlinkName, sysError(err))\n\t\t}\n\t\treturn nil\n\t}\n\treturn createHardLink(target, linkName)\n}\n\nfunc createHardLink(target, linkName string) error {\n\tfi, err := os.Stat(target)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to access '%s': %s\", target, sysError(err))\n\t}\n\tif fi.IsDir() {\n\t\treturn fmt.Errorf(\"'%s': hard link not allowed for directory\", target)\n\t}\n\tif err := os.Link(target, linkName); err != nil {\n\t\treturn fmt.Errorf(\"failed to create hard link '%s': %s\",\n\t\t\tlinkName, sysError(err))\n\t}\n\treturn nil\n}\n\nfunc isDirectory(path string) bool {\n\tfi, err := os.Stat(path)\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn fi.IsDir()\n}\n\nfunc sysError(err error) string {\n\tfor u := errors.Unwrap(err); u != nil; u = errors.Unwrap(err) {\n\t\terr = u\n\t}\n\treturn err.Error()\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar targets []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ttargets = append(targets, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tif err := parseShortFlags(arg[1:], &opts); err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\ttargets = append(targets, arg)\n\t\ti++\n\t}\n\n\tif len(targets) == 0 {\n\t\treturn opts, nil, fmt.Errorf(\"missing file operand\")\n\t}\n\n\treturn opts, targets, nil\n}\n\nfunc parseLongFlag(flag string, opts *options) (int, error) {\n\tswitch flag {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase \"--symbolic\":\n\t\topts.symbolic = true\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, opts *options) error {\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 's':\n\t\t\topts.symbolic = true\n\t\tdefault:\n\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn nil\n}\n","numLines":187,"startLine":1,"totalLines":187}}}
