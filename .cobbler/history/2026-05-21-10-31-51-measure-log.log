s/software-requirements/srd062-touch.yaml (touch SRD -- requirements R1.1 through R1.4)\n      - docs/ARCHITECTURE.yaml (shared_protocols section -- differential testing and SIGPIPE patterns)\n      - pkg/sys/sys.go (InstallSIGPIPEHandler usage)\n      - pkg/testutils/difftest.go (DiffTest struct and RunDiffTests function)\n\n    files:\n      - path: cmd/touch/main.go\n        action: create\n        note: touch utility implementation covering srd062 R1.1-R1.4\n      - path: cmd/touch/touch_test.go\n        action: create\n        note: differential tests for srd062 R1.1-R1.4\n\n    requirements:\n      - id: R1\n        text: \"Implement srd062 R1.1 per the SRD specification\"\n      - id: R2\n        text: \"Implement srd062 R1.2 per the SRD specification\"\n      - id: R3\n        text: \"Implement srd062 R1.3 per the SRD specification\"\n      - id: R4\n        text: \"Implement srd062 R1.4 per the SRD specification\"\n\n    design_decisions:\n      - id: D1\n        text: \"Call sys.InstallSIGPIPEHandler() at the start of main to match GNU coreutils SIGPIPE behavior\"\n      - id: D2\n        text: \"Use testutils.BuildBinary and testutils.RunDiffTests for differential testing against gtouch\"\n      - id: D3\n        text: \"Call exec.LookPath(\\\"gtouch\\\") and t.Skip if the reference binary is not found\"\n      - id: D4\n        text: \"Set LC_ALL=C in test environment for deterministic output comparison\"\n\n    acceptance_criteria:\n      - id: AC1\n        text: \"cmd/touch/main.go compiles with go build -o bin/touch ./cmd/touch/\"\n      - id: AC2\n        text: \"cmd/touch/touch_test.go passes with go test ./cmd/touch/... -count=1\"\n      - id: AC3\n        text: \"go vet ./cmd/touch/... reports no issues\"\n      - id: AC4\n        text: \"Differential tests compare touch output against gtouch for all R1.1-R1.4 scenarios\"\n      - id: AC5\n        text: \"Tests skip gracefully when gtouch is not installed\"\n\n- index: 1\n  title: \"[stitch] cmd/t