s([]string{\"hello\"}, 80)\n\twant := [][]string{{\"hello\"}}\n\tif !reflect.DeepEqual(got, want) {\n\t\tt.Errorf(\"Columns([hello], 80) = %v, want %v\", got, want)\n\t}\n}\n\nfunc TestColumnsMulti(t *testing.T) {\n\tt.Parallel()\n\tentries := []string{\"a\", \"b\", \"c\", \"d\"}\n\tgot := Columns(entries, 4)\n\twant := [][]string{{\"a\", \"c\"}, {\"b\", \"d\"}}\n\tif !reflect.DeepEqual(got, want) {\n\t\tt.Errorf(\"Columns(%v, 4) = %v, want %v\", entries, got, want)\n\t}\n}\n\nfunc TestColumnsForceSingleColumn(t *testing.T) {\n\tt.Parallel()\n\tentries := []string{\"hello\", \"world\"}\n\tgot := Columns(entries, 3)\n\twant := [][]string{{\"hello\"}, {\"world\"}}\n\tif !reflect.DeepEqual(got, want) {\n\t\tt.Errorf(\"Columns(%v, 3) = %v, want %v\", entries, got, want)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":7024,"cache_read_input_tokens":27792,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7024},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"30f6ce8b-19e5-4f5d-a66c-eb0ad304e850","uuid":"fb083abb-a426-4841-9884-be309ffd9191"}
