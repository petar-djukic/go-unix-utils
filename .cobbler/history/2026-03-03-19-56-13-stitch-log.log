No flags, binary input (all byte values 0x00-0xFF) passes through without corruption.\n    inputs:\n      args: []\n      stdin: \"\\\\x00\\\\x01\\\\x02...\\\\xfe\\\\xff (all 256 byte values)\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: identical 256 bytes as input\n      stderr: \"\"\n    traces:\n      - prd006-cat R1.4\n\n  - name: cat_line_numbering_n\n    description: -n flag prepends line numbers to all lines including blank lines.\n    inputs:\n      args: [\"-n\"]\n      stdin: \"alpha\\n\\nbeta\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\talpha\\n     2\\t\\n     3\\tbeta\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R2.1\n\n  - name: cat_line_numbering_b\n    description: -b flag prepends line numbers only to non-blank lines.\n    inputs:\n      args: [\"-b\"]\n      stdin: \"first\\n\\n\\nsecond\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\tfirst\\n\\n\\n     2\\tsecond\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R2.2\n      - prd006-cat R2.4\n\n  - name: cat_squeeze_blanks\n    description: -s collapses consecutive blank lines to one.\n    inputs:\n      args: [\"-s\"]\n      stdin: \"a\\n\\n\\n\\nb\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a\\n\\nb\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R3.1\n\n  - name: cat_show_nonprinting\n    description: -v displays non-printing characters with caret and M- notation.\n    inputs:\n      args: [\"-v\"]\n      stdin: \"\\\\x01\\\\x09\\\\x1b\\\\x7f\\\\x80\\\\xff\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"^A\\\\x09^[^?M-^@M-^?\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R4.1\n      - prd006-cat R4.2\n\n  - name: cat_show_ends\n    description: -E appends \"$\" before each newline.\n    inputs:\n