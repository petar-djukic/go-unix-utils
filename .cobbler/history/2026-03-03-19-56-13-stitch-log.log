ts:\n      args: [\"-n\", \"-s\"]\n      stdin: \"a\\n\\n\\n\\nb\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\ta\\n     2\\t\\n     3\\tb\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R3.3\n      - prd006-cat R4.9\n\n  - name: cat_multiple_files\n    description: 'Two files concatenated with no separator between them. Setup: file1.txt contains \"aaa\\n\", file2.txt contains \"bbb\\n\"'\n    inputs:\n      args: [\"file1.txt\", \"file2.txt\"]\n      stdin: null\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"aaa\\nbbb\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R1.1\n      - prd006-cat R1.3\n\n  - name: cat_stdin_dash\n    description: '\"-\" as a filename argument reads from stdin.'\n    inputs:\n      args: [\"-\"]\n      stdin: \"from stdin\\n\"\n      env: []\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"from stdin\\n\"\n      stderr: \"\"\n    traces:\n      - prd006-cat R1.2\n\n  - name: cat_missing_file\n    description: 'Non-existent file prints error to stderr, exits 1, continues processing. Setup: real.txt contains \"data\\n\", nonexistent.txt does not exist'\n    inputs:\n      args: [\"nonexistent.txt\", \"real.txt\"]\n      stdin: null\n      env: []\n    normalization: none\n    expected:\n      exit_code: 1\n      stdout: \"data\\n\"\n      stderr_contains: \"nonexistent.txt\"\n    traces:\n      - prd006-cat R5.2\n","numLines":249,"startLine":1,"totalLines":249}}}
