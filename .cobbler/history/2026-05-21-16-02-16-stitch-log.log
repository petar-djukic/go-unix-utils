{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WaE7HhaZyzbSWU4nmczpF8","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"regexp\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype patternKind int\n19\t\n20\tconst (\n21\t\tkindRegexp patternKind = iota\n22\t\tkindSkip\n23\t\tkindInteger\n24\t)\n25\t\n26\ttype pattern struct {\n27\t\tkind    patternKind\n28\t\tregex   *regexp.Regexp\n29\t\tlineNum int\n30\t\traw     string\n31\t}\n32\t\n33\ttype splitter struct {\n34\t\tlines   []string\n35\t\tpos     int\n36\t\tfileNum int\n37\t\tprefix  string\n38\t\tdigits  int\n39\t\tcreated []string\n40\t}\n41\t\n42\tfunc main() {\n43\t\tsys.InstallSIGPIPEHandler()\n44\t\tif err := run(os.Args[1:]); err != nil {\n45\t\t\tfmt.Fprintf(os.Stderr, \"%s\\n\", err)\n46\t\t\tos.Exit(1)\n47\t\t}\n48\t}\n49\t\n50\tfunc run(args []string) error {\n51\t\tif len(args) < 2 {\n52\t\t\tif len(args) == 0 {\n53\t\t\t\treturn fmt.Errorf(\"csplit: missing operand\")\n54\t\t\t}\n55\t\t\treturn fmt.Errorf(\"csplit: missing operand after '%s'\", args[0])\n56\t\t}\n57\t\tpats, err := parsePatterns(args[1:])\n58\t\tif err != nil {\n59\t\t\treturn err\n60\t\t}\n61\t\tdata, err := readInput(args[0])\n62\t\tif err != nil {\n63\t\t\treturn err\n64\t\t}\n65\t\ts := &splitter{\n66\t\t\tlines:  splitToLines(data),\n67\t\t\tprefix: \"xx\",\n68\t\t\tdigits: 2,\n69\t\t}\n70\t\treturn s.process(pats)\n71\t}\n72\t\n73\tfunc readInput(filename string) ([]byte, error) {\n74\t\tif filename == \"-\" {\n75\t\t\tdata, err := io.ReadAll(os.Stdin)\n76\t\t\tif err != nil {\n77\t\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n78\t\t\t}\n79\t\t\treturn data, nil\n80\t\t}\n81\t\tdata, err := os.ReadFile(filename)\n82\t\tif err != nil {\n83\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n84\t\t}\n85\t\treturn data, nil\n86\t}\n87\t\n88\tfunc splitToLines(data []byte) []string {\n89\t\tif len(data) == 0 {\n90\t\t\treturn nil\n91\t\t}\n92\t\tvar lines []string\n93\t\tfor len(data) > 0 {\n94\t\t\tidx := bytes.IndexByte(data, '\\n')\n95\t\t\tif idx < 0 {\n96\t\t\t\tlines = append(lines, string(data))\n97\t\t\t\tbreak\n98\t\t\t}\n99\t\t\tlines = append(lines, string(data[:idx+1]))\n100\t\t\tdata = data[idx+1:]\n101\t\t}\n102\t\treturn lines\n103\t}\n104\t\n105\tfunc parsePatterns(args []string) ([]pattern, error) {\n106\t\tpats := make([]pattern, 0, len(args))\n107\t\tfor _, arg := range args {\n108\t\t\tp, err := parsePattern(arg)\n109\t\t\tif err != nil {\n110\t\t\t\treturn nil, err\n111\t\t\t}\n112\t\t\tpats = append(pats, p)\n113\t\t}\n114\t\treturn pats, nil\n115\t}\n116\t\n117\tfunc parsePattern(arg string) (pattern, error) {\n118\t\tif expr, ok := parseDelimited(arg, '/'); ok {\n119\t\t\tre, err := regexp.Compile(expr)\n120\t\t\tif err != nil {\n121\t\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n122\t\t\t}\n123\t\t\treturn pattern{kind: kindRegexp, regex: re, raw: arg}, nil\n124\t\t}\n125\t\tif expr, ok := parseDelimited(arg, '%'); ok {\n126\t\t\tre, err := regexp.Compile(expr)\n127\t\t\tif err != nil {\n128\t\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n129\t\t\t}\n130\t\t\treturn pattern{kind: kindSkip, regex: re, raw: arg}, nil\n131\t\t}\n132\t\tn, err := strconv.Atoi(arg)\n133\t\tif err == nil && n >= 0 {\n134\t\t\treturn pattern{kind: kindInteger, lineNum: n, raw: arg}, nil\n135\t\t}\n136\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': invalid pattern\", arg)\n137\t}\n138\t\n139\tfunc parseDelimited(arg string, delim byte) (string, bool) {\n140\t\tif len(arg) < 2 || arg[0] != delim || arg[len(arg)-1] != delim {\n141\t\t\treturn \"\", false\n142\t\t}\n143\t\treturn arg[1 : len(arg)-1], true\n144\t}\n145\t\n146\tfunc (s *splitter) process(pats []pattern) error {\n147\t\tfor _, pat := range pats {\n148\t\t\tif err := s.apply(pat); err != nil {\n149\t\t\t\tremoveFiles(s.created)\n150\t\t\t\treturn err\n151\t\t\t}\n152\t\t}\n153\t\tif err := s.emitPiece(len(s.lines)); err != nil {\n154\t\t\tremoveFiles(s.created)\n155\t\t\treturn err\n156\t\t}\n157\t\treturn nil\n158\t}\n159\t\n160\tfunc (s *splitter) apply(pat pattern) error {\n161\t\tswitch pat.kind {\n162\t\tcase kindRegexp:\n163\t\t\tidx := matchRegexp(s.lines, s.pos, pat.regex)\n164\t\t\tif idx < 0 {\n165\t\t\t\ts.emitPiece(len(s.lines))\n166\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n167\t\t\t}\n168\t\t\treturn s.emitPiece(idx)\n169\t\tcase kindSkip:\n170\t\t\tidx := matchRegexp(s.lines, s.pos, pat.regex)\n171\t\t\tif idx < 0 {\n172\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n173\t\t\t}\n174\t\t\ts.pos = idx\n175\t\t\treturn nil\n176\t\tdefault:\n177\t\t\treturn s.applyInteger(pat)\n178\t\t}\n179\t}\n180\t\n181\tfunc (s *splitter) applyInteger(pat pattern) error {\n182\t\ttarget := pat.lineNum - 1\n183\t\tif target < s.pos || target > len(s.lines) {\n184\t\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n185\t\t}\n186\t\treturn s.emitPiece(target)\n187\t}\n188\t\n189\tfunc (s *splitter) emitPiece(to int) error {\n190\t\tpiece := s.lines[s.pos:to]\n191\t\tname := fmt.Sprintf(\"%s%0*d\", s.prefix, s.digits, s.fileNum)\n192\t\ts.created = append(s.created, name)\n193\t\tcontent := strings.Join(piece, \"\")\n194\t\tif err := os.WriteFile(name, []byte(content), 0666); err != nil {\n195\t\t\treturn fmt.Errorf(\"csplit: %v\", err)\n196\t\t}\n197\t\ts.fileNum++\n198\t\ts.pos = to\n199\t\tfmt.Println(len(content))\n200\t\treturn nil\n201\t}\n202\t\n203\tfunc matchRegexp(lines []string, start int, re *regexp.Regexp) int {\n204\t\tfor i := start; i < len(lines); i++ {\n205\t\t\tline := strings.TrimSuffix(lines[i], \"\\n\")\n206\t\t\tif re.MatchString(line) {\n207\t\t\t\treturn i\n208\t\t\t}\n209\t\t}\n210\t\treturn -1\n211\t}\n212\t\n213\tfunc removeFiles(files []string) {\n214\t\tfor _, f := range files {\n215\t\t\tos.Remove(f)\n216\t\t}\n217\t}\n218\t"}]},"parent_tool_use_id":null,"session_id":"f8cc86ec-d5d0-48bb-b1ea-93b487356535","uuid":"0a4d7af4-91a9-43ab-b736-e27acbd4d8cc","timestamp":"2026-05-21T20:02:28.087Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5450/cmd/csplit/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype patternKind int\n\nconst (\n\tkindRegexp patternKind = iota\n\tkindSkip\n\tkindInteger\n)\n\ntype pattern struct {\n\tkind    patternKind\n\tregex   *regexp.Regexp\n\tlineNum int\n\traw     string\n}\n\ntype splitter struct {\n\tlines   []string\n\tpos     int\n\tfileNum int\n\tprefix  string\n\tdigits  int\n\tcreated []string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tif err := run(os.Args[1:]); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"%s\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc run(args []string) error {\n\tif len(args) < 2 {\n\t\tif len(args) == 0 {\n\t\t\treturn fmt.Errorf(\"csplit: missing operand\")\n\t\t}\n\t\treturn fmt.Errorf(\"csplit: missing operand after '%s'\", args[0])\n\t}\n\tpats, err := parsePatterns(args[1:])\n\tif err != nil {\n\t\treturn err\n\t}\n\tdata, err := readInput(args[0])\n\tif err != nil {\n\t\treturn err\n\t}\n\ts := &splitter{\n\t\tlines:  splitToLines(data),\n\t\tprefix: \"xx\",\n\t\tdigits: 2,\n\t}\n\treturn s.process(pats)\n}\n\nfunc readInput(filename string) ([]byte, error) {\n\tif filename == \"-\" {\n\t\tdata, err := io.ReadAll(os.Stdin)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n\t\t}\n\t\treturn data, nil\n\t}\n\tdata, err := os.ReadFile(filename)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n\t}\n\treturn data, nil\n}\n\nfunc splitToLines(data []byte) []string {\n\tif len(data) == 0 {\n\t\treturn nil\n\t}\n\tvar lines []string\n\tfor len(data) > 0 {\n\t\tidx := bytes.IndexByte(data, '\\n')\n\t\tif idx < 0 {\n\t\t\tlines = append(lines, string(data))\n\t\t\tbreak\n\t\t}\n\t\tlines = append(lines, string(data[:idx+1]))\n\t\tdata = data[idx+1:]\n\t}\n\treturn lines\n}\n\nfunc parsePatterns(args []string) ([]pattern, error) {\n\tpats := make([]pattern, 0, len(args))\n\tfor _, arg := range args {\n\t\tp, err := parsePattern(arg)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tpats = append(pats, p)\n\t}\n\treturn pats, nil\n}\n\nfunc parsePattern(arg string) (pattern, error) {\n\tif expr, ok := parseDelimited(arg, '/'); ok {\n\t\tre, err := regexp.Compile(expr)\n\t\tif err != nil {\n\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n\t\t}\n\t\treturn pattern{kind: kindRegexp, regex: re, raw: arg}, nil\n\t}\n\tif expr, ok := parseDelimited(arg, '%'); ok {\n\t\tre, err := regexp.Compile(expr)\n\t\tif err != nil {\n\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n\t\t}\n\t\treturn pattern{kind: kindSkip, regex: re, raw: arg}, nil\n\t}\n\tn, err := strconv.Atoi(arg)\n\tif err == nil && n >= 0 {\n\t\treturn pattern{kind: kindInteger, lineNum: n, raw: arg}, nil\n\t}\n\treturn pattern{}, fmt.Errorf(\"csplit: '%s': invalid pattern\", arg)\n}\n\nfunc parseDelimited(arg string, delim byte) (string, bool) {\n\tif len(arg) < 2 || arg[0] != delim || arg[len(arg)-1] != delim {\n\t\treturn \"\", false\n\t}\n\treturn arg[1 : len(arg)-1], true\n}\n\nfunc (s *splitter) process(pats []pattern) error {\n\tfor _, pat := range pats {\n\t\tif err := s.apply(pat); err != nil {\n\t\t\tremoveFiles(s.created)\n\t\t\treturn err\n\t\t}\n\t}\n\tif err := s.emitPiece(len(s.lines)); err != nil {\n\t\tremoveFiles(s.created)\n\t\treturn err\n\t}\n\treturn nil\n}\n\nfunc (s *splitter) apply(pat pattern) error {\n\tswitch pat.kind {\n\tcase kindRegexp:\n\t\tidx := matchRegexp(s.lines, s.pos, pat.regex)\n\t\tif idx < 0 {\n\t\t\ts.emitPiece(len(s.lines))\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\treturn s.emitPiece(idx)\n\tcase kindSkip:\n\t\tidx := matchRegexp(s.lines, s.pos, pat.regex)\n\t\tif idx < 0 {\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ts.pos = idx\n\t\treturn nil\n\tdefault:\n\t\treturn s.applyInteger(pat)\n\t}\n}\n\nfunc (s *splitter) applyInteger(pat pattern) error {\n\ttarget := pat.lineNum - 1\n\tif target < s.pos || target > len(s.lines) {\n\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n\t}\n\treturn s.emitPiece(target)\n}\n\nfunc (s *splitter) emitPiece(to int) error {\n\tpiece := s.lines[s.pos:to]\n\tname := fmt.Sprintf(\"%s%0*d\", s.prefix, s.digits, s.fileNum)\n\ts.created = append(s.created, name)\n\tcontent := strings.Join(piece, \"\")\n\tif err := os.WriteFile(name, []byte(content), 0666); err != nil {\n\t\treturn fmt.Errorf(\"csplit: %v\", err)\n\t}\n\ts.fileNum++\n\ts.pos = to\n\tfmt.Println(len(content))\n\treturn nil\n}\n\nfunc matchRegexp(lines []string, start int, re *regexp.Regexp) int {\n\tfor i := start; i < len(lines); i++ {\n\t\tline := strings.TrimSuffix(lines[i], \"\\n\")\n\t\tif re.MatchString(line) {\n\t\t\treturn i\n\t\t}\n\t}\n\treturn -1\n}\n\nfunc removeFiles(files []string) {\n\tfor _, f := range files {\n\t\tos.Remove(f)\n\t}\n}\n","numLines":218,"startLine":1,"totalLines":218}}}
