ring, dir byte) string {\n205\t\tswitch dir {\n206\t\tcase 'a':\n207\t\t\treturn fmt.Sprintf(\"%d\", fs.Bavail)\n208\t\tcase 'b':\n209\t\t\treturn fmt.Sprintf(\"%d\", fs.Blocks)\n210\t\tcase 'c':\n211\t\t\treturn fmt.Sprintf(\"%d\", fs.Files)\n212\t\tcase 'd':\n213\t\t\treturn fmt.Sprintf(\"%d\", fs.Ffree)\n214\t\tcase 'f':\n215\t\t\treturn fmt.Sprintf(\"%d\", fs.Bfree)\n216\t\tcase 'i':\n217\t\t\treturn fsIDHex(fs.Fsid)\n218\t\tcase 'l':\n219\t\t\treturn \"?\"\n220\t\tcase 'n':\n221\t\t\treturn path\n222\t\tcase 's':\n223\t\t\treturn fmt.Sprintf(\"%d\", fs.Bsize)\n224\t\tcase 'S':\n225\t\t\treturn fmt.Sprintf(\"%d\", fs.Bsize)\n226\t\tcase 't':\n227\t\t\treturn fmt.Sprintf(\"%x\", fs.Type)\n228\t\tcase 'T':\n229\t\t\treturn int8ToStr(fs.Fstypename[:])\n230\t\tdefault:\n231\t\t\treturn \"%\" + string(dir)\n232\t\t}\n233\t}\n234\t\n235\tfunc parseEscape(s string) (string, int) {\n236\t\tif len(s) < 2 {\n237\t\t\treturn \"\\\\\", 1\n238\t\t}\n239\t\tswitch s[1] {\n240\t\tcase 'n':\n241\t\t\treturn \"\\n\", 2\n242\t\tcase 't':\n243\t\t\treturn \"\\t\", 2\n244\t\tcase 'r':\n245\t\t\treturn \"\\r\", 2\n246\t\tcase '\\\\':\n247\t\t\treturn \"\\\\\", 2\n248\t\tcase 'a':\n249\t\t\treturn \"\\a\", 2\n250\t\tcase 'b':\n251\t\t\treturn \"\\b\", 2\n252\t\tcase 'f':\n253\t\t\treturn \"\\f\", 2\n254\t\tcase 'v':\n255\t\t\treturn \"\\v\", 2\n256\t\tcase '0':\n257\t\t\treturn parseOctalEscape(s)\n258\t\tcase 'x':\n259\t\t\treturn parseHexEscape(s)\n260\t\tdefault:\n261\t\t\treturn string(s[:2]), 2\n262\t\t}\n263\t}\n264\t\n265\tfunc parseOctalEscape(s string) (string, int) {\n266\t\tn := 2\n267\t\tval := 0\n268\t\tfor n < len(s) && n < 5 && s[n] >= '0' && s[n] <= '7' {\n269\t\t\tval = val*8 + int(s[n]-'0')\n270\t\t\tn++\n271\t\t}\n272\t\tif n == 2 {\n273\t\t\treturn \"\\x00\", 2\n274\t\t}\n275\t\treturn string(rune(val)), n\n276\t}\n277\t\n278\tfunc parseHexEscape(s string) (string, int) {\n279\t\tn := 2\n280\t\tval := 0\n281\t\tfor n < len(s) && n < 4 {\n282\t\t\tc := s[n]\n283\t\