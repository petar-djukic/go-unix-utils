t\t\tArgs: []string{\"-L\", \"-P\"},\n\t\t},\n\t\t{\n\t\t\tName: \"physical-then-logical\",\n\t\t\tArgs: []string{\"-P\", \"-L\"},\n\t\t},\n\t\t{\n\t\t\tName: \"combined-LP\",\n\t\t\tArgs: []string{\"-LP\"},\n\t\t},\n\t\t{\n\t\t\tName: \"combined-PL\",\n\t\t\tArgs: []string{\"-PL\"},\n\t\t},\n\t\t// R2.1: extra positional operand (gpwd warns but still prints and exits 0)\n\t\t{\n\t\t\tName:      \"extra-operand\",\n\t\t\tArgs:      []string{\"foo\"},\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t},\n\t\t{\n\t\t\tName:      \"extra-operand-after-dashdash\",\n\t\t\tArgs:      []string{\"--\", \"foo\"},\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t},\n\t\t// R2.2: unknown flags\n\t\t{\n\t\t\tName:      \"error-unknown-long-flag\",\n\t\t\tArgs:      []string{\"--bogus\"},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t},\n\t\t{\n\t\t\tName:      \"error-unknown-short-flag\",\n\t\t\tArgs:      []string{\"-x\"},\n\t\t\tExitCode:  1,\n\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t},\n\t\t// --help and --version (discard stdout since text differs)\n\t\t{\n\t\t\tName:      \"help\",\n\t\t\tArgs:      []string{\"--help\"},\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStdout},\n\t\t},\n\t\t{\n\t\t\tName:      \"version\",\n\t\t\tArgs:      []string{\"--version\"},\n\t\t\tNormalize: []testutils.NormalizeFunc{discardStdout},\n\t\t},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":7,"lines":[" // Copyright (c) 2026 Petar Djukic. All rights reserved."," // SPDX-License-Identifier: MIT"," ","+// Implements srd051-pwd R3.1-R3.3."," package main"," "," import ("]}],"userModified":false,"replaceAll":false}}
