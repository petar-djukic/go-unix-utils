{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016XTA1bskvCVKDhw7BQA2WS","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd110-pr R1.1, R2.1, R2.2, R2.3, R3.1.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n19\t)\n20\t\n21\tconst (\n22\t\theaderSize     = 5\n23\t\tfooterSize     = 5\n24\t\tdefaultPageLen = 66\n25\t\tdefaultWidth   = 72\n26\t)\n27\t\n28\ttype options struct {\n29\t\tpageLength     int\n30\t\theaderText     string\n31\t\theaderSet      bool\n32\t\tomitHeader     bool\n33\t\tomitPagination bool\n34\t\tcolumns        int\n35\t\tacross         bool\n36\t}\n37\t\n38\tfunc main() {\n39\t\tsys.InstallSIGPIPEHandler()\n40\t\tos.Exit(run(os.Args[1:]))\n41\t}\n42\t\n43\tfunc run(args []string) int {\n44\t\topts, files, err := parseArgs(args)\n45\t\tif err != nil {\n46\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n47\t\t\treturn 1\n48\t\t}\n49\t\tif len(files) == 0 {\n50\t\t\tfiles = []string{\"-\"}\n51\t\t}\n52\t\tw := bufio.NewWriter(os.Stdout)\n53\t\texitCode := 0\n54\t\tfor _, f := range files {\n55\t\t\tif err := processFile(f, opts, w); err != nil {\n56\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n57\t\t\t\t\tos.Exit(0)\n58\t\t\t\t}\n59\t\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n60\t\t\t\texitCode = 1\n61\t\t\t}\n62\t\t}\n63\t\tif err := w.Flush(); err != nil {\n64\t\t\tif errors.Is(err, syscall.EPIPE) {\n65\t\t\t\tos.Exit(0)\n66\t\t\t}\n67\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n68\t\t\texitCode = 1\n69\t\t}\n70\t\treturn exitCode\n71\t}\n72\t\n73\tfunc parseArgs(args []string) (options, []string, error) {\n74\t\topts := options{pageLength: defaultPageLen}\n75\t\tvar files []string\n76\t\tfor i := 0; i < len(args); i++ {\n77\t\t\ta := args[i]\n78\t\t\tif a == \"--\" {\n79\t\t\t\tfiles = append(files, args[i+1:]...)\n80\t\t\t\tbreak\n81\t\t\t}\n82\t\t\tvar err error\n83\t\t\tswitch {\n84\t\t\tcase strings.HasPrefix(a, \"--length=\"):\n85\t\t\t\terr = setPageLen(&opts, a[len(\"--length=\"):])\n86\t\t\tcase strings.HasPrefix(a, \"--header=\"):\n87\t\t\t\topts.headerText, opts.headerSet = a[len(\"--header=\"):], true\n88\t\t\tcase a == \"--omit-header\" || a == \"-t\":\n89\t\t\t\topts.omitHeader = true\n90\t\t\tcase a == \"--omit-pagination\" || a == \"-T\":\n91\t\t\t\topts.omitPagination = true\n92\t\t\tcase strings.HasPrefix(a, \"-l\"):\n93\t\t\t\terr = parseLenFlag(args, &i, &opts)\n94\t\t\tcase strings.HasPrefix(a, \"-h\"):\n95\t\t\t\terr = parseHdrFlag(args, &i, &opts)\n96\t\t\tcase a == \"--across\" || a == \"-a\":\n97\t\t\t\topts.across = true\n98\t\t\tcase strings.HasPrefix(a, \"--columns=\"):\n99\t\t\t\terr = setColumns(&opts, a[len(\"--columns=\"):])\n100\t\t\tcase isColumnsFlag(a):\n101\t\t\t\terr = setColumns(&opts, a[1:])\n102\t\t\tcase strings.HasPrefix(a, \"-\") && a != \"-\":\n103\t\t\t\terr = fmt.Errorf(\"unrecognized option '%s'\", a)\n104\t\t\tdefault:\n105\t\t\t\tfiles = append(files, a)\n106\t\t\t}\n107\t\t\tif err != nil {\n108\t\t\t\treturn opts, nil, err\n109\t\t\t}\n110\t\t}\n111\t\tif opts.pageLength <= 10 {\n112\t\t\topts.omitHeader = true\n113\t\t}\n114\t\treturn opts, files, nil\n115\t}\n116\t\n117\tfunc parseLenFlag(args []string, i *int, opts *options) error {\n118\t\tv, err := valFlag(args, i, \"-l\")\n119\t\tif err != nil {\n120\t\t\treturn err\n121\t\t}\n122\t\treturn setPageLen(opts, v)\n123\t}\n124\t\n125\tfunc parseHdrFlag(args []string, i *int, opts *options) error {\n126\t\tv, err := valFlag(args, i, \"-h\")\n127\t\tif err != nil {\n128\t\t\treturn err\n129\t\t}\n130\t\topts.headerText, opts.headerSet = v, true\n131\t\treturn nil\n132\t}\n133\t\n134\tfunc valFlag(args []string, i *int, prefix string) (string, error) {\n135\t\ta := args[*i]\n136\t\tif len(a) > len(prefix) {\n137\t\t\treturn a[len(prefix):], nil\n138\t\t}\n139\t\t*i++\n140\t\tif *i >= len(args) {\n141\t\t\treturn \"\", fmt.Errorf(\"option requires an argument -- '%c'\", prefix[1])\n142\t\t}\n143\t\treturn args[*i], nil\n144\t}\n145\t\n146\tfunc setPageLen(opts *options, s string) error {\n147\t\tn, err := strconv.Atoi(s)\n148\t\tif err != nil || n < 1 {\n149\t\t\treturn fmt.Errorf(\"invalid page length: %q\", s)\n150\t\t}\n151\t\topts.pageLength = n\n152\t\treturn nil\n153\t}\n154\t\n155\tfunc setColumns(opts *options, s string) error {\n156\t\tn, err := strconv.Atoi(s)\n157\t\tif err != nil || n < 1 {\n158\t\t\treturn fmt.Errorf(\"invalid number of columns: %q\", s)\n159\t\t}\n160\t\topts.columns = n\n161\t\treturn nil\n162\t}\n163\t\n164\tfunc isColumnsFlag(s string) bool {\n165\t\tif len(s) < 2 || s[0] != '-' {\n166\t\t\treturn false\n167\t\t}\n168\t\tfor _, c := range s[1:] {\n169\t\t\tif c < '0' || c > '9' {\n170\t\t\t\treturn false\n171\t\t\t}\n172\t\t}\n173\t\treturn true\n174\t}\n175\t\n176\tfunc processFile(path string, opts options, w *bufio.Writer) error {\n177\t\tvar r io.Reader\n178\t\tvar filename string\n179\t\tvar modTime time.Time\n180\t\tif path == \"-\" {\n181\t\t\tr = os.Stdin\n182\t\t\tfilename = \"\"\n183\t\t\tmodTime = time.Now()\n184\t\t} else {\n185\t\t\tf, err := os.Open(path)\n186\t\t\tif err != nil {\n187\t\t\t\treturn err\n188\t\t\t}\n189\t\t\tdefer f.Close()\n190\t\t\tinfo, err := f.Stat()\n191\t\t\tif err != nil {\n192\t\t\t\treturn err\n193\t\t\t}\n194\t\t\tr = f\n195\t\t\tfilename = path\n196\t\t\tmodTime = info.ModTime()\n197\t\t}\n198\t\tif opts.headerSet {\n199\t\t\tfilename = opts.headerText\n200\t\t}\n201\t\treturn paginate(r, filename, modTime, opts, w)\n202\t}\n203\t\n204\tfunc paginate(r io.Reader, filename string, modTime time.Time, opts options, w *bufio.Writer) error {\n205\t\tscanner := bufio.NewScanner(r)\n206\t\tcols := max(opts.columns, 1)\n207\t\tnoHdr := opts.omitHeader || opts.omitPagination\n208\t\tif noHdr && cols <= 1 {\n209\t\t\treturn paginateNoHeader(scanner, w)\n210\t\t}\n211\t\tbody := max(opts.pageLength-headerSize-footerSize, 1)\n212\t\tdate := modTime.Format(\"2006-01-02 15:04\")\n213\t\tpageNum := 1\n214\t\tfor {\n215\t\t\tlines, eof := readBody(scanner, body*cols)\n216\t\t\tif len(lines) == 0 && eof {\n217\t\t\t\tbreak\n218\t\t\t}\n219\t\t\tif !noHdr {\n220\t\t\t\tif err := writeHeader(w, date, filename, pageNum); err != nil {\n221\t\t\t\t\treturn err\n222\t\t\t\t}\n223\t\t\t}\n224\t\t\tif cols > 1 {\n225\t\t\t\tif err := writeColumns(w, lines, body, cols, opts.across); err != nil {\n226\t\t\t\t\treturn err\n227\t\t\t\t}\n228\t\t\t} else if err := writeBody(w, lines, body); err != nil {\n229\t\t\t\treturn err\n230\t\t\t}\n231\t\t\tif !noHdr {\n232\t\t\t\tif err := writeFooter(w); err != nil {\n233\t\t\t\t\treturn err\n234\t\t\t\t}\n235\t\t\t}\n236\t\t\tpageNum++\n237\t\t\tif eof {\n238\t\t\t\tbreak\n239\t\t\t}\n240\t\t}\n241\t\treturn scanner.Err()\n242\t}\n243\t\n244\tfunc paginateNoHeader(scanner *bufio.Scanner, w *bufio.Writer) error {\n245\t\tfor scanner.Scan() {\n246\t\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", scanner.Text()); err != nil {\n247\t\t\t\treturn err\n248\t\t\t}\n249\t\t}\n250\t\treturn scanner.Err()\n251\t}\n252\t\n253\tfunc readBody(scanner *bufio.Scanner, n int) ([]string, bool) {\n254\t\tvar lines []string\n255\t\tfor range n {\n256\t\t\tif !scanner.Scan() {\n257\t\t\t\treturn lines, true\n258\t\t\t}\n259\t\t\tlines = append(lines, scanner.Text())\n260\t\t}\n261\t\treturn lines, false\n262\t}\n263\t\n264\tfunc writeHeader(w *bufio.Writer, date, filename string, pageNum int) error {\n265\t\tif _, err := fmt.Fprint(w, \"\\n\\n\"); err != nil {\n266\t\t\treturn err\n267\t\t}\n268\t\tright := fmt.Sprintf(\"Page %d\", pageNum)\n269\t\tavail := defaultWidth - len(date) - len(right)\n270\t\tlpad := avail\n271\t\trpad := 0\n272\t\tif len(filename) < avail {\n273\t\t\tlpad = (avail - len(filename)) / 2\n274\t\t\trpad = avail - len(filename) - lpad\n275\t\t}\n276\t\tline := date + strings.Repeat(\" \", lpad) + filename + strings.Repeat(\" \", rpad) + right\n277\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", line); err != nil {\n278\t\t\treturn err\n279\t\t}\n280\t\t_, err := fmt.Fprint(w, \"\\n\\n\")\n281\t\treturn err\n282\t}\n283\t\n284\tfunc writeBody(w *bufio.Writer, lines []string, bodySize int) error {\n285\t\tfor _, line := range lines {\n286\t\t\tif _, err := fmt.Fprintf(w, \"%s\\n\", line); err != nil {\n287\t\t\t\treturn err\n288\t\t\t}\n289\t\t}\n290\t\tfor range bodySize - len(lines) {\n291\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n292\t\t\t\treturn err\n293\t\t\t}\n294\t\t}\n295\t\treturn nil\n296\t}\n297\t\n298\tfunc writeFooter(w *bufio.Writer) error {\n299\t\tfor range footerSize {\n300\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n301\t\t\t\treturn err\n302\t\t\t}\n303\t\t}\n304\t\treturn nil\n305\t}\n306\t\n307\tfunc writeColumns(w *bufio.Writer, lines []string, bodySize, cols int, across bool) error {\n308\t\tcolWidth := defaultWidth / cols\n309\t\trows := (len(lines) + cols - 1) / cols\n310\t\tfor r := range rows {\n311\t\t\tfor c := range cols {\n312\t\t\t\tvar idx int\n313\t\t\t\tif across {\n314\t\t\t\t\tidx = r*cols + c\n315\t\t\t\t} else {\n316\t\t\t\t\tidx = c*rows + r\n317\t\t\t\t}\n318\t\t\t\ttext := \"\"\n319\t\t\t\tif idx < len(lines) {\n320\t\t\t\t\ttext = lines[idx]\n321\t\t\t\t}\n322\t\t\t\tif c < cols-1 {\n323\t\t\t\t\ttext = padOrTrunc(text, colWidth)\n324\t\t\t\t}\n325\t\t\t\tif _, err := fmt.Fprint(w, text); err != nil {\n326\t\t\t\t\treturn err\n327\t\t\t\t}\n328\t\t\t}\n329\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n330\t\t\t\treturn err\n331\t\t\t}\n332\t\t}\n333\t\tfor range bodySize - rows {\n334\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n335\t\t\t\treturn err\n336\t\t\t}\n337\t\t}\n338\t\treturn nil\n339\t}\n340\t\n341\tfunc padOrTrunc(s string, width int) string {\n342\t\tif len(s) >= width {\n3