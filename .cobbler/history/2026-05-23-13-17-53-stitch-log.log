{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JvBPsC9akuGKXtvAfp9HbF","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/chmod implements srd089-chmod R1.1-R1.4, R2.1-R2.4, R3.1-R3.2, R4.1-R4.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\t\"syscall\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tconst helpText = `Usage: chmod [OPTION]... MODE[,MODE]... FILE...\n20\t  or:  chmod [OPTION]... OCTAL-MODE FILE...\n21\t  or:  chmod [OPTION]... --reference=RFILE FILE...\n22\tChange the mode of each FILE to MODE.\n23\t\n24\t  -c, --changes          like verbose but report only when a change is made\n25\t  -f, --silent, --quiet  suppress most error messages\n26\t  -v, --verbose          output a diagnostic for every file processed\n27\t      --no-preserve-root  do not treat '/' specially (the default)\n28\t      --preserve-root    fail to operate recursively on '/'\n29\t      --reference=RFILE  use RFILE's mode instead of MODE values\n30\t  -R, --recursive        change files and directories recursively\n31\t      --help     display this help and exit\n32\t      --version  output version information and exit\n33\t\n34\tEach MODE is of the form '[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+'.\n35\t`\n36\t\n37\tconst versionText = `chmod (go-unix-utils) dev\n38\t`\n39\t\n40\ttype options struct {\n41\t\tverbose      bool\n42\t\tchanges      bool\n43\t\tsilent       bool\n44\t\trecursive    bool\n45\t\tpreserveRoot bool\n46\t\treference    string\n47\t}\n48\t\n49\tfunc main() {\n50\t\tsys.InstallSIGPIPEHandler()\n51\t\n52\t\topts, mode, files := parseArgs(os.Args[1:])\n53\t\tif opts.reference != \"\" {\n54\t\t\tmode = resolveReference(opts.reference)\n55\t\t}\n56\t\tif len(files) == 0 {\n57\t\t\tfmt.Fprintf(os.Stderr, \"chmod: missing operand after '%s'\\n\", mode)\n58\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n59\t\t\tos.Exit(1)\n60\t\t}\n61\t\n62\t\texitCode := 0\n63\t\tfor _, file := range files {\n64\t\t\tif err := processFile(opts, mode, file); err != nil {\n65\t\t\t\texitCode = 1\n66\t\t\t}\n67\t\t}\n68\t\tif exitCode != 0 {\n69\t\t\tos.Exit(exitCode)\n70\t\t}\n71\t}\n72\t\n73\tfunc processFile(opts options, mode string, path string) error {\n74\t\tif opts.recursive {\n75\t\t\treturn processRecursive(opts, mode, path)\n76\t\t}\n77\t\treturn applyAndReport(opts, mode, path)\n78\t}\n79\t\n80\tfunc processRecursive(opts options, mode string, root string) error {\n81\t\tif opts.preserveRoot && isRootPath(root) {\n82\t\t\tfmt.Fprintf(os.Stderr,\n83\t\t\t\t\"chmod: it is dangerous to operate recursively on '/'\\nchmod: use --no-preserve-root to override this failsafe\\n\")\n84\t\t\treturn fmt.Errorf(\"refusing to operate on root\")\n85\t\t}\n86\t\tvar walkErr error\n87\t\terr := filepath.WalkDir(root, func(path string, _ os.DirEntry, err error) error {\n88\t\t\tif err != nil {\n89\t\t\t\treportError(opts, path, err)\n90\t\t\t\twalkErr = err\n91\t\t\t\treturn nil\n92\t\t\t}\n93\t\t\tif applyErr := applyAndReport(opts, mode, path); applyErr != nil {\n94\t\t\t\twalkErr = applyErr\n95\t\t\t}\n96\t\t\treturn nil\n97\t\t})\n98\t\tif err != nil {\n99\t\t\treturn err\n100\t\t}\n101\t\treturn walkErr\n102\t}\n103\t\n104\tfunc applyAndReport(opts options, mode string, path string) error {\n105\t\toldMode, err := getMode(path)\n106\t\tif err != nil {\n107\t\t\treportError(opts, path, err)\n108\t\t\treturn err\n109\t\t}\n110\t\tif err := applyMode(mode, path); err != nil {\n111\t\t\treportError(opts, path, err)\n112\t\t\treturn err\n113\t\t}\n114\t\tnewMode, err := getMode(path)\n115\t\tif err != nil {\n116\t\t\treportError(opts, path, err)\n117\t\t\treturn err\n118\t\t}\n119\t\tprintDiagnostic(opts, path, oldMode, newMode)\n120\t\treturn nil\n121\t}\n122\t\n123\tfunc getMode(path string) (os.FileMode, error) {\n124\t\tinfo, err := os.Lstat(path)\n125\t\tif err != nil {\n126\t\t\treturn 0, err\n127\t\t}\n128\t\treturn info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky)), nil\n129\t}\n130\t\n131\tfunc reportError(opts options, _ string, err error) {\n132\t\tif opts.silent {\n133\t\t\treturn\n134\t\t}\n135\t\tfmt.Fprintf(os.Stderr, \"chmod: %s\\n\", formatErr(err))\n136\t}\n137\t\n138\tfunc printDiagnostic(opts options, path string, oldMode, newMode os.FileMode) {\n139\t\tif opts.verbose {\n140\t\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n141\t\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n142\t\t\treturn\n143\t\t}\n144\t\tif opts.changes && oldMode != newMode {\n145\t\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n146\t\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n147\t\t}\n148\t}\n149\t\n150\tfunc symbolicString(mode os.FileMode) string {\n151\t\tvar buf [9]byte\n152\t\tconst rwx = \"rwx\"\n153\t\tfor i := range 9 {\n154\t\t\tif mode&(1<<uint(8-i)) != 0 {\n155\t\t\t\tbuf[i] = rwx[i%3]\n156\t\t\t} else {\n157\t\t\t\tbuf[i] = '-'\n158\t\t\t}\n159\t\t}\n160\t\tapplySpecialBits(&buf, mode)\n161\t\treturn string(buf[:])\n162\t}\n163\t\n164\tfunc applySpecialBits(buf *[9]byte, mode os.FileMode) {\n165\t\tif mode&os.ModeSetuid != 0 {\n166\t\t\tif buf[2] == 'x' {\n167\t\t\t\tbuf[2] = 's'\n168\t\t\t} else {\n169\t\t\t\tbuf[2] = 'S'\n170\t\t\t}\n171\t\t}\n172\t\tif mode&os.ModeSetgid != 0 {\n173\t\t\tif buf[5] == 'x' {\n174\t\t\t\tbuf[5] = 's'\n175\t\t\t} else {\n176\t\t\t\tbuf[5] = 'S'\n177\t\t\t}\n178\t\t}\n179\t\tif mode&os.ModeSticky != 0 {\n180\t\t\tif buf[8] == 'x' {\n181\t\t\t\tbuf[8] = 't'\n182\t\t\t} else {\n183\t\t\t\tbuf[8] = 'T'\n184\t\t\t}\n185\t\t}\n186\t}\n187\t\n188\tfunc parseArgs(args []string) (options, string, []string) {\n189\t\tvar opts options\n190\t\tvar files []string\n191\t\tmode := \"\"\n192\t\tendOfFlags := false\n193\t\tfor _, arg := range args {\n194\t\t\tif endOfFlags {\n195\t\t\t\tfiles = append(files, arg)\n196\t\t\t\tcontinue\n197\t\t\t}\n198\t\t\tif handled := handleSpecialArg(arg, &endOfFlags); handled {\n199\t\t\t\tcontinue\n200\t\t\t}\n201\t\t\tif parseLongFlag(arg, &opts) {\n202\t\t\t\tcontinue\n203\t\t\t}\n204\t\t\tif mode == \"\" {\n205\t\t\t\tif strings.HasPrefix(arg, \"-\") && parseShortFlags(arg[1:], &opts) {\n206\t\t\t\t\tcontinue\n207\t\t\t\t}\n208\t\t\t\tif opts.reference != \"\" {\n209\t\t\t\t\tfiles = append(files, arg)\n210\t\t\t\t} else {\n211\t\t\t\t\tmode = arg\n212\t\t\t\t}\n213\t\t\t} else {\n214\t\t\t\tfiles = append(files, arg)\n215\t\t\t}\n216\t\t}\n217\t\tif mode == \"\" && opts.reference == \"\" {\n218\t\t\tfmt.Fprintln(os.Stderr, \"chmod: missing operand\")\n219\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n220\t\t\tos.Exit(1)\n221\t\t}\n222\t\treturn opts, mode, files\n223\t}\n224\t\n225\tfunc handleSpecialArg(arg string, endOfFlags *bool) bool {\n226\t\tswitch arg {\n227\t\tcase \"--help\":\n228\t\t\tfmt.Fprint(os.Stdout, helpText)\n229\t\t\tos.Exit(0)\n230\t\tcase \"--version\":\n231\t\t\tfmt.Fprint(os.Stdout, versionText)\n232\t\t\tos.Exit(0)\n233\t\tcase \"--\":\n234\t\t\t*endOfFlags = true\n235\t\tdefault:\n236\t\t\treturn false\n237\t\t}\n238\t\treturn true\n239\t}\n240\t\n241\tfunc parseLongFlag(arg string, opts *options) bool {\n242\t\tswitch arg {\n243\t\tcase \"--verbose\":\n244\t\t\topts.verbose = true\n245\t\tcase \"--changes\":\n246\t\t\topts.changes = true\n247\t\tcase \"--silent\", \"--quiet\":\n248\t\t\topts.silent = true\n249\t\tcase \"--recursive\":\n250\t\t\topts.recursive = true\n251\t\tcase \"--preserve-root\":\n252\t\t\topts.preserveRoot = true\n253\t\tcase \"--no-preserve-root\":\n254\t\t\topts.preserveRoot = false\n255\t\tdefault:\n256\t\t\tif strings.HasPrefix(arg, \"--reference=\") {\n257\t\t\t\topts.reference = arg[len(\"--reference=\"):]\n258\t\t\t\treturn true\n259\t\t\t}\n260\t\t\treturn false\n261\t\t}\n262\t\treturn true\n263\t}\n264\t\n265\tfunc parseShortFlags(flags string, opts *options) bool {\n266\t\tfor _, c := range flags {\n267\t\t\tswitch c {\n268\t\t\tcase 'v':\n269\t\t\t\topts.verbose = true\n270\t\t\tcase 'c':\n271\t\t\t\topts.changes = true\n272\t\t\tcase 'f':\n273\t\t\t\topts.silent = true\n274\t\t\tcase 'R':\n275\t\t\t\topts.recursive = true\n276\t\t\tdefault:\n277\t\t\t\treturn false\n278\t\t\t}\n279\t\t}\n280\t\treturn true\n281\t}\n282\t\n283\tfunc applyMode(mode string, path string) error {\n284\t\tif isOctalMode(mode) {\n285\t\t\treturn applyOctalMode(mode, path)\n286\t\t}\n287\t\treturn applySymbolicMode(mode, path)\n288\t}\n289\t\n290\tfunc isOctalMode(mode string) bool {\n291\t\ts := mode\n292\t\tif strings.HasPrefix(s, \"0\") && len(s) > 1 {\n293\t\t\ts = s[1:]\n294\t\t}\n295\t\tif len(s) == 0 {\n296\t\t\treturn false\n297\t\t}\n298\t\tfor _, c := range s {\n299\t\t\tif c < '0' || c > '7' {\n300\t\t\t\treturn false\n301\t\t\t}\n302\t\t}\n303\t\treturn true\n304\t}\n305\t\n306\tfunc applyOctalMode(mode string, path string) error {\n307\t\tval, err := strconv.ParseUint(mode, 8, 32)\n308\t\tif err != nil {\n309\t\t\treturn fmt.Errorf(\"invalid mode: %q\", mode)\n310\t\t}\n311\t\treturn os.Chmod(path, os.FileMode(val))\n312\t}\n313\t\n314\tfunc getUmask() os.FileMode {\n315\t\told := syscall.Umask(0)\n316\t\tsyscall.Umask(old)\n317\t\treturn os.FileMode(old)\n318\t}\n319\t\n320\tfunc applySymbolicMode(mode string, path string) error {\n321\t\tinfo, err := os.Stat(path)\n322\t\tif err != nil {\n323\t\t\treturn err\n324\t\t}\n325\t\tcurrent := info.Mode()\n326\t\tnewMode, err := evalSymbolic(mode, current, getUmask())\n327\t\tif err != nil {\n328\t\t\treturn err\n329\t\t}\n330\t\treturn os.Chmod(path, newMode)\n331\t}\n332\t\n333\tfunc resolveReference(rfile string) string {\n334\t\tinfo, err := os.Stat(rfile)\n335\t\tif err != nil {\n336\t\t\tfmt.Fprintf(os.Stderr, \"chmod: failed to get attributes of '%s': %s\\n\",\n337\t\t\t\trfile, err.(*os.PathError).Err)\n338\t\t\tos.Exit(1)\n339\t\t}\n340\t\tm := info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky))\n341\t\treturn fmt.Sprintf(\"%04o\", uint32(m))\n342\t}\n343\t\n344\tfunc isRootPath(path string) bool {\n345\t\tresolved, err := filepath.EvalSymlinks(path)\n346\t\tif err != nil {\n347\t\t\treturn path == \"/\"\n348\t\t}\n349\t\treturn resolved == \"/\"\n350\t}\n351\t\n352\tfunc formatErr(err error) string {\n353\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n354\t\t\treturn fmt.Sprintf(\"cannot access '%s': %s\", pe.Path, pe.Err)\n355\t\t}\n356\t\treturn err.Error()\n357\t}\n358\t"}]},"parent_tool_use_id":null,"session_id":"f1fb9aa0-d443-4fb0-adfd-577584f3890c","uuid":"c59906ad-0efa-49fe-87e2-83c59b2dc2ea","timestamp":"2026-05-23T17:18:03.369Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5550/cmd/chmod/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/chmod implements srd089-chmod R1.1-R1.4, R2.1-R2.4, R3.1-R3.2, R4.1-R4.3.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: chmod [OPTION]... MODE[,MODE]... FILE...\n  or:  chmod [OPTION]... OCTAL-MODE FILE...\n  or:  chmod [OPTION]... --reference=RFILE FILE...\nChange the mode of each FILE to MODE.\n\n  -c, --changes          like verbose but report only when a change is made\n  -f, --silent, --quiet  suppress most error messages\n  -v, --verbose          output a diagnostic for every file processed\n      --no-preserve-root  do not treat '/' specially (the default)\n      --preserve-root    fail to operate recursively on '/'\n      --reference=RFILE  use RFILE's mode instead of MODE values\n  -R, --recursive        change files and directories recursively\n      --help     display this help and exit\n      --version  output version information and exit\n\nEach MODE is of the form '[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+'.\n`\n\nconst versionText = `chmod (go-unix-utils) dev\n`\n\ntype options struct {\n\tverbose      bool\n\tchanges      bool\n\tsilent       bool\n\trecursive    bool\n\tpreserveRoot bool\n\treference    string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, mode, files := parseArgs(os.Args[1:])\n\tif opts.reference != \"\" {\n\t\tmode = resolveReference(opts.reference)\n\t}\n\tif len(files) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"chmod: missing operand after '%s'\\n\", mode)\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\n\texitCode := 0\n\tfor _, file := range files {\n\t\tif err := processFile(opts, mode, file); err != nil {\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc processFile(opts options, mode string, path string) error {\n\tif opts.recursive {\n\t\treturn processRecursive(opts, mode, path)\n\t}\n\treturn applyAndReport(opts, mode, path)\n}\n\nfunc processRecursive(opts options, mode string, root string) error {\n\tif opts.preserveRoot && isRootPath(root) {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"chmod: it is dangerous to operate recursively on '/'\\nchmod: use --no-preserve-root to override this failsafe\\n\")\n\t\treturn fmt.Errorf(\"refusing to operate on root\")\n\t}\n\tvar walkErr error\n\terr := filepath.WalkDir(root, func(path string, _ os.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treportError(opts, path, err)\n\t\t\twalkErr = err\n\t\t\treturn nil\n\t\t}\n\t\tif applyErr := applyAndReport(opts, mode, path); applyErr != nil {\n\t\t\twalkErr = applyErr\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn walkErr\n}\n\nfunc applyAndReport(opts options, mode string, path string) error {\n\toldMode, err := getMode(path)\n\tif err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tif err := applyMode(mode, path); err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tnewMode, err := getMode(path)\n\tif err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tprintDiagnostic(opts, path, oldMode, newMode)\n\treturn nil\n}\n\nfunc getMode(path string) (os.FileMode, error) {\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky)), nil\n}\n\nfunc reportError(opts options, _ string, err error) {\n\tif opts.silent {\n\t\treturn\n\t}\n\tfmt.Fprintf(os.Stderr, \"chmod: %s\\n\", formatErr(err))\n}\n\nfunc printDiagnostic(opts options, path string, oldMode, newMode os.FileMode) {\n\tif opts.verbose {\n\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n\t\treturn\n\t}\n\tif opts.changes && oldMode != newMode {\n\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n\t}\n}\n\nfunc symbolicString(mode os.FileMode) string {\n\tvar buf [9]byte\n\tconst rwx = \"rwx\"\n\tfor i := range 9 {\n\t\tif mode&(1<<uint(8-i)) != 0 {\n\t\t\tbuf[i] = rwx[i%3]\n\t\t} else {\n\t\t\tbuf[i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(&buf, mode)\n\treturn string(buf[:])\n}\n\nfunc applySpecialBits(buf *[9]byte, mode os.FileMode) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif buf[2] == 'x' {\n\t\t\tbuf[2] = 's'\n\t\t} else {\n\t\t\tbuf[2] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif buf[5] == 'x' {\n\t\t\tbuf[5] = 's'\n\t\t} else {\n\t\t\tbuf[5] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif buf[8] == 'x' {\n\t\t\tbuf[8] = 't'\n\t\t} else {\n\t\t\tbuf[8] = 'T'\n\t\t}\n\t}\n}\n\nfunc parseArgs(args []string) (options, string, []string) {\n\tvar opts options\n\tvar files []string\n\tmode := \"\"\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif handled := handleSpecialArg(arg, &endOfFlags); handled {\n\t\t\tcontinue\n\t\t}\n\t\tif parseLongFlag(arg, &opts) {\n\t\t\tcontinue\n\t\t}\n\t\tif mode == \"\" {\n\t\t\tif strings.HasPrefix(arg, \"-\") && parseShortFlags(arg[1:], &opts) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif opts.reference != \"\" {\n\t\t\t\tfiles = append(files, arg)\n\t\t\t} else {\n\t\t\t\tmode = arg\n\t\t\t}\n\t\t} else {\n\t\t\tfiles = append(files, arg)\n\t\t}\n\t}\n\tif mode == \"\" && opts.reference == \"\" {\n\t\tfmt.Fprintln(os.Stderr, \"chmod: missing operand\")\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\treturn opts, mode, files\n}\n\nfunc handleSpecialArg(arg string, endOfFlags *bool) bool {\n\tswitch arg {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase \"--\":\n\t\t*endOfFlags = true\n\tdefault:\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc parseLongFlag(arg string, opts *options) bool {\n\tswitch arg {\n\tcase \"--verbose\":\n\t\topts.verbose = true\n\tcase \"--changes\":\n\t\topts.changes = true\n\tcase \"--silent\", \"--quiet\":\n\t\topts.silent = true\n\tcase \"--recursive\":\n\t\topts.recursive = true\n\tcase \"--preserve-root\":\n\t\topts.preserveRoot = true\n\tcase \"--no-preserve-root\":\n\t\topts.preserveRoot = false\n\tdefault:\n\t\tif strings.HasPrefix(arg, \"--reference=\") {\n\t\t\topts.reference = arg[len(\"--reference=\"):]\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc parseShortFlags(flags string, opts *options) bool {\n\tfor _, c := range flags {\n\t\tswitch c {\n\t\tcase 'v':\n\t\t\topts.verbose = true\n\t\tcase 'c':\n\t\t\topts.changes = true\n\t\tcase 'f':\n\t\t\topts.silent = true\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tdefault:\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc applyMode(mode string, path string) error {\n\tif isOctalMode(mode) {\n\t\treturn applyOctalMode(mode, path)\n\t}\n\treturn applySymbolicMode(mode, path)\n}\n\nfunc isOctalMode(mode string) bool {\n\ts := mode\n\tif strings.HasPrefix(s, \"0\") && len(s) > 1 {\n\t\ts = s[1:]\n\t}\n\tif len(s) == 0 {\n\t\treturn false\n\t}\n\tfor _, c := range s {\n\t\tif c < '0' || c > '7' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc applyOctalMode(mode string, path string) error {\n\tval, err := strconv.ParseUint(mode, 8, 32)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid mode: %q\", mode)\n\t}\n\treturn os.Chmod(path, os.FileMode(val))\n}\n\nfunc getUmask() os.FileMode {\n\told := syscall.Umask(0)\n\tsyscall.Umask(old)\n\treturn os.FileMode(old)\n}\n\nfunc applySymbolicMode(mode string, path string) error {\n\tinfo, err := os.Stat(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tcurrent := info.Mode()\n\tnewMode, err := evalSymbolic(mode, current, getUmask())\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.Chmod(path, newMode)\n}\n\nfunc resolveReference(rfile string) string {\n\tinfo, err := os.Stat(rfile)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"chmod: failed to get attributes of '%s': %s\\n\",\n\t\t\trfile, err.(*os.PathError).Err)\n\t\tos.Exit(1)\n\t}\n\tm := info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky))\n\treturn fmt.Sprintf(\"%04o\", uint32(m))\n}\n\nfunc isRootPath(path string) bool {\n\tresolved, err := filepath.EvalSymlinks(path)\n\tif err != nil {\n\t\treturn path == \"/\"\n\t}\n\treturn resolved == \"/\"\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"cannot access '%s': %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n","numLines":358,"startLine":1,"totalLines":358}}}
