rn table\n76\t}\n77\t\n78\tfunc translate(table [256]byte) error {\n79\t\tr := bufio.NewReader(os.Stdin)\n80\t\tw := bufio.NewWriter(os.Stdout)\n81\t\tbuf := make([]byte, 32*1024)\n82\t\tfor {\n83\t\t\tn, err := r.Read(buf)\n84\t\t\tfor i := range n {\n85\t\t\t\tbuf[i] = table[buf[i]]\n86\t\t\t}\n87\t\t\tif _, werr := w.Write(buf[:n]); werr != nil {\n88\t\t\t\treturn werr\n89\t\t\t}\n90\t\t\tif err != nil {\n91\t\t\t\tif err != io.EOF {\n92\t\t\t\t\treturn err\n93\t\t\t\t}\n94\t\t\t\tbreak\n95\t\t\t}\n96\t\t}\n97\t\treturn w.Flush()\n98\t}\n99\t\n100\tfunc expandSet(spec string) ([]byte, error) {\n101\t\tvar result []byte\n102\t\ti := 0\n103\t\tfor i < len(spec) {\n104\t\t\tif spec[i] == '[' {\n105\t\t\t\tn, bytes, err := tryBracketExpr(spec, i)\n106\t\t\t\tif err != nil {\n107\t\t\t\t\treturn nil, err\n108\t\t\t\t}\n109\t\t\t\tif n > 0 {\n110\t\t\t\t\tresult = append(result, bytes...)\n111\t\t\t\t\ti += n\n112\t\t\t\t\tcontinue\n113\t\t\t\t}\n114\t\t\t}\n115\t\t\tch, n := nextByte(spec, i)\n116\t\t\trn, rangeBytes, err := tryRange(spec, i, ch, n)\n117\t\t\tif err != nil {\n118\t\t\t\treturn nil, err\n119\t\t\t}\n120\t\t\tif rn > 0 {\n121\t\t\t\tresult = append(result, rangeBytes...)\n122\t\t\t\ti += rn\n123\t\t\t\tcontinue\n124\t\t\t}\n125\t\t\tresult = append(result, ch)\n126\t\t\ti += n\n127\t\t}\n128\t\treturn result, nil\n129\t}\n130\t\n131\tfunc tryRange(spec string, i int, lo byte, loN int) (int, []byte, error) {\n132\t\tdashPos := i + loN\n133\t\tif dashPos >= len(spec) || spec[dashPos] != '-' {\n134\t\t\treturn 0, nil, nil\n135\t\t}\n136\t\tif dashPos+1 >= len(spec) {\n137\t\t\treturn 0, nil, nil\n138\t\t}\n139\t\thi, hiN := nextByte(spec, dashPos+1)\n140\t\tif lo > hi {\n141\t\t\treturn 0, nil, fmt.Errorf(\n142\t\t\t\t\"range-endpoints of '%c-%c' are in reverse collating sequence order\",\n143\t\t\t\trune(lo), rune(hi))\n144\t\t}\n145\t\treturn loN + 1 + hiN, byteRange(lo, hi), nil\n146\t}\n147\t\n148\tfunc tryBracketExpr(spec string, i int) (int, []byte, 