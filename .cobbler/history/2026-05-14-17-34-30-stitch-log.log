{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MmnLr9E7v5MKVpXqQv7tHp","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd008-ls R1.1-R1.14, R2.1-R2.2.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\t\"unicode/utf8\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n21\t)\n22\t\n23\tconst helpText = `Usage: ls [OPTION]... [FILE]...\n24\tList information about the FILEs (the current directory by default).\n25\tSort entries alphabetically if no flags given.\n26\t\n27\t  -a             do not ignore entries starting with .\n28\t  -A             do not list implied . and ..\n29\t  -C             list entries by columns\n30\t  -x             list entries by lines instead of by columns\n31\t  -1             list one file per line\n32\t  -l             use a long listing format\n33\t      --help     display this help and exit\n34\t      --version  output version information and exit\n35\t`\n36\t\n37\tconst versionText = `ls (go-unix-utils) dev\n38\t`\n39\t\n40\ttype options struct {\n41\t\tsingleColumn   bool\n42\t\tlongFormat     bool\n43\t\tforceColumns   bool\n44\t\thorizontalSort bool\n45\t\tshowAll        bool\n46\t\tshowAlmostAll  bool\n47\t}\n48\t\n49\tfunc main() {\n50\t\tsys.InstallSIGPIPEHandler()\n51\t\topts, paths := parseArgs(os.Args[1:])\n52\t\tif len(paths) == 0 {\n53\t\t\tpaths = []string{\".\"}\n54\t\t}\n55\t\tos.Exit(run(paths, opts))\n56\t}\n57\t\n58\tfunc parseArgs(args []string) (options, []string) {\n59\t\tvar opts options\n60\t\tvar paths []string\n61\t\tfor len(args) > 0 {\n62\t\t\targ := args[0]\n63\t\t\targs = args[1:]\n64\t\t\tswitch {\n65\t\t\tcase arg == \"--help\":\n66\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n67\t\t\t\tos.Exit(0)\n68\t\t\tcase arg == \"--version\":\n69\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n70\t\t\t\tos.Exit(0)\n71\t\t\tcase arg == \"--\":\n72\t\t\t\treturn opts, append(paths, args...)\n73\t\t\tcase strings.HasPrefix(arg, \"--\"):\n74\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n75\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n76\t\t\t\tos.Exit(2)\n77\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n78\t\t\t\tparseShortFlags(arg[1:], &opts)\n79\t\t\tdefault:\n80\t\t\t\tpaths = append(paths, arg)\n81\t\t\t}\n82\t\t}\n83\t\treturn opts, paths\n84\t}\n85\t\n86\tfunc parseShortFlags(flags string, opts *options) {\n87\t\tfor _, ch := range flags {\n88\t\t\tswitch ch {\n89\t\t\tcase '1':\n90\t\t\t\topts.forceColumns = false\n91\t\t\t\topts.horizontalSort = false\n92\t\t\t\tif !opts.longFormat {\n93\t\t\t\t\topts.singleColumn = true\n94\t\t\t\t}\n95\t\t\tcase 'l':\n96\t\t\t\topts.longFormat = true\n97\t\t\t\topts.singleColumn = false\n98\t\t\t\topts.forceColumns = false\n99\t\t\t\topts.horizontalSort = false\n100\t\t\tcase 'C':\n101\t\t\t\topts.forceColumns = true\n102\t\t\t\topts.horizontalSort = false\n103\t\t\t\topts.longFormat = false\n104\t\t\t\topts.singleColumn = false\n105\t\t\tcase 'x':\n106\t\t\t\topts.forceColumns = true\n107\t\t\t\topts.horizontalSort = true\n108\t\t\t\topts.longFormat = false\n109\t\t\t\topts.singleColumn = false\n110\t\t\tcase 'a':\n111\t\t\t\topts.showAll = true\n112\t\t\t\topts.showAlmostAll = false\n113\t\t\tcase 'A':\n114\t\t\t\topts.showAlmostAll = true\n115\t\t\t\topts.showAll = false\n116\t\t\tdefault:\n117\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n118\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n119\t\t\t\tos.Exit(2)\n120\t\t\t}\n121\t\t}\n122\t}\n123\t\n124\tfunc run(paths []string, opts options) int {\n125\t\texitCode := 0\n126\t\tfiles, dirs := classifyPaths(paths, &exitCode)\n127\t\tneedSep := false\n128\t\tif len(files) > 0 {\n129\t\t\tsort.Strings(files)\n130\t\t\tif opts.longFormat {\n131\t\t\t\texitCode = maxCode(exitCode, writeLongFiles(files))\n132\t\t\t} else {\n133\t\t\t\twriteEntries(files, opts)\n134\t\t\t}\n135\t\t\tneedSep = true\n136\t\t}\n137\t\tshowHeader := len(dirs) > 1 || len(files) > 0\n138\t\tfor _, dir := range dirs {\n139\t\t\tif needSep {\n140\t\t\t\tfmt.Fprintln(os.Stdout)\n141\t\t\t}\n142\t\t\tif showHeader {\n143\t\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n144\t\t\t}\n145\t\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n146\t\t\tneedSep = true\n147\t\t}\n148\t\treturn exitCode\n149\t}\n150\t\n151\tfunc classifyPaths(paths []string, exitCode *int) ([]string, []string) {\n152\t\tvar files, dirs []string\n153\t\tfor _, p := range paths {\n154\t\t\tinfo, err := os.Lstat(p)\n155\t\t\tif err != nil {\n156\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n157\t\t\t\t*exitCode = 2\n158\t\t\t\tcontinue\n159\t\t\t}\n160\t\t\tif info.IsDir() {\n161\t\t\t\tdirs = append(dirs, p)\n162\t\t\t} else {\n163\t\t\t\tfiles = append(files, p)\n164\t\t\t}\n165\t\t}\n166\t\treturn files, dirs\n167\t}\n168\t\n169\tfunc maxCode(a, b int) int {\n170\t\tif a > b {\n171\t\t\treturn a\n172\t\t}\n173\t\treturn b\n174\t}\n175\t\n176\tfunc listDir(path string, opts options) int {\n177\t\tnames, err := readNames(path, opts)\n178\t\tif err != nil {\n179\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n180\t\t\t\tpath, sysError(err))\n181\t\t\treturn 2\n182\t\t}\n183\t\tif opts.longFormat {\n184\t\t\treturn writeLongDir(path, names)\n185\t\t}\n186\t\twriteEntries(names, opts)\n187\t\treturn 0\n188\t}\n189\t\n190\tfunc readNames(path string, opts options) ([]string, error) {\n191\t\tentries, err := os.ReadDir(path)\n192\t\tif err != nil {\n193\t\t\treturn nil, err\n194\t\t}\n195\t\tnames := make([]string, 0, len(entries))\n196\t\tif opts.showAll {\n197\t\t\tnames = append(names, \".\", \"..\")\n198\t\t}\n199\t\tfor _, e := range entries {\n200\t\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n201\t\t\t\tcontinue\n202\t\t\t}\n203\t\t\tnames = append(names, e.Name())\n204\t\t}\n205\t\tsort.Strings(names)\n206\t\treturn names, nil\n207\t}\n208\t\n209\tfunc writeEntries(names []string, opts options) {\n210\t\tif len(names) == 0 {\n211\t\t\treturn\n212\t\t}\n213\t\tif opts.forceColumns {\n214\t\t\tif opts.horizontalSort {\n215\t\t\t\twriteHorizontalColumns(names, 0)\n216\t\t\t} else {\n217\t\t\t\twriteColumnsWidth(names, 0)\n218\t\t\t}\n219\t\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n220\t\t\twriteLines(names)\n221\t\t} else {\n222\t\t\twriteColumnsWidth(names, 0)\n223\t\t}\n224\t}\n225\t\n226\tfunc writeColumnsWidth(names []string, width int) {\n227\t\tif width <= 0 {\n228\t\t\tw, err := sys.TerminalWidth()\n229\t\t\tif err != nil {\n230\t\t\t\tw = 80\n231\t\t\t}\n232\t\t\twidth = w\n233\t\t}\n234\t\tgrid := format.Columns(names, width)\n235\t\twidths := gridColumnWidths(grid)\n236\t\tfor _, row := range grid {\n237\t\t\twriteGridRow(row, widths)\n238\t\t}\n239\t}\n240\t\n241\tfunc writeHorizontalColumns(names []string, width int) {\n242\t\tif width <= 0 {\n243\t\t\tw, err := sys.TerminalWidth()\n244\t\t\tif err != nil {\n245\t\t\t\tw = 80\n246\t\t\t}\n247\t\t\twidth = w\n248\t\t}\n249\t\tnumCols := findHorizontalMaxCols(names, width)\n250\t\trows := (len(names) + numCols - 1) / numCols\n251\t\tcolWidths := make([]int, numCols)\n252\t\tfor c := 0; c < numCols; c++ {\n253\t\t\tfor r := 0; r < rows; r++ {\n254\t\t\t\tidx := r*numCols + c\n255\t\t\t\tif idx >= len(names) {\n256\t\t\t\t\tbreak\n257\t\t\t\t}\n258\t\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n259\t\t\t\t\tcolWidths[c] = w\n260\t\t\t\t}\n261\t\t\t}\n262\t\t}\n263\t\tfor r := 0; r < rows; r++ {\n264\t\t\tvar row []string\n265\t\t\tfor c := 0; c < numCols; c++ {\n266\t\t\t\tidx := r*numCols + c\n267\t\t\t\tif idx >= len(names) {\n268\t\t\t\t\tbreak\n269\t\t\t\t}\n270\t\t\t\trow = append(row, names[idx])\n271\t\t\t}\n272\t\t\twriteGridRow(row, colWidths)\n273\t\t}\n274\t}\n275\t\n276\tfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n277\t\tn := len(entries)\n278\t\tfor cols := n; cols > 1; cols-- {\n279\t\t\tif horizontalGridFits(entries, cols, termWidth) {\n280\t\t\t\treturn cols\n281\t\t\t}\n282\t\t}\n283\t\treturn 1\n284\t}\n285\t\n286\tfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n287\t\trows := (len(entries) + cols - 1) / cols\n288\t\tcolWidths := make([]int, cols)\n289\t\tfor c := 0; c < cols; c++ {\n290\t\t\tfor r := 0; r < rows; r++ {\n291\t\t\t\tidx := r*cols + c\n292\t\t\t\tif idx >= len(entries) {\n293\t\t\t\t\tbreak\n294\t\t\t\t}\n295\t\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n296\t\t\t\t\tcolWidths[c] = w\n297\t\t\t\t}\n298\t\t\t}\n299\t\t}\n300\t\ttotal := 0\n301\t\tfor c := 0; c < cols; c++ {\n302\t\t\tif c < cols-1 {\n303\t\t\t\ttotal += colWidths[c] + 2\n304\t\t\t} else {\n305\t\t\t\ttotal += colWidths[c]\n306\t\t\t}\n307\t\t\tif total > termWidth {\n308\t\t\t\treturn false\n309\t\t\t}\n310\t\t}\n311\t\treturn true\n312\t}\n313\t\n314\tfunc writeLines(names []string) {\n315\t\tfor _, name := range names {\n316\t\t\twriteLine(name)\n317\t\t}\n318\t}\n319\t\n320\tfunc gridColumnWidths(grid [][]string) []int {\n321\t\tif len(grid) == 0 {\n322\t\t\treturn nil\n323\t\t}\n324\t\twidths := make([]int, len(grid[0]))\n325\t\tfor _, row := range grid {\n326\t\t\tfor c, cell := range row {\n327\t\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n328\t\t\t\t\twidths[c] = w\n329\t\t\t\t}\n330\t\t\t}\n331\t\t}\n332\t\treturn widths\n333\t}\n334\t\n335\tfunc writeGridRow(row []string, widths []int) {\n336\t\tvar b strings.Builder\n337\t\tfor i, cell := range row {\n338\t\t\tif i < len(row)-1 {\n339\t\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n340\t\t\t\tb.WriteString(\"  \")\n341\t\t\t} else {\n342\t\t\t\tb.WriteString(cell)\n343\t\t\t}\n344\t\t}\n345\t\twriteLine(b.String())\n346\t}\n347\t\n348\ttype longEntry struct {\n349\t\tname  string\n350\t\tpath  string\n351\t\tinfo  *sys.FileInfo\n352\t\towner string\n353\t\tgroup string\n354\t}\n355\t\n356\ttype longWidths struct {\n357\t\tnlink int\n358\t\towner int\n359\t\tgroup int\n360\t\tsize  int\n361\t}\n362\t\n363\tfunc writeLongFiles(paths []string) int {\n364\t\tentries := make([]longEntry, 0, len(paths))\n365\t\tcode := 0\n366\t\tfor _, p := range paths {\n367\t\t\tfi, err := sys.Lstat(p)\n368\t\t\tif err != nil {\n369\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n370\t\t\t\tcode = 2\n371\t\t\t\tcontinue\n372\t\t\t}\n373\t\t\tentries = append(entries, newLongEntry(p, p, fi))\n374\t\t}\n375\t\twriteLongEntries(entries)\n376\t\treturn code\n377\t}\n378\t\n379\tfunc writeLongDir(path string, names []string) int {\n380\t\tentries := make([]longEntry, 0, len(names))\n381\t\tcode := 0\n382\t\tfor _, name := range names {\n383\t\t\tfull := filepath.Join(path, name)\n384\t\t\tfi, err := sys.Lstat(full)\n385\t\t\tif err != nil {\n386\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n387\t\t\t\tcode = 2\n388\t\t\t\tcontinue\n389\t\t\t}\n390\t\t\tentries = append(entries, newLongEntry(name, full, fi))\n391\t\t}\n392\t\ttotalBlocks := int64(0)\n393\t\tfor _, e := range entries {\n394\t\t\ttotalBlocks += e.info.Blocks\n395\t\t}\n396\t\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n397\t\twriteLongEntries(entries)\n398\t\treturn code\n399\t}\n400\t\n401\tfunc newLongEntry(name string, path string, fi *sys.FileInfo) longEntry {\n402\t\treturn longEntry{\n403\t\t\tname:  name,\n404\t\t\tpath:  path,\n405\t\t\tinfo:  fi,\n406\t\t\towner: resolveOwner(fi.Uid),\n407\t\t\tgroup: resolveGroup(fi.Gid),\n408\t\t}\n409\t}\n410\t\n411\tfunc writeLongEntries(entries []longEntry) {\n412\t\tif len(entries) == 0 {\n413\t\t\treturn\n414\t\t}\n415\t\tw := computeLongWidths(entries)\n416\t\tfor _, e := range entries {\n417\t\t\twriteLine(formatLongLine(e, w))\n418\t\t}\n419\t}\n420\t\n421\tfunc computeLongWidths(entries []longEntry) longWidths {\n422\t\tvar w longWidths\n423\t\tfor _, e := range entries {\n424\t\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n425\t\t\t\tw.nlink = n\n426\t\t\t}\n427\t\t\tif n := len(e.owner); n > w.owner {\n428\t\t\t\tw.owner = n\n429\t\t\t}\n430\t\t\tif n := len(e.group); n > w.group {\n431\t\t\t\tw.group = n\n432\t\t\t}\n433\t\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n434\t\t\t\tw.size = n\n435\t\t\t}\n436\t\t}\n437\t\treturn w\n438\t}\n439\t\n440\tfunc formatLongLine(e longEntry, w longWidths) string {\n441\t\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n442\t\tsize := strconv.FormatInt(e.info.Size, 10)\n443\t\tname := e.name\n444\t\tif e.info.Mode&os.ModeSymlink != 0 {\n445\t\t\tif target, err := os.Readlink(e.path); err == nil {\n446\t\t\t\tname += \" -> \" + target\n447\t\t\t}\n448\t\t}\n449\t\treturn permString(e.info.Mode) + \" \" +\n450\t\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n451\t\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n452\t\t\tformat.PadRight(e.group, w.group) + \" \" +\n453\t\t\tformat.PadLeft(size, w.size) + \" \" +\n454\t\t\tformatMtime(e.info.ModTime) + \" \" +\n455\t\t\tname\n456\t}\n457\t\n458\tfunc permString(mode os.FileMode) string {\n459\t\tvar b [10]byte\n460\t\tb[0] = fileTypeChar(mode)\n461\t\tconst rwx = \"rwx\"\n462\t\tperm := mode.Perm()\n463\t\tfor i := 0; i < 9; i++ {\n464\t\t\tif perm&(1<<uint(8-i)) != 0 {\n465\t\t\t\tb[1+i] = rwx[i%3]\n466\t\t\t} else {\n467\t\t\t\tb[1+i] = '-'\n468\t\t\t}\n469\t\t}\n470\t\tapplySpecialBits(mode, &b)\n471\t\treturn string(b[:])\n472\t}\n473\t\n474\tfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n475\t\tif mode&os.ModeSetuid != 0 {\n476\t\t\tif b[3] == 'x' {\n477\t\t\t\tb[3] = 's'\n478\t\t\t} else {\n479\t\t\t\tb[3] = 'S'\n480\t\t\t}\n481\t\t}\n482\t\tif mode&os.ModeSetgid != 0 {\n483\t\t\tif b[6] == 'x' {\n484\t\t\t\tb[6] = 's'\n485\t\t\t} else {\n486\t\t\t\tb[6] = 'S'\n487\t\t\t}\n488\t\t}\n489\t\tif mode&os.ModeSticky != 0 {\n490\t\t\tif b[9] == 'x' {\n491\t\t\t\tb[9] = 't'\n492\t\t\t} else {\n493\t\t\t\tb[9] = 'T'\n494\t\t\t}\n495\t\t}\n496\t}\n497\t\n498\tfunc fileTypeChar(mode os.FileMode) byte {\n499\t\tswitch {\n500\t\tcase mode&os.ModeDir != 0:\n501\t\t\treturn 'd'\n502\t\tcase mode&os.ModeSymlink != 0:\n503\t\t\treturn 'l'\n504\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n505\t\t\treturn 'c'\n506\t\tcase mode&os.ModeDevice != 0:\n507\t\t\treturn 'b'\n508\t\tcase mode&os.ModeNamedPipe != 0:\n509\t\t\treturn 'p'\n510\t\tcase mode&os.ModeSocket != 0:\n511\t\t\treturn 's'\n512\t\tdefault:\n513\t\t\treturn '-'\n514\t\t}\n515\t}\n516\t\n517\tfunc resolveOwner(uid uint32) string {\n518\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n519\t\tif err != nil {\n520\t\t\treturn strconv.FormatUint(uint64(uid), 10)\n521\t\t}\n522\t\treturn u.Username\n523\t}\n524\t\n525\tfunc resolveGroup(gid uint32) string {\n526\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n527\t\tif err != nil {\n528\t\t\treturn strconv.FormatUint(uint64(gid), 10)\n529\t\t}\n530\t\treturn g.Name\n531\t}\n532\t\n533\tfunc formatMtime(t time.Time) string {\n534\t\tsixMonths := 6 * 30 * 24 * time.Hour\n535\t\tago := time.Since(t)\n536\t\tif ago >= 0 && ago < sixMonths {\n537\t\t\treturn t.Format(\"Jan _2 15:04\")\n538\t\t}\n539\t\treturn t.Format(\"Jan _2  2006\")\n540\t}\n541\t\n542\tfunc writeLine(s string) {\n543\t\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n544\t\t\tos.Exit(1)\n545\t\t}\n546\t}\n547\t\n548\tfunc sysError(err error) string {\n549\t\tvar pathErr *os.PathError\n550\t\tif errors.As(err, &pathErr) {\n551\t\t\treturn pathErr.Err.Error()\n552\t\t}\n553\t\treturn err.Error()\n554\t}\n555\t"}]},"parent_tool_use_id":null,"session_id":"98b2423d-f7e4-4d63-a55b-b140133c07a5","uuid":"bdd5ac3c-35f8-49e1-940a-a0f5256a3bf4","timestamp":"2026-05-14T21:38:30.451Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5209/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd008-ls R1.1-R1.14, R2.1-R2.2.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n  -a             do not ignore entries starting with .\n  -A             do not list implied . and ..\n  -C             list entries by columns\n  -x             list entries by lines instead of by columns\n  -1             list one file per line\n  -l             use a long listing format\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn   bool\n\tlongFormat     bool\n\tforceColumns   bool\n\thorizontalSort bool\n\tshowAll        bool\n\tshowAlmostAll  bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'C':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = false\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'x':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = true\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'a':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\tcase 'A':\n\t\t\topts.showAlmostAll = true\n\t\t\topts.showAll = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\texitCode := 0\n\tfiles, dirs := classifyPaths(paths, &exitCode)\n\tneedSep := false\n\tif len(files) > 0 {\n\t\tsort.Strings(files)\n\t\tif opts.longFormat {\n\t\t\texitCode = maxCode(exitCode, writeLongFiles(files))\n\t\t} else {\n\t\t\twriteEntries(files, opts)\n\t\t}\n\t\tneedSep = true\n\t}\n\tshowHeader := len(dirs) > 1 || len(files) > 0\n\tfor _, dir := range dirs {\n\t\tif needSep {\n\t\t\tfmt.Fprintln(os.Stdout)\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n\t\t}\n\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n\t\tneedSep = true\n\t}\n\treturn exitCode\n}\n\nfunc classifyPaths(paths []string, exitCode *int) ([]string, []string) {\n\tvar files, dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\t*exitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\treturn files, dirs\n}\n\nfunc maxCode(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc listDir(path string, opts options) int {\n\tnames, err := readNames(path, opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n\t\t\tpath, sysError(err))\n\t\treturn 2\n\t}\n\tif opts.longFormat {\n\t\treturn writeLongDir(path, names)\n\t}\n\twriteEntries(names, opts)\n\treturn 0\n}\n\nfunc readNames(path string, opts options) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tif opts.showAll {\n\t\tnames = append(names, \".\", \"..\")\n\t}\n\tfor _, e := range entries {\n\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name())\n\t}\n\tsort.Strings(names)\n\treturn names, nil\n}\n\nfunc writeEntries(names []string, opts options) {\n\tif len(names) == 0 {\n\t\treturn\n\t}\n\tif opts.forceColumns {\n\t\tif opts.horizontalSort {\n\t\t\twriteHorizontalColumns(names, 0)\n\t\t} else {\n\t\t\twriteColumnsWidth(names, 0)\n\t\t}\n\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n\t\twriteLines(names)\n\t} else {\n\t\twriteColumnsWidth(names, 0)\n\t}\n}\n\nfunc writeColumnsWidth(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tgrid := format.Columns(names, width)\n\twidths := gridColumnWidths(grid)\n\tfor _, row := range grid {\n\t\twriteGridRow(row, widths)\n\t}\n}\n\nfunc writeHorizontalColumns(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tnumCols := findHorizontalMaxCols(names, width)\n\trows := (len(names) + numCols - 1) / numCols\n\tcolWidths := make([]int, numCols)\n\tfor c := 0; c < numCols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\tfor r := 0; r < rows; r++ {\n\t\tvar row []string\n\t\tfor c := 0; c < numCols; c++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\trow = append(row, names[idx])\n\t\t}\n\t\twriteGridRow(row, colWidths)\n\t}\n}\n\nfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n\tn := len(entries)\n\tfor cols := n; cols > 1; cols-- {\n\t\tif horizontalGridFits(entries, cols, termWidth) {\n\t\t\treturn cols\n\t\t}\n\t}\n\treturn 1\n}\n\nfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n\trows := (len(entries) + cols - 1) / cols\n\tcolWidths := make([]int, cols)\n\tfor c := 0; c < cols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*cols + c\n\t\t\tif idx >= len(entries) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\ttotal := 0\n\tfor c := 0; c < cols; c++ {\n\t\tif c < cols-1 {\n\t\t\ttotal += colWidths[c] + 2\n\t\t} else {\n\t\t\ttotal += colWidths[c]\n\t\t}\n\t\tif total > termWidth {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc writeLines(names []string) {\n\tfor _, name := range names {\n\t\twriteLine(name)\n\t}\n}\n\nfunc gridColumnWidths(grid [][]string) []int {\n\tif len(grid) == 0 {\n\t\treturn nil\n\t}\n\twidths := make([]int, len(grid[0]))\n\tfor _, row := range grid {\n\t\tfor c, cell := range row {\n\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n\t\t\t\twidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\treturn widths\n}\n\nfunc writeGridRow(row []string, widths []int) {\n\tvar b strings.Builder\n\tfor i, cell := range row {\n\t\tif i < len(row)-1 {\n\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n\t\t\tb.WriteString(\"  \")\n\t\t} else {\n\t\t\tb.WriteString(cell)\n\t\t}\n\t}\n\twriteLine(b.String())\n}\n\ntype longEntry struct {\n\tname  string\n\tpath  string\n\tinfo  *sys.FileInfo\n\towner string\n\tgroup string\n}\n\ntype longWidths struct {\n\tnlink int\n\towner int\n\tgroup int\n\tsize  int\n}\n\nfunc writeLongFiles(paths []string) int {\n\tentries := make([]longEntry, 0, len(paths))\n\tcode := 0\n\tfor _, p := range paths {\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(p, p, fi))\n\t}\n\twriteLongEntries(entries)\n\treturn code\n}\n\nfunc writeLongDir(path string, names []string) int {\n\tentries := make([]longEntry, 0, len(names))\n\tcode := 0\n\tfor _, name := range names {\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(full)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(name, full, fi))\n\t}\n\ttotalBlocks := int64(0)\n\tfor _, e := range entries {\n\t\ttotalBlocks += e.info.Blocks\n\t}\n\twriteLine(fmt.Sprintf(\"total %d\", totalBlocks/2))\n\twriteLongEntries(entries)\n\treturn code\n}\n\nfunc newLongEntry(name string, path string, fi *sys.FileInfo) longEntry {\n\treturn longEntry{\n\t\tname:  name,\n\t\tpath:  path,\n\t\tinfo:  fi,\n\t\towner: resolveOwner(fi.Uid),\n\t\tgroup: resolveGroup(fi.Gid),\n\t}\n}\n\nfunc writeLongEntries(entries []longEntry) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tw := computeLongWidths(entries)\n\tfor _, e := range entries {\n\t\twriteLine(formatLongLine(e, w))\n\t}\n}\n\nfunc computeLongWidths(entries []longEntry) longWidths {\n\tvar w longWidths\n\tfor _, e := range entries {\n\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n\t\t\tw.nlink = n\n\t\t}\n\t\tif n := len(e.owner); n > w.owner {\n\t\t\tw.owner = n\n\t\t}\n\t\tif n := len(e.group); n > w.group {\n\t\t\tw.group = n\n\t\t}\n\t\tif n := len(strconv.FormatInt(e.info.Size, 10)); n > w.size {\n\t\t\tw.size = n\n\t\t}\n\t}\n\treturn w\n}\n\nfunc formatLongLine(e longEntry, w longWidths) string {\n\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n\tsize := strconv.FormatInt(e.info.Size, 10)\n\tname := e.name\n\tif e.info.Mode&os.ModeSymlink != 0 {\n\t\tif target, err := os.Readlink(e.path); err == nil {\n\t\t\tname += \" -> \" + target\n\t\t}\n\t}\n\treturn permString(e.info.Mode) + \" \" +\n\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n\t\tformat.PadRight(e.group, w.group) + \" \" +\n\t\tformat.PadLeft(size, w.size) + \" \" +\n\t\tformatMtime(e.info.ModTime) + \" \" +\n\t\tname\n}\n\nfunc permString(mode os.FileMode) string {\n\tvar b [10]byte\n\tb[0] = fileTypeChar(mode)\n\tconst rwx = \"rwx\"\n\tperm := mode.Perm()\n\tfor i := 0; i < 9; i++ {\n\t\tif perm&(1<<uint(8-i)) != 0 {\n\t\t\tb[1+i] = rwx[i%3]\n\t\t} else {\n\t\t\tb[1+i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(mode, &b)\n\treturn string(b[:])\n}\n\nfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif b[3] == 'x' {\n\t\t\tb[3] = 's'\n\t\t} else {\n\t\t\tb[3] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif b[6] == 'x' {\n\t\t\tb[6] = 's'\n\t\t} else {\n\t\t\tb[6] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif b[9] == 'x' {\n\t\t\tb[9] = 't'\n\t\t} else {\n\t\t\tb[9] = 'T'\n\t\t}\n\t}\n}\n\nfunc fileTypeChar(mode os.FileMode) byte {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn 'l'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\treturn 'b'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\treturn 's'\n\tdefault:\n\t\treturn '-'\n\t}\n}\n\nfunc resolveOwner(uid uint32) string {\n\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(uid), 10)\n\t}\n\treturn u.Username\n}\n\nfunc resolveGroup(gid uint32) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(gid), 10)\n\t}\n\treturn g.Name\n}\n\nfunc formatMtime(t time.Time) string {\n\tsixMonths := 6 * 30 * 24 * time.Hour\n\tago := time.Since(t)\n\tif ago >= 0 && ago < sixMonths {\n\t\treturn t.Format(\"Jan _2 15:04\")\n\t}\n\treturn t.Format(\"Jan _2  2006\")\n}\n\nfunc writeLine(s string) {\n\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc sysError(err error) string {\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\treturn pathErr.Err.Error()\n\t}\n\treturn err.Error()\n}\n","numLines":555,"startLine":1,"totalLines":555}}}
