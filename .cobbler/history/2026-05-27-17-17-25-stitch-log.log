{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012AZ9jdXbDsbBwnK4RXqKf6","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd106-df R1.1-R1.5, R2.1-R2.3, R3.1-R3.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"math\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"syscall\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t\t\"golang.org/x/sys/unix\"\n18\t)\n19\t\n20\ttype sizeMode int\n21\t\n22\tconst (\n23\t\tmodeDefault sizeMode = iota\n24\t\tmodeHuman\n25\t\tmodeSI\n26\t)\n27\t\n28\ttype options struct {\n29\t\tsizeMode   sizeMode\n30\t\tshowType   bool\n31\t\tshowInodes bool\n32\t\tshowAll    bool\n33\t\tlocalOnly  bool\n34\t}\n35\t\n36\ttype fsEntry struct {\n37\t\tfilesystem      string\n38\t\tfsType          string\n39\t\tblocks1K        int64\n40\t\tused            int64\n41\t\tavailable       int64\n42\t\tsizeBytes       int64\n43\t\tusedBytes       int64\n44\t\tavailBytes      int64\n45\t\tusePercent      string\n46\t\tinodes          int64\n47\t\tinodesUsed      int64\n48\t\tinodesFree      int64\n49\t\tinodeUsePercent string\n50\t\tmountedOn       string\n51\t}\n52\t\n53\tvar humanSuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n54\t\n55\tfunc main() {\n56\t\tsys.InstallSIGPIPEHandler()\n57\t\tos.Exit(run(os.Args[1:]))\n58\t}\n59\t\n60\tfunc run(args []string) int {\n61\t\topts, files := parseArgs(args)\n62\t\tif len(files) == 0 {\n63\t\t\treturn listAll(opts)\n64\t\t}\n65\t\treturn listPaths(files, opts)\n66\t}\n67\t\n68\tfunc parseArgs(args []string) (options, []string) {\n69\t\tvar opts options\n70\t\tvar files []string\n71\t\tendOfFlags := false\n72\t\tfor _, arg := range args {\n73\t\t\tif endOfFlags {\n74\t\t\t\tfiles = append(files, arg)\n75\t\t\t\tcontinue\n76\t\t\t}\n77\t\t\tswitch arg {\n78\t\t\tcase \"--\":\n79\t\t\t\tendOfFlags = true\n80\t\t\tcase \"-h\", \"--human-readable\":\n81\t\t\t\topts.sizeMode = modeHuman\n82\t\t\tcase \"-H\", \"--si\":\n83\t\t\t\topts.sizeMode = modeSI\n84\t\t\tcase \"-T\", \"--print-type\":\n85\t\t\t\topts.showType = true\n86\t\t\tcase \"-i\", \"--inodes\":\n87\t\t\t\topts.showInodes = true\n88\t\t\tcase \"-a\", \"--all\":\n89\t\t\t\topts.showAll = true\n90\t\t\tcase \"-l\", \"--local\":\n91\t\t\t\topts.localOnly = true\n92\t\t\tdefault:\n93\t\t\t\tfiles = append(files, arg)\n94\t\t\t}\n95\t\t}\n96\t\treturn opts, files\n97\t}\n98\t\n99\tfunc listAll(opts options) int {\n100\t\tstats, err := getAllMounts()\n101\t\tif err != nil {\n102\t\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n103\t\t\treturn 1\n104\t\t}\n105\t\tentries := filterAndDedup(stats, opts)\n106\t\tprintTable(entries, opts)\n107\t\treturn 0\n108\t}\n109\t\n110\tfunc listPaths(paths []string, opts options) int {\n111\t\tstats, err := getAllMounts()\n112\t\tif err != nil {\n113\t\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n114\t\t\treturn 1\n115\t\t}\n116\t\tdevMap := buildDevMap(stats)\n117\t\texitCode := 0\n118\t\tentries := make([]fsEntry, 0, len(paths))\n119\t\tfor _, path := range paths {\n120\t\t\tentry, err := entryForPath(path, devMap)\n121\t\t\tif err != nil {\n122\t\t\t\tfmt.Fprintf(os.Stderr, \"df: %s: %s\\n\", path, capitalizeErr(err))\n123\t\t\t\texitCode = 1\n124\t\t\t\tcontinue\n125\t\t\t}\n126\t\t\tentries = append(entries, entry)\n127\t\t}\n128\t\tif len(entries) > 0 {\n129\t\t\tprintTable(entries, opts)\n130\t\t}\n131\t\treturn exitCode\n132\t}\n133\t\n134\tfunc capitalizeErr(err error) string {\n135\t\ts := err.Error()\n136\t\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n137\t\t\treturn strings.ToUpper(s[:1]) + s[1:]\n138\t\t}\n139\t\treturn s\n140\t}\n141\t\n142\tfunc getAllMounts() ([]unix.Statfs_t, error) {\n143\t\tn, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)\n144\t\tif err != nil {\n145\t\t\treturn nil, err\n146\t\t}\n147\t\tbuf := make([]unix.Statfs_t, n)\n148\t\tn, err = unix.Getfsstat(buf, unix.MNT_NOWAIT)\n149\t\tif err != nil {\n150\t\t\treturn nil, err\n151\t\t}\n152\t\treturn buf[:n], nil\n153\t}\n154\t\n155\tfunc isDummyType(t string) bool {\n156\t\treturn t == \"devfs\" || t == \"autofs\"\n157\t}\n158\t\n159\tfunc filterAndDedup(stats []unix.Statfs_t, opts options) []fsEntry {\n160\t\tseen := make(map[int32]bool)\n161\t\tentries := make([]fsEntry, 0, len(stats))\n162\t\tfor _, s := range stats {\n163\t\t\tif !opts.showAll {\n164\t\t\t\tif isDummyType(cstring(s.Fstypename[:])) {\n165\t\t\t\t\tcontinue\n166\t\t\t\t}\n167\t\t\t\tif s.Blocks == 0 {\n168\t\t\t\t\tcontinue\n169\t\t\t\t}\n170\t\t\t}\n171\t\t\tif opts.localOnly && s.Flags&unix.MNT_LOCAL == 0 {\n172\t\t\t\tcontinue\n173\t\t\t}\n174\t\t\tdev, ok := mountDev(cstring(s.Mntonname[:]))\n175\t\t\tif !ok {\n176\t\t\t\tcontinue\n177\t\t\t}\n178\t\t\tif seen[dev] {\n179\t\t\t\tcontinue\n180\t\t\t}\n181\t\t\tseen[dev] = true\n182\t\t\tentries = append(entries, buildEntry(s))\n183\t\t}\n184\t\treturn entries\n185\t}\n186\t\n187\tfunc buildDevMap(stats []unix.Statfs_t) map[int32]string {\n188\t\tm := make(map[int32]string, len(stats))\n189\t\tfor _, s := range stats {\n190\t\t\tmount := cstring(s.Mntonname[:])\n191\t\t\tdev, ok := mountDev(mount)\n192\t\t\tif !ok {\n193\t\t\t\tcontinue\n194\t\t\t}\n195\t\t\tif _, exists := m[dev]; !exists {\n196\t\t\t\tm[dev] = mount\n197\t\t\t}\n198\t\t}\n199\t\treturn m\n200\t}\n201\t\n202\tfunc entryForPath(path string, devMap map[int32]string) (fsEntry, error) {\n203\t\tvar info syscall.Stat_t\n204\t\tif err := syscall.Stat(path, &info); err != nil {\n205\t\t\treturn fsEntry{}, err\n206\t\t}\n207\t\ttarget := path\n208\t\tif mount, ok := devMap[info.Dev]; ok {\n209\t\t\ttarget = mount\n210\t\t}\n211\t\tvar stat unix.Statfs_t\n212\t\tif err := unix.Statfs(target, &stat); err != nil {\n213\t\t\treturn fsEntry{}, err\n214\t\t}\n215\t\treturn buildEntry(stat), nil\n216\t}\n217\t\n218\tfunc mountDev(mount string) (int32, bool) {\n219\t\tvar info syscall.Stat_t\n220\t\tif err := syscall.Stat(mount, &info); err != nil {\n221\t\t\treturn 0, false\n222\t\t}\n223\t\treturn info.Dev, true\n224\t}\n225\t\n226\tfunc buildEntry(stat unix.Statfs_t) fsEntry {\n227\t\tbsize := uint64(stat.Bsize)\n228\t\ttotalBytes := int64(stat.Blocks * bsize)\n229\t\tfreeBytes := int64(stat.Bfree * bsize)\n230\t\tavailBytes := int64(stat.Bavail * bsize)\n231\t\ttotal := totalBytes / 1024\n232\t\tfree := freeBytes / 1024\n233\t\tavail := availBytes / 1024\n234\t\tinodes := int64(stat.Files)\n235\t\tinodesFree := int64(stat.Ffree)\n236\t\treturn fsEntry{\n237\t\t\tfilesystem:      cstring(stat.Mntfromname[:]),\n238\t\t\tfsType:          cstring(stat.Fstypename[:]),\n239\t\t\tblocks1K:        total,\n240\t\t\tused:            total - free,\n241\t\t\tavailable:       avail,\n242\t\t\tsizeBytes:       totalBytes,\n243\t\t\tusedBytes:       totalBytes - freeBytes,\n244\t\t\tavailBytes:      availBytes,\n245\t\t\tusePercent:      computeUsePercent(total, avail),\n246\t\t\tinodes:          inodes,\n247\t\t\tinodesUsed:      inodes - inodesFree,\n248\t\t\tinodesFree:      inodesFree,\n249\t\t\tinodeUsePercent: computeUsePercent(inodes, inodesFree),\n250\t\t\tmountedOn:       cstring(stat.Mntonname[:]),\n251\t\t}\n252\t}\n253\t\n254\tfunc computeUsePercent(total, avail int64) string {\n255\t\tif total == 0 {\n256\t\t\treturn \"-\"\n257\t\t}\n258\t\tused := total - avail\n259\t\tif used <= 0 {\n260\t\t\treturn \"0%\"\n261\t\t}\n262\t\tpct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n263\t\treturn strconv.FormatInt(pct, 10) + \"%\"\n264\t}\n265\t\n266\tfunc humanSize(bytes int64, base float64) string {\n267\t\tif bytes == 0 {\n268\t\t\treturn \"0\"\n269\t\t}\n270\t\tval := float64(bytes)\n271\t\tidx := 0\n272\t\tfor idx < len(humanSuffixes)-1 && val >= base {\n273\t\t\tval /= base\n274\t\t\tidx++\n275\t\t}\n276\t\treturn formatHuman(val, humanSuffixes[idx])\n277\t}\n278\t\n279\tfunc formatHuman(val float64, suffix string) string {\n280\t\tif suffix == \"\" {\n281\t\t\treturn strconv.FormatInt(int64(math.Ceil(val)), 10)\n282\t\t}\n283\t\tceiled := math.Ceil(val*10) / 10\n284\t\tif ceiled < 10 {\n285\t\t\treturn fmt.Sprintf(\"%.1f%s\", ceiled, suffix)\n286\t\t}\n287\t\treturn fmt.Sprintf(\"%d%s\", int64(math.Ceil(val)), suffix)\n288\t}\n289\t\n290\tfunc formatSize(blocks1K, sizeBytes int64, mode sizeMode) string {\n291\t\tswitch mode {\n292\t\tcase modeHuman:\n293\t\t\treturn humanSize(sizeBytes, 1024)\n294\t\tcase modeSI:\n295\t\t\treturn humanSize(sizeBytes, 1000)\n296\t\tdefault:\n297\t\t\treturn strconv.FormatInt(blocks1K, 10)\n298\t\t}\n299\t}\n300\t\n301\tfunc getHeaders(opts options) []string {\n302\t\tvar h []string\n303\t\th = append(h, \"Filesystem\")\n304\t\tif opts.showType {\n305\t\t\th = append(h, \"Type\")\n306\t\t}\n307\t\tif opts.showInodes {\n308\t\t\th = append(h, \"Inodes\", \"IUsed\", \"IFree\", \"IUse%\")\n309\t\t} else if opts.sizeMode != modeDefault {\n310\t\t\th = append(h, \"Size\", \"Used\", \"Avail\", \"Use%\")\n311\t\t} else {\n312\t\t\th = append(h, \"1K-blocks\", \"Used\", \"Available\", \"Use%\")\n313\t\t}\n314\t\th = append(h, \"Mounted on\")\n315\t\treturn h\n316\t}\n317\t\n318\tfunc getAlignment(opts options) []bool {\n319\t\tvar a []bool\n320\t\ta = append(a, false)\n321\t\tif opts.showType {\n322\t\t\ta = append(a, false)\n323\t\t}\n324\t\ta = append(a, true, true, true, true)\n325\t\ta = append(a, false)\n326\t\treturn a\n327\t}\n328\t\n329\tfunc entryStrings(e fsEntry, opts options) []string {\n330\t\tvar cols []string\n331\t\tcols = append(cols, e.filesystem)\n332\t\tif opts.showType {\n333\t\t\tcols = append(cols, e.fsType)\n334\t\t}\n335\t\tif opts.showInodes {\n336\t\t\tcols = append(cols,\n337\t\t\t\tstrconv.FormatInt(e.inodes, 10),\n338\t\t\t\tstrconv.FormatInt(e.inodesUsed, 10),\n339\t\t\t\tstrconv.FormatInt(e.inodesFree, 10),\n340\t\t\t\te.inodeUsePercent,\n341\t\t\t)\n342\t\t} else {\n343\t\t\tcols = append(cols,\n344\t\t\t\tformatSize(e.blocks1K, e.sizeBytes, opts.sizeMode),\n345\t\t\t\tformatSize(e.used, e.usedBytes, opts.sizeMode),\n346\t\t\t\tformatSize(e.available, e.availBytes, opts.sizeMode),\n347\t\t\t\te.usePercent,\n348\t\t\t)\n349\t\t}\n350\t\tcols = append(cols, e.mountedOn)\n351\t\treturn cols\n352\t}\n353\t\n354\tfunc computeWidths(entries []fsEntry, opts options) []int {\n355\t\th := getHeaders(opts)\n356\t\tw := make([]int, len(h))\n357\t\tfor i, s := range h {\n358\t\t\tw[i] = len(s)\n359\t\t}\n360\t\tfor _, e := range entries {\n361\t\t\tcols := entryStrings(e, opts)\n362\t\t\tfor i := range w {\n363\t\t\t\tif len(cols[i]) > w[i] {\n364\t\t\t\t\tw[i] = len(cols[i])\n365\t\t\t\t}\n366\t\t\t}\n367\t\t}\n368\t\tstart := 1\n369\t\tif opts.showType {\n370\t\t\tstart = 2\n371\t\t}\n372\t\tfor i := start; i < start+3 && i < len(w); i++ {\n373\t\t\tif w[i] < 5 {\n374\t\t\t\tw[i] = 5\n375\t\t\t}\n376\t\t}\n377\t\treturn w\n378\t}\n379\t\n380\tfunc printTable(entries []fsEntry, opts options) {\n381\t\tw := computeWidths(entries, opts)\n382\t\talign := getAlignment(opts)\n383\t\tprintLine(getHeaders(opts), w, align)\n384\t\tfor _, e := range entries {\n385\t\t\tprintLine(entryStrings(e, opts), w, align)\n386\t\t}\n387\t}\n388\t\n389\tfunc printLine(cols []string, w []int, rightAlign []bool) {\n390\t\tparts := make([]string, len(cols))\n391\t\tfor i, col := range cols {\n392\t\t\tif i == len(cols)-1 {\n393\t\t\t\tparts[i] = col\n394\t\t\t} else if rightAlign[i] {\n395\t\t\t\tparts[i] = format.PadLeft(col, w[i])\n396\t\t\t} else {\n397\t\t\t\tparts[i] = format.PadRight(col, w[i])\n398\t\t\t}\n399\t\t}\n400\t\tfmt.Println(strings.Join(parts, \" \"))\n401\t}\n402\t\n403\tfunc cstring(b []byte) string {\n404\t\tfor i, v := range b {\n405\t\t\tif v == 0 {\n406\t\t\t\treturn string(b[:i])\n407\t\t\t}\n408\t\t}\n409\t\treturn string(b)\n410\t}\n411\t"}]},"parent_tool_use_id":null,"session_id":"a315170d-d3ea-4738-8b8a-db26036cb150","uuid":"9d8cd684-5d01-4e1a-b4bd-9a9959a271bb","timestamp":"2026-05-27T21:17:37.572Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5616/cmd/df/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd106-df R1.1-R1.5, R2.1-R2.3, R3.1-R3.4.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n\t\"golang.org/x/sys/unix\"\n)\n\ntype sizeMode int\n\nconst (\n\tmodeDefault sizeMode = iota\n\tmodeHuman\n\tmodeSI\n)\n\ntype options struct {\n\tsizeMode   sizeMode\n\tshowType   bool\n\tshowInodes bool\n\tshowAll    bool\n\tlocalOnly  bool\n}\n\ntype fsEntry struct {\n\tfilesystem      string\n\tfsType          string\n\tblocks1K        int64\n\tused            int64\n\tavailable       int64\n\tsizeBytes       int64\n\tusedBytes       int64\n\tavailBytes      int64\n\tusePercent      string\n\tinodes          int64\n\tinodesUsed      int64\n\tinodesFree      int64\n\tinodeUsePercent string\n\tmountedOn       string\n}\n\nvar humanSuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run(os.Args[1:]))\n}\n\nfunc run(args []string) int {\n\topts, files := parseArgs(args)\n\tif len(files) == 0 {\n\t\treturn listAll(opts)\n\t}\n\treturn listPaths(files, opts)\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar files []string\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tswitch arg {\n\t\tcase \"--\":\n\t\t\tendOfFlags = true\n\t\tcase \"-h\", \"--human-readable\":\n\t\t\topts.sizeMode = modeHuman\n\t\tcase \"-H\", \"--si\":\n\t\t\topts.sizeMode = modeSI\n\t\tcase \"-T\", \"--print-type\":\n\t\t\topts.showType = true\n\t\tcase \"-i\", \"--inodes\":\n\t\t\topts.showInodes = true\n\t\tcase \"-a\", \"--all\":\n\t\t\topts.showAll = true\n\t\tcase \"-l\", \"--local\":\n\t\t\topts.localOnly = true\n\t\tdefault:\n\t\t\tfiles = append(files, arg)\n\t\t}\n\t}\n\treturn opts, files\n}\n\nfunc listAll(opts options) int {\n\tstats, err := getAllMounts()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n\t\treturn 1\n\t}\n\tentries := filterAndDedup(stats, opts)\n\tprintTable(entries, opts)\n\treturn 0\n}\n\nfunc listPaths(paths []string, opts options) int {\n\tstats, err := getAllMounts()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n\t\treturn 1\n\t}\n\tdevMap := buildDevMap(stats)\n\texitCode := 0\n\tentries := make([]fsEntry, 0, len(paths))\n\tfor _, path := range paths {\n\t\tentry, err := entryForPath(path, devMap)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"df: %s: %s\\n\", path, capitalizeErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, entry)\n\t}\n\tif len(entries) > 0 {\n\t\tprintTable(entries, opts)\n\t}\n\treturn exitCode\n}\n\nfunc capitalizeErr(err error) string {\n\ts := err.Error()\n\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n\t\treturn strings.ToUpper(s[:1]) + s[1:]\n\t}\n\treturn s\n}\n\nfunc getAllMounts() ([]unix.Statfs_t, error) {\n\tn, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tbuf := make([]unix.Statfs_t, n)\n\tn, err = unix.Getfsstat(buf, unix.MNT_NOWAIT)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn buf[:n], nil\n}\n\nfunc isDummyType(t string) bool {\n\treturn t == \"devfs\" || t == \"autofs\"\n}\n\nfunc filterAndDedup(stats []unix.Statfs_t, opts options) []fsEntry {\n\tseen := make(map[int32]bool)\n\tentries := make([]fsEntry, 0, len(stats))\n\tfor _, s := range stats {\n\t\tif !opts.showAll {\n\t\t\tif isDummyType(cstring(s.Fstypename[:])) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif s.Blocks == 0 {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tif opts.localOnly && s.Flags&unix.MNT_LOCAL == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tdev, ok := mountDev(cstring(s.Mntonname[:]))\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[dev] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[dev] = true\n\t\tentries = append(entries, buildEntry(s))\n\t}\n\treturn entries\n}\n\nfunc buildDevMap(stats []unix.Statfs_t) map[int32]string {\n\tm := make(map[int32]string, len(stats))\n\tfor _, s := range stats {\n\t\tmount := cstring(s.Mntonname[:])\n\t\tdev, ok := mountDev(mount)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif _, exists := m[dev]; !exists {\n\t\t\tm[dev] = mount\n\t\t}\n\t}\n\treturn m\n}\n\nfunc entryForPath(path string, devMap map[int32]string) (fsEntry, error) {\n\tvar info syscall.Stat_t\n\tif err := syscall.Stat(path, &info); err != nil {\n\t\treturn fsEntry{}, err\n\t}\n\ttarget := path\n\tif mount, ok := devMap[info.Dev]; ok {\n\t\ttarget = mount\n\t}\n\tvar stat unix.Statfs_t\n\tif err := unix.Statfs(target, &stat); err != nil {\n\t\treturn fsEntry{}, err\n\t}\n\treturn buildEntry(stat), nil\n}\n\nfunc mountDev(mount string) (int32, bool) {\n\tvar info syscall.Stat_t\n\tif err := syscall.Stat(mount, &info); err != nil {\n\t\treturn 0, false\n\t}\n\treturn info.Dev, true\n}\n\nfunc buildEntry(stat unix.Statfs_t) fsEntry {\n\tbsize := uint64(stat.Bsize)\n\ttotalBytes := int64(stat.Blocks * bsize)\n\tfreeBytes := int64(stat.Bfree * bsize)\n\tavailBytes := int64(stat.Bavail * bsize)\n\ttotal := totalBytes / 1024\n\tfree := freeBytes / 1024\n\tavail := availBytes / 1024\n\tinodes := int64(stat.Files)\n\tinodesFree := int64(stat.Ffree)\n\treturn fsEntry{\n\t\tfilesystem:      cstring(stat.Mntfromname[:]),\n\t\tfsType:          cstring(stat.Fstypename[:]),\n\t\tblocks1K:        total,\n\t\tused:            total - free,\n\t\tavailable:       avail,\n\t\tsizeBytes:       totalBytes,\n\t\tusedBytes:       totalBytes - freeBytes,\n\t\tavailBytes:      availBytes,\n\t\tusePercent:      computeUsePercent(total, avail),\n\t\tinodes:          inodes,\n\t\tinodesUsed:      inodes - inodesFree,\n\t\tinodesFree:      inodesFree,\n\t\tinodeUsePercent: computeUsePercent(inodes, inodesFree),\n\t\tmountedOn:       cstring(stat.Mntonname[:]),\n\t}\n}\n\nfunc computeUsePercent(total, avail int64) string {\n\tif total == 0 {\n\t\treturn \"-\"\n\t}\n\tused := total - avail\n\tif used <= 0 {\n\t\treturn \"0%\"\n\t}\n\tpct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n\treturn strconv.FormatInt(pct, 10) + \"%\"\n}\n\nfunc humanSize(bytes int64, base float64) string {\n\tif bytes == 0 {\n\t\treturn \"0\"\n\t}\n\tval := float64(bytes)\n\tidx := 0\n\tfor idx < len(humanSuffixes)-1 && val >= base {\n\t\tval /= base\n\t\tidx++\n\t}\n\treturn formatHuman(val, humanSuffixes[idx])\n}\n\nfunc formatHuman(val float64, suffix string) string {\n\tif suffix == \"\" {\n\t\treturn strconv.FormatInt(int64(math.Ceil(val)), 10)\n\t}\n\tceiled := math.Ceil(val*10) / 10\n\tif ceiled < 10 {\n\t\treturn fmt.Sprintf(\"%.1f%s\", ceiled, suffix)\n\t}\n\treturn fmt.Sprintf(\"%d%s\", int64(math.Ceil(val)), suffix)\n}\n\nfunc formatSize(blocks1K, sizeBytes int64, mode sizeMode) string {\n\tswitch mode {\n\tcase modeHuman:\n\t\treturn humanSize(sizeBytes, 1024)\n\tcase modeSI:\n\t\treturn humanSize(sizeBytes, 1000)\n\tdefault:\n\t\treturn strconv.FormatInt(blocks1K, 10)\n\t}\n}\n\nfunc getHeaders(opts options) []string {\n\tvar h []string\n\th = append(h, \"Filesystem\")\n\tif opts.showType {\n\t\th = append(h, \"Type\")\n\t}\n\tif opts.showInodes {\n\t\th = append(h, \"Inodes\", \"IUsed\", \"IFree\", \"IUse%\")\n\t} else if opts.sizeMode != modeDefault {\n\t\th = append(h, \"Size\", \"Used\", \"Avail\", \"Use%\")\n\t} else {\n\t\th = append(h, \"1K-blocks\", \"Used\", \"Available\", \"Use%\")\n\t}\n\th = append(h, \"Mounted on\")\n\treturn h\n}\n\nfunc getAlignment(opts options) []bool {\n\tvar a []bool\n\ta = append(a, false)\n\tif opts.showType {\n\t\ta = append(a, false)\n\t}\n\ta = append(a, true, true, true, true)\n\ta = append(a, false)\n\treturn a\n}\n\nfunc entryStrings(e fsEntry, opts options) []string {\n\tvar cols []string\n\tcols = append(cols, e.filesystem)\n\tif opts.showType {\n\t\tcols = append(cols, e.fsType)\n\t}\n\tif opts.showInodes {\n\t\tcols = append(cols,\n\t\t\tstrconv.FormatInt(e.inodes, 10),\n\t\t\tstrconv.FormatInt(e.inodesUsed, 10),\n\t\t\tstrconv.FormatInt(e.inodesFree, 10),\n\t\t\te.inodeUsePercent,\n\t\t)\n\t} else {\n\t\tcols = append(cols,\n\t\t\tformatSize(e.blocks1K, e.sizeBytes, opts.sizeMode),\n\t\t\tformatSize(e.used, e.usedBytes, opts.sizeMode),\n\t\t\tformatSize(e.available, e.availBytes, opts.sizeMode),\n\t\t\te.usePercent,\n\t\t)\n\t}\n\tcols = append(cols, e.mountedOn)\n\treturn cols\n}\n\nfunc computeWidths(entries []fsEntry, opts options) []int {\n\th := getHeaders(opts)\n\tw := make([]int, len(h))\n\tfor i, s := range h {\n\t\tw[i] = len(s)\n\t}\n\tfor _, e := range entries {\n\t\tcols := entryStrings(e, opts)\n\t\tfor i := range w {\n\t\t\tif len(cols[i]) > w[i] {\n\t\t\t\tw[i] = len(cols[i])\n\t\t\t}\n\t\t}\n\t}\n\tstart := 1\n\tif opts.showType {\n\t\tstart = 2\n\t}\n\tfor i := start; i < start+3 && i < len(w); i++ {\n\t\tif w[i] < 5 {\n\t\t\tw[i] = 5\n\t\t}\n\t}\n\treturn w\n}\n\nfunc printTable(entries []fsEntry, opts options) {\n\tw := computeWidths(entries, opts)\n\talign := getAlignment(opts)\n\tprintLine(getHeaders(opts), w, align)\n\tfor _, e := range entries {\n\t\tprintLine(entryStrings(e, opts), w, align)\n\t}\n}\n\nfunc printLine(cols []string, w []int, rightAlign []bool) {\n\tparts := make([]string, len(cols))\n\tfor i, col := range cols {\n\t\tif i == len(cols)-1 {\n\t\t\tparts[i] = col\n\t\t} else if rightAlign[i] {\n\t\t\tparts[i] = format.PadLeft(col, w[i])\n\t\t} else {\n\t\t\tparts[i] = format.PadRight(col, w[i])\n\t\t}\n\t}\n\tfmt.Println(strings.Join(parts, \" \"))\n}\n\nfunc cstring(b []byte) string {\n\tfor i, v := range b {\n\t\tif v == 0 {\n\t\t\treturn string(b[:i])\n\t\t}\n\t}\n\treturn string(b