{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LEREcAU2BJr133D3F74Xu2","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"slices\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst helpText = `Usage: sort [OPTION]... [FILE]...\n19\tWrite sorted concatenation of all FILE(s) to standard output.\n20\t\n21\tWith no FILE, or when FILE is -, read standard input.\n22\t\n23\tMandatory arguments to long options are mandatory for short options too.\n24\tOrdering options:\n25\t\n26\t  -h, --human-numeric-sort    compare human readable numbers (e.g., 2K 1G)\n27\t  -M, --month-sort            compare (unknown) < 'JAN' < ... < 'DEC'\n28\t  -n, --numeric-sort          compare according to string numerical value\n29\t  -V, --version-sort          natural sort of (version) numbers within text\n30\t  -r, --reverse               reverse the result of comparisons\n31\t\n32\tOther options:\n33\t\n34\t  -o, --output=FILE           write result to FILE instead of standard output\n35\t  -s, --stable                stabilize sort by disabling last-resort comparison\n36\t  -t, --field-separator=SEP   use SEP instead of non-blank to blank transition\n37\t  -u, --unique                with -c, check for strict ordering;\n38\t                                without -c, output only the first of an equal run\n39\t      --help        display this help and exit\n40\t      --version     output version information and exit\n41\t`\n42\t\n43\tconst versionText = `sort (go-unix-utils) dev\n44\t`\n45\t\n46\ttype sortMode int\n47\t\n48\tconst (\n49\t\tsortDefault sortMode = iota\n50\t\tsortNumeric\n51\t\tsortHumanNumeric\n52\t\tsortMonth\n53\t\tsortVersion\n54\t)\n55\t\n56\ttype options struct {\n57\t\treverse        bool\n58\t\tunique         bool\n59\t\tstable         bool\n60\t\tmode           sortMode\n61\t\toutputFile     string\n62\t\tfieldSeparator string\n63\t}\n64\t\n65\tvar monthMap = map[string]int{\n66\t\t\"JAN\": 1, \"FEB\": 2, \"MAR\": 3, \"APR\": 4,\n67\t\t\"MAY\": 5, \"JUN\": 6, \"JUL\": 7, \"AUG\": 8,\n68\t\t\"SEP\": 9, \"OCT\": 10, \"NOV\": 11, \"DEC\": 12,\n69\t}\n70\t\n71\tfunc main() {\n72\t\tsys.InstallSIGPIPEHandler()\n73\t\n74\t\topts, files, err := parseArgs(os.Args[1:])\n75\t\tif err != nil {\n76\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n77\t\t\tfmt.Fprintf(os.Stderr, \"Try 'sort --help' for more information.\\n\")\n78\t\t\tos.Exit(2)\n79\t\t}\n80\t\n81\t\tif len(files) == 0 {\n82\t\t\tfiles = []string{\"-\"}\n83\t\t}\n84\t\n85\t\tlines, err := readAllLines(files)\n86\t\tif err != nil {\n87\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n88\t\t\tos.Exit(2)\n89\t\t}\n90\t\n91\t\tlines = sortAndFilter(lines, opts)\n92\t\n93\t\tvar w io.Writer = os.Stdout\n94\t\tif opts.outputFile != \"\" {\n95\t\t\tf, err := os.Create(opts.outputFile)\n96\t\t\tif err != nil {\n97\t\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n98\t\t\t\tos.Exit(2)\n99\t\t\t}\n100\t\t\tdefer f.Close()\n101\t\t\tw = f\n102\t\t}\n103\t\twriteLines(lines, w)\n104\t}\n105\t\n106\tfunc parseArgs(args []string) (options, []string, error) {\n107\t\tvar opts options\n108\t\tvar files []string\n109\t\n110\t\ti := 0\n111\t\tfor i < len(args) {\n112\t\t\targ := args[i]\n113\t\t\tif arg == \"--\" {\n114\t\t\t\tfiles = append(files, args[i+1:]...)\n115\t\t\t\tbreak\n116\t\t\t}\n117\t\t\tif strings.HasPrefix(arg, \"--\") {\n118\t\t\t\tn, err := parseLongFlag(arg, &opts, args[i+1:])\n119\t\t\t\tif err != nil {\n120\t\t\t\t\treturn opts, nil, err\n121\t\t\t\t}\n122\t\t\t\ti += n\n123\t\t\t\tcontinue\n124\t\t\t}\n125\t\t\tif len(arg) > 1 && arg[0] == '-' {\n126\t\t\t\textra, err := parseShortFlags(arg[1:], &opts, args[i+1:])\n127\t\t\t\tif err != nil {\n128\t\t\t\t\treturn opts, nil, err\n129\t\t\t\t}\n130\t\t\t\ti += 1 + extra\n131\t\t\t\tcontinue\n132\t\t\t}\n133\t\t\tfiles = append(files, arg)\n134\t\t\ti++\n135\t\t}\n136\t\n137\t\treturn opts, files, nil\n138\t}\n139\t\n140\tfunc parseLongFlag(flag string, opts *options, remaining []string) (int, error) {\n141\t\tif v, ok := strings.CutPrefix(flag, \"--output=\"); ok {\n142\t\t\topts.outputFile = v\n143\t\t\treturn 1, nil\n144\t\t}\n145\t\tif v, ok := strings.CutPrefix(flag, \"--field-separator=\"); ok {\n146\t\t\tif len(v) != 1 {\n147\t\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", v)\n148\t\t\t}\n149\t\t\topts.fieldSeparator = v\n150\t\t\treturn 1, nil\n151\t\t}\n152\t\tswitch flag {\n153\t\tcase \"--help\":\n154\t\t\tfmt.Fprint(os.Stdout, helpText)\n155\t\t\tos.Exit(0)\n156\t\tcase \"--version\":\n157\t\t\tfmt.Fprint(os.Stdout, versionText)\n158\t\t\tos.Exit(0)\n159\t\tcase \"--reverse\":\n160\t\t\topts.reverse = true\n161\t\tcase \"--unique\":\n162\t\t\topts.unique = true\n163\t\tcase \"--stable\":\n164\t\t\topts.stable = true\n165\t\tcase \"--numeric-sort\":\n166\t\t\topts.mode = sortNumeric\n167\t\tcase \"--human-numeric-sort\":\n168\t\t\topts.mode = sortHumanNumeric\n169\t\tcase \"--month-sort\":\n170\t\t\topts.mode = sortMonth\n171\t\tcase \"--version-sort\":\n172\t\t\topts.mode = sortVersion\n173\t\tcase \"--output\", \"--field-separator\":\n174\t\t\treturn parseLongWithArg(flag, opts, remaining)\n175\t\tdefault:\n176\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n177\t\t}\n178\t\treturn 1, nil\n179\t}\n180\t\n181\tfunc parseLongWithArg(flag string, opts *options, remaining []string) (int, error) {\n182\t\tif len(remaining) == 0 {\n183\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n184\t\t}\n185\t\tswitch flag {\n186\t\tcase \"--output\":\n187\t\t\topts.outputFile = remaining[0]\n188\t\tcase \"--field-separator\":\n189\t\t\tif len(remaining[0]) != 1 {\n190\t\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n191\t\t\t}\n192\t\t\topts.fieldSeparator = remaining[0]\n193\t\t}\n194\t\treturn 2, nil\n195\t}\n196\t\n197\tfunc parseShortFlags(flags string, opts *options, remaining []string) (int, error) {\n198\t\tfor idx := 0; idx < len(flags); idx++ {\n199\t\t\tswitch flags[idx] {\n200\t\t\tcase 'r':\n201\t\t\t\topts.reverse = true\n202\t\t\tcase 'u':\n203\t\t\t\topts.unique = true\n204\t\t\tcase 's':\n205\t\t\t\topts.stable = true\n206\t\t\tcase 'n':\n207\t\t\t\topts.mode = sortNumeric\n208\t\t\tcase 'h':\n209\t\t\t\topts.mode = sortHumanNumeric\n210\t\t\tcase 'M':\n211\t\t\t\topts.mode = sortMonth\n212\t\t\tcase 'V':\n213\t\t\t\topts.mode = sortVersion\n214\t\t\tcase 'o':\n215\t\t\t\trest := flags[idx+1:]\n216\t\t\t\tif rest != \"\" {\n217\t\t\t\t\topts.outputFile = rest\n218\t\t\t\t\treturn 0, nil\n219\t\t\t\t}\n220\t\t\t\tif len(remaining) == 0 {\n221\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'o'\")\n222\t\t\t\t}\n223\t\t\t\topts.outputFile = remaining[0]\n224\t\t\t\treturn 1, nil\n225\t\t\tcase 't':\n226\t\t\t\treturn parseFieldSep(flags[idx+1:], remaining, opts)\n227\t\t\tdefault:\n228\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[idx])\n229\t\t\t}\n230\t\t}\n231\t\treturn 0, nil\n232\t}\n233\t\n234\tfunc parseFieldSep(rest string, remaining []string, opts *options) (int, error) {\n235\t\tif rest != \"\" {\n236\t\t\tif len(rest) != 1 {\n237\t\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", rest)\n238\t\t\t}\n239\t\t\topts.fieldSeparator = rest\n240\t\t\treturn 0, nil\n241\t\t}\n242\t\tif len(remaining) == 0 {\n243\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 't'\")\n244\t\t}\n245\t\tif len(remaining[0]) != 1 {\n246\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n247\t\t}\n248\t\topts.fieldSeparator = remaining[0]\n249\t\treturn 1, nil\n250\t}\n251\t\n252\tfunc readAllLines(files []string) ([]string, error) {\n253\t\tvar lines []string\n254\t\tfor _, file := range files {\n255\t\t\tr, closer, err := openInput(file)\n256\t\t\tif err != nil {\n257\t\t\t\treturn nil, err\n258\t\t\t}\n259\t\t\tfileLines, err := readLines(r)\n260\t\t\tif closer != nil {\n261\t\t\t\tcloser.Close()\n262\t\t\t}\n263\t\t\tif err != nil {\n264\t\t\t\treturn nil, err\n265\t\t\t}\n266\t\t\tlines = append(lines, fileLines...)\n267\t\t}\n268\t\treturn lines, nil\n269\t}\n270\t\n271\tfunc openInput(name string) (io.Reader, io.Closer, error) {\n272\t\tif name == \"-\" {\n273\t\t\treturn os.Stdin, nil, nil\n274\t\t}\n275\t\tf, err := os.Open(name)\n276\t\tif err != nil {\n277\t\t\treturn nil, nil, err\n278\t\t}\n279\t\treturn f, f, nil\n280\t}\n281\t\n282\tfunc readLines(r io.Reader) ([]string, error) {\n283\t\tvar lines []string\n284\t\tscanner := bufio.NewScanner(r)\n285\t\tfor scanner.Scan() {\n286\t\t\tlines = append(lines, scanner.Text())\n287\t\t}\n288\t\tif err := scanner.Err(); err != nil {\n289\t\t\treturn nil, err\n290\t\t}\n291\t\treturn lines, nil\n292\t}\n293\t\n294\tfunc sortAndFilter(lines []string, opts options) []string {\n295\t\tkeyCmp := buildKeyCmp(opts)\n296\t\n297\t\tfullCmp := keyCmp\n298\t\tif opts.mode != sortDefault && !opts.stable {\n299\t\t\tfullCmp = func(a, b string) int {\n300\t\t\t\tif r := keyCmp(a, b); r != 0 {\n301\t\t\t\t\treturn r\n302\t\t\t\t}\n303\t\t\t\treturn strings.Compare(a, b)\n304\t\t\t}\n305\t\t}\n306\t\n307\t\tsortCmp := fullCmp\n308\t\tif opts.reverse {\n309\t\t\tsortCmp = func(a, b string) int { return fullCmp(b, a) }\n310\t\t}\n311\t\n312\t\tif opts.stable {\n313\t\t\tslices.SortStableFunc(lines, sortCmp)\n314\t\t} else {\n315\t\t\tslices.SortFunc(lines, sortCmp)\n316\t\t}\n317\t\n318\t\tif opts.unique {\n319\t\t\tlines = dedup(lines, keyCmp)\n320\t\t}\n321\t\n322\t\treturn lines\n323\t}\n324\t\n325\tfunc buildKeyCmp(opts options) func(string, string) int {\n326\t\tswitch opts.mode {\n327\t\tcase sortHumanNumeric:\n328\t\t\treturn cmpFloat(parseHumanNumeric)\n329\t\tcase sortMonth:\n330\t\t\treturn func(a, b string) int { return monthRank(a) - monthRank(b) }\n331\t\tcase sortVersion:\n332\t\t\treturn compareVersion\n333\t\tcase sortNumeric:\n334\t\t\treturn cmpFloat(parseNumeric)\n335\t\tdefault:\n336\t\t\treturn strings.Compare\n337\t\t}\n338\t}\n339\t\n340\tfunc cmpFloat(parse func(string) float64) func(string, string) int {\n341\t\treturn func(a, b string) int {\n342\t\t\tna, nb := parse(a), parse(b)\n343\t\t\tif na < nb {\n344\t\t\t\treturn -1\n345\t\t\t}\n346\t\t\tif na > nb {\n347\t\t\t\treturn 1\n348\t\t\t}\n349\t\t\treturn 0\n350\t\t}\n351\t}\n352\t\n353\tfunc parseNumericEnd(s string) (float64, int) {\n354\t\ti := 0\n355\t\tfor i < len(s) && (s[i] == ' ' || s[i] == '\\t') {\n356\t\t\ti++\n357\t\t}\n358\t\tstart := i\n359\t\tif i < len(s) && (s[i] == '-' || s[i] == '+') {\n360\t\t\ti++\n361\t\t}\n362\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n363\t\t\ti++\n364\t\t}\n365\t\tif i < len(s) && s[i] == '.' {\n366\t\t\ti++\n367\t\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n368\t\t\t\ti++\n369\t\t\t}\n370\t\t}\n371\t\tif i == start || (i == start+1 && (s[start] == '-' || s[start] == '+')) {\n372\t\t\treturn 0, i\n373\t\t}\n374\t\tval, err := strconv.ParseFloat(s[start:i], 64)\n375\t\tif err != nil {\n376\t\t\treturn 0, i\n377\t\t}\n378\t\treturn val, i\n379\t}\n380\t\n381\tfunc parseNumeric(s string) float64 {\n382\t\tval, _ := parseNumericEnd(s)\n383\t\treturn val\n384\t}\n385\t\n386\tfunc parseHumanNumeric(s string) float64 {\n387\t\tval, end := parseNumericEnd(s)\n388\t\tif end < len(s) {\n389\t\t\tif m := suffixMultiplier(s[end]); m > 0 {\n390\t\t\t\treturn val * m\n391\t\t\t}\n392\t\t}\n393\t\treturn val\n394\t}\n395\t\n396\tfunc suffixMultiplier(c byte) float64 {\n397\t\tswitch c {\n398\t\tcase 'K', 'k':\n399\t\t\treturn 1 << 10\n400\t\tcase 'M':\n401\t\t\treturn 1 << 20\n402\t\tcase 'G':\n403\t\t\treturn 1 << 30\n404\t\tcase 'T':\n405\t\t\treturn 1 << 40\n406\t\tcase 'P':\n407\t\t\treturn 1 << 50\n408\t\tcase 'E':\n409\t\t\treturn 1 << 60\n410\t\tcase 'Z':\n411\t\t\treturn 1 << 70\n412\t\tcase 'Y':\n413\t\t\treturn 1 << 80\n414\t\tdefault:\n415\t\t\treturn 0\n416\t\t}\n417\t}\n418\t\n419\tfunc monthRank(s string) int {\n420\t\ti := 0\n421\t\tfor i < len(s) && (s[i] == ' ' || s[i] == '\\t') {\n422\t\t\ti++\n423\t\t}\n424\t\tend := min(i+3, len(s))\n425\t\treturn monthMap[strings.ToUpper(s[i:end])]\n426\t}\n427\t\n428\tfunc compareVersion(a, b string) int {\n429\t\tia, ib := 0, 0\n430\t\tfor ia < len(a) && ib < len(b) {\n431\t\t\tda := a[ia] >= '0' && a[ia] <= '9'\n432\t\t\tdb := b[ib] >= '0' && b[ib] <= '9'\n433\t\t\tif da && db {\n434\t\t\t\tr := cmpNumSegments(a, b, &ia, &ib)\n435\t\t\t\tif r != 0 {\n436\t\t\t\t\treturn r\n437\t\t\t\t}\n438\t\t\t\tcontinue\n439\t\t\t}\n440\t\t\tif a[ia] != b[ib] {\n441\t\t\t\treturn int(a[ia]) - int(b[ib])\n442\t\t\t}\n443\t\t\tia++\n444\t\t\tib++\n445\t\t}\n446\t\treturn len(a) - len(b)\n447\t}\n448\t\n449\tfunc cmpNumSegments(a, b string, ia, ib *int) int {\n450\t\tstartA, startB := *ia, *ib\n451\t\tfor *ia < len(a) && a[*ia] == '0' {\n452\t\t\t*ia++\n453\t\t}\n454\t\tfor *ib < len(b) && b[*ib] == '0' {\n455\t\t\t*ib++\n456\t\t}\n457\t\tsigA, sigB := *ia, *ib\n458\t\tendA := sigA\n459\t\tfor endA < len(a) && a[endA] >= '0' && a[endA] <= '9' {\n460\t\t\tendA++\n461\t\t}\n462\t\tendB := sigB\n463\t\tfor endB < len(b) && b[endB] >= '0' && b[endB] <= '9' {\n464\t\t\tendB++\n465\t\t}\n466\t\tlenA, lenB := endA-sigA, endB-sigB\n467\t\t*ia = endA\n468\t\t*ib = endB\n469\t\tif lenA != lenB {\n470\t\t\treturn lenA - lenB\n471\t\t}\n472\t\tfor k := range lenA {\n473\t\t\tif a[sigA+k] != b[sigB+k] {\n474\t\t\t\treturn int(a[sigA+k]) - int(b[sigB+k])\n475\t\t\t}\n476\t\t}\n477\t\treturn (sigB - startB) - (sigA - startA)\n478\t}\n479\t\n480\tfunc dedup(lines []string, cmp func(string, string) int) []string {\n481\t\tif len(lines) == 0 {\n482\t\t\treturn lines\n483\t\t}\n484\t\tresult := []string{lines[0]}\n485\t\tfor _, line := range lines[1:] {\n486\t\t\tif cmp(line, result[len(result)-1]) != 0 {\n487\t\t\t\tresult = append(result, line)\n488\t\t\t}\n489\t\t}\n490\t\treturn result\n491\t}\n492\t\n493\tfunc writeLines(lines []string, w io.Writer) {\n494\t\tbw := bufio.NewWriter(w)\n495\t\tfor _, line := range lines {\n496\t\t\tfmt.Fprintln(bw, line)\n497\t\t}\n498\t\tbw.Flush()\n499\t}\n500\t"}]},"parent_tool_use_id":null,"session_id":"96678a39-80a6-4d2a-941f-35cd93be42bb","uuid":"d9496ffd-23d1-4ec6-9d58-2c1a57e56f78","timestamp":"2026-05-20T22:16:57.123Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5377/cmd/sort/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"slices\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: sort [OPTION]... [FILE]...\nWrite sorted concatenation of all FILE(s) to standard output.\n\nWith no FILE, or when FILE is -, read standard input.\n\nMandatory arguments to long options are mandatory for short options too.\nOrdering options:\n\n  -h, --human-numeric-sort    compare human readable numbers (e.g., 2K 1G)\n  -M, --month-sort            compare (unknown) < 'JAN' < ... < 'DEC'\n  -n, --numeric-sort          compare according to string numerical value\n  -V, --version-sort          natural sort of (version) numbers within text\n  -r, --reverse               reverse the result of comparisons\n\nOther options:\n\n  -o, --output=FILE           write result to FILE instead of standard output\n  -s, --stable                stabilize sort by disabling last-resort comparison\n  -t, --field-separator=SEP   use SEP instead of non-blank to blank transition\n  -u, --unique                with -c, check for strict ordering;\n                                without -c, output only the first of an equal run\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `sort (go-unix-utils) dev\n`\n\ntype sortMode int\n\nconst (\n\tsortDefault sortMode = iota\n\tsortNumeric\n\tsortHumanNumeric\n\tsortMonth\n\tsortVersion\n)\n\ntype options struct {\n\treverse        bool\n\tunique         bool\n\tstable         bool\n\tmode           sortMode\n\toutputFile     string\n\tfieldSeparator string\n}\n\nvar monthMap = map[string]int{\n\t\"JAN\": 1, \"FEB\": 2, \"MAR\": 3, \"APR\": 4,\n\t\"MAY\": 5, \"JUN\": 6, \"JUL\": 7, \"AUG\": 8,\n\t\"SEP\": 9, \"OCT\": 10, \"NOV\": 11, \"DEC\": 12,\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'sort --help' for more information.\\n\")\n\t\tos.Exit(2)\n\t}\n\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\tlines, err := readAllLines(files)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\tos.Exit(2)\n\t}\n\n\tlines = sortAndFilter(lines, opts)\n\n\tvar w io.Writer = os.Stdout\n\tif opts.outputFile != \"\" {\n\t\tf, err := os.Create(opts.outputFile)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\t\tos.Exit(2)\n\t\t}\n\t\tdefer f.Close()\n\t\tw = f\n\t}\n\twriteLines(lines, w)\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar files []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, &opts, args[i+1:])\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\textra, err := parseShortFlags(arg[1:], &opts, args[i+1:])\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + extra\n\t\t\tcontinue\n\t\t}\n\t\tfiles = append(files, arg)\n\t\ti++\n\t}\n\n\treturn opts, files, nil\n}\n\nfunc parseLongFlag(flag string, opts *options, remaining []string) (int, error) {\n\tif v, ok := strings.CutPrefix(flag, \"--output=\"); ok {\n\t\topts.outputFile = v\n\t\treturn 1, nil\n\t}\n\tif v, ok := strings.CutPrefix(flag, \"--field-separator=\"); ok {\n\t\tif len(v) != 1 {\n\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", v)\n\t\t}\n\t\topts.fieldSeparator = v\n\t\treturn 1, nil\n\t}\n\tswitch flag {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase \"--reverse\":\n\t\topts.reverse = true\n\tcase \"--unique\":\n\t\topts.unique = true\n\tcase \"--stable\":\n\t\topts.stable = true\n\tcase \"--numeric-sort\":\n\t\topts.mode = sortNumeric\n\tcase \"--human-numeric-sort\":\n\t\topts.mode = sortHumanNumeric\n\tcase \"--month-sort\":\n\t\topts.mode = sortMonth\n\tcase \"--version-sort\":\n\t\topts.mode = sortVersion\n\tcase \"--output\", \"--field-separator\":\n\t\treturn parseLongWithArg(flag, opts, remaining)\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n\treturn 1, nil\n}\n\nfunc parseLongWithArg(flag string, opts *options, remaining []string) (int, error) {\n\tif len(remaining) == 0 {\n\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t}\n\tswitch flag {\n\tcase \"--output\":\n\t\topts.outputFile = remaining[0]\n\tcase \"--field-separator\":\n\t\tif len(remaining[0]) != 1 {\n\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n\t\t}\n\t\topts.fieldSeparator = remaining[0]\n\t}\n\treturn 2, nil\n}\n\nfunc parseShortFlags(flags string, opts *options, remaining []string) (int, error) {\n\tfor idx := 0; idx < len(flags); idx++ {\n\t\tswitch flags[idx] {\n\t\tcase 'r':\n\t\t\topts.reverse = true\n\t\tcase 'u':\n\t\t\topts.unique = true\n\t\tcase 's':\n\t\t\topts.stable = true\n\t\tcase 'n':\n\t\t\topts.mode = sortNumeric\n\t\tcase 'h':\n\t\t\topts.mode = sortHumanNumeric\n\t\tcase 'M':\n\t\t\topts.mode = sortMonth\n\t\tcase 'V':\n\t\t\topts.mode = sortVersion\n\t\tcase 'o':\n\t\t\trest := flags[idx+1:]\n\t\t\tif rest != \"\" {\n\t\t\t\topts.outputFile = rest\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(remaining) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'o'\")\n\t\t\t}\n\t\t\topts.outputFile = remaining[0]\n\t\t\treturn 1, nil\n\t\tcase 't':\n\t\t\treturn parseFieldSep(flags[idx+1:], remaining, opts)\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[idx])\n\t\t}\n\t}\n\treturn 0, nil\n}\n\nfunc parseFieldSep(rest string, remaining []string, opts *options) (int, error) {\n\tif rest != \"\" {\n\t\tif len(rest) != 1 {\n\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", rest)\n\t\t}\n\t\topts.fieldSeparator = rest\n\t\treturn 0, nil\n\t}\n\tif len(remaining) == 0 {\n\t\treturn 0, fmt.Errorf(\"option requires an argument -- 't'\")\n\t}\n\tif len(remaining[0]) != 1 {\n\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n\t}\n\topts.fieldSeparator = remaining[0]\n\treturn 1, nil\n}\n\nfunc readAllLines(files []string) ([]string, error) {\n\tvar lines []string\n\tfor _, file := range files {\n\t\tr, closer, err := openInput(file)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfileLines, err := readLines(r)\n\t\tif closer != nil {\n\t\t\tcloser.Close()\n\t\t}\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tlines = append(lines, fileLines...)\n\t}\n\treturn lines, nil\n}\n\nfunc openInput(name string) (io.Reader, io.Closer, error) {\n\tif name == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc readLines(r io.Reader) ([]string, error) {\n\tvar lines []string\n\tscanner := bufio.NewScanner(r)\n\tfor scanner.Scan() {\n\t\tlines = append(lines, scanner.Text())\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\treturn nil, err\n\t}\n\treturn lines, nil\n}\n\nfunc sortAndFilter(lines []string, opts options) []string {\n\tkeyCmp := buildKeyCmp(opts)\n\n\tfullCmp := keyCmp\n\tif opts.mode != sortDefault && !opts.stable {\n\t\tfullCmp = func(a, b string) int {\n\t\t\tif r := keyCmp(a, b); r != 0 {\n\t\t\t\treturn r\n\t\t\t}\n\t\t\treturn strings.Compare(a, b)\n\t\t}\n\t}\n\n\tsortCmp := fullCmp\n\tif opts.reverse {\n\t\tsortCmp = func(a, b string) int { return fullCmp(b, a) }\n\t}\n\n\tif opts.stable {\n\t\tslices.SortStableFunc(lines, sortCmp)\n\t} else {\n\t\tslices.SortFunc(lines, sortCmp)\n\t}\n\n\tif opts.unique {\n\t\tlines = dedup(lines, keyCmp)\n\t}\n\n\treturn lines\n}\n\nfunc buildKeyCmp(opts options) func(string, string) int {\n\tswitch opts.mode {\n\tcase sortHumanNumeric:\n\t\treturn cmpFloat(parseHumanNumeric)\n\tcase sortMonth:\n\t\treturn func(a, b string) int { return monthRank(a) - monthRank(b) }\n\tcase sortVersion:\n\t\treturn compareVersion\n\tcase sortNumeric:\n\t\treturn cmpFloat(parseNumeric)\n\tdefault:\n\t\treturn strings.Compare\n\t}\n}\n\nfunc cmpFloat(parse func(string) float64) func(string, string) int {\n\treturn func(a, b string) int {\n\t\tna, nb := parse(a), parse(b)\n\t\tif na < nb {\n\t\t\treturn -1\n\t\t}\n\t\tif na > nb {\n\t\t\treturn 1\n\t\t}\n\t\treturn 0\n\t}\n}\n\nfunc parseNumericEnd(s string) (float64, int) {\n\ti := 0\n\tfor i < len(s) && (s[i] == ' ' || s[i] == '\\t') {\n\t\ti++\n\t}\n\tstart := i\n\tif i < len(s) && (s[i] == '-' || s[i] == '+') {\n\t\ti++\n\t}\n\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n\t\ti++\n\t}\n\tif i < len(s) && s[i] == '.' {\n\t\ti++\n\t\tfor i < len(s) && s[i] >= '0' && s[i] <= '9' {\n\t\t\ti++\n\t\t}\n\t}\n\tif i == start || (i == start+1 && (s[start] == '-' || s[start] == '+')) {\n\t\treturn 0, i\n\t}\n\tval, err := strconv.ParseFloat(s[start:i], 64)\n\tif err != nil {\n\t\treturn 0, i\n\t}\n\treturn val, i\n}\n\nfunc parseNumeric(s string) float64 {\n\tval, _ := parseNumericEnd(s)\n\treturn val\n}\n\nfunc parseHumanNumeric(s string) float64 {\n\tval, end := parseNumericEnd(s)\n\tif end < len(s) {\n\t\tif m := suffixMultiplier(s[end]); m > 0 {\n\t\t\treturn val * m\n\t\t}\n\t}\n\treturn val\n}\n\nfunc suffixMultiplier(c byte) float64 {\n\tswitch c {\n\tcase 'K', 'k':\n\t\treturn 1 << 10\n\tcase 'M':\n\t\treturn 1 << 20\n\tcase 'G':\n\t\treturn 1 << 30\n\tcase 'T':\n\t\treturn 1 << 40\n\tcase 'P':\n\t\treturn 1 << 50\n\tcase 'E':\n\t\treturn 1 << 60\n\tcase 'Z':\n\t\treturn 1 << 70\n\tcase 'Y':\n\t\treturn 1 << 80\n\tdefault:\n\t\treturn 0\n\t}\n}\n\nfunc monthRank(s string) int {\n\ti := 0\n\tfor i < len(s) && (s[i] == ' ' || s[i] == '\\t') {\n\t\ti++\n\t}\n\tend := min(i+3, len(s))\n\treturn monthMap[strings.ToUpper(s[i:end])]\n}\n\nfunc compareVersion(a, b string) int {\n\tia, ib := 0, 0\n\tfor ia < len(a) && ib < len(b) {\n\t\tda := a[ia] >= '0' && a[ia] <= '9'\n\t\tdb := b[ib] >= '0' && b[ib] <= '9'\n\t\tif da && db {\n\t\t\tr := cmpNumSegments(a, b, &ia, &ib)\n\t\t\tif r != 0 {\n\t\t\t\treturn r\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tif a[ia] != b[ib] {\n\t\t\treturn int(a[ia]) - int(b[ib])\n\t\t}\n\t\tia++\n\t\tib++\n\t}\n\treturn len(a) - len(b)\n}\n\nfunc cmpNumSegments(a, b string, ia, ib *int) int {\n\tstartA, startB := *ia, *ib\n\tfor *ia < len(a) && a[*ia] == '0' {\n\t\t*ia++\n\t}\n\tfor *ib < len(b) && b[*ib] == '0' {\n\t\t*ib++\n\t}\n\tsigA, sigB := *ia, *ib\n\tendA := sigA\n\tfor endA < len(a) && a[endA] >= '0' && a[endA] <= '9' {\n\t\tendA++\n\t}\n\tendB := sigB\n\tfor endB < len(b) && b[endB] >= '0' && b[endB] <= '9' {\n\t\tendB++\n\t}\n\tlenA, lenB := endA-sigA, endB-sigB\n\t*ia = endA\n\t*ib = endB\n\tif lenA != lenB {\n\t\treturn lenA - lenB\n\t}\n\tfor k := range lenA {\n\t\tif a[sigA+k] != b[sigB+k] {\n\t\t\treturn int(a[sigA+k]) - int(b[sigB+k])\n\t\t}\n\t}\n\treturn (sigB - startB) - (sigA - startA)\n}\n\nfunc dedup(lines []string, cmp func(string, string) int) []string {\n\tif len(lines) == 0 {\n\t\treturn lines\n\t}\n\tresult := []string{lines[0]}\n\tfor _, line := range lines[1:] {\n\t\tif cmp(line, result[len(result)-1]) != 0 {\n\t\t\tresult = append(result, line)\n\t\t}\n\t}\n\treturn result\n}\n\nfunc writeLines(lines []string, w io.Writer) {\n\tbw := bufio.NewWriter(w)\n\tfor _, line := range lines {\n\t\tfmt.Fprintln(bw, line)\n\t}\n\tbw.Flush()\n}\n","numLines":500,"startLine":1,"totalLines":500}}}
