{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017QtGDFAFrvh7KJ6ainQAPn","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→package testutils\n     5→\n     6→import (\n     7→\t\"bytes\"\n     8→\t\"context\"\n     9→\t\"fmt\"\n    10→\t\"os\"\n    11→\t\"os/exec\"\n    12→\t\"path/filepath\"\n    13→\t\"testing\"\n    14→\t\"time\"\n    15→)\n    16→\n    17→// defaultTimeout is the maximum duration for a single binary invocation.\n    18→// Per prd001-testutils R2.3.\n    19→const defaultTimeout = 10 * time.Second\n    20→\n    21→// stdinTruncateLen is the maximum number of stdin bytes shown in failure messages.\n    22→// Per prd001-testutils R3.5.\n    23→const stdinTruncateLen = 256\n    24→\n    25→// FileExpectation describes an expected file state after binary execution. This\n    26→// supports utilities whose primary output is a file rather than stdout (sponge,\n    27→// cp, mv).\n    28→//\n    29→// Per prd001-testutils R5.1.\n    30→type FileExpectation struct {\n    31→\t// Path is the file path to check after execution. When relative, it is\n    32→\t// resolved against the test working directory.\n    33→\tPath string\n    34→\n    35→\t// Content is the expected byte-for-byte content of the file.\n    36→\tContent []byte\n    37→}\n    38→\n    39→// DiffTest defines a single differential test case. A cmd/ package defines a\n    40→// []DiffTest slice and calls RunDiffTests from a standard TestXxx function.\n    41→//\n    42→// Per prd001-testutils R1.1-R1.4.\n    43→type DiffTest struct {\n    44→\t// Name identifies this test case in go test output via t.Run.\n    45→\t// Per prd001-testutils R3.6.\n    46→\tName string\n    47→\n    48→\t// Args is the command-line arguments passed to both binaries.\n    49→\tArgs []string\n    50→\n    51→\t// Stdin is the bytes fed to both binaries on stdin. When nil, the binary\n    52→\t// receives no stdin input (EOF immediately). Per prd001-testutils R1.2.\n    53→\tStdin []byte\n    54→\n    55→\t// Env is the environment variable overrides for both binaries. When nil,\n    56→\t// both binaries inherit the test process environment. Per prd001-testutils R1.3.\n    57→\tEnv []string\n    58→\n    59→\t// Normalize is a slice of NormalizeFunc applied in order to both stdout and\n    60→\t// stderr before comparison. When nil or empty, no normalization is applied.\n    61→\t// Per prd001-testutils R1.4 and R4.3.\n    62→\tNormalize []NormalizeFunc\n    63→\n    64→\t// Timeout overrides the default 10-second timeout for this test case.\n    65→\t// When zero, the default timeout is used. Per prd001-testutils R2.3.\n    66→\tTimeout time.Duration\n    67→\n    68→\t// WorkDir sets the working directory for both binary invocations. When\n    69→\t// empty, a per-test temporary directory is used. Per prd001-testutils R2.5.\n    70→\tWorkDir string\n    71→\n    72→\t// FileExpectations lists files whose content should be compared after\n    73→\t// execution. Per prd001-testutils R5.1.\n    74→\tFileExpectations []FileExpectation\n    75→}\n    76→\n    77→// binResult holds the captured output from a single binary execution.\n    78→type binResult struct {\n    79→\tstdout   []byte\n    80→\tstderr   []byte\n    81→\texitCode int\n    82→}\n    83→\n    84→// RunDiffTests executes each DiffTest by running both the Go binary and the GNU\n    85→// reference binary with identical inputs, then comparing their outputs. Each test\n    86→// case runs as a named subtest.\n    87→//\n    88→// Per prd001-testutils AC1: a cmd/ package calls RunDiffTests(t, goBinary,\n    89→// refBinary, tests) with no other setup.\n    90→func RunDiffTests(t *testing.T, goBinary string, refBinary string, tests []DiffTest) {\n    91→\tt.Helper()\n    92→\tfor _, tc := range tests {\n    93→\t\tt.Run(tc.Name, func(t *testing.T) {\n    94→\t\t\tt.Helper()\n    95→\t\t\trunSingleDiffTest(t, goBinary, refBinary, tc)\n    96→\t\t})\n    97→\t}\n    98→}\n    99→\n   100→// runSingleDiffTest runs one DiffTest case, executing both binaries and comparing\n   101→// their outputs.\n   102→func runSingleDiffTest(t *testing.T, goBinary string, refBinary string, tc DiffTest) {\n   103→\tt.Helper()\n   104→\n   105→\tworkDir := tc.WorkDir\n   106→\tif workDir == \"\" {\n   107→\t\tworkDir = t.TempDir()\n   108→\t}\n   109→\n   110→\ttimeout := tc.Timeout\n   111→\tif timeout == 0 {\n   112→\t\ttimeout = defaultTimeout\n   113→\t}\n   114→\n   115→\t// Execute both binaries. Per prd001-testutils R2.1.\n   116→\tgoResult, err := executeBinary(goBinary, tc.Args, tc.Stdin, tc.Env, workDir, timeout)\n   117→\tif err != nil {\n   118→\t\tt.Fatalf(\"executing Go binary %s: %v\", goBinary, err)\n   119→\t}\n   120→\n   121→\trefResult, err := executeBinary(refBinary, tc.Args, tc.Stdin, tc.Env, workDir, timeout)\n   122→\tif err != nil {\n   123→\t\tt.Fatalf(\"executing reference binary %s: %v\", refBinary, err)\n   124→\t}\n   125→\n   126→\t// Apply normalization. Per prd001-testutils R3.1.\n   127→\tnormalize := ComposeNormalizers(tc.Normalize)\n   128→\n   129→\tgoStdout := normalize(goResult.stdout)\n   130→\tgoStderr := normalize(goResult.stderr)\n   131→\trefStdout := normalize(refResult.stdout)\n   132→\trefStderr := normalize(refResult.stderr)\n   133→\n   134→\t// Compare and report. Per prd001-testutils R3.2-R3.5.\n   135→\tfailed := false\n   136→\n   137→\tif !bytes.Equal(refStdout, goStdout) {\n   138→\t\tfailed = true\n   139→\t\tt.Errorf(\"stdout divergence\")\n   140→\t}\n   141→\n   142→\tif !bytes.Equal(refStderr, goStderr) {\n   143→\t\tfailed = true\n   144→\t\tt.Errorf(\"stderr divergence\")\n   145→\t}\n   146→\n   147→\tif refResult.exitCode != goResult.exitCode {\n   148→\t\tfailed = true\n   149→\t\tt.Errorf(\"exit code divergence: reference=%d, go=%d\", refResult.exitCode, goResult.exitCode)\n   150→\t}\n   151→\n   152→\tif failed {\n   153→\t\tt.Errorf(\"%s\", formatDivergenceReport(tc, refResult, goResult, refStdout, goStdout, refStderr, goStderr))\n   154→\t}\n   155→\n   156→\t// File-state comparison. Per prd001-testutils R5.1-R5.2.\n   157→\tfor _, fe := range tc.FileExpectations {\n   158→\t\tfilePath := fe.Path\n   159→\t\tif !filepath.IsAbs(filePath) {\n   160→\t\t\tfilePath = filepath.Join(workDir, filePath)\n   161→\t\t}\n   162→\n   163→\t\tactual, err := os.ReadFile(filePath)\n   164→\t\tif err != nil {\n   165→\t\t\tt.Errorf(\"reading expected file %s: %v\", fe.Path, err)\n   166→\t\t\tcontinue\n   167→\t\t}\n   168→\n   169→\t\tif !bytes.Equal(fe.Content, actual) {\n   170→\t\t\tt.Errorf(\"file content divergence for %s:\\n  expected (%d bytes): %s\\n  actual   (%d bytes): %s\",\n   171→\t\t\t\tfe.Path,\n   172→\t\t\t\tlen(fe.Content), truncateBytes(fe.Content, stdinTruncateLen),\n   173→\t\t\t\tlen(actual), truncateBytes(actual, stdinTruncateLen),\n   174→\t\t\t)\n   175→\t\t}\n   176→\t}\n   177→}\n   178→\n   179→// executeBinary runs a single binary with the given args, stdin, environment, and\n   180→// working directory under a timeout. It captures stdout, stderr, and exit code.\n   181→//\n   182→// Per prd001-testutils R2.1-R2.5.\n   183→func executeBinary(binary string, args []string, stdin []byte, env []string, workDir string, timeout time.Duration) (*binResult, error) {\n   184→\tctx, cancel := context.WithTimeout(context.Background(), timeout)\n   185→\tdefer cancel()\n   186→\n   187→\tcmd := exec.CommandContext(ctx, binary, args...)\n   188→\tcmd.Dir = workDir\n   189→\n   190→\tif env != nil {\n   191→\t\tcmd.Env = append(os.Environ(), env...)\n   192→\t}\n   193→\n   194→\tif stdin != nil {\n   195→\t\tcmd.Stdin = bytes.NewReader(stdin)\n   196→\t}\n   197→\n   198→\tvar stdoutBuf, stderrBuf bytes.Buffer\n   199→\tcmd.Stdout = &stdoutBuf\n   200→\tcmd.Stderr = &stderrBuf\n   201→\n   202→\terr := cmd.Run()\n   203→\n   204→\t// Check for timeout. Per prd001-testutils R2.3 and AC5.\n   205→\tif ctx.Err() == context.DeadlineExceeded {\n   206→\t\treturn nil, fmt.Errorf(\"binary %s exceeded %v timeout\", binary, timeout)\n   207→\t}\n   208→\n   209→\texitCode := 0\n   210→\tif err != nil {\n   211→\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n   212→\t\t\texitCode = exitErr.ExitCode()\n   213→\t\t} else {\n   214→\t\t\treturn nil, fmt.Errorf(\"running binary %s: %w\", binary, err)\n   215→\t\t}\n   216→\t}\n   217→\n   218→\treturn &binResult{\n   219→\t\tstdout:   stdoutBuf.Bytes(),\n   220→\t\tstderr:   stderrBuf.Bytes(),\n   221→\t\texitCode: exitCode,\n   222→\t}, nil\n   223→}\n   224→\n   225→// formatDivergenceReport builds the failure message with all context needed to\n   226→// diagnose the divergence.\n   227→//\n   228→// Per prd001-testutils R3.5.\n   229→func formatDivergenceReport(tc DiffTest, ref *binResult, goRes *binResult, refStdoutNorm []byte, goStdoutNorm []byte, refStderrNorm []byte, goStderrNorm []byte) string {\n   230→\tvar buf bytes.Buffer\n   231→\tfmt.Fprintf(&buf, \"\\n--- Divergence Report ---\\n\")\n   232→\tfmt.Fprintf(&buf, \"Args: %v\\n\", tc.Args)\n   233→\tfmt.Fprintf(&buf, \"Stdin (%d bytes): %s\\n\", len(tc.Stdin), truncateBytes(tc.Stdin, stdinTruncateLen))\n   234→\tfmt.Fprintf(&buf, \"Reference exit code: %d\\n\", ref.exitCode)\n   235→\tfmt.Fprintf(&buf, \"Go        exit code: %d\\n\", goRes.exitCode)\n   236→\tfmt.Fprintf(&buf, \"Reference stdout (normalized):\\n%s\\n\", refStdoutNorm)\n   237→\tfmt.Fprintf(&buf, \"Go        stdout (normalized):\\n%s\\n\", goStdoutNorm)\n   238→\tfmt.Fprintf(&buf, \"Reference stderr (normalized):\\n%s\\n\", refStderrNorm)\n   239→\tfmt.Fprintf(&buf, \"Go        stderr (normalized):\\n%s\\n\", goStderrNorm)\n   240→\treturn buf.String()\n   241→}\n   242→\n   243→// truncateBytes returns a string representation of b, truncated to maxLen bytes\n   244→// with an ellipsis suffix if truncated.\n   245→func truncateBytes(b []byte, maxLen int) string {\n   246→\tif len(b) <= maxLen {\n   247→\t\treturn string(b)\n   248→\t}\n   249→\treturn string(b[:maxLen]) + \"...\"\n   250→}\n   251→"}]},"parent_tool_use_id":null,"session_id":"67b50bca-6f65-43a4-b4fa-2734b1eda8ae","uuid":"c865c863-a36c-44b8-9288-29b4f6950fc1","tool_use_result":{"type":"text","file":{"filePath":"/var/folders/k1/vt4zxn952wv_8xjqtntq1ycr0000gn/T/go-unix-utils-worktrees/generation-2026-02-25-08-44-27-tyr/pkg/testutils/difftest.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n)\n\n// defaultTimeout is the maximum duration for a single binary invocation.\n// Per prd001-testutils R2.3.\nconst defaultTimeout = 10 * time.Second\n\n// stdinTruncateLen is the maximum number of stdin bytes shown in failure messages.\n// Per prd001-testutils R3.5.\nconst stdinTruncateLen = 256\n\n// FileExpectation describes an expected file state after binary execution. This\n// supports utilities whose primary output is a file rather than stdout (sponge,\n// cp, mv).\n//\n// Per prd001-testutils R5.1.\ntype FileExpectation struct {\n\t// Path is the file path to check after execution. When relative, it is\n\t// resolved against the test working directory.\n\tPath string\n\n\t// Content is the expected byte-for-byte content of the file.\n\tContent []byte\n}\n\n// DiffTest defines a single differential test case. A cmd/ package defines a\n// []DiffTest slice and calls RunDiffTests from a standard TestXxx function.\n//\n// Per prd001-testutils R1.1-R1.4.\ntype DiffTest struct {\n\t// Name identifies this test case in go test output via t.Run.\n\t// Per prd001-testutils R3.6.\n\tName string\n\n\t// Args is the command-line arguments passed to both binaries.\n\tArgs []string\n\n\t// Stdin is the bytes fed to both binaries on stdin. When nil, the binary\n\t// receives no stdin input (EOF immediately). Per prd001-testutils R1.2.\n\tStdin []byte\n\n\t// Env is the environment variable overrides for both binaries. When nil,\n\t// both binaries inherit the test process environment. Per prd001-testutils R1.3.\n\tEnv []string\n\n\t// Normalize is a slice of NormalizeFunc applied in order to both stdout and\n\t// stderr before comparison. When nil or empty, no normalization is applied.\n\t// Per prd001-testutils R1.4 and R4.3.\n\tNormalize []NormalizeFunc\n\n\t// Timeout overrides the default 10-second timeout for this test case.\n\t// When zero, the default timeout is used. Per prd001-testutils R2.3.\n\tTimeout time.Duration\n\n\t// WorkDir sets the working directory for both binary invocations. When\n\t// empty, a per-test temporary directory is used. Per prd001-testutils R2.5.\n\tWorkDir string\n\n\t// FileExpectations lists files whose content should be compared after\n\t// execution. Per prd001-testutils R5.1.\n\tFileExpectations []FileExpectation\n}\n\n// binResult holds the captured output from a single binary execution.\ntype binResult struct {\n\tstdout   []byte\n\tstderr   []byte\n\texitCode int\n}\n\n// RunDiffTests executes each DiffTest by running both the Go binary and the GNU\n// reference binary with identical inputs, then comparing their outputs. Each test\n// case runs as a named subtest.\n//\n// Per prd001-testutils AC1: a cmd/ package calls RunDiffTests(t, goBinary,\n// refBinary, tests) with no other setup.\nfunc RunDiffTests(t *testing.T, goBinary string, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\tt.Helper()\n\t\t\trunSingleDiffTest(t, goBinary, refBinary, tc)\n\t\t})\n\t}\n}\n\n// runSingleDiffTest runs one DiffTest case, executing both binaries and comparing\n// their outputs.\nfunc runSingleDiffTest(t *testing.T, goBinary string, refBinary string, tc DiffTest) {\n\tt.Helper()\n\n\tworkDir := tc.WorkDir\n\tif workDir == \"\" {\n\t\tworkDir = t.TempDir()\n\t}\n\n\ttimeout := tc.Timeout\n\tif timeout == 0 {\n\t\ttimeout = defaultTimeout\n\t}\n\n\t// Execute both binaries. Per prd001-testutils R2.1.\n\tgoResult, err := executeBinary(goBinary, tc.Args, tc.Stdin, tc.Env, workDir, timeout)\n\tif err != nil {\n\t\tt.Fatalf(\"executing Go binary %s: %v\", goBinary, err)\n\t}\n\n\trefResult, err := executeBinary(refBinary, tc.Args, tc.Stdin, tc.Env, workDir, timeout)\n\tif err != nil {\n\t\tt.Fatalf(\"executing reference binary %s: %v\", refBinary, err)\n\t}\n\n\t// Apply normalization. Per prd001-testutils R3.1.\n\tnormalize := ComposeNormalizers(tc.Normalize)\n\n\tgoStdout := normalize(goResult.stdout)\n\tgoStderr := normalize(goResult.stderr)\n\trefStdout := normalize(refResult.stdout)\n\trefStderr := normalize(refResult.stderr)\n\n\t// Compare and report. Per prd001-testutils R3.2-R3.5.\n\tfailed := false\n\n\tif !bytes.Equal(refStdout, goStdout) {\n\t\tfailed = true\n\t\tt.Errorf(\"stdout divergence\")\n\t}\n\n\tif !bytes.Equal(refStderr, goStderr) {\n\t\tfailed = true\n\t\tt.Errorf(\"stderr divergence\")\n\t}\n\n\tif refResult.exitCode != goResult.exitCode {\n\t\tfailed = true\n\t\tt.Errorf(\"exit code divergence: reference=%d, go=%d\", refResult.exitCode, goResult.exitCode)\n\t}\n\n\tif failed {\n\t\tt.Errorf(\"%s\", formatDivergenceReport(tc, refResult, goResult, refStdout, goStdout, refStderr, goStderr))\n\t}\n\n\t// File-state comparison. Per prd001-testutils R5.1-R5.2.\n\tfor _, fe := range tc.FileExpectations {\n\t\tfilePath := fe.Path\n\t\tif !filepath.IsAbs(filePath) {\n\t\t\tfilePath = filepath.Join(workDir, filePath)\n\t\t}\n\n\t\tactual, err := os.ReadFile(filePath)\n\t\tif err != nil {\n\t\t\tt.Errorf(\"reading expected file %s: %v\", fe.Path, err)\n\t\t\tcontinue\n\t\t}\n\n\t\tif !bytes.Equal(fe.Content, actual) {\n\t\t\tt.Errorf(\"file content divergence for %s:\\n  expected (%d bytes): %s\\n  actual   (%d bytes): %s\",\n\t\t\t\tfe.Path,\n\t\t\t\tlen(fe.Content), truncateBytes(fe.Content, stdinTruncateLen),\n\t\t\t\tlen(actual), truncateBytes(actual, stdinTruncateLen),\n\t\t\t)\n\t\t}\n\t}\n}\n\n// executeBinary runs a single binary with the given args, stdin, environment, and\n// working directory under a timeout. It captures stdout, stderr, and exit code.\n//\n// Per prd001-testutils R2.1-R2.5.\nfunc executeBinary(binary string, args []string, stdin []byte, env []string, workDir string, timeout time.Duration) (*binResult, error) {\n\tctx, cancel := context.WithTimeout(context.Background(), timeout)\n\tdefer cancel()\n\n\tcmd := exec.CommandContext(ctx, binary, args...)\n\tcmd.Dir = workDir\n\n\tif env != nil {\n\t\tcmd.Env = append(os.Environ(), env...)\n\t}\n\n\tif stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(stdin)\n\t}\n\n\tvar stdoutBuf, stderrBuf bytes.Buffer\n\tcmd.Stdout = &stdoutBuf\n\tcmd.Stderr = &stderrBuf\n\n\terr := cmd.Run()\n\n\t// Check for timeout. Per prd001-testutils R2.3 and AC5.\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\treturn nil, fmt.Errorf(\"binary %s exceeded %v timeout\", binary, timeout)\n\t}\n\n\texitCode := 0\n\tif err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\texitCode = exitErr.ExitCode()\n\t\t} else {\n\t\t\treturn nil, fmt.Errorf(\"running binary %s: %w\", binary, err)\n\t\t}\n\t}\n\n\treturn &binResult{\n\t\tstdout:   stdoutBuf.Bytes(),\n\t\tstderr:   stderrBuf.Bytes(),\n\t\texitCode: exitCode,\n\t}, nil\n}\n\n// formatDivergenceReport builds the failure message with all context needed to\n// diagnose the divergence.\n//\n// Per prd001-testutils R3.5.\nfunc formatDivergenceReport(tc DiffTest, ref *binResult, goRes *binResult, refStdoutNorm []byte, goStdoutNorm []byte, refStderrNorm []byte, goStderrNorm []byte) string {\n\tvar buf bytes.Buffer\n\tfmt.Fprintf(&buf, \"\\n--- Divergence Report ---\\n\")\n\tfmt.Fprintf(&buf, \"Args: %v\\n\", tc.Args)\n\tfmt.Fprintf(&buf, \"Stdin (%d bytes): %s\\n\", len(tc.Stdin), truncateBytes(tc.Stdin, stdinTruncateLen))\n\tfmt.Fprintf(&buf, \"Reference exit code: %d\\n\", ref.exitCode)\n\tfmt.Fprintf(&buf, \"Go        exit code: %d\\n\", goRes.exitCode)\n\tfmt.Fprintf(&buf, \"Reference stdout (normalized):\\n%s\\n\", refStdoutNorm)\n\tfmt.Fprintf(&buf, \"Go        stdout (normalized):\\n%s\\n\", goStdoutNorm)\n\tfmt.Fprintf(&buf, \"Reference stderr (normalized):\\n%s\\n\", refStderrNorm)\n\tfmt.Fprintf(&buf, \"Go        stderr (normalized):\\n%s\\n\", goStderrNorm)\n\treturn buf.String()\n}\n\n// truncateBytes returns a string representation of b, truncated to maxLen bytes\n// with an ellipsis suffix if truncated.\nfunc truncateBytes(b []byte, maxLen int) string {\n\tif len(b) <= maxLen {\n\t\treturn string(b)\n\t}\n\treturn string(b[:maxLen]) + \"...\"\n}\n","numLines":251,"startLine":1,"totalLines":251}}}
