{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013GYkiV4pRyo4Pwmkb4fWoE","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd071-numfmt R1.1-R1.4, R2.1-R2.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"flag\"\n10\t\t\"fmt\"\n11\t\t\"math\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tvar (\n20\t\tsiSuffixes   = []string{\"\", \"k\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n21\t\tiecSuffixes  = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n22\t\tieciSuffixes = []string{\"\", \"Ki\", \"Mi\", \"Gi\", \"Ti\", \"Pi\", \"Ei\"}\n23\t)\n24\t\n25\ttype opts struct {\n26\t\tfromUnit string\n27\t\ttoUnit   string\n28\t\tformat   string\n29\t\tpadding  int\n30\t\tround    string\n31\t\tsuffix   string\n32\t}\n33\t\n34\ttype fmtSpec struct {\n35\t\tleftAlign bool\n36\t\twidth     int\n37\t\tprec      int\n38\t}\n39\t\n40\tfunc main() {\n41\t\tsys.InstallSIGPIPEHandler()\n42\t\ttoUnit := flag.String(\"to\", \"none\", \"\")\n43\t\tfromUnit := flag.String(\"from\", \"none\", \"\")\n44\t\tformat := flag.String(\"format\", \"\", \"\")\n45\t\tpadding := flag.Int(\"padding\", 0, \"\")\n46\t\tround := flag.String(\"round\", \"from-zero\", \"\")\n47\t\tsuffix := flag.String(\"suffix\", \"\", \"\")\n48\t\tflag.Parse()\n49\t\tif !isValidUnit(*toUnit) || !isValidUnit(*fromUnit) {\n50\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: invalid unit\\n\")\n51\t\t\tos.Exit(1)\n52\t\t}\n53\t\tif !isValidRound(*round) {\n54\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: invalid --round method: '%s'\\n\", *round)\n55\t\t\tos.Exit(1)\n56\t\t}\n57\t\to := opts{fromUnit: *fromUnit, toUnit: *toUnit, format: *format, padding: *padding, round: *round, suffix: *suffix}\n58\t\thasError := false\n59\t\tif flag.NArg() > 0 {\n60\t\t\tfor _, arg := range flag.Args() {\n61\t\t\t\tif err := processToken(arg, o); err != nil {\n62\t\t\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: %v\\n\", err)\n63\t\t\t\t\thasError = true\n64\t\t\t\t}\n65\t\t\t}\n66\t\t} else {\n67\t\t\tscanner := bufio.NewScanner(os.Stdin)\n68\t\t\tfor scanner.Scan() {\n69\t\t\t\tif err := processLine(scanner.Text(), o); err != nil {\n70\t\t\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: %v\\n\", err)\n71\t\t\t\t\thasError = true\n72\t\t\t\t}\n73\t\t\t}\n74\t\t}\n75\t\tif hasError {\n76\t\t\tos.Exit(2)\n77\t\t}\n78\t}\n79\t\n80\tfunc isValidUnit(u string) bool {\n81\t\tswitch u {\n82\t\tcase \"none\", \"si\", \"iec\", \"iec-i\":\n83\t\t\treturn true\n84\t\t}\n85\t\treturn false\n86\t}\n87\t\n88\tfunc isValidRound(r string) bool {\n89\t\tswitch r {\n90\t\tcase \"up\", \"down\", \"from-zero\", \"towards-zero\", \"nearest\":\n91\t\t\treturn true\n92\t\t}\n93\t\treturn false\n94\t}\n95\t\n96\tfunc processLine(line string, o opts) error {\n97\t\tprefix, token, trailing := splitWhitespace(line)\n98\t\tif token == \"\" {\n99\t\t\treturn fmt.Errorf(\"invalid number: %q\", \"\")\n100\t\t}\n101\t\tval, err := parseNumber(token, o.fromUnit)\n102\t\tif err != nil {\n103\t\t\treturn err\n104\t\t}\n105\t\tout := formatOutput(val, o)\n106\t\tif prefix != \"\" {\n107\t\t\tfieldWidth := len(prefix) + len(token)\n108\t\t\tif len(out) < fieldWidth {\n109\t\t\t\tout = strings.Repeat(\" \", fieldWidth-len(out)) + out\n110\t\t\t}\n111\t\t}\n112\t\tfmt.Printf(\"%s%s\\n\", out, trailing)\n113\t\treturn nil\n114\t}\n115\t\n116\tfunc processToken(token string, o opts) error {\n117\t\tval, err := parseNumber(token, o.fromUnit)\n118\t\tif err != nil {\n119\t\t\treturn err\n120\t\t}\n121\t\tfmt.Println(formatOutput(val, o))\n122\t\treturn nil\n123\t}\n124\t\n125\tfunc formatOutput(val float64, o opts) string {\n126\t\tspec := parseFmtSpec(o.format)\n127\t\tout := formatNumber(val, o.toUnit, o.round, spec.prec)\n128\t\tout += o.suffix\n129\t\twidth := spec.width\n130\t\tleftAlign := spec.leftAlign\n131\t\tif o.padding != 0 {\n132\t\t\tpw := o.padding\n133\t\t\tif pw < 0 {\n134\t\t\t\tleftAlign = true\n135\t\t\t\tpw = -pw\n136\t\t\t}\n137\t\t\tif pw > width {\n138\t\t\t\twidth = pw\n139\t\t\t}\n140\t\t}\n141\t\tif width > 0 && len(out) < width {\n142\t\t\tout = padString(out, width, leftAlign)\n143\t\t}\n144\t\treturn out\n145\t}\n146\t\n147\tfunc parseFmtSpec(format string) fmtSpec {\n148\t\tspec := fmtSpec{prec: -1}\n149\t\tidx := strings.IndexByte(format, '%')\n150\t\tif idx < 0 {\n151\t\t\treturn spec\n152\t\t}\n153\t\ts := format[idx+1:]\n154\t\tfor len(s) > 0 && (s[0] == '-' || s[0] == '+' || s[0] == '\\'' || s[0] == ' ') {\n155\t\t\tif s[0] == '-' {\n156\t\t\t\tspec.leftAlign = true\n157\t\t\t}\n158\t\t\ts = s[1:]\n159\t\t}\n160\t\tfor len(s) > 0 && s[0] >= '0' && s[0] <= '9' {\n161\t\t\tspec.width = spec.width*10 + int(s[0]-'0')\n162\t\t\ts = s[1:]\n163\t\t}\n164\t\tif len(s) > 0 && s[0] == '.' {\n165\t\t\ts = s[1:]\n166\t\t\tspec.prec = 0\n167\t\t\tfor len(s) > 0 && s[0] >= '0' && s[0] <= '9' {\n168\t\t\t\tspec.prec = spec.prec*10 + int(s[0]-'0')\n169\t\t\t\ts = s[1:]\n170\t\t\t}\n171\t\t}\n172\t\treturn spec\n173\t}\n174\t\n175\tfunc padString(s string, width int, leftAlign bool) string {\n176\t\tpad := width - len(s)\n177\t\tif pad <= 0 {\n178\t\t\treturn s\n179\t\t}\n180\t\tspaces := strings.Repeat(\" \", pad)\n181\t\tif leftAlign {\n182\t\t\treturn s + spaces\n183\t\t}\n184\t\treturn spaces + s\n185\t}\n186\t\n187\tfunc splitWhitespace(s string) (prefix, body, suffix string) {\n188\t\ttrimLeft := strings.TrimLeft(s, \" \\t\")\n189\t\tprefix = s[:len(s)-len(trimLeft)]\n190\t\ttrimRight := strings.TrimRight(trimLeft, \" \\t\")\n191\t\tsuffix = trimLeft[len(trimRight):]\n192\t\tbody = trimRight\n193\t\treturn\n194\t}\n195\t\n196\tfunc parseNumber(s, unit string) (float64, error) {\n197\t\tif unit == \"none\" {\n198\t\t\tval, err := strconv.ParseFloat(s, 64)\n199\t\t\tif err != nil {\n200\t\t\t\tif hasSuffix(s) {\n201\t\t\t\t\treturn 0, fmt.Errorf(\n202\t\t\t\t\t\t\"rejecting suffix in input: '%s' (consider using --from)\", s)\n203\t\t\t\t}\n204\t\t\t\treturn 0, fmt.Errorf(\"invalid number: '%s'\", s)\n205\t\t\t}\n206\t\t\treturn val, nil\n207\t\t}\n208\t\tnumStr, mult, err := extractSuffix(s, unit)\n209\t\tif err != nil {\n210\t\t\treturn 0, err\n211\t\t}\n212\t\tval, err := strconv.ParseFloat(numStr, 64)\n213\t\tif err != nil {\n214\t\t\treturn 0, fmt.Errorf(\"invalid number: '%s'\", s)\n215\t\t}\n216\t\treturn val * mult, nil\n217\t}\n218\t\n219\tfunc hasSuffix(s string) bool {\n220\t\tif len(s) == 0 {\n221\t\t\treturn false\n222\t\t}\n223\t\tif len(s) >= 2 {\n224\t\t\ttail := s[len(s)-2:]\n225\t\t\tswitch tail {\n226\t\t\tcase \"Ki\", \"Mi\", \"Gi\", \"Ti\", \"Pi\", \"Ei\":\n227\t\t\t\treturn true\n228\t\t\t}\n229\t\t}\n230\t\tswitch s[len(s)-1] {\n231\t\tcase 'K', 'k', 'M', 'G', 'T', 'P', 'E':\n232\t\t\treturn true\n233\t\t}\n234\t\treturn false\n235\t}\n236\t\n237\tfunc extractSuffix(s, unit string) (string, float64, error) {\n238\t\tif len(s) == 0 {\n239\t\t\treturn \"\", 0, fmt.Errorf(\"invalid number: ''\")\n240\t\t}\n241\t\tbase := baseForUnit(unit)\n242\t\tsuffixMap := suffixMultipliers(unit, base)\n243\t\tif unit == \"iec-i\" && len(s) >= 2 {\n244\t\t\ttail := s[len(s)-2:]\n245\t\t\tif m, ok := suffixMap[tail]; ok {\n246\t\t\t\treturn s[:len(s)-2], m, nil\n247\t\t\t}\n248\t\t}\n249\t\ttail := s[len(s)-1:]\n250\t\tif m, ok := suffixMap[tail]; ok {\n251\t\t\treturn s[:len(s)-1], m, nil\n252\t\t}\n253\t\tif endsWithLetter(s) {\n254\t\t\treturn \"\", 0, fmt.Errorf(\"invalid suffix in input: '%s'\", s)\n255\t\t}\n256\t\treturn s, 1, nil\n257\t}\n258\t\n259\tfunc endsWithLetter(s string) bool {\n260\t\tif len(s) == 0 {\n261\t\t\treturn false\n262\t\t}\n263\t\tc := s[len(s)-1]\n264\t\treturn (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')\n265\t}\n266\t\n267\tfunc baseForUnit(unit string) float64 {\n268\t\tif unit == \"si\" {\n269\t\t\treturn 1000\n270\t\t}\n271\t\treturn 1024\n272\t}\n273\t\n274\tfunc suffixMultipliers(unit string, base float64) map[string]float64 {\n275\t\tm := make(map[string]float64)\n276\t\tswitch unit {\n277\t\tcase \"si\":\n278\t\t\tm[\"K\"] = base\n279\t\t\tm[\"k\"] = base\n280\t\t\tm[\"M\"] = math.Pow(base, 2)\n281\t\t\tm[\"G\"] = math.Pow(base, 3)\n282\t\t\tm[\"T\"] = math.Pow(base, 4)\n283\t\t\tm[\"P\"] = math.Pow(base, 5)\n284\t\t\tm[\"E\"] = math.Pow(base, 6)\n285\t\tcase \"iec\":\n286\t\t\tm[\"K\"] = base\n287\t\t\tm[\"M\"] = math.Pow(base, 2)\n288\t\t\tm[\"G\"] = math.Pow(base, 3)\n289\t\t\tm[\"T\"] = math.Pow(base, 4)\n290\t\t\tm[\"P\"] = math.Pow(base, 5)\n291\t\t\tm[\"E\"] = math.Pow(base, 6)\n292\t\tcase \"iec-i\":\n293\t\t\tm[\"Ki\"] = base\n294\t\t\tm[\"Mi\"] = math.Pow(base, 2)\n295\t\t\tm[\"Gi\"] = math.Pow(base, 3)\n296\t\t\tm[\"Ti\"] = math.Pow(base, 4)\n297\t\t\tm[\"Pi\"] = math.Pow(base, 5)\n298\t\t\tm[\"Ei\"] = math.Pow(base, 6)\n299\t\t}\n300\t\treturn m\n301\t}\n302\t\n303\tfunc formatNumber(val float64, unit, round string, prec int) string {\n304\t\tif unit == \"none\" {\n305\t\t\treturn formatValPrec(val, prec)\n306\t\t}\n307\t\tbase := baseForUnit(unit)\n308\t\tsuffixes := suffixesForUnit(unit)\n309\t\treturn formatWithSuffix(val, base, suffixes, round, prec)\n310\t}\n311\t\n312\tfunc formatRaw(val float64) string {\n313\t\tif val == math.Trunc(val) && !math.IsInf(val, 0) {\n314\t\t\treturn strconv.FormatInt(int64(val), 10)\n315\t\t}\n316\t\treturn strconv.FormatFloat(val, 'f', -1, 64)\n317\t}\n318\t\n319\tfunc formatValPrec(val float64, prec int) string {\n320\t\tif prec >= 0 {\n321\t\t\treturn strconv.FormatFloat(val, 'f', prec, 64)\n322\t\t}\n323\t\treturn formatRaw(val)\n324\t}\n325\t\n326\tfunc suffixesForUnit(unit string) []string {\n327\t\tswitch unit {\n328\t\tcase \"si\":\n329\t\t\treturn siSuffixes\n330\t\tcase \"iec\":\n331\t\t\treturn iecSuffixes\n332\t\tcase \"iec-i\":\n333\t\t\treturn ieciSuffixes\n334\t\t}\n335\t\treturn nil\n336\t}\n337\t\n338\tfunc formatWithSuffix(val, base float64, suffixes []string, round string, prec int) string {\n339\t\tnegative := val < 0\n340\t\tabs := math.Abs(val)\n341\t\tlevel := 0\n342\t\tscaled := abs\n343\t\tfor level+1 < len(suffixes) && scaled >= base {\n344\t\t\tscaled /= base\n345\t\t\tlevel++\n346\t\t}\n347\t\tif level == 0 {\n348\t\t\treturn formatValPrec(val, prec)\n349\t\t}\n350\t\tsign := \"\"\n351\t\tif negative {\n352\t\t\tsign = \"-\"\n353\t\t}\n354\t\tif prec >= 0 {\n355\t\t\tr := roundToPrec(scaled, prec, negative, round)\n356\t\t\tif r >= base && level+1 < len(suffixes) {\n357\t\t\t\tlevel++\n358\t\t\t\tr = roundToPrec(abs/math.Pow(base, float64(level)), prec, negative, round)\n359\t\t\t}\n360\t\t\treturn fmt.Sprintf(\"%s%.*f%s\", sign, prec, r, suffixes[level])\n361\t\t}\n362\t\trounded1 := roundToPrec(scaled, 1, negative, round)\n363\t\tif rounded1 < 10 {\n364\t\t\treturn fmt.Sprintf(\"%s%.1f%s\", sign, rounded1, suffixes[level])\n365\t\t}\n366\t\tintVal := int64(roundToPrec(scaled, 0, negative, round))\n367\t\tif float64(intVal) >= base && level+1 < len(suffixes) {\n368\t\t\tlevel++\n369\t\t\tnewScaled := abs / math.Pow(base, float64(level))\n370\t\t\tr := roundToPrec(newScaled, 1, negative, round)\n371\t\t\tif r < 10 {\n372\t\t\t\treturn fmt.Sprintf(\"%s%.1f%s\", sign, r, suffixes[level])\n373\t\t\t}\n374\t\t\tintVal = int64(roundToPrec(newScaled, 0, negative, round))\n375\t\t}\n376\t\treturn fmt.Sprintf(\"%s%d%s\", sign, intVal, suffixes[level])\n377\t}\n378\t\n379\tfunc roundToPrec(absVal float64, prec int, negative bool, method string) float64 {\n380\t\tfactor := math.Pow(10, float64(prec))\n381\t\treturn roundAbs(absVal*factor, negative, method) / factor\n382\t}\n383\t\n384\tfunc roundAbs(absVal float64, negative bool, method string) float64 {\n385\t\tswitch method {\n386\t\tcase \"up\":\n387\t\t\tif negative {\n388\t\t\t\treturn math.Floor(absVal)\n389\t\t\t}\n390\t\t\treturn math.Ceil(absVal)\n391\t\tcase \"down\":\n392\t\t\tif negative {\n393\t\t\t\treturn math.Ceil(absVal)\n394\t\t\t}\n395\t\t\treturn math.Floor(absVal)\n396\t\tcase \"from-zero\":\n397\t\t\treturn math.Ceil(absVal)\n398\t\tcase \"towards-zero\":\n399\t\t\treturn math.Floor(absVal)\n400\t\tcase \"nearest\":\n401\t\t\treturn math.Round(absVal)\n402\t\t}\n403\t\treturn math.Ceil(absVal)\n404\t}\n405\t"}]},"parent_tool_use_id":null,"session_id":"c21e2f76-afda-4939-b345-1cfc82a1e0dc","uuid":"efff6268-bf4c-44e8-8de7-2164acddabcd","timestamp":"2026-05-22T22:50:59.061Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5473/cmd/numfmt/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd071-numfmt R1.1-R1.4, R2.1-R2.4.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"flag\"\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar (\n\tsiSuffixes   = []string{\"\", \"k\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\tiecSuffixes  = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\tieciSuffixes = []string{\"\", \"Ki\", \"Mi\", \"Gi\", \"Ti\", \"Pi\", \"Ei\"}\n)\n\ntype opts struct {\n\tfromUnit string\n\ttoUnit   string\n\tformat   string\n\tpadding  int\n\tround    string\n\tsuffix   string\n}\n\ntype fmtSpec struct {\n\tleftAlign bool\n\twidth     int\n\tprec      int\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\ttoUnit := flag.String(\"to\", \"none\", \"\")\n\tfromUnit := flag.String(\"from\", \"none\", \"\")\n\tformat := flag.String(\"format\", \"\", \"\")\n\tpadding := flag.Int(\"padding\", 0, \"\")\n\tround := flag.String(\"round\", \"from-zero\", \"\")\n\tsuffix := flag.String(\"suffix\", \"\", \"\")\n\tflag.Parse()\n\tif !isValidUnit(*toUnit) || !isValidUnit(*fromUnit) {\n\t\tfmt.Fprintf(os.Stderr, \"numfmt: invalid unit\\n\")\n\t\tos.Exit(1)\n\t}\n\tif !isValidRound(*round) {\n\t\tfmt.Fprintf(os.Stderr, \"numfmt: invalid --round method: '%s'\\n\", *round)\n\t\tos.Exit(1)\n\t}\n\to := opts{fromUnit: *fromUnit, toUnit: *toUnit, format: *format, padding: *padding, round: *round, suffix: *suffix}\n\thasError := false\n\tif flag.NArg() > 0 {\n\t\tfor _, arg := range flag.Args() {\n\t\t\tif err := processToken(arg, o); err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: %v\\n\", err)\n\t\t\t\thasError = true\n\t\t\t}\n\t\t}\n\t} else {\n\t\tscanner := bufio.NewScanner(os.Stdin)\n\t\tfor scanner.Scan() {\n\t\t\tif err := processLine(scanner.Text(), o); err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"numfmt: %v\\n\", err)\n\t\t\t\thasError = true\n\t\t\t}\n\t\t}\n\t}\n\tif hasError {\n\t\tos.Exit(2)\n\t}\n}\n\nfunc isValidUnit(u string) bool {\n\tswitch u {\n\tcase \"none\", \"si\", \"iec\", \"iec-i\":\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc isValidRound(r string) bool {\n\tswitch r {\n\tcase \"up\", \"down\", \"from-zero\", \"towards-zero\", \"nearest\":\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc processLine(line string, o opts) error {\n\tprefix, token, trailing := splitWhitespace(line)\n\tif token == \"\" {\n\t\treturn fmt.Errorf(\"invalid number: %q\", \"\")\n\t}\n\tval, err := parseNumber(token, o.fromUnit)\n\tif err != nil {\n\t\treturn err\n\t}\n\tout := formatOutput(val, o)\n\tif prefix != \"\" {\n\t\tfieldWidth := len(prefix) + len(token)\n\t\tif len(out) < fieldWidth {\n\t\t\tout = strings.Repeat(\" \", fieldWidth-len(out)) + out\n\t\t}\n\t}\n\tfmt.Printf(\"%s%s\\n\", out, trailing)\n\treturn nil\n}\n\nfunc processToken(token string, o opts) error {\n\tval, err := parseNumber(token, o.fromUnit)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfmt.Println(formatOutput(val, o))\n\treturn nil\n}\n\nfunc formatOutput(val float64, o opts) string {\n\tspec := parseFmtSpec(o.format)\n\tout := formatNumber(val, o.toUnit, o.round, spec.prec)\n\tout += o.suffix\n\twidth := spec.width\n\tleftAlign := spec.leftAlign\n\tif o.padding != 0 {\n\t\tpw := o.padding\n\t\tif pw < 0 {\n\t\t\tleftAlign = true\n\t\t\tpw = -pw\n\t\t}\n\t\tif pw > width {\n\t\t\twidth = pw\n\t\t}\n\t}\n\tif width > 0 && len(out) < width {\n\t\tout = padString(out, width, leftAlign)\n\t}\n\treturn out\n}\n\nfunc parseFmtSpec(format string) fmtSpec {\n\tspec := fmtSpec{prec: -1}\n\tidx := strings.IndexByte(format, '%')\n\tif idx < 0 {\n\t\treturn spec\n\t}\n\ts := format[idx+1:]\n\tfor len(s) > 0 && (s[0] == '-' || s[0] == '+' || s[0] == '\\'' || s[0] == ' ') {\n\t\tif s[0] == '-' {\n\t\t\tspec.leftAlign = true\n\t\t}\n\t\ts = s[1:]\n\t}\n\tfor len(s) > 0 && s[0] >= '0' && s[0] <= '9' {\n\t\tspec.width = spec.width*10 + int(s[0]-'0')\n\t\ts = s[1:]\n\t}\n\tif len(s) > 0 && s[0] == '.' {\n\t\ts = s[1:]\n\t\tspec.prec = 0\n\t\tfor len(s) > 0 && s[0] >= '0' && s[0] <= '9' {\n\t\t\tspec.prec = spec.prec*10 + int(s[0]-'0')\n\t\t\ts = s[1:]\n\t\t}\n\t}\n\treturn spec\n}\n\nfunc padString(s string, width int, leftAlign bool) string {\n\tpad := width - len(s)\n\tif pad <= 0 {\n\t\treturn s\n\t}\n\tspaces := strings.Repeat(\" \", pad)\n\tif leftAlign {\n\t\treturn s + spaces\n\t}\n\treturn spaces + s\n}\n\nfunc splitWhitespace(s string) (prefix, body, suffix string) {\n\ttrimLeft := strings.TrimLeft(s, \" \\t\")\n\tprefix = s[:len(s)-len(trimLeft)]\n\ttrimRight := strings.TrimRight(trimLeft, \" \\t\")\n\tsuffix = trimLeft[len(trimRight):]\n\tbody = trimRight\n\treturn\n}\n\nfunc parseNumber(s, unit string) (float64, error) {\n\tif unit == \"none\" {\n\t\tval, err := strconv.ParseFloat(s, 64)\n\t\tif err != nil {\n\t\t\tif hasSuffix(s) {\n\t\t\t\treturn 0, fmt.Errorf(\n\t\t\t\t\t\"rejecting suffix in input: '%s' (consider using --from)\", s)\n\t\t\t}\n\t\t\treturn 0, fmt.Errorf(\"invalid number: '%s'\", s)\n\t\t}\n\t\treturn val, nil\n\t}\n\tnumStr, mult, err := extractSuffix(s, unit)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tval, err := strconv.ParseFloat(numStr, 64)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid number: '%s'\", s)\n\t}\n\treturn val * mult, nil\n}\n\nfunc hasSuffix(s string) bool {\n\tif len(s) == 0 {\n\t\treturn false\n\t}\n\tif len(s) >= 2 {\n\t\ttail := s[len(s)-2:]\n\t\tswitch tail {\n\t\tcase \"Ki\", \"Mi\", \"Gi\", \"Ti\", \"Pi\", \"Ei\":\n\t\t\treturn true\n\t\t}\n\t}\n\tswitch s[len(s)-1] {\n\tcase 'K', 'k', 'M', 'G', 'T', 'P', 'E':\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc extractSuffix(s, unit string) (string, float64, error) {\n\tif len(s) == 0 {\n\t\treturn \"\", 0, fmt.Errorf(\"invalid number: ''\")\n\t}\n\tbase := baseForUnit(unit)\n\tsuffixMap := suffixMultipliers(unit, base)\n\tif unit == \"iec-i\" && len(s) >= 2 {\n\t\ttail := s[len(s)-2:]\n\t\tif m, ok := suffixMap[tail]; ok {\n\t\t\treturn s[:len(s)-2], m, nil\n\t\t}\n\t}\n\ttail := s[len(s)-1:]\n\tif m, ok := suffixMap[tail]; ok {\n\t\treturn s[:len(s)-1], m, nil\n\t}\n\tif endsWithLetter(s) {\n\t\treturn \"\", 0, fmt.Errorf(\"invalid suffix in input: '%s'\", s)\n\t}\n\treturn s, 1, nil\n}\n\nfunc endsWithLetter(s string) bool {\n\tif len(s) == 0 {\n\t\treturn false\n\t}\n\tc := s[len(s)-1]\n\treturn (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')\n}\n\nfunc baseForUnit(unit string) float64 {\n\tif unit == \"si\" {\n\t\treturn 1000\n\t}\n\treturn 1024\n}\n\nfunc suffixMultipliers(unit string, base float64) map[string]float64 {\n\tm := make(map[string]float64)\n\tswitch unit {\n\tcase \"si\":\n\t\tm[\"K\"] = base\n\t\tm[\"k\"] = base\n\t\tm[\"M\"] = math.Pow(base, 2)\n\t\tm[\"G\"] = math.Pow(base, 3)\n\t\tm[\"T\"] = math.Pow(base, 4)\n\t\tm[\"P\"] = math.Pow(base, 5)\n\t\tm[\"E\"] = math.Pow(base, 6)\n\tcase \"iec\":\n\t\tm[\"K\"] = base\n\t\tm[\"M\"] = math.Pow(base, 2)\n\t\tm[\"G\"] = math.Pow(base, 3)\n\t\tm[\"T\"] = math.Pow(base, 4)\n\t\tm[\"P\"] = math.Pow(base, 5)\n\t\tm[\"E\"] = math.Pow(base, 6)\n\tcase \"iec-i\":\n\t\tm[\"Ki\"] = base\n\t\tm[\"Mi\"] = math.Pow(base, 2)\n\t\tm[\"Gi\"] = math.Pow(base, 3)\n\t\tm[\"Ti\"] = math.Pow(base, 4)\n\t\tm[\"Pi\"] = math.Pow(base, 5)\n\t\tm[\"Ei\"] = math.Pow(base, 6)\n\t}\n\treturn m\n}\n\nfunc formatNumber(val float64, unit, round string, prec int) string {\n\tif unit == \"none\" {\n\t\treturn formatValPrec(val, prec)\n\t}\n\tbase := baseForUnit(unit)\n\tsuffixes := suffixesForUnit(unit)\n\treturn formatWithSuffix(val, base, suffixes, round, prec)\n}\n\nfunc formatRaw(val float64) string {\n\tif val == math.Trunc(val) && !math.IsInf(val, 0) {\n\t\treturn strconv.FormatInt(int64(val), 10)\n\t}\n\treturn strconv.FormatFloat(val, 'f', -1, 64)\n}\n\nfunc formatValPrec(val float64, prec int) string {\n\tif prec >= 0 {\n\t\treturn strconv.FormatFloat(val, 'f', prec, 64)\n\t}\n\treturn formatRaw(val)\n}\n\nfunc suffixesForUnit(unit string) []string {\n\tswitch unit {\n\tcase \"si\":\n\t\treturn siSuffixes\n\tcase \"iec\":\n\t\treturn iecSuffixes\n\tcase \"iec-i\":\n\t\treturn ieciSuffixes\n\t}\n\treturn nil\n}\n\nfunc formatWithSuffix(val, base float64, suffixes []string, round string, prec int) string {\n\tnegative := val < 0\n\tabs := math.Abs(val)\n\tlevel := 0\n\tscaled := abs\n\tfor level+1 < len(suffixes) && scaled >= base {\n\t\tscaled /= base\n\t\tlevel++\n\t}\n\tif level == 0 {\n\t\treturn formatValPrec(val, prec)\n\t}\n\tsign := \"\"\n\tif negative {\n\t\tsign = \"-\"\n\t}\n\tif prec >= 0 {\n\t\tr := roundToPrec(scaled, prec, negative, round)\n\t\tif r >= base && level+1 < len(suffixes) {\n\t\t\tlevel++\n\t\t\tr = roundToPrec(abs/math.Pow(base, float64(level)), prec, negative, round)\n\t\t}\n\t\treturn fmt.Sprintf(\"%s%.*f%s\", sign, prec, r, suffixes[level])\n\t}\n\trounded1 := roundToPrec(scaled, 1, negative, round)\n\tif rounded1 < 10 {\n\t\treturn fmt.Sprintf(\"%s%.1f%s\", sign, rounded1, suffixes[level])\n\t}\n\tintVal := int64(roundToPrec(scaled, 0, negative, round))\n\tif float64(intVal) >= base && level+1 < len(suffixes) {\n\t\tlevel++\n\t\tnewScaled := abs / math.Pow(base, float64(level))\n\t\tr := roundToPrec(newScaled, 1, negative, round)\n\t\tif r < 10 {\n\t\t\treturn fmt.Sprintf(\"%s%.1f%s\", sign, r, suffixes[level])\n\t\t}\n\t\tintVal = int64(roundToPrec(newScaled, 0, negative, round))\n\t}\n\treturn fmt.Sprintf(\"%s%d%s\", sign, intVal, suffixes[level])\n}\n\nfunc roundToPrec(absVal float64, prec int, negative bool, method string) float64 {\n\tfactor := math.Pow(10, float64(prec))\n\treturn roundAbs(absVal*factor, negative, method) / factor\n}\n\nfunc roundAbs(absVal float64, negative bool, method string) float64 {\n\tswitch method {\n\tcase \"up\":\n\t\tif negative {\n\t\t\treturn math.Floor(absVal)\n\t\t}\n\t\treturn math.Ceil(absVal)\n\tcase \"down\":\n\t\tif negative {\n\t\t\treturn math.Ceil(absVal)\n\t\t}\n\t\treturn math.Floor(absVal)\n\tcase \"from-zero\":\n\t\treturn math.Ceil(absVal)\n\tcase \"towards-zero\":\n\t\treturn math.Floor(absVal)\n\tcase \"nearest\":\n\t\treturn math.Round(absVal)\n\t}\n\treturn math.Ceil(absVal)\n}\n","numLines":405,"startLine":1,"totalLines":405}}}
