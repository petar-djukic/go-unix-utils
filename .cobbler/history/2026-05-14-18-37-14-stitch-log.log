{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F1na32opKXniTfnHyTcDgF","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd008-ls R1.1-R1.14, R2.1-R2.15, R3.1-R3.15.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"sort\"\n14\t\t\"strconv\"\n15\t\t\"strings\"\n16\t\t\"time\"\n17\t\t\"unicode/utf8\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n20\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n21\t)\n22\t\n23\tconst helpText = `Usage: ls [OPTION]... [FILE]...\n24\tList information about the FILEs (the current directory by default).\n25\tSort entries alphabetically if no flags given.\n26\t\n27\t  -a             do not ignore entries starting with .\n28\t  -A             do not list implied . and ..\n29\t  -C             list entries by columns\n30\t  -d             list directories themselves, not their contents\n31\t  -F             append indicator (one of */=>@|) to entries\n32\t  -h             with -l and/or -s, print human readable sizes\n33\t  -i             print the index number of each file\n34\t  -l             use a long listing format\n35\t  -n             like -l, but list numeric user and group IDs\n36\t  -R             list subdirectories recursively\n37\t  -r             reverse order while sorting\n38\t  -s             print the allocated size of each file, in blocks\n39\t  -S             sort by file size, largest first\n40\t  -t             sort by modification time, newest first\n41\t  -U             do not sort; list entries in directory order\n42\t  -v             natural sort of (version) numbers within text\n43\t  -x             list entries by lines instead of by columns\n44\t  -1             list one file per line\n45\t      --color[=WHEN]  colorize the output; WHEN can be 'always'\n46\t                         (default if omitted), 'auto', or 'never'\n47\t      --help     display this help and exit\n48\t      --version  output version information and exit\n49\t`\n50\t\n51\tconst versionText = `ls (go-unix-utils) dev\n52\t`\n53\t\n54\ttype options struct {\n55\t\tsingleColumn  bool\n56\t\tlongFormat    bool\n57\t\tforceColumns  bool\n58\t\thorizontalSort bool\n59\t\tshowAll       bool\n60\t\tshowAlmostAll bool\n61\t\tdirAsEntry    bool\n62\t\tsortByTime    bool\n63\t\tsortBySize    bool\n64\t\treverseSort   bool\n65\t\tunsorted      bool\n66\t\tversionSort   bool\n67\t\tshowInode     bool\n68\t\tshowBlocks    bool\n69\t\tnumericIds    bool\n70\t\thumanReadable bool\n71\t\tclassify      bool\n72\t\trecursive     bool\n73\t\tcolorMode     string\n74\t}\n75\t\n76\tfunc main() {\n77\t\tsys.InstallSIGPIPEHandler()\n78\t\topts, paths := parseArgs(os.Args[1:])\n79\t\tif len(paths) == 0 {\n80\t\t\tpaths = []string{\".\"}\n81\t\t}\n82\t\tos.Exit(run(paths, opts))\n83\t}\n84\t\n85\tfunc parseArgs(args []string) (options, []string) {\n86\t\tvar opts options\n87\t\tvar paths []string\n88\t\tfor len(args) > 0 {\n89\t\t\targ := args[0]\n90\t\t\targs = args[1:]\n91\t\t\tswitch {\n92\t\t\tcase arg == \"--help\":\n93\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n94\t\t\t\tos.Exit(0)\n95\t\t\tcase arg == \"--version\":\n96\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n97\t\t\t\tos.Exit(0)\n98\t\t\tcase arg == \"--\":\n99\t\t\t\treturn opts, append(paths, args...)\n100\t\t\tcase arg == \"--color\":\n101\t\t\t\topts.colorMode = \"always\"\n102\t\t\tcase strings.HasPrefix(arg, \"--color=\"):\n103\t\t\t\topts.colorMode = parseColorValue(arg)\n104\t\t\tcase strings.HasPrefix(arg, \"--\"):\n105\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n106\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n107\t\t\t\tos.Exit(2)\n108\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n109\t\t\t\tparseShortFlags(arg[1:], &opts)\n110\t\t\tdefault:\n111\t\t\t\tpaths = append(paths, arg)\n112\t\t\t}\n113\t\t}\n114\t\treturn opts, paths\n115\t}\n116\t\n117\tfunc parseShortFlags(flags string, opts *options) {\n118\t\tfor _, ch := range flags {\n119\t\t\tswitch ch {\n120\t\t\tcase '1':\n121\t\t\t\topts.forceColumns = false\n122\t\t\t\topts.horizontalSort = false\n123\t\t\t\tif !opts.longFormat {\n124\t\t\t\t\topts.singleColumn = true\n125\t\t\t\t}\n126\t\t\tcase 'l':\n127\t\t\t\topts.longFormat = true\n128\t\t\t\topts.singleColumn = false\n129\t\t\t\topts.forceColumns = false\n130\t\t\t\topts.horizontalSort = false\n131\t\t\tcase 'C':\n132\t\t\t\topts.forceColumns = true\n133\t\t\t\topts.horizontalSort = false\n134\t\t\t\topts.longFormat = false\n135\t\t\t\topts.singleColumn = false\n136\t\t\tcase 'x':\n137\t\t\t\topts.forceColumns = true\n138\t\t\t\topts.horizontalSort = true\n139\t\t\t\topts.longFormat = false\n140\t\t\t\topts.singleColumn = false\n141\t\t\tcase 'a':\n142\t\t\t\topts.showAll = true\n143\t\t\t\topts.showAlmostAll = false\n144\t\t\tcase 'A':\n145\t\t\t\topts.showAlmostAll = true\n146\t\t\t\topts.showAll = false\n147\t\t\tcase 'd':\n148\t\t\t\topts.dirAsEntry = true\n149\t\t\tcase 'F':\n150\t\t\t\topts.classify = true\n151\t\t\tcase 'h':\n152\t\t\t\topts.humanReadable = true\n153\t\t\tcase 'i':\n154\t\t\t\topts.showInode = true\n155\t\t\tcase 'n':\n156\t\t\t\topts.numericIds = true\n157\t\t\t\topts.longFormat = true\n158\t\t\t\topts.singleColumn = false\n159\t\t\t\topts.forceColumns = false\n160\t\t\t\topts.horizontalSort = false\n161\t\t\tcase 'R':\n162\t\t\t\topts.recursive = true\n163\t\t\tcase 'r':\n164\t\t\t\topts.reverseSort = true\n165\t\t\tcase 's':\n166\t\t\t\topts.showBlocks = true\n167\t\t\tcase 't':\n168\t\t\t\topts.sortByTime = true\n169\t\t\t\topts.sortBySize = false\n170\t\t\t\topts.unsorted = false\n171\t\t\t\topts.versionSort = false\n172\t\t\tcase 'S':\n173\t\t\t\topts.sortBySize = true\n174\t\t\t\topts.sortByTime = false\n175\t\t\t\topts.unsorted = false\n176\t\t\t\topts.versionSort = false\n177\t\t\tcase 'U':\n178\t\t\t\topts.unsorted = true\n179\t\t\t\topts.sortByTime = false\n180\t\t\t\topts.sortBySize = false\n181\t\t\t\topts.versionSort = false\n182\t\t\tcase 'v':\n183\t\t\t\topts.versionSort = true\n184\t\t\t\topts.sortByTime = false\n185\t\t\t\topts.sortBySize = false\n186\t\t\t\topts.unsorted = false\n187\t\t\tdefault:\n188\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n189\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n190\t\t\t\tos.Exit(2)\n191\t\t\t}\n192\t\t}\n193\t}\n194\t\n195\tfunc parseColorValue(arg string) string {\n196\t\tval := arg[len(\"--color=\"):]\n197\t\tswitch val {\n198\t\tcase \"always\", \"auto\", \"never\":\n199\t\t\treturn val\n200\t\tdefault:\n201\t\t\tfmt.Fprintf(os.Stderr,\n202\t\t\t\t\"ls: invalid argument '%s' for '--color'\\n\", val)\n203\t\t\tfmt.Fprintln(os.Stderr,\n204\t\t\t\t\"Try 'ls --help' for more information.\")\n205\t\t\tos.Exit(2)\n206\t\t\treturn \"\"\n207\t\t}\n208\t}\n209\t\n210\tfunc setupColor(opts options) {\n211\t\tswitch opts.colorMode {\n212\t\tcase \"always\":\n213\t\t\tformat.SetColorEnabled(true)\n214\t\tcase \"auto\":\n215\t\t\tformat.SetColorEnabled(sys.IsTerminal(os.Stdout.Fd()))\n216\t\tdefault:\n217\t\t\tformat.SetColorEnabled(false)\n218\t\t}\n219\t}\n220\t\n221\tfunc run(paths []string, opts options) int {\n222\t\tsetupColor(opts)\n223\t\texitCode := 0\n224\t\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n225\t\tneedSep := false\n226\t\tif len(files) > 0 {\n227\t\t\tsortEntries(files, \"\", opts)\n228\t\t\tif opts.longFormat {\n229\t\t\t\texitCode = maxCode(exitCode, writeLongFiles(files, opts))\n230\t\t\t} else {\n231\t\t\t\tdisplay := buildDisplayNames(files, \"\", opts)\n232\t\t\t\twriteEntries(display, opts)\n233\t\t\t}\n234\t\t\tneedSep = true\n235\t\t}\n236\t\tshowHeader := len(dirs) > 1 || len(files) > 0 || opts.recursive\n237\t\tsortEntries(dirs, \"\", opts)\n238\t\tfor _, dir := range dirs {\n239\t\t\tif needSep {\n240\t\t\t\tfmt.Fprintln(os.Stdout)\n241\t\t\t}\n242\t\t\tif showHeader {\n243\t\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n244\t\t\t}\n245\t\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n246\t\t\tneedSep = true\n247\t\t}\n248\t\treturn exitCode\n249\t}\n250\t\n251\tfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n252\t\tvar files, dirs []string\n253\t\tfor _, p := range paths {\n254\t\t\tinfo, err := os.Lstat(p)\n255\t\t\tif err != nil {\n256\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n257\t\t\t\t*exitCode = 2\n258\t\t\t\tcontinue\n259\t\t\t}\n260\t\t\tif info.IsDir() && !dirAsEntry {\n261\t\t\t\tdirs = append(dirs, p)\n262\t\t\t} else {\n263\t\t\t\tfiles = append(files, p)\n264\t\t\t}\n265\t\t}\n266\t\treturn files, dirs\n267\t}\n268\t\n269\tfunc maxCode(a, b int) int {\n270\t\tif a > b {\n271\t\t\treturn a\n272\t\t}\n273\t\treturn b\n274\t}\n275\t\n276\tfunc listDir(path string, opts options) int {\n277\t\tnames, err := readNames(path, opts)\n278\t\tif err != nil {\n279\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n280\t\t\t\tpath, sysError(err))\n281\t\t\treturn 2\n282\t\t}\n283\t\tcode := 0\n284\t\tif opts.longFormat {\n285\t\t\tcode = writeLongDir(path, names, opts)\n286\t\t} else {\n287\t\t\tif opts.showBlocks {\n288\t\t\t\twriteTotalLine(path, names, opts)\n289\t\t\t}\n290\t\t\tdisplay := buildDisplayNames(names, path, opts)\n291\t\t\twriteEntries(display, opts)\n292\t\t}\n293\t\tif opts.recursive {\n294\t\t\tcode = maxCode(code, recurseSubdirs(path, names, opts))\n295\t\t}\n296\t\treturn code\n297\t}\n298\t\n299\tfunc recurseSubdirs(path string, names []string, opts options) int {\n300\t\tcode := 0\n301\t\tfor _, name := range names {\n302\t\t\tif name == \".\" || name == \"..\" {\n303\t\t\t\tcontinue\n304\t\t\t}\n305\t\t\tfull := filepath.Join(path, name)\n306\t\t\tfi, err := os.Lstat(full)\n307\t\t\tif err != nil || !fi.IsDir() {\n308\t\t\t\tcontinue\n309\t\t\t}\n310\t\t\tfmt.Fprintln(os.Stdout)\n311\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", full)\n312\t\t\tcode = maxCode(code, listDir(full, opts))\n313\t\t}\n314\t\treturn code\n315\t}\n316\t\n317\tfunc readNames(path string, opts options) ([]string, error) {\n318\t\tentries, err := os.ReadDir(path)\n319\t\tif err != nil {\n320\t\t\treturn nil, err\n321\t\t}\n322\t\tnames := make([]string, 0, len(entries))\n323\t\tif opts.showAll {\n324\t\t\tnames = append(names, \".\", \"..\")\n325\t\t}\n326\t\tfor _, e := range entries {\n327\t\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n328\t\t\t\tcontinue\n329\t\t\t}\n330\t\t\tnames = append(names, e.Name())\n331\t\t}\n332\t\tsortEntries(names, path, opts)\n333\t\treturn names, nil\n334\t}\n335\t\n336\tfunc sortEntries(names []string, basePath string, opts options) {\n337\t\tif opts.unsorted {\n338\t\t\treturn\n339\t\t}\n340\t\tif opts.versionSort {\n341\t\t\tsort.SliceStable(names, func(i, j int) bool {\n342\t\t\t\treturn strverscmp(names[i], names[j]) < 0\n343\t\t\t})\n344\t\t\tif opts.reverseSort {\n345\t\t\t\treverseSlice(names)\n346\t\t\t}\n347\t\t\treturn\n348\t\t}\n349\t\tif !opts.sortByTime && !opts.sortBySize {\n350\t\t\tsort.Strings(names)\n351\t\t\tif opts.reverseSort {\n352\t\t\t\treverseSlice(names)\n353\t\t\t}\n354\t\t\treturn\n355\t\t}\n356\t\ttype entry struct {\n357\t\t\tname    string\n358\t\t\tmodTime time.Time\n359\t\t\tsize    int64\n360\t\t}\n361\t\tentries := make([]entry, len(names))\n362\t\tfor i, name := range names {\n363\t\t\tentries[i].name = name\n364\t\t\tp := name\n365\t\t\tif basePath != \"\" {\n366\t\t\t\tp = filepath.Join(basePath, name)\n367\t\t\t}\n368\t\t\tif fi, err := sys.Lstat(p); err == nil {\n369\t\t\t\tentries[i].modTime = fi.ModTime\n370\t\t\t\tentries[i].size = fi.Size\n371\t\t\t}\n372\t\t}\n373\t\tsort.SliceStable(entries, func(i, j int) bool {\n374\t\t\tif opts.sortByTime {\n375\t\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n376\t\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n377\t\t\t\t}\n378\t\t\t\treturn entries[i].name < entries[j].name\n379\t\t\t}\n380\t\t\tif entries[i].size != entries[j].size {\n381\t\t\t\treturn entries[i].size > entries[j].size\n382\t\t\t}\n383\t\t\treturn entries[i].name < entries[j].name\n384\t\t})\n385\t\tfor i, e := range entries {\n386\t\t\tnames[i] = e.name\n387\t\t}\n388\t\tif opts.reverseSort {\n389\t\t\treverseSlice(names)\n390\t\t}\n391\t}\n392\t\n393\ttype entryInfo struct {\n394\t\tinode  uint64\n395\t\tblocks int64\n396\t\tmode   os.FileMode\n397\t}\n398\t\n399\tfunc statDisplayEntries(names []string, basePath string, opts options) ([]entryInfo, int, int) {\n400\t\tinfos := make([]entryInfo, len(names))\n401\t\tvar inodeW, blocksW int\n402\t\tfor i, name := range names {\n403\t\t\tp := name\n404\t\t\tif basePath != \"\" {\n405\t\t\t\tp = filepath.Join(basePath, name)\n406\t\t\t}\n407\t\t\tfi, err := sys.Lstat(p)\n408\t\t\tif err != nil {\n409\t\t\t\tcontinue\n410\t\t\t}\n411\t\t\tinfos[i] = entryInfo{fi.Ino, fi.Blocks / 2, fi.Mode}\n412\t\t\tif n := len(strconv.FormatUint(fi.Ino, 10)); n > inodeW {\n413\t\t\t\tinodeW = n\n414\t\t\t}\n415\t\t\tbstr := formatBlocks(infos[i].blocks, opts.humanReadable)\n416\t\t\tif n := len(bstr); n > blocksW {\n417\t\t\t\tblocksW = n\n418\t\t\t}\n419\t\t}\n420\t\treturn infos, inodeW, blocksW\n421\t}\n422\t\n423\tfunc buildDisplayNames(names []string, basePath string, opts options) []string {\n424\t\tneedPrefix := opts.showInode || opts.showBlocks\n425\t\tneedColor := format.FileTypeColor(os.ModeDir) != \"\"\n426\t\tif !needPrefix && !needColor && !opts.classify {\n427\t\t\treturn names\n428\t\t}\n429\t\tinfos, inodeW, blocksW := statDisplayEntries(names, basePath, opts)\n430\t\tresult := make([]string, len(names))\n431\t\tfor i, name := range names {\n432\t\t\tvar b strings.Builder\n433\t\t\tif opts.showInode {\n434\t\t\t\tb.WriteString(format.PadLeft(strconv.FormatUint(infos[i].inode, 10), inodeW))\n435\t\t\t\tb.WriteByte(' ')\n436\t\t\t}\n437\t\t\tif opts.showBlocks {\n438\t\t\t\tbstr := formatBlocks(infos[i].blocks, opts.humanReadable)\n439\t\t\t\tb.WriteString(format.PadLeft(bstr, blocksW))\n440\t\t\t\tb.WriteByte(' ')\n441\t\t\t}\n442\t\t\tb.WriteString(colorEntry(name, infos[i].mode, opts.classify))\n443\t\t\tresult[i] = b.String()\n444\t\t}\n445\t\treturn result\n446\t}\n447\t\n448\tfunc colorEntry(name string, mode os.FileMode, classify bool) string {\n449\t\tindicator := \"\"\n450\t\tif classify {\n451\t\t\tindicator = classifyIndicator(mode)\n452\t\t}\n453\t\tc := format.FileTypeColor(mode)\n454\t\tif c == \"\" {\n455\t\t\treturn name + indicator\n456\t\t}\n457\t\treturn c + name + format.Reset() + indicator\n458\t}\n459\t\n460\tfunc classifyIndicator(mode os.FileMode) string {\n461\t\tswitch {\n462\t\tcase mode&os.ModeDir != 0:\n463\t\t\treturn \"/\"\n464\t\tcase mode&os.ModeSymlink != 0:\n465\t\t\treturn \"@\"\n466\t\tcase mode&os.ModeNamedPipe != 0:\n467\t\t\treturn \"|\"\n468\t\tcase mode&os.ModeSocket != 0:\n469\t\t\treturn \"=\"\n470\t\tcase mode.IsRegular() && mode&0111 != 0:\n471\t\t\treturn \"*\"\n472\t\tdefault:\n473\t\t\treturn \"\"\n474\t\t}\n475\t}\n476\t\n477\tfunc writeEntries(names []string, opts options) {\n478\t\tif len(names) == 0 {\n479\t\t\treturn\n480\t\t}\n481\t\tif opts.forceColumns {\n482\t\t\tif opts.horizontalSort {\n483\t\t\t\twriteHorizontalColumns(names, 0)\n484\t\t\t} else {\n485\t\t\t\twriteColumnsWidth(names, 0)\n486\t\t\t}\n487\t\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n488\t\t\twriteLines(names)\n489\t\t} else {\n490\t\t\twriteColumnsWidth(names, 0)\n491\t\t}\n492\t}\n493\t\n494\tfunc writeColumnsWidth(names []string, width int) {\n495\t\tif width <= 0 {\n496\t\t\tw, err := sys.TerminalWidth()\n497\t\t\tif err != nil {\n498\t\t\t\tw = 80\n499\t\t\t}\n500\t\t\twidth = w\n501\t\t}\n502\t\tgrid := format.Columns(names, width)\n503\t\twidths := gridColumnWidths(grid)\n504\t\tfor _, row := range grid {\n505\t\t\twriteGridRow(row, widths)\n506\t\t}\n507\t}\n508\t\n509\tfunc writeHorizontalColumns(names []string, width int) {\n510\t\tif width <= 0 {\n511\t\t\tw, err := sys.TerminalWidth()\n512\t\t\tif err != nil {\n513\t\t\t\tw = 80\n514\t\t\t}\n515\t\t\twidth = w\n516\t\t}\n517\t\tnumCols := findHorizontalMaxCols(names, width)\n518\t\trows := (len(names) + numCols - 1) / numCols\n519\t\tcolWidths := make([]int, numCols)\n520\t\tfor c := 0; c < numCols; c++ {\n521\t\t\tfor r := 0; r < rows; r++ {\n522\t\t\t\tidx := r*numCols + c\n523\t\t\t\tif idx >= len(names) {\n524\t\t\t\t\tbreak\n525\t\t\t\t}\n526\t\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n527\t\t\t\t\tcolWidths[c] = w\n528\t\t\t\t}\n529\t\t\t}\n530\t\t}\n531\t\tfor r := 0; r < rows; r++ {\n532\t\t\tvar row []string\n533\t\t\tfor c := 0; c < numCols; c++ {\n534\t\t\t\tidx := r*numCols + c\n535\t\t\t\tif idx >= len(names) {\n536\t\t\t\t\tbreak\n537\t\t\t\t}\n538\t\t\t\trow = append(row, names[idx])\n539\t\t\t}\n540\t\t\twriteGridRow(row, colWidths)\n541\t\t}\n542\t}\n543\t\n544\tfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n545\t\tn := len(entries)\n546\t\tfor cols := n; cols > 1; cols-- {\n547\t\t\tif horizontalGridFits(entries, cols, termWidth) {\n548\t\t\t\treturn cols\n549\t\t\t}\n550\t\t}\n551\t\treturn 1\n552\t}\n553\t\n554\tfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n555\t\trows := (len(entries) + cols - 1) / cols\n556\t\tcolWidths := make([]int, cols)\n557\t\tfor c := 0; c < cols; c++ {\n558\t\t\tfor r := 0; r < rows; r++ {\n559\t\t\t\tidx := r*cols + c\n560\t\t\t\tif idx >= len(entries) {\n561\t\t\t\t\tbreak\n562\t\t\t\t}\n563\t\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n564\t\t\t\t\tcolWidths[c] = w\n565\t\t\t\t}\n566\t\t\t}\n567\t\t}\n568\t\ttotal := 0\n569\t\tfor c := 0; c < cols; c++ {\n570\t\t\tif c < cols-1 {\n571\t\t\t\ttotal += colWidths[c] + 2\n572\t\t\t} else {\n573\t\t\t\ttotal += colWidths[c]\n574\t\t\t}\n575\t\t\tif total > termWidth {\n576\t\t\t\treturn false\n577\t\t\t}\n578\t\t}\n579\t\treturn true\n580\t}\n581\t\n582\tfunc writeLines(names []string) {\n583\t\tfor _, name := range names {\n584\t\t\twriteLine(name)\n585\t\t}\n586\t}\n587\t\n588\tfunc gridColumnWidths(grid [][]string) []int {\n589\t\tif len(grid) == 0 {\n590\t\t\treturn nil\n591\t\t}\n592\t\twidths := make([]int, len(grid[0]))\n593\t\tfor _, row := range grid {\n594\t\t\tfor c, cell := range row {\n595\t\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n596\t\t\t\t\twidths[c] = w\n597\t\t\t\t}\n598\t\t\t}\n599\t\t}\n600\t\treturn widths\n601\t}\n602\t\n603\tfunc writeGridRow(row []string, widths []int) {\n604\t\tvar b strings.Builder\n605\t\tfor i, cell := range row {\n606\t\t\tif i < len(row)-1 {\n607\t\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n608\t\t\t\tb.WriteString(\"  \")\n609\t\t\t} else {\n610\t\t\t\tb.WriteString(cell)\n611\t\t\t}\n612\t\t}\n613\t\twriteLine(b.String())\n614\t}\n615\t\n616\ttype longEntry struct {\n617\t\tname  string\n618\t\tpath  string\n619\t\tinfo  *sys.FileInfo\n620\t\towner string\n621\t\tgroup string\n622\t}\n623\t\n624\ttype longWidths struct {\n625\t\tinode  int\n626\t\tblocks int\n627\t\tnlink  int\n628\t\towner  int\n629\t\tgroup  int\n630\t\tsize   int\n631\t}\n632\t\n633\tfunc writeLongFiles(paths []string, opts options) int {\n634\t\tentries := make([]longEntry, 0, len(paths))\n635\t\tcode := 0\n636\t\tfor _, p := range paths {\n637\t\t\tfi, err := sys.Lstat(p)\n638\t\t\tif err != nil {\n639\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n640\t\t\t\tcode = 2\n641\t\t\t\tcontinue\n642\t\t\t}\n643\t\t\tentries = append(entries, newLongEntry(p, p, fi, opts))\n644\t\t}\n645\t\twriteLongEntries(entries, opts)\n646\t\treturn code\n647\t}\n648\t\n649\tfunc writeTotalLine(path string, names []string, opts options) {\n650\t\ttotal := int64(0)\n651\t\tfor _, name := range names {\n652\t\t\tp := filepath.Join(path, name)\n653\t\t\tfi, err := sys.Lstat(p)\n654\t\t\tif err != nil {\n655\t\t\t\tcontinue\n656\t\t\t}\n657\t\t\ttotal += fi.Blocks\n658\t\t}\n659\t\twriteLine(fmt.Sprintf(\"total %s\", formatBlocks(total/2, opts.humanReadable)))\n660\t}\n661\t\n662\tfunc writeLongDir(path string, names []string, opts options) int {\n663\t\tentries := make([]longEntry, 0, len(names))\n664\t\tcode := 0\n665\t\tfor _, name := range names {\n666\t\t\tfull := filepath.Join(path, name)\n667\t\t\tfi, err := sys.Lstat(full)\n668\t\t\tif err != nil {\n669\t\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n670\t\t\t\tcode = 2\n671\t\t\t\tcontinue\n672\t\t\t}\n673\t\t\tentries = append(entries, newLongEntry(name, full, fi, opts))\n674\t\t}\n675\t\ttotalBlocks := int64(0)\n676\t\tfor _, e := range entries {\n677\t\t\ttotalBlocks += e.info.Blocks\n678\t\t}\n679\t\ttotal := formatBlocks(totalBlocks/2, opts.humanReadable)\n680\t\twriteLine(fmt.Sprintf(\"total %s\", total))\n681\t\twriteLongEntries(entries, opts)\n682\t\treturn code\n683\t}\n684\t\n685\tfunc newLongEntry(name, path string, fi *sys.FileInfo, opts options) longEntry {\n686\t\towner := resolveOwner(fi.Uid)\n687\t\tgroup := resolveGroup(fi.Gid)\n688\t\tif opts.numericIds {\n689\t\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n690\t\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n691\t\t}\n692\t\treturn longEntry{\n693\t\t\tname:  name,\n694\t\t\tpath:  path,\n695\t\t\tinfo:  fi,\n696\t\t\towner: owner,\n697\t\t\tgroup: group,\n698\t\t}\n699\t}\n700\t\n701\tfunc writeLongEntries(entries []longEntry, opts options) {\n702\t\tif len(entries) == 0 {\n703\t\t\treturn\n704\t\t}\n705\t\tw := computeLongWidths(entries, opts)\n706\t\tfor _, e := range entries {\n707\t\t\twriteLine(formatLongLine(e, w, opts))\n708\t\t}\n709\t}\n710\t\n711\tfunc computeLongWidths(entries []longEntry, opts options) longWidths {\n712\t\tvar w longWidths\n713\t\tfor _, e := range entries {\n714\t\t\tif opts.showInode {\n715\t\t\t\tif n := len(strconv.FormatUint(e.info.Ino, 10)); n > w.inode {\n716\t\t\t\t\tw.inode = n\n717\t\t\t\t}\n718\t\t\t}\n719\t\t\tif opts.showBlocks {\n720\t\t\t\tbstr := formatBlocks(e.info.Blocks/2, opts.humanReadable)\n721\t\t\t\tif n := len(bstr); n > w.blocks {\n722\t\t\t\t\tw.blocks = n\n723\t\t\t\t}\n724\t\t\t}\n725\t\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n726\t\t\t\tw.nlink = n\n727\t\t\t}\n728\t\t\tif n := len(e.owner); n > w.owner {\n729\t\t\t\tw.owner = n\n730\t\t\t}\n731\t\t\tif n := len(e.group); n > w.group {\n732\t\t\t\tw.group = n\n733\t\t\t}\n734\t\t\tsstr := formatSize(e.info.Size, opts.humanReadable)\n735\t\t\tif n := len(sstr); n > w.size {\n736\t\t\t\tw.size = n\n737\t\t\t}\n738\t\t}\n739\t\treturn w\n740\t}\n741\t\n742\tfunc formatLongLine(e longEntry, w longWidths, opts options) string {\n743\t\tvar prefix string\n744\t\tif opts.showInode {\n745\t\t\tprefix += format.PadLeft(strconv.FormatUint(e.info.Ino, 10), w.inode) + \" \"\n746\t\t}\n747\t\tif opts.showBlocks {\n748\t\t\tbstr := formatBlocks(e.info.Blocks/2, opts.humanReadable)\n749\t\t\tprefix += format.PadLeft(bstr, w.blocks) + \" \"\n750\t\t}\n751\t\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n752\t\tsize := formatSize(e.info.Size, opts.humanReadable)\n753\t\tclassifyName := opts.classify && e.info.Mode&os.ModeSymlink == 0\n754\t\tname := colorEntry(e.name, e.info.Mode, classifyName)\n755\t\tif e.info.Mode&os.ModeSymlink != 0 {\n756\t\t\tif target, err := os.Readlink(e.path); err == nil {\n757\t\t\t\tname += \" -> \" + target\n758\t\t\t}\n759\t\t}\n760\t\treturn prefix +\n761\t\t\tpermString(e.info.Mode) + \" \" +\n762\t\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n763\t\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n764\t\t\tformat.PadRight(e.group, w.group) + \" \" +\n765\t\t\tformat.PadLeft(size, w.size) + \" \" +\n766\t\t\tformatMtime(e.info.ModTime) + \" \" +\n767\t\t\tname\n768\t}\n769\t\n770\tfunc formatBlocks(blocks int64, human bool) string {\n771\t\tif !human {\n772\t\t\treturn strconv.FormatInt(blocks, 10)\n773\t\t}\n774\t\treturn format.HumanSize(blocks*1024, format.HumanSizeOpts{Binary: true})\n775\t}\n776\t\n777\tfunc formatSize(size int64, human bool) string {\n778\t\tif !human {\n779\t\t\treturn strconv.FormatInt(size, 10)\n780\t\t}\n781\t\treturn format.HumanSize(size, format.HumanSizeOpts{Binary: true})\n782\t}\n783\t\n784\tfunc permString(mode os.FileMode) string {\n785\t\tvar b [10]byte\n786\t\tb[0] = fileTypeChar(mode)\n787\t\tconst rwx = \"rwx\"\n788\t\tperm := mode.Perm()\n789\t\tfor i := 0; i < 9; i++ {\n790\t\t\tif perm&(1<<uint(8-i)) != 0 {\n791\t\t\t\tb[1+i] = rwx[i%3]\n792\t\t\t} else {\n793\t\t\t\tb[1+i] = '-'\n794\t\t\t}\n795\t\t}\n796\t\tapplySpecialBits(mode, &b)\n797\t\treturn string(b[:])\n798\t}\n799\t\n800\tfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n801\t\tif mode&os.ModeSetuid != 0 {\n802\t\t\tif b[3] == 'x' {\n803\t\t\t\tb[3] = 's'\n804\t\t\t} else {\n805\t\t\t\tb[3] = 'S'\n806\t\t\t}\n807\t\t}\n808\t\tif mode&os.ModeSetgid != 0 {\n809\t\t\tif b[6] == 'x' {\n810\t\t\t\tb[6] = 's'\n811\t\t\t} else {\n812\t\t\t\tb[6] = 'S'\n813\t\t\t}\n814\t\t}\n815\t\tif mode&os.ModeSticky != 0 {\n816\t\t\tif b[9] == 'x' {\n817\t\t\t\tb[9] = 't'\n818\t\t\t} else {\n819\t\t\t\tb[9] = 'T'\n820\t\t\t}\n821\t\t}\n822\t}\n823\t\n824\tfunc fileTypeChar(mode os.FileMode) byte {\n825\t\tswitch {\n826\t\tcase mode&os.ModeDir != 0:\n827\t\t\treturn 'd'\n828\t\tcase mode&os.ModeSymlink != 0:\n829\t\t\treturn 'l'\n830\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n831\t\t\treturn 'c'\n832\t\tcase mode&os.ModeDevice != 0:\n833\t\t\treturn 'b'\n834\t\tcase mode&os.ModeNamedPipe != 0:\n835\t\t\treturn 'p'\n836\t\tcase mode&os.ModeSocket != 0:\n837\t\t\treturn 's'\n838\t\tdefault:\n839\t\t\treturn '-'\n840\t\t}\n841\t}\n842\t\n843\tfunc resolveOwner(uid uint32) string {\n844\t\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n845\t\tif err != nil {\n846\t\t\treturn strconv.FormatUint(uint64(uid), 10)\n847\t\t}\n848\t\treturn u.Username\n849\t}\n850\t\n851\tfunc resolveGroup(gid uint32) string {\n852\t\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n853\t\tif err != nil {\n854\t\t\treturn strconv.FormatUint(uint64(gid), 10)\n855\t\t}\n856\t\treturn g.Name\n857\t}\n858\t\n859\tfunc formatMtime(t time.Time) string {\n860\t\tsixMonths := 6 * 30 * 24 * time.Hour\n861\t\tago := time.Since(t)\n862\t\tif ago >= 0 && ago < sixMonths {\n863\t\t\treturn t.Format(\"Jan _2 15:04\")\n864\t\t}\n865\t\treturn t.Format(\"Jan _2  2006\")\n866\t}\n867\t\n868\tfunc writeLine(s string) {\n869\t\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n870\t\t\tos.Exit(1)\n871\t\t}\n872\t}\n873\t\n874\tfunc sysError(err error) string {\n875\t\tvar pathErr *os.PathError\n876\t\tif errors.As(err, &pathErr) {\n877\t\t\treturn pathErr.Err.Error()\n878\t\t}\n879\t\treturn err.Error()\n880\t}\n881\t"}]},"parent_tool_use_id":null,"session_id":"ce15821f-257a-402c-b91b-42275224bc4f","uuid":"fc869d3c-fe39-402b-9bbd-adf4bca613d5","timestamp":"2026-05-14T22:37:26.139Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5222/cmd/ls/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd008-ls R1.1-R1.14, R2.1-R2.15, R3.1-R3.15.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"sort\"\n\t\"strconv\"\n\t\"strings\"\n\t\"time\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ls [OPTION]... [FILE]...\nList information about the FILEs (the current directory by default).\nSort entries alphabetically if no flags given.\n\n  -a             do not ignore entries starting with .\n  -A             do not list implied . and ..\n  -C             list entries by columns\n  -d             list directories themselves, not their contents\n  -F             append indicator (one of */=>@|) to entries\n  -h             with -l and/or -s, print human readable sizes\n  -i             print the index number of each file\n  -l             use a long listing format\n  -n             like -l, but list numeric user and group IDs\n  -R             list subdirectories recursively\n  -r             reverse order while sorting\n  -s             print the allocated size of each file, in blocks\n  -S             sort by file size, largest first\n  -t             sort by modification time, newest first\n  -U             do not sort; list entries in directory order\n  -v             natural sort of (version) numbers within text\n  -x             list entries by lines instead of by columns\n  -1             list one file per line\n      --color[=WHEN]  colorize the output; WHEN can be 'always'\n                         (default if omitted), 'auto', or 'never'\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `ls (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn  bool\n\tlongFormat    bool\n\tforceColumns  bool\n\thorizontalSort bool\n\tshowAll       bool\n\tshowAlmostAll bool\n\tdirAsEntry    bool\n\tsortByTime    bool\n\tsortBySize    bool\n\treverseSort   bool\n\tunsorted      bool\n\tversionSort   bool\n\tshowInode     bool\n\tshowBlocks    bool\n\tnumericIds    bool\n\thumanReadable bool\n\tclassify      bool\n\trecursive     bool\n\tcolorMode     string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase arg == \"--color\":\n\t\t\topts.colorMode = \"always\"\n\t\tcase strings.HasPrefix(arg, \"--color=\"):\n\t\t\topts.colorMode = parseColorValue(arg)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'C':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = false\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'x':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = true\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'a':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\tcase 'A':\n\t\t\topts.showAlmostAll = true\n\t\t\topts.showAll = false\n\t\tcase 'd':\n\t\t\topts.dirAsEntry = true\n\t\tcase 'F':\n\t\t\topts.classify = true\n\t\tcase 'h':\n\t\t\topts.humanReadable = true\n\t\tcase 'i':\n\t\t\topts.showInode = true\n\t\tcase 'n':\n\t\t\topts.numericIds = true\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tcase 'r':\n\t\t\topts.reverseSort = true\n\t\tcase 's':\n\t\t\topts.showBlocks = true\n\t\tcase 't':\n\t\t\topts.sortByTime = true\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'S':\n\t\t\topts.sortBySize = true\n\t\t\topts.sortByTime = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'U':\n\t\t\topts.unsorted = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.versionSort = false\n\t\tcase 'v':\n\t\t\topts.versionSort = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'ls --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc parseColorValue(arg string) string {\n\tval := arg[len(\"--color=\"):]\n\tswitch val {\n\tcase \"always\", \"auto\", \"never\":\n\t\treturn val\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"ls: invalid argument '%s' for '--color'\\n\", val)\n\t\tfmt.Fprintln(os.Stderr,\n\t\t\t\"Try 'ls --help' for more information.\")\n\t\tos.Exit(2)\n\t\treturn \"\"\n\t}\n}\n\nfunc setupColor(opts options) {\n\tswitch opts.colorMode {\n\tcase \"always\":\n\t\tformat.SetColorEnabled(true)\n\tcase \"auto\":\n\t\tformat.SetColorEnabled(sys.IsTerminal(os.Stdout.Fd()))\n\tdefault:\n\t\tformat.SetColorEnabled(false)\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\tsetupColor(opts)\n\texitCode := 0\n\tfiles, dirs := classifyPaths(paths, &exitCode, opts.dirAsEntry)\n\tneedSep := false\n\tif len(files) > 0 {\n\t\tsortEntries(files, \"\", opts)\n\t\tif opts.longFormat {\n\t\t\texitCode = maxCode(exitCode, writeLongFiles(files, opts))\n\t\t} else {\n\t\t\tdisplay := buildDisplayNames(files, \"\", opts)\n\t\t\twriteEntries(display, opts)\n\t\t}\n\t\tneedSep = true\n\t}\n\tshowHeader := len(dirs) > 1 || len(files) > 0 || opts.recursive\n\tsortEntries(dirs, \"\", opts)\n\tfor _, dir := range dirs {\n\t\tif needSep {\n\t\t\tfmt.Fprintln(os.Stdout)\n\t\t}\n\t\tif showHeader {\n\t\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", dir)\n\t\t}\n\t\texitCode = maxCode(exitCode, listDir(dir, opts))\n\t\tneedSep = true\n\t}\n\treturn exitCode\n}\n\nfunc classifyPaths(paths []string, exitCode *int, dirAsEntry bool) ([]string, []string) {\n\tvar files, dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\t*exitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() && !dirAsEntry {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\treturn files, dirs\n}\n\nfunc maxCode(a, b int) int {\n\tif a > b {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc listDir(path string, opts options) int {\n\tnames, err := readNames(path, opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ls: cannot open directory '%s': %s\\n\",\n\t\t\tpath, sysError(err))\n\t\treturn 2\n\t}\n\tcode := 0\n\tif opts.longFormat {\n\t\tcode = writeLongDir(path, names, opts)\n\t} else {\n\t\tif opts.showBlocks {\n\t\t\twriteTotalLine(path, names, opts)\n\t\t}\n\t\tdisplay := buildDisplayNames(names, path, opts)\n\t\twriteEntries(display, opts)\n\t}\n\tif opts.recursive {\n\t\tcode = maxCode(code, recurseSubdirs(path, names, opts))\n\t}\n\treturn code\n}\n\nfunc recurseSubdirs(path string, names []string, opts options) int {\n\tcode := 0\n\tfor _, name := range names {\n\t\tif name == \".\" || name == \"..\" {\n\t\t\tcontinue\n\t\t}\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := os.Lstat(full)\n\t\tif err != nil || !fi.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tfmt.Fprintln(os.Stdout)\n\t\tfmt.Fprintf(os.Stdout, \"%s:\\n\", full)\n\t\tcode = maxCode(code, listDir(full, opts))\n\t}\n\treturn code\n}\n\nfunc readNames(path string, opts options) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tif opts.showAll {\n\t\tnames = append(names, \".\", \"..\")\n\t}\n\tfor _, e := range entries {\n\t\tif strings.HasPrefix(e.Name(), \".\") && !opts.showAll && !opts.showAlmostAll {\n\t\t\tcontinue\n\t\t}\n\t\tnames = append(names, e.Name())\n\t}\n\tsortEntries(names, path, opts)\n\treturn names, nil\n}\n\nfunc sortEntries(names []string, basePath string, opts options) {\n\tif opts.unsorted {\n\t\treturn\n\t}\n\tif opts.versionSort {\n\t\tsort.SliceStable(names, func(i, j int) bool {\n\t\t\treturn strverscmp(names[i], names[j]) < 0\n\t\t})\n\t\tif opts.reverseSort {\n\t\t\treverseSlice(names)\n\t\t}\n\t\treturn\n\t}\n\tif !opts.sortByTime && !opts.sortBySize {\n\t\tsort.Strings(names)\n\t\tif opts.reverseSort {\n\t\t\treverseSlice(names)\n\t\t}\n\t\treturn\n\t}\n\ttype entry struct {\n\t\tname    string\n\t\tmodTime time.Time\n\t\tsize    int64\n\t}\n\tentries := make([]entry, len(names))\n\tfor i, name := range names {\n\t\tentries[i].name = name\n\t\tp := name\n\t\tif basePath != \"\" {\n\t\t\tp = filepath.Join(basePath, name)\n\t\t}\n\t\tif fi, err := sys.Lstat(p); err == nil {\n\t\t\tentries[i].modTime = fi.ModTime\n\t\t\tentries[i].size = fi.Size\n\t\t}\n\t}\n\tsort.SliceStable(entries, func(i, j int) bool {\n\t\tif opts.sortByTime {\n\t\t\tif !entries[i].modTime.Equal(entries[j].modTime) {\n\t\t\t\treturn entries[i].modTime.After(entries[j].modTime)\n\t\t\t}\n\t\t\treturn entries[i].name < entries[j].name\n\t\t}\n\t\tif entries[i].size != entries[j].size {\n\t\t\treturn entries[i].size > entries[j].size\n\t\t}\n\t\treturn entries[i].name < entries[j].name\n\t})\n\tfor i, e := range entries {\n\t\tnames[i] = e.name\n\t}\n\tif opts.reverseSort {\n\t\treverseSlice(names)\n\t}\n}\n\ntype entryInfo struct {\n\tinode  uint64\n\tblocks int64\n\tmode   os.FileMode\n}\n\nfunc statDisplayEntries(names []string, basePath string, opts options) ([]entryInfo, int, int) {\n\tinfos := make([]entryInfo, len(names))\n\tvar inodeW, blocksW int\n\tfor i, name := range names {\n\t\tp := name\n\t\tif basePath != \"\" {\n\t\t\tp = filepath.Join(basePath, name)\n\t\t}\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\tinfos[i] = entryInfo{fi.Ino, fi.Blocks / 2, fi.Mode}\n\t\tif n := len(strconv.FormatUint(fi.Ino, 10)); n > inodeW {\n\t\t\tinodeW = n\n\t\t}\n\t\tbstr := formatBlocks(infos[i].blocks, opts.humanReadable)\n\t\tif n := len(bstr); n > blocksW {\n\t\t\tblocksW = n\n\t\t}\n\t}\n\treturn infos, inodeW, blocksW\n}\n\nfunc buildDisplayNames(names []string, basePath string, opts options) []string {\n\tneedPrefix := opts.showInode || opts.showBlocks\n\tneedColor := format.FileTypeColor(os.ModeDir) != \"\"\n\tif !needPrefix && !needColor && !opts.classify {\n\t\treturn names\n\t}\n\tinfos, inodeW, blocksW := statDisplayEntries(names, basePath, opts)\n\tresult := make([]string, len(names))\n\tfor i, name := range names {\n\t\tvar b strings.Builder\n\t\tif opts.showInode {\n\t\t\tb.WriteString(format.PadLeft(strconv.FormatUint(infos[i].inode, 10), inodeW))\n\t\t\tb.WriteByte(' ')\n\t\t}\n\t\tif opts.showBlocks {\n\t\t\tbstr := formatBlocks(infos[i].blocks, opts.humanReadable)\n\t\t\tb.WriteString(format.PadLeft(bstr, blocksW))\n\t\t\tb.WriteByte(' ')\n\t\t}\n\t\tb.WriteString(colorEntry(name, infos[i].mode, opts.classify))\n\t\tresult[i] = b.String()\n\t}\n\treturn result\n}\n\nfunc colorEntry(name string, mode os.FileMode, classify bool) string {\n\tindicator := \"\"\n\tif classify {\n\t\tindicator = classifyIndicator(mode)\n\t}\n\tc := format.FileTypeColor(mode)\n\tif c == \"\" {\n\t\treturn name + indicator\n\t}\n\treturn c + name + format.Reset() + indicator\n}\n\nfunc classifyIndicator(mode os.FileMode) string {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn \"/\"\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn \"@\"\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn \"|\"\n\tcase mode&os.ModeSocket != 0:\n\t\treturn \"=\"\n\tcase mode.IsRegular() && mode&0111 != 0:\n\t\treturn \"*\"\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\nfunc writeEntries(names []string, opts options) {\n\tif len(names) == 0 {\n\t\treturn\n\t}\n\tif opts.forceColumns {\n\t\tif opts.horizontalSort {\n\t\t\twriteHorizontalColumns(names, 0)\n\t\t} else {\n\t\t\twriteColumnsWidth(names, 0)\n\t\t}\n\t} else if opts.singleColumn || !sys.IsTerminal(os.Stdout.Fd()) {\n\t\twriteLines(names)\n\t} else {\n\t\twriteColumnsWidth(names, 0)\n\t}\n}\n\nfunc writeColumnsWidth(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tgrid := format.Columns(names, width)\n\twidths := gridColumnWidths(grid)\n\tfor _, row := range grid {\n\t\twriteGridRow(row, widths)\n\t}\n}\n\nfunc writeHorizontalColumns(names []string, width int) {\n\tif width <= 0 {\n\t\tw, err := sys.TerminalWidth()\n\t\tif err != nil {\n\t\t\tw = 80\n\t\t}\n\t\twidth = w\n\t}\n\tnumCols := findHorizontalMaxCols(names, width)\n\trows := (len(names) + numCols - 1) / numCols\n\tcolWidths := make([]int, numCols)\n\tfor c := 0; c < numCols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(names[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\tfor r := 0; r < rows; r++ {\n\t\tvar row []string\n\t\tfor c := 0; c < numCols; c++ {\n\t\t\tidx := r*numCols + c\n\t\t\tif idx >= len(names) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\trow = append(row, names[idx])\n\t\t}\n\t\twriteGridRow(row, colWidths)\n\t}\n}\n\nfunc findHorizontalMaxCols(entries []string, termWidth int) int {\n\tn := len(entries)\n\tfor cols := n; cols > 1; cols-- {\n\t\tif horizontalGridFits(entries, cols, termWidth) {\n\t\t\treturn cols\n\t\t}\n\t}\n\treturn 1\n}\n\nfunc horizontalGridFits(entries []string, cols, termWidth int) bool {\n\trows := (len(entries) + cols - 1) / cols\n\tcolWidths := make([]int, cols)\n\tfor c := 0; c < cols; c++ {\n\t\tfor r := 0; r < rows; r++ {\n\t\t\tidx := r*cols + c\n\t\t\tif idx >= len(entries) {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tif w := utf8.RuneCountInString(entries[idx]); w > colWidths[c] {\n\t\t\t\tcolWidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\ttotal := 0\n\tfor c := 0; c < cols; c++ {\n\t\tif c < cols-1 {\n\t\t\ttotal += colWidths[c] + 2\n\t\t} else {\n\t\t\ttotal += colWidths[c]\n\t\t}\n\t\tif total > termWidth {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc writeLines(names []string) {\n\tfor _, name := range names {\n\t\twriteLine(name)\n\t}\n}\n\nfunc gridColumnWidths(grid [][]string) []int {\n\tif len(grid) == 0 {\n\t\treturn nil\n\t}\n\twidths := make([]int, len(grid[0]))\n\tfor _, row := range grid {\n\t\tfor c, cell := range row {\n\t\t\tif w := utf8.RuneCountInString(cell); w > widths[c] {\n\t\t\t\twidths[c] = w\n\t\t\t}\n\t\t}\n\t}\n\treturn widths\n}\n\nfunc writeGridRow(row []string, widths []int) {\n\tvar b strings.Builder\n\tfor i, cell := range row {\n\t\tif i < len(row)-1 {\n\t\t\tb.WriteString(format.PadRight(cell, widths[i]))\n\t\t\tb.WriteString(\"  \")\n\t\t} else {\n\t\t\tb.WriteString(cell)\n\t\t}\n\t}\n\twriteLine(b.String())\n}\n\ntype longEntry struct {\n\tname  string\n\tpath  string\n\tinfo  *sys.FileInfo\n\towner string\n\tgroup string\n}\n\ntype longWidths struct {\n\tinode  int\n\tblocks int\n\tnlink  int\n\towner  int\n\tgroup  int\n\tsize   int\n}\n\nfunc writeLongFiles(paths []string, opts options) int {\n\tentries := make([]longEntry, 0, len(paths))\n\tcode := 0\n\tfor _, p := range paths {\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", p, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(p, p, fi, opts))\n\t}\n\twriteLongEntries(entries, opts)\n\treturn code\n}\n\nfunc writeTotalLine(path string, names []string, opts options) {\n\ttotal := int64(0)\n\tfor _, name := range names {\n\t\tp := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(p)\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\ttotal += fi.Blocks\n\t}\n\twriteLine(fmt.Sprintf(\"total %s\", formatBlocks(total/2, opts.humanReadable)))\n}\n\nfunc writeLongDir(path string, names []string, opts options) int {\n\tentries := make([]longEntry, 0, len(names))\n\tcode := 0\n\tfor _, name := range names {\n\t\tfull := filepath.Join(path, name)\n\t\tfi, err := sys.Lstat(full)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"ls: cannot access '%s': %s\\n\", full, sysError(err))\n\t\t\tcode = 2\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, newLongEntry(name, full, fi, opts))\n\t}\n\ttotalBlocks := int64(0)\n\tfor _, e := range entries {\n\t\ttotalBlocks += e.info.Blocks\n\t}\n\ttotal := formatBlocks(totalBlocks/2, opts.humanReadable)\n\twriteLine(fmt.Sprintf(\"total %s\", total))\n\twriteLongEntries(entries, opts)\n\treturn code\n}\n\nfunc newLongEntry(name, path string, fi *sys.FileInfo, opts options) longEntry {\n\towner := resolveOwner(fi.Uid)\n\tgroup := resolveGroup(fi.Gid)\n\tif opts.numericIds {\n\t\towner = strconv.FormatUint(uint64(fi.Uid), 10)\n\t\tgroup = strconv.FormatUint(uint64(fi.Gid), 10)\n\t}\n\treturn longEntry{\n\t\tname:  name,\n\t\tpath:  path,\n\t\tinfo:  fi,\n\t\towner: owner,\n\t\tgroup: group,\n\t}\n}\n\nfunc writeLongEntries(entries []longEntry, opts options) {\n\tif len(entries) == 0 {\n\t\treturn\n\t}\n\tw := computeLongWidths(entries, opts)\n\tfor _, e := range entries {\n\t\twriteLine(formatLongLine(e, w, opts))\n\t}\n}\n\nfunc computeLongWidths(entries []longEntry, opts options) longWidths {\n\tvar w longWidths\n\tfor _, e := range entries {\n\t\tif opts.showInode {\n\t\t\tif n := len(strconv.FormatUint(e.info.Ino, 10)); n > w.inode {\n\t\t\t\tw.inode = n\n\t\t\t}\n\t\t}\n\t\tif opts.showBlocks {\n\t\t\tbstr := formatBlocks(e.info.Blocks/2, opts.humanReadable)\n\t\t\tif n := len(bstr); n > w.blocks {\n\t\t\t\tw.blocks = n\n\t\t\t}\n\t\t}\n\t\tif n := len(strconv.FormatUint(e.info.Nlink, 10)); n > w.nlink {\n\t\t\tw.nlink = n\n\t\t}\n\t\tif n := len(e.owner); n > w.owner {\n\t\t\tw.owner = n\n\t\t}\n\t\tif n := len(e.group); n > w.group {\n\t\t\tw.group = n\n\t\t}\n\t\tsstr := formatSize(e.info.Size, opts.humanReadable)\n\t\tif n := len(sstr); n > w.size {\n\t\t\tw.size = n\n\t\t}\n\t}\n\treturn w\n}\n\nfunc formatLongLine(e longEntry, w longWidths, opts options) string {\n\tvar prefix string\n\tif opts.showInode {\n\t\tprefix += format.PadLeft(strconv.FormatUint(e.info.Ino, 10), w.inode) + \" \"\n\t}\n\tif opts.showBlocks {\n\t\tbstr := formatBlocks(e.info.Blocks/2, opts.humanReadable)\n\t\tprefix += format.PadLeft(bstr, w.blocks) + \" \"\n\t}\n\tnlink := strconv.FormatUint(e.info.Nlink, 10)\n\tsize := formatSize(e.info.Size, opts.humanReadable)\n\tclassifyName := opts.classify && e.info.Mode&os.ModeSymlink == 0\n\tname := colorEntry(e.name, e.info.Mode, classifyName)\n\tif e.info.Mode&os.ModeSymlink != 0 {\n\t\tif target, err := os.Readlink(e.path); err == nil {\n\t\t\tname += \" -> \" + target\n\t\t}\n\t}\n\treturn prefix +\n\t\tpermString(e.info.Mode) + \" \" +\n\t\tformat.PadLeft(nlink, w.nlink) + \" \" +\n\t\tformat.PadRight(e.owner, w.owner) + \" \" +\n\t\tformat.PadRight(e.group, w.group) + \" \" +\n\t\tformat.PadLeft(size, w.size) + \" \" +\n\t\tformatMtime(e.info.ModTime) + \" \" +\n\t\tname\n}\n\nfunc formatBlocks(blocks int64, human bool) string {\n\tif !human {\n\t\treturn strconv.FormatInt(blocks, 10)\n\t}\n\treturn format.HumanSize(blocks*1024, format.HumanSizeOpts{Binary: true})\n}\n\nfunc formatSize(size int64, human bool) string {\n\tif !human {\n\t\treturn strconv.FormatInt(size, 10)\n\t}\n\treturn format.HumanSize(size, format.HumanSizeOpts{Binary: true})\n}\n\nfunc permString(mode os.FileMode) string {\n\tvar b [10]byte\n\tb[0] = fileTypeChar(mode)\n\tconst rwx = \"rwx\"\n\tperm := mode.Perm()\n\tfor i := 0; i < 9; i++ {\n\t\tif perm&(1<<uint(8-i)) != 0 {\n\t\t\tb[1+i] = rwx[i%3]\n\t\t} else {\n\t\t\tb[1+i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(mode, &b)\n\treturn string(b[:])\n}\n\nfunc applySpecialBits(mode os.FileMode, b *[10]byte) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif b[3] == 'x' {\n\t\t\tb[3] = 's'\n\t\t} else {\n\t\t\tb[3] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif b[6] == 'x' {\n\t\t\tb[6] = 's'\n\t\t} else {\n\t\t\tb[6] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif b[9] == 'x' {\n\t\t\tb[9] = 't'\n\t\t} else {\n\t\t\tb[9] = 'T'\n\t\t}\n\t}\n}\n\nfunc fileTypeChar(mode os.FileMode) byte {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn 'd'\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn 'l'\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn 'c'\n\tcase mode&os.ModeDevice != 0:\n\t\treturn 'b'\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn 'p'\n\tcase mode&os.ModeSocket != 0:\n\t\treturn 's'\n\tdefault:\n\t\treturn '-'\n\t}\n}\n\nfunc resolveOwner(uid uint32) string {\n\tu, err := user.LookupId(strconv.Itoa(int(uid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(uid), 10)\n\t}\n\treturn u.Username\n}\n\nfunc resolveGroup(gid uint32) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(int(gid)))\n\tif err != nil {\n\t\treturn strconv.FormatUint(uint64(gid), 10)\n\t}\n\treturn g.Name\n}\n\nfunc formatMtime(t time.Time) string {\n\tsixMonths := 6 * 30 * 24 * time.Hour\n\tago := time.Since(t)\n\tif ago >= 0 && ago < sixMonths {\n\t\treturn t.Format(\"Jan _2 15:04\")\n\t}\n\treturn t.Format(\"Jan _2  2006\")\n}\n\nfunc writeLine(s string) {\n\tif _, err := fmt.Fprintln(os.Stdout, s); err != nil {\n\t\tos.Exit(1)\n\t}\n}\n\nfunc sysError(err error) string {\n\tvar pathErr *os.PathError\n\tif errors.As(err, &pathErr) {\n\t\treturn pathErr.Err.Error()\n\t}\n\treturn err.Error()\n}\n","numLines":881,"startLine":1,"totalLines":881}}}
