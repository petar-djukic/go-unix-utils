ion.\n// R2.5: undoes a prior SetColorEnabled call.\nfunc ResetColorEnabled() {\n\tcolorMu.Lock()\n\tcolorOverride = nil\n\tcolorMu.Unlock()\n}\n","numLines":105,"startLine":1,"totalLines":105}}}
