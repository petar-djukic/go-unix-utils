olorDisabled() {\n67\t\t\treturn \"\"\n68\t\t}\n69\t\treturn ansiReset\n70\t}\n71\t\n72\t// ColorEnabled reports whether color output is enabled for the given writer.\n73\t// R2.3: when no override is set, detects whether the writer is a terminal.\n74\tfunc ColorEnabled(w io.Writer) bool {\n75\t\tcolorMu.RLock()\n76\t\toverride := colorOverride\n77\t\tcolorMu.RUnlock()\n78\t\tif override != nil {\n79\t\t\treturn *override\n80\t\t}\n81\t\ttype fder interface {\n82\t\t\tFd() uintptr\n83\t\t}\n84\t\tif f, ok := w.(fder); ok {\n85\t\t\treturn sys.IsTerminal(f.Fd())\n86\t\t}\n87\t\treturn false\n88\t}\n89\t\n90\t// SetColorEnabled forces color output on or off regardless of terminal detection.\n91\t// R2.5: overrides the terminal check used by ColorEnabled and FileTypeColor.\n92\tfunc SetColorEnabled(enabled bool) {\n93\t\tcolorMu.Lock()\n94\t\tcolorOverride = &enabled\n95\t\tcolorMu.Unlock()\n96\t}\n97\t\n98\t// ResetColorEnabled clears any color override, restoring terminal-based detection.\n99\t// R2.5: undoes a prior SetColorEnabled call.\n100\tfunc ResetColorEnabled() {\n101\t\tcolorMu.Lock()\n102\t\tcolorOverride = nil\n103\t\tcolorMu.Unlock()\n104\t}\n105\t"}]},"parent_tool_use_id":null,"session_id":"022f8c73-4e7b-4f0e-8c5e-a2affdd55d0d","uuid":"1d091645-1812-428c-abe8-5186bb1981d2","timestamp":"2026-05-30T16:54:21.005Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5678/pkg/format/color.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage format\n\nimport (\n\t\"io\"\n\t\"os\"\n\t\"sync\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst (\n\tansiReset    = \"\\033[0m\"\n\tansiDir      = \"\\033[01;34m\"\n\tansiSymlink  = \"\\033[01;36m\"\n\tansiExec     = \"\\033[01;32m\"\n\tansiFifo     = \"\\033[40;33m\"\n\tansiSocket   = \"\\033[01;35m\"\n\tansiBlockDev = \"\\033[01;33m\"\n\tansiCharDev  = \"\\