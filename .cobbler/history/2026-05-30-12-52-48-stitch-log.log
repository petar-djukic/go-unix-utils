{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ytAoZEuqcjcYY8aeR9T2N","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Package format provides output formatting shared across utilities including\n5\t// human-readable size conversion, ANSI color output, and column alignment.\n6\t// Implements srd003-format.\n7\tpackage format\n8\t\n9\timport (\n10\t\t\"fmt\"\n11\t\t\"math\"\n12\t)\n13\t\n14\t// HumanSizeOpts configures human-readable size formatting.\n15\t// R3.1: Binary selects 1024-based (K, M, G) vs 1000-based (kB, MB, GB) units.\n16\ttype HumanSizeOpts struct {\n17\t\tBinary bool\n18\t}\n19\t\n20\tvar (\n21\t\tbinarySuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n22\t\tsiSuffixes     = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n23\t)\n24\t\n25\t// HumanSize formats a byte count as a human-readable string with unit suffix.\n26\t// R3.2: binary mode uses base 1024; SI mode uses base 1000.\n27\t// R3.3: outputs at most one decimal place when the value is fractional.\n28\t// R3.4: returns \"0\" for zero bytes.\n29\tfunc HumanSize(bytes int64, opts HumanSizeOpts) string {\n30\t\tif bytes == 0 {\n31\t\t\treturn \"0\"\n32\t\t}\n33\t\n34\t\tvar base float64\n35\t\tvar suffixes []string\n36\t\tif opts.Binary {\n37\t\t\tbase = 1024\n38\t\t\tsuffixes = binarySuffixes\n39\t\t} else {\n40\t\t\tbase = 1000\n41\t\t\tsuffixes = siSuffixes\n42\t\t}\n43\t\n44\t\tval := float64(bytes)\n45\t\tfor i, suffix := range suffixes {\n46\t\t\tif val < base || i == len(suffixes)-1 {\n47\t\t\t\treturn formatValue(val, suffix)\n48\t\t\t}\n49\t\t\tval /= base\n50\t\t}\n51\t\treturn formatValue(val, suffixes[len(suffixes)-1])\n52\t}\n53\t\n54\tfunc formatValue(val float64, suffix string) string {\n55\t\tif suffix == \"\" {\n56\t\t\treturn fmt.Sprintf(\"%d\", int64(val))\n57\t\t}\n58\t\trounded := math.Round(val*10) / 10\n59\t\tif rounded < 10 {\n60\t\t\treturn fmt.Sprintf(\"%.1f%s\", val, suffix)\n61\t\t}\n62\t\treturn fmt.Sprintf(\"%d%s\", int64(math.Round(val)), suffix)\n63\t}\n64\t"}]},"parent_tool_use_id":null,"session_id":"022f8c73-4e7b-4f0e-8c5e-a2affdd55d0d","uuid":"5521e2f3-3ff4-4796-add8-583ef1424cb0","timestamp":"2026-05-30T16:54:20.560Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5678/pkg/format/humansize.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package format provides output formatting shared across utilities including\n// human-readable size conversion, ANSI color output, and column alignment.\n// Implements srd003-format.\npackage format\n\nimport (\n\t\"fmt\"\n\t\"math\"\n)\n\n// HumanSizeOpts configures human-readable size formatting.\n// R3.1: Binary selects 1024-based (K, M, G) vs 1000-based (kB, MB, GB) units.\ntype HumanSizeOpts struct {\n\tBinary bool\n}\n\nvar (\n\tbinarySuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\tsiSuffixes     = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n)\n\n// HumanSize formats a byte count as a human-readable string with unit suffix.\n// R3.2: binary mode uses base 1024; SI mode uses base 1000.\n// R3.3: outputs at most one decimal place when the value is fractional.\n// R3.4: returns \"0\" for zero bytes.\nfunc HumanSize(bytes int64, opts HumanSizeOpts) string {\n\tif bytes == 0 {\n\t\treturn \"0\"\n\t}\n\n\tvar base float64\n\tvar suffixes []string\n\tif opts.Binary {\n\t\tbase = 1024\n\t\tsuffixes = binarySuffixes\n\t} else {\n\t\tbase = 1000\n\t\tsuffixes = siSuffixes\n\t}\n\n\tval := float64(bytes)\n\tfor i, suffix := range suffixes {\n\t\tif val < base || i == len(suffixes)-1 {\n\t\t\treturn formatValue(val, suffix)\n\t\t}\n\t\tval /= base\n\t}\n\treturn formatValue(val, suffixes[len(suffixes)-1])\n}\n\nfunc formatValue(val float64, suffix string) string {\n\tif suffix == \"\" {\n\t\treturn fmt.Sprintf(\"%d\", int64(val))\n\t}\n\trounded := math.Round(val*10) / 10\n\tif rounded < 10 {\n\t\treturn fmt.Sprintf(\"%.1f%s\", val, suffix)\n\t}\n\treturn fmt.Sprintf(\"%d%s\", int64(math.Round(val)), suffix)\n}\n","numLines":64,"startLine":1,"totalLines":64}}}
