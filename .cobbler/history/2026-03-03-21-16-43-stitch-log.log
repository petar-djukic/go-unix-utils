ion: -w flag counts words (maximal sequences of non-whitespace).\n    55→    inputs:\n    56→      args: [\"-w\"]\n    57→      stdin: \"hello world\\ngoodbye  cruel   world\\n\"\n    58→      env: [\"LC_ALL=C\"]\n    59→    normalization: none\n    60→    expected:\n    61→      exit_code: 0\n    62→      stdout_structure: 'output contains \"5\"'\n    63→      stderr: \"\"\n    64→    traces:\n    65→      - prd005-wc R2.2\n    66→      - prd005-wc R2.6\n    67→\n    68→  - name: wc_bytes_only\n    69→    description: -c flag counts bytes.\n    70→    inputs:\n    71→      args: [\"-c\"]\n    72→      stdin: \"abc\\n\"\n    73→      env: [\"LC_ALL=C\"]\n    74→    normalization: none\n    75→    expected:\n    76→      exit_code: 0\n    77→      stdout_structure: 'output contains \"4\"'\n    78→      stderr: \"\"\n    79→    traces:\n    80→      - prd005-wc R2.3\n    81→\n    82→  - name: wc_chars_lc_c\n    83→    description: -m with LC_ALL=C; character count equals byte count under C locale.\n    84→    inputs:\n    85→      args: [\"-m\"]\n    86→      stdin: \"hello\\n\"\n    87→      env: [\"LC_ALL=C\"]\n    88→    normalization: none\n    89→    expected:\n    90→      exit_code: 0\n    91→      stdout_structure: 'output contains \"6\"'\n    92→      stderr: \"\"\n    93→    traces:\n    94→      - prd005-wc R2.4\n    95→      - prd005-wc R5.1\n    96→      - prd005-wc R5.2\n    97→\n    98→  - name: wc_max_line_length\n    99→    description: -L flag reports the longest line length with tab expansion.\n   100→    inputs:\n   101→      args: [\"-L\"]\n   102→      stdin: \"short\\na much longer line here\\nmed\\n\"\n   103→      env: [\"LC_ALL=C\"]\n   104→    normalization: none\n   105→    expected:\n   106→      exit_code: 0\n   107→      stdout_structure: 'output contains \"22\"'\n   108→      stderr: \"\"\n   109→    traces:\n   110→      - prd005-wc R2.5\n   111→\n   112→  - name: wc_combined_flags_order\n   113→    description: Combined flags (-l -w -