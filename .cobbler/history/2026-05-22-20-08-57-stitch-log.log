28\t\n229\tfunc consumeArg(ps *printState) string {\n230\t\tif ps.argIdx < len(ps.args) {\n231\t\t\ts := ps.args[ps.argIdx]\n232\t\t\tps.argIdx++\n233\t\t\treturn s\n234\t\t}\n235\t\tps.argIdx++\n236\t\treturn \"\"\n237\t}\n238\t\n239\tfunc formatSpec(spec byte, dir string, ps *printState, out *strings.Builder) {\n240\t\targ := consumeArg(ps)\n241\t\tswitch spec {\n242\t\tcase 'd', 'i':\n243\t\t\tfmtSigned(dir+\"d\", arg, ps, out)\n244\t\tcase 'o':\n245\t\t\tfmtUnsigned(dir+\"o\", arg, ps, out)\n246\t\tcase 'u':\n247\t\t\tfmtUnsigned(dir+\"d\", arg, ps, out)\n248\t\tcase 'x':\n249\t\t\tfmtUnsigned(dir+\"x\", arg, ps, out)\n250\t\tcase 'X':\n251\t\t\tfmtUnsigned(dir+\"X\", arg, ps, out)\n252\t\tcase 'f', 'F', 'e', 'E', 'g', 'G':\n253\t\t\tfmtFloat(dir+string(spec), arg, ps, out)\n254\t\tcase 's':\n255\t\t\tfmt.Fprintf(out, dir+\"s\", arg)\n256\t\tcase 'c':\n257\t\t\tfmtChar(dir, arg, out)\n258\t\tcase 'b':\n259\t\t\tfmtBStr(arg, ps, out)\n260\t\tdefault:\n261\t\t\tfmt.Fprintf(os.Stderr, \"printf: '%%%c': invalid directive\\n\", spec)\n262\t\t\tps.hadErr = true\n263\t\t}\n264\t}\n265\t\n266\tfunc fmtSigned(goFmt, arg string, ps *printState, out *strings.Builder) {\n267\t\tn, err := parseIntArg(arg)\n268\t\tif err != nil {\n269\t\t\tfmt.Fprintf(os.Stderr, \"printf: '%s': expected a numeric value\\n\", arg)\n270\t\t\tps.hadErr = true\n271\t\t}\n272\t\tfmt.Fprintf(out, goFmt, n)\n273\t}\n274\t\n275\tfunc fmtUnsigned(goFmt, arg string, ps *printState, out *strings.Builder) {\n276\t\tn, err := parseIntArg(arg)\n277\t\tif err != nil {\n278\t\t\tfmt.Fprintf(os.Stderr, \"printf: '%s': expected a numeric value\\n\", arg)\n279\t\t\tps.hadErr = true\n280\t\t}\n281\t\tif n == 0 {\n282\t\t\tgoFmt = strings.ReplaceAll(goFmt, \"#\", \"\")\n283\t\t}\n284\t\tfmt.Fprintf(out, goFmt, uint64(n))\n285\t}\n286\t\n287\tfunc fmtFloat(goFmt, arg string, ps *printState, out *strings.Builder) {\n288\t\tf, err := parseFloatArg(arg)\n289\t\tif err != nil {\n290\t\t\tfmt.Fprintf(os.Stderr, \"print