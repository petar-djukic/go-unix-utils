1) {\n\t\tselect {}\n\t}\n\n\tif total > 0 {\n\t\ttime.Sleep(time.Duration(total * float64(time.Second)))\n\t}\n}\n\nfunc parseDuration(arg string) (float64, error) {\n\tlower := strings.ToLower(arg)\n\tif lower == \"infinity\" || lower == \"inf\" {\n\t\treturn math.Inf(1), nil\n\t}\n\n\tmultiplier := 1.0\n\ts := arg\n\tif len(s) > 0 {\n\t\tswitch s[len(s)-1] {\n\t\tcase 's':\n\t\t\tmultiplier = 1\n\t\t\ts = s[:len(s)-1]\n\t\tcase 'm':\n\t\t\tmultiplier = 60\n\t\t\ts = s[:len(s)-1]\n\t\tcase 'h':\n\t\t\tmultiplier = 3600\n\t\t\ts = s[:len(s)-1]\n\t\tcase 'd':\n\t\t\tmultiplier = 86400\n\t\t\ts = s[:len(s)-1]\n\t\t}\n\t}\n\n\tval, err := strconv.ParseFloat(s, 64)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\tif val < 0 {\n\t\treturn 0, fmt.Errorf(\"negative duration\")\n\t}\n\n\treturn val * multiplier, nil\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
