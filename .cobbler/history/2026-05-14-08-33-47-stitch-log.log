tvar stdout, stderr bytes.Buffer\n440\t\tcmd.Stdout = &stdout\n441\t\tcmd.Stderr = &stderr\n442\t\terr := cmd.Run()\n443\t\tif err == nil {\n444\t\t\treturn 0, stdout.Bytes(), stderr.Bytes()\n445\t\t}\n446\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n447\t\t\treturn exitErr.ExitCode(), stdout.Bytes(), stderr.Bytes()\n448\t\t}\n449\t\tt.Fatalf(\"unexpected error: %v\", err)\n450\t\treturn -1, nil, nil\n451\t}\n452\t\n453\tfunc runWithBrokenStdout(t *testing.T, binary string) int {\n454\t\tt.Helper()\n455\t\tpr, pw, err := os.Pipe()\n456\t\tif err != nil {\n457\t\t\tt.Fatal(err)\n458\t\t}\n459\t\tcmd := exec.Command(binary)\n460\t\tcmd.Stdin = bytes.NewReader(bytes.Repeat([]byte(\"a\\n\"), 100000))\n461\t\tcmd.Stdout = pw\n462\t\tif err := cmd.Start(); err != nil {\n463\t\t\tpr.Close()\n464\t\t\tpw.Close()\n465\t\t\tt.Fatal(err)\n466\t\t}\n467\t\tpw.Close()\n468\t\tpr.Close()\n469\t\terr = cmd.Wait()\n470\t\tif err == nil {\n471\t\t\treturn 0\n472\t\t}\n473\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n474\t\t\treturn exitErr.ExitCode()\n475\t\t}\n476\t\tt.Fatalf(\"unexpected error: %v\", err)\n477\t\treturn -1\n478\t}\n479\t\n480\tfunc allBytes() []byte {\n481\t\tb := make([]byte, 256)\n482\t\tfor i := range b {\n483\t\t\tb[i] = byte(i)\n484\t\t}\n485\t\treturn b\n486\t}\n487\t\n488\tfunc runSIGINTTest(t *testing.T, binary, label string) ([]byte, []byte, int) {\n489\t\tt.Helper()\n490\t\tdir := t.TempDir()\n491\t\toutFile := filepath.Join(dir, \"out.txt\")\n492\t\tcmd := exec.Command(binary, \"-i\", outFile)\n493\t\tstdin, err := cmd.StdinPipe()\n494\t\tif err != nil {\n495\t\t\tt.Fatalf(\"%s: stdin pipe: %v\", label, err)\n496\t\t}\n497\t\tvar stdout, stderr bytes.Buffer\n498\t\tcmd.Stdout = &stdout\n499\t\tcmd.Stderr = &stderr\n500\t\tif err := cmd.Start(); err != nil {\n501\t\t\tt.Fatalf(\"%s: start: %v\", label, err)\n502\t\t}\n503\t\t// Wait for the process to create the output file before proceeding.\n504\t\tfor range 50 {\n