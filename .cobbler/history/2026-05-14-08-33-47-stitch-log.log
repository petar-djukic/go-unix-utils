ulti\", input, \"a.txt\", \"b.txt\")\n55\t\tif !bytes.Equal(goStdout, refStdout) {\n56\t\t\tt.Fatalf(\"stdout divergence\\n  go:  %q\\n  ref: %q\", goStdout, refStdout)\n57\t\t}\n58\t}\n59\t\n60\tfunc TestDiffDashFile(t *testing.T) {\n61\t\tgoBin := testutils.BuildBinary(t, \".\")\n62\t\trefBin, err := exec.LookPath(\"gtee\")\n63\t\tif err != nil {\n64\t\t\tt.Skip(\"reference binary gtee not found\")\n65\t\t}\n66\t\tinput := []byte(\"dash test\\n\")\n67\t\ttests := []testutils.DiffTest{\n68\t\t\t{Name: \"dash_only\", Args: []string{\"-\"}, Stdin: input},\n69\t\t}\n70\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n71\t}\n72\t\n73\tfunc TestDiffAppendMode(t *testing.T) {\n74\t\tgoBin := testutils.BuildBinary(t, \".\")\n75\t\trefBin, err := exec.LookPath(\"gtee\")\n76\t\tif err != nil {\n77\t\t\tt.Skip(\"reference binary gtee not found\")\n78\t\t}\n79\t\trunAppendTest(t, goBin, \"go_append\")\n80\t\trunAppendTest(t, refBin, \"ref_append\")\n81\t}\n82\t\n83\tfunc TestDiffAppendLongFlag(t *testing.T) {\n84\t\tgoBin := testutils.BuildBinary(t, \".\")\n85\t\trefBin, err := exec.LookPath(\"gtee\")\n86\t\tif err != nil {\n87\t\t\tt.Skip(\"reference binary gtee not found\")\n88\t\t}\n89\t\trunAppendTestLong(t, goBin, \"go_append_long\")\n90\t\trunAppendTestLong(t, refBin, \"ref_append_long\")\n91\t}\n92\t\n93\tfunc TestDiffCombinedFlags(t *testing.T) {\n94\t\tgoBin := testutils.BuildBinary(t, \".\")\n95\t\trefBin, err := exec.LookPath(\"gtee\")\n96\t\tif err != nil {\n97\t\t\tt.Skip(\"reference binary gtee not found\")\n98\t\t}\n99\t\tinput := []byte(\"combined\\n\")\n100\t\ttests := []testutils.DiffTest{\n101\t\t\t{Name: \"combined_ai\", Args: []string{\"-ai\"}, Stdin: input},\n102\t\t\t{Name: \"combined_ia\", Args: []string{\"-ia\"}, Stdin: input},\n103\t\t\t{Name: \"separate_a_i\", Args: []string{\"-a\", \"-i\"}, Stdin: input},\n104\t\t}\n105\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n106\t}\n107\t\n108\tfunc TestDiffIgnoreInterrupts(t *testing.T) {\n109\t\tgoBin := testutils.BuildBinary(t, \".\")\n110\t\trefBin, err := exec.LookPath(\"gtee\")\n111\t\tif err != nil {\n112\t\t\tt.Skip(\"reference binary gtee not found\")\n113\t\t}\n114\t\tinput := []byte(\"interrupt test\\n\")\n115\t\ttests := []testutils.DiffTest{\n116\t\t\t{Name: \"ignore_interrupts_short\", Args: []string{\"-i\"}, Stdin: input},\n117\t\t\t{Name: \"ignore_interrupts_long\", Args: []string{\"--ignore-interrupts\"}, Stdin: input},\n118\t\t}\n119\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n120\t}\n121\t\n122\tfunc TestDiffWriteOrder(t *testing.T) {\n123\t\tgoBin := testutils.BuildBinary(t, \".\")\n124\t\trefBin, err := exec.LookPath(\"gtee\")\n125\t\tif err != nil {\n126\t\t\tt.Skip(\"reference binary gtee not found\")\n127\t\t}\n128\t\tvar ordered []byte\n129\t\tfor i := range 100 {\n130\t\t\tordered = fmt.Appendf(ordered, \"line %03d\\n\", i)\n131\t\t}\n132\t\ttests := []testutils.DiffTest{\n133\t\t\t{Name: \"write_order\", Stdin: ordered},\n134\t\t}\n135\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n136\t}\n137\t\n138\tfunc TestDiffMultiFileAppend(t *testing.T) {\n139\t\tgoBin := testutils.BuildBinary(t, \".\")\n140\t\trefBin, err := exec.LookPath(\"gtee\")\n141\t\tif err != nil {\n142\t\t\tt.Skip(\"reference binary gtee not found\")\n143\t\t}\n144\t\trunMultiFileAppendTest(t, goBin, \"go_multi_append\")\n145\t\trunMultiFileAppendTest(t, refBin, \"ref_multi_append\")\n146\t}\n147\t\n148\tfunc TestFileCreation(t *testing.T) {\n149\t\tgoBin := testutils.BuildBinary(t, \".\")\n150\t\tdir := t.TempDir()\n151\t\toutFile := filepath.Join(dir, \"created.txt\")\n152\t\tcmd := exec.Command(goBin, outFile)\n153\t\tcmd.Stdin = bytes.NewReader([]byte(\"create me\\n\"))\n154\t\tout, err := cmd.Output()\n155\t\tif err != nil {\n156\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n157\t\t}\n158\t\tif string(out) != \"create me\\n\" {\n159\t\t\tt.Fatalf(\"stdout: got %q, want %q\", out, \"create me\\n\")\n160\t\t}\n161\t\tgot, err := os.ReadFile(outFile)\n162\t\tif err != nil {\n163\t\t\tt.Fatalf(\"read created file: %v\", err)\n164\t\t}\n165\t\tif string(got) != \"create me\\n\" {\n166\t\t\tt.Fatalf(\"file content: got %q, want %q\", got, \"create me\\n\")\n167\t\t}\n168\t}\n169\t\n170\tfunc TestTruncateExisting(t *testing.T) {\n171\t\tgoBin := testutils.BuildBinary(t, \".\")\n172\t\tdir := t.TempDir()\n173\t\toutFile := filepath.Join(dir, \"existing.txt\")\n174\t\tos.WriteFile(outFile, []byte(\"old content\\n\"), 0o644)\n175\t\tcmd := exec.Command(goBin, outFile)\n176\t\tcmd.Stdin = bytes.NewReader([]byte(\"new\\n\"))\n177\t\tif err := cmd.Run(); err != nil {\n178\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n179\t\t}\n180\t\tgot, err := os.ReadFile(outFile)\n181\t\tif err != nil {\n182\t\t\tt.Fatalf(\"read file: %v\", err)\n183\t\t}\n184\t\tif string(got) != \"new\\n\" {\n185\t\t\tt.Fatalf(\"file content: got %q, want %q\", got, \"new\\n\")\n186\t\t}\n187\t}\n188\t\n189\tfunc runFileTest(t *testing.T, binary, label string, input []byte, fileName string) {\n190\t\tt.Helper()\n191\t\tdir := t.TempDir()\n192\t\toutPath := filepath.Join(dir, fileName)\n193\t\tcmd := exec.Command(binary, outPath)\n194\t\tcmd.Stdin = bytes.NewReader(input)\n195\t\tstdout, err := cmd.Output()\n196\t\tif err != nil {\n197\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n198\t\t}\n199\t\tif !bytes.Equal(stdout, input) {\n200\t\t\tt.Fatalf(\"%s: stdout divergence\\n  got:  %q\\n  want: %q\", label, stdout, input)\n201\t\t}\n202\t\tgot, err := os.ReadFile(outPath)\n203\t\tif err != nil {\n204\t\t\tt.Fatalf(\"%s: read output file: %v\", label, err)\n205\t\t}\n206\t\tif !bytes.Equal(got, input) {\n207\t\t\tt.Fatalf(\"%s: file content divergence\\n  got:  %q\\n  want: %q\", label, got, input)\n208\t\t}\n209\t}\n210\t\n211\tfunc runMultiFileTest(\n212\t\tt *testing.T, binary, label string, input []byte, names ...string,\n213\t) []byte {\n214\t\tt.Helper()\n215\t\tdir := t.TempDir()\n216\t\tvar paths []string\n217\t\tfor _, n := range names {\n218\t\t\tpaths = append(paths, filepath.Join(dir, n))\n219\t\t}\n220\t\tcmd := exec.Command(binary, paths...)\n221\t\tcmd.Stdin = bytes.NewReader(input)\n222\t\tstdout, err := cmd.Output()\n223\t\tif err != nil {\n224\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n225\t\t}\n226\t\tfor _, p := range paths {\n227\t\t\tgot, err := os.ReadFile(p)\n228\t\t\tif err != nil {\n229\t\t\t\tt.Fatalf(\"%s: read %s: %v\", label, p, err)\n230\t\t\t}\n231\t\t\tif !bytes.Equal(got, input) {\n232\t\t\t\tt.Fatalf(\"%s: %s divergence\\n  got:  %q\\n  want: %q\", label, p, got, input)\n233\t\t\t}\n234\t\t}\n235\t\treturn stdout\n236\t}\n237\t\n238\tfunc runAppendTest(t *testing.T, binary, label string) {\n239\t\tt.Helper()\n240\t\tdir := t.TempDir()\n241\t\toutFile := filepath.Join(dir, \"append.txt\")\n242\t\tos.WriteFile(outFile, []byte(\"existing\\n\"), 0o644)\n243\t\tcmd := exec.Command(binary, \"-a\", outFile)\n244\t\tcmd.Stdin = bytes.NewReader([]byte(\"appended\\n\"))\n245\t\tif err := cmd.Run(); err != nil {\n246\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n247\t\t}\n248\t\tgot, err := os.ReadFile(outFile)\n249\t\tif err != nil {\n250\t\t\tt.Fatalf(\"%s: read file: %v\", label, err)\n251\t\t}\n252\t\twant := \"existing\\nappended\\n\"\n253\t\tif string(got) != want {\n254\t\t\tt.Fatalf(\"%s: file content\\n  got:  %q\\n  want: %q\", label, got, want)\n255\t\t}\n256\t}\n257\t\n258\tfunc runAppendTestLong(t *testing.T, binary, label string) {\n259\t\tt.Helper()\n260\t\tdir := t.TempDir()\n261\t\toutFile := filepath.Join(dir, \"append_long.txt\")\n262\t\tos.WriteFile(outFile, []byte(\"existing\\n\"), 0o644)\n263\t\tcmd := exec.Command(binary, \"--append\", outFile)\n264\t\tcmd.Stdin = bytes.NewReader([]byte(\"appended\\n\"))\n265\t\tif err := cmd.Run(); err != nil {\n266\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n267\t\t}\n268\t\tgot, err := os.ReadFile(outFile)\n269\t\tif err != nil {\n270\t\t\tt.Fatalf(\"%s: read file: %v\", label, err)\n271\t\t}\n272\t\twant := \"existing\\nappended\\n\"\n273\t\tif string(got) != want {\n274\t\t\tt.Fatalf(\"%s: file content\\n  got:  %q\\n  want: %q\", label, got, want)\n275\t\t}\n276\t}\n277\t\n278\tfunc runMultiFileAppendTest(t *testing.T, binary, label string) {\n279\t\tt.Helper()\n280\t\tdir := t.TempDir()\n281\t\tfileA := filepath.Join(dir, \"a.txt\")\n282\t\tfileB := filepath.Join(dir, \"b.txt\")\n283\t\tos.WriteFile(fileA, []byte(\"old_a\\n\"), 0o644)\n284\t\tos.WriteFile(fileB, []byte(\"old_b\\n\"), 0o644)\n285\t\tcmd := exec.Command(binary, \"-a\", fileA, fileB)\n286\t\tcmd.Stdin = bytes.NewReader([]byte(\"new\\n\"))\n287\t\tif err := cmd.Run(); err != nil {\n288\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n289\t\t}\n290\t\tgotA, err := os.ReadFile(fileA)\n291\t\tif err != nil {\n292\t\t\tt.Fatalf(\"%s: read a.txt: %v\", label, err)\n293\t\t}\n294\t\tgotB, err := os.ReadFile(fileB)\n295\t\tif err != nil {\n296\t\t\tt.Fatalf(\"%s: read b.txt: %v\", label, err)\n297\t\t}\n298\t\twantA := \"old_a\\nnew\\n\"\n299\t\twantB := \"old_b\\nnew\\n\"\n300\t\tif string(gotA) != wantA {\n301\t\t\tt.Fatalf(\"%s: a.txt\\n  got:  %q\\n  want: %q\", label, gotA, wantA)\n302\t\t}\n303\t\tif string(gotB) != wantB {\n304\t\t\tt.Fatalf(\"%s: b.txt\\n  got:  %q\\n  want: %q\", label, gotB, wantB)\n305\t\t}\n306\t}\n307\t\n308\tfunc TestWriteErrorReadOnly(t *testing.T) {\n309\t\tgoBin := testutils.BuildBinary(t, \".\")\n310\t\tdir := t.TempDir()\n311\t\troDir := filepath.Join(dir, \"readonly\")\n312\t\tos.Mkdir(roDir, 0o555)\n313\t\tbadFile := filepath.Join(roDir, \"nope.txt\")\n314\t\tgoodFile := filepath.Join(dir, \"good.txt\")\n315\t\n316\t\tgoExit, goStdout, goStderr := runCapture(t, goBin, []byte(\"data\\n\"), badFile, goodFile)\n317\t\tif goExit != 1 {\n318\t\t\tt.Fatalf(\"expected exit 1, got %d\", goExit)\n319\t\t}\n320\t\tif string(goStdout) != \"data\\n\" {\n321\t\t\tt.Fatalf(\"stdout: got %q, want %q\", goStdout, \"data\\n\")\n322\t\t}\n323\t\tgot, err := os.ReadFile(goodFile)\n324\t\tif err != nil {\n325\t\t\tt.Fatalf(\"read good file: %v\", err)\n326\t\t}\n327\t\tif string(got) != \"data\\n\" {\n328\t\t\tt.Fatalf(\"good file: got %q, want %q\", got, \"data\\n\")\n329\t\t}\n330\t\tif !strings.Contains(string(goStderr), \"nope.txt\") {\n331\t\t\tt.Fatalf(\"stderr should mention failed file, got: %q\", goStderr)\n332\t\t}\n333\t\n334\t\trefBin, err := exec.LookPath(\"gtee\")\n335\t\tif err != nil {\n336\t\t\tt.Skip(\"reference binary gtee not found\")\n337\t\t}\n338\t\trefExit, _, _ := runCapture(t, refBin, []byte(\"data\\n\"), badFile, goodFile)\n339\t\tif goExit != refExit {\n340\t\t\tt.Fatalf(\"exit code divergence: go=%d ref=%d\", goExit, refExit)\n341\t\t}\n342\t}\n343\t\n344\tfunc TestWriteErrorContinuesWriting(t *testing.T) {\n345\t\tgoBin := testutils.BuildBinary(t, \".\")\n346\t\tdir := t.TempDir()\n347\t\troDir := filepath.Join(dir, \"readonly\")\n348\t\tos.Mkdir(roDir, 0o555)\n349\t\tbadFile := filepath.Join(roDir, \"fail.txt\")\n350\t\tfileA := filepath.Join(dir, \"a.txt\")\n351\t\tfileB := filepath.Join(dir, \"b.txt\")\n352\t\n353\t\texit, stdout, _ := runCapture(t, goBin, []byte(\"hello\\n\"), fileA, badFile, fileB)\n354\t\tif exit != 1 {\n355\t\t\tt.Fatalf(\"expected exit 1, got %d\", exit)\n356\t\t}\n357\t\tif string(stdout) != \"hello\\n\" {\n358\t\t\tt.Fatalf(\"stdout: got %q, want %q\", stdout, \"hello\\n\")\n359\t\t}\n360\t\tfor _, p := range []string{fileA, fileB} {\n361\t\t\tgot, err := os.ReadFile(p)\n362\t\t\tif err != nil {\n363\t\t\t\tt.Fatalf(\"read %s: %v\", p, err)\n364\t\t\t}\n365\t\t\tif string(got) != \"hello\\n\" {\n366\t\t\t\tt.Fatalf(\"%s: got %q, want %q\", p, got, \"hello\\n\")\n367\t\t\t}\n368\t\t}\n369\t}\n370\t\n371\tfunc TestBrokenStdout(t *testing.T) {\n372\t\tgoBin := testutils.BuildBinary(t, \".\")\n373\t\tgoExit := runWithBrokenStdout(t, goBin)\n374\t\tif goExit != 1 {\n375\t\t\tt.Fatalf(\"expected exit 1, got %d\", goExit)\n376\t\t}\n377\t}\n378\t\n379\tfunc TestExitZeroOnSuccess(t *testing.T) {\n380\t\tgoBin := testutils.BuildBinary(t, \".\")\n381\t\tdir := t.TempDir()\n382\t\toutFile := filepath.Join(dir, \"out.txt\")\n383\t\tcmd := exec.Command(goBin, outFile)\n384\t\tcmd.Stdin = bytes.NewReader([]byte(\"ok\\n\"))\n385\t\tif err := cmd.Run(); err != nil {\n386\t\t\tt.Fatalf(\"expected exit 0, got: %v\", err)\n387\t\t}\n388\t}\n389\t\n390\tfunc runCapture(\n391\t\tt *testing.T, binary string, stdin []byte, args ...string,\n392\t) (int, []byte, []byte) {\n393\t\tt.Helper()\n394\t\tcmd := exec.Command(binary, args...)\n395\t\tcmd.Stdin = bytes.NewReader(stdin)\n396\t\tvar stdout, stderr bytes.Buffer\n397\t\tcmd.Stdout = &stdout\n398\t\tcmd.Stderr = &stderr\n399\t\terr := cmd.Run()\n400\t\tif err == nil {\n401\t\t\treturn 0, stdout.Bytes(), stderr.Bytes()\n402\t\t}\n403\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n404\t\t\treturn exitErr.ExitCode(), stdout.Bytes(), stderr.Bytes()\n405\t\t}\n406\t\tt.Fatalf(\"unexpected error: %v\", err)\n407\t\treturn -1, nil, nil\n408\t}\n409\t\n410\tfunc runWithBrokenStdout(t *testing.T, binary string) int {\n411\t\tt.Helper()\n412\t\tpr, pw, err := os.Pipe()\n413\t\tif err != nil {\n414\t\t\tt.Fatal(err)\n415\t\t}\n416\t\tcmd := exec.Command(binary)\n417\t\tcmd.Stdin = bytes.NewReader(bytes.Repeat([]byte(\"a\\n\"), 100000))\n418\t\tcmd.Stdout = pw\n419\t\tif err := cmd.Start(); err != nil {\n420\t\t\tpr.Close()\n421\t\t\tpw.Close()\n422\t\t\tt.Fatal(err)\n423\t\t}\n424\t\tpw.Close()\n425\t\tpr.Close()\n426\t\terr = cmd.Wait()\n427\t\tif err == nil {\n428\t\t\treturn 0\n429\t\t}\n430\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n431\t\t\treturn exitErr.ExitCode()\n432\t\t}\n433\t\tt.Fatalf(\"unexpected error: %v\", err)\n434\t\treturn -1\n435\t}\n436\t\n437\tfunc allBytes() []byte {\n438\t\tb := make([]byte, 256)\n439\t\tfor i := range b {\n440\t\t\tb[i] = byte(i)\n441\t\t}\n442\t\treturn b\n443\t}\n444\t"}]},"parent_tool_use_id":null,"session_id":"45b367c8-a543-4f51-9d2a-6e6621243c42","uuid":"cc948106-5967-46b2-afbd-da7564fed443","timestamp":"2026-05-14T12:34:01.488Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5160/cmd/tee/tee_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\ttests := []testutils.DiffTest{\n\t\t{Name: \"passthrough_no_files\", Stdin: []byte(\"hello\\nworld\\n\")},\n\t\t{Name: \"empty_stdin\", Stdin: []byte{}},\n\t\t{Name: \"large_input\", Stdin: bytes.Repeat([]byte(\"abcdefghij\\n\"), 1000)},\n\t\t{Name: \"no_trailing_newline\", Stdin: []byte(\"no newline\")},\n\t\t{Name: \"binary_data\", Stdin: allBytes()},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc TestDiffSingleFile(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\tinput := []byte(\"hello\\nworld\\n\")\n\trunFileTest(t, goBin, \"go_single\", input, \"out.txt\")\n\trunFileTest(t, refBin, \"ref_single\", input, \"out.txt\")\n}\n\nfunc TestDiffMultipleFiles(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\tinput := []byte(\"multi\\nfile\\ntest\\n\")\n\tgoStdout := runMultiFileTest(t, goBin, \"go_multi\", input, \"a.txt\", \"b.txt\")\n\trefStdout := runMultiFileTest(t, refBin, \"ref_multi\", input, \"a.txt\", \"b.txt\")\n\tif !bytes.Equal(goStdout, refStdout) {\n\t\tt.Fatalf(\"stdout divergence\\n  go:  %q\\n  ref: %q\", goStdout, refStdout)\n\t}\n}\n\nfunc TestDiffDashFile(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\tinput := []byte(\"dash test\\n\")\n\ttests := []testutils.DiffTest{\n\t\t{Name: \"dash_only\", Args: []string{\"-\"}, Stdin: input},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc TestDiffAppendMode(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\trunAppendTest(t, goBin, \"go_append\")\n\trunAppendTest(t, refBin, \"ref_append\")\n}\n\nfunc TestDiffAppendLongFlag(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\trunAppendTestLong(t, goBin, \"go_append_long\")\n\trunAppendTestLong(t, refBin, \"ref_append_long\")\n}\n\nfunc TestDiffCombinedFlags(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\tinput := []byte(\"combined\\n\")\n\ttests := []testutils.DiffTest{\n\t\t{Name: \"combined_ai\", Args: []string{\"-ai\"}, Stdin: input},\n\t\t{Name: \"combined_ia\", Args: []string{\"-ia\"}, Stdin: input},\n\t\t{Name: \"separate_a_i\", Args: []string{\"-a\", \"-i\"}, Stdin: input},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc TestDiffIgnoreInterrupts(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\tinput := []byte(\"interrupt test\\n\")\n\ttests := []testutils.DiffTest{\n\t\t{Name: \"ignore_interrupts_short\", Args: []string{\"-i\"}, Stdin: input},\n\t\t{Name: \"ignore_interrupts_long\", Args: []string{\"--ignore-interrupts\"}, Stdin: input},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc TestDiffWriteOrder(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\tvar ordered []byte\n\tfor i := range 100 {\n\t\tordered = fmt.Appendf(ordered, \"line %03d\\n\", i)\n\t}\n\ttests := []testutils.DiffTest{\n\t\t{Name: \"write_order\", Stdin: ordered},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc TestDiffMultiFileAppend(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\trunMultiFileAppendTest(t, goBin, \"go_multi_append\")\n\trunMultiFileAppendTest(t, refBin, \"ref_multi_append\")\n}\n\nfunc TestFileCreation(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tdir := t.TempDir()\n\toutFile := filepath.Join(dir, \"created.txt\")\n\tcmd := exec.Command(goBin, outFile)\n\tcmd.Stdin = bytes.NewReader([]byte(\"create me\\n\"))\n\tout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\tif string(out) != \"create me\\n\" {\n\t\tt.Fatalf(\"stdout: got %q, want %q\", out, \"create me\\n\")\n\t}\n\tgot, err := os.ReadFile(outFile)\n\tif err != nil {\n\t\tt.Fatalf(\"read created file: %v\", err)\n\t}\n\tif string(got) != \"create me\\n\" {\n\t\tt.Fatalf(\"file content: got %q, want %q\", got, \"create me\\n\")\n\t}\n}\n\nfunc TestTruncateExisting(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tdir := t.TempDir()\n\toutFile := filepath.Join(dir, \"existing.txt\")\n\tos.WriteFile(outFile, []byte(\"old content\\n\"), 0o644)\n\tcmd := exec.Command(goBin, outFile)\n\tcmd.Stdin = bytes.NewReader([]byte(\"new\\n\"))\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"unexpected error: %v\", err)\n\t}\n\tgot, err := os.ReadFile(outFile)\n\tif err != nil {\n\t\tt.Fatalf(\"read file: %v\", err)\n\t}\n\tif string(got) != \"new\\n\" {\n\t\tt.Fatalf(\"file content: got %q, want %q\", got, \"new\\n\")\n\t}\n}\n\nfunc runFileTest(t *testing.T, binary, label string, input []byte, fileName string) {\n\tt.Helper()\n\tdir := t.TempDir()\n\toutPath := filepath.Join(dir, fileName)\n\tcmd := exec.Command(binary, outPath)\n\tcmd.Stdin = bytes.NewReader(input)\n\tstdout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n\t}\n\tif !bytes.Equal(stdout, input) {\n\t\tt.Fatalf(\"%s: stdout divergence\\n  got:  %q\\n  want: %q\", label, stdout, input)\n\t}\n\tgot, err := os.ReadFile(outPath)\n\tif err != nil {\n\t\tt.Fatalf(\"%s: read output file: %v\", label, err)\n\t}\n\tif !bytes.Equal(got, input) {\n\t\tt.Fatalf(\"%s: file content divergence\\n  got:  %q\\n  want: %q\", label, got, input)\n\t}\n}\n\nfunc runMultiFileTest(\n\tt *testing.T, binary, label string, input []byte, names ...string,\n) []byte {\n\tt.Helper()\n\tdir := t.TempDir()\n\tvar paths []string\n\tfor _, n := range names {\n\t\tpaths = append(paths, filepath.Join(dir, n))\n\t}\n\tcmd := exec.Command(binary, paths...)\n\tcmd.Stdin = bytes.NewReader(input)\n\tstdout, err := cmd.Output()\n\tif err != nil {\n\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n\t}\n\tfor _, p := range paths {\n\t\tgot, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"%s: read %s: %v\", label, p, err)\n\t\t}\n\t\tif !bytes.Equal(got, input) {\n\t\t\tt.Fatalf(\"%s: %s divergence\\n  got:  %q\\n  want: %q\", label, p, got, input)\n\t\t}\n\t}\n\treturn stdout\n}\n\nfunc runAppendTest(t *testing.T, binary, label string) {\n\tt.Helper()\n\tdir := t.TempDir()\n\toutFile := filepath.Join(dir, \"append.txt\")\n\tos.WriteFile(outFile, []byte(\"existing\\n\"), 0o644)\n\tcmd := exec.Command(binary, \"-a\", outFile)\n\tcmd.Stdin = bytes.NewReader([]byte(\"appended\\n\"))\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n\t}\n\tgot, err := os.ReadFile(outFile)\n\tif err != nil {\n\t\tt.Fatalf(\"%s: read file: %v\", label, err)\n\t}\n\twant := \"existing\\nappended\\n\"\n\tif string(got) != want {\n\t\tt.Fatalf(\"%s: file content\\n  got:  %q\\n  want: %q\", label, got, want)\n\t}\n}\n\nfunc runAppendTestLong(t *testing.T, binary, label string) {\n\tt.Helper()\n\tdir := t.TempDir()\n\toutFile := filepath.Join(dir, \"append_long.txt\")\n\tos.WriteFile(outFile, []byte(\"existing\\n\"), 0o644)\n\tcmd := exec.Command(binary, \"--append\", outFile)\n\tcmd.Stdin = bytes.NewReader([]byte(\"appended\\n\"))\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n\t}\n\tgot, err := os.ReadFile(outFile)\n\tif err != nil {\n\t\tt.Fatalf(\"%s: read file: %v\", label, err)\n\t}\n\twant := \"existing\\nappended\\n\"\n\tif string(got) != want {\n\t\tt.Fatalf(\"%s: file content\\n  got:  %q\\n  want: %q\", label, got, want)\n\t}\n}\n\nfunc runMultiFileAppendTest(t *testing.T, binary, label string) {\n\tt.Helper()\n\tdir := t.TempDir()\n\tfileA := filepath.Join(dir, \"a.txt\")\n\tfileB := filepath.Join(dir, \"b.txt\")\n\tos.WriteFile(fileA, []byte(\"old_a\\n\"), 0o644)\n\tos.WriteFile(fileB, []byte(\"old_b\\n\"), 0o644)\n\tcmd := exec.Command(binary, \"-a\", fileA, fileB)\n\tcmd.Stdin = bytes.NewReader([]byte(\"new\\n\"))\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n\t}\n\tgotA, err := os.ReadFile(fileA)\n\tif err != nil {\n\t\tt.Fatalf(\"%s: read a.txt: %v\", label, err)\n\t}\n\tgotB, err := os.ReadFile(fileB)\n\tif err != nil {\n\t\tt.Fatalf(\"%s: read b.txt: %v\", label, err)\n\t}\n\twantA := \"old_a\\nnew\\n\"\n\twantB := \"old_b\\nnew\\n\"\n\tif string(gotA) != wantA {\n\t\tt.Fatalf(\"%s: a.txt\\n  got:  %q\\n  want: %q\", label, gotA, wantA)\n\t}\n\tif string(gotB) != wantB {\n\t\tt.Fatalf(\"%s: b.txt\\n  got:  %q\\n  want: %q\", label, gotB, wantB)\n\t}\n}\n\nfunc TestWriteErrorReadOnly(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tdir := t.TempDir()\n\troDir := filepath.Join(dir, \"readonly\")\n\tos.Mkdir(roDir, 0o555)\n\tbadFile := filepath.Join(roDir, \"nope.txt\")\n\tgoodFile := filepath.Join(dir, \"good.txt\")\n\n\tgoExit, goStdout, goStderr := runCapture(t, goBin, []byte(\"data\\n\"), badFile, goodFile)\n\tif goExit != 1 {\n\t\tt.Fatalf(\"expected exit 1, got %d\", goExit)\n\t}\n\tif string(goStdout) != \"data\\n\" {\n\t\tt.Fatalf(\"stdout: got %q, want %q\", goStdout, \"data\\n\")\n\t}\n\tgot, err := os.ReadFile(goodFile)\n\tif err != nil {\n\t\tt.Fatalf(\"read good file: %v\", err)\n\t}\n\tif string(got) != \"data\\n\" {\n\t\tt.Fatalf(\"good file: got %q, want %q\", got, \"data\\n\")\n\t}\n\tif !strings.Contains(string(goStderr), \"nope.txt\") {\n\t\tt.Fatalf(\"stderr should mention failed file, got: %q\", goStderr)\n\t}\n\n\trefBin, err := exec.LookPath(\"gtee\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gtee not found\")\n\t}\n\trefExit, _, _ := runCapture(t, refBin, []byte(\"data\\n\"), badFile, goodFile)\n\tif goExit != refExit {\n\t\tt.Fatalf(\"exit code divergence: go=%d ref=%d\", goExit, refExit)\n\t}\n}\n\nfunc TestWriteErrorContinuesWriting(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tdir := t.TempDir()\n\troDir := filepath.Join(dir, \"readonly\")\n\tos.Mkdir(roDir, 0o555)\n\tbadFile := filepath.Join(roDir, \"fail.txt\")\n\tfileA := filepath.Join(dir, \"a.txt\")\n\tfileB := filepath.Join(dir, \"b.txt\")\n\n\texit, stdout, _ := runCapture(t, goBin, []byte(\"hello\\n\"), fileA, badFile, fileB)\n\tif exit != 1 {\n\t\tt.Fatalf(\"expected exit 1, got %d\", exit)\n\t}\n\tif string(stdout) != \"hello\\n\" {\n\t\tt.Fatalf(\"stdout: got %q, want %q\", stdout, \"hello\\n\")\n\t}\n\tfor _, p := range []string{fileA, fileB} {\n\t\tgot, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"read %s: %v\", p, err)\n\t\t}\n\t\tif string(got) != \"hello\\n\" {\n\t\t\tt.Fatalf(\"%s: got %q, want %q\", p, got, \"hello\\n\")\n\t\t}\n\t}\n}\n\nfunc TestBrokenStdout(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tgoExit := runWithBrokenStdout(t, goBin)\n\tif goExit != 1 {\n\t\tt.Fatalf(\"expected exit 1, got %d\", goExit)\n\t}\n}\n\nfunc TestExitZeroOnSuccess(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tdir := t.TempDir()\n\toutFile := filepath.Join(dir, \"out.txt\")\n\tcmd := exec.Command(goBin, outFile)\n\tcmd.Stdin = bytes.NewReader([]byte(\"ok\\n\"))\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"expected exit 0, got: %v\", err)\n\t}\n}\n\nfunc runCapture(\n\tt *testing.T, binary string, stdin []byte, args ...string,\n) (int, []byte, []byte) {\n\tt.Helper()\n\tcmd := exec.Command(binary, args...)\n\tcmd.Stdin = bytes.NewReader(stdin)\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\terr := cmd.Run()\n\tif err == nil {\n\t\treturn 0, stdout.Bytes(), stderr.Bytes()\n\t}\n\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n\t\treturn exitErr.ExitCode(), stdout.Bytes(), stderr.Bytes()\n\t}\n\tt.Fatalf(\"unexpected error: %v\", err)\n\treturn -1, nil, nil\n}\n\nfunc runWithBrokenStdout(t *testing.T, binary string) int {\n\tt.Helper()\n\tpr, pw, err := os.Pipe()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcmd := exec.Command(binary)\n\tcmd.Stdin = bytes.NewReader(bytes.Repeat([]byte(\"a\\n\"), 100000))\n\tcmd.Stdout = pw\n\tif err := cmd.Start(); err != nil {\n\t\tpr.Close()\n\t\tpw.Close()\n\t\tt.Fatal(err)\n\t}\n\tpw.Close()\n\tpr.Close()\n\terr = cmd.Wait()\n\tif err == nil {\n\t\treturn 0\n\t}\n\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n\t\treturn exitErr.ExitCode()\n\t}\n\tt.Fatalf(\"unexpected error: %v\", err)\n\treturn -1\n}\n\nfunc allBytes() []byte {\n\tb := make([]byte, 256)\n\tfor i := range b {\n\t\tb[i] = byte(i)\n\t}\n\treturn b\n}\n","numLines":444,"star