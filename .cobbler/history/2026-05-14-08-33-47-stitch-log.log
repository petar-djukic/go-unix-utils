{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0117sZRUStSDcdeXRjJ3ce4J","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"strings\"\n14\t\t\"testing\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n17\t)\n18\t\n19\tfunc TestDiff(t *testing.T) {\n20\t\tgoBin := testutils.BuildBinary(t, \".\")\n21\t\trefBin, err := exec.LookPath(\"gtee\")\n22\t\tif err != nil {\n23\t\t\tt.Skip(\"reference binary gtee not found\")\n24\t\t}\n25\t\ttests := []testutils.DiffTest{\n26\t\t\t{Name: \"passthrough_no_files\", Stdin: []byte(\"hello\\nworld\\n\")},\n27\t\t\t{Name: \"empty_stdin\", Stdin: []byte{}},\n28\t\t\t{Name: \"large_input\", Stdin: bytes.Repeat([]byte(\"abcdefghij\\n\"), 1000)},\n29\t\t\t{Name: \"no_trailing_newline\", Stdin: []byte(\"no newline\")},\n30\t\t\t{Name: \"binary_data\", Stdin: allBytes()},\n31\t\t}\n32\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n33\t}\n34\t\n35\tfunc TestDiffSingleFile(t *testing.T) {\n36\t\tgoBin := testutils.BuildBinary(t, \".\")\n37\t\trefBin, err := exec.LookPath(\"gtee\")\n38\t\tif err != nil {\n39\t\t\tt.Skip(\"reference binary gtee not found\")\n40\t\t}\n41\t\tinput := []byte(\"hello\\nworld\\n\")\n42\t\trunFileTest(t, goBin, \"go_single\", input, \"out.txt\")\n43\t\trunFileTest(t, refBin, \"ref_single\", input, \"out.txt\")\n44\t}\n45\t\n46\tfunc TestDiffMultipleFiles(t *testing.T) {\n47\t\tgoBin := testutils.BuildBinary(t, \".\")\n48\t\trefBin, err := exec.LookPath(\"gtee\")\n49\t\tif err != nil {\n50\t\t\tt.Skip(\"reference binary gtee not found\")\n51\t\t}\n52\t\tinput := []byte(\"multi\\nfile\\ntest\\n\")\n53\t\tgoStdout := runMultiFileTest(t, goBin, \"go_multi\", input, \"a.txt\", \"b.txt\")\n54\t\trefStdout := runMultiFileTest(t, refBin, \"ref_multi\", input, \"a.txt\", \"b.txt\")\n55\t\tif !bytes.Equal(goStdout, refStdout) {\n56\t\t\tt.Fatalf(\"stdout divergence\\n  go:  %q\\n  ref: %q\", goStdout, refStdout)\n57\t\t}\n58\t}\n59\t\n60\tfunc TestDiffDashFile(t *testing.T) {\n61\t\tgoBin := testutils.BuildBinary(t, \".\")\n62\t\trefBin, err := exec.LookPath(\"gtee\")\n63\t\tif err != nil {\n64\t\t\tt.Skip(\"reference binary gtee not found\")\n65\t\t}\n66\t\tinput := []byte(\"dash test\\n\")\n67\t\ttests := []testutils.DiffTest{\n68\t\t\t{Name: \"dash_only\", Args: []string{\"-\"}, Stdin: input},\n69\t\t}\n70\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n71\t}\n72\t\n73\tfunc TestDiffAppendMode(t *testing.T) {\n74\t\tgoBin := testutils.BuildBinary(t, \".\")\n75\t\trefBin, err := exec.LookPath(\"gtee\")\n76\t\tif err != nil {\n77\t\t\tt.Skip(\"reference binary gtee not found\")\n78\t\t}\n79\t\trunAppendTest(t, goBin, \"go_append\")\n80\t\trunAppendTest(t, refBin, \"ref_append\")\n81\t}\n82\t\n83\tfunc TestDiffAppendLongFlag(t *testing.T) {\n84\t\tgoBin := testutils.BuildBinary(t, \".\")\n85\t\trefBin, err := exec.LookPath(\"gtee\")\n86\t\tif err != nil {\n87\t\t\tt.Skip(\"reference binary gtee not found\")\n88\t\t}\n89\t\trunAppendTestLong(t, goBin, \"go_append_long\")\n90\t\trunAppendTestLong(t, refBin, \"ref_append_long\")\n91\t}\n92\t\n93\tfunc TestDiffCombinedFlags(t *testing.T) {\n94\t\tgoBin := testutils.BuildBinary(t, \".\")\n95\t\trefBin, err := exec.LookPath(\"gtee\")\n96\t\tif err != nil {\n97\t\t\tt.Skip(\"reference binary gtee not found\")\n98\t\t}\n99\t\tinput := []byte(\"combined\\n\")\n100\t\ttests := []testutils.DiffTest{\n101\t\t\t{Name: \"combined_ai\", Args: []string{\"-ai\"}, Stdin: input},\n102\t\t\t{Name: \"combined_ia\", Args: []string{\"-ia\"}, Stdin: input},\n103\t\t\t{Name: \"separate_a_i\", Args: []string{\"-a\", \"-i\"}, Stdin: input},\n104\t\t}\n105\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n106\t}\n107\t\n108\tfunc TestDiffIgnoreInterrupts(t *testing.T) {\n109\t\tg