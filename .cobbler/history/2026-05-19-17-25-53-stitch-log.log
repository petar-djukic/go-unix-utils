var prevKey string\n218\t\tcount := 0\n219\t\tfor scanner.Scan() {\n220\t\t\tline := scanner.Text()\n221\t\t\tkey := comparisonKey(line, opts)\n222\t\t\tif first {\n223\t\t\t\tprev = line\n224\t\t\t\tprevKey = key\n225\t\t\t\tcount = 1\n226\t\t\t\tfirst = false\n227\t\t\t\tcontinue\n228\t\t\t}\n229\t\t\tif key == prevKey {\n230\t\t\t\tcount++\n231\t\t\t\tcontinue\n232\t\t\t}\n233\t\t\tif err := emitRun(w, prev, count, opts); err != nil {\n234\t\t\t\treturn 1\n235\t\t\t}\n236\t\t\tprev = line\n237\t\t\tprevKey = key\n238\t\t\tcount = 1\n239\t\t}\n240\t\tif !first {\n241\t\t\tif err := emitRun(w, prev, count, opts); err != nil {\n242\t\t\t\treturn 1\n243\t\t\t}\n244\t\t}\n245\t\tif err := w.Flush(); err != nil {\n246\t\t\treturn 1\n247\t\t}\n248\t\treturn 0\n249\t}\n250\t\n251\tfunc emitRun(w *bufio.Writer, line string, count int, opts options) error {\n252\t\tn := runCopies(count, opts)\n253\t\tfor range n {\n254\t\t\tif opts.count {\n255\t\t\t\tif _, err := fmt.Fprintf(w, \"%7d %s\\n\", count, line); err != nil {\n256\t\t\t\t\treturn err\n257\t\t\t\t}\n258\t\t\t} else {\n259\t\t\t\tif _, err := w.WriteString(line); err != nil {\n260\t\t\t\t\treturn err\n261\t\t\t\t}\n262\t\t\t\tif err := w.WriteByte('\\n'); err != nil {\n263\t\t\t\t\treturn err\n264\t\t\t\t}\n265\t\t\t}\n266\t\t}\n267\t\treturn nil\n268\t}\n269\t\n270\tfunc runCopies(count int, opts options) int {\n271\t\tif (opts.repeated || opts.allRepeated) && opts.unique {\n272\t\t\treturn 0\n273\t\t}\n274\t\tif opts.allRepeated {\n275\t\t\tif count > 1 {\n276\t\t\t\treturn count\n277\t\t\t}\n278\t\t\treturn 0\n279\t\t}\n280\t\tif opts.repeated {\n281\t\t\tif count > 1 {\n282\t\t\t\treturn 1\n283\t\t\t}\n284\t\t\treturn 0\n285\t\t}\n286\t\tif opts.unique {\n287\t\t\tif count == 1 {\n288\t\t\t\treturn 1\n289\t\t\t}\n290\t\t\treturn 0\n291\t\t}\n292\t\treturn 1\n293\t}\n294\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analy