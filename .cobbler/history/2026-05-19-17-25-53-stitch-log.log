t.Errorf(\"extra operand '%s'\", positional[2])\n72\t\t}\n73\t\treturn opts, inputFile, outputFile, nil\n74\t}\n75\t\n76\tfunc parseFlags(opts *options, args []string, i int) (int, error) {\n77\t\tflagStr := args[i][1:]\n78\t\tfor j := 0; j < len(flagStr); j++ {\n79\t\t\tch := rune(flagStr[j])\n80\t\t\tswitch ch {\n81\t\t\tcase 'f', 's', 'w':\n82\t\t\t\trest := flagStr[j+1:]\n83\t\t\t\tif len(rest) == 0 {\n84\t\t\t\t\ti++\n85\t\t\t\t\tif i >= len(args) {\n86\t\t\t\t\t\treturn i, fmt.Errorf(\"option requires an argument -- '%c'\", ch)\n87\t\t\t\t\t}\n88\t\t\t\t\trest = args[i]\n89\t\t\t\t}\n90\t\t\t\tn, err := strconv.Atoi(rest)\n91\t\t\t\tif err != nil {\n92\t\t\t\t\treturn i, fmt.Errorf(\"invalid number of %s: '%s'\", flagDescription(ch), rest)\n93\t\t\t\t}\n94\t\t\t\tsetNumericOpt(opts, ch, n)\n95\t\t\t\treturn i, nil\n96\t\t\tdefault:\n97\t\t\t\tif err := parseFlag(opts, ch); err != nil {\n98\t\t\t\t\treturn i, err\n99\t\t\t\t}\n100\t\t\t}\n101\t\t}\n102\t\treturn i, nil\n103\t}\n104\t\n105\tfunc flagDescription(ch rune) string {\n106\t\tswitch ch {\n107\t\tcase 'f':\n108\t\t\treturn \"fields to skip\"\n109\t\tcase 's':\n110\t\t\treturn \"bytes to skip\"\n111\t\tdefault:\n112\t\t\treturn \"bytes to compare\"\n113\t\t}\n114\t}\n115\t\n116\tfunc setNumericOpt(opts *options, ch rune, n int) {\n117\t\tswitch ch {\n118\t\tcase 'f':\n119\t\t\topts.skipFields = n\n120\t\tcase 's':\n121\t\t\topts.skipChars = n\n122\t\tcase 'w':\n123\t\t\topts.checkChars = n\n124\t\t}\n125\t}\n126\t\n127\tfunc parseFlag(opts *options, ch rune) error {\n128\t\tswitch ch {\n129\t\tcase 'c':\n130\t\t\topts.count = true\n131\t\tcase 'd':\n132\t\t\topts.repeated = true\n133\t\tcase 'D':\n134\t\t\topts.allRepeated = true\n135\t\tcase 'u':\n136\t\t\topts.unique = true\n137\t\tcase 'i':\n138\t\t\topts.ignoreCase = true\n139\t\tdefault:\n140\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", ch)\n141\t\t}\n142\t\treturn nil\n143\t}\n144\t\n145\tfunc run(w *bufio.Writer, opts options, inputFile, ou