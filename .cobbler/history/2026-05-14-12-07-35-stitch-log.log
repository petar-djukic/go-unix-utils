{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018zdGapof4N9jGFUfC9jqM5","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"strings\"\n12\t\t\"unicode\"\n13\t\t\"unicode/utf8\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype options struct {\n19\t\tprintLines bool\n20\t\tprintWords bool\n21\t\tprintBytes bool\n22\t\tprintChars bool\n23\t\tprintMax   bool\n24\t\ttotalMode  string\n25\t\tfiles0From string\n26\t}\n27\t\n28\ttype counts struct {\n29\t\tlines   int64\n30\t\twords   int64\n31\t\tbytes   int64\n32\t\tchars   int64\n33\t\tmaxLine int64\n34\t}\n35\t\n36\tfunc main() {\n37\t\tsys.InstallSIGPIPEHandler()\n38\t\topts, files := parseArgs(os.Args[1:])\n39\t\texitCode := run(opts, files, os.Stdout, os.Stderr)\n40\t\tos.Exit(exitCode)\n41\t}\n42\t\n43\tfunc run(opts options, files []string, stdout io.Writer, stderr io.Writer) int {\n44\t\tif noFlagsSet(opts) {\n45\t\t\topts.printLines = true\n46\t\t\topts.printWords = true\n47\t\t\topts.printBytes = true\n48\t\t}\n49\t\tif opts.totalMode == \"\" {\n50\t\t\topts.totalMode = \"auto\"\n51\t\t}\n52\t\n53\t\tif opts.files0From != \"\" {\n54\t\t\textra, err := readFiles0From(opts.files0From)\n55\t\t\tif err != nil {\n56\t\t\t\tfmt.Fprintf(stderr, \"wc: %s\\n\", err)\n57\t\t\t\treturn 1\n58\t\t\t}\n59\t\t\tfiles = append(files, extra...)\n60\t\t}\n61\t\n62\t\tif len(files) == 0 {\n63\t\t\tfiles = []string{\"-\"}\n64\t\t}\n65\t\n66\t\twidth := computeWidth(files, countColumns(opts))\n67\t\tresults, names, hadError := processFiles(files, stderr)\n68\t\tprintResults(stdout, opts, results, names, width)\n69\t\tif hadError {\n70\t\t\treturn 1\n71\t\t}\n72\t\treturn 0\n73\t}\n74\t\n75\tfunc noFlagsSet(opts options) bool {\n76\t\treturn !opts.printLines && !opts.printWords &&\n77\t\t\t!opts.printBytes && !opts.printChars && !opts.printMax\n78\t}\n79\t\n80\tfunc processFiles(files []string, stderr io.Writer) ([]counts, []string, bool) {\n81\t\tresults := make([]counts, 0, len(files))\n82\t\tnames := make([]string, 0, len(files))\n83\t\thadError := false\n84\t\n85\t\tfor _, f := range files {\n86\t\t\tc, err := countFile(f)\n87\t\t\tif err != nil {\n88\t\t\t\tfmt.Fprintf(stderr, \"wc: %s\\n\", err)\n89\t\t\t\thadError = true\n90\t\t\t\tcontinue\n91\t\t\t}\n92\t\t\tresults = append(results, c)\n93\t\t\tif f == \"-\" {\n94\t\t\t\tnames = append(names, \"\")\n95\t\t\t} else {\n96\t\t\t\tnames = append(names, f)\n97\t\t\t}\n98\t\t}\n99\t\treturn results, names, hadError\n100\t}\n101\t\n102\tfunc countFile(name string) (counts, error) {\n103\t\tvar r io.Reader\n104\t\tif name == \"-\" {\n105\t\t\tr = os.Stdin\n106\t\t} else {\n107\t\t\tf, err := os.Open(name)\n108\t\t\tif err != nil {\n109\t\t\t\treturn counts{}, fmt.Errorf(\"%s: %s\", name, err.(*os.PathError).Err)\n110\t\t\t}\n111\t\t\tdefer f.Close()\n112\t\t\tr = f\n113\t\t}\n114\t\treturn countReader(r)\n115\t}\n116\t\n117\tfunc countReader(r io.Reader) (counts, error) {\n118\t\tvar c counts\n119\t\tbr := bufio.NewReader(r)\n120\t\tinWord := false\n121\t\tlineLen := int64(0)\n122\t\n123\t\tbuf := make([]byte, 32*1024)\n124\t\tfor {\n125\t\t\tn, err := br.Read(buf)\n126\t\t\tc.bytes += int64(n)\n127\t\t\tprocessChunk(buf[:n], &c, &inWord, &lineLen)\n128\t\t\tif err == io.EOF {\n129\t\t\t\tbreak\n130\t\t\t}\n131\t\t\tif err != nil {\n132\t\t\t\treturn c, err\n133\t\t\t}\n134\t\t}\n135\t\n136\t\tif lineLen > c.maxLine {\n137\t\t\tc.maxLine = lineLen\n138\t\t}\n139\t\treturn c, nil\n140\t}\n141\t\n142\tfunc processChunk(data []byte, c *counts, inWord *bool, lineLen *int64) {\n143\t\ti := 0\n144\t\tfor i < len(data) {\n145\t\t\tr, size := utf8.DecodeRune(data[i:])\n146\t\t\tif r == utf8.RuneError && size == 1 {\n147\t\t\t\tc.chars++\n148\t\t\t\tprocessNonSpaceByte(data[i], c, inWord, lineLen)\n149\t\t\t\ti++\n150\t\t\t\tcontinue\n151\t\t\t}\n152\t\t\tc.chars++\n153\t\t\tif r == '\\n' {\n154\t\t\t\tc.lines++\n155\t\t\t\thandleNewline(c, inWord, lineLen)\n156\t\t\t} else if r == '\\t' {\n157\t\t\t\thandleTab(inWord, lineLen)\n158\t\t\t} else if unicode.IsSpace(r) {\n159\t\t\t\t*inWord = false\n160\t\t\t\t*lineLen++\n161\t\t\t} else {\n162\t\t\t\tif !*inWord {\n163\t\t\t\t\tc.words++\n164\t\t\t\t\t*inWord = true\n165\t\t\t\t}\n166\t\t\t\t*lineLen++\n167\t\t\t}\n168\t\t\ti += size\n169\t\t}\n170\t}\n171\t\n172\tfunc processNonSpaceByte(b byte, c *counts, inWord *bool, lineLen *int64) {\n173\t\tswitch b {\n174\t\tcase '\\n':\n175\t\t\tc.lines++\n176\t\t\thandleNewline(c, inWord, lineLen)\n177\t\tcase '\\t':\n178\t\t\thandleTab(inWord, lineLen)\n179\t\tcase ' ', '\\r', '\\f', '\\v':\n180\t\t\t*inWord = false\n181\t\t\t*lineLen++\n182\t\tdefault:\n183\t\t\tif !*inWord {\n184\t\t\t\tc.words++\n185\t\t\t\t*inWord = true\n186\t\t\t}\n187\t\t\t*lineLen++\n188\t\t}\n189\t}\n190\t\n191\tfunc handleNewline(c *counts, inWord *bool, lineLen *int64) {\n192\t\t*inWord = false\n193\t\tif *lineLen > c.maxLine {\n194\t\t\tc.maxLine = *lineLen\n195\t\t}\n196\t\t*lineLen = 0\n197\t}\n198\t\n199\tfunc handleTab(inWord *bool, lineLen *int64) {\n200\t\t*inWord = false\n201\t\t*lineLen = (*lineLen/8 + 1) * 8\n202\t}\n203\t\n204\tfunc printResults(w io.Writer, opts options, results []counts, names []string, width int) {\n205\t\ttotal := sumCounts(results)\n206\t\tshowTotal := shouldShowTotal(opts.totalMode, len(results))\n207\t\n208\t\tif opts.totalMode != \"only\" {\n209\t\t\tfor i, c := range results {\n210\t\t\t\tprintLine(w, opts, c, names[i], width)\n211\t\t\t}\n212\t\t}\n213\t\tif showTotal {\n214\t\t\tprintLine(w, opts, total, \"total\", width)\n215\t\t}\n216\t}\n217\t\n218\tfunc sumCounts(results []counts) counts {\n219\t\tvar total counts\n220\t\tfor _, c := range results {\n221\t\t\ttotal.lines += c.lines\n222\t\t\ttotal.words += c.words\n223\t\t\ttotal.bytes += c.bytes\n224\t\t\ttotal.chars += c.chars\n225\t\t\tif c.maxLine > total.maxLine {\n226\t\t\t\ttotal.maxLine = c.maxLine\n227\t\t\t}\n228\t\t}\n229\t\treturn total\n230\t}\n231\t\n232\tfunc shouldShowTotal(mode string, n int) bool {\n233\t\tswitch mode {\n234\t\tcase \"always\":\n235\t\t\treturn true\n236\t\tcase \"only\":\n237\t\t\treturn true\n238\t\tcase \"never\":\n239\t\t\treturn false\n240\t\tdefault:\n241\t\t\treturn n > 1\n242\t\t}\n243\t}\n244\t\n245\tfunc countColumns(opts options) int {\n246\t\tn := 0\n247\t\tif opts.printLines {\n248\t\t\tn++\n249\t\t}\n250\t\tif opts.printWords {\n251\t\t\tn++\n252\t\t}\n253\t\tif opts.printChars {\n254\t\t\tn++\n255\t\t}\n256\t\tif opts.printBytes {\n257\t\t\tn++\n258\t\t}\n259\t\tif opts.printMax {\n260\t\t\tn++\n261\t\t}\n262\t\treturn n\n263\t}\n264\t\n265\tfunc computeWidth(files []string, numColumns int) int {\n266\t\ttotalSize := int64(0)\n267\t\thasRegular := false\n268\t\tfor _, f := range files {\n269\t\t\tif f == \"-\" {\n270\t\t\t\tcontinue\n271\t\t\t}\n272\t\t\tinfo, err := os.Stat(f)\n273\t\t\tif err != nil || !info.Mode().IsRegular() {\n274\t\t\t\tcontinue\n275\t\t\t}\n276\t\t\ttotalSize += info.Size()\n277\t\t\thasRegular = true\n278\t\t}\n279\t\tminWidth := 1\n280\t\tif numColumns > 1 && !hasRegular {\n281\t\t\tminWidth = 7\n282\t\t}\n283\t\tif hasRegular {\n284\t\t\treturn max(len(fmt.Sprintf(\"%d\", totalSize)), minWidth)\n285\t\t}\n286\t\treturn minWidth\n287\t}\n288\t\n289\tfunc printLine(w io.Writer, opts options, c counts, name string, width int) {\n290\t\tfields := collectFields(opts, c, width)\n291\t\tline := strings.Join(fields, \" \")\n292\t\tif name != \"\" {\n293\t\t\tline += \" \" + name\n294\t\t}\n295\t\tfmt.Fprintln(w, line)\n296\t}\n297\t\n298\tfunc collectFields(opts options, c counts, width int) []string {\n299\t\tfields := make([]string, 0, 5)\n300\t\tif opts.printLines {\n301\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.lines))\n302\t\t}\n303\t\tif opts.printWords {\n304\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.words))\n305\t\t}\n306\t\tif opts.printChars {\n307\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.chars))\n308\t\t}\n309\t\tif opts.printBytes {\n310\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.bytes))\n311\t\t}\n312\t\tif opts.printMax {\n313\t\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.maxLine))\n314\t\t}\n315\t\treturn fields\n316\t}\n317\t\n318\tfunc readFiles0From(path string) ([]string, error) {\n319\t\tvar r io.Reader\n320\t\tif path == \"-\" {\n321\t\t\tr = os.Stdin\n322\t\t} else {\n323\t\t\tf, err := os.Open(path)\n324\t\t\tif err != nil {\n325\t\t\t\treturn nil, err\n326\t\t\t}\n327\t\t\tdefer f.Close()\n328\t\t\tr = f\n329\t\t}\n330\t\tdata, err := io.ReadAll(r)\n331\t\tif err != nil {\n332\t\t\treturn nil, err\n333\t\t}\n334\t\tif len(data) == 0 {\n335\t\t\treturn nil, nil\n336\t\t}\n337\t\tparts := strings.Split(string(data), \"\\x00\")\n338\t\tif parts[len(parts)-1] == \"\" {\n339\t\t\tparts = parts[:len(parts)-1]\n340\t\t}\n341\t\treturn parts, nil\n342\t}\n343\t\n344\tfunc parseArgs(args []string) (options, []string) {\n345\t\tvar opts options\n346\t\tvar files []string\n347\t\ti := 0\n348\t\tfor i < len(args) {\n349\t\t\targ := args[i]\n350\t\t\tif arg == \"--\" {\n351\t\t\t\tfiles = append(files, args[i+1:]...)\n352\t\t\t\tbreak\n353\t\t\t}\n354\t\t\tif handled, advance := parseLongFlag(arg, args[i:], &opts); handled {\n355\t\t\t\ti += advance\n356\t\t\t\tcontinue\n357\t\t\t}\n358\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n359\t\t\t\tfiles = append(files, arg)\n360\t\t\t\ti++\n361\t\t\t\tcontinue\n362\t\t\t}\n363\t\t\ti += parseShortFlags(arg[1:], &opts)\n364\t\t}\n365\t\treturn opts, files\n366\t}\n367\t\n368\tfunc parseLongFlag(arg string, _ []string, opts *options) (bool, int) {\n369\t\tif !strings.HasPrefix(arg, \"--\") {\n370\t\t\treturn false, 0\n371\t\t}\n372\t\tswitch {\n373\t\tcase arg == \"--lines\":\n374\t\t\topts.printLines = true\n375\t\tcase arg == \"--words\":\n376\t\t\topts.printWords = true\n377\t\tcase arg == \"--bytes\":\n378\t\t\topts.printBytes = true\n379\t\tcase arg == \"--chars\":\n380\t\t\topts.printChars = true\n381\t\tcase arg == \"--max-line-length\":\n382\t\t\topts.printMax = true\n383\t\tcase strings.HasPrefix(arg, \"--total=\"):\n384\t\t\topts.totalMode = arg[len(\"--total=\"):]\n385\t\tcase strings.HasPrefix(arg, \"--files0-from=\"):\n386\t\t\topts.files0From = arg[len(\"--files0-from=\"):]\n387\t\tdefault:\n388\t\t\treturn false, 0\n389\t\t}\n390\t\treturn true, 1\n391\t}\n392\t\n393\tfunc parseShortFlags(flags string, opts *options) int {\n394\t\tfor _, ch := range flags {\n395\t\t\tswitch ch {\n396\t\t\tcase 'l':\n397\t\t\t\topts.printLines = true\n398\t\t\tcase 'w':\n399\t\t\t\topts.printWords = true\n400\t\t\tcase 'c':\n401\t\t\t\topts.printBytes = true\n402\t\t\tcase 'm':\n403\t\t\t\topts.printChars = true\n404\t\t\tcase 'L':\n405\t\t\t\topts.printMax = true\n406\t\t\t}\n407\t\t}\n408\t\treturn 1\n409\t}\n410\t"}]},"parent_tool_use_id":null,"session_id":"d3473b47-a5a0-4e0d-947b-e76c77cbd5fa","uuid":"4b06cb72-1d36-4a60-9e54-cf5bc26b9d9a","timestamp":"2026-05-14T16:07:44.714Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5178/cmd/wc/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\t\"unicode\"\n\t\"unicode/utf8\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype options struct {\n\tprintLines bool\n\tprintWords bool\n\tprintBytes bool\n\tprintChars bool\n\tprintMax   bool\n\ttotalMode  string\n\tfiles0From string\n}\n\ntype counts struct {\n\tlines   int64\n\twords   int64\n\tbytes   int64\n\tchars   int64\n\tmaxLine int64\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, files := parseArgs(os.Args[1:])\n\texitCode := run(opts, files, os.Stdout, os.Stderr)\n\tos.Exit(exitCode)\n}\n\nfunc run(opts options, files []string, stdout io.Writer, stderr io.Writer) int {\n\tif noFlagsSet(opts) {\n\t\topts.printLines = true\n\t\topts.printWords = true\n\t\topts.printBytes = true\n\t}\n\tif opts.totalMode == \"\" {\n\t\topts.totalMode = \"auto\"\n\t}\n\n\tif opts.files0From != \"\" {\n\t\textra, err := readFiles0From(opts.files0From)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"wc: %s\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tfiles = append(files, extra...)\n\t}\n\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\twidth := computeWidth(files, countColumns(opts))\n\tresults, names, hadError := processFiles(files, stderr)\n\tprintResults(stdout, opts, results, names, width)\n\tif hadError {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc noFlagsSet(opts options) bool {\n\treturn !opts.printLines && !opts.printWords &&\n\t\t!opts.printBytes && !opts.printChars && !opts.printMax\n}\n\nfunc processFiles(files []string, stderr io.Writer) ([]counts, []string, bool) {\n\tresults := make([]counts, 0, len(files))\n\tnames := make([]string, 0, len(files))\n\thadError := false\n\n\tfor _, f := range files {\n\t\tc, err := countFile(f)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(stderr, \"wc: %s\\n\", err)\n\t\t\thadError = true\n\t\t\tcontinue\n\t\t}\n\t\tresults = append(results, c)\n\t\tif f == \"-\" {\n\t\t\tnames = append(names, \"\")\n\t\t} else {\n\t\t\tnames = append(names, f)\n\t\t}\n\t}\n\treturn results, names, hadError\n}\n\nfunc countFile(name string) (counts, error) {\n\tvar r io.Reader\n\tif name == \"-\" {\n\t\tr = os.Stdin\n\t} else {\n\t\tf, err := os.Open(name)\n\t\tif err != nil {\n\t\t\treturn counts{}, fmt.Errorf(\"%s: %s\", name, err.(*os.PathError).Err)\n\t\t}\n\t\tdefer f.Close()\n\t\tr = f\n\t}\n\treturn countReader(r)\n}\n\nfunc countReader(r io.Reader) (counts, error) {\n\tvar c counts\n\tbr := bufio.NewReader(r)\n\tinWord := false\n\tlineLen := int64(0)\n\n\tbuf := make([]byte, 32*1024)\n\tfor {\n\t\tn, err := br.Read(buf)\n\t\tc.bytes += int64(n)\n\t\tprocessChunk(buf[:n], &c, &inWord, &lineLen)\n\t\tif err == io.EOF {\n\t\t\tbreak\n\t\t}\n\t\tif err != nil {\n\t\t\treturn c, err\n\t\t}\n\t}\n\n\tif lineLen > c.maxLine {\n\t\tc.maxLine = lineLen\n\t}\n\treturn c, nil\n}\n\nfunc processChunk(data []byte, c *counts, inWord *bool, lineLen *int64) {\n\ti := 0\n\tfor i < len(data) {\n\t\tr, size := utf8.DecodeRune(data[i:])\n\t\tif r == utf8.RuneError && size == 1 {\n\t\t\tc.chars++\n\t\t\tprocessNonSpaceByte(data[i], c, inWord, lineLen)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tc.chars++\n\t\tif r == '\\n' {\n\t\t\tc.lines++\n\t\t\thandleNewline(c, inWord, lineLen)\n\t\t} else if r == '\\t' {\n\t\t\thandleTab(inWord, lineLen)\n\t\t} else if unicode.IsSpace(r) {\n\t\t\t*inWord = false\n\t\t\t*lineLen++\n\t\t} else {\n\t\t\tif !*inWord {\n\t\t\t\tc.words++\n\t\t\t\t*inWord = true\n\t\t\t}\n\t\t\t*lineLen++\n\t\t}\n\t\ti += size\n\t}\n}\n\nfunc processNonSpaceByte(b byte, c *counts, inWord *bool, lineLen *int64) {\n\tswitch b {\n\tcase '\\n':\n\t\tc.lines++\n\t\thandleNewline(c, inWord, lineLen)\n\tcase '\\t':\n\t\thandleTab(inWord, lineLen)\n\tcase ' ', '\\r', '\\f', '\\v':\n\t\t*inWord = false\n\t\t*lineLen++\n\tdefault:\n\t\tif !*inWord {\n\t\t\tc.words++\n\t\t\t*inWord = true\n\t\t}\n\t\t*lineLen++\n\t}\n}\n\nfunc handleNewline(c *counts, inWord *bool, lineLen *int64) {\n\t*inWord = false\n\tif *lineLen > c.maxLine {\n\t\tc.maxLine = *lineLen\n\t}\n\t*lineLen = 0\n}\n\nfunc handleTab(inWord *bool, lineLen *int64) {\n\t*inWord = false\n\t*lineLen = (*lineLen/8 + 1) * 8\n}\n\nfunc printResults(w io.Writer, opts options, results []counts, names []string, width int) {\n\ttotal := sumCounts(results)\n\tshowTotal := shouldShowTotal(opts.totalMode, len(results))\n\n\tif opts.totalMode != \"only\" {\n\t\tfor i, c := range results {\n\t\t\tprintLine(w, opts, c, names[i], width)\n\t\t}\n\t}\n\tif showTotal {\n\t\tprintLine(w, opts, total, \"total\", width)\n\t}\n}\n\nfunc sumCounts(results []counts) counts {\n\tvar total counts\n\tfor _, c := range results {\n\t\ttotal.lines += c.lines\n\t\ttotal.words += c.words\n\t\ttotal.bytes += c.bytes\n\t\ttotal.chars += c.chars\n\t\tif c.maxLine > total.maxLine {\n\t\t\ttotal.maxLine = c.maxLine\n\t\t}\n\t}\n\treturn total\n}\n\nfunc shouldShowTotal(mode string, n int) bool {\n\tswitch mode {\n\tcase \"always\":\n\t\treturn true\n\tcase \"only\":\n\t\treturn true\n\tcase \"never\":\n\t\treturn false\n\tdefault:\n\t\treturn n > 1\n\t}\n}\n\nfunc countColumns(opts options) int {\n\tn := 0\n\tif opts.printLines {\n\t\tn++\n\t}\n\tif opts.printWords {\n\t\tn++\n\t}\n\tif opts.printChars {\n\t\tn++\n\t}\n\tif opts.printBytes {\n\t\tn++\n\t}\n\tif opts.printMax {\n\t\tn++\n\t}\n\treturn n\n}\n\nfunc computeWidth(files []string, numColumns int) int {\n\ttotalSize := int64(0)\n\thasRegular := false\n\tfor _, f := range files {\n\t\tif f == \"-\" {\n\t\t\tcontinue\n\t\t}\n\t\tinfo, err := os.Stat(f)\n\t\tif err != nil || !info.Mode().IsRegular() {\n\t\t\tcontinue\n\t\t}\n\t\ttotalSize += info.Size()\n\t\thasRegular = true\n\t}\n\tminWidth := 1\n\tif numColumns > 1 && !hasRegular {\n\t\tminWidth = 7\n\t}\n\tif hasRegular {\n\t\treturn max(len(fmt.Sprintf(\"%d\", totalSize)), minWidth)\n\t}\n\treturn minWidth\n}\n\nfunc printLine(w io.Writer, opts options, c counts, name string, width int) {\n\tfields := collectFields(opts, c, width)\n\tline := strings.Join(fields, \" \")\n\tif name != \"\" {\n\t\tline += \" \" + name\n\t}\n\tfmt.Fprintln(w, line)\n}\n\nfunc collectFields(opts options, c counts, width int) []string {\n\tfields := make([]string, 0, 5)\n\tif opts.printLines {\n\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.lines))\n\t}\n\tif opts.printWords {\n\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.words))\n\t}\n\tif opts.printChars {\n\t\tfields = append(fields, fmt.Sprintf(\"%*d\", width, c.chars))\n\t}\n\tif opts.printBytes {\n\t\tfields = append