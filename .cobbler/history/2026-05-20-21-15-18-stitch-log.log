he source is a directory and the error indicates an existing destination, handling each case appropriately.\n\nImplementing the move function... Writing the move logic...","signature":""}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":363,"cache_read_input_tokens":66591,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":363},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"30e09af5-8686-465d-bc62-6ead7c43a3cb","uuid":"a34962cd-8152-4ac5-a3d3-40d8d845b766"}
