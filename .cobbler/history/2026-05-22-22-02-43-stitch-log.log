{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VJ7xGqLzK6krCvcU9mtE2V","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"context\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"testing\"\n14\t\t\"time\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n17\t)\n18\t\n19\tfunc TestDiff(t *testing.T) {\n20\t\tgoBin := testutils.BuildBinary(t, \".\")\n21\t\trefBin, err := exec.LookPath(\"gcksum\")\n22\t\tif err != nil {\n23\t\t\tt.Skip(\"reference binary not found\")\n24\t\t}\n25\t\n26\t\ttmpDir := t.TempDir()\n27\t\thelloFile := filepath.Join(tmpDir, \"hello.txt\")\n28\t\tif err := os.WriteFile(helloFile, []byte(\"hello\\n\"), 0o644); err != nil {\n29\t\t\tt.Fatal(err)\n30\t\t}\n31\t\temptyFile := filepath.Join(tmpDir, \"empty.txt\")\n32\t\tif err := os.WriteFile(emptyFile, []byte{}, 0o644); err != nil {\n33\t\t\tt.Fatal(err)\n34\t\t}\n35\t\tbinaryFile := filepath.Join(tmpDir, \"binary.dat\")\n36\t\tif err := os.WriteFile(binaryFile, []byte{0x00, 0x01, 0x02, 0xFF, 0xFE}, 0o644); err != nil {\n37\t\t\tt.Fatal(err)\n38\t\t}\n39\t\n40\t\tdiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n41\t\n42\t\ttests := []testutils.DiffTest{\n43\t\t\t// R1.1: single file produces CRC checksum and byte count\n44\t\t\t{\n45\t\t\t\tName: \"single-file\",\n46\t\t\t\tArgs: []string{helloFile},\n47\t\t\t},\n48\t\t\t// R1.1: empty file\n49\t\t\t{\n50\t\t\t\tName: \"empty-file\",\n51\t\t\t\tArgs: []string{emptyFile},\n52\t\t\t},\n53\t\t\t// R1.1: binary content\n54\t\t\t{\n55\t\t\t\tName: \"binary-content\",\n56\t\t\t\tArgs: []string{binaryFile},\n57\t\t\t},\n58\t\t\t// R1.2: stdin with no arguments\n59\t\t\t{\n60\t\t\t\tName:  \"stdin-no-args\",\n61\t\t\t\tStdin: []byte(\"hello\\n\"),\n62\t\t\t},\n63\t\t\t// R1.2: empty stdin\n64\t\t\t{\n65\t\t\t\tName:  \"stdin-empty\",\n66\t\t\t\tStdin: []byte{},\n67\t\t\t},\n68\t\t\t// R1.2: stdin with explicit \"-\"\n69\t\t\t{\n70\t\t\t\tName:  \"stdin-dash\",\n71\t\t\t\tArgs:  []string{\"-\"},\n72\t\t\t\tStdin: []byte(\"abc\"),\n73\t\t\t},\n74\t\t\t// R1.3: multiple files in argument order\n75\t\t\t{\n76\t\t\t\tName: \"multiple-files\",\n77\t\t\t\tArgs: []string{helloFile, emptyFile},\n78\t\t\t},\n79\t\t\t// R1.3: multiple files reversed order\n80\t\t\t{\n81\t\t\t\tName: \"multiple-files-reversed\",\n82\t\t\t\tArgs: []string{emptyFile, helloFile},\n83\t\t\t},\n84\t\t\t// R1.3: three files\n85\t\t\t{\n86\t\t\t\tName: \"three-files\",\n87\t\t\t\tArgs: []string{helloFile, emptyFile, binaryFile},\n88\t\t\t},\n89\t\t\t// R1.4: missing file exits 1\n90\t\t\t{\n91\t\t\t\tName:      \"missing-file\",\n92\t\t\t\tArgs:      []string{filepath.Join(tmpDir, \"nonexistent.txt\")},\n93\t\t\t\tExitCode:  1,\n94\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n95\t\t\t},\n96\t\t\t// R1.4: missing file among valid files continues processing\n97\t\t\t{\n98\t\t\t\tName:      \"missing-among-valid\",\n99\t\t\t\tArgs:      []string{helloFile, filepath.Join(tmpDir, \"nonexistent.txt\"), emptyFile},\n100\t\t\t\tExitCode:  1,\n101\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n102\t\t\t},\n103\t\t}\n104\t\n105\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n106\t}\n107\t\n108\tfunc TestSIGPIPE(t *testing.T) {\n109\t\tgoBin := testutils.BuildBinary(t, \".\")\n110\t\tdir := t.TempDir()\n111\t\tlargePath := filepath.Join(dir, \"large.dat\")\n112\t\tif err := os.WriteFile(largePath, bytes.Repeat([]byte(\"x\\n\"), 500000), 0o644); err != nil {\n113\t\t\tt.Fatal(err)\n114\t\t}\n115\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n116\t\tdefer cancel()\n117\t\tcmd := exec.CommandContext(ctx, goBin, largePath)\n118\t\tstdout, err := cmd.StdoutPipe()\n119\t\tif err != nil {\n120\t\t\tt.Fatal(err)\n121\t\t}\n122\t\tif err := cmd.Start(); err != n