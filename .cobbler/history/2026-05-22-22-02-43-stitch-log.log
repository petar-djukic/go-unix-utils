{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kw76cp1csoQFqCtj66vFDm","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"os\"\n10\t\n11\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n12\t)\n13\t\n14\tvar crcTable [256]uint32\n15\t\n16\tfunc init() {\n17\t\tconst poly = 0x04C11DB7\n18\t\tfor i := range 256 {\n19\t\t\tc := uint32(i) << 24\n20\t\t\tfor range 8 {\n21\t\t\t\tif c&0x80000000 != 0 {\n22\t\t\t\t\tc = (c << 1) ^ poly\n23\t\t\t\t} else {\n24\t\t\t\t\tc <<= 1\n25\t\t\t\t}\n26\t\t\t}\n27\t\t\tcrcTable[i] = c\n28\t\t}\n29\t}\n30\t\n31\tfunc main() {\n32\t\tsys.InstallSIGPIPEHandler()\n33\t\tfiles := os.Args[1:]\n34\t\texitCode := 0\n35\t\tif len(files) == 0 {\n36\t\t\tif err := processStdin(os.Stdout); err != nil {\n37\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n38\t\t\t\texitCode = 1\n39\t\t\t}\n40\t\t} else {\n41\t\t\tfor _, file := range files {\n42\t\t\t\tif err := processFile(file, os.Stdout); err != nil {\n43\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n44\t\t\t\t\texitCode = 1\n45\t\t\t\t}\n46\t\t\t}\n47\t\t}\n48\t\tos.Exit(exitCode)\n49\t}\n50\t\n51\tfunc processStdin(stdout io.Writer) error {\n52\t\tcrc, size, err := computeCRC(os.Stdin)\n53\t\tif err != nil {\n54\t\t\treturn err\n55\t\t}\n56\t\tfmt.Fprintf(stdout, \"%d %d\\n\", crc, size)\n57\t\treturn nil\n58\t}\n59\t\n60\tfunc processFile(file string, stdout io.Writer) error {\n61\t\tr, err := openInput(file)\n62\t\tif err != nil {\n63\t\t\treturn err\n64\t\t}\n65\t\tdefer r.Close()\n66\t\tcrc, size, err := computeCRC(r)\n67\t\tif err != nil {\n68\t\t\treturn err\n69\t\t}\n70\t\tfmt.Fprintf(stdout, \"%d %d %s\\n\", crc, size, file)\n71\t\treturn nil\n72\t}\n73\t\n74\tfunc computeCRC(r io.Reader) (uint32, int64, error) {\n75\t\tvar crc uint32\n76\t\tvar size int64\n77\t\tbuf := make([]byte, 32*1024)\n78\t\tfor {\n79\t\t\tn, err := r.Read(buf)\n80\t\t\tfor _, b := range buf[:n] {\n81\t\t\t\tcrc = (crc << 8) ^ crcTable[(crc>>24)^uint32(b)]\n82\t\t\t}\n83\t\t\tsize += int64(n)\n84\t\t\tif err == io.EOF {\n85\t\t\t\tbreak\n86\t\t\t}\n87\t\t\tif err != nil {\n88\t\t\t\treturn 0, 0, err\n89\t\t\t}\n90\t\t}\n91\t\tfor n := size; n > 0; n >>= 8 {\n92\t\t\tcrc = (crc << 8) ^ crcTable[(crc>>24)^uint32(n&0xFF)]\n93\t\t}\n94\t\tcrc = ^crc\n95\t\treturn crc, size, nil\n96\t}\n97\t\n98\tfunc openInput(file string) (io.ReadCloser, error) {\n99\t\tif file == \"-\" {\n100\t\t\treturn io.NopCloser(os.Stdin), nil\n101\t\t}\n102\t\treturn os.Open(file)\n103\t}\n104\t"}]},"parent_tool_use_id":null,"session_id":"8712a2a4-759f-4848-9d0f-c286fe0a86e4","uuid":"3ab61870-bd60-4ee2-9c7a-3f1523314b53","timestamp":"2026-05-23T02:06:21.376Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5502/cmd/cksum/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar crcTable [256]uint32\n\nfunc init() {\n\tconst poly = 0x04C11DB7\n\tfor i := range 256 {\n\t\tc := uint32(i) << 24\n\t\tfor range 8 {\n\t\t\tif c&0x80000000 != 0 {\n\t\t\t\tc = (c << 1) ^ poly\n\t\t\t} else {\n\t\t\t\tc <<= 1\n\t\t\t}\n\t\t}\n\t\tcrcTable[i] = c\n\t}\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tfiles := os.Args[1:]\n\texitCode := 0\n\tif len(files) == 0 {\n\t\tif err := processStdin(os.Stdout); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t} else {\n\t\tfor _, file := range files {\n\t\t\tif err := processFile(file, os.Stdout); err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n\t\t\t\texitCode = 1\n\t\t\t}\n\t\t}\n\t}\n\tos.Exit(exitCode)\n}\n\nfunc processStdin(stdout io.Writer) error {\n\tcrc, size, err := computeCRC(os.Stdin)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfmt.Fprintf(stdout, \"%d %d\\n\", crc, size)\n\treturn nil\n}\n\nfunc processFile(file string, stdout io.Writer) error {\n\tr, err := openInput(file)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdefer r.Close()\n\tcrc, size, err := computeCRC(r)\n\tif err != nil {\n\t\treturn err\n\t}\n\tfmt.Fprintf(stdout, \"%d %d %s\\n\", crc, size, file)\n\treturn nil\n}\n\nfunc computeCRC(r io.Reader) (uint32, int64, error) {\n\tvar crc uint32\n\tvar size int64\n\tbuf := make([]byte, 32*1024)\n\tfor {\n\t\tn, err := r.Read(buf)\n\t\tfor _, b := range buf[:n] {\n\t\t\tcrc = (crc << 8) ^ crcTable[(crc>>24)^uint32(b)]\n\t\t}\n\t\tsize += int64(n)\n\t\tif err == io.EOF {\n\t\t\tbreak\n\t\t}\n\t\tif err != nil {\n\t\t\treturn 0, 0, err\n\t\t}\n\t}\n\tfor n := size; n > 0; n >>= 8 {\n\t\tcrc = (crc << 8) ^ crcTable[(crc>>24)^uint32(n&0xFF)]\n\t}\n\tcrc = ^crc\n\treturn crc, size, nil\n}\n\nfunc openInput(file string) (io.ReadCloser, error) {\n\tif file == \"-\" {\n\t\treturn io.NopCloser(os.Stdin), nil\n\t}\n\treturn os.Open(file)\n}\n","numLines":104,"startLine":1,"totalLines":104}}}
