{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LcyiARKHyFceX23baEbgb6","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"crypto/sha256\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tconst helpText = `Usage: sha256sum [OPTION]... [FILE]...\n19\tPrint or check SHA256 (256-bit) checksums.\n20\t\n21\tWith no FILE, or when FILE is -, read standard input.\n22\t  -b, --binary         read in binary mode\n23\t  -c, --check          read checksums from the FILEs and check them\n24\t      --tag            create a BSD-style checksum\n25\t  -t, --text           read in text mode (default)\n26\t  -z, --zero           end each output line with NUL, not newline,\n27\t                         and disable file name escaping\n28\t\n29\tThe following five options are useful only when verifying checksums:\n30\t      --quiet          don't print OK for each successfully verified file\n31\t      --status         don't output anything, status code shows success\n32\t  -w, --warn           warn about improperly formatted checksum lines\n33\t      --help           display this help and exit\n34\t      --version        output version information and exit\n35\t`\n36\t\n37\tconst versionText = `sha256sum (go-unix-utils) dev\n38\t`\n39\t\n40\tfunc main() {\n41\t\tsys.InstallSIGPIPEHandler()\n42\t\topts, files := parseArgs(os.Args[1:])\n43\t\tcfg := hashutil.HashConfig{\n44\t\t\tAlgorithm: \"SHA256\",\n45\t\t\tNewHash:   sha256.New,\n46\t\t\tDigestLen: 32,\n47\t\t}\n48\t\tvar stdout io.Writer = os.Stdout\n49\t\tif opts.zero {\n50\t\t\tstdout = &nulWriter{w: os.Stdout}\n51\t\t}\n52\t\tif opts.check {\n53\t\t\tcheckOpts := hashutil.CheckOptions{\n54\t\t\t\tWarn:   opts.warn,\n55\t\t\t\tQuiet:  opts.quiet,\n56\t\t\t\tStatus: opts.status,\n57\t\t\t}\n58\t\t\texitCode := 0\n59\t\t\tfor _, f := range files {\n60\t\t\t\tok, err := hashutil.VerifyChecksums(f, cfg, checkOpts, stdout, os.Stderr)\n61\t\t\t\tif err != nil {\n62\t\t\t\t\tfmt.Fprintf(os.Stderr, \"sha256sum: %s\\n\", err)\n63\t\t\t\t\texitCode = 1\n64\t\t\t\t} else if !ok {\n65\t\t\t\t\texitCode = 1\n66\t\t\t\t}\n67\t\t\t}\n68\t\t\tos.Exit(exitCode)\n69\t\t}\n70\t\tos.Exit(hashutil.DigestFiles(files, cfg, opts.binary, opts.tag, stdout, os.Stderr))\n71\t}\n72\t\n73\ttype nulWriter struct {\n74\t\tw io.Writer\n75\t}\n76\t\n77\tfunc (n *nulWriter) Write(p []byte) (int, error) {\n78\t\treplaced := bytes.ReplaceAll(p, []byte{'\\n'}, []byte{0})\n79\t\tnn, err := n.w.Write(replaced)\n80\t\tif nn > len(p) {\n81\t\t\tnn = len(p)\n82\t\t}\n83\t\treturn nn, err\n84\t}\n85\t\n86\ttype options struct {\n87\t\tbinary bool\n88\t\ttag    bool\n89\t\tcheck  bool\n90\t\twarn   bool\n91\t\tquiet  bool\n92\t\tstatus bool\n93\t\tzero   bool\n94\t}\n95\t\n96\tfunc parseArgs(args []string) (options, []string) {\n97\t\tvar opts options\n98\t\tvar files []string\n99\t\ti := 0\n100\t\tfor i < len(args) {\n101\t\t\targ := args[i]\n102\t\t\tif arg == \"--\" {\n103\t\t\t\tfiles = append(files, args[i+1:]...)\n104\t\t\t\tbreak\n105\t\t\t}\n106\t\t\tif handled, advance := parseLongFlag(arg, &opts); handled {\n107\t\t\t\ti += advance\n108\t\t\t\tcontinue\n109\t\t\t}\n110\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n111\t\t\t\tfiles = append(files, arg)\n112\t\t\t\ti++\n113\t\t\t\tcontinue\n114\t\t\t}\n115\t\t\ti += parseShortFlags(arg[1:], &opts)\n116\t\t}\n117\t\treturn opts, files\n118\t}\n119\t\n120\tfunc parseLongFlag(arg string, opts *options) (bool, int) {\n121\t\tif !strings.HasPrefix(arg, \"--\") {\n122\t\t\treturn false, 0\n123\t\t}\n124\t\tswitch arg {\n125\t\tcase \"--help\":\n126\t\t\tfmt.Fprint(os.Stdout, helpText)\n127\t\t\tos.Exit(0)\n128\t\t\treturn true, 1\n129\t\tcase \"--version\":\n130\t\t\tfmt.Fprint(os.Stdout, versionText)\n131\t\t\tos.Exit(0)\n132\t\t\treturn true, 1\n133\t\tcase \"--binary\":\n134\t\t\topts.binary = true\n135\t\tcase \"--text\":\n136\t\t\topts.binary = false\n137\t\tcase \"--tag\":\n138\t\t\topts.tag = true\n139\t\tcase \"--check\":\n140\t\t\topts.check = true\n141\t\tcase \"--warn\":\n142\t\t\topts.warn = true\n143\t\tcase \"--quiet\":\n144\t\t\topts.quiet = true\n145\t\tcase \"--status\":\n146\t\t\topts.status = true\n147\t\tcase \"--zero\":\n148\t\t\topts.zero = true\n149\t\tdefault:\n150\t\t\treturn false, 0\n151\t\t}\n152\t\treturn true, 1\n153\t}\n154\t\n155\tfunc parseShortFlags(flags string, opts *options) int {\n156\t\tfor _, ch := range flags {\n157\t\t\tswitch ch {\n158\t\t\tcase 'b':\n159\t\t\t\topts.binary = true\n160\t\t\tcase 't':\n161\t\t\t\topts.binary = false\n162\t\t\tcase 'c':\n163\t\t\t\topts.check = true\n164\t\t\tcase 'w':\n165\t\t\t\topts.warn = true\n166\t\t\tcase 'z':\n167\t\t\t\topts.zero = true\n168\t\t\t}\n169\t\t}\n170\t\treturn 1\n171\t}\n172\t"}]},"parent_tool_use_id":null,"session_id":"8712a2a4-759f-4848-9d0f-c286fe0a86e4","uuid":"95abcfd3-2b01-4bb0-9821-b5d6e01192bc","timestamp":"2026-05-23T02:06:55.283Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5502/cmd/sha256sum/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"crypto/sha256\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: sha256sum [OPTION]... [FILE]...\nPrint or check SHA256 (256-bit) checksums.\n\nWith no FILE, or when FILE is -, read standard input.\n  -b, --binary         read in binary mode\n  -c, --check          read checksums from the FILEs and check them\n      --tag            create a BSD-style checksum\n  -t, --text           read in text mode (default)\n  -z, --zero           end each output line with NUL, not newline,\n                         and disable file name escaping\n\nThe following five options are useful only when verifying checksums:\n      --quiet          don't print OK for each successfully verified file\n      --status         don't output anything, status code shows success\n  -w, --warn           warn about improperly formatted checksum lines\n      --help           display this help and exit\n      --version        output version information and exit\n`\n\nconst versionText = `sha256sum (go-unix-utils) dev\n`\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, files := parseArgs(os.Args[1:])\n\tcfg := hashutil.HashConfig{\n\t\tAlgorithm: \"SHA256\",\n\t\tNewHash:   sha256.New,\n\t\tDigestLen: 32,\n\t}\n\tvar stdout io.Writer = os.Stdout\n\tif opts.zero {\n\t\tstdout = &nulWriter{w: os.Stdout}\n\t}\n\tif opts.check {\n\t\tcheckOpts := hashutil.CheckOptions{\n\t\t\tWarn:   opts.warn,\n\t\t\tQuiet:  opts.quiet,\n\t\t\tStatus: opts.status,\n\t\t}\n\t\texitCode := 0\n\t\tfor _, f := range files {\n\t\t\tok, err := hashutil.VerifyChecksums(f, cfg, checkOpts, stdout, os.Stderr)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"sha256sum: %s\\n\", err)\n\t\t\t\texitCode = 1\n\t\t\t} else if !ok {\n\t\t\t\texitCode = 1\n\t\t\t}\n\t\t}\n\t\tos.Exit(exitCode)\n\t}\n\tos.Exit(hashutil.DigestFiles(files, cfg, opts.binary, opts.tag, stdout, os.Stderr))\n}\n\ntype nulWriter struct {\n\tw io.Writer\n}\n\nfunc (n *nulWriter) Write(p []byte) (int, error) {\n\treplaced := bytes.ReplaceAll(p, []byte{'\\n'}, []byte{0})\n\tnn, err := n.w.Write(replaced)\n\tif nn > len(p) {\n\t\tnn = len(p)\n\t}\n\treturn nn, err\n}\n\ntype options struct {\n\tbinary bool\n\ttag    bool\n\tcheck  bool\n\twarn   bool\n\tquiet  bool\n\tstatus bool\n\tzero   bool\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\tvar opts options\n\tvar files []string\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif handled, advance := parseLongFlag(arg, &opts); handled {\n\t\t\ti += advance\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n\t\t\tfiles = append(files, arg)\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\ti += parseShortFlags(arg[1:], &opts)\n\t}\n\treturn opts, files\n}\n\nfunc parseLongFlag(arg string, opts *options) (bool, int) {\n\tif !strings.HasPrefix(arg, \"--\") {\n\t\treturn false, 0\n\t}\n\tswitch arg {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn true, 1\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn true, 1\n\tcase \"--binary\":\n\t\topts.binary = true\n\tcase \"--text\":\n\t\topts.binary = false\n\tcase \"--tag\":\n\t\topts.tag = true\n\tcase \"--check\":\n\t\topts.check = true\n\tcase \"--warn\":\n\t\topts.warn = true\n\tcase \"--quiet\":\n\t\topts.quiet = true\n\tcase \"--status\":\n\t\topts.status = true\n\tcase \"--zero\":\n\t\topts.zero = true\n\tdefault:\n\t\treturn false, 0\n\t}\n\treturn true, 1\n}\n\nfunc parseShortFlags(flags string, opts *options) int {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase 'b':\n\t\t\topts.binary = true\n\t\tcase 't':\n\t\t\topts.binary = false\n\t\tcase 'c':\n\t\t\topts.check = true\n\t\tcase 'w':\n\t\t\topts.warn = true\n\t\tcase 'z':\n\t\t\topts.zero = true\n\t\t}\n\t}\n\treturn 1\n}\n","numLines":172,"startLine":1,"totalLines":172}}}
