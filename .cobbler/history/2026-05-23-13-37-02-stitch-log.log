{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017QtTEJCMPAhKBJDgSbACgs","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/du implements recursive directory disk usage reporting.\n5\t// Implements srd009-du R1.1-R1.5, R2.1-R2.8, R3.1-R3.3, R4.1-R4.2, R5.1.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"flag\"\n10\t\t\"fmt\"\n11\t\t\"os\"\n12\t\t\"path/filepath\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype inodeKey struct {\n19\t\tDev uint64\n20\t\tIno uint64\n21\t}\n22\t\n23\ttype options struct {\n24\t\tsummarize     bool\n25\t\tallFiles      bool\n26\t\tgrandTotal    bool\n27\t\tmaxDepth      int\n28\t\tmegaBlocks    bool\n29\t\toneFileSystem bool\n30\t\tapparentSize  bool\n31\t\thumanReadable bool\n32\t\tsiUnits       bool\n33\t\tnullTerm      bool\n34\t}\n35\t\n36\tfunc main() {\n37\t\tsys.InstallSIGPIPEHandler()\n38\t\n39\t\topts := parseFlags()\n40\t\targs := flag.Args()\n41\t\tif len(args) == 0 {\n42\t\t\targs = []string{\".\"}\n43\t\t}\n44\t\n45\t\tseen := make(map[inodeKey]bool)\n46\t\texitCode := 0\n47\t\tvar cumTotal int64\n48\t\n49\t\tfor _, arg := range args {\n50\t\t\ttotal, err := processArg(arg, seen, &opts)\n51\t\t\tcumTotal += total\n52\t\t\tif err != nil {\n53\t\t\t\texitCode = 1\n54\t\t\t}\n55\t\t}\n56\t\n57\t\tif opts.grandTotal {\n58\t\t\tprintEntry(cumTotal, \"total\", &opts)\n59\t\t}\n60\t\n61\t\tos.Exit(exitCode)\n62\t}\n63\t\n64\tfunc parseFlags() options {\n65\t\tvar opts options\n66\t\tflag.BoolVar(&opts.summarize, \"s\", false, \"display only a total for each argument\")\n67\t\tflag.BoolVar(&opts.allFiles, \"a\", false, \"write counts for all files, not just directories\")\n68\t\tflag.BoolVar(&opts.grandTotal, \"c\", false, \"produce a grand total\")\n69\t\tflag.IntVar(&opts.maxDepth, \"d\", -1, \"max display depth\")\n70\t\tflag.IntVar(&opts.maxDepth, \"max-depth\", -1, \"max display depth\")\n71\t\tflag.Bool(\"k\", false, \"use 1024-byte blocks (default)\")\n72\t\tflag.BoolVar(&opts.megaBlocks, \"m\", false, \"use 1048576-byte blocks\")\n73\t\tflag.BoolVar(&opts.oneFileSystem, \"x\", false, \"skip directories on different file systems\")\n74\t\tflag.BoolVar(&opts.oneFileSystem, \"one-file-system\", false, \"skip directories on different file systems\")\n75\t\tflag.BoolVar(&opts.apparentSize, \"apparent-size\", false, \"print apparent sizes rather than disk usage\")\n76\t\tflag.BoolVar(&opts.humanReadable, \"h\", false, \"print sizes in human readable format\")\n77\t\tflag.BoolVar(&opts.siUnits, \"si\", false, \"like -h, but use powers of 1000 not 1024\")\n78\t\tflag.BoolVar(&opts.nullTerm, \"0\", false, \"end each output line with NUL, not newline\")\n79\t\tflag.BoolVar(&opts.nullTerm, \"null\", false, \"end each output line with NUL, not newline\")\n80\t\tflag.Parse()\n81\t\treturn opts\n82\t}\n83\t\n84\tfunc processArg(path string, seen map[inodeKey]bool, opts *options) (int64, error) {\n85\t\tfi, err := sys.Lstat(path)\n86\t\tif err != nil {\n87\t\t\tfmt.Fprintf(os.Stderr, \"du: %v\\n\", err)\n88\t\t\treturn 0, err\n89\t\t}\n90\t\n91\t\trootDev := fi.Dev\n92\t\n93\t\tif !fi.Mode.IsDir() {\n94\t\t\tsize := fileSize(fi, seen, opts)\n95\t\t\tprintEntry(size, path, opts)\n96\t\t\treturn size, nil\n97\t\t}\n98\t\n99\t\treturn walkDir(path, fi, seen, opts, 0, rootDev)\n100\t}\n101\t\n102\tfunc walkDir(path string, fi *sys.FileInfo, seen map[inodeKey]bool, opts *options, depth int, rootDev uint64) (int64, error) {\n103\t\tentries, err := os.ReadDir(path)\n104\t\tif err != nil {\n105\t\t\tfmt.Fprintf(os.Stderr, \"du: %v\\n\", err)\n106\t\t\tsize := sizeContrib(fi, opts)\n107\t\t\tif shouldPrint(depth, true, opts) {\n108\t\t\t\tprintEntry(size, path, opts)\n109\t\t\t}\n110\t\t\treturn size, err\n111\t\t}\n112\t\n113\t\ttotal, firstErr := accumChildren(path, entries, seen, opts, depth, rootDev)\n114\t\ttotal += sizeContrib(fi, opts)\n115\t\tif shouldPrint(depth, true, opts) {\n116\t\t\tprintEntry(total, path, opts)\n117\t\t}\n118\t\treturn total, firstErr\n119\t}\n120\t\n121\tfunc accumChildren(dir string, entries []os.DirEntry, seen map[inodeKey]bool, opts *options, parentDepth int, rootDev uint64) (int64, error) {\n122\t\tvar total int64\n123\t\tvar firstErr error\n124\t\tchildDepth := parentDepth + 1\n125\t\n126\t\tfor _, entry := range entries {\n127\t\t\tchildPath := filepath.Join(dir, entry.Name())\n128\t\t\tsize, err := childSize(childPath, seen, opts, childDepth, rootDev)\n129\t\t\tif err != nil && firstErr == nil {\n130\t\t\t\tfirstErr = err\n131\t\t\t}\n132\t\t\ttotal += size\n133\t\t}\n134\t\n135\t\treturn total, firstErr\n136\t}\n137\t\n138\tfunc childSize(path string, seen map[inodeKey]bool, opts *options, depth int, rootDev uint64) (int64, error) {\n139\t\tfi, err := sys.Lstat(path)\n140\t\tif err != nil {\n141\t\t\tfmt.Fprintf(os.Stderr, \"du: %v\\n\", err)\n142\t\t\treturn 0, err\n143\t\t}\n144\t\n145\t\tif fi.Mode.IsDir() {\n146\t\t\tif opts.oneFileSystem && fi.Dev != rootDev {\n147\t\t\t\treturn 0, nil\n148\t\t\t}\n149\t\t\treturn walkDir(path, fi, seen, opts, depth, rootDev)\n150\t\t}\n151\t\n152\t\tsize := fileSize(fi, seen, opts)\n153\t\tif shouldPrint(depth, false, opts) {\n154\t\t\tprintEntry(size, path, opts)\n155\t\t}\n156\t\treturn size, nil\n157\t}\n158\t\n159\tfunc shouldPrint(depth int, isDir bool, opts *options) bool {\n160\t\tif opts.summarize {\n161\t\t\treturn depth == 0\n162\t\t}\n163\t\tif opts.maxDepth >= 0 && depth > opts.maxDepth {\n164\t\t\treturn false\n165\t\t}\n166\t\tif isDir {\n167\t\t\treturn true\n168\t\t}\n169\t\treturn opts.allFiles\n170\t}\n171\t\n172\tfunc fileSize(fi *sys.FileInfo, seen map[inodeKey]bool, opts *options) int64 {\n173\t\tkey := inodeKey{Dev: fi.Dev, Ino: fi.Ino}\n174\t\tif seen[key] {\n175\t\t\treturn 0\n176\t\t}\n177\t\tseen[key] = true\n178\t\treturn sizeContrib(fi, opts)\n179\t}\n180\t\n181\tfunc sizeContrib(fi *sys.FileInfo, opts *options) int64 {\n182\t\tif opts.apparentSize {\n183\t\t\treturn fi.Size\n184\t\t}\n185\t\treturn fi.Blocks\n186\t}\n187\t\n188\tfunc displaySize(raw int64, opts *options) int64 {\n189\t\tif opts.apparentSize {\n190\t\t\tif opts.megaBlocks {\n191\t\t\t\treturn (raw + 1048575) / 1048576\n192\t\t\t}\n193\t\t\treturn (raw + 1023) / 1024\n194\t\t}\n195\t\tif opts.megaBlocks {\n196\t\t\treturn (raw + 2047) / 2048\n197\t\t}\n198\t\treturn raw / 2\n199\t}\n200\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01GBCLCD1Cq6FDaz9wYrXLmw","session_id":"3bfc0ed3-e106-4eb1-8ca5-c42dd61ac9de","uuid":"616002c6-265f-43a3-af03-d6a77a835a72","timestamp":"2026-05-23T17:39:04.987Z"}
