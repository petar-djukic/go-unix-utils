:\n\t\t\topts.verbose = true\n\t\tcase 'c':\n\t\t\topts.changes = true\n\t\tcase 'f':\n\t\t\topts.silent = true\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tcase 'h':\n\t\t\topts.noDereference = true\n\t\tcase 'H':\n\t\t\topts.symlink = symlinkH\n\t\tcase 'L':\n\t\t\topts.symlink = symlinkL\n\t\tcase 'P':\n\t\t\topts.symlink = symlinkP\n\t\tdefault:\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n","numLines":325,"startLine":1,"totalLines":325}}}
