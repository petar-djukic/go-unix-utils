ath.Join(tmpDir, \"nonexistent.sha1\")},\n266\t\t\t\tExitCode:  1,\n267\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n268\t\t\t},\n269\t\t}\n270\t\n271\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n272\t}\n273\t\n274\tfunc TestSIGPIPE(t *testing.T) {\n275\t\tgoBin := testutils.BuildBinary(t, \".\")\n276\t\tdir := t.TempDir()\n277\t\tlargePath := filepath.Join(dir, \"large.dat\")\n278\t\tif err := os.WriteFile(largePath, bytes.Repeat([]byte(\"x\\n\"), 500000), 0o644); err != nil {\n279\t\t\tt.Fatal(err)\n280\t\t}\n281\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n282\t\tdefer cancel()\n283\t\tcmd := exec.CommandContext(ctx, goBin, largePath)\n284\t\tstdout, err := cmd.StdoutPipe()\n285\t\tif err != nil {\n286\t\t\tt.Fatal(err)\n287\t\t}\n288\t\tif err := cmd.Start(); err != nil {\n289\t\t\tt.Fatal(err)\n290\t\t}\n291\t\tbuf := make([]byte, 1)\n292\t\tif _, err := io.ReadFull(stdout, buf); err != nil {\n293\t\t\tt.Fatal(err)\n294\t\t}\n295\t\tstdout.Close()\n296\t\terr = cmd.Wait()\n297\t\tif ctx.Err() == context.DeadlineExceeded {\n298\t\t\tt.Fatal(\"sha1sum timed out; SIGPIPE handler may not be installed\")\n299\t\t}\n300\t\tif err != nil {\n301\t\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n302\t\t}\n303\t}\n304\t\n305\tfunc sha1hex(data []byte) string {\n306\t\tsum := sha1.Sum(data)\n307\t\treturn hex.EncodeToString(sum[:])\n308\t}\n309\t\n310\tfunc writeFile(t *testing.T, path, content string) {\n311\t\tt.Helper()\n312\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n313\t\t\tt.Fatal(err)\n314\t\t}\n315\t}\n316\t"}]},"parent_tool_use_id":null,"session_id":"126ff546-10de-4985-8712-3c817acedac1","uuid":"b5e2eea2-5462-493d-83ad-d76993c12e1c","timestamp":"2026-05-19T23:37:22.632Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5317/cmd/sha1sum/sha1sum_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"crypto/sha1\"\n\t\"encoding/hex\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gsha1sum\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttmpDir := t.TempDir()\n\thelloFile := filepath.Join(tmpDir, \"hello.txt\")\n\tif err := os.WriteFile(helloFile, []byte(\"hello\\n\"), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\temptyFile := filepath.Join(tmpDir, \"empty.txt\")\n\tif err := os.WriteFile(emptyFile, []byte{}, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\n\tdiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n\n\thelloHash := sha1hex([]byte(\"hello\\n\"))\n\temptyHash := sha1hex([]byte{})\n\n\tvalidChecksum := filepath.Join(tmpDir, \"valid.sha1\")\n\twriteFile(t, validChecksum, fmt.Sprintf(\"%s  %s\\n\", helloHash, helloFile))\n\n\tmultiChecksum := filepath.Join(tmpDir, \"multi.sha1\")\n\twriteFile(t, multiChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", helloHash, helloFile, emptyHash, emptyFile))\n\n\tmismatchChecksum := filepath.Join(tmpDir, \"mismatch.sha1\")\n\twriteFile(t, mismatchChecksum, fmt.Sprintf(\"%s  %s\\n\", \"0000000000000000000000000000000000000000\", helloFile))\n\n\tmixedChecksum := filepath.Join(tmpDir, \"mixed.sha1\")\n\twriteFile(t, mixedChecksum, fmt.Sprintf(\"%s  %s\\n%s  %s\\n\", helloHash, helloFile, \"0000000000000000000000000000000000000000\", emptyFile))\n\n\tmalformedChecksum := filepath.Join(tmpDir, \"malformed.sha1\")\n\twriteFile(t, malformedChecksum, fmt.Sprintf(\"this is not a checksum\\n%s  %s\\n\", helloHash, helloFile))\n\n\tbsdChecksum := filepath.Join(tmpDir, \"bsd.sha1\")\n\twriteFile(t, bsdChecksum, fmt.Sprintf(\"SHA1 (%s) = %s\\n\