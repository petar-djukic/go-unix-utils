f); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstdout.Close()\n\terr = cmd.Wait()\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatal(\"sha512sum timed out; SIGPIPE handler may not be installed\")\n\t}\n\tif err != nil {\n\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n\t}\n}\n\nfunc sha512hex(data []byte) string {\n\tsum := sha512.Sum512(data)\n\treturn hex.EncodeToString(sum[:])\n}\n\nfunc writeFile(t *testing.T, path, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3930,"cache_read_input_tokens":25452,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3930},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"126ff546-10de-4985-8712-3c817acedac1","uuid":"ac120548-c985-4513-9ee6-f20342975912"}
