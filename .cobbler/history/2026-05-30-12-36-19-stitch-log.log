{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QpESbuPfo8MfCvG3t6Dpcx","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd110-pr R1.1, R2.1, R2.2, R2.3, R3.1, R4.1, R4.2, R4.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n19\t)\n20\t\n21\tconst (\n22\t\theaderSize     = 5\n23\t\tfooterSize     = 5\n24\t\tdefaultPageLen = 66\n25\t\tdefaultWidth   = 72\n26\t)\n27\t\n28\ttype options struct {\n29\t\tpageLength     int\n30\t\theaderText     string\n31\t\theaderSet      bool\n32\t\tomitHeader     bool\n33\t\tomitPagination bool\n34\t\tcolumns        int\n35\t\tacross         bool\n36\t\tnumberLines    bool\n37\t\tnumberSep      byte\n38\t\tnumberWidth    int\n39\t\tindent         int\n40\t\tpageWidth      int\n41\t\tdoubleSpace    bool\n42\t\tseparator      string\n43\t\tseparatorSet   bool\n44\t}\n45\t\n46\tfunc main() {\n47\t\tsys.InstallSIGPIPEHandler()\n48\t\tos.Exit(run(os.Args[1:]))\n49\t}\n50\t\n51\tfunc run(args []string) int {\n52\t\topts, files, err := parseArgs(args)\n53\t\tif err != nil {\n54\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n55\t\t\treturn 1\n56\t\t}\n57\t\tif len(files) == 0 {\n58\t\t\tfiles = []string{\"-\"}\n59\t\t}\n60\t\tw := bufio.NewWriter(os.Stdout)\n61\t\texitCode := 0\n62\t\tfor _, f := range files {\n63\t\t\tif err := processFile(f, opts, w); err != nil {\n64\t\t\t\tif errors.Is(err, syscall.EPIPE) {\n65\t\t\t\t\tos.Exit(0)\n66\t\t\t\t}\n67\t\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n68\t\t\t\texitCode = 1\n69\t\t\t}\n70\t\t}\n71\t\tif err := w.Flush(); err != nil {\n72\t\t\tif errors.Is(err, syscall.EPIPE) {\n73\t\t\t\tos.Exit(0)\n74\t\t\t}\n75\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n76\t\t\texitCode = 1\n77\t\t}\n78\t\treturn exitCode\n79\t}\n80\t\n81\tfunc parseArgs(args []string) (options, []string, error) {\n82\t\topts := options{\n83\t\t\tpageLength:  defaultPageLen,\n84\t\t\tpageWidth:   defaultWidth,\n85\t\t\tnumberSep:   '\\t',\n86\t\t\tnumberWidth: 5,\n87\t\t}\n88\t\tvar files []string\n89\t\tfor i := 0; i < len(args); i++ {\n90\t\t\ta := args[i]\n91\t\t\tif a == \"--\" {\n92\t\t\t\tfiles = append(files, args[i+1:]...)\n93\t\t\t\tbreak\n94\t\t\t}\n95\t\t\tvar err error\n96\t\t\tswitch {\n97\t\t\tcase strings.HasPrefix(a, \"--length=\"):\n98\t\t\t\terr = setPageLen(&opts, a[len(\"--length=\"):])\n99\t\t\tcase strings.HasPrefix(a, \"--header=\"):\n100\t\t\t\topts.headerText, opts.headerSet = a[len(\"--header=\"):], true\n101\t\t\tcase a == \"--omit-header\" || a == \"-t\":\n102\t\t\t\topts.omitHeader = true\n103\t\t\tcase a == \"--omit-pagination\" || a == \"-T\":\n104\t\t\t\topts.omitPagination = true\n105\t\t\tcase strings.HasPrefix(a, \"-l\"):\n106\t\t\t\terr = parseLenFlag(args, &i, &opts)\n107\t\t\tcase strings.HasPrefix(a, \"-h\"):\n108\t\t\t\terr = parseHdrFlag(args, &i, &opts)\n109\t\t\tcase a == \"--across\" || a == \"-a\":\n110\t\t\t\topts.across = true\n111\t\t\tcase a == \"--double-space\" || a == \"-d\":\n112\t\t\t\topts.doubleSpace = true\n113\t\t\tcase strings.HasPrefix(a, \"--columns=\"):\n114\t\t\t\terr = setColumns(&opts, a[len(\"--columns=\"):])\n115\t\t\tcase strings.HasPrefix(a, \"--number-lines\"):\n116\t\t\t\terr = parseNumLong(&opts, a)\n117\t\t\tcase strings.HasPrefix(a, \"-n\"):\n118\t\t\t\tparseNumShort(&opts, a)\n119\t\t\tcase strings.HasPrefix(a, \"--indent=\"):\n120\t\t\t\terr = setIndent(&opts, a[len(\"--indent=\"):])\n121\t\t\tcase strings.HasPrefix(a, \"-o\"):\n122\t\t\t\terr = parseIndentFlag(args, &i, &opts)\n123\t\t\tcase strings.HasPrefix(a, \"--width=\"):\n124\t\t\t\terr = setWidth(&opts, a[len(\"--width=\"):])\n125\t\t\tcase strings.HasPrefix(a, \"-w\"):\n126\t\t\t\terr = parseWidthFlag(args, &i, &opts)\n127\t\t\tcase strings.HasPrefix(a, \"--separator=\"):\n128\t\t\t\topts.separator, opts.separatorSet = a[len(\"--separator=\"):], true\n129\t\t\tcase a == \"--separator\" || a == \"-s\":\n130\t\t\t\topts.separator, opts.separatorSet = \"\\t\", true\n131\t\t\tcase strings.HasPrefix(a, \"-s\"):\n132\t\t\t\topts.separator, opts.separatorSet = string(a[2]), true\n133\t\t\tcase isColumnsFlag(a):\n134\t\t\t\terr = setColumns(&opts, a[1:])\n135\t\t\tcase strings.HasPrefix(a, \"-\") && a != \"-\":\n136\t\t\t\terr = fmt.Errorf(\"unrecognized option '%s'\", a)\n137\t\t\tdefault:\n138\t\t\t\tfiles = append(files, a)\n139\t\t\t}\n140\t\t\tif err != nil {\n141\t\t\t\treturn opts, nil, err\n142\t\t\t}\n143\t\t}\n144\t\tif opts.pageLength <= 10 {\n145\t\t\topts.omitHeader = true\n146\t\t}\n147\t\treturn opts, files, nil\n148\t}\n149\t\n150\tfunc parseLenFlag(args []string, i *int, opts *options) error {\n151\t\tv, err := valFlag(args, i, \"-l\")\n152\t\tif err != nil {\n153\t\t\treturn err\n154\t\t}\n155\t\treturn setPageLen(opts, v)\n156\t}\n157\t\n158\tfunc parseHdrFlag(args []string, i *int, opts *options) error {\n159\t\tv, err := valFlag(args, i, \"-h\")\n160\t\tif err != nil {\n161\t\t\treturn err\n162\t\t}\n163\t\topts.headerText, opts.headerSet = v, true\n164\t\treturn nil\n165\t}\n166\t\n167\tfunc parseIndentFlag(args []string, i *int, opts *options) error {\n168\t\tv, err := valFlag(args, i, \"-o\")\n169\t\tif err != nil {\n170\t\t\treturn err\n171\t\t}\n172\t\treturn setIndent(opts, v)\n173\t}\n174\t\n175\tfunc parseWidthFlag(args []string, i *int, opts *options) error {\n176\t\tv, err := valFlag(args, i, \"-w\")\n177\t\tif err != nil {\n178\t\t\treturn err\n179\t\t}\n180\t\treturn setWidth(opts, v)\n181\t}\n182\t\n183\tfunc parseNumShort(opts *options, a string) {\n184\t\topts.numberLines = true\n185\t\trest := a[2:]\n186\t\tif len(rest) == 0 {\n187\t\t\treturn\n188\t\t}\n189\t\tif rest[0] < '0' || rest[0] > '9' {\n190\t\t\topts.numberSep = rest[0]\n191\t\t\trest = rest[1:]\n192\t\t}\n193\t\tif len(rest) > 0 {\n194\t\t\tif w, err := strconv.Atoi(rest); err == nil && w >= 1 {\n195\t\t\t\topts.numberWidth = w\n196\t\t\t}\n197\t\t}\n198\t}\n199\t\n200\tfunc parseNumLong(opts *options, a string) error {\n201\t\topts.numberLines = true\n202\t\tif a == \"--number-lines\" {\n203\t\t\treturn nil\n204\t\t}\n205\t\tif !strings.HasPrefix(a, \"--number-lines=\") {\n206\t\t\treturn fmt.Errorf(\"unrecognized option '%s'\", a)\n207\t\t}\n208\t\trest := a[len(\"--number-lines=\"):]\n209\t\tif len(rest) == 0 {\n210\t\t\treturn nil\n211\t\t}\n212\t\tif rest[0] < '0' || rest[0] > '9' {\n213\t\t\topts.numberSep = rest[0]\n214\t\t\trest = rest[1:]\n215\t\t}\n216\t\tif len(rest) > 0 {\n217\t\t\tw, err := strconv.Atoi(rest)\n218\t\t\tif err != nil || w < 1 {\n219\t\t\t\treturn fmt.Errorf(\"invalid number width: %q\", rest)\n220\t\t\t}\n221\t\t\topts.numberWidth = w\n222\t\t}\n223\t\treturn nil\n224\t}\n225\t\n226\tfunc valFlag(args []string, i *int, prefix string) (string, error) {\n227\t\ta := args[*i]\n228\t\tif len(a) > len(prefix) {\n229\t\t\treturn a[len(prefix):], nil\n230\t\t}\n231\t\t*i++\n232\t\tif *i >= len(args) {\n233\t\t\treturn \"\", fmt.Errorf(\"option requires an argument -- '%c'\", prefix[1])\n234\t\t}\n235\t\treturn args[*i], nil\n236\t}\n237\t\n238\tfunc setPageLen(opts *options, s string) error {\n239\t\tn, err := strconv.Atoi(s)\n240\t\tif err != nil || n < 1 {\n241\t\t\treturn fmt.Errorf(\"invalid page length: %q\", s)\n242\t\t}\n243\t\topts.pageLength = n\n244\t\treturn nil\n245\t}\n246\t\n247\tfunc setColumns(opts *options, s string) error {\n248\t\tn, err := strconv.Atoi(s)\n249\t\tif err != nil || n < 1 {\n250\t\t\treturn fmt.Errorf(\"invalid number of columns: %q\", s)\n251\t\t}\n252\t\topts.columns = n\n253\t\treturn nil\n254\t}\n255\t\n256\tfunc setIndent(opts *options, s string) error {\n257\t\tn, err := strconv.Atoi(s)\n258\t\tif err != nil || n < 0 {\n259\t\t\treturn fmt.Errorf(\"invalid indent: %q\", s)\n260\t\t}\n261\t\topts.indent = n\n262\t\treturn nil\n263\t}\n264\t\n265\tfunc setWidth(opts *options, s string) error {\n266\t\tn, err := strconv.Atoi(s)\n267\t\tif err != nil || n < 1 {\n268\t\t\treturn fmt.Errorf(\"invalid page width: %q\", s)\n269\t\t}\n270\t\topts.pageWidth = n\n271\t\treturn nil\n272\t}\n273\t\n274\tfunc isColumnsFlag(s string) bool {\n275\t\tif len(s) < 2 || s[0] != '-' {\n276\t\t\treturn false\n277\t\t}\n278\t\tfor _, c := range s[1:] {\n279\t\t\tif c < '0' || c > '9' {\n280\t\t\t\treturn false\n281\t\t\t}\n282\t\t}\n283\t\treturn true\n284\t}\n285\t\n286\tfunc processFile(path string, opts options, w *bufio.Writer) error {\n287\t\tvar r io.Reader\n288\t\tvar filename string\n289\t\tvar modTime time.Time\n290\t\tif path == \"-\" {\n291\t\t\tr = os.Stdin\n292\t\t\tfilename = \"\"\n293\t\t\tmodTime = time.Now()\n294\t\t} else {\n295\t\t\tf, err := os.Open(path)\n296\t\t\tif err != nil {\n297\t\t\t\treturn err\n298\t\t\t}\n299\t\t\tdefer f.Close()\n300\t\t\tinfo, err := f.Stat()\n301\t\t\tif err != nil {\n302\t\t\t\treturn err\n303\t\t\t}\n304\t\t\tr = f\n305\t\t\tfilename = path\n306\t\t\tmodTime = info.ModTime()\n307\t\t}\n308\t\tif opts.headerSet {\n309\t\t\tfilename = opts.headerText\n310\t\t}\n311\t\treturn paginate(r, filename, modTime, opts, w)\n312\t}\n313\t\n314\tfunc paginate(r io.Reader, filename string, modTime time.Time, opts options, w *bufio.Writer) error {\n315\t\tscanner := bufio.NewScanner(r)\n316\t\tcols := max(opts.columns, 1)\n317\t\tnoHdr := opts.omitHeader || opts.omitPagination\n318\t\tif noHdr && cols <= 1 {\n319\t\t\treturn paginateNoHeader(scanner, w, opts)\n320\t\t}\n321\t\tbody := max(opts.pageLength-headerSize-footerSize, 1)\n322\t\tif noHdr {\n323\t\t\tbody = opts.pageLength\n324\t\t}\n325\t\tbodyLines := body\n326\t\tif opts.doubleSpace {\n327\t\t\tbodyLines = max(body/2, 1)\n328\t\t}\n329\t\tdate := modTime.Format(\"2006-01-02 15:04\")\n330\t\tpageNum := 1\n331\t\tlineNum := 1\n332\t\tfor {\n333\t\t\tlines, eof := readBody(scanner, bodyLines*cols)\n334\t\t\tif len(lines) == 0 && eof {\n335\t\t\t\tbreak\n336\t\t\t}\n337\t\t\tif !noHdr {\n338\t\t\t\tif err := writeHeader(w, date, filename, pageNum, opts); err != nil {\n339\t\t\t\t\treturn err\n340\t\t\t\t}\n341\t\t\t}\n342\t\t\tif cols > 1 {\n343\t\t\t\tif err := writeColumns(w, lines, body, cols, opts, !noHdr, lineNum); err != nil {\n344\t\t\t\t\treturn err\n345\t\t\t\t}\n346\t\t\t} else if err := writeBody(w, lines, body, opts, lineNum); err != nil {\n347\t\t\t\treturn err\n348\t\t\t}\n349\t\t\tif !noHdr {\n350\t\t\t\tif err := writeFooter(w); err != nil {\n351\t\t\t\t\treturn err\n352\t\t\t\t}\n353\t\t\t}\n354\t\t\tlineNum += len(lines)\n355\t\t\tpageNum++\n356\t\t\tif eof {\n357\t\t\t\tbreak\n358\t\t\t}\n359\t\t}\n360\t\treturn scanner.Err()\n361\t}\n362\t\n363\tfunc paginateNoHeader(scanner *bufio.Scanner, w *bufio.Writer, opts options) error {\n364\t\tind := strings.Repeat(\" \", opts.indent)\n365\t\tlineNum := 1\n366\t\tfor scanner.Scan() {\n367\t\t\tprefix := \"\"\n368\t\t\tif opts.numberLines {\n369\t\t\t\tprefix = fmtNum(lineNum, opts.numberSep, opts.numberWidth)\n370\t\t\t}\n371\t\t\tif _, err := fmt.Fprintf(w, \"%s%s%s\\n\", ind, prefix, scanner.Text()); err != nil {\n372\t\t\t\treturn err\n373\t\t\t}\n374\t\t\tif opts.doubleSpace {\n375\t\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n376\t\t\t\t\treturn err\n377\t\t\t\t}\n378\t\t\t}\n379\t\t\tlineNum++\n380\t\t}\n381\t\treturn scanner.Err()\n382\t}\n383\t\n384\tfunc readBody(scanner *bufio.Scanner, n int) ([]string, bool) {\n385\t\tvar lines []string\n386\t\tfor range n {\n387\t\t\tif !scanner.Scan() {\n388\t\t\t\treturn lines, true\n389\t\t\t}\n390\t\t\tlines = append(lines, scanner.Text())\n391\t\t}\n392\t\treturn lines, false\n393\t}\n394\t\n395\tfunc writeHeader(w *bufio.Writer, date, filename string, pageNum int, opts options) error {\n396\t\tif _, err := fmt.Fprint(w, \"\\n\\n\"); err != nil {\n397\t\t\treturn err\n398\t\t}\n399\t\tright := fmt.Sprintf(\"Page %d\", pageNum)\n400\t\tavail := opts.pageWidth - len(date) - len(right)\n401\t\tlpad := avail\n402\t\trpad := 0\n403\t\tif len(filename) < avail {\n404\t\t\tlpad = (avail - len(filename)) / 2\n405\t\t\trpad = avail - len(filename) - lpad\n406\t\t}\n407\t\tind := strings.Repeat(\" \", opts.indent)\n408\t\tline := date + strings.Repeat(\" \", lpad) + filename + strings.Repeat(\" \", rpad) + right\n409\t\tif _, err := fmt.Fprintf(w, \"%s%s\\n\", ind, line); err != nil {\n410\t\t\treturn err\n411\t\t}\n412\t\t_, err := fmt.Fprint(w, \"\\n\\n\")\n413\t\treturn err\n414\t}\n415\t\n416\tfunc writeBody(w *bufio.Writer, lines []string, bodySize int, opts options, lineNum int) error {\n417\t\tind := strings.Repeat(\" \", opts.indent)\n418\t\toutputLines := 0\n419\t\tfor i, line := range lines {\n420\t\t\tprefix := \"\"\n421\t\t\tif opts.numberLines {\n422\t\t\t\tprefix = fmtNum(lineNum+i, opts.numberSep, opts.numberWidth)\n423\t\t\t}\n424\t\t\tif _, err := fmt.Fprintf(w, \"%s%s%s\\n\", ind, prefix, line); err != nil {\n425\t\t\t\treturn err\n426\t\t\t}\n427\t\t\toutputLines++\n428\t\t\tif opts.doubleSpace {\n429\t\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n430\t\t\t\t\treturn err\n431\t\t\t\t}\n432\t\t\t\toutputLines++\n433\t\t\t}\n434\t\t}\n435\t\tfor range bodySize - outputLines {\n436\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n437\t\t\t\treturn err\n438\t\t\t}\n439\t\t}\n440\t\treturn nil\n441\t}\n442\t\n443\tfunc writeFooter(w *bufio.Writer) error {\n444\t\tfor range footerSize {\n445\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n446\t\t\t\treturn err\n447\t\t\t}\n448\t\t}\n449\t\treturn nil\n450\t}\n451\t\n452\tfunc writeColumns(w *bufio.Writer, lines []string, bodySize, cols int, opts options, pad bool, lineNum int) error {\n453\t\tcolWidth := opts.pageWidth / cols\n454\t\tn := len(lines)\n455\t\trows := (n + cols - 1) / cols\n456\t\tfullCols := n - (rows-1)*cols\n457\t\tind := strings.Repeat(\" \", opts.indent)\n458\t\toutputRows := 0\n459\t\tfor r := range rows {\n460\t\t\tif _, err := fmt.Fprint(w, ind); err != nil {\n461\t\t\t\treturn err\n462\t\t\t}\n463\t\t\tlast := lastDataCol(r, cols, rows, fullCols, n, opts.across)\n464\t\t\tfor c := 0; c <= last; c++ {\n465\t\t\t\tidx := colIdx(r, c, cols, rows, fullCols, opts.across)\n466\t\t\t\tcell := fmtCell(lines[idx], idx, c, last, colWidth, lineNum, opts)\n467\t\t\t\tif _, err := fmt.Fprint(w, cell); err != nil {\n468\t\t\t\t\treturn err\n469\t\t\t\t}\n470\t\t\t}\n471\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n472\t\t\t\treturn err\n473\t\t\t}\n474\t\t\toutputRows++\n475\t\t\tif opts.doubleSpace {\n476\t\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n477\t\t\t\t\treturn err\n478\t\t\t\t}\n479\t\t\t\toutputRows++\n480\t\t\t}\n481\t\t}\n482\t\tif pad {\n483\t\t\tfor range bodySize - outputRows {\n484\t\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n485\t\t\t\t\treturn err\n486\t\t\t\t}\n487\t\t\t}\n488\t\t}\n489\t\treturn nil\n490\t}\n491\t\n492\tfunc fmtCell(text string, idx, c, last, colWidth, lineNum int, opts options) string {\n493\t\tprefix := \"\"\n494\t\tif opts.numberLines {\n495\t\t\tprefix = fmtNum(lineNum+idx, opts.numberSep, opts.numberWidth)\n496\t\t}\n497\t\tcell := prefix + text\n498\t\tif c < last {\n499\t\t\tif opts.separatorSet {\n500\t\t\t\treturn cell + opts.separator\n501\t\t\t}\n502\t\t\treturn padToCol(cell, opts.indent+c*colWidth, opts.indent+(c+1)*colWidth)\n503\t\t}\n504\t\treturn cell\n505\t}\n506\t\n507\tfunc fmtNum(n int, sep byte, width int) string {\n508\t\ts := strconv.Itoa(n)\n509\t\tif len(s) < width {\n510\t\t\ts = strings.Repeat(\" \", width-len(s)) + s\n511\t\t}\n512\t\treturn s + string(sep)\n513\t}\n514\t\n515\tfunc lastDataCol(r, cols, rows, fullCols, n int, across bool) int {\n516\t\tif across {\n517\t\t\tif remaining := n - r*cols; remaining >= cols {\n518\t\t\t\treturn cols - 1\n519\t\t\t} else {\n520\t\t\t\treturn remaining - 1\n521\t\t\t}\n522\t\t}\n523\t\tif r < rows-1 || fullCols >= cols {\n524\t\t\treturn cols - 1\n525\t\t}\n526\t\treturn fullCols - 1\n527\t}\n528\t\n529\tfunc colIdx(r, c, cols, rows, fullCols int, across bool) int {\n530\t\tif across {\n531\t\t\treturn r*cols + c\n532\t\t}\n533\t\treturn colDownIdx(r, c, rows, fullCols)\n534\t}\n535\t\n536\tfunc colDownIdx(r, c, rows, fullCols int) int {\n537\t\tif c < fullCols {\n538\t\t\treturn c*rows + r\n539\t\t}\n540\t\treturn fullCols*rows + (c-fullCols)*(rows-1) + r\n541\t}\n542\t\n543\tfunc padToCol(s string, absStart, absTarget int) string {\n544\t\tif absStart+len(s) >= absTarget {\n545\t\t\treturn s[:absTarget-absStart]\n546\t\t}\n547\t\tvar buf strings.Builder\n548\t\tbuf.WriteString(s)\n549\t\tpos := absStart + len(s)\n550\t\tfor pos < absTarget {\n551\t\t\tnextTab := (pos/8 + 1) * 8\n552\t\t\tif nextTab <= absTarget {\n553\t\t\t\tbuf.WriteByte('\\t')\n554\t\t\t\tpos = nextTab\n555\t\t\t} else {\n556\t\t\t\tbuf.WriteString(strings.Repeat(\" \", absTarget-pos))\n557\t\t\t\tpos = absTarget\n558\t\t\t}\n559\t\t}\n560\t\treturn buf.String()\n561\t}\n562\t"}]},"parent_tool_use_id":null,"session_id":"c6e7e902-2507-4531-80ba-08f898ff6c73","uuid":"b63cc17f-fa94-45f2-b921-a0f1985f0d3c","timestamp":"2026-05-30T16:37:19.195Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5674/cmd/pr/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd110-pr R1.1, R2.1, R2.2, R2.3, R3.1, R4.1, R4.2, R4.3.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst (\n\theaderSize     = 5\n\tfooterSize     = 5\n\tdefaultPageLen = 66\n\tdefaultWidth   = 72\n)\n\ntype options struct {\n\tpageLength     int\n\theaderText     string\n\theaderSet      bool\n\tomitHeader     bool\n\tomitPagination bool\n\tcolumns        int\n\tacross         bool\n\tnumberLines    bool\n\tnumberSep      byte\n\tnumberWidth    int\n\tindent         int\n\tpageWidth      int\n\tdoubleSpace    bool\n\tseparator      string\n\tseparatorSet   bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run(os.Args[1:]))\n}\n\nfunc run(args []string) int {\n\topts, files, err := parseArgs(args)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n\t\treturn 1\n\t}\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\tw := bufio.NewWriter(os.Stdout)\n\texitCode := 0\n\tfor _, f := range files {\n\t\tif err := processFile(f, opts, w); err != nil {\n\t\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\t\tos.Exit(0)\n\t\t\t}\n\t\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif err := w.Flush(); err != nil {\n\t\tif errors.Is(err, syscall.EPIPE) {\n\t\t\tos.Exit(0)\n\t\t}\n\t\tfmt.Fprintf(os.Stderr, \"pr: %s\\n\", err)\n\t\texitCode = 1\n\t}\n\treturn exitCode\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\topts := options{\n\t\tpageLength:  defaultPageLen,\n\t\tpageWidth:   defaultWidth,\n\t\tnumberSep:   '\\t',\n\t\tnumberWidth: 5,\n\t}\n\tvar files []string\n\tfor i := 0; i < len(args); i++ {\n\t\ta := args[i]\n\t\tif a == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tvar err error\n\t\tswitch {\n\t\tcase strings.HasPrefix(a, \"--length=\"):\n\t\t\terr = setPageLen(&opts, a[len(\"--length=\"):])\n\t\tcase strings.HasPrefix(a, \"--header=\"):\n\t\t\topts.headerText, opts.headerSet = a[len(\"--header=\"):], true\n\t\tcase a == \"--omit-header\" || a == \"-t\":\n\t\t\topts.omitHeader = true\n\t\tcase a == \"--omit-pagination\" || a == \"-T\":\n\t\t\topts.omitPagination = true\n\t\tcase strings.HasPrefix(a, \"-l\"):\n\t\t\terr = parseLenFlag(args, &i, &opts)\n\t\tcase strings.HasPrefix(a, \"-h\"):\n\t\t\terr = parseHdrFlag(args, &i, &opts)\n\t\tcase a == \"--across\" || a == \"-a\":\n\t\t\topts.across = true\n\t\tcase a == \"--double-space\" || a == \"-d\":\n\t\t\topts.doubleSpace = true\n\t\tcase strings.HasPrefix(a, \"--columns=\"):\n\t\t\terr = setColumns(&opts, a[len(\"--columns=\"):])\n\t\tcase strings.HasPrefix(a, \"--number-lines\"):\n\t\t\terr = parseNumLong(&opts, a)\n\t\tcase strings.HasPrefix(a, \"-n\"):\n\t\t\tparseNumShort(&opts, a)\n\t\tcase strings.HasPrefix(a, \"--indent=\"):\n\t\t\terr = setIndent(&opts, a[len(\"--indent=\"):])\n\t\tcase strings.HasPrefix(a, \"-o\"):\n\t\t\terr = parseIndentFlag(args, &i, &opts)\n\t\tcase strings.HasPrefix(a, \"--width=\"):\n\t\t\terr = setWidth(&opts, a[len(\"--width=\"):])\n\t\tcase strings.HasPrefix(a, \"-w\"):\n\t\t\terr = parseWidthFlag(args, &i, &opts)\n\t\tcase strings.HasPrefix(a, \"--separator=\"):\n\t\t\topts.separator, opts.separatorSet = a[len(\"--separator=\"):], true\n\t\tcase a == \"--separator\" || a == \"-s\":\n\t\t\topts.separator, opts.separatorSet = \"\\t\", true\n\t\tcase strings.HasPrefix(a, \"-s\"):\n\t\t\topts.separator, opts.separatorSet = string(a[2]), true\n\t\tcase isColumnsFlag(a):\n\t\t\terr = setColumns(&opts, a[1:])\n\t\tcase strings.HasPrefix(a, \"-\") && a != \"-\":\n\t\t\terr = fmt.Errorf(\"unrecognized option '%s'\", a)\n\t\tdefault:\n\t\t\tfiles = append(files, a)\n\t\t}\n\t\tif err != nil {\n\t\t\treturn opts, nil, err\n\t\t}\n\t}\n\tif opts.pageLength <= 10 {\n\t\topts.omitHeader = true\n\t}\n\treturn opts, files, nil\n}\n\nfunc parseLenFlag(args []string, i *int, opts *options) error {\n\tv, err := valFlag(args, i, \"-l\")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn setPageLen(opts, v)\n}\n\nfunc parseHdrFlag(args []string, i *int, opts *options) error {\n\tv, err := valFlag(args, i, \"-h\")\n\tif err != nil {\n\t\treturn err\n\t}\n\topts.headerText, opts.headerSet = v, true\n\treturn nil\n}\n\nfunc parseIndentFlag(args []string, i *int, opts *options) error {\n\tv, err := valFlag(args, i, \"-o\")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn setIndent(opts, v)\n}\n\nfunc parseWidthFlag(args []string, i *int, opts *options) error {\n\tv, err := valFlag(args, i, \"-w\")\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn setWidth(opts, v)\n}\n\nfunc parseNumShort(opts *options, a string) {\n\topts.numberLines = true\n\trest := a[2:]\n\tif len(rest) == 0 {\n\t\treturn\n\t}\n\tif rest[0] < '0' || rest[0] > '9' {\n\t\topts.numberSep = rest[0]\n\t\trest = rest[1:]\n\t}\n\tif len(rest) > 0 {\n\t\tif w, err := strconv.Atoi(rest); err == nil && w >= 1 {\n\t\t\topts.numberWidth = w\n\t\t}\n\t}\n}\n\nfunc parseNumLong(opts *options, a string) error {\n\topts.numberLines = true\n\tif a == \"--number-lines\" {\n\t\treturn nil\n\t}\n\tif !strings.HasPrefix(a, \"--number-lines=\") {\n\t\treturn fmt.Errorf(\"unrecognized option '%s'\", a)\n\t}\n\trest := a[len(\"--number-lines=\"):]\n\tif len(rest) == 0 {\n\t\treturn nil\n\t}\n\tif rest[0] < '0' || rest[0] > '9' {\n\t\topts.numberSep = rest[0]\n\t\trest = rest[1:]\n\t}\n\tif len(rest) > 0 {\n\t\tw, err := strconv.Atoi(rest)\n\t\tif err != nil || w < 1 {\n\t\t\treturn fmt.Errorf(\"invalid number width: %q\", rest)\n\t\t}\n\t\topts.numberWidth = w\n\t}\n\treturn nil\n}\n\nfunc valFlag(args []string, i *int, prefix string) (string, error) {\n\ta := args[*i]\n\tif len(a) > len(prefix) {\n\t\treturn a[len(prefix):], nil\n\t}\n\t*i++\n\tif *i >= len(args) {\n\t\treturn \"\", fmt.Errorf(\"option requires an argument -- '%c'\", prefix[1])\n\t}\n\treturn args[*i], nil\n}\n\nfunc setPageLen(opts *options, s string) error {\n\tn, err := strconv.Atoi(s)\n\tif err != nil || n < 1 {\n\t\treturn fmt.Errorf(\"invalid page length: %q\", s)\n\t}\n\topts.pageLength = n\n\treturn nil\n}\n\nfunc setColumns(opts *options, s string) error {\n\tn, err := strconv.Atoi(s)\n\tif err != nil || n < 1 {\n\t\treturn fmt.Errorf(\"invalid number of columns: %q\", s)\n\t}\n\topts.columns = n\n\treturn nil\n}\n\nfunc setIndent(opts *options, s string) error {\n\tn, err := strconv.Atoi(s)\n\tif err != nil || n < 0 {\n\t\treturn fmt.Errorf(\"invalid indent: %q\", s)\n\t}\n\topts.indent = n\n\treturn nil\n}\n\nfunc setWidth(opts *options, s string) error {\n\tn, err := strconv.Atoi(s)\n\tif err != nil || n < 1 {\n\t\treturn fmt.Errorf(\"invalid page width: %q\", s)\n\t}\n\topts.pageWidth = n\n\treturn nil\n}\n\nfunc isColumnsFlag(s string) bool {\n\tif len(s) < 2 || s[0] != '-' {\n\t\treturn false\n\t}\n\tfor _, c := range s[1:] {\n\t\tif c < '0' || c > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc processFile(path string, opts options, w *bufio.Writer) error {\n\tvar r io.Reader\n\tvar filename string\n\tvar modTime time.Time\n\tif path == \"-\" {\n\t\tr = os.Stdin\n\t\tfilename = \"\"\n\t\tmodTime = time.Now()\n\t} else {\n\t\tf, err := os.Open(path)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tdefer f.Close()\n\t\tinfo, err := f.Stat()\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tr = f\n\t\tfilename = path\n\t\tmodTime = info.ModTime()\n\t}\n\tif opts.headerSet {\n\t\tfilename = opts.headerText\n\t}\n\treturn paginate(r, filename, modTime, opts, w)\n}\n\nfunc paginate(r io.Reader, filename string, modTime time.Time, opts options, w *bufio.Writer) error {\n\tscanner := bufio.NewScanner(r)\n\tcols := max(opts.columns, 1)\n\tnoHdr := opts.omitHeader || opts.omitPagination\n\tif noHdr && cols <= 1 {\n\t\treturn paginateNoHeader(scanner, w, opts)\n\t}\n\tbody := max(opts.pageLength-headerSize-footerSize, 1)\n\tif noHdr {\n\t\tbody = opts.pageLength\n\t}\n\tbodyLines := body\n\tif opts.doubleSpace {\n\t\tbodyLines = max(body/2, 1)\n\t}\n\tdate := modTime.Format(\"2006-01-02 15:04\")\n\tpageNum := 1\n\tlineNum := 1\n\tfor {\n\t\tlines, eof := readBody(scanner, bodyLines*cols)\n\t\tif len(lines) == 0 && eof {\n\t\t\tbreak\n\t\t}\n\t\tif !noHdr {\n\t\t\tif err := writeHeader(w, date, filename, pageNum, opts); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tif cols > 1 {\n\t\t\tif err := writeColumns(w, lines, body, cols, opts, !noHdr, lineNum); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t} else if err := writeBody(w, lines, body, opts, lineNum); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif !noHdr {\n\t\t\tif err := writeFooter(w); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tlineNum += len(lines)\n\t\tpageNum++\n\t\tif eof {\n\t\t\tbreak\n\t\t}\n\t}\n\treturn scanner.Err()\n}\n\nfunc paginateNoHeader(scanner *bufio.Scanner, w *bufio.Writer, opts options) error {\n\tind := strings.Repeat(\" \", opts.indent)\n\tlineNum := 1\n\tfor scanner.Scan() {\n\t\tprefix := \"\"\n\t\tif opts.numberLines {\n\t\t\tprefix = fmtNum(lineNum, opts.numberSep, opts.numberWidth)\n\t\t}\n\t\tif _, err := fmt.Fprintf(w, \"%s%s%s\\n\", ind, prefix, scanner.Text()); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif opts.doubleSpace {\n\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tlineNum++\n\t}\n\treturn scanner.Err()\n}\n\nfunc readBody(scanner *bufio.Scanner, n int) ([]string, bool) {\n\tvar lines []string\n\tfor range n {\n\t\tif !scanner.Scan() {\n\t\t\treturn lines, true\n\t\t}\n\t\tlines = append(lines, scanner.Text())\n\t}\n\treturn lines, false\n}\n\nfunc writeHeader(w *bufio.Writer, date, filename string, pageNum int, opts options) error {\n\tif _, err := fmt.Fprint(w, \"\\n\\n\"); err != nil {\n\t\treturn err\n\t}\n\tright := fmt.Sprintf(\"Page %d\", pageNum)\n\tavail := opts.pageWidth - len(date) - len(right)\n\tlpad := avail\n\trpad := 0\n\tif len(filename) < avail {\n\t\tlpad = (avail - len(filename)) / 2\n\t\trpad = avail - len(filename) - lpad\n\t}\n\tind := strings.Repeat(\" \", opts.indent)\n\tline := date + strings.Repeat(\" \", lpad) + filename + strings.Repeat(\" \", rpad) + right\n\tif _, err := fmt.Fprintf(w, \"%s%s\\n\", ind, line); err != nil {\n\t\treturn err\n\t}\n\t_, err := fmt.Fprint(w, \"\\n\\n\")\n\treturn err\n}\n\nfunc writeBody(w *bufio.Writer, lines []string, bodySize int, opts options, lineNum int) error {\n\tind := strings.Repeat(\" \", opts.indent)\n\toutputLines := 0\n\tfor i, line := range lines {\n\t\tprefix := \"\"\n\t\tif opts.numberLines {\n\t\t\tprefix = fmtNum(lineNum+i, opts.numberSep, opts.numberWidth)\n\t\t}\n\t\tif _, err := fmt.Fprintf(w, \"%s%s%s\\n\", ind, prefix, line); err != nil {\n\t\t\treturn err\n\t\t}\n\t\toutputLines++\n\t\tif opts.doubleSpace {\n\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\toutputLines++\n\t\t}\n\t}\n\tfor range bodySize - outputLines {\n\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc writeFooter(w *bufio.Writer) error {\n\tfor range footerSize {\n\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc writeColumns(w *bufio.Writer, lines []string, bodySize, cols int, opts options, pad bool, lineNum int) error {\n\tcolWidth := opts.pageWidth / cols\n\tn := len(lines)\n\trows := (n + cols - 1) / cols\n\tfullCols := n - (rows-1)*cols\n\tind := strings.Repeat(\" \", opts.indent)\n\toutputRows := 0\n\tfor r := range rows {\n\t\tif _, err := fmt.Fprint(w, ind); err != nil {\n\t\t\treturn err\n\t\t}\n\t\tlast := lastDataCol(r, cols, rows, fullCols, n, opts.across)\n\t\tfor c := 0; c <= last; c++ {\n\t\t\tidx := colIdx(r, c, cols, rows, fullCols, opts.across)\n\t\t\tcell := fmtCell(lines[idx], idx, c, last, colWidth, lineNum, opts)\n\t\t\tif _, err := fmt.Fprint(w, cell); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\treturn err\n\t\t}\n\t\toutputRows++\n\t\tif opts.doubleSpace {\n\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\toutputRows++\n\t\t}\n\t}\n\tif pad {\n\t\tfor range bodySize - outputRows {\n\t\t\tif _, err := fmt.Fprint(w, \"\\n\"); err != nil {\n\t\t\t\treturn err\n\t\t\t}\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc fmtCell(text string, idx, c, last, colWidth, lineNum int, opts options) string {\n\tprefix := \"\"\n\tif opts.numberLines {\n\t\tprefix = fmtNum(lineNum+idx, opts.numberSep, opts.numberWidth)\n\t}\n\tcell := prefix + text\n\tif c < last {\n\t\tif opts.separatorSet {\n\t\t\treturn cell + opts.separator\n\t\t}\n\t\treturn padToCol(cell, opts.indent+c*colWidth, opts.indent+(c+1)*colWidth)\n\t}\n\treturn cell\n}\n\nfunc fmtNum(n int, sep byte, width int) string {\n\ts := strconv.Itoa(n)\n\tif len(s) < width {\n\t\ts = strings.Repeat(\" \", width-len(s)) + s\n\t}\n\treturn s + string(sep)\n}\n\nfunc lastDataCol(r, cols, rows, fullCols, n int, across bool) int {\n\tif across {\n\t\tif remaining := n - r*cols; remaining >= cols {\n\t\t\treturn cols - 1\n\t\t} else {\n\t\t\treturn remaining - 1\n\t\t}\n\t}\n\tif r < rows-1 || fullCols >= cols {\n\t\treturn cols - 1\n\t}\n\treturn fullCols - 1\n}\n\nfunc colIdx(r, c, cols, rows, fullCols int, across bool) int {\n\tif across {\n\t\treturn r*cols + c\n\t}\n\treturn colDownIdx(r, c, rows, fullCols)\n}\n\nfunc colDownIdx(r, c, rows, fullCols int) int {\n\tif c < fullCols {\n\t\treturn c*rows + r\n\t}\n\treturn fullCols*rows + (c-fullCols)*(rows-1) + r\n}\n\nfunc padToCol(s string, absStart, absTarget int) string {\n\tif absStart+len(s) >= absTarget {\n\t\treturn s[:absTarget-absStart]\n\t}\n\tvar buf strings.Builder\n\tbuf.WriteString(s)\n\tpos := absStart + len(s)\n\tfor pos < absTarget {\n\t\tnextTab := (pos/8 + 1) * 8\n\t\tif nextTab <= absTarget {\n\t\t\tbuf.WriteByte('\\t')\n\t\t\tpos = nextTab\n\t\t} else {\n\t\t\tbuf.WriteString(strings.Repeat(\" \", absTarget-pos))\n\t\t\tpos = absTarget\n\t\t}\n\t}\n\treturn buf.String()\n}\n","numLines":562,"startLine":1,"totalLines":562}}}
