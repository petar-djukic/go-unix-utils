tc.lines)\n     \t\t\trefOut := captureLines(t, refBin, tc.args, tc.lines)\n     \t\t\tif !bytes.Equal(goOut, refOut) {\n     \t\t\t\tt.Errorf(\"output mismatch\\ngo:  %q\\nref: %q\", goOut, refOut)\n     \t\t\t}\n     \t\t})\n     \t}\n     }\n     \n     func captureLines(t *testing.T, binary string, args []string, n int) []byte {\n     \tt.Helper()\n     \tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n     \tdefer cancel()\n     \tcmd := exec.CommandContext(ctx, binary, args...)\n     \tstdout, err := cmd.StdoutPipe()\n     \tif err != nil {\n     \t\tt.Fatalf(\"StdoutPipe: %v\", err)\n     \t}\n     \tif err := cmd.Start(); err != nil {\n     \t\tt.Fatalf(\"Start: %v\", err)\n     \t}\n     \tvar buf bytes.Buffer\n     \tscanner := bufio.NewScanner(stdout)\n     \tfor i := 0; i < n && scanner.Scan(); i++ {\n     \t\tbuf.Write(scanner.Bytes())\n     \t\tbuf.WriteByte('\\n')\n     \t}\n     \tstdout.Close()\n     \t_ = cmd.Wait()\n     \treturn buf.Bytes()\n     }\n     ```\n\n4. Errors and fixes:\n   - No errors encountered yet - implementation was fully designed in thinking but no files have been written or compiled yet.\n\n5. Problem Solving:\n   - Key problem solved: `yes` produces infinite output, so standard `RunDiffTests` can't be used (it would hang). Solution: custom `captureLines` function that reads N lines from subprocess stdout via `bufio.Scanner`, closes the pipe (triggering SIGPIPE), and returns captured output.\n   - Key design decision: `--` separator handling only checks if FIRST arg is `--` (matching GNU behavior with POSIX getopt `+` mode where first non-option stops scanning).\n   - Decided NOT to implement `--help`/`--version` per E3 (no scope creep) since R1.x doesn't require them.\n   - Verified all 6 test cases trace through the implementation correctly.\n\n6. All user messages:\n   - Message 1: The enormous task prompt providing complete project context, SRD references, execution constitution, go style constitut