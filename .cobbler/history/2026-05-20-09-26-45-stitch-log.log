ring{\"-d\", \"-p\", tmpdir},\n109\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n110\t\t\t\t},\n111\t\t\t})\n112\t\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n113\t\t})\n114\t\n115\t\tt.Run(\"directory_tmpdir_eq\", func(t *testing.T) {\n116\t\t\ttmpdir := t.TempDir()\n117\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n118\t\t\t\t{\n119\t\t\t\t\tName:      \"d_tmpdir_eq\",\n120\t\t\t\t\tArgs:      []string{\"-d\", \"--tmpdir=\" + tmpdir},\n121\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n122\t\t\t\t},\n123\t\t\t})\n124\t\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n125\t\t})\n126\t\n127\t\tt.Run(\"directory_tmpdir_no_value\", func(t *testing.T) {\n128\t\t\ttmpdir := t.TempDir()\n129\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n130\t\t\t\t{\n131\t\t\t\t\tName:      \"d_tmpdir_nv\",\n132\t\t\t\t\tArgs:      []string{\"-d\", \"--tmpdir\"},\n133\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n134\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n135\t\t\t\t},\n136\t\t\t})\n137\t\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n138\t\t})\n139\t\n140\t\tt.Run(\"p_flag_explicit_dir\", func(t *testing.T) {\n141\t\t\ttmpdir := t.TempDir()\n142\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n143\t\t\t\t{\n144\t\t\t\t\tName:      \"p_dir\",\n145\t\t\t\t\tArgs:      []string{\"-p\", tmpdir, \"myXXXXXX\"},\n146\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n147\t\t\t\t},\n148\t\t\t})\n149\t\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n150\t\t})\n151\t\n152\t\tt.Run(\"tmpdir_equals_dir\", func(t *testing.T) {\n153\t\t\ttmpdir := t.TempDir()\n154\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n155\t\t\t\t{\n156\t\t\t\t\tName:      \"tmpdir_eq\",\n157\t\t\t\t\tArgs:      []string{\"--tmpdir=\" + tmpdir, \"myXXXXXX\"},\n158\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n159\t\t\t\t},\n160\t\t\t})\n161\t\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n162\t\t})\n163\t\n164\t\tt.Run(\"tmpdir_no_value\", func(t *testing.T) {\n165\t\t\ttmpdir := t.TempDir()\n166\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n167\t\t\t\t{\n168\t\t\t\t\tName:      \"tmpdir_no_val\",\n169\t\t\t\t\tArgs:      []string{\"--tmpdir\", \"myXXXXXX\"},\n170\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n171\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n172\t\t\t\t},\n173\t\t\t})\n174\t\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n175\t\t})\n176\t\n177\t\tt.Run(\"suffix\", func(t *testing.T) {\n178\t\t\ttmpdir := t.TempDir()\n179\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n180\t\t\t\t{\n181\t\t\t\t\tName:      \"suffix_txt\",\n182\t\t\t\t\tArgs:      []string{\"--suffix=.txt\"},\n183\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n184\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n185\t\t\t\t},\n186\t\t\t})\n187\t\t\tverifySuffix(t, tmpdir, \".txt\")\n188\t\t})\n189\t\n190\t\tt.Run(\"suffix_with_dir\", func(t *testing.T) {\n191\t\t\ttmpdir := t.TempDir()\n192\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n193\t\t\t\t{\n194\t\t\t\t\tName:      \"suffix_p\",\n195\t\t\t\t\tArgs:      []string{\"-d\", \"-p\", tmpdir, \"--suffix=.d\", \"testXXXXXX\"},\n196\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"test\", 6)},\n197\t\t\t\t},\n198\t\t\t})\n199\t\t\tverifySuffix(t, tmpdir, \".d\")\n200\t\t\tverifyCreatedWithSuffix(t, tmpdir, \"test\", 6, \".d\", 0o700, true)\n201\t\t})\n202\t\n203\t\tt.Run(\"t_legacy_mode\", func(t *testing.T) {\n204\t\t\ttmpdir := t.TempDir()\n205\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n206\t\t\t\t{\n207\t\t\t\t\tName:      \"t_flag\",\n208\t\t\t\t\tArgs:      []string{\"-t\", \"myXXXXXX\"},\n209\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n210\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n211\t\t\t\t},\n212\t\t\t})\n213\t\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n214\t\t})\n215\t\n216\t\tt.Run(\"error_suffix_slash\", func(t *testing.T) {\n217\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n218\t\t\t\t{\n219\t\t\t\t\tName:      \"suffix_slash\",\n220\t\t\t\t\tArgs:      []string{\"--suffix=/bad\"},\n221\t\t\t\t\tExitCode:  1,\n222\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n223\t\t\t\t},\n224\t\t\t})\n225\t\t})\n226\t\n227\t\tt.Run(\"error_too_few_xs\", func(t *testing.T) {\n228\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n229\t\t\t\t{\n230\t\t\t\t\tName:      \"two_xs\",\n231\t\t\t\t\tArgs:      []string{\"fooXX\"},\n232\t\t\t\t\tExitCode:  1,\n233\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n234\t\t\t\t},\n235\t\t\t\t{\n236\t\t\t\t\tName:      \"one_x\",\n237\t\t\t\t\tArgs:      []string{\"fooX\"},\n238\t\t\t\t\tExitCode:  1,\n239\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n240\t\t\t\t},\n241\t\t\t\t{\n242\t\t\t\t\tName:      \"no_xs\",\n243\t\t\t\t\tArgs:      []string{\"foo\"},\n244\t\t\t\t\tExitCode:  1,\n245\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n246\t\t\t\t},\n247\t\t\t})\n248\t\t})\n249\t\n250\t\tt.Run(\"error_too_many_templates\", func(t *testing.T) {\n251\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n252\t\t\t\t{\n253\t\t\t\t\tName:      \"two_templates\",\n254\t\t\t\t\tArgs:      []string{\"fooXXX\", \"barXXX\"},\n255\t\t\t\t\tExitCode:  1,\n256\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n257\t\t\t\t},\n258\t\t\t})\n259\t\t})\n260\t\n261\t\tt.Run(\"dry_run_short_flag\", func(t *testing.T) {\n262\t\t\ttmpdir := t.TempDir()\n263\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n264\t\t\t\t{\n265\t\t\t\t\tName:      \"u_flag\",\n266\t\t\t\t\tArgs:      []string{\"-u\"},\n267\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n268\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10), normalizeDryRunWarning},\n269\t\t\t\t},\n270\t\t\t})\n271\t\t\tverifyNotCreated(t, tmpdir)\n272\t\t})\n273\t\n274\t\tt.Run(\"dry_run_long_flag\", func(t *testing.T) {\n275\t\t\ttmpdir := t.TempDir()\n276\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n277\t\t\t\t{\n278\t\t\t\t\tName:      \"dry_run\",\n279\t\t\t\t\tArgs:      []string{\"--dry-run\"},\n280\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n281\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10), normalizeDryRunWarning},\n282\t\t\t\t},\n283\t\t\t})\n284\t\t\tverifyNotCreated(t, tmpdir)\n285\t\t})\n286\t\n287\t\tt.Run(\"dry_run_directory\", func(t *testing.T) {\n288\t\t\ttmpdir := t.TempDir()\n289\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n290\t\t\t\t{\n291\t\t\t\t\tName:      \"u_d\",\n292\t\t\t\t\tArgs:      []string{\"-u\", \"-d\"},\n293\t\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n294\t\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10), normalizeDryRunWarning},\n295\t\t\t\t},\n296\t\t\t})\n297\t\t\tverifyNotCreated(t, tmpdir)\n298\t\t})\n299\t\n300\t\tt.Run(\"quiet_creation_error\", func(t *testing.T) {\n301\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n302\t\t\t\t{\n303\t\t\t\t\tName:     \"q_flag\",\n304\t\t\t\t\tArgs:     []string{\"-q\", \"-p\", \"/nonexistent_mktemp_test_dir\", \"testXXXXXX\"},\n305\t\t\t\t\tExitCode: 1,\n306\t\t\t\t},\n307\t\t\t})\n308\t\t})\n309\t\n310\t\tt.Run(\"quiet_long_creation_error\", func(t *testing.T) {\n311\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n312\t\t\t\t{\n313\t\t\t\t\tName:     \"quiet_flag\",\n314\t\t\t\t\tArgs:     []string{\"--quiet\", \"-p\", \"/nonexistent_mktemp_test_dir\", \"testXXXXXX\"},\n315\t\t\t\t\tExitCode: 1,\n316\t\t\t\t},\n317\t\t\t})\n318\t\t})\n319\t\n320\t\tt.Run(\"quiet_validation_error\", func(t *testing.T) {\n321\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n322\t\t\t\t{\n323\t\t\t\t\tName:      \"q_validation\",\n324\t\t\t\t\tArgs:      []string{\"-q\", \"fooXX\"},\n325\t\t\t\t\tExitCode:  1,\n326\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n327\t\t\t\t},\n328\t\t\t})\n329\t\t})\n330\t}\n331\t\n332\tfunc makeTemplateNormalizer(prefix string, xCount int) testutils.NormalizeFunc {\n333\t\tpattern := regexp.MustCompile(\n334\t\t\tregexp.QuoteMeta(prefix) + `[A-Za-z0-9]{` + fmt.Sprintf(\"%d\", xCount) + `}`,\n335\t\t)\n336\t\treplacement := []byte(prefix + strings.Repeat(\"X\", xCount))\n337\t\treturn func(b []byte) []byte {\n338\t\t\treturn pattern.ReplaceAll(b, replacement)\n339\t\t}\n340\t}\n341\t\n342\tvar dryRunWarningRe = regexp.MustCompile(`(?m)^[^\\n]*warning:[^\\n]*\\n?`)\n343\t\n344\tfunc normalizeDryRunWarning(b []byte) []byte {\n345\t\treturn dryRunWarningRe.ReplaceAll(b, nil)\n346\t}\n347\t\n348\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mktemp\\b`)\n349\t\n350\tfunc normalizeBinaryName(b []byte) []byte {\n351\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mktemp\"))\n352\t}\n353\t\n354\tfunc verifyCreated(t *testing.T, dir, prefix string, suffixLen int, mode os.FileMode, expectDir bool) {\n355\t\tt.Helper()\n356\t\tentries, err := os.ReadDir(dir)\n357\t\tif err != nil {\n358\t\t\tt.Fatalf(\"readdir: %v\", err)\n359\t\t}\n360\t\tfound := 0\n361\t\tfor _, e := range entries {\n362\t\t\tname := e.Name()\n363\t\t\tif !strings.HasPrefix(name, prefix) {\n364\t\t\t\tcontinue\n365\t\t\t}\n366\t\t\tfound++\n367\t\t\tsuffix := name[len(prefix):]\n368\t\t\tif len(suffix) != suffixLen {\n369\t\t\t\tt.Errorf(\"entry %q: expected %d random chars, got %d\", name, suffixLen, len(suffix))\n370\t\t\t}\n371\t\t\tfor _, c := range suffix {\n372\t\t\t\tif !isAlphanumeric(c) {\n373\t\t\t\t\tt.Errorf(\"entry %q: non-alphanumeric char %q in suffix\", name, c)\n374\t\t\t\t}\n375\t\t\t}\n376\t\t\tpath := filepath.Join(dir, name)\n377\t\t\tinfo, err := os.Lstat(path)\n378\t\t\tif err != nil {\n379\t\t\t\tt.Fatalf(\"stat %q: %v\", name, err)\n380\t\t\t}\n381\t\t\tif expectDir {\n382\t\t\t\tif !info.IsDir() {\n383\t\t\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n384\t\t\t\t}\n385\t\t\t} else {\n386\t\t\t\tif !info.Mode().IsRegular() {\n387\t\t\t\t\tt.Errorf(\"entry %q: expected regular file\", name)\n388\t\t\t\t}\n389\t\t\t}\n390\t\t\tif perm := info.Mode().Perm(); perm != mode {\n391\t\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n392\t\t\t}\n393\t\t}\n394\t\tif found == 0 {\n395\t\t\tt.Fatal(\"no matching entries created in temp dir\")\n396\t\t}\n397\t}\n398\t\n399\tfunc verifyCreatedWithSuffix(\n400\t\tt *testing.T, dir, prefix string, randomLen int, fileSuffix string,\n401\t\tmode os.FileMode, expectDir bool,\n402\t) {\n403\t\tt.Helper()\n404\t\tentries, err := os.ReadDir(dir)\n405\t\tif err != nil {\n406\t\t\tt.Fatalf(\"readdir: %v\", err)\n407\t\t}\n408\t\tfound := 0\n409\t\tfor _, e := range entries {\n410\t\t\tname := e.Name()\n411\t\t\tif !strings.HasPrefix(name, prefix) || !strings.HasSuffix(name, fileSuffix) {\n412\t\t\t\tcontinue\n413\t\t\t}\n414\t\t\tfound++\n415\t\t\tmiddle := name[len(prefix) : len(name)-len(fileSuffix)]\n416\t\t\tif len(middle) != randomLen {\n417\t\t\t\tt.Errorf(\"entry %q: expected %d random chars, got %d\", name, randomLen, len(middle))\n418\t\t\t}\n419\t\t\tpath := filepath.Join(dir, name)\n420\t\t\tinfo, err := os.Lstat(path)\n421\t\t\tif err != nil {\n422\t\t\t\tt.Fatalf(\"stat %q: %v\", name, err)\n423\t\t\t}\n424\t\t\tif expectDir && !info.IsDir() {\n425\t\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n426\t\t\t}\n427\t\t\tif perm := info.Mode().Perm(); perm != mode {\n428\t\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n429\t\t\t}\n430\t\t}\n431\t\tif found == 0 {\n432\t\t\tt.Fatal(\"no matching entries created in temp dir\")\n433\t\t}\n434\t}\n435\t\n436\tfunc verifySuffix(t *testing.T, dir, expectedSuffix string) {\n437\t\tt.Helper()\n438\t\tentries, err := os.ReadDir(dir)\n439\t\tif err != nil {\n440\t\t\tt.Fatalf(\"readdir: %v\", err)\n441\t\t}\n442\t\tfor _, e := range entries {\n443\t\t\tif strings.HasSuffix(e.Name(), expectedSuffix) {\n444\t\t\t\treturn\n445\t\t\t}\n446\t\t}\n447\t\tt.Fatalf(\"no entry with suffix %q found in %s\", expectedSuffix, dir)\n448\t}\n449\t\n450\tfunc verifyNotCreated(t *testing.T, dir string) {\n451\t\tt.Helper()\n452\t\tentries, err := os.ReadDir(dir)\n453\t\tif err != nil {\n454\t\t\tt.Fatalf(\"readdir: %v\", err)\n455\t\t}\n456\t\tif len(entries) != 0 {\n457\t\t\tnames := make([]string, len(entries))\n458\t\t\tfor i, e := range entries {\n459\t\t\t\tnames[i] = e.Name()\n460\t\t\t}\n461\t\t\tt.Errorf(\"expected no files in %s, found: %v\", dir, names)\n462\t\t}\n463\t}\n464\t\n465\tfunc isAlphanumeric(c rune) bool {\n466\t\treturn (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')\n467\t}\n468\t"}]},"parent_tool_use_id":null,"session_id":"af6fc51e-1be6-4684-883f-eb9850fb4e76","uuid":"9d81caf5-b527-451b-b38f-57efcb372464","timestamp":"2026-05-20T13:27:57.109Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5353/cmd/mktemp/mktemp_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd036-mktemp R4.1, R4.2, R4.3, R4.4.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gmktemp\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary gmktemp not found\")\n\t}\n\n\tt.Run(\"default_no_args\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"default\",\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o600, false)\n\t})\n\n\tt.Run(\"custom_template\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttemplate := filepath.Join(tmpdir, \"myfileXXXXXX\")\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"custom\",\n\t\t\t\tArgs:      []string{template},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"myfile\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"myfile\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"custom_template_min_xs\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttemplate := filepath.Join(tmpdir, \"fooXXX\")\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"min_xs\",\n\t\t\t\tArgs:      []string{template},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"foo\", 3)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"foo\", 3, 0o600, false)\n\t})\n\n\tt.Run(\"directory_short_flag\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_flag\",\n\t\t\t\tArgs:      []string{\"-d\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"directory_long_flag\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"directory_flag\",\n\t\t\t\tArgs:      []string{\"--directory\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"directory_custom_template\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttemplate := filepath.Join(tmpdir, \"myXXXXXX\")\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_custom\",\n\t\t\t\tArgs:      []string{\"-d\", template},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o700, true)\n\t})\n\n\tt.Run(\"directory_p_flag\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_p\",\n\t\t\t\tArgs:      []string{\"-d\", \"-p\", tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"directory_tmpdir_eq\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_tmpdir_eq\",\n\t\t\t\tArgs:      []string{\"-d\", \"--tmpdir=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"directory_tmpdir_no_value\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"d_tmpdir_nv\",\n\t\t\t\tArgs:      []string{\"-d\", \"--tmpdir\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"tmp.\", 10, 0o700, true)\n\t})\n\n\tt.Run(\"p_flag_explicit_dir\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"p_dir\",\n\t\t\t\tArgs:      []string{\"-p\", tmpdir, \"myXXXXXX\"},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"tmpdir_equals_dir\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"tmpdir_eq\",\n\t\t\t\tArgs:      []string{\"--tmpdir=\" + tmpdir, \"myXXXXXX\"},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"tmpdir_no_value\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"tmpdir_no_val\",\n\t\t\t\tArgs:      []string{\"--tmpdir\", \"myXXXXXX\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"suffix\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"suffix_txt\",\n\t\t\t\tArgs:      []string{\"--suffix=.txt\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10)},\n\t\t\t},\n\t\t})\n\t\tverifySuffix(t, tmpdir, \".txt\")\n\t})\n\n\tt.Run(\"suffix_with_dir\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"suffix_p\",\n\t\t\t\tArgs:      []string{\"-d\", \"-p\", tmpdir, \"--suffix=.d\", \"testXXXXXX\"},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"test\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifySuffix(t, tmpdir, \".d\")\n\t\tverifyCreatedWithSuffix(t, tmpdir, \"test\", 6, \".d\", 0o700, true)\n\t})\n\n\tt.Run(\"t_legacy_mode\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"t_flag\",\n\t\t\t\tArgs:      []string{\"-t\", \"myXXXXXX\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"my\", 6)},\n\t\t\t},\n\t\t})\n\t\tverifyCreated(t, tmpdir, \"my\", 6, 0o600, false)\n\t})\n\n\tt.Run(\"error_suffix_slash\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"suffix_slash\",\n\t\t\t\tArgs:      []string{\"--suffix=/bad\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"error_too_few_xs\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"two_xs\",\n\t\t\t\tArgs:      []string{\"fooXX\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t\t{\n\t\t\t\tName:      \"one_x\",\n\t\t\t\tArgs:      []string{\"fooX\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t\t{\n\t\t\t\tName:      \"no_xs\",\n\t\t\t\tArgs:      []string{\"foo\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"error_too_many_templates\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"two_templates\",\n\t\t\t\tArgs:      []string{\"fooXXX\", \"barXXX\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"dry_run_short_flag\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"u_flag\",\n\t\t\t\tArgs:      []string{\"-u\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10), normalizeDryRunWarning},\n\t\t\t},\n\t\t})\n\t\tverifyNotCreated(t, tmpdir)\n\t})\n\n\tt.Run(\"dry_run_long_flag\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"dry_run\",\n\t\t\t\tArgs:      []string{\"--dry-run\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10), normalizeDryRunWarning},\n\t\t\t},\n\t\t})\n\t\tverifyNotCreated(t, tmpdir)\n\t})\n\n\tt.Run(\"dry_run_directory\", func(t *testing.T) {\n\t\ttmpdir := t.TempDir()\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"u_d\",\n\t\t\t\tArgs:      []string{\"-u\", \"-d\"},\n\t\t\t\tEnv:       []string{\"TMPDIR=\" + tmpdir},\n\t\t\t\tNormalize: []testutils.NormalizeFunc{makeTemplateNormalizer(\"tmp.\", 10), normalizeDryRunWarning},\n\t\t\t},\n\t\t})\n\t\tverifyNotCreated(t, tmpdir)\n\t})\n\n\tt.Run(\"quiet_creation_error\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:     \"q_flag\",\n\t\t\t\tArgs:     []string{\"-q\", \"-p\", \"/nonexistent_mktemp_test_dir\", \"testXXXXXX\"},\n\t\t\t\tExitCode: 1,\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"quiet_long_creation_error\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:     \"quiet_flag\",\n\t\t\t\tArgs:     []string{\"--quiet\", \"-p\", \"/nonexistent_mktemp_test_dir\", \"testXXXXXX\"},\n\t\t\t\tExitCode: 1,\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"quiet_validation_error\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"q_validation\",\n\t\t\t\tArgs:      []string{\"-q\", \"fooXX\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n}\n\nfunc makeTemplateNormalizer(prefix string, xCount int) testutils.NormalizeFunc {\n\tpattern := regexp.MustCompile(\n\t\tregexp.QuoteMeta(prefix) + `[A-Za-z0-9]{` + fmt.Sprintf(\"%d\", xCount) + `}`,\n\t)\n\treplacement := []byte(prefix + strings.Repeat(\"X\", xCount))\n\treturn func(b []byte) []byte {\n\t\treturn pattern.ReplaceAll(b, replacement)\n\t}\n}\n\nvar dryRunWarningRe = regexp.MustCompile(`(?m)^[^\\n]*warning:[^\\n]*\\n?`)\n\nfunc normalizeDryRunWarning(b []byte) []byte {\n\treturn dryRunWarningRe.ReplaceAll(b, nil)\n}\n\nvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mktemp\\b`)\n\nfunc normalizeBinaryName(b []byte) []byte {\n\treturn binaryNameRe.ReplaceAll(b, []byte(\"mktemp\"))\n}\n\nfunc verifyCreated(t *testing.T, dir, prefix string, suffixLen int, mode os.FileMode, expectDir bool) {\n\tt.Helper()\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"readdir: %v\", err)\n\t}\n\tfound := 0\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif !strings.HasPrefix(name, prefix) {\n\t\t\tcontinue\n\t\t}\n\t\tfound++\n\t\tsuffix := name[len(prefix):]\n\t\tif len(suffix) != suffixLen {\n\t\t\tt.Errorf(\"entry %q: expected %d random chars, got %d\", name, suffixLen, len(suffix))\n\t\t}\n\t\tfor _, c := range suffix {\n\t\t\tif !isAlphanumeric(c) {\n\t\t\t\tt.Errorf(\"entry %q: non-alphanumeric char %q in suffix\", name, c)\n\t\t\t}\n\t\t}\n\t\tpath := filepath.Join(dir, name)\n\t\tinfo, err := os.Lstat(path)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"stat %q: %v\", name, err)\n\t\t}\n\t\tif expectDir {\n\t\t\tif !info.IsDir() {\n\t\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n\t\t\t}\n\t\t} else {\n\t\t\tif !info.Mode().IsRegular() {\n\t\t\t\tt.Errorf(\"entry %q: expected regular file\", name)\n\t\t\t}\n\t\t}\n\t\tif perm := info.Mode().Perm(); perm != mode {\n\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n\t\t}\n\t}\n\tif found == 0 {\n\t\tt.Fatal(\"no matching entries created in temp dir\")\n\t}\n}\n\nfunc verifyCreatedWithSuffix(\n\tt *testing.T, dir, prefix string, randomLen int, fileSuffix string,\n\tmode os.FileMode, expectDir bool,\n) {\n\tt.Helper()\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"readdir: %v\", err)\n\t}\n\tfound := 0\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif !strings.HasPrefix(name, prefix) || !strings.HasSuffix(name, fileSuffix) {\n\t\t\tcontinue\n\t\t}\n\t\tfound++\n\t\tmiddle := name[len(prefix) : len(name)-len(fileSuffix)]\n\t\tif len(middle) != randomLen {\n\t\t\tt.Errorf(\"entry %q: expected %d random chars, got %d\", name, randomLen, len(middle))\n\t\t}\n\t\tpath := filepath.Join(dir, name)\n\t\tinfo, err := os.Lstat(path)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"stat %q: %v\", name, err)\n\t\t}\n\t\tif expectDir && !info.IsDir() {\n\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n\t\t}\n\t\tif perm := info.Mode().Perm(); perm != mode {\n\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n\t\t}\n\t}\n\tif found == 0 {\n\t\tt.Fatal(\"no matching entries created in temp dir\")\n\t}\n}\n\nfunc verifySuffix(t *testing.T, dir, expectedSuffix string) {\n\tt.Helper()\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"readdir: %v\", err)\n\t}\n\tfor _, e := range entries {\n\t\tif strings.HasSuffix(e.Name(), expectedSuffix) {\n\t\t\treturn\n\t\t}\n\t}\n\tt.Fatalf(\"no entry with suffix %q found in %s\", expectedSuffix, dir)\n}\n\nfunc verifyNotCreated(t *testing.T, dir string) {\n\tt.Helper()\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\tt.Fatalf(\"readdir: %v\", err)\n\t}\n\tif len(entries) != 0 {\n\t\tnames := make([]string, len(entries))\n\t\tfor i, e := range entries {\n\t\t\tnames[i] = e.Name()\n\t\t}\n\t\tt.Errorf(\"expected no files in %s, found: %v\", dir, names)\n\t}\n}\n\nfunc isAlphanumeric(c rune) bool {\n\treturn (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')\n}\n","numLines":468,"startLine":1,"totalLines":468}}}
