{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YQph5Sxks9WX6WTdPnQoo9","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"path/filepath\"\n12\t\t\"testing\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n15\t)\n16\t\n17\tfunc TestDiff(t *testing.T) {\n18\t\tgoBin := testutils.BuildBinary(t, \".\")\n19\t\trefBin, err := exec.LookPath(\"gtee\")\n20\t\tif err != nil {\n21\t\t\tt.Skip(\"reference binary gtee not found\")\n22\t\t}\n23\t\ttests := []testutils.DiffTest{\n24\t\t\t{Name: \"passthrough_no_files\", Stdin: []byte(\"hello\\nworld\\n\")},\n25\t\t\t{Name: \"empty_stdin\", Stdin: []byte{}},\n26\t\t\t{Name: \"large_input\", Stdin: bytes.Repeat([]byte(\"abcdefghij\\n\"), 1000)},\n27\t\t\t{Name: \"no_trailing_newline\", Stdin: []byte(\"no newline\")},\n28\t\t\t{Name: \"binary_data\", Stdin: allBytes()},\n29\t\t}\n30\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n31\t}\n32\t\n33\tfunc TestDiffSingleFile(t *testing.T) {\n34\t\tgoBin := testutils.BuildBinary(t, \".\")\n35\t\trefBin, err := exec.LookPath(\"gtee\")\n36\t\tif err != nil {\n37\t\t\tt.Skip(\"reference binary gtee not found\")\n38\t\t}\n39\t\tinput := []byte(\"hello\\nworld\\n\")\n40\t\trunFileTest(t, goBin, \"go_single\", input, \"out.txt\")\n41\t\trunFileTest(t, refBin, \"ref_single\", input, \"out.txt\")\n42\t}\n43\t\n44\tfunc TestDiffMultipleFiles(t *testing.T) {\n45\t\tgoBin := testutils.BuildBinary(t, \".\")\n46\t\trefBin, err := exec.LookPath(\"gtee\")\n47\t\tif err != nil {\n48\t\t\tt.Skip(\"reference binary gtee not found\")\n49\t\t}\n50\t\tinput := []byte(\"multi\\nfile\\ntest\\n\")\n51\t\tgoStdout := runMultiFileTest(t, goBin, \"go_multi\", input, \"a.txt\", \"b.txt\")\n52\t\trefStdout := runMultiFileTest(t, refBin, \"ref_multi\", input, \"a.txt\", \"b.txt\")\n53\t\tif !bytes.Equal(goStdout, refStdout) {\n54\t\t\tt.Fatalf(\"stdout divergence\\n  go:  %q\\n  ref: %q\", goStdout, refStdout)\n55\t\t}\n56\t}\n57\t\n58\tfunc TestDiffDashFile(t *testing.T) {\n59\t\tgoBin := testutils.BuildBinary(t, \".\")\n60\t\trefBin, err := exec.LookPath(\"gtee\")\n61\t\tif err != nil {\n62\t\t\tt.Skip(\"reference binary gtee not found\")\n63\t\t}\n64\t\tinput := []byte(\"dash test\\n\")\n65\t\ttests := []testutils.DiffTest{\n66\t\t\t{Name: \"dash_only\", Args: []string{\"-\"}, Stdin: input},\n67\t\t}\n68\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n69\t}\n70\t\n71\tfunc TestDiffAppendMode(t *testing.T) {\n72\t\tgoBin := testutils.BuildBinary(t, \".\")\n73\t\trefBin, err := exec.LookPath(\"gtee\")\n74\t\tif err != nil {\n75\t\t\tt.Skip(\"reference binary gtee not found\")\n76\t\t}\n77\t\trunAppendTest(t, goBin, \"go_append\")\n78\t\trunAppendTest(t, refBin, \"ref_append\")\n79\t}\n80\t\n81\tfunc TestDiffAppendLongFlag(t *testing.T) {\n82\t\tgoBin := testutils.BuildBinary(t, \".\")\n83\t\trefBin, err := exec.LookPath(\"gtee\")\n84\t\tif err != nil {\n85\t\t\tt.Skip(\"reference binary gtee not found\")\n86\t\t}\n87\t\trunAppendTestLong(t, goBin, \"go_append_long\")\n88\t\trunAppendTestLong(t, refBin, \"ref_append_long\")\n89\t}\n90\t\n91\tfunc TestDiffCombinedFlags(t *testing.T) {\n92\t\tgoBin := testutils.BuildBinary(t, \".\")\n93\t\trefBin, err := exec.LookPath(\"gtee\")\n94\t\tif err != nil {\n95\t\t\tt.Skip(\"reference binary gtee not found\")\n96\t\t}\n97\t\tinput := []byte(\"combined\\n\")\n98\t\ttests := []testutils.DiffTest{\n99\t\t\t{Name: \"combined_ai\", Args: []string{\"-ai\"}, Stdin: input},\n100\t\t\t{Name: \"combined_ia\", Args: []string{\"-ia\"}, Stdin: input},\n101\t\t\t{Name: \"separate_a_i\", Args: []string{\"-a\", \"-i\"}, Stdin: input},\n102\t\t}\n103\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n104\t}\n105\t\n106\tfunc TestDiffIgnoreInterrupts(t *testing.T) {\n107\t\tgoBin := testutils.BuildBinary(t, \".\")\n108\t\trefBin, err := exec.LookPath(\"gtee\")\n109\t\tif err != nil {\n110\t\t\tt.Skip(\"reference binary gtee not found\")\n111\t\t}\n112\t\tinput := []byte(\"interrupt test\\n\")\n113\t\ttests := []testutils.DiffTest{\n114\t\t\t{Name: \"ignore_interrupts_short\", Args: []string{\"-i\"}, Stdin: input},\n115\t\t\t{Name: \"ignore_interrupts_long\", Args: []string{\"--ignore-interrupts\"}, Stdin: input},\n116\t\t}\n117\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n118\t}\n119\t\n120\tfunc TestDiffWriteOrder(t *testing.T) {\n121\t\tgoBin := testutils.BuildBinary(t, \".\")\n122\t\trefBin, err := exec.LookPath(\"gtee\")\n123\t\tif err != nil {\n124\t\t\tt.Skip(\"reference binary gtee not found\")\n125\t\t}\n126\t\tvar ordered []byte\n127\t\tfor i := range 100 {\n128\t\t\tordered = fmt.Appendf(ordered, \"line %03d\\n\", i)\n129\t\t}\n130\t\ttests := []testutils.DiffTest{\n131\t\t\t{Name: \"write_order\", Stdin: ordered},\n132\t\t}\n133\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n134\t}\n135\t\n136\tfunc TestDiffMultiFileAppend(t *testing.T) {\n137\t\tgoBin := testutils.BuildBinary(t, \".\")\n138\t\trefBin, err := exec.LookPath(\"gtee\")\n139\t\tif err != nil {\n140\t\t\tt.Skip(\"reference binary gtee not found\")\n141\t\t}\n142\t\trunMultiFileAppendTest(t, goBin, \"go_multi_append\")\n143\t\trunMultiFileAppendTest(t, refBin, \"ref_multi_append\")\n144\t}\n145\t\n146\tfunc TestFileCreation(t *testing.T) {\n147\t\tgoBin := testutils.BuildBinary(t, \".\")\n148\t\tdir := t.TempDir()\n149\t\toutFile := filepath.Join(dir, \"created.txt\")\n150\t\tcmd := exec.Command(goBin, outFile)\n151\t\tcmd.Stdin = bytes.NewReader([]byte(\"create me\\n\"))\n152\t\tout, err := cmd.Output()\n153\t\tif err != nil {\n154\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n155\t\t}\n156\t\tif string(out) != \"create me\\n\" {\n157\t\t\tt.Fatalf(\"stdout: got %q, want %q\", out, \"create me\\n\")\n158\t\t}\n159\t\tgot, err := os.ReadFile(outFile)\n160\t\tif err != nil {\n161\t\t\tt.Fatalf(\"read created file: %v\", err)\n162\t\t}\n163\t\tif string(got) != \"create me\\n\" {\n164\t\t\tt.Fatalf(\"file content: got %q, want %q\", got, \"create me\\n\")\n165\t\t}\n166\t}\n167\t\n168\tfunc TestTruncateExisting(t *testing.T) {\n169\t\tgoBin := testutils.BuildBinary(t, \".\")\n170\t\tdir := t.TempDir()\n171\t\toutFile := filepath.Join(dir, \"existing.txt\")\n172\t\tos.WriteFile(outFile, []byte(\"old content\\n\"), 0o644)\n173\t\tcmd := exec.Command(goBin, outFile)\n174\t\tcmd.Stdin = bytes.NewReader([]byte(\"new\\n\"))\n175\t\tif err := cmd.Run(); err != nil {\n176\t\t\tt.Fatalf(\"unexpected error: %v\", err)\n177\t\t}\n178\t\tgot, err := os.ReadFile(outFile)\n179\t\tif err != nil {\n180\t\t\tt.Fatalf(\"read file: %v\", err)\n181\t\t}\n182\t\tif string(got) != \"new\\n\" {\n183\t\t\tt.Fatalf(\"file content: got %q, want %q\", got, \"new\\n\")\n184\t\t}\n185\t}\n186\t\n187\tfunc runFileTest(t *testing.T, binary, label string, input []byte, fileName string) {\n188\t\tt.Helper()\n189\t\tdir := t.TempDir()\n190\t\toutPath := filepath.Join(dir, fileName)\n191\t\tcmd := exec.Command(binary, outPath)\n192\t\tcmd.Stdin = bytes.NewReader(input)\n193\t\tstdout, err := cmd.Output()\n194\t\tif err != nil {\n195\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n196\t\t}\n197\t\tif !bytes.Equal(stdout, input) {\n198\t\t\tt.Fatalf(\"%s: stdout divergence\\n  got:  %q\\n  want: %q\", label, stdout, input)\n199\t\t}\n200\t\tgot, err := os.ReadFile(outPath)\n201\t\tif err != nil {\n202\t\t\tt.Fatalf(\"%s: read output file: %v\", label, err)\n203\t\t}\n204\t\tif !bytes.Equal(got, input) {\n205\t\t\tt.Fatalf(\"%s: file content divergence\\n  got:  %q\\n  want: %q\", label, got, input)\n206\t\t}\n207\t}\n208\t\n209\tfunc runMultiFileTest(\n210\t\tt *testing.T, binary, label string, input []byte, names ...string,\n211\t) []byte {\n212\t\tt.Helper()\n213\t\tdir := t.TempDir()\n214\t\tvar paths []string\n215\t\tfor _, n := range names {\n216\t\t\tpaths = append(paths, filepath.Join(dir, n))\n217\t\t}\n218\t\tcmd := exec.Command(binary, paths...)\n219\t\tcmd.Stdin = bytes.NewReader(input)\n220\t\tstdout, err := cmd.Output()\n221\t\tif err != nil {\n222\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n223\t\t}\n224\t\tfor _, p := range paths {\n225\t\t\tgot, err := os.ReadFile(p)\n226\t\t\tif err != nil {\n227\t\t\t\tt.Fatalf(\"%s: read %s: %v\", label, p, err)\n228\t\t\t}\n229\t\t\tif !bytes.Equal(got, input) {\n230\t\t\t\tt.Fatalf(\"%s: %s divergence\\n  got:  %q\\n  want: %q\", label, p, got, input)\n231\t\t\t}\n232\t\t}\n233\t\treturn stdout\n234\t}\n235\t\n236\tfunc runAppendTest(t *testing.T, binary, label string) {\n237\t\tt.Helper()\n238\t\tdir := t.TempDir()\n239\t\toutFile := filepath.Join(dir, \"append.txt\")\n240\t\tos.WriteFile(outFile, []byte(\"existing\\n\"), 0o644)\n241\t\tcmd := exec.Command(binary, \"-a\", outFile)\n242\t\tcmd.Stdin = bytes.NewReader([]byte(\"appended\\n\"))\n243\t\tif err := cmd.Run(); err != nil {\n244\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n245\t\t}\n246\t\tgot, err := os.ReadFile(outFile)\n247\t\tif err != nil {\n248\t\t\tt.Fatalf(\"%s: read file: %v\", label, err)\n249\t\t}\n250\t\twant := \"existing\\nappended\\n\"\n251\t\tif string(got) != want {\n252\t\t\tt.Fatalf(\"%s: file content\\n  got:  %q\\n  want: %q\", label, got, want)\n253\t\t}\n254\t}\n255\t\n256\tfunc runAppendTestLong(t *testing.T, binary, label string) {\n257\t\tt.Helper()\n258\t\tdir := t.TempDir()\n259\t\toutFile := filepath.Join(dir, \"append_long.txt\")\n260\t\tos.WriteFile(outFile, []byte(\"existing\\n\"), 0o644)\n261\t\tcmd := exec.Command(binary, \"--append\", outFile)\n262\t\tcmd.Stdin = bytes.NewReader([]byte(\"appended\\n\"))\n263\t\tif err := cmd.Run(); err != nil {\n264\t\t\tt.Fatalf(\"%s: unexpected error: %v\", label, err)\n265\t\t}\n266\t\tgot, err := os.ReadFile(outFile)\n267\t\tif err != nil {\n268\t\t\tt.Fatalf(\"%s: read file: %v\", label, err)\n269\t\t}\n270\t\twant := \"existing\\na