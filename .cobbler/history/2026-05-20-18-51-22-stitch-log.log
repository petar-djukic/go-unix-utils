--bytes=-3\"},\n132\t\t\t\tStdin: []byte(\"abcdefghij\"),\n133\t\t\t},\n134\t\n135\t\t\t// R2.1: stdin via -\n136\t\t\t{\n137\t\t\t\tName:  \"bytes-stdin-dash\",\n138\t\t\t\tArgs:  []string{\"-c\", \"3\", \"-\"},\n139\t\t\t\tStdin: []byte(\"hello\"),\n140\t\t\t},\n141\t\n142\t\t\t// Error: invalid byte count\n143\t\t\t{\n144\t\t\t\tName:      \"bytes-invalid\",\n145\t\t\t\tArgs:      []string{\"-c\", \"abc\"},\n146\t\t\t\tExitCode:  1,\n147\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n148\t\t\t},\n149\t\t}\n150\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n151\t}\n152\t\n153\tfunc TestDiffHeaders(t *testing.T) {\n154\t\tgoBin := testutils.BuildBinary(t, \".\")\n155\t\trefBin, err := exec.LookPath(\"ghead\")\n156\t\tif err != nil {\n157\t\t\tt.Skip(\"reference binary not found\")\n158\t\t}\n159\t\n160\t\tdir := t.TempDir()\n161\t\twriteFixture(t, dir, \"a.txt\", \"alpha\\nbravo\\ncharlie\\n\")\n162\t\twriteFixture(t, dir, \"b.txt\", \"delta\\necho\\nfoxtrot\\n\")\n163\t\n164\t\tdiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n165\t\n166\t\ttests := []testutils.DiffTest{\n167\t\t\t// R3.1: multi-file headers\n168\t\t\t{\n169\t\t\t\tName:    \"multi-file-headers\",\n170\t\t\t\tArgs:    []string{\"a.txt\", \"b.txt\"},\n171\t\t\t\tWorkDir: dir,\n172\t\t\t},\n173\t\t\t// R3.2: single file, no header by default\n174\t\t\t{\n175\t\t\t\tName:    \"single-file-no-header\",\n176\t\t\t\tArgs:    []string{\"a.txt\"},\n177\t\t\t\tWorkDir: dir,\n178\t\t\t},\n179\t\t\t// R3.3: -q suppresses headers on multiple files\n180\t\t\t{\n181\t\t\t\tName:    \"quiet-multi-file\",\n182\t\t\t\tArgs:    []string{\"-q\", \"a.txt\", \"b.txt\"},\n183\t\t\t\tWorkDir: dir,\n184\t\t\t},\n185\t\t\t// R3.3: --quiet long form\n186\t\t\t{\n187\t\t\t\tName:    \"quiet-long-multi-file\",\n188\t\t\t\tArgs:    []string{\"--quiet\", \"a.txt\", \"b.txt\"},\n189\t\t\t\tWorkDir: dir,\n190\t\t\t},\n191\t\t\t// R3.3: --silent long form\n192\t\t\t{\n193\t\t\t\tName:    \"silent-long-multi-file\",\n194\t\t\t\tArgs:    []string{\"--silent\", \"a.txt\", \"b.txt\"},\n195\t\t\t\tWorkDir: dir,\n196\t\t\t},\n197\t\t\t// R3.4: -v forces header on single file\n198\t\t\t{\n199\t\t\t\tName:    \"verbose-single-file\",\n200\t\t\t\tArgs:    []string{\"-v\", \"a.txt\"},\n201\t\t\t\tWorkDir: dir,\n202\t\t\t},\n203\t\t\t// R3.4: --verbose long form\n204\t\t\t{\n205\t\t\t\tName:    \"verbose-long-single-file\",\n206\t\t\t\tArgs:    []string{\"--verbose\", \"a.txt\"},\n207\t\t\t\tWorkDir: dir,\n208\t\t\t},\n209\t\t\t// R3.4: -v with multiple files\n210\t\t\t{\n211\t\t\t\tName:    \"verbose-multi-file\",\n212\t\t\t\tArgs:    []string{\"-v\", \"a.txt\", \"b.txt\"},\n213\t\t\t\tWorkDir: dir,\n214\t\t\t},\n215\t\t\t// R3.3+R3.4: last -q/-v wins\n216\t\t\t{\n217\t\t\t\tName:    \"quiet-then-verbose\",\n218\t\t\t\tArgs:    []string{\"-q\", \"-v\", \"a.txt\"},\n219\t\t\t\tWorkDir: dir,\n220\t\t\t},\n221\t\t\t{\n222\t\t\t\tName:    \"verbose-then-quiet\",\n223\t\t\t\tArgs:    []string{\"-v\", \"-q\", \"a.txt\", \"b.txt\"},\n224\t\t\t\tWorkDir: dir,\n225\t\t\t},\n226\t\t\t// R3.1: multi-file with -n\n227\t\t\t{\n228\t\t\t\tName:    \"multi-file-with-n\",\n229\t\t\t\tArgs:    []string{\"-n\", \"1\", \"a.txt\", \"b.txt\"},\n230\t\t\t\tWorkDir: dir,\n231\t\t\t},\n232\t\t\t// R3.1: multi-file with -c\n233\t\t\t{\n234\t\t\t\tName:    \"multi-file-with-c\",\n235\t\t\t\tArgs:    []string{\"-c\", \"3\", \"a.txt\", \"b.txt\"},\n236\t\t\t\tWorkDir: dir,\n237\t\t\t},\n238\t\t\t// R3.5: error on non-existent file continues processing\n239\t\t\t{\n240\t\t\t\tName:      \"nonexistent-with-valid\",\n241\t\t\t\tArgs:      []string{\"nonexistent.txt\", \"a.txt\"},\n242\t\t\t\tWorkDir:   dir,\n243\t\t\t\tExitCode:  1,\n244\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n245\t\t\t},\n246\t\t\t// R3.5+R4.2: valid file then nonexistent\n247\t\t\t{\n248\t\t\t\tName:      \"valid-then-nonexistent\",\n249\t\t\t\tArgs:      []string{\"a.txt\", \"nonexistent.txt\"},\n250\t\t\t\tWorkDir:   dir,\n251\t\t\t\tExitCode:  1,\n252\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n253\t\t\t},\n254\t\t\t// R3.5+R4.2: nonexistent between valid files\n255\t\t\t{\n256\t\t\t\tName:      \"nonexistent-between-valid\",\n257\t\t\t\tArgs:      []string{\"a.txt\", \"nonexistent.txt\", \"b.txt\"},\n258\t\t\t\tWorkDir:   dir,\n259\t\t\t\tExitCode:  1,\n260\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n261\t\t\t},\n262\t\t\t// R4.2: single nonexistent file\n263\t\t\t{\n264\t\t\t\tName:      \"nonexistent-only\",\n265\t\t\t\tArgs:      []string{\"nonexistent.txt\"},\n266\t\t\t\tWorkDir:   dir,\n267\t\t\t\tExitCode:  1,\n268\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n269\t\t\t},\n270\t\t}\n271\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n272\t}\n273\t\n274\tfunc writeFixture(t *testing.T, dir, name, content string) {\n275\t\tt.Helper()\n276\t\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n277\t\t\tt.Fatal(err)\n278\t\t}\n279\t}\n280\t\n281\tfunc bytes512() []byte {\n282\t\tb := make([]byte, 600)\n283\t\tfor i := range b {\n284\t\t\tb[i] = byte('a' + i%26)\n285\t\t}\n286\t\treturn b\n287\t}\n288\t\n289\tfunc seq(start, end int) []byte {\n290\t\tvar b []byte\n291\t\tfor i := start; i <= end; i++ {\n292\t\t\tb = fmt.Appendf(b, \"%d\\n\", i)\n293\t\t}\n294\t\treturn b\n295\t}\n296\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01LBBmgUDX9K24xFZvbDZ6Gj","session_id":"7572528e-a6da-4fdd-8b4b-68f7c8392313","uuid":"08317a2e-0976-4806-92a4-f12e219be911","timestamp":"2026-05-20T22:52:34.387Z"}
