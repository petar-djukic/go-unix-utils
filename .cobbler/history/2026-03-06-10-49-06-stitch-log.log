{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016kXBctXECttGEXLa4mhbAm","type":"tool_result","content":"     1→// Copyright (c) 2026 Petar Djukic. All rights reserved.\n     2→// SPDX-License-Identifier: MIT\n     3→\n     4→// Package testutils provides the differential testing harness for comparing\n     5→// Go binary output against GNU reference binaries.\n     6→// Implements prd001-testutils.\n     7→package testutils\n     8→\n     9→import (\n    10→\t\"bytes\"\n    11→\t\"os\"\n    12→\t\"os/exec\"\n    13→\t\"path/filepath\"\n    14→\t\"testing\"\n    15→)\n    16→\n    17→// NormalizeFunc transforms output bytes before comparison.\n    18→type NormalizeFunc = func([]byte) []byte\n    19→\n    20→// DiffTest defines a single differential test case.\n    21→type DiffTest struct {\n    22→\tName          string\n    23→\tArgs          []string\n    24→\tStdin         []byte\n    25→\tEnv           []string\n    26→\tWorkDir       string\n    27→\tExitCode      int\n    28→\tNormalize     []NormalizeFunc\n    29→\tExpectedFiles map[string][]byte\n    30→}\n    31→\n    32→type runResult struct {\n    33→\tstdout   []byte\n    34→\tstderr   []byte\n    35→\texitCode int\n    36→}\n    37→\n    38→// BuildBinary compiles the Go package at pkg and returns the path to the\n    39→// resulting binary. The binary is placed in t.TempDir().\n    40→func BuildBinary(t *testing.T, pkg string) string {\n    41→\tt.Helper()\n    42→\tbin := filepath.Join(t.TempDir(), \"binary\")\n    43→\tcmd := exec.Command(\"go\", \"build\", \"-o\", bin, pkg)\n    44→\tout, err := cmd.CombinedOutput()\n    45→\tif err != nil {\n    46→\t\tt.Fatalf(\"BuildBinary: go build failed: %v\\n%s\", err, out)\n    47→\t}\n    48→\treturn bin\n    49→}\n    50→\n    51→// RunDiffTests executes each test case against both goBinary and refBinary,\n    52→// comparing exit code, stdout, and stderr. Normalizers are applied before\n    53→// comparison.\n    54→func RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n    55→\tt.Helper()\n    56→\tfor _, tc := range tests {\n    57→\t\tt.Run(tc.Name, func(t *testing.T) {\n    58→\t\t\tt.Parallel()\n    59→\t\t\tgoRes := runBinary(t, goBinary, tc)\n    60→\t\t\trefRes := runBinary(t, refBinary, tc)\n    61→\n    62→\t\t\tif goRes.exitCode != refRes.exitCode {\n    63→\t\t\t\tt.Errorf(\"exit code mismatch: go=%d ref=%d\", goRes.exitCode, refRes.exitCode)\n    64→\t\t\t}\n    65→\n    66→\t\t\tgoOut := goRes.stdout\n    67→\t\t\trefOut := refRes.stdout\n    68→\t\t\tgoErr := goRes.stderr\n    69→\t\t\trefErr := refRes.stderr\n    70→\t\t\tfor _, n := range tc.Normalize {\n    71→\t\t\t\tgoOut = n(goOut)\n    72→\t\t\t\trefOut = n(refOut)\n    73→\t\t\t\tgoErr = n(goErr)\n    74→\t\t\t\trefErr = n(refErr)\n    75→\t\t\t}\n    76→\n    77→\t\t\tif !bytes.Equal(goOut, refOut) {\n    78→\t\t\t\tt.Errorf(\"stdout mismatch:\\n  go:  %q\\n  ref: %q\", goOut, refOut)\n    79→\t\t\t}\n    80→\t\t\tif !bytes.Equal(goErr, refErr) {\n    81→\t\t\t\tt.Errorf(\"stderr mismatch:\\n  go:  %q\\n  ref: %q\", goErr, refErr)\n    82→\t\t\t}\n    83→\t\t})\n    84→\t}\n    85→}\n    86→\n    87→// ComposeNormalizers chains multiple NormalizeFuncs into one.\n    88→func ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n    89→\treturn func(b []byte) []byte {\n    90→\t\tfor _, fn := range fns {\n    91→\t\t\tb = fn(b)\n    92→\t\t}\n    93→\t\treturn b\n    94→\t}\n    95→}\n    96→\n    97→func runBinary(t *testing.T, binary string, tc DiffTest) runResult {\n    98→\tt.Helper()\n    99→\tcmd := exec.Command(binary, tc.Args...)\n   100→\n   101→\tif len(tc.Stdin) > 0 {\n   102→\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n   103→\t}\n   104→\n   105→\tenv := os.Environ()\n   106→\tenv = append(env, tc.Env...)\n   107→\tcmd.Env = env\n   108→\n   109→\tif tc.WorkDir != \"\" {\n   110→\t\tcmd.Dir = tc.WorkDir\n   111→\t}\n   112→\n   113→\tvar stdout, stderr bytes.Buffer\n   114→\tcmd.Stdout = &stdout\n   115→\tcmd.Stderr = &stderr\n   116→\n   117→\terr := cmd.Run()\n   118→\texitCode := 0\n   119→\tif err != nil {\n   120→\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n   121→\t\t\texitCode = exitErr.ExitCode()\n   122→\t\t} else {\n   123→\t\t\tt.Fatalf(\"failed to run %s: %v\", binary, err)\n   124→\t\t}\n   125→\t}\n   126→\n   127→\treturn runResult{\n   128→\t\tstdout:   stdout.Bytes(),\n   129→\t\tstderr:   stderr.Bytes(),\n   130→\t\texitCode: exitCode,\n   131→\t}\n   132→}\n   133→\n   134→// TimestampNormalizer strips timestamps from output for comparison.\n   135→var TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n   136→\treturn b\n   137→}\n   138→"}]},"parent_tool_use_id":null,"session_id":"4ecf39f2-e3af-4bf5-864a-659ffb740ed4","uuid":"5f6b78bb-ab98-4698-a209-d76035eb044b","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/332/pkg/testutils/testutils.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides the differential testing harness for comparing\n// Go binary output against GNU reference binaries.\n// Implements prd001-testutils.\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"testing\"\n)\n\n// NormalizeFunc transforms output bytes before comparison.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest defines a single differential test case.\ntype DiffTest struct {\n\tName          string\n\tArgs          []string\n\tStdin         []byte\n\tEnv           []string\n\tWorkDir       string\n\tExitCode      int\n\tNormalize     []NormalizeFunc\n\tExpectedFiles map[string][]byte\n}\n\ntype runResult struct {\n\tstdout   []byte\n\tstderr   []byte\n\texitCode int\n}\n\n// BuildBinary compiles the Go package at pkg and returns the path to the\n// resulting binary. The binary is placed in t.TempDir().\nfunc BuildBinary(t *testing.T, pkg string) string {\n\tt.Helper()\n\tbin := filepath.Join(t.TempDir(), \"binary\")\n\tcmd := exec.Command(\"go\", \"build\", \"-o\", bin, pkg)\n\tout, err := cmd.CombinedOutput()\n\tif err != nil {\n\t\tt.Fatalf(\"BuildBinary: go build failed: %v\\n%s\", err, out)\n\t}\n\treturn bin\n}\n\n// RunDiffTests executes each test case against both goBinary and refBinary,\n// comparing exit code, stdout, and stderr. Normalizers are applied before\n// comparison.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tgoRes := runBinary(t, goBinary, tc)\n\t\t\trefRes := runBinary(t, refBinary, tc)\n\n\t\t\tif goRes.exitCode != refRes.exitCode {\n\t\t\t\tt.Errorf(\"exit code mismatch: go=%d ref=%d\", goRes.exitCode, refRes.exitCode)\n\t\t\t}\n\n\t\t\tgoOut := goRes.stdout\n\t\t\trefOut := refRes.stdout\n\t\t\tgoErr := goRes.stderr\n\t\t\trefErr := refRes.stderr\n\t\t\tfor _, n := range tc.Normalize {\n\t\t\t\tgoOut = n(goOut)\n\t\t\t\trefOut = n(refOut)\n\t\t\t\tgoErr = n(goErr)\n\t\t\t\trefErr = n(refErr)\n\t\t\t}\n\n\t\t\tif !bytes.Equal(goOut, refOut) {\n\t\t\t\tt.Errorf(\"stdout mismatch:\\n  go:  %q\\n  ref: %q\", goOut, refOut)\n\t\t\t}\n\t\t\tif !bytes.Equal(goErr, refErr) {\n\t\t\t\tt.Errorf(\"stderr mismatch:\\n  go:  %q\\n  ref: %q\", goErr, refErr)\n\t\t\t}\n\t\t})\n\t}\n}\n\n// ComposeNormalizers chains multiple NormalizeFuncs into one.\nfunc ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n\treturn func(b []byte) []byte {\n\t\tfor _, fn := range fns {\n\t\t\tb = fn(b)\n\t\t}\n\t\treturn b\n\t}\n}\n\nfunc runBinary(t *testing.T, binary string, tc DiffTest) runResult {\n\tt.Helper()\n\tcmd := exec.Command(binary, tc.Args...)\n\n\tif len(tc.Stdin) > 0 {\n\t\tcmd.Stdin = bytes.NewReader(tc.Stdin)\n\t}\n\n\tenv := os.Environ()\n\tenv = append(env, tc.Env...)\n\tcmd.Env = env\n\n\tif tc.WorkDir != \"\" {\n\t\tcmd.Dir = tc.WorkDir\n\t}\n\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\n\terr := cmd.Run()\n\texitCode := 0\n\tif err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\texitCode = exitErr.ExitCode()\n\t\t} else {\n\t\t\tt.Fatalf(\"failed to run %s: %v\", binary, err)\n\t\t}\n\t}\n\n\treturn runResult{\n\t\tstdout:   stdout.Bytes(),\n\t\tstderr:   stderr.Bytes(),\n\t\texitCode: exitCode,\n\t}\n}\n\n// TimestampNormalizer strips timestamps from output for comparison.\nvar TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n\treturn b\n}\n","numLines":138,"startLine":1,"totalLines":138}}}
