   stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"stdio\\nstdlib\\n\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R2.2\n\n  - name: basename_nul_delimited\n    description: \"basename -z /usr/bin/sort; expect 'sort' followed by NUL byte instead of newline.\"\n    inputs:\n      args: [\"-z\", \"/usr/bin/sort\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"sort\\x00\"\n      stderr: \"\"\n    traces:\n      - prd015-basename R3.1\n\n  # --- dirname ---\n  - name: dirname_simple_path\n    description: \"dirname /usr/bin/sort; expect '/usr/bin'.\"\n    inputs:\n      args: [\"/usr/bin/sort\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"/usr/bin\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.1\n\n  - name: dirname_no_directory\n    description: \"dirname stdio.h; expect '.' (current directory).\"\n    inputs:\n      args: [\"stdio.h\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \".\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.2\n\n  - name: dirname_root_path\n    description: \"dirname /; expect '/'.\"\n    inputs:\n      args: [\"/\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"/\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.3\n\n  - name: dirname_trailing_slashes\n    description: \"dirname /usr/bin/; expect '/usr' (trailing slash stripped before processing).\"\n    inputs:\n      args: [\"/usr/bin/\"]\n      stdin: \"\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"/usr\\n\"\n      stderr: \"\"\n    traces:\n      - prd016-dirname R1.1\n      - prd016-dirname R1.4\