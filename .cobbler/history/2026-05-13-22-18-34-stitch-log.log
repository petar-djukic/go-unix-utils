{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C7LqUutNCURqh35zLgsBtE","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage format\n5\t\n6\timport (\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"sync\"\n10\t\n11\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n12\t)\n13\t\n14\tconst (\n15\t\tansiReset    = \"\\033[0m\"\n16\t\tansiDir      = \"\\033[01;34m\"\n17\t\tansiSymlink  = \"\\033[01;36m\"\n18\t\tansiExec     = \"\\033[01;32m\"\n19\t\tansiFifo     = \"\\033[40;33m\"\n20\t\tansiSocket   = \"\\033[01;35m\"\n21\t\tansiBlockDev = \"\\033[01;33m\"\n22\t\tansiCharDev  = \"\\033[01;33m\"\n23\t)\n24\t\n25\tvar (\n26\t\tcolorMu       sync.RWMutex\n27\t\tcolorOverride *bool\n28\t)\n29\t\n30\tfunc colorDisabled() bool {\n31\t\tcolorMu.RLock()\n32\t\toverride := colorOverride\n33\t\tcolorMu.RUnlock()\n34\t\treturn override != nil && !*override\n35\t}\n36\t\n37\t// FileTypeColor returns the ANSI escape sequence for a file's type.\n38\t// R2.1, R2.4, R2.6: returns empty string when color is explicitly disabled via SetColorEnabled(false).\n39\tfunc FileTypeColor(mode os.FileMode) string {\n40\t\tif colorDisabled() {\n41\t\t\treturn \"\"\n42\t\t}\n43\t\tswitch {\n44\t\tcase mode&os.ModeDir != 0:\n45\t\t\treturn ansiDir\n46\t\tcase mode&os.ModeSymlink != 0:\n47\t\t\treturn ansiSymlink\n48\t\tcase mode&os.ModeNamedPipe != 0:\n49\t\t\treturn ansiFifo\n50\t\tcase mode&os.ModeSocket != 0:\n51\t\t\treturn ansiSocket\n52\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n53\t\t\treturn ansiCharDev\n54\t\tcase mode&os.ModeDevice != 0:\n55\t\t\treturn ansiBlockDev\n56\t\tcase mode&0o111 != 0:\n57\t\t\treturn ansiExec\n58\t\tdefault:\n59\t\t\treturn \"\"\n60\t\t}\n61\t}\n62\t\n63\t// Reset returns the ANSI reset sequence.\n64\t// R2.2, R2.6: returns empty string when color is explicitly disabled via SetColorEnabled(false).\n65\tfunc Reset() string {\n66\t\tif colorDisabled() {\n67\t\t\treturn \"\"\n68\t\t}\n69\t\treturn ansiReset\n70\t}\n71\t\n72\tfunc ColorEnabled(w io.Writer) bool {\n73\t\tcolorMu.RLock()\n74\t\toverride := colorOverride\n75\t\tcolorMu.RUnlock()\n76\t\tif override != nil {\n77\t\t\treturn *override\n78\t\t}\n79\t\ttype fder interface {\n80\t\t\tFd() uintptr\n81\t\t}\n82\t\tif f, ok := w.(fder); ok {\n83\t\t\treturn sys.IsTerminal(f.Fd())\n84\t\t}\n85\t\treturn false\n86\t}\n87\t\n88\tfunc SetColorEnabled(enabled bool) {\n89\t\tcolorMu.Lock()\n90\t\tcolorOverride = &enabled\n91\t\tcolorMu.Unlock()\n92\t}\n93\t\n94\tfunc ResetColorEnabled() {\n95\t\tcolorMu.Lock()\n96\t\tcolorOverride = nil\n97\t\tcolorMu.Unlock()\n98\t}\n99\t"}]},"parent_tool_use_id":null,"session_id":"e397dc26-65ab-414f-bd8e-cf485181480c","uuid":"56ba6ffd-3abf-4741-af47-0650ae8c7941","timestamp":"2026-05-14T02:21:38.572Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5122/pkg/format/color.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage format\n\nimport (\n\t\"io\"\n\t\"os\"\n\t\"sync\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst (\n\tansiReset    = \"\\033[0m\"\n\tansiDir      = \"\\033[01;34m\"\n\tansiSymlink  = \"\\033[01;36m\"\n\tansiExec     = \"\\033[01;32m\"\n\tansiFifo     = \"\\033[40;33m\"\n\tansiSocket   = \"\\033[01;35m\"\n\tansiBlockDev = \"\\033[01;33m\"\n\tansiCharDev  = \"\\033[01;33m\"\n)\n\nvar (\n\tcolorMu       sync.RWMutex\n\tcolorOverride *bool\n)\n\nfunc colorDisabled() bool {\n\tcolorMu.RLock()\n\toverride := colorOverride\n\tcolorMu.RUnlock()\n\treturn override != nil && !*override\n}\n\n// FileTypeColor returns the ANSI escape sequence for a file's type.\n// R2.1, R2.4, R2.6: returns empty string when color is explicitly disabled via SetColorEnabled(false).\nfunc FileTypeColor(mode os.FileMode) string {\n\tif colorDisabled() {\n\t\treturn \"\"\n\t}\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn ansiDir\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn ansiSymlink\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn ansiFifo\n\tcase mode&os.ModeSocket != 0:\n\t\treturn ansiSocket\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn ansiCharDev\n\tcase mode&os.ModeDevice != 0:\n\t\treturn ansiBlockDev\n\tcase mode&0o111 != 0:\n\t\treturn ansiExec\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\n// Reset returns the ANSI reset sequence.\n// R2.2, R2.6: returns empty string when color is explicitly disabled via SetColorEnabled(false).\nfunc Reset() string {\n\tif colorDisabled() {\n\t\treturn \"\"\n\t}\n\treturn ansiReset\n}\n\nfunc ColorEnabled(w io.Writer) bool {\n\tcolorMu.RLock()\n\toverride := colorOverride\n\tcolorMu.RUnlock()\n\tif override != nil {\n\t\treturn *override\n\t}\n\ttype fder interface {\n\t\tFd() uintptr\n\t}\n\tif f, ok := w.(fder); ok {\n\t\treturn sys.IsTerminal(f.Fd())\n\t}\n\treturn false\n}\n\nfunc SetColorEnabled(enabled bool) {\n\tcolorMu.Lock()\n\tcolorOverride = &enabled\n\tcolorMu.Unlock()\n}\n\nfunc ResetColorEnabled() {\n\tcolorMu.Lock()\n\tcolorOverride = nil\n\tcolorMu.Unlock()\n}\n","numLines":99,"startLine":1,"totalLines":99}}}
