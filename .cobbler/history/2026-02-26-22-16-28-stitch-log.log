   53→\tif refBinaryPath == \"\" {\n    54→\t\tt.Skip(\"reference binary 'ts' not found on PATH; install moreutils to run differential tests\")\n    55→\t}\n    56→\n    57→\ttests := []testutils.DiffTest{\n    58→\t\t{\n    59→\t\t\t// prd004-ts R1.1, R1.2, R1.4 — default format with three-line stdin\n    60→\t\t\tName:             \"default_format_three_lines\",\n    61→\t\t\tArgs:             nil,\n    62→\t\t\tStdin:            []byte(\"line1\\nline2\\nline3\\n\"),\n    63→\t\t\tEnv:              []string{\"LC_ALL=C\"},\n    64→\t\t\tExpectedExitCode: 0,\n    65→\t\t\tNormalize:        []testutils.Normalize{testutils.TimestampNormalizer},\n    66→\t\t},\n    67→\t\t{\n    68→\t\t\t// prd004-ts R1.6 — empty stdin produces no output, exits 0\n    69→\t\t\tName:             \"default_format_empty_stdin\",\n    70→\t\t\tArgs:             nil,\n    71→\t\t\tStdin:            []byte{},\n    72→\t\t\tEnv:              []string{\"LC_ALL=C\"},\n    73→\t\t\tExpectedExitCode: 0,\n    74→\t\t\tNormalize:        nil,\n    75→\t\t},\n    76→\t\t{\n    77→\t\t\t// prd004-ts R1.5 — partial last line (no trailing newline) must be timestamped\n    78→\t\t\tName:             \"default_format_partial_last_line\",\n    79→\t\t\tArgs:             nil,\n    80→\t\t\tStdin:            []byte(\"partial\"),\n    81→\t\t\tEnv:              []string{\"LC_ALL=C\"},\n    82→\t\t\tExpectedExitCode: 0,\n    83→\t\t\tNormalize:        []testutils.Normalize{testutils.TimestampNormalizer},\n    84→\t\t},\n    85→\t\t{\n    86→\t\t\t// prd004-ts R2.1, R2.2 — custom strftime format string\n    87→\t\t\tName:             \"custom_strftime_format\",\n    88→\t\t\tArgs:             []string{\"%Y-%m-%dT%H:%M:%S\"},\n    89→\t\t\tStdin:            []byte(\"hello\\nworld\\n\"),\n    90→\t\t\tEnv:              []string{\"LC_ALL=C\"},\n    91→\t\t\tExpectedExitCode: 0,\n    92→\t\t\tNormalize:        []testutils.Normalize{testutils.TimestampNormalizer},\n    93→\t\t},\n    94→\t\t{\n    95→\t\t\t// prd004