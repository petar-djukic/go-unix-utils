{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P7T3u8DqRdbW9oSNCWwdMX","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Package format provides output formatting shared across utilities including\n5\t// human-readable size conversion, ANSI color output, and column alignment.\n6\t// Implements srd003-format.\n7\tpackage format\n8\t\n9\timport \"fmt\"\n10\t\n11\t// HumanSizeOpts configures human-readable size formatting.\n12\t// R3.1: Binary selects 1024-based (K, M, G) vs 1000-based (kB, MB, GB) units.\n13\ttype HumanSizeOpts struct {\n14\t\tBinary bool\n15\t}\n16\t\n17\tvar (\n18\t\tbinarySuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n19\t\tsiSuffixes     = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n20\t)\n21\t\n22\t// HumanSize formats a byte count as a human-readable string with unit suffix.\n23\t// R3.2: binary mode uses base 1024; SI mode uses base 1000.\n24\t// R3.3: outputs at most one decimal place when the value is fractional.\n25\t// R3.4: returns \"0\" for zero bytes.\n26\tfunc HumanSize(bytes int64, opts HumanSizeOpts) string {\n27\t\tif bytes == 0 {\n28\t\t\treturn \"0\"\n29\t\t}\n30\t\n31\t\tvar base float64\n32\t\tvar suffixes []string\n33\t\tif opts.Binary {\n34\t\t\tbase = 1024\n35\t\t\tsuffixes = binarySuffixes\n36\t\t} else {\n37\t\t\tbase = 1000\n38\t\t\tsuffixes = siSuffixes\n39\t\t}\n40\t\n41\t\tval := float64(bytes)\n42\t\tfor i, suffix := range suffixes {\n43\t\t\tnext := val / base\n44\t\t\tif next < 1 || i == len(suffixes)-1 {\n45\t\t\t\treturn formatValue(val, suffix)\n46\t\t\t}\n47\t\t\tval = next\n48\t\t}\n49\t\treturn formatValue(val, suffixes[len(suffixes)-1])\n50\t}\n51\t\n52\tfunc formatValue(val float64, suffix string) string {\n53\t\tif suffix == \"\" {\n54\t\t\treturn fmt.Sprintf(\"%d\", int64(val))\n55\t\t}\n56\t\treturn fmt.Sprintf(\"%.1f%s\", val, suffix)\n57\t}\n58\t"}]},"parent_tool_use_id":null,"session_id":"46b161d1-ee54-420c-922a-e7b43e613093","uuid":"b8b1ab04-da6f-4da5-adca-58003596ddca","timestamp":"2026-05-13T23:31:21.361Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5092/pkg/format/humansize.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package format provides output formatting shared across utilities including\n// human-readable size conversion, ANSI color output, and column alignment.\n// Implements srd003-format.\npackage format\n\nimport \"fmt\"\n\n// HumanSizeOpts configures human-readable size formatting.\n// R3.1: Binary selects 1024-based (K, M, G) vs 1000-based (kB, MB, GB) units.\ntype HumanSizeOpts struct {\n\tBinary bool\n}\n\nvar (\n\tbinarySuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\tsiSuffixes     = []string{\"\", \"kB\", \"MB\", \"GB\", \"TB\"}\n)\n\n// HumanSize formats a byte count as a human-readable string with unit suffix.\n// R3.2: binary mode uses base 1024; SI mode uses base 1000.\n// R3.3: outputs at most one decimal place when the value is fractional.\n// R3.4: returns \"0\" for zero bytes.\nfunc HumanSize(bytes int64, opts HumanSizeOpts) string {\n\tif bytes == 0 {\n\t\treturn \"0\"\n\t}\n\n\tvar base float64\n\tvar suffixes []string\n\tif opts.Binary {\n\t\tbase = 1024\n\t\tsuffixes = binarySuffixes\n\t} else {\n\t\tbase = 1000\n\t\tsuffixes = siSuffixes\n\t}\n\n\tval := float64(bytes)\n\tfor i, suffix := range suffixes {\n\t\tnext := val / base\n\t\tif next < 1 || i == len(suffixes)-1 {\n\t\t\treturn formatValue(val, suffix)\n\t\t}\n\t\tval = next\n\t}\n\treturn formatValue(val, suffixes[len(suffixes)-1])\n}\n\nfunc formatValue(val float64, suffix string) string {\n\tif suffix == \"\" {\n\t\treturn fmt.Sprintf(\"%d\", int64(val))\n\t}\n\treturn fmt.Sprintf(\"%.1f%s\", val, suffix)\n}\n","numLines":58,"startLine":1,"totalLines":58}}}
