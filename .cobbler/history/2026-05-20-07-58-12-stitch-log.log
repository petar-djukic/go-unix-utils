\tExitCode:  1,\n109\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n110\t\t\t\t},\n111\t\t\t\t{\n112\t\t\t\t\tName:      \"one_x\",\n113\t\t\t\t\tArgs:      []string{\"fooX\"},\n114\t\t\t\t\tExitCode:  1,\n115\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n116\t\t\t\t},\n117\t\t\t\t{\n118\t\t\t\t\tName:      \"no_xs\",\n119\t\t\t\t\tArgs:      []string{\"foo\"},\n120\t\t\t\t\tExitCode:  1,\n121\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n122\t\t\t\t},\n123\t\t\t})\n124\t\t})\n125\t\n126\t\tt.Run(\"error_too_many_templates\", func(t *testing.T) {\n127\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n128\t\t\t\t{\n129\t\t\t\t\tName:      \"two_templates\",\n130\t\t\t\t\tArgs:      []string{\"fooXXX\", \"barXXX\"},\n131\t\t\t\t\tExitCode:  1,\n132\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n133\t\t\t\t},\n134\t\t\t})\n135\t\t})\n136\t}\n137\t\n138\tfunc makeTemplateNormalizer(prefix string, xCount int) testutils.NormalizeFunc {\n139\t\tpattern := regexp.MustCompile(\n140\t\t\tregexp.QuoteMeta(prefix) + `[A-Za-z0-9]{` + fmt.Sprintf(\"%d\", xCount) + `}`,\n141\t\t)\n142\t\treplacement := []byte(prefix + strings.Repeat(\"X\", xCount))\n143\t\treturn func(b []byte) []byte {\n144\t\t\treturn pattern.ReplaceAll(b, replacement)\n145\t\t}\n146\t}\n147\t\n148\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mktemp\\b`)\n149\t\n150\tfunc normalizeBinaryName(b []byte) []byte {\n151\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mktemp\"))\n152\t}\n153\t\n154\tfunc verifyCreated(t *testing.T, dir, prefix string, suffixLen int, mode os.FileMode, expectDir bool) {\n155\t\tt.Helper()\n156\t\tentries, err := os.ReadDir(dir)\n157\t\tif err != nil {\n158\t\t\tt.Fatalf(\"readdir: %v\", err)\n159\t\t}\n160\t\tfound := 0\n161\t\tfor _, e := range entries {\n162\t\t\tname := e.Name()\n163\t\t\tif !strings.HasPrefix(name, prefix) {\n164\t\t\t\tcontinue\n165\t\t\t}\n166\t\t\tfoun