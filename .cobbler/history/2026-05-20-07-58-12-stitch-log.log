{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J7pxv2t7mYA97aPM978EH1","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd037-ln R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3, R2.4,\n5\t// R3.1, R3.2, R3.3, R3.4, R3.5, R3.6.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"bufio\"\n10\t\t\"fmt\"\n11\t\t\"os\"\n12\t\t\"path/filepath\"\n13\t\t\"strings\"\n14\t\t\"syscall\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tconst helpText = `Usage: ln [OPTION]... TARGET LINK_NAME\n20\t  or:  ln [OPTION]... TARGET\n21\t  or:  ln [OPTION]... TARGET... DIRECTORY\n22\tIn the 1st form, create a link to TARGET with the name LINK_NAME.\n23\tIn the 2nd form, create a link to TARGET in the current directory.\n24\tIn the 3rd form, create links to each TARGET in DIRECTORY.\n25\t\n26\t  -b                         like --backup but does not accept an argument\n27\t  -f, --force                remove existing destination files\n28\t  -i, --interactive          prompt whether to remove destinations\n29\t  -n, --no-dereference       treat LINK_NAME as a normal file if\n30\t                              it is a symbolic link to a directory\n31\t  -r, --relative             create symbolic links relative to link location\n32\t  -s, --symbolic             make symbolic links instead of hard links\n33\t  -S, --suffix=SUFFIX        override the usual backup suffix\n34\t  -v, --verbose              print name of each linked file\n35\t      --backup[=CONTROL]     make a backup of each existing destination file\n36\t      --help                 display this help and exit\n37\t      --version              output version information and exit\n38\t`\n39\t\n40\tconst versionText = `ln (go-unix-utils) dev\n41\t`\n42\t\n43\ttype options struct {\n44\t\tsymbolic      bool\n45\t\trelative      bool\n46\t\tforce         bool\n47\t\tinteractive   bool\n48\t\tnoDereference bool\n49\t\tverbose       bool\n50\t\tbackupMethod  string\n51\t\tsuffix        string\n52\t}\n53\t\n54\tfunc main() {\n55\t\tsys.InstallSIGPIPEHandler()\n56\t\n57\t\topts, targets, err := parseArgs(os.Args[1:])\n58\t\tif err != nil {\n59\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n60\t\t\tfmt.Fprintf(os.Stderr, \"Try 'ln --help' for more information.\\n\")\n61\t\t\tos.Exit(1)\n62\t\t}\n63\t\n64\t\tos.Exit(run(opts, targets))\n65\t}\n66\t\n67\tfunc run(opts options, targets []string) int {\n68\t\texitCode := 0\n69\t\tlast := targets[len(targets)-1]\n70\t\n71\t\tswitch {\n72\t\tcase len(targets) == 1:\n73\t\t\tlinkName := \"./\" + filepath.Base(targets[0])\n74\t\t\texitCode = doLink(targets[0], linkName, opts, exitCode)\n75\t\tcase isDirDest(last, opts.noDereference):\n76\t\t\tfor _, target := range targets[:len(targets)-1] {\n77\t\t\t\tlinkName := filepath.Join(last, filepath.Base(target))\n78\t\t\t\texitCode = doLink(target, linkName, opts, exitCode)\n79\t\t\t}\n80\t\tcase len(targets) == 2:\n81\t\t\texitCode = doLink(targets[0], targets[1], opts, exitCode)\n82\t\tdefault:\n83\t\t\tfmt.Fprintf(os.Stderr, \"ln: target '%s': %s\\n\",\n84\t\t\t\tlast, targetDirError(last))\n85\t\t\texitCode = 1\n86\t\t}\n87\t\n88\t\treturn exitCode\n89\t}\n90\t\n91\tfunc doLink(target, linkName string, opts options, code int) int {\n92\t\tok, err := createLink(target, linkName, opts)\n93\t\tif err != nil {\n94\t\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n95\t\t\treturn 1\n96\t\t}\n97\t\tif !ok {\n98\t\t\treturn 1\n99\t\t}\n100\t\treturn code\n101\t}\n102\t\n103\tfunc createLink(target, linkName string, opts options) (bool, error) {\n104\t\tproceed, backupPath, err := handleExisting(linkName, opts)\n105\t\tif err != nil {\n106\t\t\treturn false, err\n107\t\t}\n108\t\tif !proceed {\n109\t\t\treturn false, nil\n110\t\t}\n111\t\n112\t\tif opts.symbolic {\n113\t\t\treturn true, createSymLink(target, linkName, opts, backupPath)\n114\t\t}\n115\t\treturn true, createHardLink(target, linkName, opts, backupPath)\n116\t}\n117\t\n118\tfunc createSymLink(target, linkName string, opts options, backupPath string) error {\n119\t\tt := target\n120\t\tif opts.relative {\n121\t\t\trel, err := computeRelative(target, linkName)\n122\t\t\tif err != nil {\n123\t\t\t\treturn err\n124\t\t\t}\n125\t\t\tt = rel\n126\t\t}\n127\t\tif err := os.Symlink(t, linkName); err != nil {\n128\t\t\treturn fmt.Errorf(\"failed to create symbolic link '%s': %s\",\n129\t\t\t\tlinkName, sysErrMsg(err))\n130\t\t}\n131\t\tif opts.verbose {\n132\t\t\tprintVerbose(backupPath, linkName, \"->\", t)\n133\t\t}\n134\t\treturn nil\n135\t}\n136\t\n137\tfunc createHardLink(target, linkName string, opts options, backupPath string) error {\n138\t\tfi, err := os.Stat(target)\n139\t\tif err != nil {\n140\t\t\treturn fmt.Errorf(\"failed to access '%s': %s\", target, sysErrMsg(err))\n141\t\t}\n142\t\tif fi.IsDir() {\n143\t\t\treturn fmt.Errorf(\"%s: hard link not allowed for directory\", target)\n144\t\t}\n145\t\tif err := os.Link(target, linkName); err != nil {\n146\t\t\treturn fmt.Errorf(\"failed to create hard link '%s': %s\",\n147\t\t\t\tlinkName, sysErrMsg(err))\n148\t\t}\n149\t\tif opts.verbose {\n150\t\t\tprintVerbose(backupPath, linkName, \"=>\", target)\n151\t\t}\n152\t\treturn nil\n153\t}\n154\t\n155\tfunc printVerbose(backupPath, linkName, arrow, target string) {\n156\t\tif backupPath != \"\" {\n157\t\t\tfmt.Fprintf(os.Stdout, \"'%s' ~ '%s' %s '%s'\\n\", backupPath, linkName, arrow, target)\n158\t\t} else {\n159\t\t\tfmt.Fprintf(os.Stdout, \"'%s' %s '%s'\\n\", linkName, arrow, target)\n160\t\t}\n161\t}\n162\t\n163\tfunc handleExisting(linkName string, opts options) (bool, string, error) {\n164\t\t_, err := os.Lstat(linkName)\n165\t\tif err != nil {\n166\t\t\treturn true, \"\", nil\n167\t\t}\n168\t\n169\t\tif opts.interactive {\n170\t\t\tif !confirmReplace(linkName) {\n171\t\t\t\treturn false, \"\", nil\n172\t\t\t}\n173\t\t} else if !opts.force && opts.backupMethod == \"\" {\n174\t\t\treturn true, \"\", nil\n175\t\t}\n176\t\n177\t\tvar backupPath string\n178\t\tif opts.backupMethod != \"\" {\n179\t\t\tbackupPath, err = makeBackup(linkName, opts)\n180\t\t\tif err != nil {\n181\t\t\t\treturn false, \"\", err\n182\t\t\t}\n183\t\t} else {\n184\t\t\tif err := os.Remove(linkName); err != nil {\n185\t\t\t\treturn false, \"\", fmt.Errorf(\"cannot remove '%s': %s\",\n186\t\t\t\t\tlinkName, sysErrMsg(err))\n187\t\t\t}\n188\t\t}\n189\t\n190\t\treturn true, backupPath, nil\n191\t}\n192\t\n193\tfunc makeBackup(path string, opts options) (string, error) {\n194\t\tvar backupPath string\n195\t\tswitch opts.backupMethod {\n196\t\tcase \"numbered\":\n197\t\t\tbackupPath = nextNumberedBackup(path)\n198\t\tcase \"existing\":\n199\t\t\tif hasNumberedBackups(path) {\n200\t\t\t\tbackupPath = nextNumberedBackup(path)\n201\t\t\t} else {\n202\t\t\t\tbackupPath = path + opts.suffix\n203\t\t\t}\n204\t\tdefault:\n205\t\t\tbackupPath = path + opts.suffix\n206\t\t}\n207\t\n208\t\tif err := os.Rename(path, backupPath); err != nil {\n209\t\t\treturn \"\", fmt.Errorf(\"cannot backup '%s' to '%s': %s\",\n210\t\t\t\tpath, backupPath, sysErrMsg(err))\n211\t\t}\n212\t\treturn backupPath, nil\n213\t}\n214\t\n215\tfunc nextNumberedBackup(path string) string {\n216\t\tfor i := 1; ; i++ {\n217\t\t\tbp := fmt.Sprintf(\"%s.~%d~\", path, i)\n218\t\t\tif _, err := os.Lstat(bp); err != nil {\n219\t\t\t\treturn bp\n220\t\t\t}\n221\t\t}\n222\t}\n223\t\n224\tfunc hasNumberedBackups(path string) bool {\n225\t\tdir := filepath.Dir(path)\n226\t\tbase := filepath.Base(path)\n227\t\tentries, err := os.ReadDir(dir)\n228\t\tif err != nil {\n229\t\t\treturn false\n230\t\t}\n231\t\tprefix := base + \".~\"\n232\t\tfor _, e := range entries {\n233\t\t\tname := e.Name()\n234\t\t\tif strings.HasPrefix(name, prefix) && strings.HasSuffix(name, \"~\") {\n235\t\t\t\tmiddle := name[len(prefix) : len(name)-1]\n236\t\t\t\tif len(middle) > 0 && isAllDigits(middle) {\n237\t\t\t\t\treturn true\n238\t\t\t\t}\n239\t\t\t}\n240\t\t}\n241\t\treturn false\n242\t}\n243\t\n244\tfunc isAllDigits(s string) bool {\n245\t\tfor _, c := range s {\n246\t\t\tif c < '0' || c > '9' {\n247\t\t\t\treturn false\n248\t\t\t}\n249\t\t}\n250\t\treturn true\n251\t}\n252\t\n253\tfunc confirmReplace(dest string) bool {\n254\t\tif !sys.IsTerminal(os.Stdin.Fd()) {\n255\t\t\treturn false\n256\t\t}\n257\t\tfmt.Fprintf(os.Stderr, \"ln: replace '%s'? \", dest)\n258\t\tscanner := bufio.NewScanner(os.Stdin)\n259\t\tif !scanner.Scan() {\n260\t\t\treturn false\n261\t\t}\n262\t\tline := scanner.Text()\n263\t\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n264\t}\n265\t\n266\tfunc computeRelative(target, linkName string) (string, error) {\n267\t\tabsTarget, err := filepath.Abs(target)\n268\t\tif err != nil {\n269\t\t\treturn \"\", fmt.Errorf(\"failed to access '%s': %s\", target, sysErrMsg(err))\n270\t\t}\n271\t\tlinkDir := filepath.Dir(linkName)\n272\t\tabsLinkDir, err := filepath.Abs(linkDir)\n273\t\tif err != nil {\n274\t\t\treturn \"\", fmt.Errorf(\"failed to access '%s': %s\", linkDir, sysErrMsg(err))\n275\t\t}\n276\t\trel, err := filepath.Rel(absLinkDir, absTarget)\n277\t\tif err != nil {\n278\t\t\treturn \"\", fmt.Errorf(\"failed to compute relative path: %s\", err)\n279\t\t}\n280\t\treturn rel, nil\n281\t}\n282\t\n283\tfunc isDirDest(path string, noDereference bool) bool {\n284\t\tvar fi os.FileInfo\n285\t\tvar err error\n286\t\tif noDereference {\n287\t\t\tfi, err = os.Lstat(path)\n288\t\t} else {\n289\t\t\tfi, err = os.Stat(path)\n290\t\t}\n291\t\tif err != nil {\n292\t\t\treturn false\n293\t\t}\n294\t\treturn fi.IsDir()\n295\t}\n296\t\n297\tfunc targetDirError(path string) string {\n298\t\t_, err := os.Stat(path)\n299\t\tif err != nil {\n300\t\t\treturn \"No such file or directory\"\n301\t\t}\n302\t\treturn \"Not a directory\"\n303\t}\n304\t\n305\tfunc sysErrMsg(err error) string {\n306\t\tpe, ok := err.(*os.PathError)\n307\t\tif !ok {\n308\t\t\tle, ok := err.(*os.LinkError)\n309\t\t\tif !ok {\n310\t\t\t\treturn err.Error()\n311\t\t\t}\n312\t\t\treturn errnoMsg(le.Err)\n313\t\t}\n314\t\treturn errnoMsg(pe.Err)\n315\t}\n316\t\n317\tfunc errnoMsg(err error) string {\n318\t\tse, ok := err.(syscall.Errno)\n319\t\tif !ok {\n320\t\t\treturn err.Error()\n321\t\t}\n322\t\tswitch se {\n323\t\tcase syscall.EEXIST:\n324\t\t\treturn \"File exists\"\n325\t\tcase syscall.ENOENT:\n326\t\t\treturn \"No such file or directory\"\n327\t\tcase syscall.EACCES:\n328\t\t\treturn \"Permission denied\"\n329\t\tcase syscall.ENOTDIR:\n330\t\t\treturn \"Not a directory\"\n331\t\tcase syscall.EPERM:\n332\t\t\treturn \"Operation not permitted\"\n333\t\tcase syscall.EXDEV:\n334\t\t\treturn \"Invalid cross-device link\"\n335\t\tdefault:\n336\t\t\treturn se.Error()\n337\t\t}\n338\t}\n339\t\n340\tfunc parseArgs(args []string) (options, []string, error) {\n341\t\tvar opts options\n342\t\tvar targets []string\n343\t\n344\t\ti := 0\n345\t\tfor i < len(args) {\n346\t\t\targ := args[i]\n347\t\t\tif arg == \"--\" {\n348\t\t\t\ttargets = append(targets, args[i+1:]...)\n349\t\t\t\tbreak\n350\t\t\t}\n351\t\t\tif strings.HasPrefix(arg, \"--\") {\n352\t\t\t\tn, err := parseLongFlag(arg, args[i+1:], &opts)\n353\t\t\t\tif err != nil {\n354\t\t\t\t\treturn opts, nil, err\n355\t\t\t\t}\n356\t\t\t\ti += n\n357\t\t\t\tcontinue\n358\t\t\t}\n359\t\t\tif len(arg) > 1 && arg[0] == '-' {\n360\t\t\t\tconsumed, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n361\t\t\t\tif err != nil {\n362\t\t\t\t\treturn opts, nil, err\n363\t\t\t\t}\n364\t\t\t\ti += 1 + consumed\n365\t\t\t\tcontinue\n366\t\t\t}\n367\t\t\ttargets = append(targets, arg)\n368\t\t\ti++\n369\t\t}\n370\t\n371\t\tif len(targets) == 0 {\n372\t\t\treturn opts, nil, fmt.Errorf(\"missing file operand\")\n373\t\t}\n374\t\n375\t\tif opts.suffix == \"\" {\n376\t\t\topts.suffix = \"~\"\n377\t\t}\n378\t\n379\t\treturn opts, targets, nil\n380\t}\n381\t\n382\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n383\t\tswitch {\n384\t\tcase flag == \"--help\":\n385\t\t\tfmt.Fprint(os.Stdout, helpText)\n386\t\t\tos.Exit(0)\n387\t\t\treturn 0, nil\n388\t\tcase flag == \"--version\":\n389\t\t\tfmt.Fprint(os.Stdout, versionText)\n390\t\t\tos.Exit(0)\n391\t\t\treturn 0, nil\n392\t\tcase flag == \"--symbolic\":\n393\t\t\topts.symbolic = true\n394\t\t\treturn 1, nil\n395\t\tcase flag == \"--relative\":\n396\t\t\topts.relative = true\n397\t\t\treturn 1, nil\n398\t\tcase flag == \"--force\":\n399\t\t\topts.force = true\n400\t\t\topts.interactive = false\n401\t\t\treturn 1, nil\n402\t\tcase flag == \"--interactive\":\n403\t\t\topts.interactive = true\n404\t\t\topts.force = false\n405\t\t\treturn 1, nil\n406\t\tcase flag == \"--no-dereference\":\n407\t\t\topts.noDereference = true\n408\t\t\treturn 1, nil\n409\t\tcase flag == \"--verbose\":\n410\t\t\topts.verbose = true\n411\t\t\treturn 1, nil\n412\t\tcase flag == \"--backup\":\n413\t\t\topts.backupMethod = \"existing\"\n414\t\t\treturn 1, nil\n415\t\tcase strings.HasPrefix(flag, \"--backup=\"):\n416\t\t\tmethod := flag[len(\"--backup=\"):]\n417\t\t\tnormalized, err := normalizeBackupMethod(method)\n418\t\t\tif err != nil {\n419\t\t\t\treturn 0, err\n420\t\t\t}\n421\t\t\topts.backupMethod = normalized\n422\t\t\treturn 1, nil\n423\t\tcase flag == \"--suffix\":\n424\t\t\tif len(remaining) == 0 {\n425\t\t\t\treturn 0, fmt.Errorf(\"option '--suffix' requires an argument\")\n426\t\t\t}\n427\t\t\topts.suffix = remaining[0]\n428\t\t\treturn 2, nil\n429\t\tcase strings.HasPrefix(flag, \"--suffix=\"):\n430\t\t\topts.suffix = flag[len(\"--suffix=\"):]\n431\t\t\treturn 1, nil\n432\t\tdefault:\n433\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n434\t\t}\n435\t}\n436\t\n437\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n438\t\tconsumed := 0\n439\t\tfor j := 0; j < len(flags); j++ {\n440\t\t\tswitch flags[j] {\n441\t\t\tcase 's':\n442\t\t\t\topts.symbolic = true\n443\t\t\tcase 'r':\n444\t\t\t\topts.relative = true\n445\t\t\tcase 'f':\n446\t\t\t\topts.force = true\n447\t\t\t\topts.interactive = false\n448\t\t\tcase 'i':\n449\t\t\t\topts.interactive = true\n450\t\t\t\topts.force = false\n451\t\t\tcase 'n':\n452\t\t\t\topts.noDereference = true\n453\t\t\tcase 'v':\n454\t\t\t\topts.verbose = true\n455\t\t\tcase 'b':\n456\t\t\t\topts.backupMethod = \"existing\"\n457\t\t\tcase 'S':\n458\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n459\t\t\t\t\topts.suffix = rest\n460\t\t\t\t} else if len(remaining) > consumed {\n461\t\t\t\t\topts.suffix = remaining[consumed]\n462\t\t\t\t\tconsumed++\n463\t\t\t\t} else {\n464\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'S'\")\n465\t\t\t\t}\n466\t\t\t\treturn consumed, nil\n467\t\t\tdefault:\n468\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n469\t\t\t}\n470\t\t}\n471\t\treturn consumed, nil\n472\t}\n473\t\n474\tfunc normalizeBackupMethod(method string) (string, error) {\n475\t\tswitch method {\n476\t\tcase \"none\", \"off\":\n477\t\t\treturn \"\", nil\n478\t\tcase \"numbered\", \"t\":\n479\t\t\treturn \"numbered\", nil\n480\t\tcase \"existing\", \"nil\":\n481\t\t\treturn \"existing\", nil\n482\t\tcase \"simple\", \"never\":\n483\t\t\treturn \"simple\", nil\n484\t\tdefault:\n485\t\t\treturn \"\", fmt.Errorf(\"invalid backup type '%s'\", method)\n486\t\t}\n487\t}\n488\t"}]},"parent_tool_use_id":null,"session_id":"6d0c25e4-6f69-4e0e-8989-487121e9d072","uuid":"900f475a-07c0-4c14-88a9-a49d34a383c6","timestamp":"2026-05-20T12:00:00.852Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5344/cmd/ln/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd037-ln R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3, R2.4,\n// R3.1, R3.2, R3.3, R3.4, R3.5, R3.6.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: ln [OPTION]... TARGET LINK_NAME\n  or:  ln [OPTION]... TARGET\n  or:  ln [OPTION]... TARGET... DIRECTORY\nIn the 1st form, create a link to TARGET with the name LINK_NAME.\nIn the 2nd form, create a link to TARGET in the current directory.\nIn the 3rd form, create links to each TARGET in DIRECTORY.\n\n  -b                         like --backup but does not accept an argument\n  -f, --force                remove existing destination files\n  -i, --interactive          prompt whether to remove destinations\n  -n, --no-dereference       treat LINK_NAME as a normal file if\n                              it is a symbolic link to a directory\n  -r, --relative             create symbolic links relative to link location\n  -s, --symbolic             make symbolic links instead of hard links\n  -S, --suffix=SUFFIX        override the usual backup suffix\n  -v, --verbose              print name of each linked file\n      --backup[=CONTROL]     make a backup of each existing destination file\n      --help                 display this help and exit\n      --version              output version information and exit\n`\n\nconst versionText = `ln (go-unix-utils) dev\n`\n\ntype options struct {\n\tsymbolic      bool\n\trelative      bool\n\tforce         bool\n\tinteractive   bool\n\tnoDereference bool\n\tverbose       bool\n\tbackupMethod  string\n\tsuffix        string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, targets, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'ln --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\n\tos.Exit(run(opts, targets))\n}\n\nfunc run(opts options, targets []string) int {\n\texitCode := 0\n\tlast := targets[len(targets)-1]\n\n\tswitch {\n\tcase len(targets) == 1:\n\t\tlinkName := \"./\" + filepath.Base(targets[0])\n\t\texitCode = doLink(targets[0], linkName, opts, exitCode)\n\tcase isDirDest(last, opts.noDereference):\n\t\tfor _, target := range targets[:len(targets)-1] {\n\t\t\tlinkName := filepath.Join(last, filepath.Base(target))\n\t\t\texitCode = doLink(target, linkName, opts, exitCode)\n\t\t}\n\tcase len(targets) == 2:\n\t\texitCode = doLink(targets[0], targets[1], opts, exitCode)\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"ln: target '%s': %s\\n\",\n\t\t\tlast, targetDirError(last))\n\t\texitCode = 1\n\t}\n\n\treturn exitCode\n}\n\nfunc doLink(target, linkName string, opts options, code int) int {\n\tok, err := createLink(target, linkName, opts)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"ln: %s\\n\", err)\n\t\treturn 1\n\t}\n\tif !ok {\n\t\treturn 1\n\t}\n\treturn code\n}\n\nfunc createLink(target, linkName string, opts options) (bool, error) {\n\tproceed, backupPath, err := handleExisting(linkName, opts)\n\tif err != nil {\n\t\treturn false, err\n\t}\n\tif !proceed {\n\t\treturn false, nil\n\t}\n\n\tif opts.symbolic {\n\t\treturn true, createSymLink(target, linkName, opts, backupPath)\n\t}\n\treturn true, createHardLink(target, linkName, opts, backupPath)\n}\n\nfunc createSymLink(target, linkName string, opts options, backupPath string) error {\n\tt := target\n\tif opts.relative {\n\t\trel, err := computeRelative(target, linkName)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tt = rel\n\t}\n\tif err := os.Symlink(t, linkName); err != nil {\n\t\treturn fmt.Errorf(\"failed to create symbolic link '%s': %s\",\n\t\t\tlinkName, sysErrMsg(err))\n\t}\n\tif opts.verbose {\n\t\tprintVerbose(backupPath, linkName, \"->\", t)\n\t}\n\treturn nil\n}\n\nfunc createHardLink(target, linkName string, opts options, backupPath string) error {\n\tfi, err := os.Stat(target)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"failed to access '%s': %s\", target, sysErrMsg(err))\n\t}\n\tif fi.IsDir() {\n\t\treturn fmt.Errorf(\"%s: hard link not allowed for directory\", target)\n\t}\n\tif err := os.Link(target, linkName); err != nil {\n\t\treturn fmt.Errorf(\"failed to create hard link '%s': %s\",\n\t\t\tlinkName, sysErrMsg(err))\n\t}\n\tif opts.verbose {\n\t\tprintVerbose(backupPath, linkName, \"=>\", target)\n\t}\n\treturn nil\n}\n\nfunc printVerbose(backupPath, linkName, arrow, target string) {\n\tif backupPath != \"\" {\n\t\tfmt.Fprintf(os.Stdout, \"'%s' ~ '%s' %s '%s'\\n\", backupPath, linkName, arrow, target)\n\t} else {\n\t\tfmt.Fprintf(os.Stdout, \"'%s' %s '%s'\\n\", linkName, arrow, target)\n\t}\n}\n\nfunc handleExisting(linkName string, opts options) (bool, string, error) {\n\t_, err := os.Lstat(linkName)\n\tif err != nil {\n\t\treturn true, \"\", nil\n\t}\n\n\tif opts.interactive {\n\t\tif !confirmReplace(linkName) {\n\t\t\treturn false, \"\", nil\n\t\t}\n\t} else if !opts.force && opts.backupMethod == \"\" {\n\t\treturn true, \"\", nil\n\t}\n\n\tvar backupPath string\n\tif opts.backupMethod != \"\" {\n\t\tbackupPath, err = makeBackup(linkName, opts)\n\t\tif err != nil {\n\t\t\treturn false, \"\", err\n\t\t}\n\t} else {\n\t\tif err := os.Remove(linkName); err != nil {\n\t\t\treturn false, \"\", fmt.Errorf(\"cannot remove '%s': %s\",\n\t\t\t\tlinkName, sysErrMsg(err))\n\t\t}\n\t}\n\n\treturn true, backupPath, nil\n}\n\nfunc makeBackup(path string, opts options) (string, error) {\n\tvar backupPath string\n\tswitch opts.backupMethod {\n\tcase \"numbered\":\n\t\tbackupPath = nextNumberedBackup(path)\n\tcase \"existing\":\n\t\tif hasNumberedBackups(path) {\n\t\t\tbackupPath = nextNumberedBackup(path)\n\t\t} else {\n\t\t\tbackupPath = path + opts.suffix\n\t\t}\n\tdefault:\n\t\tbackupPath = path + opts.suffix\n\t}\n\n\tif err := os.Rename(path, backupPath); err != nil {\n\t\treturn \"\", fmt.Errorf(\"cannot backup '%s' to '%s': %s\",\n\t\t\tpath, backupPath, sysErrMsg(err))\n\t}\n\treturn backupPath, nil\n}\n\nfunc nextNumberedBackup(path string) string {\n\tfor i := 1; ; i++ {\n\t\tbp := fmt.Sprintf(\"%s.~%d~\", path, i)\n\t\tif _, err := os.Lstat(bp); err != nil {\n\t\t\treturn bp\n\t\t}\n\t}\n}\n\nfunc hasNumberedBackups(path string) bool {\n\tdir := filepath.Dir(path)\n\tbase := filepath.Base(path)\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treturn false\n\t}\n\tprefix := base + \".~\"\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif strings.HasPrefix(name, prefix) && strings.HasSuffix(name, \"~\") {\n\t\t\tmiddle := name[len(prefix) : len(name)-1]\n\t\t\tif len(middle) > 0 && isAllDigits(middle) {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t}\n\treturn false\n}\n\nfunc isAllDigits(s string) bool {\n\tfor _, c := range s {\n\t\tif c < '0' || c > '9' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc confirmReplace(dest string) bool {\n\tif !sys.IsTerminal(os.Stdin.Fd()) {\n\t\treturn false\n\t}\n\tfmt.Fprintf(os.Stderr, \"ln: replace '%s'? \", dest)\n\tscanner := bufio.NewScanner(os.Stdin)\n\tif !scanner.Scan() {\n\t\treturn false\n\t}\n\tline := scanner.Text()\n\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n}\n\nfunc computeRelative(target, linkName string) (string, error) {\n\tabsTarget, err := filepath.Abs(target)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to access '%s': %s\", target, sysErrMsg(err))\n\t}\n\tlinkDir := filepath.Dir(linkName)\n\tabsLinkDir, err := filepath.Abs(linkDir)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to access '%s': %s\", linkDir, sysErrMsg(err))\n\t}\n\trel, err := filepath.Rel(absLinkDir, absTarget)\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"failed to compute relative path: %s\", err)\n\t}\n\treturn rel, nil\n}\n\nfunc isDirDest(path string, noDereference bool) bool {\n\tvar fi os.FileInfo\n\tvar err error\n\tif noDereference {\n\t\tfi, err = os.Lstat(path)\n\t} else {\n\t\tfi, err = os.Stat(path)\n\t}\n\tif err != nil {\n\t\treturn false\n\t}\n\treturn fi.IsDir()\n}\n\nfunc targetDirError(path string) string {\n\t_, err := os.Stat(path)\n\tif err != nil {\n\t\treturn \"No such file or directory\"\n\t}\n\treturn \"Not a directory\"\n}\n\nfunc sysErrMsg(err error) string {\n\tpe, ok := err.(*os.PathError)\n\tif !ok {\n\t\tle, ok := err.(*os.LinkError)\n\t\tif !ok {\n\t\t\treturn err.Error()\n\t\t}\n\t\treturn errnoMsg(le.Err)\n\t}\n\treturn errnoMsg(pe.Err)\n}\n\nfunc errnoMsg(err error) string {\n\tse, ok := err.(syscall.Errno)\n\tif !ok {\n\t\treturn err.Error()\n\t}\n\tswitch se {\n\tcase syscall.EEXIST:\n\t\treturn \"File exists\"\n\tcase syscall.ENOENT:\n\t\treturn \"No such file or directory\"\n\tcase syscall.EACCES:\n\t\treturn \"Permission denied\"\n\tcase syscall.ENOTDIR:\n\t\treturn \"Not a directory\"\n\tcase syscall.EPERM:\n\t\treturn \"Operation not permitted\"\n\tcase syscall.EXDEV:\n\t\treturn \"Invalid cross-device link\"\n\tdefault:\n\t\treturn se.Error()\n\t}\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar targets []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ttargets = append(targets, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tconsumed, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + consumed\n\t\t\tcontinue\n\t\t}\n\t\ttargets = append(targets, arg)\n\t\ti++\n\t}\n\n\tif len(targets) == 0 {\n\t\treturn opts, nil, fmt.Errorf(\"missing file operand\")\n\t}\n\n\tif opts.suffix == \"\" {\n\t\topts.suffix = \"~\"\n\t}\n\n\treturn opts, targets, nil\n}\n\nfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--symbolic\":\n\t\topts.symbolic = true\n\t\treturn 1, nil\n\tcase flag == \"--relative\":\n\t\topts.relative = true\n\t\treturn 1, nil\n\tcase flag == \"--force\":\n\t\topts.force = true\n\t\topts.interactive = false\n\t\treturn 1, nil\n\tcase flag == \"--interactive\":\n\t\topts.interactive = true\n\t\topts.force = false\n\t\treturn 1, nil\n\tcase flag == \"--no-dereference\":\n\t\topts.noDereference = true\n\t\treturn 1, nil\n\tcase flag == \"--verbose\":\n\t\topts.verbose = true\n\t\treturn 1, nil\n\tcase flag == \"--backup\":\n\t\topts.backupMethod = \"existing\"\n\t\treturn 1, nil\n\tcase strings.HasPrefix(flag, \"--backup=\"):\n\t\tmethod := flag[len(\"--backup=\"):]\n\t\tnormalized, err := normalizeBackupMethod(method)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.backupMethod = normalized\n\t\treturn 1, nil\n\tcase flag == \"--suffix\":\n\t\tif len(remaining) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '--suffix' requires an argument\")\n\t\t}\n\t\topts.suffix = remaining[0]\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--suffix=\"):\n\t\topts.suffix = flag[len(\"--suffix=\"):]\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 's':\n\t\t\topts.symbolic = true\n\t\tcase 'r':\n\t\t\topts.relative = true\n\t\tcase 'f':\n\t\t\topts.force = true\n\t\t\topts.interactive = false\n\t\tcase 'i':\n\t\t\topts.interactive = true\n\t\t\topts.force = false\n\t\tcase 'n':\n\t\t\topts.noDereference = true\n\t\tcase 'v':\n\t\t\topts.verbose = true\n\t\tcase 'b':\n\t\t\topts.backupMethod = \"existing\"\n\t\tcase 'S':\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\topts.suffix = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\topts.suffix = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'S'\")\n\t\t\t}\n\t\t\treturn consumed, nil\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn consumed, nil\n}\n\nfunc normalizeBackupMethod(method string) (string, error) {\n\tswitch method {\n\tcase \"none\", \"off\":\n\t\treturn \"\", nil\n\tcase \"numbered\", \"t\":\n\t\treturn \"numbered\", nil\n\tcase \"existing\", \"nil\":\n\t\treturn \"existing\", nil\n\tcase \"simple\", \"never\":\n\t\treturn \"simple\", nil\n\tdefault:\n\t\treturn \"\", fmt.Errorf(\"invalid backup type '%s'\", method)\n\t}\n}\n","numLines":488,"startLine":1,"totalLines":488}}}
