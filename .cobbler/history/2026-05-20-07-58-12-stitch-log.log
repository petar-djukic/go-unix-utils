ing, bool, error) {\n\tvar opts options\n\tvar templates []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ttemplates = append(templates, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tconsumed, err := parseLongFlag(arg, &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, \"\", false, err\n\t\t\t}\n\t\t\ti += consumed\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tconsumed, err := parseShortFlags(arg[1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, \"\", false, err\n\t\t\t}\n\t\t\ti += 1 + consumed\n\t\t\tcontinue\n\t\t}\n\t\ttemplates = append(templates, arg)\n\t\ti++\n\t}\n\n\tswitch len(templates) {\n\tcase 0:\n\t\treturn opts, defaultTemplate, true, nil\n\tcase 1:\n\t\treturn opts, templates[0], false, nil\n\tdefault:\n\t\treturn opts, \"\", false, fmt.Errorf(\"too many templates\")\n\t}\n}\n\nfunc parseLongFlag(flag string, opts *options) (int, error) {\n\tswitch flag {\n\tcase \"--directory\":\n\t\topts.directory = true\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, opts *options) (int, error) {\n\tfor j := range len(flags) {\n\t\tswitch flags[j] {\n\t\tcase 'd':\n\t\t\topts.directory = true\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn 0, nil\n}\n\nfunc run(opts options, template string, useDefaultDir bool) error {\n\tfullTemplate := template\n\tif useDefaultDir {\n\t\tdir := os.Getenv(\"TMPDIR\")\n\t\tif dir == \"\" {\n\t\t\tdir = \"/tmp\"\n\t\t}\n\t\tfullTemplate = dir + \"/\" + template\n\t}\n\n\txCount := countTrailingX(fullTemplate)\n\tif xCount < 3 {\n\t\treturn fmt.Errorf(\"too few X's in template '%s'\", fullTemplate)\n\t}\n\n\tprefix := fullTemplate[:len(fullTemplate)-xCount]\n\n\tfor range 100 {\n\t\tsuffix, err := randomString(xCount)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tpath := prefix + suffix\n\t\tif opts.directory {\n\t\t\terr = os.Mkdir(path, 0o700)\n\t\t} else {\n\t\t\tvar fd *os.File\n\t\t\tfd, err = os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)\n\t\t\tif err == nil {\n\t\t\t\tfd.Close()\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\tif os.IsExist(err) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\treturn fmt.Errorf(\"failed to create %s via template '%s': %s\",\n\t\t\t\tentityKind(opts.directory), fullTemplate, unwrapErr(err))\n\t\t}\n\t\tfmt.Println(path)\n\t\treturn nil\n\t}\n\n\treturn fmt.Errorf(\"failed to create %s via template '%s': too many collisions\",\n\t\tentityKind(opts.directory), fullTemplate)\n}\n\nfunc entityKind(isDir bool) string {\n\tif isDir {\n\t\treturn \"directory\"\n\t}\n\treturn \"file\"\n}\n\nfunc countTrailingX(s string) int {\n\tcount := 0\n\tfor i := len(s) - 1; i >= 0; i-- {\n\t\tif s[i] != 'X' {\n\t\t\tbreak\n\t\t}\n\t\tcount++\n\t}\n\treturn count\n}\n\nfunc randomString(n int) (string, error) {\n\tb := make([]byte, n)\n\tmax := big.NewInt(int64(len(charset)))\n\tfor i := range b {\n\t\tidx, err := rand.Int(rand.Reader, max)\n\t\tif err != nil {\n\t\t\treturn \"\", err\n\t\t}\n\t\tb[i] = charset[idx.Int64()]\n\t}\n\treturn string(b), nil\n}\n\nfunc unwrapErr(err error) string {\n\tpe, ok := err.(*os.PathError)\n\tif !ok {\n\t\treturn err.Error()\n\t}\n\treturn pe.Err.Error()\n}\n","userModified":false}}
