t\t\tif !info.IsDir() {\n\t\t\t\tt.Errorf(\"entry %q: expected directory\", name)\n\t\t\t}\n\t\t} else {\n\t\t\tif !info.Mode().IsRegular() {\n\t\t\t\tt.Errorf(\"entry %q: expected regular file\", name)\n\t\t\t}\n\t\t}\n\t\tif perm := info.Mode().Perm(); perm != mode {\n\t\t\tt.Errorf(\"entry %q: expected mode %04o, got %04o\", name, mode, perm)\n\t\t}\n\t}\n\tif found == 0 {\n\t\tt.Fatal(\"no matching entries created in temp dir\")\n\t}\n}\n\nfunc isAlphanumeric(c rune) bool {\n\treturn (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2060,"cache_read_input_tokens":111842,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2060},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6d0c25e4-6f69-4e0e-8989-487121e9d072","uuid":"54db9946-dfdb-45eb-9a56-0adada693a06"}
