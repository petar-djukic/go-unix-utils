{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RkmRXNrUtdLxHe4ogT4Qwo","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd056-cp R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3, R2.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"path/filepath\"\n12\t\t\"regexp\"\n13\t\t\"testing\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n16\t)\n17\t\n18\tfunc TestDiff(t *testing.T) {\n19\t\tgoBin := testutils.BuildBinary(t, \".\")\n20\t\trefBin, err := exec.LookPath(\"gcp\")\n21\t\tif err != nil {\n22\t\t\tt.Skip(\"reference binary gcp not found\")\n23\t\t}\n24\t\n25\t\tenv := []string{\"LC_ALL=C\"}\n26\t\n27\t\tbinaryNameRe := regexp.MustCompile(`(?m)^(?:/\\S+/)?g?cp:`)\n28\t\tnormBin := testutils.NormalizeFunc(func(b []byte) []byte {\n29\t\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"cp:\"))\n30\t\t})\n31\t\tnormCase := testutils.NormalizeFunc(func(b []byte) []byte {\n32\t\t\treturn bytes.ToLower(b)\n33\t\t})\n34\t\tnormTry := testutils.NormalizeFunc(func(b []byte) []byte {\n35\t\t\tvar out [][]byte\n36\t\t\tfor line := range bytes.SplitSeq(b, []byte(\"\\n\")) {\n37\t\t\t\tif !bytes.HasPrefix(bytes.TrimSpace(bytes.ToLower(line)), []byte(\"try \")) {\n38\t\t\t\t\tout = append(out, bytes.Clone(line))\n39\t\t\t\t}\n40\t\t\t}\n41\t\t\treturn bytes.Join(out, []byte(\"\\n\"))\n42\t\t})\n43\t\terrNorm := []testutils.NormalizeFunc{normBin, normCase, normTry}\n44\t\tpromptNorm := []testutils.NormalizeFunc{normBin}\n45\t\n46\t\tt.Run(\"r1_1_single_file\", func(t *testing.T) {\n47\t\t\tdir := t.TempDir()\n48\t\t\twriteFile(t, dir, \"src.txt\", \"hello world\\n\")\n49\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n50\t\t\t\t{\n51\t\t\t\t\tName:    \"copy\",\n52\t\t\t\t\tArgs:    []string{\"src.txt\", \"dest.txt\"},\n53\t\t\t\t\tWorkDir: dir,\n54\t\t\t\t\tEnv:     env,\n55\t\t\t\t\tExpectedFiles: map[string][]byte{\n56\t\t\t\t\t\t\"dest.txt\": []byte(\"hello world\\n\"),\n57\t\t\t\t\t},\n58\t\t\t\t},\n59\t\t\t})\n60\t\t})\n61\t\n62\t\tt.Run(\"r1_1_into_directory\", func(t *testing.T) {\n63\t\t\tdir := t.TempDir()\n64\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n65\t\t\tos.Mkdir(filepath.Join(dir, \"destdir\"), 0o755)\n66\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n67\t\t\t\t{\n68\t\t\t\t\tName:    \"into_dir\",\n69\t\t\t\t\tArgs:    []string{\"src.txt\", \"destdir\"},\n70\t\t\t\t\tWorkDir: dir,\n71\t\t\t\t\tEnv:     env,\n72\t\t\t\t\tExpectedFiles: map[string][]byte{\n73\t\t\t\t\t\t\"destdir/src.txt\": []byte(\"hello\\n\"),\n74\t\t\t\t\t},\n75\t\t\t\t},\n76\t\t\t})\n77\t\t})\n78\t\n79\t\tt.Run(\"r1_1_multi_file\", func(t *testing.T) {\n80\t\t\tdir := t.TempDir()\n81\t\t\twriteFile(t, dir, \"a.txt\", \"aaa\\n\")\n82\t\t\twriteFile(t, dir, \"b.txt\", \"bbb\\n\")\n83\t\t\tos.Mkdir(filepath.Join(dir, \"destdir\"), 0o755)\n84\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n85\t\t\t\t{\n86\t\t\t\t\tName:    \"multi\",\n87\t\t\t\t\tArgs:    []string{\"a.txt\", \"b.txt\", \"destdir\"},\n88\t\t\t\t\tWorkDir: dir,\n89\t\t\t\t\tEnv:     env,\n90\t\t\t\t\tExpectedFiles: map[string][]byte{\n91\t\t\t\t\t\t\"destdir/a.txt\": []byte(\"aaa\\n\"),\n92\t\t\t\t\t\t\"destdir/b.txt\": []byte(\"bbb\\n\"),\n93\t\t\t\t\t},\n94\t\t\t\t},\n95\t\t\t})\n96\t\t})\n97\t\n98\t\tt.Run(\"r1_1_overwrite_existing\", func(t *testing.T) {\n99\t\t\tdir := t.TempDir()\n100\t\t\twriteFile(t, dir, \"src.txt\", \"new\\n\")\n101\t\t\twriteFile(t, dir, \"dest.txt\", \"old\\n\")\n102\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n103\t\t\t\t{\n104\t\t\t\t\tName:    \"overwrite\",\n105\t\t\t\t\tArgs:    []string{\"src.txt\", \"dest.txt\"},\n106\t\t\t\t\tWorkDir: dir,\n107\t\t\t\t\tEnv:     env,\n108\t\t\t\t\tExpectedFiles: map[string][]byte{\n109\t\t\t\t\t\t\"dest.txt\": []byte(\"new\\n\"),\n110\t\t\t\t\t},\n