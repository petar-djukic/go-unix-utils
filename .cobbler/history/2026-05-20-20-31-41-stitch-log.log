{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UYv1VY2qQF5PL53NZguuXC","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/cp implements srd056-cp: copy files and directories.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"path/filepath\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\ttype overwriteMode int\n20\t\n21\tconst (\n22\t\towDefault   overwriteMode = iota\n23\t\towAskUser                 // -i\n24\t\towNoClobber               // -n\n25\t)\n26\t\n27\ttype derefMode int\n28\t\n29\tconst (\n30\t\tderefDefault derefMode = iota\n31\t\tderefAlways\n32\t\tderefNever\n33\t)\n34\t\n35\tvar (\n36\t\towMode      overwriteMode\n37\t\tunlinkDest  bool\n38\t\trecursive   bool\n39\t\tderef       derefMode\n40\t\tstdinReader = bufio.NewReader(os.Stdin)\n41\t\terrDeclined = errors.New(\"declined\")\n42\t\terrPartial  = errors.New(\"partial failure\")\n43\t)\n44\t\n45\tfunc main() {\n46\t\tsys.InstallSIGPIPEHandler()\n47\t\targs := parseFlags(os.Args[1:])\n48\t\tif len(args) == 0 {\n49\t\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n50\t\t\tos.Exit(1)\n51\t\t}\n52\t\tif len(args) == 1 {\n53\t\t\tfmt.Fprintf(os.Stderr,\n54\t\t\t\t\"cp: missing destination file operand after '%s'\\n\", args[0])\n55\t\t\tos.Exit(1)\n56\t\t}\n57\t\tdest := args[len(args)-1]\n58\t\tsources := args[:len(args)-1]\n59\t\tcode := 0\n60\t\tif len(sources) > 1 {\n61\t\t\tcode = copyMultiple(sources, dest)\n62\t\t} else {\n63\t\t\tcode = copySingle(sources[0], dest)\n64\t\t}\n65\t\tif code != 0 {\n66\t\t\tos.Exit(code)\n67\t\t}\n68\t}\n69\t\n70\tfunc parseFlags(args []string) []string {\n71\t\tvar files []string\n72\t\tendOfFlags := false\n73\t\tfor _, arg := range args {\n74\t\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n75\t\t\t\tfiles = append(files, arg)\n76\t\t\t\tcontinue\n77\t\t\t}\n78\t\t\tif arg == \"--\" {\n79\t\t\t\tendOfFlags = true\n80\t\t\t\tcontinue\n81\t\t\t}\n82\t\t\tif strings.HasPrefix(arg, \"--\") {\n83\t\t\t\tapplyLongFlag(arg[2:])\n84\t\t\t\tcontinue\n85\t\t\t}\n86\t\t\tfor _, c := range arg[1:] {\n87\t\t\t\tapplyFlag(c)\n88\t\t\t}\n89\t\t}\n90\t\treturn files\n91\t}\n92\t\n93\tfunc applyFlag(c rune) {\n94\t\tswitch c {\n95\t\tcase 'f':\n96\t\t\towMode = owDefault\n97\t\t\tunlinkDest = true\n98\t\tcase 'i':\n99\t\t\towMode = owAskUser\n100\t\t\tunlinkDest = false\n101\t\tcase 'n':\n102\t\t\towMode = owNoClobber\n103\t\tcase 'r', 'R':\n104\t\t\trecursive = true\n105\t\tcase 'L':\n106\t\t\tderef = derefAlways\n107\t\tcase 'P':\n108\t\t\tderef = derefNever\n109\t\t}\n110\t}\n111\t\n112\tfunc applyLongFlag(name string) {\n113\t\tswitch name {\n114\t\tcase \"force\":\n115\t\t\towMode = owDefault\n116\t\t\tunlinkDest = true\n117\t\tcase \"interactive\":\n118\t\t\towMode = owAskUser\n119\t\t\tunlinkDest = false\n120\t\tcase \"no-clobber\":\n121\t\t\towMode = owNoClobber\n122\t\tcase \"recursive\":\n123\t\t\trecursive = true\n124\t\tcase \"dereference\":\n125\t\t\tderef = derefAlways\n126\t\tcase \"no-dereference\":\n127\t\t\tderef = derefNever\n128\t\t}\n129\t}\n130\t\n131\tfunc shouldDeref() bool {\n132\t\tswitch deref {\n133\t\tcase derefAlways:\n134\t\t\treturn true\n135\t\tcase derefNever:\n136\t\t\treturn false\n137\t\tdefault:\n138\t\t\treturn !recursive\n139\t\t}\n140\t}\n141\t\n142\tfunc statSource(path string) (os.FileInfo, error) {\n143\t\tif shouldDeref() {\n144\t\t\treturn os.Stat(path)\n145\t\t}\n146\t\treturn os.Lstat(path)\n147\t}\n148\t\n149\tfunc copySingle(src, dest string) int {\n150\t\tinfo, err := os.Stat(dest)\n151\t\tif err == nil && info.IsDir() {\n152\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n153\t\t}\n154\t\tif err := copyFile(src, dest); err != nil {\n155\t\t\tif err != errDeclined && err != errPartial {\n156\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n157\t\t\t}\n158\t\t\treturn 1\n159\t\t}\n160\t\treturn 0\n161\t}\n162\t\n163\tfunc copyMultiple(sources []string, dest string) int {\n164\t\tinfo, err := os.Stat(dest)\n165\t\tif err != nil || !info.IsDir() {\n166\t\t\tfmt.Fprintf(os.Stderr, \"cp: target '%s': not a directory\\n\", dest)\n167\t\t\treturn 1\n168\t\t}\n169\t\tcode := 0\n170\t\tfor _, src := range sources {\n171\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n172\t\t\tif err := copyFile(src, target); err != nil {\n173\t\t\t\tif err != errDeclined && err != errPartial {\n174\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n175\t\t\t\t}\n176\t\t\t\tcode = 1\n177\t\t\t}\n178\t\t}\n179\t\treturn code\n180\t}\n181\t\n182\tfunc copyFile(src, dest string) error {\n183\t\tsrcInfo, err := statSource(src)\n184\t\tif err != nil {\n185\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n186\t\t}\n187\t\tif srcInfo.IsDir() {\n188\t\t\tif !recursive {\n189\t\t\t\treturn fmt.Errorf(\"-r not specified; omitting directory '%s'\", src)\n190\t\t\t}\n191\t\t\treturn copyDir(src, dest)\n192\t\t}\n193\t\tisLink := srcInfo.Mode()&os.ModeSymlink != 0\n194\t\tif destInfo, err := os.Stat(dest); err == nil {\n195\t\t\tif !isLink && os.SameFile(srcInfo, destInfo) {\n196\t\t\t\treturn fmt.Errorf(\"'%s' and '%s' are the same file\", src, dest)\n197\t\t\t}\n198\t\t\tswitch owMode {\n199\t\t\tcase owNoClobber:\n200\t\t\t\treturn nil\n201\t\t\tcase owAskUser:\n202\t\t\t\tif !confirmOverwrite(dest) {\n203\t\t\t\t\treturn errDeclined\n204\t\t\t\t}\n205\t\t\t}\n206\t\t}\n207\t\tif isLink {\n208\t\t\treturn copyLink(src, dest)\n209\t\t}\n210\t\treturn doCopy(src, dest, srcInfo.Mode())\n211\t}\n212\t\n213\tfunc copyDir(src, dest string) error {\n214\t\tsrcInfo, err := os.Stat(src)\n215\t\tif err != nil {\n216\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n217\t\t}\n218\t\tif err := os.Mkdir(dest, srcInfo.Mode().Perm()); err != nil && !os.IsExist(err) {\n219\t\t\treturn fmtPathErr(\"cannot create directory\", dest, err)\n220\t\t}\n221\t\tentries, err := os.ReadDir(src)\n222\t\tif err != nil {\n223\t\t\treturn fmtPathErr(\"cannot read directory\", src, err)\n224\t\t}\n225\t\tfailed := false\n226\t\tfor _, e := range entries {\n227\t\t\ts := filepath.Join(src, e.Name())\n228\t\t\td := filepath.Join(dest, e.Name())\n229\t\t\tif err := copyFile(s, d); err != nil {\n230\t\t\t\tif err != errDeclined && err != errPartial {\n231\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n232\t\t\t\t}\n233\t\t\t\tfailed = true\n234\t\t\t}\n235\t\t}\n236\t\tif failed {\n237\t\t\treturn errPartial\n238\t\t}\n239\t\treturn nil\n240\t}\n241\t\n242\tfunc copyLink(src, dest string) error {\n243\t\ttarget, err := os.Readlink(src)\n244\t\tif err != nil {\n245\t\t\treturn fmtPathErr(\"cannot readlink\", src, err)\n246\t\t}\n247\t\tos.Remove(dest)\n248\t\tif err := os.Symlink(target, dest); err != nil {\n249\t\t\treturn fmtPathErr(\"cannot create symlink\", dest, err)\n250\t\t}\n251\t\treturn nil\n252\t}\n253\t\n254\tfunc doCopy(src, dest string, mode os.FileMode) error {\n255\t\tin, err := os.Open(src)\n256\t\tif err != nil {\n257\t\t\treturn fmtPathErr(\"cannot open\", src, err)\n258\t\t}\n259\t\tdefer in.Close()\n260\t\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n261\t\tif err != nil && unlinkDest {\n262\t\t\tos.Remove(dest)\n263\t\t\tout, err = os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n264\t\t}\n265\t\tif err != nil {\n266\t\t\treturn fmtPathErr(\"cannot create regular file\", dest, err)\n267\t\t}\n268\t\tdefer out.Close()\n269\t\tif _, err := io.Copy(out, in); err != nil {\n270\t\t\treturn err\n271\t\t}\n272\t\treturn out.Close()\n273\t}\n274\t\n275\tfunc confirmOverwrite(dest string) bool {\n276\t\tfmt.Fprintf(os.Stderr, \"cp: overwrite '%s'? \", dest)\n277\t\tline, _ := stdinReader.ReadString('\\n')\n278\t\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n279\t}\n280\t\n281\tfunc fmtPathErr(verb, path string, err error) error {\n282\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n283\t\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n284\t\t}\n285\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n286\t}\n287\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01QNVU5JfPw1Jo5jmDRmtt9h","session_id":"1273c734-52b1-41f4-bc95-2c61f3011a70","uuid":"32a1b542-e323-4157-a59e-f2624a24f031","timestamp":"2026-05-21T00:31:53.676Z"}
