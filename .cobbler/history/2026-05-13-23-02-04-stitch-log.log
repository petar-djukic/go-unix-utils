{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y95i5xX4ZFkXkyAtQf9R9w","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/sponge implements srd007-sponge: soak all of stdin before writing\n5\t// to a named output file, preventing read-write conflicts in pipelines.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"flag\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"os/signal\"\n14\t\t\"path/filepath\"\n15\t\t\"runtime\"\n16\t\t\"sync\"\n17\t\t\"syscall\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n20\t)\n21\t\n22\tvar appendMode = flag.Bool(\"a\", false, \"append to output file\")\n23\t\n24\tvar (\n25\t\ttempFileMu   sync.Mutex\n26\t\ttempFilePath string\n27\t)\n28\t\n29\tfunc main() {\n30\t\tsys.InstallSIGPIPEHandler()\n31\t\tflag.Parse()\n32\t\tos.Exit(run())\n33\t}\n34\t\n35\tfunc run() int {\n36\t\tinstallCleanupHandler()\n37\t\tdefer cleanupCurrentTempFile()\n38\t\n39\t\tdata, tmpFile, err := readAllStdin()\n40\t\tif err != nil {\n41\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n42\t\t\treturn 1\n43\t\t}\n44\t\tif tmpFile != \"\" {\n45\t\t\tsetTempFile(tmpFile)\n46\t\t}\n47\t\n48\t\targs := flag.Args()\n49\t\tif len(args) == 0 {\n50\t\t\treturn runPassthrough(data, tmpFile)\n51\t\t}\n52\t\treturn runOutput(args[0], data, tmpFile)\n53\t}\n54\t\n55\tfunc runPassthrough(data []byte, tmpFile string) int {\n56\t\tif err := writeToStdout(data, tmpFile); err != nil {\n57\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n58\t\t\treturn 1\n59\t\t}\n60\t\treturn 0\n61\t}\n62\t\n63\tfunc runOutput(filename string, data []byte, tmpFile string) int {\n64\t\tmode, exists, isRegular, err := outputFileInfo(filename)\n65\t\tif err != nil {\n66\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n67\t\t\treturn 1\n68\t\t}\n69\t\n70\t\t// R3.1, R3.2: append only when file exists and is a regular file\n71\t\tif *appendMode && exists && isRegular {\n72\t\t\tdata, tmpFile, err = prependOriginal(filename, data, tmpFile)\n73\t\t\tif err != nil {\n74\t\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n75\t\t\t\treturn 1\n76\t\t\t}\n77\t\t\tif tmpFile != \"\" {\n78\t\t\t\tsetTempFile(tmpFile)\n79\t\t\t}\n80\t\t}\n81\t\n82\t\tif err := writeOutputFile(filename, data, tmpFile, mode, exists, isRegular); err != nil {\n83\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n84\t\t\treturn 1\n85\t\t}\n86\t\tclearTempFile()\n87\t\treturn 0\n88\t}\n89\t\n90\tfunc readAllStdin() ([]byte, string, error) {\n91\t\tdata, err := io.ReadAll(os.Stdin)\n92\t\tif err != nil {\n93\t\t\treturn nil, \"\", fmt.Errorf(\"read stdin: %w\", err)\n94\t\t}\n95\t\tthreshold := spillThreshold()\n96\t\tif uint64(len(data)) > threshold {\n97\t\t\ttmpPath, err := spillToTempFile(data)\n98\t\t\tif err != nil {\n99\t\t\t\treturn nil, \"\", err\n100\t\t\t}\n101\t\t\treturn nil, tmpPath, nil\n102\t\t}\n103\t\treturn data, \"\", nil\n104\t}\n105\t\n106\tfunc spillThreshold() uint64 {\n107\t\tvar m runtime.MemStats\n108\t\truntime.ReadMemStats(&m)\n109\t\tavail := m.Sys - m.HeapInuse\n110\t\tif avail == 0 {\n111\t\t\treturn 256 * 1024 * 1024\n112\t\t}\n113\t\tquarter := avail / 4\n114\t\tconst maxThreshold = 1024 * 1024 * 1024\n115\t\tif quarter > maxThreshold {\n116\t\t\treturn maxThreshold\n117\t\t}\n118\t\treturn quarter\n119\t}\n120\t\n121\tfunc spillToTempFile(data []byte) (string, error) {\n122\t\tf, err := os.CreateTemp(tempDir(), \"sponge.\")\n123\t\tif err != nil {\n124\t\t\treturn \"\", fmt.Errorf(\"create temp file: %w\", err)\n125\t\t}\n126\t\tpath := f.Name()\n127\t\tif _, err := f.Write(data); err != nil {\n128\t\t\tf.Close()\n129\t\t\tos.Remove(path)\n130\t\t\treturn \"\", fmt.Errorf(\"write temp file: %w\", err)\n131\t\t}\n132\t\tif err := f.Close(); err != nil {\n133\t\t\tos.Remove(path)\n134\t\t\treturn \"\", fmt.Errorf(\"close temp file: %w\", err)\n135\t\t}\n136\t\treturn path, nil\n137\t}\n138\t\n139\tfunc tempDir(