 nil\n77\t}\n78\t\n79\tfunc tailBytes(r io.Reader, w io.Writer, opts options) error {\n80\t\tif opts.fromStart {\n81\t\t\treturn tailBytesFromStart(r, w, opts.count)\n82\t\t}\n83\t\treturn tailBytesFromEnd(r, w, opts.count)\n84\t}\n85\t\n86\tfunc tailBytesFromEnd(r io.Reader, w io.Writer, n int64) error {\n87\t\tif n <= 0 {\n88\t\t\treturn nil\n89\t\t}\n90\t\tdata, err := io.ReadAll(r)\n91\t\tif err != nil {\n92\t\t\treturn err\n93\t\t}\n94\t\tstart := int64(len(data)) - n\n95\t\tif start < 0 {\n96\t\t\tstart = 0\n97\t\t}\n98\t\t_, werr := w.Write(data[start:])\n99\t\treturn werr\n100\t}\n101\t\n102\tfunc tailBytesFromStart(r io.Reader, w io.Writer, n int64) error {\n103\t\tif n > 1 {\n104\t\t\t_, err := io.CopyN(io.Discard, r, n-1)\n105\t\t\tif err != nil {\n106\t\t\t\tif err == io.EOF {\n107\t\t\t\t\treturn nil\n108\t\t\t\t}\n109\t\t\t\treturn err\n110\t\t\t}\n111\t\t}\n112\t\t_, err := io.Copy(w, r)\n113\t\treturn err\n114\t}\n115\t\n116\tfunc tailLines(r io.Reader, w io.Writer, opts options) error {\n117\t\tif opts.fromStart {\n118\t\t\treturn tailLinesFromStart(r, w, opts.count)\n119\t\t}\n120\t\treturn tailLinesFromEnd(r, w, opts.count)\n121\t}\n122\t\n123\tfunc tailLinesFromEnd(r io.Reader, w io.Writer, n int64) error {\n124\t\tif n <= 0 {\n125\t\t\treturn nil\n126\t\t}\n127\t\tbr := bufio.NewReader(r)\n128\t\tvar lines [][]byte\n129\t\tfor {\n130\t\t\tline, err := br.ReadBytes('\\n')\n131\t\t\tif len(line) > 0 {\n132\t\t\t\tlines = append(lines, line)\n133\t\t\t}\n134\t\t\tif err != nil {\n135\t\t\t\tbreak\n136\t\t\t}\n137\t\t}\n138\t\tstart := max(int64(len(lines))-n, 0)\n139\t\tfor _, line := range lines[start:] {\n140\t\t\tif _, err := w.Write(line); err != nil {\n141\t\t\t\treturn err\n142\t\t\t}\n143\t\t}\n144\t\treturn nil\n145\t}\n146\t\n147\tfunc tailLinesFromStart(r io.Reader, w io.Writer, n int64) error {\n148\t\tbr := bufio.NewReader(r)\n149\t\tlineNum := int64(1)\n150\t\tfor {\n151\t\t\tline, err := br.ReadBytes('\\n')\n152\t\t\tif len(line) > 0 