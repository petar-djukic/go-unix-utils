hm=sha256\", \"--untagged\"},\n183\t\t\t\tStdin: []byte(\"hello\\n\"),\n184\t\t\t},\n185\t\t\t// R2.3: raw output\n186\t\t\t{\n187\t\t\t\tName: \"raw-sha256\",\n188\t\t\t\tArgs: []string{\"--algorithm=sha256\", \"--raw\", helloFile},\n189\t\t\t},\n190\t\t\t{\n191\t\t\t\tName:  \"raw-sha256-stdin\",\n192\t\t\t\tArgs:  []string{\"--algorithm=sha256\", \"--raw\"},\n193\t\t\t\tStdin: []byte(\"hello\\n\"),\n194\t\t\t},\n195\t\t\t{\n196\t\t\t\tName: \"raw-sm3\",\n197\t\t\t\tArgs: []string{\"--algorithm=sm3\", \"--raw\", helloFile},\n198\t\t\t},\n199\t\t\t// R3.1: exit 0 on success (verified by all above tests with default ExitCode=0)\n200\t\t}\n201\t\n202\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n203\t}\n204\t\n205\tfunc TestSIGPIPE(t *testing.T) {\n206\t\tgoBin := testutils.BuildBinary(t, \".\")\n207\t\tdir := t.TempDir()\n208\t\tlargePath := filepath.Join(dir, \"large.dat\")\n209\t\tif err := os.WriteFile(largePath, bytes.Repeat([]byte(\"x\\n\"), 500000), 0o644); err != nil {\n210\t\t\tt.Fatal(err)\n211\t\t}\n212\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n213\t\tdefer cancel()\n214\t\tcmd := exec.CommandContext(ctx, goBin, largePath)\n215\t\tstdout, err := cmd.StdoutPipe()\n216\t\tif err != nil {\n217\t\t\tt.Fatal(err)\n218\t\t}\n219\t\tif err := cmd.Start(); err != nil {\n220\t\t\tt.Fatal(err)\n221\t\t}\n222\t\tbuf := make([]byte, 1)\n223\t\tif _, err := io.ReadFull(stdout, buf); err != nil {\n224\t\t\tt.Fatal(err)\n225\t\t}\n226\t\tstdout.Close()\n227\t\terr = cmd.Wait()\n228\t\tif ctx.Err() == context.DeadlineExceeded {\n229\t\t\tt.Fatal(\"cksum timed out; SIGPIPE handler may not be installed\")\n230\t\t}\n231\t\tif err != nil {\n232\t\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n233\t\t}\n234\t}\n235\t"}]},"parent_tool_use_id":null,"session_id":"ab8bdeb5-6e3a-4d5e-965c-efab4cb31f2d","uuid":"293db1a7-0dbf-4d3d-b3a4-afded24f9907","timestamp":"2026-05-23T02:22:28.165Z","tool_use_result":{"type":"text","file":{"fi