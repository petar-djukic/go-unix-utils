{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VSeXPo87Woc6hBNTbW1eFR","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"crypto/sha1\"\n8\t\t\"crypto/sha256\"\n9\t\t\"crypto/sha512\"\n10\t\t\"fmt\"\n11\t\t\"hash\"\n12\t\t\"io\"\n13\t\t\"os\"\n14\t\t\"strings\"\n15\t\n16\t\t\"golang.org/x/crypto/blake2b\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n20\t)\n21\t\n22\tvar crcTable [256]uint32\n23\t\n24\tfunc init() {\n25\t\tconst poly = 0x04C11DB7\n26\t\tfor i := range 256 {\n27\t\t\tc := uint32(i) << 24\n28\t\t\tfor range 8 {\n29\t\t\t\tif c&0x80000000 != 0 {\n30\t\t\t\t\tc = (c << 1) ^ poly\n31\t\t\t\t} else {\n32\t\t\t\t\tc <<= 1\n33\t\t\t\t}\n34\t\t\t}\n35\t\t\tcrcTable[i] = c\n36\t\t}\n37\t}\n38\t\n39\ttype options struct {\n40\t\talgorithm string\n41\t\tuntagged  bool\n42\t\traw       bool\n43\t}\n44\t\n45\tfunc main() {\n46\t\tsys.InstallSIGPIPEHandler()\n47\t\topts, files := parseArgs(os.Args[1:])\n48\t\talg := opts.algorithm\n49\t\tif alg == \"\" || alg == \"crc\" {\n50\t\t\trunCRC(files)\n51\t\t\treturn\n52\t\t}\n53\t\tcfg, err := algorithmConfig(alg)\n54\t\tif err != nil {\n55\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n56\t\t\tos.Exit(1)\n57\t\t}\n58\t\tif opts.raw {\n59\t\t\tif len(files) > 1 {\n60\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: the --raw option is not supported with multiple files\\n\")\n61\t\t\t\tos.Exit(1)\n62\t\t\t}\n63\t\t\tos.Exit(digestRaw(files, cfg))\n64\t\t}\n65\t\tos.Exit(hashutil.DigestFiles(files, cfg, false, !opts.untagged, os.Stdout, os.Stderr))\n66\t}\n67\t\n68\tfunc runCRC(files []string) {\n69\t\texitCode := 0\n70\t\tif len(files) == 0 {\n71\t\t\tif err := crcStdin(os.Stdout); err != nil {\n72\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n73\t\t\t\texitCode = 1\n74\t\t\t}\n75\t\t} else {\n76\t\t\tfor _, file := range files {\n77\t\t\t\tif err := crcFile(file, os.Stdout); err != nil {\n78\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n79\t\t\t\t\texitCode = 1\n80\t\t\t\t}\n81\t\t\t}\n82\t\t}\n83\t\tos.Exit(exitCode)\n84\t}\n85\t\n86\tfunc algorithmConfig(alg string) (hashutil.HashConfig, error) {\n87\t\tswitch alg {\n88\t\tcase \"sha1\":\n89\t\t\treturn hashutil.HashConfig{Algorithm: \"SHA1\", NewHash: sha1.New, DigestLen: 20}, nil\n90\t\tcase \"sha224\":\n91\t\t\treturn hashutil.HashConfig{Algorithm: \"SHA224\", NewHash: sha256.New224, DigestLen: 28}, nil\n92\t\tcase \"sha256\":\n93\t\t\treturn hashutil.HashConfig{Algorithm: \"SHA256\", NewHash: sha256.New, DigestLen: 32}, nil\n94\t\tcase \"sha384\":\n95\t\t\treturn hashutil.HashConfig{Algorithm: \"SHA384\", NewHash: sha512.New384, DigestLen: 48}, nil\n96\t\tcase \"sha512\":\n97\t\t\treturn hashutil.HashConfig{Algorithm: \"SHA512\", NewHash: sha512.New, DigestLen: 64}, nil\n98\t\tcase \"blake2b\":\n99\t\t\treturn hashutil.HashConfig{\n100\t\t\t\tAlgorithm: \"BLAKE2b\",\n101\t\t\t\tNewHash:   func() hash.Hash { h, _ := blake2b.New512(nil); return h },\n102\t\t\t\tDigestLen: 64,\n103\t\t\t}, nil\n104\t\tcase \"sm3\":\n105\t\t\treturn hashutil.HashConfig{Algorithm: \"SM3\", NewHash: newSM3, DigestLen: 32}, nil\n106\t\tdefault:\n107\t\t\treturn hashutil.HashConfig{}, fmt.Errorf(\"unrecognized algorithm: %s\", alg)\n108\t\t}\n109\t}\n110\t\n111\tfunc digestRaw(files []string, cfg hashutil.HashConfig) int {\n112\t\tif len(files) == 0 {\n113\t\t\tfiles = []string{\"-\"}\n114\t\t}\n115\t\tfor _, file := range files {\n116\t\t\tr, err := openInput(file)\n117\t\t\tif err != nil {\n118\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n119\t\t\t\treturn 1\n120\t\t\t}\n121\t\t\th := cfg.NewHash()\n122\t\t\t_, err = io.Copy(h, r)\n123\t\t\tr.Close()\n124\t\t\tif err != nil {\n125\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n126\t\t\t\treturn 1\n127\t\t\t}\n128\t\t\tos.Stdout.Write(h.Sum(nil))\n129\t\t}\n130\t\treturn 0\n131\t}\n132\t\n133\tfunc parseArgs(args []string) (options, []string) {\n134\t\tvar opts options\n135\t\tvar files []string\n136\t\ti := 0\n137\t\tfor i < len(args) {\n138\t\t\targ := args[i]\n139\t\t\tif arg == \"--\" {\n140\t\t\t\tfiles = append(files, args[i+1:]...)\n141\t\t\t\tbreak\n142\t\t\t}\n143\t\t\tif strings.HasPrefix(arg, \"--\") {\n144\t\t\t\ti += parseLongFlag(args[i:], &opts)\n145\t\t\t\tcontinue\n146\t\t\t}\n147\t\t\tif arg != \"-\" && strings.HasPrefix(arg, \"-\") {\n148\t\t\t\ti += parseShortFlag(args[i:], &opts)\n149\t\t\t\tcontinue\n150\t\t\t}\n151\t\t\tfiles = append(files, arg)\n152\t\t\ti++\n153\t\t}\n154\t\treturn opts, files\n155\t}\n156\t\n157\tfunc parseLongFlag(remaining []string, opts *options) int {\n158\t\targ := remaining[0]\n159\t\tswitch {\n160\t\tcase arg == \"--untagged\":\n161\t\t\topts.untagged = true\n162\t\tcase arg == \"--raw\":\n163\t\t\topts.raw = true\n164\t\tcase arg == \"--algorithm\" && len(remaining) >= 2:\n165\t\t\topts.algorithm = remaining[1]\n166\t\t\treturn 2\n167\t\tcase strings.HasPrefix(arg, \"--algorithm=\"):\n168\t\t\topts.algorithm = arg[len(\"--algorithm=\"):]\n169\t\t}\n170\t\treturn 1\n171\t}\n172\t\n173\tfunc parseShortFlag(remaining []string, opts *options) int {\n174\t\targ := remaining[0]\n175\t\tif len(arg) >= 2 && arg[1] == 'a' {\n176\t\t\tif len(arg) > 2 {\n177\t\t\t\topts.algorithm = arg[2:]\n178\t\t\t\treturn 1\n179\t\t\t}\n180\t\t\tif len(remaining) >= 2 {\n181\t\t\t\topts.algorithm = remaining[1]\n182\t\t\t\treturn 2\n183\t\t\t}\n184\t\t}\n185\t\treturn 1\n186\t}\n187\t\n188\tfunc crcStdin(stdout io.Writer) error {\n189\t\tcrc, size, err := computeCRC(os.Stdin)\n190\t\tif err != nil {\n191\t\t\treturn err\n192\t\t}\n193\t\tfmt.Fprintf(stdout, \"%d %d\\n\", crc, size)\n194\t\treturn nil\n195\t}\n196\t\n197\tfunc crcFile(file string, stdout io.Writer) error {\n198\t\tr, err := openInput(file)\n199\t\tif err != nil {\n200\t\t\treturn err\n201\t\t}\n202\t\tdefer r.