efer outCloser.Close()\n\t}\n\n\treturn deduplicate(r, out)\n}\n\nfunc openInput(name string) (io.Reader, io.Closer, error) {\n\tif name == \"\" || name == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc openOutput(w *bufio.Writer, name string) (*bufio.Writer, io.Closer, error) {\n\tif name == \"\" {\n\t\treturn w, nil, nil\n\t}\n\tf, err := os.Create(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn bufio.NewWriter(f), f, nil\n}\n\nfunc deduplicate(r io.Reader, w *bufio.Writer) int {\n\tscanner := bufio.NewScanner(r)\n\tfirst := true\n\tvar prev string\n\tfor scanner.Scan() {\n\t\tline := scanner.Text()\n\t\tif first || line != prev {\n\t\t\tif _, err := w.WriteString(line); err != nil {\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\tif err := w.WriteByte('\\n'); err != nil {\n\t\t\t\treturn 1\n\t\t\t}\n\t\t\tprev = line\n\t\t\tfirst = false\n\t\t}\n\t}\n\tif err := w.Flush(); err != nil {\n\t\treturn 1\n\t}\n\treturn 0\n}\n","userModified":false}}
