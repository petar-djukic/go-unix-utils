eturn \"\\n\", true\n\tcase 't':\n\t\treturn \"\\t\", true\n\tcase '%':\n\t\treturn \"%\", true\n\tdefault:\n\t\treturn \"\", false\n\t}\n}\n\nfunc padValue(raw string, width int, pad byte, mod byte) string {\n\tif width == 0 || mod == '-' {\n\t\treturn raw\n\t}\n\tswitch mod {\n\tcase '_':\n\t\tpad = ' '\n\tcase '0':\n\t\tpad = '0'\n\t}\n\tif len(raw) >= width {\n\t\treturn raw\n\t}\n\treturn strings.Repeat(string(pad), width-len(raw)) + raw\n}\n\nfunc hour12(t time.Time) int {\n\th := t.Hour() % 12\n\tif h == 0 {\n\t\th = 12\n\t}\n\treturn h\n}\n","numLines":267,"startLine":1,"totalLines":267}}}
