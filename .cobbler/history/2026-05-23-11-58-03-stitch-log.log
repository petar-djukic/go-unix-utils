oin(refDir1, \"ref\"), make([]byte, 75), 0644)\n\ttests = append(tests, testutils.DiffTest{\n\t\tName:    \"reference file short flag\",\n\t\tArgs:    []string{\"-r\", \"ref\", \"file\"},\n\t\tWorkDir: refDir1,\n\t\tExpectedFiles: map[string][]byte{\n\t\t\t\"file\": make([]byte, 75),\n\t\t},\n\t})\n\n\trefDir2 := t.TempDir()\n\tos.WriteFile(filepath.Join(refDir2, \"ref\"), make([]byte, 75), 0644)\n\ttests = append(tests, testutils.DiffTest{\n\t\tName:    \"reference file long flag\",\n\t\tArgs:    []string{\"--reference=ref\", \"file\"},\n\t\tWorkDir: refDir2,\n\t\tExpectedFiles: map[string][]byte{\n\t\t\t\"file\": make([]byte, 75),\n\t\t},\n\t})\n\n\trefPlusDir := t.TempDir()\n\tos.WriteFile(filepath.Join(refPlusDir, \"ref\"), make([]byte, 100), 0644)\n\ttests = append(tests, testutils.DiffTest{\n\t\tName:    \"reference with relative size\",\n\t\tArgs:    []string{\"-r\", \"ref\", \"-s\", \"+25\", \"file\"},\n\t\tWorkDir: refPlusDir,\n\t\tExpectedFiles: map[string][]byte{\n\t\t\t\"file\": make([]byte, 125),\n\t\t},\n\t})\n\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\nfunc TestNoCreateSkipsCreation(t *testing.T) {\n\tbin := testutils.BuildBinary(t, \".\")\n\tdir := t.TempDir()\n\tpath := filepath.Join(dir, \"absent\")\n\n\tcmd := exec.Command(bin, \"-c\", \"-s\", \"100\", path)\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"truncate -c failed: %v\", err)\n\t}\n\n\tif _, err := os.Stat(path); !os.IsNotExist(err) {\n\t\tt.Fatalf(\"expected file to not exist, got: %v\", err)\n\t}\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":0,"cache_read_input_tokens":36884,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":12,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3744d7c5-07a8-4173-943a-43ef3e470584","uuid":"b3a9