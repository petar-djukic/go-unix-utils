n(\"reference-file\", func(t *testing.T) {\n223\t\t\trunTruncTest(t, goBin, refBin, []string{\"-r\", \"ref\", \"target\"},\n224\t\t\t\tfunc(dir string) {\n225\t\t\t\t\tos.WriteFile(filepath.Join(dir, \"ref\"), make([]byte, 42), 0o644)\n226\t\t\t\t})\n227\t\t})\n228\t\n229\t\tt.Run(\"reference-with-relative-size\", func(t *testing.T) {\n230\t\t\trunTruncTest(t, goBin, refBin, []string{\"-r\", \"ref\", \"-s\", \"+5\", \"target\"},\n231\t\t\t\tfunc(dir string) {\n232\t\t\t\t\tos.WriteFile(filepath.Join(dir, \"ref\"), make([]byte, 11), 0o644)\n233\t\t\t\t})\n234\t\t})\n235\t\n236\t\tt.Run(\"nonexistent-reference\", func(t *testing.T) {\n237\t\t\trunTruncTest(t, goBin, refBin, []string{\"-r\", \"nosuchref\", \"target\"}, nil)\n238\t\t})\n239\t\n240\t\tt.Run(\"combined-cs\", func(t *testing.T) {\n241\t\t\trunTruncTest(t, goBin, refBin, []string{\"-cs\", \"100\", \"file\"}, nil)\n242\t\t})\n243\t\n244\t\tt.Run(\"size-zero\", func(t *testing.T) {\n245\t\t\trunTruncTest(t, goBin, refBin, []string{\"-s\", \"0\", \"file\"},\n246\t\t\t\tfunc(dir string) {\n247\t\t\t\t\tos.WriteFile(filepath.Join(dir, \"file\"), make([]byte, 50), 0o644)\n248\t\t\t\t})\n249\t\t})\n250\t\n251\t\tt.Run(\"io-blocks\", func(t *testing.T) {\n252\t\t\trunTruncTest(t, goBin, refBin, []string{\"-o\", \"-s\", \"1\", \"file\"}, nil)\n253\t\t})\n254\t}\n255\t\n256\ttype binResult struct {\n257\t\tstdout   []byte\n258\t\tstderr   []byte\n259\t\texitCode int\n260\t}\n261\t\n262\tfunc runTruncTest(\n263\t\tt *testing.T, goBin, refBin string,\n264\t\targs []string, setup func(string),\n265\t) {\n266\t\tt.Helper()\n267\t\tgoDir := t.TempDir()\n268\t\trefDir := t.TempDir()\n269\t\tif setup != nil {\n270\t\t\tsetup(goDir)\n271\t\t\tsetup(refDir)\n272\t\t}\n273\t\tgoRes := runBin(t, goBin, args, goDir)\n274\t\trefRes := runBin(t, refBin, args, refDir)\n275\t\tcompareResults(t, args, goRes, refRes)\n276\t\tcompareDirSizes(t, args, goDir, refDir)\n277\t}\n278\t\n279\tfunc runBin(t *testing.T, binary string, args []string, workDir string) binResult {\n280\t\tt.Helper()\n281\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n282\t\tdefer cancel()\n283\t\tcmd := exec.CommandContext(ctx, binary, args...)\n284\t\tcmd.Dir = workDir\n285\t\tcmd.Env = append(os.Environ(), \"LC_ALL=C\")\n286\t\tvar stdout, stderr bytes.Buffer\n287\t\tcmd.Stdout = &stdout\n288\t\tcmd.Stderr = &stderr\n289\t\terr := cmd.Run()\n290\t\tif ctx.Err() == context.DeadlineExceeded {\n291\t\t\tt.Fatalf(\"binary %s timed out\", binary)\n292\t\t}\n293\t\texitCode := 0\n294\t\tif err != nil {\n295\t\t\tvar exitErr *exec.ExitError\n296\t\t\tif errors.As(err, &exitErr) {\n297\t\t\t\texitCode = exitErr.ExitCode()\n298\t\t\t} else {\n299\t\t\t\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n300\t\t\t}\n301\t\t}\n302\t\treturn binResult{stdout: stdout.Bytes(), stderr: stderr.Bytes(), exitCode: exitCode}\n303\t}\n304\t\n305\tfunc compareResults(t *testing.T, args []string, goRes, refRes binResult) {\n306\t\tt.Helper()\n307\t\tgoStdout := normBinaryName(goRes.stdout)\n308\t\trefStdout := normBinaryName(refRes.stdout)\n309\t\tgoStderr := normBinaryName(goRes.stderr)\n310\t\trefStderr := normBinaryName(refRes.stderr)\n311\t\n312\t\tif !bytes.Equal(goStdout, refStdout) ||\n313\t\t\t!bytes.Equal(goStderr, refStderr) ||\n314\t\t\tgoRes.exitCode != refRes.exitCode {\n315\t\t\tt.Fatalf(\"divergence detected\\n\"+\n316\t\t\t\t\"  args:       %v\\n\"+\n317\t\t\t\t\"  ref stdout: %q\\n\"+\n318\t\t\t\t\"  go  stdout: %q\\n\"+\n319\t\t\t\t\"  ref stderr: %q\\n\"+\n320\t\t\t\t\"  go  stderr: %q\\n\"+\n321\t\t\t\t\"  ref exit:   %d\\n\"+\n322\t\t\t\t\"  go  exit:   %d\\n\",\n323\t\t\t\targs, refStdout, goStdout, refStderr, goStderr, refRes.exitCode, goRes.exitCode)\n324\t\t}\n325\t}\n326\t\n327\tfunc compareDirSizes(t *testing.T, args []string, goDir, refDir string) {\n328\t\tt.Helper()\n329\t\tgoEntries, _ := os.ReadDir(goDir)\n330\t\trefEntries, _ := os.ReadDir(refDir)\n331\t\tgoFiles := fileInfoMap(goEntries, goDir)\n332\t\trefFiles := fileInfoMap(refEntries, refDir)\n333\t\n334\t\tfor name, refSize := range refFiles {\n335\t\t\tgoSize, ok := goFiles[name]\n336\t\t\tif !ok {\n337\t\t\t\tt.Errorf(\"file %q exists in ref dir but not go dir (args: %v)\", name, args)\n338\t\t\t\tcontinue\n339\t\t\t}\n340\t\t\tif goSize != refSize {\n341\t\t\t\tt.Errorf(\"file %q size mismatch: go=%d ref=%d (args: %v)\",\n342\t\t\t\t\tname, goSize, refSize, args)\n343\t\t\t}\n344\t\t}\n345\t\tfor name := range goFiles {\n346\t\t\tif _, ok := refFiles[name]; !ok {\n347\t\t\t\tt.Errorf(\"file %q exists in go dir but not ref dir (args: %v)\", name, args)\n348\t\t\t}\n349\t\t}\n350\t}\n351\t\n352\tfunc fileInfoMap(entries []os.DirEntry, dir string) map[string]int64 {\n353\t\tm := make(map[string]int64)\n354\t\tfor _, e := range entries {\n355\t\t\tif e.IsDir() {\n356\t\t\t\tcontinue\n357\t\t\t}\n358\t\t\tfi, err := e.Info()\n359\t\t\tif err != nil {\n360\t\t\t\tcontinue\n361\t\t\t}\n362\t\t\tm[e.Name()] = fi.Size()\n363\t\t}\n364\t\treturn m\n365\t}\n366\t"}]},"parent_tool_use_id":null,"session_id":"3744d7c5-07a8-4173-943a-43ef3e470584","uuid":"49e449a9-c28a-4717-b8b3-abfeea58a22d","timestamp":"2026-05-23T16:16:39.345Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5541/cmd/truncate/truncate_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nvar binaryNameRe = regexp.MustCompile(`(?:/\\S+/)?g?truncate`)\n\nfunc normBinaryName(b []byte) []byte {\n\treturn binaryNameRe.ReplaceAll(b, []byte(\"truncate\"))\n}\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gtrun