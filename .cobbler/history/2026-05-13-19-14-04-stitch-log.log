{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VfYvQ1fUn8DNqufsagGdAE","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage format\n5\t\n6\timport (\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"sync\"\n10\t\n11\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n12\t)\n13\t\n14\tconst (\n15\t\tansiReset    = \"\\033[0m\"\n16\t\tansiDir      = \"\\033[01;34m\"\n17\t\tansiSymlink  = \"\\033[01;36m\"\n18\t\tansiExec     = \"\\033[01;32m\"\n19\t\tansiFifo     = \"\\033[40;33m\"\n20\t\tansiSocket   = \"\\033[01;35m\"\n21\t\tansiBlockDev = \"\\033[01;33m\"\n22\t\tansiCharDev  = \"\\033[01;33m\"\n23\t)\n24\t\n25\tvar (\n26\t\tcolorMu       sync.RWMutex\n27\t\tcolorOverride *bool\n28\t)\n29\t\n30\tfunc FileTypeColor(mode os.FileMode) string {\n31\t\tswitch {\n32\t\tcase mode&os.ModeDir != 0:\n33\t\t\treturn ansiDir\n34\t\tcase mode&os.ModeSymlink != 0:\n35\t\t\treturn ansiSymlink\n36\t\tcase mode&os.ModeNamedPipe != 0:\n37\t\t\treturn ansiFifo\n38\t\tcase mode&os.ModeSocket != 0:\n39\t\t\treturn ansiSocket\n40\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n41\t\t\treturn ansiCharDev\n42\t\tcase mode&os.ModeDevice != 0:\n43\t\t\treturn ansiBlockDev\n44\t\tcase mode&0o111 != 0:\n45\t\t\treturn ansiExec\n46\t\tdefault:\n47\t\t\treturn \"\"\n48\t\t}\n49\t}\n50\t\n51\tfunc Reset() string {\n52\t\treturn ansiReset\n53\t}\n54\t\n55\tfunc ColorEnabled(w io.Writer) bool {\n56\t\tcolorMu.RLock()\n57\t\toverride := colorOverride\n58\t\tcolorMu.RUnlock()\n59\t\tif override != nil {\n60\t\t\treturn *override\n61\t\t}\n62\t\ttype fder interface {\n63\t\t\tFd() uintptr\n64\t\t}\n65\t\tif f, ok := w.(fder); ok {\n66\t\t\treturn sys.IsTerminal(f.Fd())\n67\t\t}\n68\t\treturn false\n69\t}\n70\t\n71\tfunc SetColorEnabled(enabled bool) {\n72\t\tcolorMu.Lock()\n73\t\tcolorOverride = &enabled\n74\t\tcolorMu.Unlock()\n75\t}\n76\t\n77\tfunc ResetColorEnabled() {\n78\t\tcolorMu.Lock()\n79\t\tcolorOverride = nil\n80\t\tcolorMu.Unlock()\n81\t}\n82\t"}]},"parent_tool_use_id":null,"session_id":"1fddc713-5852-4641-9a02-1148ebe93444","uuid":"dc52bdff-7ae8-42b3-ba58-d96969a46be3","timestamp":"2026-05-13T23:15:02.789Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5090/pkg/format/color.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage format\n\nimport (\n\t\"io\"\n\t\"os\"\n\t\"sync\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst (\n\tansiReset    = \"\\033[0m\"\n\tansiDir      = \"\\033[01;34m\"\n\tansiSymlink  = \"\\033[01;36m\"\n\tansiExec     = \"\\033[01;32m\"\n\tansiFifo     = \"\\033[40;33m\"\n\tansiSocket   = \"\\033[01;35m\"\n\tansiBlockDev = \"\\033[01;33m\"\n\tansiCharDev  = \"\\033[01;33m\"\n)\n\nvar (\n\tcolorMu       sync.RWMutex\n\tcolorOverride *bool\n)\n\nfunc FileTypeColor(mode os.FileMode) string {\n\tswitch {\n\tcase mode&os.ModeDir != 0:\n\t\treturn ansiDir\n\tcase mode&os.ModeSymlink != 0:\n\t\treturn ansiSymlink\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn ansiFifo\n\tcase mode&os.ModeSocket != 0:\n\t\treturn ansiSocket\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn ansiCharDev\n\tcase mode&os.ModeDevice != 0:\n\t\treturn ansiBlockDev\n\tcase mode&0o111 != 0:\n\t\treturn ansiExec\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\nfunc Reset() string {\n\treturn ansiReset\n}\n\nfunc ColorEnabled(w io.Writer) bool {\n\tcolorMu.RLock()\n\toverride := colorOverride\n\tcolorMu.RUnlock()\n\tif override != nil {\n\t\treturn *override\n\t}\n\ttype fder interface {\n\t\tFd() uintptr\n\t}\n\tif f, ok := w.(fder); ok {\n\t\treturn sys.IsTerminal(f.Fd())\n\t}\n\treturn false\n}\n\nfunc SetColorEnabled(enabled bool) {\n\tcolorMu.Lock()\n\tcolorOverride = &enabled\n\tcolorMu.Unlock()\n}\n\nfunc ResetColorEnabled() {\n\tcolorMu.Lock()\n\tcolorOverride = nil\n\tcolorMu.Unlock()\n}\n","numLines":82,"startLine":1,"totalLines":82}}}
