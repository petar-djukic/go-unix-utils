k\n\tcase mode&os.ModeNamedPipe != 0:\n\t\treturn ansiFifo\n\tcase mode&os.ModeSocket != 0:\n\t\treturn ansiSocket\n\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n\t\treturn ansiCharDev\n\tcase mode&os.ModeDevice != 0:\n\t\treturn ansiBlockDev\n\tcase mode&0o111 != 0:\n\t\treturn ansiExec\n\tdefault:\n\t\treturn \"\"\n\t}\n}\n\nfunc Reset() string {\n\treturn ansiReset\n}\n\nfunc ColorEnabled(w io.Writer) bool {\n\tcolorMu.RLock()\n\toverride := colorOverride\n\tcolorMu.RUnlock()\n\tif override != nil {\n\t\treturn *override\n\t}\n\ttype fder interface {\n\t\tFd() uintptr\n\t}\n\tif f, ok := w.(fder); ok {\n\t\treturn sys.IsTerminal(f.Fd())\n\t}\n\treturn false\n}\n\nfunc SetColorEnabled(enabled bool) {\n\tcolorMu.Lock()\n\tcolorOverride = &enabled\n\tcolorMu.Unlock()\n}\n\nfunc ResetColorEnabled() {\n\tcolorMu.Lock()\n\tcolorOverride = nil\n\tcolorMu.Unlock()\n}\n","structuredPatch":[{"oldStart":60,"oldLines":7,"newStart":60,"newLines":12,"lines":["   }"," }"," ","+// Reset returns the ANSI reset sequence.","+// R2.2, R2.6: returns empty string when color is explicitly disabled via SetColorEnabled(false)."," func Reset() string {","+  if colorDisabled() {","+    return \"\"","+  }","   return ansiReset"," }"," "]}],"userModified":false,"replaceAll":false}}
