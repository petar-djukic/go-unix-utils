echo ----\n\n  - name: echo_default_output\n    description: No flags; arguments joined with spaces, followed by newline.\n    inputs:\n      args: [\"hello\", \"world\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello world\\n\"\n      stderr: \"\"\n    traces:\n      - prd020-echo R1.1\n\n  - name: echo_no_args\n    description: No arguments; outputs only a newline.\n    inputs:\n      args: []\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"\\n\"\n      stderr: \"\"\n    traces:\n      - prd020-echo R1.2\n\n  - name: echo_suppress_newline\n    description: -n flag suppresses trailing newline.\n    inputs:\n      args: [\"-n\", \"hello\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello\"\n      stderr: \"\"\n    traces:\n      - prd020-echo R1.3\n\n  - name: echo_escape_tab\n    description: -e interprets \\\\t as a horizontal tab.\n    inputs:\n      args: [\"-e\", \"col1\\\\tcol2\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"col1\\tcol2\\n\"\n      stderr: \"\"\n    traces:\n      - prd020-echo R2.1\n\n  - name: echo_escape_newline\n    description: -e interprets \\\\n as an embedded newline.\n    inputs:\n      args: [\"-e\", \"line1\\\\nline2\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"line1\\nline2\\n\"\n      stderr: \"\"\n    traces:\n      - prd020-echo R2.1\n\n  - name: echo_escape_c_terminates\n    description: -e with \\\\c terminates output at that point; no trailing newline.\n    inputs:\n      args: [\"-e\", \"before\\\\cafter\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"before\"\n      stderr: \"\"\n    traces:\n      - prd020-echo R2.2\n\n  - name: echo_no_escape_default\n    description: Without -e, backslash sequences are literal.\n    inputs:\n      args: [\"a\\\\tb\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a\\\\tb\\n\"\n      stderr: \"\"\n    traces:\n      - prd020-echo R2.3\n\n  - name: echo_combined_n_e\n    description: -n -e combined; escape sequences processed and no trailing newline.\n    inputs:\n      args: [\"-n\", \"-e\", \"x\\\\ty\"]\n      stdin: null\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"x\\ty\"\n      stderr: \"\"\n    traces:\n      - prd020-echo R1.3\n      - prd020-echo R2.1\n\n  # ---- tac ----\n\n  - name: tac_default_reversal\n    description: Lines reversed; trailing newline preserved.\n    inputs:\n      args: []\n      stdin: \"alpha\\nbeta\\ngamma\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"gamma\\nbeta\\nalpha\\n\"\n      stderr: \"\"\n    traces:\n      - prd021-tac R1.1\n      - prd021-tac R1.2\n\n  - name: tac_no_trailing_newline\n    description: Input without trailing newline; last line (now first) has no newline.\n    inputs:\n      args: []\n      stdin: \"a\\nb\\nc\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"c\\nb\\na\"\n      stderr: \"\"\n    traces:\n      - prd021-tac R1.2\n\n  - name: tac_custom_separator\n    description: -s ':' splits on colon; records reversed with colon separator after each.\n    inputs:\n      args: [\"-s\", \":\"]\n      stdin: \"a:b:c:\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"c:b:a:\"\n      stderr: \"\"\n    traces:\n      - prd021-tac R2.1\n\n  - name: tac_before_flag\n    description: -b places separator before each record.\n    inputs:\n      args: [\"-b\", \"-s\", \":\"]\n      stdin: \":a:b:c\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \":c:b:a\"\n      stderr: \"\"\n    traces:\n      - prd021-tac R2.2\n\n  - name: tac_single_line\n    description: Single line input reverses to itself.\n    inputs:\n      args: []\n      stdin: \"only\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"only\\n\"\n      stderr: \"\"\n    traces:\n      - prd021-tac R1.1\n\n  # ---- nl ----\n\n  - name: nl_default_body_numbering\n    description: Default mode numbers non-empty body lines only; empty lines pass through unnumbered.\n    inputs:\n      args: []\n      stdin: \"first\\n\\nsecond\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\tfirst\\n\\n     2\\tsecond\\n\"\n      stderr: \"\"\n    traces:\n      - prd022-nl R1.1\n      - prd022-nl R1.2\n\n  - name: nl_number_all_lines\n    description: -b a numbers every line including empty lines.\n    inputs:\n      args: [\"-b\", \"a\"]\n      stdin: \"x\\n\\ny\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\tx\\n     2\\t\\n     3\\ty\\n\"\n      stderr: \"\"\n    traces:\n      - prd022-nl R2.1\n\n  - name: nl_format_ln_width_3_separator\n    description: \"-n ln -w 3 -s ': ' uses left-justified 3-char field with custom separator.\"\n    inputs:\n      args: [\"-n\", \"ln\", \"-w\", \"3\", \"-s\", \": \"]\n      stdin: \"a\\nb\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"1  : a\\n2  : b\\n\"\n      stderr: \"\"\n    traces:\n      - prd022-nl R3.1\n      - prd022-nl R3.2\n      - prd022-nl R3.3\n\n  - name: nl_start_and_increment\n    description: -v 10 -i 5 starts at 10 and increments by 5.\n    inputs:\n      args: [\"-v\", \"10\", \"-i\", \"5\"]\n      stdin: \"p\\nq\\nr\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"    10\\tp\\n    15\\tq\\n    20\\tr\\n\"\n      stderr: \"\"\n    traces:\n      - prd022-nl R3.4\n\n  - name: nl_section_delimiters\n    description: Section delimiter lines consumed; header numbered with -h a.\n    inputs:\n      args: [\"-h\", \"a\"]\n      stdin: \"\\\\:\\\\:\\\\:\\nheader line\\n\\\\:\\\\:\\nbody line\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"     1\\theader line\\n     1\\tbody line\\n\"\n      stderr: \"\"\n    traces:\n      - prd022-nl R4.1\n      - prd022-nl R4.2\n\n  # ---- fold ----\n\n  - name: fold_default_width_80\n    description: Lines up to 80 characters pass through unchanged.\n    inputs:\n      args: []\n      stdin: \"short line\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"short line\\n\"\n      stderr: \"\"\n    traces:\n      - prd023-fold R1.2\n\n  - name: fold_wrap_at_width\n    description: -w 4 wraps a 10-character string into segments of 4, 4, 2.\n    inputs:\n      args: [\"-w\", \"4\"]\n      stdin: \"abcdefghij\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"abcd\\nefgh\\nij\"\n      stderr: \"\"\n    traces:\n      - prd023-fold R1.1\n      - prd023-fold R1.3\n      - prd023-fold R1.4\n\n  - name: fold_space_break\n    description: -w 11 -s breaks at the last space within 11 columns.\n    inputs:\n      args: [\"-w\", \"11\", \"-s\"]\n      stdin: \"hello world foo\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"hello world\\nfoo\\n\"\n      stderr: \"\"\n    traces:\n      - prd023-fold R3.1\n\n  - name: fold_byte_mode\n    description: -b measures width in bytes; no tab-stop expansion.\n    inputs:\n      args: [\"-b\", \"-w\", \"4\"]\n      stdin: \"abcde\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"abcd\\ne\"\n      stderr: \"\"\n    traces:\n      - prd023-fold R2.3\n\n  - name: fold_tab_columns\n    description: Tab expands to tab stops for column counting; wrap accounts for tab width.\n    inputs:\n      args: [\"-w\", \"9\"]\n      stdin: \"a\\tbcde\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"a\\tbcd\\ne\\n\"\n      stderr: \"\"\n    traces:\n      - prd023-fold R2.2\n\n  - name: fold_space_break_no_space\n    description: -s with no space in first W columns falls back to hard wrap.\n    inputs:\n      args: [\"-w\", \"4\", \"-s\"]\n      stdin: \"abcdefgh\\n\"\n      env: [\"LC_ALL=C\"]\n    normalization: none\n    expected:\n      exit_code: 0\n      stdout: \"abcd\\nefgh\\n\"\n      stderr: \"\"\n    traces:\n      - prd023-fold R3.2\n","numLines":384,"startLine":1,"totalLines":384}}}
