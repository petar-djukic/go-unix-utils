n(workDir, name), []byte(\"x\"), 0o644)\n110\t\t\t\tsetGroup(t, filepath.Join(workDir, name), groupA.gid)\n111\t\t\t}\n112\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n113\t\t\t\t{\n114\t\t\t\t\tName:    \"three_files\",\n115\t\t\t\t\tArgs:    []string{\":\" + groupB.name, \"a\", \"b\", \"c\"},\n116\t\t\t\t\tWorkDir: workDir,\n117\t\t\t\t},\n118\t\t\t})\n119\t\t\tfor _, name := range []string{\"a\", \"b\", \"c\"} {\n120\t\t\t\tverifyGroup(t, filepath.Join(workDir, name), groupB.gid)\n121\t\t\t}\n122\t\t})\n123\t\n124\t\tt.Run(\"reference_file\", func(t *testing.T) {\n125\t\t\tworkDir := t.TempDir()\n126\t\t\tos.WriteFile(filepath.Join(workDir, \"ref\"), []byte(\"r\"), 0o644)\n127\t\t\tsetGroup(t, filepath.Join(workDir, \"ref\"), groupB.gid)\n128\t\t\tos.WriteFile(filepath.Join(workDir, \"target\"), []byte(\"t\"), 0o644)\n129\t\t\tsetGroup(t, filepath.Join(workDir, \"target\"), groupA.gid)\n130\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n131\t\t\t\t{\n132\t\t\t\t\tName:      \"reference\",\n133\t\t\t\t\tArgs:      []string{\"--reference=ref\", \"target\"},\n134\t\t\t\t\tWorkDir:   workDir,\n135\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n136\t\t\t\t},\n137\t\t\t})\n138\t\t})\n139\t\n140\t\tt.Run(\"invalid_user\", func(t *testing.T) {\n141\t\t\tworkDir := t.TempDir()\n142\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n143\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n144\t\t\t\t{\n145\t\t\t\t\tName:      \"bad_user\",\n146\t\t\t\t\tArgs:      []string{\"nonexistent_user_xyz\", \"file\"},\n147\t\t\t\t\tWorkDir:   workDir,\n148\t\t\t\t\tExitCode:  1,\n149\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n150\t\t\t\t},\n151\t\t\t})\n152\t\t})\n153\t\n154\t\tt.Run(\"invalid_group\", func(t *testing.T) {\n155\t\t\tworkDir := t.TempDir()\n156\t\t\tos.WriteFile(filepath.Join(workDir, \"file\"), []byte(\"x\"), 0o644)\n157\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n158\t\t\t\t{\n159\t\t\t\t\tName:      \"bad_group\",\n160\t\t\t\t\tArgs:      []string{\":nonexistent_group_xyz\", \"file\"},\n161\t\t\t\t\tWorkDir:   workDir,\n162\t\t\t\t\tExitCode:  1,\n163\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n164\t\t\t\t},\n165\t\t\t})\n166\t\t})\n167\t\n168\t\tt.Run(\"missing_operand\", func(t *testing.T) {\n169\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n170\t\t\t\t{\n171\t\t\t\t\tName:      \"no_args\",\n172\t\t\t\t\tArgs:      []string{},\n173\t\t\t\t\tExitCode:  1,\n174\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n175\t\t\t\t},\n176\t\t\t})\n177\t\t})\n178\t\n179\t\tt.Run(\"missing_file_operand\", func(t *testing.T) {\n180\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n181\t\t\t\t{\n182\t\t\t\t\tName:      \"owner_only\",\n183\t\t\t\t\tArgs:      []string{cur.Username},\n184\t\t\t\t\tExitCode:  1,\n185\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n186\t\t\t\t},\n187\t\t\t})\n188\t\t})\n189\t\n190\t\tt.Run(\"nonexistent_file\", func(t *testing.T) {\n191\t\t\tworkDir := t.TempDir()\n192\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n193\t\t\t\t{\n194\t\t\t\t\tName:      \"no_such_file\",\n195\t\t\t\t\tArgs:      []string{\":\" + groupA.name, \"does_not_exist\"},\n196\t\t\t\t\tWorkDir:   workDir,\n197\t\t\t\t\tExitCode:  1,\n198\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n199\t\t\t\t},\n200\t\t\t})\n201\t\t})\n202\t\n203\t\tt.Run(\"partial_failure\", func(t *testing.T) {\n204\t\t\tworkDir := t.TempDir()\n205\t\t\tos.WriteFile(filepath.Join(workDir, \"good\"), []byte(\"x\"), 0o644)\n206\t\t\tsetGroup(t, filepath.Join(workDir, \"good\"), groupA.gid)\n207\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n208\t\t\t\t{\n209\t\t\t\t\tName:      \"one_good_one_bad\",\n210\t\t\t\t\tArgs:      []string{\":\" + groupB.name, \"good\", \"missing\"},\n211\t\t\t\t\tWorkDir:   workDir,\n212\t\t\t\t\tExitCode:  1,\n213\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName, normalizeErrorVerb},\n214\t\t\t\t},\n215\t\t\t})\n216\t\t\tverifyGroup(t, filepath.Join(workDir, \"good\"), groupB.gid)\n217\t\t})\n218\t}\n219\t\n220\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?chown\\b`)\n221\t\n222\tfunc normalizeBinaryName(b []byte) []byte {\n223\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"chown\"))\n224\t}\n225\t\n226\tvar errorVerbRe = regexp.MustCompile(\n227\t\t`(cannot access|changing ownership of)`,\n228\t)\n229\t\n230\tfunc normalizeErrorVerb(b []byte) []byte {\n231\t\tout := errorVerbRe.ReplaceAll(b, []byte(\"ERROR_VERB\"))\n232\t\tout = normalizeErrnoCase(out)\n233\t\treturn out\n234\t}\n235\t\n236\tvar errnoRe = regexp.MustCompile(`(?i)(no such file or directory|permission denied|operation not permitted)`)\n237\t\n238\tfunc normalizeErrnoCase(b []byte) []byte {\n239\t\treturn errnoRe.ReplaceAllFunc(b, func(m []byte) []byte {\n240\t\t\tlower := make([]byte, len(m))\n241\t\t\tfor i, c := range m {\n242\t\t\t\tif c >= 'A' && c <= 'Z' {\n243\t\t\t\t\tlower[i] = c + 32\n244\t\t\t\t} else {\n245\t\t\t\t\tlower[i] = c\n246\t\t\t\t}\n247\t\t\t}\n248\t\t\treturn lower\n249\t\t})\n250\t}\n251\t\n252\ttype groupInfo struct {\n253\t\tname string\n254\t\tgid  int\n255\t}\n256\t\n257\tfunc testGroups(t *testing.T) []groupInfo {\n258\t\tt.Helper()\n259\t\tcur, err := user.Current()\n260\t\tif err != nil {\n261\t\t\tt.Fatalf(\"user.Current: %v\", err)\n262\t\t}\n263\t\tgids, err := cur.GroupIds()\n264\t\tif err != nil {\n265\t\t\tt.Fatalf(\"GroupIds: %v\", err)\n266\t\t}\n267\t\tvar groups []groupInfo\n268\t\tfor _, gidStr := range gids {\n269\t\t\tgid, err := strconv.Atoi(gidStr)\n270\t\t\tif err != nil {\n271\t\t\t\tcontinue\n272\t\t\t}\n273\t\t\tg, err := user.LookupGroupId(gidStr)\n274\t\t\tif err != nil {\n275\t\t\t\tcontinue\n276\t\t\t}\n277\t\t\tgroups = append(groups, groupInfo{name: g.Name, gid: gid})\n278\t\t\tif len(groups) == 2 {\n279\t\t\t\tbreak\n280\t\t\t}\n281\t\t}\n282\t\treturn groups\n283\t}\n284\t\n285\tfunc setGroup(t *testing.T, path string, gid int) {\n286\t\tt.Helper()\n287\t\tif err := os.Lchown(path, -1, gid); err != nil {\n288\t\t\tt.Fatalf(\"setGroup(%s, %d): %v\", path, gid, err)\n289\t\t}\n290\t}\n291\t\n292\tfunc verifyGroup(t *testing.T, path string, expectedGID int) {\n293\t\tt.Helper()\n294\t\tinfo, err := os.Lstat(path)\n295\t\tif err != nil {\n296\t\t\tt.Fatalf(\"Lstat(%s): %v\", path, err)\n297\t\t}\n298\t\tstat, ok := info.Sys().(*syscall.Stat_t)\n299\t\tif !ok {\n300\t\t\tt.Fatal(\"Sys() is not *syscall.Stat_t\")\n301\t\t}\n302\t\tif int(stat.Gid) != expectedGID {\n303\t\t\tt.Errorf(\"group of %s: got %d, want %d\", path, stat.Gid, expectedGID)\n304\t\t}\n305\t}\n306\t\n307\tfunc TestHelp(t *testing.T) {\n308\t\tgoBin := testutils.BuildBinary(t, \".\")\n309\t\tcmd := exec.Command(goBin, \"--help\")\n310\t\tout, err := cmd.Output()\n311\t\tif err != nil {\n312\t\t\tt.Fatalf(\"--help failed: %v\", err)\n313\t\t}\n314\t\tif len(out) == 0 {\n315\t\t\tt.Fatal(\"--help produced no output\")\n316\t\t}\n317\t}\n318\t\n319\tfunc TestVersion(t *testing.T) {\n320\t\tgoBin := testutils.BuildBinary(t, \".\")\n321\t\tcmd := exec.Command(goBin, \"--version\")\n322\t\tout, err := cmd.Output()\n323\t\tif err != nil {\n324\t\t\tt.Fatalf(\"--version failed: %v\", err)\n325\t\t}\n326\t\tif len(out) == 0 {\n327\t\t\tt.Fatal(\"--version produced no output\")\n328\t\t}\n329\t}\n330\t\n331\tfunc TestReferenceNonexistent(t *testing.T) {\n332\t\tgoBin := testutils.BuildBinary(t, \".\")\n333\t\tcmd := exec.Command(goBin, \"--reference=/tmp/no_such_ref_file_xyz\", \"somefile\")\n334\t\tcmd.Dir = t.TempDir()\n335\t\tout, err := cmd.CombinedOutput()\n336\t\tif err == nil {\n337\t\t\tt.Fatal(\"expected error for nonexistent reference file\")\n338\t\t}\n339\t\t_ = out\n340\t\texitCode :