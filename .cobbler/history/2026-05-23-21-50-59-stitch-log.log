Level bool) bool {\n\tswitch opts.symlink {\n\tcase symlinkL:\n\t\treturn true\n\tcase symlinkH:\n\t\treturn isTopLevel\n\tdefault:\n\t\treturn false\n\t}\n}\n\nfunc statPath(path string, follow bool) (os.FileInfo, error) {\n\tif follow {\n\t\treturn os.Stat(path)\n\t}\n\treturn os.Lstat(path)\n}\n\nfunc walkChildren(opts options, uid, gid int, dir string) error {\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treportError(err)\n\t\treturn err\n\t}\n\tvar firstErr error\n\tfor _, e := range entries {\n\t\tchild := filepath.Join(dir, e.Name())\n\t\tif err := chownRecursive(opts, uid, gid, child, false); err != nil && firstErr == nil {\n\t\t\tfirstErr = err\n\t\t}\n\t}\n\treturn firstErr\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":377,"cache_read_input_tokens":34424,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":377},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"80e6db11-f061-4f27-a12d-9bbe460fdae4","uuid":"5f1ac3e3-1e7d-4e5e-896a-c9e9e3932d0b"}
