{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0132LX14xBTWZWkyLNhmn7vN","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/chgrp implements srd090-chgrp R1.1-R1.4, R2.1-R2.3, R3.1-R3.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tconst helpText = `Usage: chgrp [OPTION]... GROUP FILE...\n20\t  or:  chgrp [OPTION]... --reference=RFILE FILE...\n21\tChange the group of each FILE to GROUP.\n22\t\n23\t  -c, --changes          like verbose but report only when a change is made\n24\t  -f, --silent, --quiet  suppress most error messages\n25\t  -v, --verbose          output a diagnostic for every file processed\n26\t      --dereference      affect the referent of each symbolic link (this is\n27\t                         the default), rather than the symbolic link itself\n28\t  -h, --no-dereference   affect symbolic links instead of any referenced file\n29\t      --no-preserve-root  do not treat '/' specially (the default)\n30\t      --preserve-root    fail to operate recursively on '/'\n31\t      --reference=RFILE  use RFILE's group rather than specifying a GROUP value\n32\t  -R, --recursive        operate on files and directories recursively\n33\t  -H                     if a command line argument is a symbolic link\n34\t                         to a directory, traverse it\n35\t  -L                     traverse every symbolic link to a directory\n36\t                         encountered\n37\t  -P                     do not traverse any symbolic links (default)\n38\t      --help     display this help and exit\n39\t      --version  output version information and exit\n40\t\n41\tExamples:\n42\t  chgrp staff /u      Change the group of /u to \"staff\".\n43\t  chgrp -hR staff /u  Change the group of /u and subfiles to \"staff\".\n44\t`\n45\t\n46\tconst versionText = `chgrp (go-unix-utils) dev\n47\t`\n48\t\n49\ttype symlinkMode int\n50\t\n51\tconst (\n52\t\tsymlinkP symlinkMode = iota\n53\t\tsymlinkH\n54\t\tsymlinkL\n55\t)\n56\t\n57\ttype options struct {\n58\t\tverbose       bool\n59\t\tchanges       bool\n60\t\tsilent        bool\n61\t\treference     string\n62\t\trecursive     bool\n63\t\tnoDereference bool\n64\t\tsymlink       symlinkMode\n65\t}\n66\t\n67\tfunc main() {\n68\t\tsys.InstallSIGPIPEHandler()\n69\t\n70\t\topts, group, files := parseArgs(os.Args[1:])\n71\t\tgid := resolveGID(opts, group)\n72\t\tgroupLabel := group\n73\t\tif opts.reference != \"\" {\n74\t\t\tgroupLabel = gidToName(gid)\n75\t\t}\n76\t\tif len(files) == 0 {\n77\t\t\tif opts.reference != \"\" {\n78\t\t\t\tfmt.Fprintln(os.Stderr, \"chgrp: missing operand\")\n79\t\t\t} else {\n80\t\t\t\tfmt.Fprintf(os.Stderr, \"chgrp: missing operand after '%s'\\n\", group)\n81\t\t\t}\n82\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chgrp --help' for more information.\")\n83\t\t\tos.Exit(1)\n84\t\t}\n85\t\n86\t\texitCode := 0\n87\t\tfor _, file := range files {\n88\t\t\tif err := changeGroup(opts, gid, groupLabel, file); err != nil {\n89\t\t\t\texitCode = 1\n90\t\t\t}\n91\t\t}\n92\t\tif exitCode != 0 {\n93\t\t\tos.Exit(exitCode)\n94\t\t}\n95\t}\n96\t\n97\tfunc resolveGID(opts options, group string) int {\n98\t\tif opts.reference != \"\" {\n99\t\t\treturn resolveReference(opts.reference)\n100\t\t}\n101\t\treturn lookupGroup(group)\n102\t}\n103\t\n104\tfunc lookupGroup(group string) int {\n105\t\tif gid, err := strconv.Atoi(group); err == nil {\n106\t\t\treturn gid\n107\t\t}\n108\t\tg, err := user.LookupGroup(group)\n109\t\tif err != nil {\n110\t\t\tfmt.Fprintf(os.Stderr, \"chgrp: invalid group: '%s'\\n\", group)\n111\t\t\tos.Exit(1)\n112\t\t}\n113\t\tgid, err := strconv.Atoi(g.Gid)\n114\t\tif err != nil {\n115\t\t\tfmt.Fprintf(os.Stderr, \"chgrp: invalid group: '%s'\\n\", group)\n116\t\t\tos.Exit(1)\n117\t\t}\n118\t\treturn gid\n119\t}\n120\t\n121\tfunc gidToName(gid int) string {\n122\t\tg, err := user.LookupGroupId(strconv.Itoa(gid))\n123\t\tif err != nil {\n124\t\t\treturn strconv.Itoa(gid)\n125\t\t}\n126\t\treturn g.Name\n127\t}\n128\t\n129\tfunc resolveReference(rfile string) int {\n130\t\tfi, err := sys.Stat(rfile)\n131\t\tif err != nil {\n132\t\t\tfmt.Fprintf(os.Stderr, \"chgrp: failed to get attributes of '%s': %s\\n\",\n133\t\t\t\trfile, err.(*os.PathError).Err)\n134\t\t\tos.Exit(1)\n135\t\t}\n136\t\treturn int(fi.Gid)\n137\t}\n138\t\n139\tfunc changeGroup(opts options, gid int, groupLabel, path string) error {\n140\t\tif !opts.recursive {\n141\t\t\treturn chownSingle(opts, gid, groupLabel, path)\n142\t\t}\n143\t\treturn chownRecursive(opts, gid, groupLabel, path, true)\n144\t}\n145\t\n146\tfunc chownSingle(opts options, gid int, groupLabel, path string) error {\n147\t\tfn := os.Chown\n148\t\tstatFn := sys.Stat\n149\t\tif opts.noDereference {\n150\t\t\tfn = os.Lchown\n151\t\t\tstatFn = sys.Lstat\n152\t\t}\n153\t\toldGID := -1\n154\t\tif opts.verbose || opts.changes {\n155\t\t\tif fi, err := statFn(path); err == nil {\n156\t\t\t\toldGID = int(fi.Gid)\n157\t\t\t}\n158\t\t}\n159\t\tif err := fn(path, -1, gid); err != nil {\n160\t\t\treportError(opts, err)\n161\t\t\tprintDiagnostic(opts, path, oldGID, gid, groupLabel)\n162\t\t\treturn err\n163\t\t}\n164\t\tprintDiagnostic(opts, path, oldGID, gid, groupLabel)\n165\t\treturn nil\n166\t}\n167\t\n168\tfunc chownRecursive(opts options, gid int, groupLabel, path string, isTopLevel bool) error {\n169\t\tfollow := shouldFollowLink(opts, isTopLevel)\n170\t\tfi, err := statPath(path, follow)\n171\t\tif err != nil {\n172\t\t\treportError(opts, err)\n173\t\t\tprintDiagnostic(opts, path, -1, gid, groupLabel)\n174\t\t\treturn err\n175\t\t}\n176\t\tvar firstErr error\n177\t\tif fi.IsDir() {\n178\t\t\tfirstErr = walkChildren(opts, gid, groupLabel, path)\n179\t\t}\n180\t\tif err := applyChown(opts, gid, groupLabel, path); err != nil && firstErr == nil {\n181\t\t\tfirstErr = err\n182\t\t}\n183\t\treturn firstErr\n184\t}\n185\t\n186\tfunc applyChown(opts options, gid int, groupLabel, path string) error {\n187\t\tfn := os.Lchown\n188\t\tstatFn := sys.Lstat\n189\t\tif opts.symlink == symlinkL {\n190\t\t\tfn = os.Chown\n191\t\t\tstatFn = sys.Stat\n192\t\t}\n193\t\toldGID := -1\n194\t\tif opts.verbose || opts.changes {\n195\t\t\tif fi, err := statFn(path); err == nil {\n196\t\t\t\toldGID = int(fi.Gid)\n197\t\t\t}\n198\t\t}\n199\t\tif err := fn(path, -1, gid); err != nil {\n200\t\t\treportError(opts, err)\n201\t\t\tprintDiagnostic(opts, path, oldGID, gid, groupLabel)\n202\t\t\treturn err\n203\t\t}\n204\t\tprintDiagnostic(opts, path, oldGID, gid, groupLabel)\n205\t\treturn nil\n206\t}\n207\t\n208\tfunc shouldFollowLink(opts options, isTopLevel bool) bool {\n209\t\tswitch opts.symlink {\n210\t\tcase symlinkL:\n211\t\t\treturn true\n212\t\tcase symlinkH:\n213\t\t\treturn isTopLevel\n214\t\tdefault:\n215\t\t\treturn false\n216\t\t}\n217\t}\n218\t\n219\tfunc statPath(path string, follow bool) (os.FileInfo, error) {\n220\t\tif follow {\n221\t\t\treturn os.Stat(path)\n222\t\t}\n223\t\treturn os.Lstat(path)\n224\t}\n225\t\n226\tfunc walkChildren(opts options, gid int, groupLabel, dir string) error {\n227\t\tentries, err := os.ReadDir(dir)\n228\t\tif err != nil {\n229\t\t\treportError(opts, err)\n230\t\t\treturn err\n231\t\t}\n232\t\tvar firstErr error\n233\t\tfor _, e := range entries {\n234\t\t\tchild := filepath.Join(dir, e.Name())\n235\t\t\tif err := chownRecursive(opts, gid, groupLabel, child, false); err != nil && firstErr == nil {\n236\t\t\t\tfirstErr = err\n237\t\t\t}\n238\t\t}\n239\t\treturn firstErr\n240\t}\n241\t\n242\tfunc printDiagnostic(opts options, path string, oldGID, newGID int, groupLabel string) {\n243\t\tif !opts.verbose && !opts.changes {\n244\t\t\treturn\n245\t\t}\n246\t\tif oldGID < 0 {\n247\t\t\tif opts.verbose {\n248\t\t\t\tfmt.Fprintf(os.Stdout, \"failed to change group of '%s' to %s\\n\", path, groupLabel)\n249\t\t\t}\n250\t\t\treturn\n251\t\t}\n252\t\tif oldGID == newGID {\n253\t\t\tif opts.verbose {\n254\t\t\t\tfmt.Fprintf(os.Stdout, \"group of '%s' retained as %s\\n\", path, gidToName(newGID))\n255\t\t\t}\n256\t\t\treturn\n257\t\t}\n258\t\tfmt.Fprintf(os.Stdout, \"changed group of '%s' from %s to %s\\n\",\n259\t\t\tpath, gidToName(oldGID), groupLabel)\n260\t}\n261\t\n262\tfunc reportError(opts options, err error) {\n263\t\tif opts.silent {\n264\t\t\treturn\n265\t\t}\n266\t\tfmt.Fprintf(os.Stderr, \"chgrp: %s\\n\", formatErr(err))\n267\t}\n268\t\n269\tfunc formatErr(err error) string {\n270\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n271\t\t\treturn fmt.Sprintf(\"changing group of '%s': %s\", pe.Path, pe.Err)\n272\t\t}\n273\t\treturn err.Error()\n274\t}\n275\t\n276\tfunc parseArgs(args []string) (options, string, []string) {\n277\t\tvar opts options\n278\t\tvar files []string\n279\t\tgroup := \"\"\n280\t\tendOfFlags := false\n281\t\tfor _, arg := range args {\n282\t\t\tif endOfFlags {\n283\t\t\t\tfiles = append(files, arg)\n284\t\t\t\tcontinue\n285\t\t\t}\n286\t\t\tif handled := handleSpecialArg(arg, &endOfFlags); handled {\n287\t\t\t\tcontinue\n288\t\t\t}\n289\t\t\tif parseLongFlag(arg, &opts) {\n290\t\t\t\tcontinue\n291\t\t\t}\n292\t\t\tif group == \"\" {\n293\t\t\t\tif strings.HasPrefix(arg, \"-\") && parseShortFlags(arg[1:], &opts) {\n294\t\t\t\t\tcontinue\n295\t\t\t\t}\n296\t\t\t\tif opts.reference != \"\" {\n297\t\t\t\t\tfiles = append(files, arg)\n298\t\t\t\t} else {\n299\t\t\t\t\tgroup = arg\n300\t\t\t\t}\n301\t\t\t} else {\n302\t\t\t\tfiles = append(files, arg)\n303\t\t\t}\n304\t\t}\n305\t\tif group == \"\" && opts.reference == \"\" {\n306\t\t\tfmt.Fprintln(os.Stderr, \"chgrp: missing operand\")\n307\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chgrp --help' for more information.\")\n308\t\t\tos.Exit(1)\n309\t\t}\n310\t\treturn opts, group, files\n311\t}\n312\t\n313\tfunc handleSpecialArg(arg string, endOfFlags *bool) bool {\n314\t\tswitch arg {\n315\t\tcase \"--help\":\n316\t\t\tfmt.Fprint(os.Stdout, helpText)\n317\t\t\tos.Exit(0)\n318\t\tcase \"--version\":\n319\t\t\tfmt.Fprint(os.Stdout, versionText)\n320\t\t\tos.Exit(0)\n321\t\tcase \"--\":\n322\t\t\t*endOfFlags = true\n323\t\tdefault:\n324\t\t\treturn false\n325\t\t}\n326\t\treturn true\n327\t}\n328\t\n329\tfunc parseLongFlag(arg string, opts *options) bool {\n330\t\tswitch arg {\n331\t\tcase \"--verbose\":\n332\t\t\topts.verbose = true\n333\t\tcase \"--changes\":\n334\t\t\topts.changes = true\n335\t\tcase \"--silent\", \"--quiet\":\n336\t\t\topts.silent = true\n337\t\tcase \"--recursive\":\n338\t\t\topts.recursive = true\n339\t\tcase \"--dereference\":\n340\t\t\topts.noDereference = false\n341\t\tcase \"--no-dereference\":\n342\t\t\topts.noDereference = true\n343\t\tcase \"--preserve-root\", \"--no-preserve-root\":\n344\t\tdefault:\n345\t\t\tif strings.HasPrefix(arg, \"--reference=\") {\n346\t\t\t\topts.reference = arg[len(\"--reference=\"):]\n347\t\t\t\treturn true\n348\t\t\t}\n349\t\t\treturn false\n350\t\t}\n351\t\treturn true\n352\t}\n353\t\n354\tfunc parseShortFlags(flags string, opts *options) bool {\n355\t\tfor _, c := range flags {\n356\t\t\tswitch c {\n357\t\t\tcase 'v':\n358\t\t\t\topts.verbose = true\n359\t\t\tcase 'c':\n360\t\t\t\topts.changes = true\n361\t\t\tcase 'f':\n362\t\t\t\topts.silent = true\n363\t\t\tcase 'R':\n364\t\t\t\topts.recursive = true\n365\t\t\tcase 'h':\n366\t\t\t\topts.noDereference = true\n367\t\t\tcase 'H':\n368\t\t\t\topts.symlink = symlinkH\n369\t\t\tcase 'L':\n370\t\t\t\topts.symlink = symlinkL\n371\t\t\tcase 'P':\n372\t\t\t\topts.symlink = symlinkP\n373\t\t\tdefault:\n374\t\t\t\treturn false\n375\t\t\t}\n376\t\t}\n377\t\treturn true\n378\t}\n379\t"}]},"parent_tool_use_id":null,"session_id":"80e6db11-f061-4f27-a12d-9bbe460fdae4","uuid":"bbb895db-4d71-4a2c-a04e-79bc768aa74f","timestamp":"2026-05-24T01:52:23.324Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5557/cmd/chgrp/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/chgrp implements srd090-chgrp R1.1-R1.4, R2.1-R2.3, R3.1-R3.3.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/user\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: chgrp [OPTION]... GROUP FILE...\n  or:  chgrp [OPTION]... --reference=RFILE FILE...\nChange the group of each FILE to GROUP.\n\n  -c, --changes          like verbose but report only when a change is made\n  -f, --silent, --quiet  suppress most error messages\n  -v, --verbose          output a diagnostic for every file processed\n      --dereference      affect the referent of each symbolic link (this is\n                         the default), rather than the symbolic link itself\n  -h, --no-dereference   affect symbolic links instead of any referenced file\n      --no-preserve-root  do not treat '/' specially (the default)\n      --preserve-root    fail to operate recursively on '/'\n      --reference=RFILE  use RFILE's group rather than specifying a GROUP value\n  -R, --recursive        operate on files and directories recursively\n  -H                     if a command line argument is a symbolic link\n                         to a directory, traverse it\n  -L                     traverse every symbolic link to a directory\n                         encountered\n  -P                     do not traverse any symbolic links (default)\n      --help     display this help and exit\n      --version  output version information and exit\n\nExamples:\n  chgrp staff /u      Change the group of /u to \"staff\".\n  chgrp -hR staff /u  Change the group of /u and subfiles to \"staff\".\n`\n\nconst versionText = `chgrp (go-unix-utils) dev\n`\n\ntype symlinkMode int\n\nconst (\n\tsymlinkP symlinkMode = iota\n\tsymlinkH\n\tsymlinkL\n)\n\ntype options struct {\n\tverbose       bool\n\tchanges       bool\n\tsilent        bool\n\treference     string\n\trecursive     bool\n\tnoDereference bool\n\tsymlink       symlinkMode\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, group, files := parseArgs(os.Args[1:])\n\tgid := resolveGID(opts, group)\n\tgroupLabel := group\n\tif opts.reference != \"\" {\n\t\tgroupLabel = gidToName(gid)\n\t}\n\tif len(files) == 0 {\n\t\tif opts.reference != \"\" {\n\t\t\tfmt.Fprintln(os.Stderr, \"chgrp: missing operand\")\n\t\t} else {\n\t\t\tfmt.Fprintf(os.Stderr, \"chgrp: missing operand after '%s'\\n\", group)\n\t\t}\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chgrp --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\n\texitCode := 0\n\tfor _, file := range files {\n\t\tif err := changeGroup(opts, gid, groupLabel, file); err != nil {\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc resolveGID(opts options, group string) int {\n\tif opts.reference != \"\" {\n\t\treturn resolveReference(opts.reference)\n\t}\n\treturn lookupGroup(group)\n}\n\nfunc lookupGroup(group string) int {\n\tif gid, err := strconv.Atoi(group); err == nil {\n\t\treturn gid\n\t}\n\tg, err := user.LookupGroup(group)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"chgrp: invalid group: '%s'\\n\", group)\n\t\tos.Exit(1)\n\t}\n\tgid, err := strconv.Atoi(g.Gid)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"chgrp: invalid group: '%s'\\n\", group)\n\t\tos.Exit(1)\n\t}\n\treturn gid\n}\n\nfunc gidToName(gid int) string {\n\tg, err := user.LookupGroupId(strconv.Itoa(gid))\n\tif err != nil {\n\t\treturn strconv.Itoa(gid)\n\t}\n\treturn g.Name\n}\n\nfunc resolveReference(rfile string) int {\n\tfi, err := sys.Stat(rfile)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"chgrp: failed to get attributes of '%s': %s\\n\",\n\t\t\trfile, err.(*os.PathError).Err)\n\t\tos.Exit(1)\n\t}\n\treturn int(fi.Gid)\n}\n\nfunc changeGroup(opts options, gid int, groupLabel, path string) error {\n\tif !opts.recursive {\n\t\treturn chownSingle(opts, gid, groupLabel, path)\n\t}\n\treturn chownRecursive(opts, gid, groupLabel, path, true)\n}\n\nfunc chownSingle(opts options, gid int, groupLabel, path string) error {\n\tfn := os.Chown\n\tstatFn := sys.Stat\n\tif opts.noDereference {\n\t\tfn = os.Lchown\n\t\tstatFn = sys.Lstat\n\t}\n\toldGID := -1\n\tif opts.verbose || opts.changes {\n\t\tif fi, err := statFn(path); err == nil {\n\t\t\toldGID = int(fi.Gid)\n\t\t}\n\t}\n\tif err := fn(path, -1, gid); err != nil {\n\t\treportError(opts, err)\n\t\tprintDiagnostic(opts, path, oldGID, gid, groupLabel)\n\t\treturn err\n\t}\n\tprintDiagnostic(opts, path, oldGID, gid, groupLabel)\n\treturn nil\n}\n\nfunc chownRecursive(opts options, gid int, groupLabel, path string, isTopLevel bool) error {\n\tfollow := shouldFollowLink(opts, isTopLevel)\n\tfi, err := statPath(path, follow)\n\tif err != nil {\n\t\treportError(opts, err)\n\t\tprintDiagnostic(opts, path, -1, gid, groupLabel)\n\t\treturn err\n\t}\n\tvar firstErr error\n\tif fi.IsDir() {\n\t\tfirstErr = walkChildren(opts, gid, groupLabel, path)\n\t}\n\tif err := applyChown(opts, gid, groupLabel, path); err != nil && firstErr == nil {\n\t\tfirstErr = err\n\t}\n\treturn firstErr\n}\n\nfunc applyChown(opts options, gid int, groupLabel, path string) error {\n\tfn := os.Lchown\n\tstatFn := sys.Lstat\n\tif opts.symlink == symlinkL {\n\t\tfn = os.Chown\n\t\tstatFn = sys.Stat\n\t}\n\toldGID := -1\n\tif opts.verbose || opts.changes {\n\t\tif fi, err := statFn(path); err == nil {\n\t\t\toldGID = int(fi.Gid)\n\t\t}\n\t}\n\tif err := fn(path, -1, gid); err != nil {\n\t\treportError(opts, err)\n\t\tprintDiagnostic(opts, path, oldGID, gid, groupLabel)\n\t\treturn err\n\t}\n\tprintDiagnostic(opts, path, oldGID, gid, groupLabel)\n\treturn nil\n}\n\nfunc shouldFollowLink(opts options, isTopLevel bool) bool {\n\tswitch opts.symlink {\n\tcase symlinkL:\n\t\treturn true\n\tcase symlinkH:\n\t\treturn isTopLevel\n\tdefault:\n\t\treturn false\n\t}\n}\n\nfunc statPath(path string, follow bool) (os.FileInfo, error) {\n\tif follow {\n\t\treturn os.Stat(path)\n\t}\n\treturn os.Lstat(path)\n}\n\nfunc walkChildren(opts options, gid int, groupLabel, dir string) error {\n\tentries, err := os.ReadDir(dir)\n\tif err != nil {\n\t\treportError(opts, err)\n\t\treturn err\n\t}\n\tvar firstErr error\n\tfor _, e := range entries {\n\t\tchild := filepath.Join(dir, e.Name())\n\t\tif err := chownRecursive(opts, gid, groupLabel, child, false); err != nil && firstErr == nil {\n\t\t\tfirstErr = err\n\t\t}\n\t}\n\treturn firstErr\n}\n\nfunc printDiagnostic(opts options, path string, oldGID, newGID int, groupLabel string) {\n\tif !opts.verbose && !opts.changes {\n\t\treturn\n\t}\n\tif oldGID < 0 {\n\t\tif opts.verbose {\n\t\t\tfmt.Fprintf(os.Stdout, \"failed to change group of '%s' to %s\\n\", path, groupLabel)\n\t\t}\n\t\treturn\n\t}\n\tif oldGID == newGID {\n\t\tif opts.verbose {\n\t\t\tfmt.Fprintf(os.Stdout, \"group of '%s' retained as %s\\n\", path, gidToName(newGID))\n\t\t}\n\t\treturn\n\t}\n\tfmt.Fprintf(os.Stdout, \"changed group of '%s' from %s to %s\\n\",\n\t\tpath, gidToName(oldGID), groupLabel)\n}\n\nfunc reportError(opts options, err error) {\n\tif opts.silent {\n\t\treturn\n\t}\n\tfmt.Fprintf(os.Stderr, \"chgrp: %s\\n\", formatErr(err))\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"changing group of '%s': %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n\nfunc parseArgs(args []string) (options, string, []string) {\n\tvar opts options\n\tvar files []string\n\tgroup := \"\"\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif handled := handleSpecialArg(arg, &endOfFlags); handled {\n\t\t\tcontinue\n\t\t}\n\t\tif parseLongFlag(arg, &opts) {\n\t\t\tcontinue\n\t\t}\n\t\tif group == \"\" {\n\t\t\tif strings.HasPrefix(arg, \"-\") && parseShortFlags(arg[1:], &opts) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif opts.reference != \"\" {\n\t\t\t\tfiles = append(files, arg)\n\t\t\t} else {\n\t\t\t\tgroup = arg\n\t\t\t}\n\t\t} else {\n\t\t\tfiles = append(files, arg)\n\t\t}\n\t}\n\tif group == \"\" && opts.reference == \"\" {\n\t\tfmt.Fprintln(os.Stderr, \"chgrp: missing operand\")\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chgrp --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\treturn opts, group, files\n}\n\nfunc handleSpecialArg(arg string, endOfFlags *bool) bool {\n\tswitch arg {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase \"--\":\n\t\t*endOfFlags = true\n\tdefault:\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc parseLongFlag(arg string, opts *options) bool {\n\tswitch arg {\n\tcase \"--verbose\":\n\t\topts.verbose = true\n\tcase \"--changes\":\n\t\topts.changes = true\n\tcase \"--silent\", \"--quiet\":\n\t\topts.silent = true\n\tcase \"--recursive\":\n\t\topts.recursive = true\n\tcase \"--dereference\":\n\t\topts.noDereference = false\n\tcase \"--no-dereference\":\n\t\topts.noDereference = true\n\tcase \"--preserve-root\", \"--no-preserve-root\":\n\tdefault:\n\t\tif strings.HasPrefix(arg, \"--reference=\") {\n\t\t\topts.reference = arg[len(\"--reference=\"):]\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc parseShortFlags(flags string, opts *options) bool {\n\tfor _, c := range flags {\n\t\tswitch c {\n\t\tcase 'v':\n\t\t\topts.verbose = true\n\t\tcase 'c':\n\t\t\topts.changes = true\n\t\tcase 'f':\n\t\t\topts.silent = true\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tcase 'h':\n\t\t\topts.noDereference = true\n\t\tcase 'H':\n\t\t\topts.symlink = symlinkH\n\t\tcase 'L':\n\t\t\topts.symlink = symlinkL\n\t\tcase 'P':\n\t\t\topts.symlink = symlinkP\n\t\tdefault:\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n","numLines":379,"startLine":1,"totalLines":379}}}
