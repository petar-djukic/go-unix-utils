n57\t\t\t},\n58\t\t\t{\n59\t\t\t\tName:    \"r4_1_exit_zero_no_args_passthrough\",\n60\t\t\t\tStdin:   []byte(\"line1\\nline2\\n\"),\n61\t\t\t},\n62\t\t\t{\n63\t\t\t\tName:      \"r4_2_nonexistent_file\",\n64\t\t\t\tArgs:      []string{\"nonexistent.txt\"},\n65\t\t\t\tWorkDir:   dir,\n66\t\t\t\tExitCode:  1,\n67\t\t\t\tNormalize: errNorm,\n68\t\t\t},\n69\t\t\t{\n70\t\t\t\tName:      \"r4_2_nonexistent_among_valid\",\n71\t\t\t\tArgs:      []string{\"a.txt\", \"nonexistent.txt\"},\n72\t\t\t\tWorkDir:   dir,\n73\t\t\t\tExitCode:  1,\n74\t\t\t\tNormalize: errNorm,\n75\t\t\t},\n76\t\t\t{\n77\t\t\t\tName:      \"r4_2_serial_nonexistent\",\n78\t\t\t\tArgs:      []string{\"-s\", \"nonexistent.txt\"},\n79\t\t\t\tWorkDir:   dir,\n80\t\t\t\tExitCode:  1,\n81\t\t\t\tNormalize: errNorm,\n82\t\t\t},\n83\t\t\t{\n84\t\t\t\tName:    \"r4_4_normal_with_sigpipe_handler\",\n85\t\t\t\tArgs:    []string{\"a.txt\"},\n86\t\t\t\tWorkDir: dir,\n87\t\t\t},\n88\t\t\t{\n89\t\t\t\tName:    \"parallel_unequal_lengths\",\n90\t\t\t\tArgs:    []string{\"short.txt\", \"long.txt\"},\n91\t\t\t\tWorkDir: dir,\n92\t\t\t},\n93\t\t\t{\n94\t\t\t\tName:    \"parallel_custom_delim\",\n95\t\t\t\tArgs:    []string{\"-d:\", \"a.txt\", \"nums.txt\"},\n96\t\t\t\tWorkDir: dir,\n97\t\t\t},\n98\t\t\t{\n99\t\t\t\tName:    \"serial_two_files\",\n100\t\t\t\tArgs:    []string{\"-s\", \"a.txt\", \"nums.txt\"},\n101\t\t\t\tWorkDir: dir,\n102\t\t\t},\n103\t\t\t{\n104\t\t\t\tName:  \"serial_stdin\",\n105\t\t\t\tArgs:  []string{\"-s\", \"-\"},\n106\t\t\t\tStdin: []byte(\"x\\ny\\nz\\n\"),\n107\t\t\t},\n108\t\t}\n109\t\n110\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n111\t}\n112\t\n113\tfunc writeFile(t *testing.T, dir, name, content string) {\n114\t\tt.Helper()\n115\t\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0644); err != nil {\n116\t\t\tt.Fatal(err)\n117\t\t}\n118\t}\n119\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and 