{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NRUeybRWvuaLAYcizs98kG","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/tr implements srd054-tr: translate or delete characters.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype config struct {\n19\t\tdelete     bool\n20\t\tsqueeze    bool\n21\t\tcomplement bool\n22\t\toperands   []string\n23\t}\n24\t\n25\tfunc main() {\n26\t\tsys.InstallSIGPIPEHandler()\n27\t\n28\t\tcfg, err := parseArgs(os.Args[1:])\n29\t\tif err != nil {\n30\t\t\tfmt.Fprintf(os.Stderr, \"tr: %s\\n\", err)\n31\t\t\tos.Exit(1)\n32\t\t}\n33\t\tif err := run(cfg); err != nil {\n34\t\t\tfmt.Fprintf(os.Stderr, \"tr: %s\\n\", err)\n35\t\t\tos.Exit(1)\n36\t\t}\n37\t}\n38\t\n39\tfunc parseArgs(args []string) (config, error) {\n40\t\tvar cfg config\n41\t\tendOfFlags := false\n42\t\tfor _, arg := range args {\n43\t\t\tif endOfFlags || arg == \"-\" {\n44\t\t\t\tcfg.operands = append(cfg.operands, arg)\n45\t\t\t\tcontinue\n46\t\t\t}\n47\t\t\tif arg == \"--\" {\n48\t\t\t\tendOfFlags = true\n49\t\t\t\tcontinue\n50\t\t\t}\n51\t\t\tif arg == \"--delete\" {\n52\t\t\t\tcfg.delete = true\n53\t\t\t\tcontinue\n54\t\t\t}\n55\t\t\tif arg == \"--squeeze-repeats\" {\n56\t\t\t\tcfg.squeeze = true\n57\t\t\t\tcontinue\n58\t\t\t}\n59\t\t\tif arg == \"--complement\" {\n60\t\t\t\tcfg.complement = true\n61\t\t\t\tcontinue\n62\t\t\t}\n63\t\t\tif len(arg) > 1 && arg[0] == '-' {\n64\t\t\t\tif arg[1] == '-' {\n65\t\t\t\t\treturn cfg, fmt.Errorf(\"unrecognized option '%s'\", arg)\n66\t\t\t\t}\n67\t\t\t\tif err := parseShortFlags(&cfg, arg[1:]); err != nil {\n68\t\t\t\t\treturn cfg, err\n69\t\t\t\t}\n70\t\t\t\tcontinue\n71\t\t\t}\n72\t\t\tcfg.operands = append(cfg.operands, arg)\n73\t\t}\n74\t\treturn cfg, nil\n75\t}\n76\t\n77\tfunc parseShortFlags(cfg *config, flags string) error {\n78\t\tfor _, c := range flags {\n79\t\t\tswitch c {\n80\t\t\tcase 'd':\n81\t\t\t\tcfg.delete = true\n82\t\t\tcase 's':\n83\t\t\t\tcfg.squeeze = true\n84\t\t\tcase 'c', 'C':\n85\t\t\t\tcfg.complement = true\n86\t\t\tdefault:\n87\t\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", c)\n88\t\t\t}\n89\t\t}\n90\t\treturn nil\n91\t}\n92\t\n93\tfunc validateOperands(cfg config) error {\n94\t\tn := len(cfg.operands)\n95\t\tif n == 0 {\n96\t\t\treturn fmt.Errorf(\"missing operand\")\n97\t\t}\n98\t\tif cfg.delete && !cfg.squeeze {\n99\t\t\tif n > 1 {\n100\t\t\t\treturn fmt.Errorf(\"extra operand '%s'\", cfg.operands[1])\n101\t\t\t}\n102\t\t\treturn nil\n103\t\t}\n104\t\tif cfg.squeeze && !cfg.delete && n == 1 {\n105\t\t\treturn nil\n106\t\t}\n107\t\tif n < 2 {\n108\t\t\treturn fmt.Errorf(\"missing operand after '%s'\", cfg.operands[0])\n109\t\t}\n110\t\treturn nil\n111\t}\n112\t\n113\tfunc run(cfg config) error {\n114\t\tif err := validateOperands(cfg); err != nil {\n115\t\t\treturn err\n116\t\t}\n117\t\tset1, err := expandSet(cfg.operands[0])\n118\t\tif err != nil {\n119\t\t\treturn err\n120\t\t}\n121\t\tif cfg.complement {\n122\t\t\tset1 = complementSet(set1)\n123\t\t}\n124\t\tset1Members := memberSet(set1)\n125\t\tif cfg.delete {\n126\t\t\tif !cfg.squeeze {\n127\t\t\t\treturn process(nil, &set1Members, nil)\n128\t\t\t}\n129\t\t\tset2, err := expandSet(cfg.operands[1])\n130\t\t\tif err != nil {\n131\t\t\t\treturn err\n132\t\t\t}\n133\t\t\tsqSet := memberSet(set2)\n134\t\t\treturn process(nil, &set1Members, &sqSet)\n135\t\t}\n136\t\tif cfg.squeeze && len(cfg.operands) == 1 {\n137\t\t\treturn process(nil, nil, &set1Members)\n138\t\t}\n139\t\tset2, err := expandSet(cfg.operands[1])\n140\t\tif err != nil {\n141\t\t\treturn err\n142\t\t}\n143\t\tif len(set2) == 0 {\n144\t\t\treturn fmt.Errorf(\"when not truncating set1, string2 must be non-empty\")\n145\t\t}\n146\t\ttable := buildTable(set1, set2)\n147\t\tif cfg.squeeze {\n148\t\t\tsqSet := memberSet(set2)\n149\t\t\treturn process(&table, nil, &sqSet)\n150\t\t}\n151\t\treturn process(&table, nil, nil)\n152\t}\n153\t\n154\tfunc complementSet(set []byte) []byte {\n155\t\tvar present [256]bool\n156\t\tfor _, b := range set {\n157\t\t\tpresent[b] = true\n158\t\t}\n159\t\tvar result []byte\n160\t\tfor i := range 256 {\n161\t\t\tif !present[byte(i)] {\n162\t\t\t\tresult = append(result, byte(i))\n163\t\t\t}\n164\t\t}\n165\t\treturn result\n166\t}\n167\t\n168\tfunc memberSet(set []byte) [256]bool {\n169\t\tvar m [256]bool\n170\t\tfor _, b := range set {\n171\t\t\tm[b] = true\n172\t\t}\n173\t\treturn m\n174\t}\n175\t\n176\tfunc buildTable(set1, set2 []byte) [256]byte {\n177\t\tvar table [256]byte\n178\t\tfor i := range table {\n179\t\t\ttable[i] = byte(i)\n180\t\t}\n181\t\tfor i, b := range set1 {\n182\t\t\tif i < len(set2) {\n183\t\t\t\ttable[b] = set2[i]\n184\t\t\t} else {\n185\t\t\t\ttable[b] = set2[len(set2)-1]\n186\t\t\t}\n187\t\t}\n188\t\treturn table\n189\t}\n190\t\n191\tfunc process(table *[256]byte, deleteSet, squeezeSet *[256]bool) error {\n192\t\tr := bufio.NewReader(os.Stdin)\n193\t\tw := bufio.NewWriter(os.Stdout)\n194\t\tprev := -1\n195\t\tbuf := make([]byte, 32*1024)\n196\t\tfor {\n197\t\t\tn, err := r.Read(buf)\n198\t\t\tfor i := range n {\n199\t\t\t\tb := buf[i]\n200\t\t\t\tif deleteSet != nil && deleteSet[b] {\n201\t\t\t\t\tcontinue\n202\t\t\t\t}\n203\t\t\t\tif table != nil {\n204\t\t\t\t\tb = table[b]\n205\t\t\t\t}\n206\t\t\t\tif squeezeSet != nil && squeezeSet[b] && int(b) == prev {\n207\t\t\t\t\tcontinue\n208\t\t\t\t}\n209\t\t\t\tprev = int(b)\n210\t\t\t\tif werr := w.WriteByte(b); werr != nil {\n211\t\t\t\t\treturn werr\n212\t\t\t\t}\n213\t\t\t}\n214\t\t\tif err != nil {\n215\t\t\t\tif err != io.EOF {\n216\t\t\t\t\treturn err\n217\t\t\t\t}\n218\t\t\t\tbreak\n219\t\t\t}\n220\t\t}\n221\t\treturn w.Flush()\n222\t}\n223\t\n224\tfunc expandSet(spec string) ([]byte, error) {\n225\t\tvar result []byte\n226\t\ti := 0\n227\t\tfor i < len(spec) {\n228\t\t\tif spec[i] == '[' {\n229\t\t\t\tn, bytes, err := tryBracketExpr(spec, i)\n230\t\t\t\tif err != nil {\n231\t\t\t\t\treturn nil, err\n232\t\t\t\t}\n233\t\t\t\tif n > 0 {\n234\t\t\t\t\tresult = append(result, bytes...)\n235\t\t\t\t\ti += n\n236\t\t\t\t\tcontinue\n237\t\t\t\t}\n238\t\t\t}\n239\t\t\tch, n := nextByte(spec, i)\n240\t\t\trn, rangeBytes, err := tryRange(spec, i, ch, n)\n241\t\t\tif err != nil {\n242\t\t\t\treturn nil, err\n243\t\t\t}\n244\t\t\tif rn > 0 {\n245\t\t\t\tresult = append(result, rangeBytes...)\n246\t\t\t\ti += rn\n247\t\t\t\tcontinue\n248\t\t\t}\n249\t\t\tresult = append(result, ch)\n250\t\t\ti += n\n251\t\t}\n252\t\treturn result, nil\n253\t}\n254\t\n255\tfunc tryRange(spec string, i int, lo byte, loN int) (int, []byte, error) {\n256\t\tdashPos := i + loN\n257\t\tif dashPos >= len(spec) || spec[dashPos] != '-' {\n258\t\t\treturn 0, nil, nil\n259\t\t}\n260\t\tif dashPos+1 >= len(spec) {\n261\t\t\treturn 0, nil, nil\n262\t\t}\n263\t\thi, hiN := nextByte(spec, dashPos+1)\n264\t\tif lo > hi {\n265\t\t\treturn 0, nil, fmt.Errorf(\n266\t\t\t\t\"range-endpoints of '%c-%c' are in reverse collating sequence order\",\n267\t\t\t\trune(lo), rune(hi))\n268\t\t}\n269\t\treturn loN + 1 + hiN, byteRange(lo, hi), nil\n270\t}\n271\t\n272\tfunc tryBracketExpr(spec string, i int) (int, []byte, error) {\n273\t\tif strings.HasPrefix(spec[i:], \"[:\") {\n274\t\t\treturn parseCharClass(spec, i)\n275\t\t}\n276\t\tif strings.HasPrefix(spec[i:], \"[=\") {\n277\t\t\treturn parseEquivClass(spec, i)\n278\t\t}\n279\t\treturn tryRepeat(spec, i)\n280\t}\n281\t\n282\tfunc parseCharClass(spec string, i int) (int, []byte, error) {\n283\t\tend := strings.Index(spec[i:], \":]\")\n284\t\tif end < 0 {\n285\t\t\treturn 0, nil, nil\n286\t\t}\n287\t\tclassName := spec[i+2 : i+end]\n288\t\tbytes, err := expandCharClass(className)\n289\t\tif err != nil {\n290\t\t\treturn 0, nil, err\n291\t\t}\n292\t\treturn end + 2, bytes, nil\n293\t}\n294\t\n295\tfunc expandCharClass(name string) ([]byte, error) {\n296\t\tswitch name {\n297\t\tcase \"upper\":\n298\t\t\treturn byteRange('A', 'Z'), nil\n299\t\tcase \"lower\":\n300\t\t\treturn byteRange('a', 'z'), nil\n301\t\tcase \"digit\":\n302\t\t\treturn byteRange('0', '9'), nil\n303\t\tcase \"alpha\":\n304\t\t\treturn append(byteRange('A', 'Z'), byteRange('a', 'z')...), nil\n305\t\tcase \"alnum\":\n306\t\t\tr := byteRange('0', '9')\n307\t\t\tr = append(r, byteRange('A', 'Z')...)\n308\t\t\tr = append(r, byteRange('a', 'z')...)\n309\t\t\treturn r, nil\n310\t\tcase \"blank\":\n311\t\t\treturn []byte{'\\t', ' '}, nil\n312\t\tcase \"space\":\n313\t\t\treturn []byte{'\\t', '\\n', '\\v', '\\f', '\\r', ' '}, nil\n314\t\tcase \"cntrl\":\n315\t\t\treturn append(byteRange(0, 31), 127), nil\n316\t\tcase \"print\":\n317\t\t\treturn byteRange(32, 126), nil\n318\t\tcase \"graph\":\n319\t\t\treturn byteRange(33, 126), nil\n320\t\tcase \"punct\":\n321\t\t\treturn expandPunct(), nil\n322\t\tcase \"xdigit\":\n323\t\t\tr := byteRange('0', '9')\n324\t\t\tr = append(r, byteRange('A', 'F')...)\n325\t\t\tr = append(r, byteRange('a', 'f')...)\n326\t\t\treturn r, nil\n327\t\tdefault:\n328\t\t\treturn nil, fmt.Errorf(\"invalid character class '%s'\", name)\n329\t\t}\n330\t}\n331\t\n332\tfunc expandPunct() []byte {\n333\t\tvar result []byte\n334\t\tfor b := byte(33); b <= 126; b++ {\n335\t\t\tif !isAlnum(b) {\n336\t\t\t\tresult = append(result, b)\n337\t\t\t}\n338\t\t}\n339\t\treturn result\n340\t}\n341\t\n342\tfunc isAlnum(b byte) bool {\n343\t\treturn (b >= '0' && b <= '9') ||\n344\t\t\t(b >= 'A' && b <= 'Z') ||\n345\t\t\t(b >= 'a' && b <= 'z')\n346\t}\n347\t\n348\tfunc parseEquivClass(spec string, i int) (int, []byte, error) {\n349\t\tend := strings.Index(spec[i:], \"=]\")\n350\t\tif end < 0 {\n351\t\t\treturn 0, nil, nil\n352\t\t}\n353\t\tch := spec[i+2]\n354\t\treturn end + 2, []byte{ch}, nil\n355\t}\n356\t\n357\tfunc tryRepeat(spec string, i int) (int, []byte, error) {\n358\t\tend := strings.Index(spec[i:], \"]\")\n359\t\tif end < 0 {\n360\t\t\treturn 0, nil, nil\n361\t\t}\n362\t\tinner := spec[i+1 : i+end]\n363\t\tif len(inner) < 2 {\n364\t\t\treturn 0, nil, nil\n365\t\t}\n366\t\tch, n := nextByte(inner, 0)\n367\t\tif n >= len(inner) || inner[n] != '*' {\n368\t\t\treturn 0, nil, nil\n369\t\t}\n370\t\tcountStr := inner[n+1:]\n371\t\tbytes, err := makeRepeat(ch, countStr)\n372\t\tif err != nil {\n373\t\t\treturn 0, nil, err\n374\t\t}\n375\t\treturn end + 1, bytes, nil\n376\t}\n377\t\n378\tfunc makeRepeat(ch byte, countStr string) ([]byte, error) {\n379\t\tif countStr == \"\" {\n380\t\t\treturn []byte{ch}, nil\n381\t\t}\n382\t\tbase := 10\n383\t\tif strings.HasPrefix(countStr, \"0\") && len(countStr) > 1 {\n384\t\t\tbase = 8\n385\t\t}\n386\t\tcount, err := strconv.ParseInt(countStr, base, 64)\n387\t\tif err != nil {\n388\t\t\treturn nil, fmt.Errorf(\"invalid repeat count '%s'\", countStr)\n389\t\t}\n390\t\tresult := make([]byte, count)\n391\t\tfor j := range result {\n392\t\t\tresult[j] = ch\n393\t\t}\n394\t\treturn result, nil\n395\t}\n396\t\n397\tfunc nextByte(spec string, i int) (byte, int) {\n398\t\tif spec[i] != '\\\\' || i+1 >= len(spec) {\n399\t\t\treturn spec[i], 1\n400\t\t}\n401\t\tc := spec[i+1]\n402\t\tif c >= '0' && c <= '7' {\n403\t\t\treturn parseOctal(spec, i)\n404\t\t}\n405\t\tif ch, ok := escapeChar(c); ok {\n406\t\t\treturn ch, 2\n407\t\t}\n408\t\treturn c, 2\n409\t}\n410\t\n411\tfunc escapeChar(c byte) (byte, bool) {\n412\t\tswitch c {\n413\t\tcase 'a':\n414\t\t\treturn '\\a', true\n415\t\tcase 'b':\n416\t\t\treturn '\\b', true\n417\t\tcase 'f':\n418\t\t\treturn '\\f', true\n419\t\tcase 'n':\n420\t\t\treturn '\\n', true\n421\t\tcase 'r':\n422\t\t\treturn '\\r', true\n423\t\tcase 't':\n424\t\t\treturn '\\t', true\n425\t\tcase 'v':\n426\t\t\treturn '\\v', true\n427\t\tcase '\\\\':\n428\t\t\treturn '\\\\', true\n429\t\tdefault:\n430\t\t\treturn 0, false\n431\t\t}\n432\t}\n433\t\n434\tfunc parseOctal(spec string, i int) (byte, int) {\n435\t\tj := i + 1\n436\t\tfor j < len(spec) && j < i+4 && spec[j] >= '0' && spec[j] <= '7' {\n437\t\t\tj++\n438\t\t}\n439\t\tval, _ := strconv.ParseUint(spec[i+1:j], 8, 16)\n440\t\treturn byte(val), j - i\n441\t}\n442\t\n443\tfunc byteRange(lo, hi byte) []byte {\n444\t\tif lo > hi {\n445\t\t\treturn nil\n446\t\t}\n447\t\tresult := make([]byte, int(hi)-int(lo)+1)\n448\t\tfor i := range result {\n449\t\t\tresult[i] = lo + byte(i)\n450\t\t}\n451\t\treturn result\n452\t}\n453\t"}]},"parent_tool_use_id":null,"session_id":"2c6b651d-10da-4679-b0c4-38e48c4ea296","uuid":"0b000cec-265b-4910-be3d-fb1c0b8e36bf","timestamp":"2026-05-20T23:32:44.436Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5386/cmd/tr/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/tr implements srd054-tr: translate or delete characters.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype config struct {\n\tdelete     bool\n\tsqueeze    bool\n\tcomplement bool\n\toperands   []string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tcfg, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"tr: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\tif err := run(cfg); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"tr: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) (config, error) {\n\tvar cfg config\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags || arg == \"-\" {\n\t\t\tcfg.operands = append(cfg.operands, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--delete\" {\n\t\t\tcfg.delete = true\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--squeeze-repeats\" {\n\t\t\tcfg.squeeze = true\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--complement\" {\n\t\t\tcfg.complement = true\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tif arg[1] == '-' {\n\t\t\t\treturn cfg, fmt.Errorf(\"unrecognized option '%s'\", arg)\n\t\t\t}\n\t\t\tif err := parseShortFlags(&cfg, arg[1:]); err != nil {\n\t\t\t\treturn cfg, err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tcfg.operands = append(cfg.operands, arg)\n\t}\n\treturn cfg, nil\n}\n\nfunc parseShortFlags(cfg *config, flags string) error {\n\tfor _, c := range flags {\n\t\tswitch c {\n\t\tcase 'd':\n\t\t\tcfg.delete = true\n\t\tcase 's':\n\t\t\tcfg.squeeze = true\n\t\tcase 'c', 'C':\n\t\t\tcfg.complement = true\n\t\tdefault:\n\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", c)\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc validateOperands(cfg config) error {\n\tn := len(cfg.operands)\n\tif n == 0 {\n\t\treturn fmt.Errorf(\"missing operand\")\n\t}\n\tif cfg.delete && !cfg.squeeze {\n\t\tif n > 1 {\n\t\t\treturn fmt.Errorf(\"extra operand '%s'\", cfg.operands[1])\n\t\t}\n\t\treturn nil\n\t}\n\tif cfg.squeeze && !cfg.delete && n == 1 {\n\t\treturn nil\n\t}\n\tif n < 2 {\n\t\treturn fmt.Errorf(\"missing operand after '%s'\", cfg.operands[0])\n\t}\n\treturn nil\n}\n\nfunc run(cfg config) error {\n\tif err := validateOperands(cfg); err != nil {\n\t\treturn err\n\t}\n\tset1, err := expandSet(cfg.operands[0])\n\tif err != nil {\n\t\treturn err\n\t}\n\tif cfg.complement {\n\t\tset1 = complementSet(set1)\n\t}\n\tset1Members := memberSet(set1)\n\tif cfg.delete {\n\t\tif !cfg.squeeze {\n\t\t\treturn process(nil, &set1Members, nil)\n\t\t}\n\t\tset2, err := expandSet(cfg.operands[1])\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tsqSet := memberSet(set2)\n\t\treturn process(nil, &set1Members, &sqSet)\n\t}\n\tif cfg.squeeze && len(cfg.operands) == 1 {\n\t\treturn process(nil, nil, &set1Members)\n\t}\n\tset2, err := expandSet(cfg.operands[1])\n\tif err != nil {\n\t\treturn err\n\t}\n\tif len(set2) == 0 {\n\t\treturn fmt.Errorf(\"when not truncating set1, string2 must be non-empty\")\n\t}\n\ttable := buildTable(set1, set2)\n\tif cfg.squeeze {\n\t\tsqSet := memberSet(set2)\n\t\treturn process(&table, nil, &sqSet)\n\t}\n\treturn process(&table, nil, nil)\n}\n\nfunc complementSet(set []byte) []byte {\n\tvar present [256]bool\n\tfor _, b := range set {\n\t\tpresent[b] = true\n\t}\n\tvar result []byte\n\tfor i := range 256 {\n\t\tif !present[byte(i)] {\n\t\t\tresult = append(result, byte(i))\n\t\t}\n\t}\n\treturn result\n}\n\nfunc memberSet(set []byte) [256]bool {\n\tvar m [256]bool\n\tfor _, b := range set {\n\t\tm[b] = true\n\t}\n\treturn m\n}\n\nfunc buildTable(set1, set2 []byte) [256]byte {\n\tvar table [256]byte\n\tfor i := range table {\n\t\ttable[i] = byte(i)\n\t}\n\tfor i, b := range set1 {\n\t\tif i < len(set2) {\n\t\t\ttable[b] = set2[i]\n\t\t} else {\n\t\t\ttable[b] = set2[len(set2)-1]\n\t\t}\n\t}\n\treturn table\n}\n\nfunc process(table *[256]byte, deleteSet, squeezeSet *[256]bool) error {\n\tr := bufio.NewReader(os.Stdin)\n\tw := bufio.NewWriter(os.Stdout)\n\tprev := -1\n\tbuf := make([]byte, 32*1024)\n\tfor {\n\t\tn, err := r.Read(buf)\n\t\tfor i := range n {\n\t\t\tb := buf[i]\n\t\t\tif deleteSet != nil && deleteSet[b] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif table != nil {\n\t\t\t\tb = table[b]\n\t\t\t}\n\t\t\tif squeezeSet != nil && squeezeSet[b] && int(b) == prev {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tprev = int(b)\n\t\t\tif werr := w.WriteByte(b); werr != nil {\n\t\t\t\treturn werr\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\tif err != io.EOF {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t}\n\treturn w.Flush()\n}\n\nfunc expandSet(spec string) ([]byte, error) {\n\tvar result []byte\n\ti := 0\n\tfor i < len(spec) {\n\t\tif spec[i] == '[' {\n\t\t\tn, bytes, err := tryBracketExpr(spec, i)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\tif n > 0 {\n\t\t\t\tresult = append(result, bytes...)\n\t\t\t\ti += n\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tch, n := nextByte(spec, i)\n\t\trn, rangeBytes, err := tryRange(spec, i, ch, n)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif rn > 0 {\n\t\t\tresult = append(result, rangeBytes...)\n\t\t\ti += rn\n\t\t\tcontinue\n\t\t}\n\t\tresult = append(result, ch)\n\t\ti += n\n\t}\n\treturn result, nil\n}\n\nfunc tryRange(spec string, i int, lo byte, loN int) (int, []byte, error) {\n\tdashPos := i + loN\n\tif dashPos >= len(spec) || spec[dashPos] != '-' {\n\t\treturn 0, nil, nil\n\t}\n\tif dashPos+1 >= len(spec) {\n\t\treturn 0, nil, nil\n\t}\n\thi, hiN := nextByte(spec, dashPos+1)\n\tif lo > hi {\n\t\treturn 0, nil, fmt.Errorf(\n\t\t\t\"range-endpoints of '%c-%c' are in reverse collating sequence order\",\n\t\t\trune(lo), rune(hi))\n\t}\n\treturn loN + 1 + hiN, byteRange(lo, hi), nil\n}\n\nfunc tryBracketExpr(spec string, i int) (int, []byte, error) {\n\tif strings.HasPrefix(spec[i:], \"[:\") {\n\t\treturn parseCharClass(spec, i)\n\t}\n\tif strings.HasPrefix(spec[i:], \"[=\") {\n\t\treturn parseEquivClass(spec, i)\n\t}\n\treturn tryRepeat(spec, i)\n}\n\nfunc parseCharClass(spec string, i int) (int, []byte, error) {\n\tend := strings.Index(spec[i:], \":]\")\n\tif end < 0 {\n\t\treturn 0, nil, nil\n\t}\n\tclassName := spec[i+2 : i+end]\n\tbytes, err := expandCharClass(className)\n\tif err != nil {\n\t\treturn 0, nil, err\n\t}\n\treturn end + 2, bytes, nil\n}\n\nfunc expandCharClass(name string) ([]byte, error) {\n\tswitch name {\n\tcase \"upper\":\n\t\treturn byteRange('A', 'Z'), nil\n\tcase \"lower\":\n\t\treturn byteRange('a', 'z'), nil\n\tcase \"digit\":\n\t\treturn byteRange('0', '9'), nil\n\tcase \"alpha\":\n\t\treturn append(byteRange('A', 'Z'), byteRange('a', 'z')...), nil\n\tcase \"alnum\":\n\t\tr := byteRange('0', '9')\n\t\tr = append(r, byteRange('A', 'Z')...)\n\t\tr = append(r, byteRange('a', 'z')...)\n\t\treturn r, nil\n\tcase \"blank\":\n\t\treturn []byte{'\\t', ' '}, nil\n\tcase \"space\":\n\t\treturn []byte{'\\t', '\\n', '\\v', '\\f', '\\r', ' '}, nil\n\tcase \"cntrl\":\n\t\treturn append(byteRange(0, 31), 127), nil\n\tcase \"print\":\n\t\treturn byteRange(32, 126), nil\n\tcase \"graph\":\n\t\treturn byteRange(33, 126), nil\n\tcase \"punct\":\n\t\treturn expandPunct(), nil\n\tcase \"xdigit\":\n\t\tr := byteRange('0', '9')\n\t\tr = append(r, byteRange('A', 'F')...)\n\t\tr = append(r, byteRange('a', 'f')...)\n\t\treturn r, nil\n\tdefault:\n\t\treturn nil, fmt.Errorf(\"invalid character class '%s'\", name)\n\t}\n}\n\nfunc expandPunct() []byte {\n\tvar result []byte\n\tfor b := byte(33); b <= 126; b++ {\n\t\tif !isAlnum(b) {\n\t\t\tresult = append(result, b)\n\t\t}\n\t}\n\treturn result\n}\n\nfunc isAlnum(b byte) bool {\n\treturn (b >= '0' && b <= '9') ||\n\t\t(b >= 'A' && b <= 'Z') ||\n\t\t(b >= 'a' && b <= 'z')\n}\n\nfunc parseEquivClass(spec string, i int) (int, []byte, error) {\n\tend := strings.Index(spec[i:], \"=]\")\n\tif end < 0 {\n\t\treturn 0, nil, nil\n\t}\n\tch := spec[i+2]\n\treturn end + 2, []byte{ch}, nil\n}\n\nfunc tryRepeat(spec string, i int) (int, []byte, error) {\n\tend := strings.Index(spec[i:], \"]\")\n\tif end < 0 {\n\t\treturn 0, nil, nil\n\t}\n\tinner := spec[i+1 : i+end]\n\tif len(inner) < 2 {\n\t\treturn 0, nil, nil\n\t}\n\tch, n := nextByte(inner, 0)\n\tif n >= len(inner) || inner[n] != '*' {\n\t\treturn 0, nil, nil\n\t}\n\tcountStr := inner[n+1:]\n\tbytes, err := makeRepeat(ch, countStr)\n\tif err != nil {\n\t\treturn 0, nil, err\n\t}\n\treturn end + 1, bytes, nil\n}\n\nfunc makeRepeat(ch byte, countStr string) ([]byte, error) {\n\tif countStr == \"\" {\n\t\treturn []byte{ch}, nil\n\t}\n\tbase := 10\n\tif strings.HasPrefix(countStr, \"0\") && len(countStr) > 1 {\n\t\tbase = 8\n\t}\n\tcount, err := strconv.ParseInt(countStr, base, 64)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"invalid repeat count '%s'\", countStr)\n\t}\n\tresult := make([]byte, count)\n\tfor j := range result {\n\t\tresult[j] = ch\n\t}\n\treturn result, nil\n}\n\nfunc nextByte(spec string, i int) (byte, int) {\n\tif spec[i] != '\\\\' || i+1 >= len(spec) {\n\t\treturn spec[i], 1\n\t}\n\tc := spec[i+1]\n\tif c >= '0' && c <= '7' {\n\t\treturn parseOctal(spec, i)\n\t}\n\tif ch, ok := escapeChar(c); ok {\n\t\treturn ch, 2\n\t}\n\treturn c, 2\n}\n\nfunc escapeChar(c byte) (byte, bool) {\n\tswitch c {\n\tcase 'a':\n\t\treturn '\\a', true\n\tcase 'b':\n\t\treturn '\\b', true\n\tcase 'f':\n\t\treturn '\\f', true\n\tcase 'n':\n\t\treturn '\\n', true\n\tcase 'r':\n\t\treturn '\\r', true\n\tcase 't':\n\t\treturn '\\t', true\n\tcase 'v':\n\t\treturn '\\v', true\n\tcase '\\\\':\n\t\treturn '\\\\', true\n\tdefault:\n\t\treturn 0, false\n\t}\n}\n\nfunc parseOctal(spec string, i int) (byte, int) {\n\tj := i + 1\n\tfor j < len(spec) && j < i+4 && spec[j] >= '0' && spec[j] <= '7' {\n\t\tj++\n\t}\n\tval, _ := strconv.ParseUint(spec[i+1:j], 8, 16)\n\treturn byte(val), j - i\n}\n\nfunc byteRange(lo, hi byte) []byte {\n\tif lo > hi {\n\t\treturn nil\n\t}\n\tresult := make([]byte, int(hi)-int(lo)+1)\n\tfor i := range result {\n\t\tresult[i] = lo + byte(i)\n\t}\n\treturn result\n}\n","numLines":453,"startLine":1,"totalLines":453}}}
