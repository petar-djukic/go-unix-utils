Join(dir, \"sub\"), 0o755)\n230\t\t\t}, []string{\"-sr\", \"src\", \"sub/link\"}, func(t *testing.T, dir string) {\n231\t\t\t\ttarget, err := os.Readlink(filepath.Join(dir, \"sub\", \"link\"))\n232\t\t\t\tif err != nil {\n233\t\t\t\t\tt.Fatalf(\"readlink: %v\", err)\n234\t\t\t\t}\n235\t\t\t\tif target != \"../src\" {\n236\t\t\t\t\tt.Fatalf(\"expected relative target '../src', got %q\", target)\n237\t\t\t\t}\n238\t\t\t})\n239\t\t})\n240\t\n241\t\tt.Run(\"backup_simple\", func(t *testing.T) {\n242\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n243\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n244\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n245\t\t\t}, []string{\"-b\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n246\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n247\t\t\t\tverifyFileContent(t, dir, \"dest~\", \"old\")\n248\t\t\t})\n249\t\t})\n250\t\n251\t\tt.Run(\"backup_simple_symlink\", func(t *testing.T) {\n252\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n253\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n254\t\t\t}, []string{\"-sb\", \"newtarget\", \"dest\"}, func(t *testing.T, dir string) {\n255\t\t\t\tverifySymlink(t, dir, \"dest\", \"newtarget\")\n256\t\t\t\tverifyFileContent(t, dir, \"dest~\", \"old\")\n257\t\t\t})\n258\t\t})\n259\t\n260\t\tt.Run(\"backup_numbered\", func(t *testing.T) {\n261\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n262\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n263\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n264\t\t\t}, []string{\"--backup=numbered\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n265\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n266\t\t\t\tverifyFileContent(t, dir, \"dest.~1~\", \"old\")\n267\t\t\t})\n268\t\t})\n269\t\n270\t\tt.Run(\"backup_numbered_increments\", func(t *testing.T) {\n271\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n272\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n273\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n274\t\t\t\twriteFile(t, dir, \"dest.~1~\", \"older\")\n275\t\t\t}, []string{\"--backup=numbered\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n276\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n277\t\t\t\tverifyFileContent(t, dir, \"dest.~1~\", \"older\")\n278\t\t\t\tverifyFileContent(t, dir, \"dest.~2~\", \"old\")\n279\t\t\t})\n280\t\t})\n281\t\n282\t\tt.Run(\"backup_existing_falls_back_simple\", func(t *testing.T) {\n283\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n284\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n285\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n286\t\t\t}, []string{\"--backup=existing\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n287\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n288\t\t\t\tverifyFileContent(t, dir, \"dest~\", \"old\")\n289\t\t\t})\n290\t\t})\n291\t\n292\t\tt.Run(\"backup_existing_uses_numbered\", func(t *testing.T) {\n293\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n294\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n295\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n296\t\t\t\twriteFile(t, dir, \"dest.~1~\", \"v1\")\n297\t\t\t}, []string{\"--backup=existing\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n298\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n299\t\t\t\tverifyFileContent(t, dir, \"dest.~1~\", \"v1\")\n300\t\t\t\tverifyFileContent(t, dir, \"dest.~2~\", \"old\")\n301\t\t\t})\n302\t\t})\n303\t\n304\t\tt.Run(\"backup_none\", func(t *testing.T) {\n305\t\t\tdir := t.TempDir()\n306\t\t\twriteFile(t, dir, \"src\", \"new\")\n307\t\t\twriteFile(t, dir, \"dest\", \"old\")\n308\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n309\t\t\t\t{\n310\t\t\t\t\tName:     \"backup_none\",\n311\t\t\t\t\tArgs:     []string{\"--backup=none\", \"src\", \"dest\"},\n312\t\t\t\t\tWorkDir:  dir,\n313\t\t\t\t\tExitCode: 1,\n314\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n315\t\t\t\t\t\tnormalizeBinaryName,\n316\t\t\t\t\t},\n317\t\t\t\t},\n318\t\t\t})\n319\t\t})\n320\t\n321\t\tt.Run(\"backup_custom_suffix\", func(t *testing.T) {\n322\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n323\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n324\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n325\t\t\t}, []string{\"-b\", \"-S\", \".bak\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n326\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n327\t\t\t\tverifyFileContent(t, dir, \"dest.bak\", \"old\")\n328\t\t\t})\n329\t\t})\n330\t\n331\t\tt.Run(\"backup_suffix_equals\", func(t *testing.T) {\n332\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n333\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n334\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n335\t\t\t}, []string{\"-b\", \"--suffix=.orig\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n336\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n337\t\t\t\tverifyFileContent(t, dir, \"dest.orig\", \"old\")\n338\t\t\t})\n339\t\t})\n340\t\n341\t\tt.Run(\"backup_verbose\", func(t *testing.T) {\n342\t\t\trunLinkTestV(t, goBin, refBin,\n343\t\t\t\tmap[string]string{\"src\": \"new\", \"dest\": \"old\"},\n344\t\t\t\t[]string{\"-bv\", \"src\", \"dest\"},\n345\t\t\t\tfunc(t *testing.T, dir string) {\n346\t\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n347\t\t\t\t},\n348\t\t\t)\n349\t\t})\n350\t\n351\t\tt.Run(\"backup_verbose_symlink\", func(t *testing.T) {\n352\t\t\trunLinkTestV(t, goBin, refBin,\n353\t\t\t\tmap[string]string{\"dest\": \"old\"},\n354\t\t\t\t[]string{\"-sbv\", \"newtarget\", \"dest\"},\n355\t\t\t\tfunc(t *testing.T, dir string) {\n356\t\t\t\t\tverifySymlink(t, dir, \"dest\", \"newtarget\")\n357\t\t\t\t},\n358\t\t\t)\n359\t\t})\n360\t\n361\t\tt.Run(\"backup_force_combined\", func(t *testing.T) {\n362\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n363\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n364\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n365\t\t\t}, []string{\"-fb\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n366\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n367\t\t\t\tverifyFileContent(t, dir, \"dest~\", \"old\")\n368\t\t\t})\n369\t\t})\n370\t\n371\t\tt.Run(\"backup_method_aliases\", func(t *testing.T) {\n372\t\t\tfor _, tc := range []struct {\n373\t\t\t\tname   string\n374\t\t\t\tmethod string\n375\t\t\t}{\n376\t\t\t\t{\"t\", \"t\"},\n377\t\t\t\t{\"never\", \"never\"},\n378\t\t\t\t{\"nil\", \"nil\"},\n379\t\t\t\t{\"off\", \"off\"},\n380\t\t\t} {\n381\t\t\t\tt.Run(tc.name, func(t *testing.T) {\n382\t\t\t\t\tgoDir := t.TempDir()\n383\t\t\t\t\trefDir := t.TempDir()\n384\t\t\t\t\twriteFile(t, goDir, \"src\", \"new\")\n385\t\t\t\t\twriteFile(t, goDir, \"dest\", \"old\")\n386\t\t\t\t\twriteFile(t, refDir, \"src\", \"new\")\n387\t\t\t\t\twriteFile(t, refDir, \"dest\", \"old\")\n388\t\t\t\t\targs := []string{\"--backup=\" + tc.method, \"src\", \"dest\"}\n389\t\t\t\t\tgoRes := runBin(t, goBin, args, goDir)\n390\t\t\t\t\trefRes := runBin(t, refBin, args, refDir)\n391\t\t\t\t\tcompareResults(t, args, goRes, refRes)\n392\t\t\t\t})\n393\t\t\t}\n394\t\t})\n395\t\n396\t\tt.Run(\"multi_target_dir\", func(t *testing.T) {\n397\t\t\trunLinkTest(t, goBin, refBin,\n398\t\t\t\tmap[string]string{\"x\": \"xx\", \"y\": \"yy\", \"z\": \"zz\"},\n399\t\t\t\t[]string{\"x\", \"y\", \"z\", \"dest\"},\n400\t\t\t\tfunc(t *testing.T, dir string) {\n401\t\t\t\t\tverifyHardLink(t, dir, \"x\", filepath.Join(\"dest\", \"x\"))\n402\t\t\t\t\tverifyHardLink(t, dir, \"y\", filepath.Join(\"dest\", \"y\"))\n403\t\t\t\t\tverifyHardLink(t, dir, \"z\", filepath.Join(\"dest\", \"z\"))\n404\t\t\t\t},\n405\t\t\t)\n406\t\t})\n407\t\n408\t\tt.Run(\"multi_target_symlink_dir\", func(t *testing.T) {\n409\t\t\trunLinkTest(t, goBin, refBin,\n410\t\t\t\tmap[string]string{\"a\": \"aa\", \"b\": \"bb\"},\n411\t\t\t\t[]string{\"-s\", \"a\", \"b\", \"dest\"},\n412\t\t\t\tfunc(t *testing.T, dir string) {\n413\t\t\t\t\tverifySymlink(t, dir, filepath.Join(\"dest\", \"a\"), \"a\")\n414\t\t\t\t\tverifySymlink(t, dir, filepath.Join(\"dest\", \"b\"), \"b\")\n415\t\t\t\t},\n416\t\t\t)\n417\t\t})\n418\t\n419\t\tt.Run(\"help_flag\", func(t *testing.T) {\n420\t\t\tgoRes := runBin(t, goBin, []string{\"--help\"}, t.TempDir())\n421\t\t\trefRes := runBin(t, refBin, []string{\"--help\"}, t.TempDir())\n422\t\t\tif goRes.exitCode != refRes.exitCode {\n423\t\t\t\tt.Fatalf(\"exit code: go=%d ref=%d\", goRes.exitCode, refRes.exitCode)\n424\t\t\t}\n425\t\t\tif len(goRes.stdout) == 0 {\n426\t\t\t\tt.Fatal(\"--help produced no stdout\")\n427\t\t\t}\n428\t\t})\n429\t\n430\t\tt.Run(\"version_flag\", func(t *testing.T) {\n431\t\t\tgoRes := runBin(t, goBin, []string{\"--version\"}, t.TempDir())\n432\t\t\trefRes := runBin(t, refBin, []string{\"--version\"}, t.TempDir())\n433\t\t\tif goRes.exitCode != refRes.exitCode {\n434\t\t\t\tt.Fatalf(\"exit code: go=%d ref=%d\", goRes.exitCode, refRes.exitCode)\n435\t\t\t}\n436\t\t\tif len(goRes.stdout) == 0 {\n437\t\t\t\tt.Fatal(\"--version produced no stdout\")\n438\t\t\t}\n439\t\t})\n440\t}\n441\t\n442\tfunc writeFile(t *testing.T, dir, name, content string) {\n443\t\tt.Helper()\n444\t\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {\n445\t\t\tt.Fatal(err)\n446\t\t}\n447\t}\n448\t\n449\tfunc setupDir(t *testing.T, dir string, files map[string]string) {\n450\t\tt.Helper()\n451\t\tfor name, content := range files {\n452\t\t\twriteFile(t, dir, name, content)\n453\t\t}\n454\t}\n455\t\n456\tfunc runLinkTest(\n457\t\tt *testing.T, goBin, refBin string,\n458\t\tfiles map[string]string,\n459\t\targs []string,\n460\t\tverify func(t *testing.T, dir string),\n461\t) {\n462\t\tt.Helper()\n463\t\tgoDir := t.TempDir()\n464\t\trefDir := t.TempDir()\n465\t\n466\t\tneedsDestDir := false\n467\t\tif len(args) > 2 {\n468\t\t\tlast := args[len(args)-1]\n469\t\t\tnonFlagCount := 0\n470\t\t\tfor _, a := range args {\n471\t\t\t\tif !isFlag(a) {\n472\t\t\t\t\tnonFlagCount++\n473\t\t\t\t}\n474\t\t\t}\n475\t\t\tif nonFlagCount > 2 {\n476\t\t\t\tneedsDestDir = true\n477\t\t\t\t_ = last\n478\t\t\t}\n479\t\t}\n480\t\n481\t\tfor _, d := range []string{goDir, refDir} {\n482\t\t\tsetupDir(t, d, files)\n483\t\t\tif needsDestDir {\n484\t\t\t\tlast := args[len(args)-1]\n485\t\t\t\tos.Mkdir(filepath.Join(d, last), 0o755)\n486\t\t\t}\n487\t\t}\n488\t\n489\t\tgoRes := runBin(t, goBin, args, goDir)\n490\t\trefRes := runBin(t, refBin, args, refDir)\n491\t\tcompareResults(t, args, goRes, refRes)\n492\t\n493\t\tif verify != nil {\n494\t\t\tt.Run(\"verify_go\", func(t *testing.T) { verify(t, goDir) })\n495\t\t\tt.Run(\"verify_ref\", func(t *testing.T) { verify(t, refDir) })\n496\t\t}\n497\t}\n498\t\n499\tfunc runLinkTestV(\n500\t\tt *testing.T, goBin, refBin string,\n501\t\tfiles map[string]string,\n502\t\targs []string,\n503\t\tverify ...func(t *testing.T, dir string),\n504\t) {\n505\t\tt.Helper()\n506\t\tgoDir := t.TempDir()\n507\t\trefDir := t.TempDir()\n508\t\tsetupDir(t, goDir, files)\n509\t\tsetupDir(t, refDir, files)\n510\t\tgoRes := runBin(t, goBin, args, goDir)\n511\t\trefRes := runBin(t, refBin, args, refDir)\n512\t\tcompareResults(t, args, goRes, refRes)\n513\t\n514\t\tif len(verify) > 0 && verify[0] != nil {\n515\t\t\tt.Run(\"verify_go\", func(t *testing.T) { verify[0](t, goDir) })\n516\t\t\tt.Run(\"verify_ref\", func(t *testing.T) { verify[0](t, refDir) })\n517\t\t}\n518\t}\n519\t\n520\tfunc runLinkTestN(\n521\t\tt *testing.T, goBin, refBin string,\n522\t\tsetup func(t *testing.T, dir string),\n523\t\targs []string,\n524\t\tverify func(t *testing.T, dir string),\n525\t) {\n526\t\tt.Helper()\n527\t\tgoDir := t.TempDir()\n528\t\trefDir := t.TempDir()\n529\t\tsetup(t, goDir)\n530\t\tsetup(t, refDir)\n531\t\tgoRes := runBin(t, goBin, args, goDir)\n532\t\trefRes := runBin(t, refBin, args, refDir)\n533\t\tcompareResults(t, args, goRes, refRes)\n534\t\n535\t\tif verify != nil {\n536\t\t\tt.Run(\"verify_go\", func(t *testing.T) { verify(t, goDir) })\n537\t\t\tt.Run(\"verify_ref\", func(t *testing.T) { verify(t, refDir) })\n538\t\t}\n539\t}\n540\t\n541\tfunc isFlag(s string) bool {\n542\t\treturn len(s) > 0 && s[0] == '-'\n543\t}\n544\t\n545\tfunc verifyHardLink(t *testing.T, dir, orig, link string) {\n546\t\tt.Helper()\n547\t\torigPath := filepath.Join(dir, orig)\n548\t\tlinkPath := filepath.Join(dir, link)\n549\t\torigInfo, err := os.Stat(origPath)\n550\t\tif err != nil {\n551\t\t\tt.Fatalf(\"stat original %s: %v\", orig, err)\n552\t\t}\n553\t\tlinkInfo, err := os.Lstat(linkPath)\n554\t\tif err != nil {\n555\t\t\tt.Fatalf(\"lstat link %s: %v\", link, err)\n556\t\t}\n557\t\tif linkInfo.Mode()&os.ModeSymlink != 0 {\n558\t\t\tt.Fatalf(\"%s is a symlink, expected hard link\", link)\n559\t\t}\n560\t\tif !os.SameFile(origInfo, linkInfo) {\n561\t\t\tt.Fatalf(\"%s and %s do not share the same inode\", orig, link)\n562\t\t}\n563\t}\n564\t\n565\tfunc verifySymlink(t *testing.T, dir, link, expectedTarget string) {\n566\t\tt.Helper()\n567\t\tlinkPath := filepath.Join(dir, link)\n568\t\tfi, err := os.Lstat(linkPath)\n569\t\tif err != nil {\n570\t\t\tt.Fatalf(\"lstat %s: %v\", link, err)\n571\t\t}\n572\t\tif fi.Mode()&os.ModeSymlink == 0 {\n573\t\t\tt.Fatalf(\"%s is not a symlink, expected symbolic link\", link)\n574\t\t}\n575\t\ttarget, err := os.Readlink(linkPath)\n576\t\tif err != nil {\n577\t\t\tt.Fatalf(\"readlink %s: %v\", link, err)\n578\t\t}\n579\t\tif target != expectedTarget {\n580\t\t\tt.Fatalf(\"symlink %s: expected target %q, got %q\", link, expectedTarget, target)\n581\t\t}\n582\t}\n583\t\n584\tfunc verifyFileContent(t *testing.T, dir, name, expected string) {\n585\t\tt.Helper()\n586\t\tcontent, err := os.ReadFile(filepath.Join(dir, name))\n587\t\tif err != nil {\n588\t\t\tt.Fatalf(\"read %s: %v\", name, err)\n589\t\t}\n590\t\tif string(content) != expected {\n591\t\t\tt.Fatalf(\"file %s: expected %q, got %q\", name, expected, string(content))\n592\t\t}\n593\t}\n594\t\n595\ttype binResult struct {\n596\t\tstdout   []byte\n597\t\tstderr   []byte\n598\t\texitCode int\n599\t}\n600\t\n601\tfunc runBin(t *testing.T, binary string, args []string, workDir string) binResult {\n602\t\tt.Helper()\n603\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n604\t\tdefer cancel()\n605\t\tcmd := exec.CommandContext(ctx, binary, args...)\n606\t\tcmd.Dir = workDir\n607\t\tcmd.Env = append(os.Environ(), \"LC_ALL=C\")\n608\t\tvar stdout, stderr bytes.Buffer\n609\t\tcmd.Stdout = &stdout\n610\t\tcmd.Stderr = &stderr\n611\t\terr := cmd.Run()\n612\t\tif ctx.Err() == context.DeadlineExceeded {\n613\t\t\tt.Fatalf(\"binary %s timed out\", binary)\n614\t\t}\n615\t\texitCode := 0\n616\t\tif err != nil {\n617\t\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n618\t\t\t\texitCode = exitErr.ExitCode()\n619\t\t\t} else {\n620\t\t\t\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n621\t\t\t}\n622\t\t}\n623\t\treturn binResult{stdout: stdout.Bytes(), stderr: stderr.Bytes(), exitCode: exitCode}\n624\t}\n625\t\n626\tfunc compareResults(t *testing.T, args []string, goRes, refRes binResult) {\n627\t\tt.Helper()\n628\t\tgoStdout := normalizeBinaryName(goRes.stdout)\n629\t\trefStdout := normalizeBinaryName(refRes.stdout)\n630\t\tgoStderr := normalizeBinaryName(goRes.stderr)\n631\t\trefStderr := normalizeBinaryName(refRes.stderr)\n632\t\n633\t\tif !bytes.Equal(goStdout, refStdout) ||\n634\t\t\t!bytes.Equal(goStderr, refStderr) ||\n635\t\t\tgoRes.exitCode != refRes.exitCode {\n636\t\t\tt.Fatalf(\"divergence detected\\n\"+\n637\t\t\t\t\"  args:       %v\\n\"+\n638\t\t\t\t\"  ref stdout: %q\\n\"+\n639\t\t\t\t\"  go  stdout: %q\\n\"+\n640\t\t\t\t\"  ref stderr: %q\\n\"+\n641\t\t\t\t\"  go  stderr: %q\\n\"+\n642\t\t\t\t\"  ref exit:   %d\\n\"+\n643\t\t\t\t\"  go  exit:   %d\\n\",\n644\t\t\t\targs, refStdout, goStdout, refStderr, goStderr, refRes.exitCode, goRes.exitCode)\n645\t\t}\n646\t}\n647\t\n648\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?ln\\b`)\n649\t\n650\tfunc normalizeBinaryName(b []by