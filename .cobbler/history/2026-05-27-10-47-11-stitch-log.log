{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mf3CCDssB3DLNZ9jnPARSn","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/chmod implements srd089-chmod R1.1-R1.4, R2.1-R2.4, R3.1-R3.2, R4.1-R4.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\t\"syscall\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tconst helpText = `Usage: chmod [OPTION]... MODE[,MODE]... FILE...\n20\t  or:  chmod [OPTION]... OCTAL-MODE FILE...\n21\t  or:  chmod [OPTION]... --reference=RFILE FILE...\n22\tChange the mode of each FILE to MODE.\n23\t\n24\t  -c, --changes          like verbose but report only when a change is made\n25\t  -f, --silent, --quiet  suppress most error messages\n26\t  -v, --verbose          output a diagnostic for every file processed\n27\t      --no-preserve-root  do not treat '/' specially (the default)\n28\t      --preserve-root    fail to operate recursively on '/'\n29\t      --reference=RFILE  use RFILE's mode instead of MODE values\n30\t  -R, --recursive        change files and directories recursively\n31\t      --help     display this help and exit\n32\t      --version  output version information and exit\n33\t\n34\tEach MODE is of the form '[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+'.\n35\t`\n36\t\n37\tconst versionText = `chmod (go-unix-utils) dev\n38\t`\n39\t\n40\ttype options struct {\n41\t\tverbose      bool\n42\t\tchanges      bool\n43\t\tsilent       bool\n44\t\trecursive    bool\n45\t\tpreserveRoot bool\n46\t\treference    string\n47\t}\n48\t\n49\tfunc main() {\n50\t\tsys.InstallSIGPIPEHandler()\n51\t\n52\t\topts, mode, files := parseArgs(os.Args[1:])\n53\t\tif opts.reference != \"\" {\n54\t\t\tmode = resolveReference(opts.reference)\n55\t\t} else if err := validateMode(mode); err != nil {\n56\t\t\tfmt.Fprintf(os.Stderr, \"chmod: invalid mode: '%s'\\n\", mode)\n57\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n58\t\t\tos.Exit(1)\n59\t\t}\n60\t\tif len(files) == 0 {\n61\t\t\tfmt.Fprintf(os.Stderr, \"chmod: missing operand after '%s'\\n\", mode)\n62\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n63\t\t\tos.Exit(1)\n64\t\t}\n65\t\n66\t\texitCode := 0\n67\t\tfor _, file := range files {\n68\t\t\tif err := processFile(opts, mode, file); err != nil {\n69\t\t\t\texitCode = 1\n70\t\t\t}\n71\t\t}\n72\t\tif exitCode != 0 {\n73\t\t\tos.Exit(exitCode)\n74\t\t}\n75\t}\n76\t\n77\tfunc processFile(opts options, mode string, path string) error {\n78\t\tif opts.recursive {\n79\t\t\treturn processRecursive(opts, mode, path)\n80\t\t}\n81\t\treturn applyAndReport(opts, mode, path)\n82\t}\n83\t\n84\tfunc processRecursive(opts options, mode string, root string) error {\n85\t\tif opts.preserveRoot && isRootPath(root) {\n86\t\t\tfmt.Fprintf(os.Stderr,\n87\t\t\t\t\"chmod: it is dangerous to operate recursively on '/'\\nchmod: use --no-preserve-root to override this failsafe\\n\")\n88\t\t\treturn fmt.Errorf(\"refusing to operate on root\")\n89\t\t}\n90\t\tvar walkErr error\n91\t\terr := filepath.WalkDir(root, func(path string, _ os.DirEntry, err error) error {\n92\t\t\tif err != nil {\n93\t\t\t\treportError(opts, path, err)\n94\t\t\t\twalkErr = err\n95\t\t\t\treturn nil\n96\t\t\t}\n97\t\t\tif applyErr := applyAndReport(opts, mode, path); applyErr != nil {\n98\t\t\t\twalkErr = applyErr\n99\t\t\t}\n100\t\t\treturn nil\n101\t\t})\n102\t\tif err != nil {\n103\t\t\treturn err\n104\t\t}\n105\t\treturn walkErr\n106\t}\n107\t\n108\tfunc applyAndReport(opts options, mode string, path string) error {\n109\t\toldMode, err := getMode(path)\n110\t\tif err != nil {\n111\t\t\treportError(opts, path, err)\n112\t\t\treturn err\n113\t\t}\n114\t\tif err := applyMode(mode, path); err != nil {\n115\t\t\treportError(opts, path, err)\n116\t\t\treturn err\n117\t\t}\n118\t\tnewMode, err := getMode(path)\n119\t\tif err != nil {\n120\t\t\treportError(opts, path, err)\n121\t\t\treturn err\n122\t\t}\n123\t\tprintDiagnostic(opts, path, oldMode, newMode)\n124\t\treturn nil\n125\t}\n126\t\n127\tfunc getMode(path string) (os.FileMode, error) {\n128\t\tinfo, err := os.Lstat(path)\n129\t\tif err != nil {\n130\t\t\treturn 0, err\n131\t\t}\n132\t\treturn info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky)), nil\n133\t}\n134\t\n135\tfunc reportError(opts options, _ string, err error) {\n136\t\tif opts.silent {\n137\t\t\treturn\n138\t\t}\n139\t\tfmt.Fprintf(os.Stderr, \"chmod: %s\\n\", formatErr(err))\n140\t}\n141\t\n142\tfunc printDiagnostic(opts options, path string, oldMode, newMode os.FileMode) {\n143\t\tif opts.verbose {\n144\t\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n145\t\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n146\t\t\treturn\n147\t\t}\n148\t\tif opts.changes && oldMode != newMode {\n149\t\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n150\t\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n151\t\t}\n152\t}\n153\t\n154\tfunc symbolicString(mode os.FileMode) string {\n155\t\tvar buf [9]byte\n156\t\tconst rwx = \"rwx\"\n157\t\tfor i := range 9 {\n158\t\t\tif mode&(1<<uint(8-i)) != 0 {\n159\t\t\t\tbuf[i] = rwx[i%3]\n160\t\t\t} else {\n161\t\t\t\tbuf[i] = '-'\n162\t\t\t}\n163\t\t}\n164\t\tapplySpecialBits(&buf, mode)\n165\t\treturn string(buf[:])\n166\t}\n167\t\n168\tfunc applySpecialBits(buf *[9]byte, mode os.FileMode) {\n169\t\tif mode&os.ModeSetuid != 0 {\n170\t\t\tif buf[2] == 'x' {\n171\t\t\t\tbuf[2] = 's'\n172\t\t\t} else {\n173\t\t\t\tbuf[2] = 'S'\n174\t\t\t}\n175\t\t}\n176\t\tif mode&os.ModeSetgid != 0 {\n177\t\t\tif buf[5] == 'x' {\n178\t\t\t\tbuf[5] = 's'\n179\t\t\t} else {\n180\t\t\t\tbuf[5] = 'S'\n181\t\t\t}\n182\t\t}\n183\t\tif mode&os.ModeSticky != 0 {\n184\t\t\tif buf[8] == 'x' {\n185\t\t\t\tbuf[8] = 't'\n186\t\t\t} else {\n187\t\t\t\tbuf[8] = 'T'\n188\t\t\t}\n189\t\t}\n190\t}\n191\t\n192\tfunc parseArgs(args []string) (options, string, []string) {\n193\t\tvar opts options\n194\t\tvar files []string\n195\t\tmode := \"\"\n196\t\tendOfFlags := false\n197\t\tfor _, arg := range args {\n198\t\t\tif endOfFlags {\n199\t\t\t\tfiles = append(files, arg)\n200\t\t\t\tcontinue\n201\t\t\t}\n202\t\t\tif handled := handleSpecialArg(arg, &endOfFlags); handled {\n203\t\t\t\tcontinue\n204\t\t\t}\n205\t\t\tif parseLongFlag(arg, &opts) {\n206\t\t\t\tcontinue\n207\t\t\t}\n208\t\t\tif mode == \"\" {\n209\t\t\t\tif strings.HasPrefix(arg, \"-\") && parseShortFlags(arg[1:], &opts) {\n210\t\t\t\t\tcontinue\n211\t\t\t\t}\n212\t\t\t\tif opts.reference != \"\" {\n213\t\t\t\t\tfiles = append(files, arg)\n214\t\t\t\t} else {\n215\t\t\t\t\tmode = arg\n216\t\t\t\t}\n217\t\t\t} else {\n218\t\t\t\tfiles = append(files, arg)\n219\t\t\t}\n220\t\t}\n221\t\tif mode == \"\" && opts.reference == \"\" {\n222\t\t\tfmt.Fprintln(os.Stderr, \"chmod: missing operand\")\n223\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n224\t\t\tos.Exit(1)\n225\t\t}\n226\t\treturn opts, mode, files\n227\t}\n228\t\n229\tfunc handleSpecialArg(arg string, endOfFlags *bool) bool {\n230\t\tswitch arg {\n231\t\tcase \"--help\":\n232\t\t\tfmt.Fprint(os.Stdout, helpText)\n233\t\t\tos.Exit(0)\n234\t\tcase \"--version\":\n235\t\t\tfmt.Fprint(os.Stdout, versionText)\n236\t\t\tos.Exit(0)\n237\t\tcase \"--\":\n238\t\t\t*endOfFlags = true\n239\t\tdefault:\n240\t\t\treturn false\n241\t\t}\n242\t\treturn true\n243\t}\n244\t\n245\tfunc parseLongFlag(arg string, opts *options) bool {\n246\t\tswitch arg {\n247\t\tcase \"--verbose\":\n248\t\t\topts.verbose = true\n249\t\tcase \"--changes\":\n250\t\t\topts.changes = true\n251\t\tcase \"--silent\", \"--quiet\":\n252\t\t\topts.silent = true\n253\t\tcase \"--recursive\":\n254\t\t\topts.recursive = true\n255\t\tcase \"--preserve-root\":\n256\t\t\topts.preserveRoot = true\n257\t\tcase \"--no-preserve-root\":\n258\t\t\topts.preserveRoot = false\n259\t\tdefault:\n260\t\t\tif strings.HasPrefix(arg, \"--reference=\") {\n261\t\t\t\topts.reference = arg[len(\"--reference=\"):]\n262\t\t\t\treturn true\n263\t\t\t}\n264\t\t\treturn false\n265\t\t}\n266\t\treturn true\n267\t}\n268\t\n269\tfunc parseShortFlags(flags string, opts *options) bool {\n270\t\tfor _, c := range flags {\n271\t\t\tswitch c {\n272\t\t\tcase 'v':\n273\t\t\t\topts.verbose = true\n274\t\t\tcase 'c':\n275\t\t\t\topts.changes = true\n276\t\t\tcase 'f':\n277\t\t\t\topts.silent = true\n278\t\t\tcase 'R':\n279\t\t\t\topts.recursive = true\n280\t\t\tdefault:\n281\t\t\t\treturn false\n282\t\t\t}\n283\t\t}\n284\t\treturn true\n285\t}\n286\t\n287\tfunc validateMode(mode string) error {\n288\t\tif isOctalMode(mode) {\n289\t\t\t_, err := strconv.ParseUint(mode, 8, 32)\n290\t\t\treturn err\n291\t\t}\n292\t\t_, err := evalSymbolic(mode, 0, 0)\n293\t\treturn err\n294\t}\n295\t\n296\tfunc applyMode(mode string, path string) error {\n297\t\tif isOctalMode(mode) {\n298\t\t\treturn applyOctalMode(mode, path)\n299\t\t}\n300\t\treturn applySymbolicMode(mode, path)\n301\t}\n302\t\n303\tfunc isOctalMode(mode string) bool {\n304\t\ts := mode\n305\t\tif strings.HasPrefix(s, \"0\") && len(s) > 1 {\n306\t\t\ts = s[1:]\n307\t\t}\n308\t\tif len(s) == 0 {\n309\t\t\treturn false\n310\t\t}\n311\t\tfor _, c := range s {\n312\t\t\tif c < '0' || c > '7' {\n313\t\t\t\treturn false\n314\t\t\t}\n315\t\t}\n316\t\treturn true\n317\t}\n318\t\n319\tfunc applyOctalMode(mode string, path string) error {\n320\t\tval, err := strconv.ParseUint(mode, 8, 32)\n321\t\tif err != nil {\n322\t\t\treturn fmt.Errorf(\"invalid mode: %q\", mode)\n323\t\t}\n324\t\treturn os.Chmod(path, os.FileMode(val))\n325\t}\n326\t\n327\tfunc getUmask() os.FileMode {\n328\t\told := syscall.Umask(0)\n329\t\tsyscall.Umask(old)\n330\t\treturn os.FileMode(old)\n331\t}\n332\t\n333\tfunc applySymbolicMode(mode string, path string) error {\n334\t\tinfo, err := os.Stat(path)\n335\t\tif err != nil {\n336\t\t\treturn err\n337\t\t}\n338\t\tcurrent := info.Mode()\n339\t\tnewMode, err := evalSymbolic(mode, current, getUmask())\n340\t\tif err != nil {\n341\t\t\treturn err\n342\t\t}\n343\t\treturn os.Chmod(path, newMode)\n344\t}\n345\t\n346\tfunc resolveReference(rfile string) string {\n347\t\tinfo, err := os.Stat(rfile)\n348\t\tif err != nil {\n349\t\t\tfmt.Fprintf(os.Stderr, \"chmod: failed to get attributes of '%s': %s\\n\",\n350\t\t\t\trfile, err.(*os.PathError).Err)\n351\t\t\tos.Exit(1)\n352\t\t}\n353\t\tm := info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky))\n354\t\treturn fmt.Sprintf(\"%04o\", uint32(m))\n355\t}\n356\t\n357\tfunc isRootPath(path string) bool {\n358\t\tresolved, err := filepath.EvalSymlinks(path)\n359\t\tif err != nil {\n360\t\t\treturn path == \"/\"\n361\t\t}\n362\t\treturn resolved == \"/\"\n363\t}\n364\t\n365\tfunc formatErr(err error) string {\n366\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n367\t\t\treturn fmt.Sprintf(\"cannot access '%s': %s\", pe.Path, pe.Err)\n368\t\t}\n369\t\treturn err.Error()\n370\t}\n371\t"}]},"parent_tool_use_id":null,"session_id":"e0aad558-3b83-4cbd-a45c-b69252e89161","uuid":"be341434-7144-437c-bf9c-fe642f12b400","timestamp":"2026-05-27T14:47:23.442Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5587/cmd/chmod/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/chmod implements srd089-chmod R1.1-R1.4, R2.1-R2.4, R3.1-R3.2, R4.1-R4.3.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: chmod [OPTION]... MODE[,MODE]... FILE...\n  or:  chmod [OPTION]... OCTAL-MODE FILE...\n  or:  chmod [OPTION]... --reference=RFILE FILE...\nChange the mode of each FILE to MODE.\n\n  -c, --changes          like verbose but report only when a change is made\n  -f, --silent, --quiet  suppress most error messages\n  -v, --verbose          output a diagnostic for every file processed\n      --no-preserve-root  do not treat '/' specially (the default)\n      --preserve-root    fail to operate recursively on '/'\n      --reference=RFILE  use RFILE's mode instead of MODE values\n  -R, --recursive        change files and directories recursively\n      --help     display this help and exit\n      --version  output version information and exit\n\nEach MODE is of the form '[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+'.\n`\n\nconst versionText = `chmod (go-unix-utils) dev\n`\n\ntype options struct {\n\tverbose      bool\n\tchanges      bool\n\tsilent       bool\n\trecursive    bool\n\tpreserveRoot bool\n\treference    string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, mode, files := parseArgs(os.Args[1:])\n\tif opts.reference != \"\" {\n\t\tmode = resolveReference(opts.reference)\n\t} else if err := validateMode(mode); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"chmod: invalid mode: '%s'\\n\", mode)\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\tif len(files) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"chmod: missing operand after '%s'\\n\", mode)\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\n\texitCode := 0\n\tfor _, file := range files {\n\t\tif err := processFile(opts, mode, file); err != nil {\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc processFile(opts options, mode string, path string) error {\n\tif opts.recursive {\n\t\treturn processRecursive(opts, mode, path)\n\t}\n\treturn applyAndReport(opts, mode, path)\n}\n\nfunc processRecursive(opts options, mode string, root string) error {\n\tif opts.preserveRoot && isRootPath(root) {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"chmod: it is dangerous to operate recursively on '/'\\nchmod: use --no-preserve-root to override this failsafe\\n\")\n\t\treturn fmt.Errorf(\"refusing to operate on root\")\n\t}\n\tvar walkErr error\n\terr := filepath.WalkDir(root, func(path string, _ os.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treportError(opts, path, err)\n\t\t\twalkErr = err\n\t\t\treturn nil\n\t\t}\n\t\tif applyErr := applyAndReport(opts, mode, path); applyErr != nil {\n\t\t\twalkErr = applyErr\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn walkErr\n}\n\nfunc applyAndReport(opts options, mode string, path string) error {\n\toldMode, err := getMode(path)\n\tif err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tif err := applyMode(mode, path); err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tnewMode, err := getMode(path)\n\tif err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tprintDiagnostic(opts, path, oldMode, newMode)\n\treturn nil\n}\n\nfunc getMode(path string) (os.FileMode, error) {\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky)), nil\n}\n\nfunc reportError(opts options, _ string, err error) {\n\tif opts.silent {\n\t\treturn\n\t}\n\tfmt.Fprintf(os.Stderr, \"chmod: %s\\n\", formatErr(err))\n}\n\nfunc printDiagnostic(opts options, path string, oldMode, newMode os.FileMode) {\n\tif opts.verbose {\n\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n\t\treturn\n\t}\n\tif opts.changes && oldMode != newMode {\n\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n\t}\n}\n\nfunc symbolicString(mode os.FileMode) string {\n\tvar buf [9]byte\n\tconst rwx = \"rwx\"\n\tfor i := range 9 {\n\t\tif mode&(1<<uint(8-i)) != 0 {\n\t\t\tbuf[i] = rwx[i%3]\n\t\t} else {\n\t\t\tbuf[i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(&buf, mode)\n\treturn string(buf[:])\n}\n\nfunc applySpecialBits(buf *[9]byte, mode os.FileMode) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif buf[2] == 'x' {\n\t\t\tbuf[2] = 's'\n\t\t} else {\n\t\t\tbuf[2] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif buf[5] == 'x' {\n\t\t\tbuf[5] = 's'\n\t\t} else {\n\t\t\tbuf[5] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif buf[8] == 'x' {\n\t\t\tbuf[8] = 't'\n\t\t} else {\n\t\t\tbuf[8] = 'T'\n\t\t}\n\t}\n}\n\nfunc parseArgs(args []string) (options, string, []string) {\n\tvar opts options\n\tvar files []string\n\tmode := \"\"\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif handled := handleSpecialArg(arg, &endOfFlags); handled {\n\t\t\tcontinue\n\t\t}\n\t\tif parseLongFlag(arg, &opts) {\n\t\t\tcontinue\n\t\t}\n\t\tif mode == \"\" {\n\t\t\tif strings.HasPrefix(arg, \"-\") && parseShortFlags(arg[1:], &opts) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif opts.reference != \"\" {\n\t\t\t\tfiles = append(files, arg)\n\t\t\t} else {\n\t\t\t\tmode = arg\n\t\t\t}\n\t\t} else {\n\t\t\tfiles = append(files, arg)\n\t\t}\n\t}\n\tif mode == \"\" && opts.reference == \"\" {\n\t\tfmt.Fprintln(os.Stderr, \"chmod: missing operand\")\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\treturn opts, mode, files\n}\n\nfunc handleSpecialArg(arg string, endOfFlags *bool) bool {\n\tswitch arg {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase \"--\":\n\t\t*endOfFlags = true\n\tdefault:\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc parseLongFlag(arg string, opts *options) bool {\n\tswitch arg {\n\tcase \"--verbose\":\n\t\topts.verbose = true\n\tcase \"--changes\":\n\t\topts.changes = true\n\tcase \"--silent\", \"--quiet\":\n\t\topts.silent = true\n\tcase \"--recursive\":\n\t\topts.recursive = true\n\tcase \"--preserve-root\":\n\t\topts.preserveRoot = true\n\tcase \"--no-preserve-root\":\n\t\topts.preserveRoot = false\n\tdefault:\n\t\tif strings.HasPrefix(arg, \"--reference=\") {\n\t\t\topts.reference = arg[len(\"--reference=\"):]\n\t\t\treturn true\n\t\t}\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc parseShortFlags(flags string, opts *options) bool {\n\tfor _, c := range flags {\n\t\tswitch c {\n\t\tcase 'v':\n\t\t\topts.verbose = true\n\t\tcase 'c':\n\t\t\topts.changes = true\n\t\tcase 'f':\n\t\t\topts.silent = true\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tdefault:\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc validateMode(mode string) error {\n\tif isOctalMode(mode) {\n\t\t_, err := strconv.ParseUint(mode, 8, 32)\n\t\treturn err\n\t}\n\t_, err := evalSymbolic(mode, 0, 0)\n\treturn err\n}\n\nfunc applyMode(mode string, path string) error {\n\tif isOctalMode(mode) {\n\t\treturn applyOctalMode(mode, path)\n\t}\n\treturn applySymbolicMode(mode, path)\n}\n\nfunc isOctalMode(mode string) bool {\n\ts := mode\n\tif strings.HasPrefix(s, \"0\") && len(s) > 1 {\n\t\ts = s[1:]\n\t}\n\tif len(s) == 0 {\n\t\treturn false\n\t}\n\tfor _, c := range s {\n\t\tif c < '0' || c > '7' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc applyOctalMode(mode string, path string) error {\n\tval, err := strconv.ParseUint(mode, 8, 32)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid mode: %q\", mode)\n\t}\n\treturn os.Chmod(path, os.FileMode(val))\n}\n\nfunc getUmask() os.FileMode {\n\told := syscall.Umask(0)\n\tsyscall.Umask(old)\n\treturn os.FileMode(old)\n}\n\nfunc applySymbolicMode(mode string, path string) error {\n\tinfo, err := os.Stat(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tcurrent := info.Mode()\n\tnewMode, err := evalSymbolic(mode, current, getUmask())\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.Chmod(path, newMode)\n}\n\nfunc resolveReference(rfile string) string {\n\tinfo, err := os.Stat(rfile)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"chmod: failed to get attributes of '%s': %s\\n\",\n\t\t\trfile, err.(*os.PathError).Err)\n\t\tos.Exit(1)\n\t}\n\tm := info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky))\n\treturn fmt.Sprintf(\"%04o\", uint32(m))\n}\n\nfunc isRootPath(path string) bool {\n\tresolved, err := filepath.EvalSymlinks(path)\n\tif err != nil {\n\t\treturn path == \"/\"\n\t}\n\treturn resolved == \"/\"\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"cannot access '%s': %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n","numLines":371,"startLine":1,"totalLines":371}}}
