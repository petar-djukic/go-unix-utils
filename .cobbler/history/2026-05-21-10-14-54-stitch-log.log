t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar args []string\nvar pos int\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tif len(os.Args) < 2 {\n\t\tfmt.Fprintln(os.Stderr, \"expr: missing operand\")\n\t\tos.Exit(2)\n\t}\n\n\targs = os.Args[1:]\n\tpos = 0\n\n\tresult := parseOr()\n\n\tif pos != len(args) {\n\t\tfmt.Fprintln(os.Stderr, \"expr: syntax error: unexpected argument '\"+args[pos]+\"'\")\n\t\tos.Exit(2)\n\t}\n\n\tfmt.Println(result)\n\n\tif isNullOrZero(result) {\n\t\tos.Exit(1)\n\t}\n\tos.Exit(0)\n}\n\nfunc isNullOrZero(s string) bool {\n\tif s == \"\" || s == \"0\" {\n\t\treturn true\n\t}\n\tn, err := strconv.ParseInt(s, 10, 64)\n\treturn err == nil && n == 0\n}\n\nfunc peek() string {\n\tif pos >= len(args) {\n\t\treturn \"\"\n\t}\n\treturn args[pos]\n}\n\nfunc advance() string {\n\ttok := args[pos]\n\tpos++\n\treturn tok\n}\n\nfunc syntaxError() {\n\tif pos < len(args) {\n\t\tfmt.Fprintln(os.Stderr, \"expr: syntax error: unexpected argument '\"+args[pos]+\"'\")\n\t} else {\n\t\tfmt.Fprintln(os.Stderr, \"expr: syntax error: missing argument after '\"+args[pos-1]+\"'\")\n\t}\n\tos.Exit(2)\n}\n\nfunc parseOr() string {\n\tleft := parseAnd()\n\tfor peek() == \"|\" {\n\t\tadvance()\n\t\tif pos >= len(args) {\n\t\t\tsyntaxError()\n\t\t}\n\t\tright := parseAnd()\n\t\tif !isNullOrZero(left) {\n\t\t\t// left is truthy, return it\n\t\t} else {\n\t\t\tleft = right\n\t\t}\n\t}\n\treturn left\n}\n\nfunc parseAnd() string {\n\tleft := parseComparison()\n\tfor peek() == \"&\" {\n\t\tadvance()\n\t\tif pos >= len(args) {\n\t\t\tsyntaxError()\n\t\t}\n\t\tright := parseComparison()\n\t\tif !isNullOrZero(left) && !isNullOrZero(right) {\n\t\t\t// both truthy, return left\n\t\t} else {\n\t\t\tleft = \"0\"\n\t\t}\n\t}\n\treturn left\n}\n\nfunc parseComparison() string {\n\tleft := parseAddSub()\n\tfor {\n\t\top := peek()\n\t\tswitch op {\n\t\tcase \"<\", \"<=\", \"=\", \"!=\", \">=\", \">\":\n\t\t\tadvance()\n\t\t\tif pos >= len(args) {\n\t\t\t\tsyntaxError()\n\t\t\t}\n\t\t\tright := parseAddSub()\n\t\t\tleft = evalComparison(left, op, right)\n\t\tdefault:\n\t\t\treturn left\n\t\t}\n\t}\n}\n\nfunc evalComparison(left, op, right string) string {\n\tli, lErr := strconv.ParseInt(left, 10, 64)\n\tri, rErr := strconv.ParseInt(right, 10, 64)\n\n\tvar cmp int\n\tif lErr == nil && rErr == nil {\n\t\tswitch {\n\t\tcase li < ri:\n\t\t\tcmp = -1\n\t\tcase li > ri:\n\t\t\tcmp = 1\n\t\tdefault:\n\t\t\tcmp = 0\n\t\t}\n\t} else {\n\t\tcmp = strings.Compare(left, right)\n\t}\n\n\tvar result bool\n\tswitch op {\n\tcase \"<\":\n\t\tresult = cmp < 0\n\tcase \"<=\":\n\t\tresult = cmp <= 0\n\tcase \"=\":\n\t\tresult = cmp == 0\n\tcase \"!=\":\n\t\tresult = cmp != 0\n\tcase \">=\":\n\t\tresult = cmp >= 0\n\tcase \">\":\n\t\tresult = cmp > 0\n\t}\n\n\tif result {\n\t\treturn \"1\"\n\t}\n\treturn \"0\"\n}\n\nfunc parseAddSub() string {\n\tleft := parseMulDiv()\n\tfor {\n\t\top := peek()\n\t\tif op != \"+\" && op != \"-\" {\n\t\t\treturn left\n\t\t}\n\t\tadvance()\n\t\tif pos >= len(args) {\n\t\t\tsyntaxError()\n\t\t}\n\t\tright := parseMulDiv()\n\t\tleft = evalArithmetic(left, op, right)\n\t}\n}\n\nfunc parseMulDiv() string {\n\tleft := parsePrimary()\n\tfor {\n\t\top := peek()\n\t\tif op != \"*\" && op != \"/\" && op != \"%\" {\n\t\t\treturn left\n\t\t}\n\t\tadvance()\n\t\tif pos >= len(args) {\n\t\t\tsyntaxError()\n\t\t}\n\t\tright := parsePrimary()\n\t\tleft = evalArithmetic(left, op, right)\n\t}\n}\n\nfunc evalArithmetic(left, op, right string) string {\n\tl, lErr := strconv.ParseInt(left, 10, 64)\n\tr, rErr := strconv.ParseInt(right, 10, 64)\n\n\tif lErr != nil {\n\t\tfmt.Fprintf(os.Stderr, \"expr: non-integer argument '%s'\\n\", left)\n\t\tos.Exit(2)\n\t}\n\tif rErr != nil {\n\t\tfmt.Fprintf(os.Stderr, \"expr: non-integer argument '%s'\\n\", right)\n\t\tos.Exit(2)\n\t}\n\n\tswitch op {\n\tcase \"+\":\n\t\treturn strconv.FormatInt(l+r, 10)\n\tcase \"-\":\n\t\treturn strconv.FormatInt(l-r, 10)\n\tcase \"*\":\n\t\treturn strconv.FormatInt(l*r, 10)\n\tcase \"/\":\n\t\tif r == 0 {\n\t\t\tfmt.Fprintln(os.Stderr, \"expr: division by zero\")\n\t\t\tos.Exit(2)\n\t\t}\n\t\treturn strconv.FormatInt(l/r, 10)\n\tcase \"%\":\n\t\tif r == 0 {\n\t\t\tfmt.Fprintln(os.Stderr, \"expr: division by zero\")\n\t\t\tos.Exit(2)\n\t\t}\n\t\treturn strconv.FormatInt(l%r, 10)\n\t}\n\treturn \"0\"\n}\n\nfunc parsePrimary() string {\n\ttok := peek()\n\n\tif tok == \"\" {\n\t\tfmt.Fprintln(os.Stderr, \"expr: syntax error: missing argument\")\n\t\tos.Exit(2)\n\t}\n\n\tif tok == \"(\" {\n\t\tadvance()\n\t\tresult := parseOr()\n\t\tif peek() != \")\" {\n\t\t\tfmt.Fprintln(os.Stderr, \"expr: syntax error: expecting ')'\")\n\t\t\tos.Exit(2)\n\t\t}\n\t\tadvance()\n\t\treturn result\n\t}\n\n\tif tok == \"+\" {\n\t\tadvance()\n\t\tif pos >= len(args) {\n\t\t\tsyntaxError()\n\t\t}\n\t\treturn advance()\n\t}\n\n\tif tok == \"match\" {\n\t\treturn parseMatch()\n\t}\n\tif tok == \"substr\" {\n\t\treturn parseSubstr()\n\t}\n\tif tok == \"index\" {\n\t\treturn parseIndex()\n\t}\n\tif tok == \"length\" {\n\t\treturn parseLength()\n\t}\n\n\tadvance()\n\n\tif tok == \":\" {\n\t\tfmt.Fprintln(os.Stderr, \"expr: syntax error: unexpected argument ':'\")\n\t\tos.Exit(2)\n\t}\n\n\treturn maybeColon(tok)\n}\n\nfunc maybeColon(left string) string {\n\tif peek() == \":\" {\n\t\tadvance()\n\t\tif pos >= len(args) {\n\t\t\tsyntaxError()\n\t\t}\n\t\tpattern := advance()\n\t\treturn evalMatch(left, pattern)\n\t}\n\treturn left\n}\n\nfunc evalMatch(str, pattern string) string {\n\tfullPattern := \"^(?:\" + breToGoRegex(pattern) + \")\"\n\n\tre, err := regexp.Compile(fullPattern)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"expr: invalid regular expression '%s'\\n\", pattern)\n\t\tos.Exit(2)\n\t}\n\n\tm := re.FindStringSubmatch(str)\n\tif m == nil {\n\t\tif hasGroup(pattern) {\n\t\t\treturn \"\"\n\t\t}\n\t\treturn \"0\"\n\t}\n\n\tif len(m) > 1 {\n\t\treturn m[1]\n\t}\n\treturn strconv.Itoa(len(m[0]))\n}\n\nfunc hasGroup(pattern string) bool {\n\tfor i := 0; i < len(pattern)-1; i++ {\n\t\tif pattern[i] == '\\\\' && pattern[i+1] == '(' {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc breToGoRegex(pattern string) string {\n\tvar b strings.Builder\n\ti := 0\n\tfor i < len(pattern) {\n\t\tif pattern[i] == '\\\\' && i+1 < len(pattern) {\n\t\t\tnext := pattern[i+1]\n\t\t\tswitch next {\n\t\t\tcase '(':\n\t\t\t\tb.WriteByte('(')\n\t\t\t\ti += 2\n\t\t\tcase ')':\n\t\t\t\tb.WriteByte(')')\n\t\t\t\ti += 2\n\t\t\tcase '{':\n\t\t\t\tb.WriteByte('{')\n\t\t\t\ti += 2\n\t\t\tcase '}':\n\t\t\t\tb.WriteByte('}')\n\t\t\t\ti += 2\n\t\t\tcase '+':\n\t\t\t\tb.WriteByte('+')\n\t\t\t\ti += 2\n\t\t\tcase '?':\n\t\t\t\tb.WriteByte('?')\n\t\t\t\ti += 2\n\t\t\tcase '|':\n\t\t\t\tb.WriteByte('|')\n\t\t\t\ti += 2\n\t\t\tcase '1', '2', '3', '4', '5', '6', '7', '8', '9':\n\t\t\t\tb.WriteByte('\\\\')\n\t\t\t\tb.WriteByte(next)\n\t\t\t\ti += 2\n\t\t\tdefault:\n\t\t\t\tb.WriteByte('\\\\')\n\t\t\t\tb.WriteByte(next)\n\t\t\t\ti += 2\n\t\t\t}\n\t\t} else {\n\t\t\tch := pattern[i]\n\t\t\tswitch ch {\n\t\t\tcase '(', ')', '{', '}', '+', '?', '|':\n\t\t\t\tb.WriteByte('\\\\')\n\t\t\t\tb.WriteByte(ch)\n\t\t\tdefault:\n\t\t\t\tb.WriteByte(ch)\n\t\t\t}\n\t\t\ti++\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc parseMatch() string {\n\tadvance() // consume \"match\"\n\tif pos+1 >= len(args) {\n\t\tsyntaxError()\n\t}\n\tstr := advance()\n\tpattern := advance()\n\treturn evalMatch(str, pattern)\n}\n\nfunc parseSubstr() string {\n\tadvance() // consume \"substr\"\n\tif pos+2 >= len(args) {\n\t\tsyntaxError()\n\t}\n\tstr := advance()\n\tposStr := advance()\n\tlenStr := advance()\n\n\tp, err := strconv.Atoi(posStr)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"expr: non-integer argument '%s'\\n\", posStr)\n\t\tos.Exit(2)\n\t}\n\tl, err := strconv.Atoi(lenStr)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"expr: non-integer argument '%s'\\n\", lenStr)\n\t\tos.Exit(2)\n\t}\n\n\trunes := []rune(str)\n\tif p < 1 || l < 0 || p > len(runes) {\n\t\treturn \"\"\n\t}\n\tend := p - 1 + l\n\tif end > len(runes) {\n\t\tend = len(runes)\n\t}\n\treturn string(runes[p-1 : end])\n}\n\nfunc parseIndex() string {\n\tadvance() // consume \"index\"\n\tif pos+1 >= len(args) {\n\t\tsyntaxError()\n\t}\n\tstr := advance()\n\tchars := advance()\n\n\tfor i, ch := range str {\n\t\tif strings.ContainsRune(chars, ch) {\n\t\t\treturn strconv.Itoa(i + 1)\n\t\t}\n\t}\n\treturn \"0\"\n}\n\nfunc parseLength() string {\n\tadvance() // consume \"length\"\n\tif pos >= len(args) {\n\t\tsyntaxError()\n\t}\n\tstr := advance()\n\treturn strconv.Itoa(len([]rune(str)))\n}\n\n// Ensure big is referenced (used for potential future arbitrary precision).\nvar _ = big.NewInt\n","userModified":false}}
