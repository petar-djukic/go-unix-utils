{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BWnvjUHESjSaDZCTJhCDiB","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Package hashutil provides shared hash output formatting and checksum\n5\t// verification logic for md5sum, sha1sum, sha256sum, sha512sum, sha224sum,\n6\t// sha384sum, b2sum, cksum, and sum utilities.\n7\t// Implements srd086-hashutil R1.1, R1.2, R1.3, R1.4.\n8\tpackage hashutil\n9\t\n10\timport (\n11\t\t\"encoding/hex\"\n12\t\t\"fmt\"\n13\t\t\"hash\"\n14\t\t\"io\"\n15\t)\n16\t\n17\t// HashConfig parameterizes a hash utility with its algorithm name, hash\n18\t// factory, and expected digest length. (R1.1)\n19\ttype HashConfig struct {\n20\t\tAlgorithm string\n21\t\tNewHash   func() hash.Hash\n22\t\tDigestLen int\n23\t}\n24\t\n25\t// CheckOptions controls --check mode output behavior. (R1.2 / R2.2)\n26\ttype CheckOptions struct {\n27\t\tWarn   bool\n28\t\tQuiet  bool\n29\t\tStatus bool\n30\t}\n31\t\n32\t// FormatGNU formats a digest and filename in GNU coreutils format.\n33\t// Text mode: \"HASH  FILENAME\"; binary mode: \"HASH *FILENAME\". (R1.3)\n34\tfunc FormatGNU(digest, filename string, binary bool) string {\n35\t\tif binary {\n36\t\t\treturn fmt.Sprintf(\"%s *%s\", digest, filename)\n37\t\t}\n38\t\treturn fmt.Sprintf(\"%s  %s\", digest, filename)\n39\t}\n40\t\n41\t// FormatBSDTag formats a digest in BSD tag format:\n42\t// \"ALGORITHM (FILENAME) = HASH\". (R1.3)\n43\tfunc FormatBSDTag(algorithm, filename, digest string) string {\n44\t\treturn fmt.Sprintf(\"%s (%s) = %s\", algorithm, filename, digest)\n45\t}\n46\t\n47\t// ComputeDigest reads all bytes from r, computes the hash using cfg, and\n48\t// returns the lowercase hex-encoded digest string. (R1.4)\n49\tfunc ComputeDigest(r io.Reader, cfg HashConfig) (string, error) {\n50\t\th := cfg.NewHash()\n51\t\tif _, err := io.Copy(h, r); err != nil {\n52\t\t\treturn \"\", fmt.Errorf(\"computing digest: %w\", err)\n53\t\t}\n54\t\treturn hex.EncodeToString(h.Sum(nil)), nil\n55\t}\n56\t\n57\t// ParseChecksumLine parses a single checksum line in GNU or BSD tag format.\n58\t// (R1.4 / R2.1)\n59\tfunc ParseChecksumLine(line string, cfg HashConfig) (filename, expectedDigest string, binary bool, err error) {\n60\t\treturn \"\", \"\", false, nil\n61\t}\n62\t\n63\t// VerifyChecksums reads a checksum file and verifies each entry against the\n64\t// actual file contents. (R1.4 / R2.3)\n65\tfunc VerifyChecksums(checksumFile string, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) (bool, error) {\n66\t\treturn false, nil\n67\t}\n68\t\n69\t// DigestFiles computes and prints digests for each file in the list. (R1.4 / R3.1)\n70\tfunc DigestFiles(files []string, cfg HashConfig, binary, tag bool, stdout, stderr io.Writer) int {\n71\t\treturn 0\n72\t}\n73\t"}]},"parent_tool_use_id":null,"session_id":"3ce4b834-9763-4ac2-9cd8-c96dba42c885","uuid":"b8f17ff7-9e5d-46ec-90b5-644efdc5f225","timestamp":"2026-05-14T00:32:42.866Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5106/pkg/hashutil/hashconfig.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package hashutil provides shared hash output formatting and checksum\n// verification logic for md5sum, sha1sum, sha256sum, sha512sum, sha224sum,\n// sha384sum, b2sum, cksum, and sum utilities.\n// Implements srd086-hashutil R1.1, R1.2, R1.3, R1.4.\npackage hashutil\n\nimport (\n\t\"encoding/hex\"\n\t\"fmt\"\n\t\"hash\"\n\t\"io\"\n)\n\n// HashConfig parameterizes a hash utility with its algorithm name, hash\n// factory, and expected digest length. (R1.1)\ntype HashConfig struct {\n\tAlgorithm string\n\tNewHash   func() hash.Hash\n\tDigestLen int\n}\n\n// CheckOptions controls --check mode output behavior. (R1.2 / R2.2)\ntype CheckOptions struct {\n\tWarn   bool\n\tQuiet  bool\n\tStatus bool\n}\n\n// FormatGNU formats a digest and filename in GNU coreutils format.\n// Text mode: \"HASH  FILENAME\"; binary mode: \"HASH *FILENAME\". (R1.3)\nfunc FormatGNU(digest, filename string, binary bool) string {\n\tif binary {\n\t\treturn fmt.Sprintf(\"%s *%s\", digest, filename)\n\t}\n\treturn fmt.Sprintf(\"%s  %s\", digest, filename)\n}\n\n// FormatBSDTag formats a digest in BSD tag format:\n// \"ALGORITHM (FILENAME) = HASH\". (R1.3)\nfunc FormatBSDTag(algorithm, filename, digest string) string {\n\treturn fmt.Sprintf(\"%s (%s) = %s\", algorithm, filename, digest)\n}\n\n// ComputeDigest reads all bytes from r, computes the hash using cfg, and\n// returns the lowercase hex-encoded digest string. (R1.4)\nfunc ComputeDigest(r io.Reader, cfg HashConfig) (string, error) {\n\th := cfg.NewHash()\n\tif _, err := io.Copy(h, r); err != nil {\n\t\treturn \"\", fmt.Errorf(\"computing digest: %w\", err)\n\t}\n\treturn hex.EncodeToString(h.Sum(nil)), nil\n}\n\n// ParseChecksumLine parses a single checksum line in GNU or BSD tag format.\n// (R1.4 / R2.1)\nfunc ParseChecksumLine(line string, cfg HashConfig) (filename, expectedDigest string, binary bool, err error) {\n\treturn \"\", \"\", false, nil\n}\n\n// VerifyChecksums reads a checksum file and verifies each entry against the\n// actual file contents. (R1.4 / R2.3)\nfunc VerifyChecksums(checksumFile string, cfg HashConfig, opts CheckOptions, stdout, stderr io.Writer) (bool, error) {\n\treturn false, nil\n}\n\n// DigestFiles computes and prints digests for each file in the list. (R1.4 / R3.1)\nfunc DigestFiles(files []string, cfg HashConfig, binary, tag bool, stdout, stderr io.Writer) int {\n\treturn 0\n}\n","numLines":73,"startLine":1,"totalLines":73}}}
