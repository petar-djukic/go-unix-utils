t\t\tmode = modeHuman\n77\t\t\tcase \"-H\", \"--si\":\n78\t\t\t\tmode = modeSI\n79\t\t\tdefault:\n80\t\t\t\tfiles = append(files, arg)\n81\t\t\t}\n82\t\t}\n83\t\treturn mode, files\n84\t}\n85\t\n86\tfunc listAll(mode sizeMode) int {\n87\t\tstats, err := getAllMounts()\n88\t\tif err != nil {\n89\t\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n90\t\t\treturn 1\n91\t\t}\n92\t\tentries := filterAndDedup(stats)\n93\t\tprintTable(entries, mode)\n94\t\treturn 0\n95\t}\n96\t\n97\tfunc listPaths(paths []string, mode sizeMode) int {\n98\t\tstats, err := getAllMounts()\n99\t\tif err != nil {\n100\t\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n101\t\t\treturn 1\n102\t\t}\n103\t\tdevMap := buildDevMap(stats)\n104\t\texitCode := 0\n105\t\tentries := make([]fsEntry, 0, len(paths))\n106\t\tfor _, path := range paths {\n107\t\t\tentry, err := entryForPath(path, devMap)\n108\t\t\tif err != nil {\n109\t\t\t\tfmt.Fprintf(os.Stderr, \"df: %s: %s\\n\", path, capitalizeErr(err))\n110\t\t\t\texitCode = 1\n111\t\t\t\tcontinue\n112\t\t\t}\n113\t\t\tentries = append(entries, entry)\n114\t\t}\n115\t\tif len(entries) > 0 {\n116\t\t\tprintTable(entries, mode)\n117\t\t}\n118\t\treturn exitCode\n119\t}\n120\t\n121\tfunc capitalizeErr(err error) string {\n122\t\ts := err.Error()\n123\t\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n124\t\t\treturn strings.ToUpper(s[:1]) + s[1:]\n125\t\t}\n126\t\treturn s\n127\t}\n128\t\n129\tfunc getAllMounts() ([]unix.Statfs_t, error) {\n130\t\tn, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)\n131\t\tif err != nil {\n132\t\t\treturn nil, err\n133\t\t}\n134\t\tbuf := make([]unix.Statfs_t, n)\n135\t\tn, err = unix.Getfsstat(buf, unix.MNT_NOWAIT)\n136\t\tif err != nil {\n137\t\t\treturn nil, err\n138\t\t}\n139\t\treturn buf[:n], nil\n140\t}\n141\t\n142\tfunc isDummyType(t string) bool {\n143\t\treturn t == \"devfs\" || t == \"autofs\"\n144\t}\n145\t\n146\tfunc filterAndDedup(stats []unix.Statfs_t) []fsEntry {\n147\t\tseen := make(map[int32]bool)\n148\t\tentries := make([]fsEntry, 0, len(stats))\n149\t\tfor _, s := range stats {\n150\t\t\tif isDummyType(cstring(s.Fstypename[:])) {\n151\t\t\t\tcontinue\n152\t\t\t}\n153\t\t\tif s.Blocks == 0 {\n154\t\t\t\tcontinue\n155\t\t\t}\n156\t\t\tdev, ok := mountDev(cstring(s.Mntonname[:]))\n157\t\t\tif !ok {\n158\t\t\t\tcontinue\n159\t\t\t}\n160\t\t\tif seen[dev] {\n161\t\t\t\tcontinue\n162\t\t\t}\n163\t\t\tseen[dev] = true\n164\t\t\tentries = append(entries, buildEntry(s))\n165\t\t}\n166\t\treturn entries\n167\t}\n168\t\n169\tfunc buildDevMap(stats []unix.Statfs_t) map[int32]string {\n170\t\tm := make(map[int32]string, len(stats))\n171\t\tfor _, s := range stats {\n172\t\t\tmount := cstring(s.Mntonname[:])\n173\t\t\tdev, ok := mountDev(mount)\n174\t\t\tif !ok {\n175\t\t\t\tcontinue\n176\t\t\t}\n177\t\t\tif _, exists := m[dev]; !exists {\n178\t\t\t\tm[dev] = mount\n179\t\t\t}\n180\t\t}\n181\t\treturn m\n182\t}\n183\t\n184\tfunc entryForPath(path string, devMap map[int32]string) (fsEntry, error) {\n185\t\tvar info syscall.Stat_t\n186\t\tif err := syscall.Stat(path, &info); err != nil {\n187\t\t\treturn fsEntry{}, err\n188\t\t}\n189\t\ttarget := path\n190\t\tif mount, ok := devMap[info.Dev]; ok {\n191\t\t\ttarget = mount\n192\t\t}\n193\t\tvar stat unix.Statfs_t\n194\t\tif err := unix.Statfs(target, &stat); err != nil {\n195\t\t\treturn fsEntry{}, err\n196\t\t}\n197\t\treturn buildEntry(stat), nil\n198\t}\n199\t\n200\tfunc mountDev(mount string) (int32, bool) {\n201\t\tvar info syscall.Stat_t\n202\t\tif err := syscall.Stat(mount, &info); err != nil {\n203\t\t\treturn 0, false\n204\t\t}\n205\t\treturn info.Dev, true\n206\t}\n207\t\n208\tfunc buildEntry(stat unix.Statfs_t) fsEntry {\n209\t\tbsize := uint64(stat.Bsize)\n210\t\ttotalBytes := int64(stat.Blocks * bsize)\n211\t\tfreeBytes := int64(stat.Bfree * bsize)\n212\t\tavailBytes := int64(stat.Bavail * bsize)\n213\t\ttotal := totalBytes / 1024\n214\t\tfree := freeBytes / 1024\n215\t\tavail := availBytes / 1024\n216\t\treturn fsEntry{\n217\t\t\tfilesystem: cstring(stat.Mntfromname[:]),\n218\t\t\tblocks1K:   total,\n219\t\t\tused:       total - free,\n220\t\t\tavailable:  avail,\n221\t\t\tsizeBytes:  totalBytes,\n222\t\t\tusedBytes:  totalBytes - freeBytes,\n223\t\t\tavailBytes: availBytes,\n224\t\t\tusePercent: computeUsePercent(total, avail),\n225\t\t\tmountedOn:  cstring(stat.Mntonname[:]),\n226\t\t}\n227\t}\n228\t\n229\tfunc computeUsePercent(total, avail int64) string {\n230\t\tif total == 0 {\n231\t\t\treturn \"-\"\n232\t\t}\n233\t\tused := total - avail\n234\t\tif used <= 0 {\n235\t\t\treturn \"0%\"\n236\t\t}\n237\t\tpct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n238\t\treturn strconv.FormatInt(pct, 10) + \"%\"\n239\t}\n240\t\n241\tfunc humanSize(bytes int64, base float64) string {\n242\t\tif bytes == 0 {\n243\t\t\treturn \"0\"\n244\t\t}\n245\t\tval := float64(bytes)\n246\t\tidx := 0\n247\t\tfor idx < len(humanSuffixes)-1 && val >= base {\n248\t\t\tval /= base\n249\t\t\tidx++\n250\t\t}\n251\t\treturn formatHuman(val, humanSuffixes[idx])\n252\t}\n253\t\n254\tfunc formatHuman(val float64, suffix string) string {\n255\t\tif suffix == \"\" {\n256\t\t\treturn strconv.FormatInt(int64(math.Ceil(val)), 10)\n257\t\t}\n258\t\tceiled := math.Ceil(val*10) / 10\n259\t\tif ceiled < 10 {\n260\t\t\treturn fmt.Sprintf(\"%.1f%s\", ceiled, suffix)\n261\t\t}\n262\t\treturn fmt.Sprintf(\"%d%s\", int64(math.Ceil(val)), suffix)\n263\t}\n264\t\n265\tfunc formatSize(blocks1K, sizeBytes int64, mode sizeMode) string {\n266\t\tswitch mode {\n267\t\tcase modeHuman:\n268\t\t\treturn humanSize(sizeBytes, 1024)\n269\t\tcase modeSI:\n270\t\t\treturn humanSize(sizeBytes, 1000)\n271\t\tdefault:\n272\t\t\treturn strconv.FormatInt(blocks1K, 10)\n273\t\t}\n274\t}\n275\t\n276\tfunc getHeaders(mode sizeMode) [6]string {\n277\t\tif mode != modeDefault {\n278\t\t\treturn humanHeaders\n279\t\t}\n280\t\treturn defaultHeaders\n281\t}\n282\t\n283\tfunc printTable(entries []fsEntry, mode sizeMode) {\n284\t\tw := computeWidths(entries, mode)\n285\t\tprintLine(getHeaders(mode), w)\n286\t\tfor _, e := range entries {\n287\t\t\tprintLine(entryStrings(e, mode), w)\n288\t\t}\n289\t}\n290\t\n291\tfunc entryStrings(e fsEntry, mode sizeMode) [6]string {\n292\t\treturn [6]string{\n293\t\t\te.filesystem,\n294\t\t\tformatSize(e.blocks1K, e.sizeBytes, mode),\n295\t\t\tformatSize(e.used, e.usedBytes, mode),\n296\t\t\tformatSize(e.available, e.availBytes, mode),\n297\t\t\te.usePercent,\n298\t\t\te.mountedOn,\n299\t\t}\n300\t}\n301\t\n302\tfunc computeWidths(entries []fsEntry, mode sizeMode) [6]int {\n303\t\th := getHeaders(mode)\n304\t\tw := [6]int{len(h[0]), len(h[1]), len(h[2]), len(h[3]), len(h[4]), len(h[5])}\n305\t\tfor _, e := range entries {\n306\t\t\tcols := entryStrings(e, mode)\n307\t\t\tfor i := range w {\n308\t\t\t\tif len(cols[i]) > w[i] {\n309\t\t\t\t\tw[i] = len(cols[i])\n310\t\t\t\t}\n311\t\t\t}\n312\t\t}\n313\t\tfor i := 1; i <= 3; i++ {\n314\t\t\tif w[i] < 5 {\n315\t\t\t\tw[i] = 5\n316\t\t\t}\n317\t\t}\n318\t\treturn w\n319\t}\n320\t\n321\tfunc printLine(cols [6]string, w [6]int) {\n322\t\tfmt.Printf(\"%s %s %s %s %s %s\\n\",\n323\t\t\tformat.PadRight(cols[0], w[0]),\n324\t\t\tformat.PadLeft(cols[1], w[1]),\n325\t\t\tformat.PadLeft(cols[2], w[2]),\n326\t\t\tformat.PadLeft(cols[3], w[3]),\n327\t\t\tformat.PadLeft(cols[4], w[4]),\n328\t\t\tcols[5],\n329\t\t)\n330\t}\n331\t\n332\tfunc cstring(b []byte) string {\n333\t\tfor i, v := range b {\n334\t\t\tif v == 0 {\n335\t\t\t\treturn string(b[:i])\n336\t\t\t}\n337\t\t}\n338\t\treturn string(b)\n339\t}\n340\t"}]},"parent_tool_use_id":null,"session_id":"23c1c290-2627-430c-aa84-94704d0f6b79","uuid":"fdef0a15-b793-4df4-9557-b2552c5ef5c8","timestamp":"2026-05-27T20:00:14.965Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5607/cmd/df/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd106-df R1.1-R1.5, R2.1-R2.3.\npackage main\n\nimport (\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/format\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n\t\"golang.org/x/sys/unix\"\n)\n\ntype sizeMode int\n\nconst (\n\tmodeDefault sizeMode = iota\n\tmodeHuman\n\tmodeSI\n)\n\ntype fsEntry struct {\n\tfilesystem string\n\tblocks1K   int64\n\tused       int64\n\tavailable  int64\n\tsizeBytes  int64\n\tusedBytes  int64\n\tavailBytes int64\n\tusePercent string\n\tmountedOn  string\n}\n\nvar defaultHeaders = [6]string{\n\t\"Filesystem\", \"1K-blocks\", \"Used\", \"Available\", \"Use%\", \"Mounted on\",\n}\n\nvar humanHeaders = [6]string{\n\t\"Filesystem\", \"Size\", \"Used\", \"Avail\", \"Use%\", \"Mounted on\",\n}\n\nvar humanSuffixes = []string{\"\", \"K\", \"M\", \"G\", \"T\", \"P\", \"E\"}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run(os.Args[1:]))\n}\n\nfunc run(args []string) int {\n\tmode, files := parseArgs(args)\n\tif len(files) == 0 {\n\t\treturn listAll(mode)\n\t}\n\treturn listPaths(files, mode)\n}\n\nfunc parseArgs(args []string) (sizeMode, []string) {\n\tmode := modeDefault\n\tvar files []string\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tswitch arg {\n\t\tcase \"--\":\n\t\t\tendOfFlags = true\n\t\tcase \"-h\", \"--human-readable\":\n\t\t\tmode = modeHuman\n\t\tcase \"-H\", \"--si\":\n\t\t\tmode = modeSI\n\t\tdefault:\n\t\t\tfiles = append(files, arg)\n\t\t}\n\t}\n\treturn mode, files\n}\n\nfunc listAll(mode sizeMode) int {\n\tstats, err := getAllMounts()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n\t\treturn 1\n\t}\n\tentries := filterAndDedup(stats)\n\tprintTable(entries, mode)\n\treturn 0\n}\n\nfunc listPaths(paths []string, mode sizeMode) int {\n\tstats, err := getAllMounts()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"df: %v\\n\", err)\n\t\treturn 1\n\t}\n\tdevMap := buildDevMap(stats)\n\texitCode := 0\n\tentries := make([]fsEntry, 0, len(paths))\n\tfor _, path := range paths {\n\t\tentry, err := entryForPath(path, devMap)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"df: %s: %s\\n\", path, capitalizeErr(err))\n\t\t\texitCode = 1\n\t\t\tcontinue\n\t\t}\n\t\tentries = append(entries, entry)\n\t}\n\tif len(entries) > 0 {\n\t\tprintTable(entries, mode)\n\t}\n\treturn exitCode\n}\n\nfunc capitalizeErr(err error) string {\n\ts := err.Error()\n\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n\t\treturn strings.ToUpper(s[:1]) + s[1:]\n\t}\n\treturn s\n}\n\nfunc getAllMounts() ([]unix.Statfs_t, error) {\n\tn, err := unix.Getfsstat(nil, unix.MNT_NOWAIT)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tbuf := make([]unix.Statfs_t, n)\n\tn, err = unix.Getfsstat(buf, unix.MNT_NOWAIT)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn buf[:n], nil\n}\n\nfunc isDummyType(t string) bool {\n\treturn t == \"devfs\" || t == \"autofs\"\n}\n\nfunc filterAndDedup(stats []unix.Statfs_t) []fsEntry {\n\tseen := make(map[int32]bool)\n\tentries := make([]fsEntry, 0, len(stats))\n\tfor _, s := range stats {\n\t\tif isDummyType(cstring(s.Fstypename[:])) {\n\t\t\tcontinue\n\t\t}\n\t\tif s.Blocks == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tdev, ok := mountDev(cstring(s.Mntonname[:]))\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif seen[dev] {\n\t\t\tcontinue\n\t\t}\n\t\tseen[dev] = true\n\t\tentries = append(entries, buildEntry(s))\n\t}\n\treturn entries\n}\n\nfunc buildDevMap(stats []unix.Statfs_t) map[int32]string {\n\tm := make(map[int32]string, len(stats))\n\tfor _, s := range stats {\n\t\tmount := cstring(s.Mntonname[:])\n\t\tdev, ok := mountDev(mount)\n\t\tif !ok {\n\t\t\tcontinue\n\t\t}\n\t\tif _, exists := m[dev]; !exists {\n\t\t\tm[dev] = mount\n\t\t}\n\t}\n\treturn m\n}\n\nfunc entryForPath(path string, devMap map[int32]string) (fsEntry, error) {\n\tvar info syscall.Stat_t\n\tif err := syscall.Stat(path, &info); err != nil {\n\t\treturn fsEntry{}, err\n\t}\n\ttarget := path\n\tif mount, ok := devMap[info.Dev]; ok {\n\t\ttarget = mount\n\t}\n\tvar stat unix.Statfs_t\n\tif err := unix.Statfs(target, &stat); err != nil {\n\t\treturn fsEntry{}, err\n\t}\n\treturn buildEntry(stat), nil\n}\n\nfunc mountDev(mount string) (int32, bool) {\n\tvar info syscall.Stat_t\n\tif err := syscall.Stat(mount, &info); err != nil {\n\t\treturn 0, false\n\t}\n\treturn info.Dev, true\n}\n\nfunc buildEntry(stat unix.Statfs_t) fsEntry {\n\tbsize := uint64(stat.Bsize)\n\ttotalBytes := int64(stat.Blocks * bsize)\n\tfreeBytes := int64(stat.Bfree * bsize)\n\tavailBytes := int64(stat.Bavail * bsize)\n\ttotal := totalBytes / 1024\n\tfree := freeBytes / 1024\n\tavail := availBytes / 1024\n\treturn fsEntry{\n\t\tfilesystem: cstring(stat.Mntfromname[:]),\n\t\tblocks1K:   total,\n\t\tused:       total - free,\n\t\tavailable:  avail,\n\t\tsizeBytes:  totalBytes,\n\t\tusedBytes:  totalBytes - freeBytes,\n\t\tavailBytes: availBytes,\n\t\tusePercent: computeUsePercent(total, avail),\n\t\tmountedOn:  cstring(stat.Mntonname[:]),\n\t}\n}\n\nfunc computeUsePercent(total, avail int64) string {\n\tif total == 0 {\n\t\treturn \"-\"\n\t}\n\tused := total - avail\n\tif used <= 0 {\n\t\treturn \"0%\"\n\t}\n\tpct := int64(math.Ceil(float64(used) * 100 / float64(total)))\n\treturn strconv.FormatInt(pct, 10) + \"%\"\n}\n\nfunc humanSize(bytes int64, base float64) string {\n\tif bytes == 0 {\n\t\treturn \"0\"\n\t}\n\tval := float64(bytes)\n\tidx := 0\n\tfor idx < len(humanSuffixes)-1 && val >= base {\n\t\tval /= base\n\t\tidx++\n\t}\n\treturn formatHuman(val, humanSuffixes[idx])\n}\n\nfunc formatHuman(val float64, suffix string) string {\n\tif suffix == \"\" {\n\t\treturn strconv.FormatInt(int64(math.Ceil(val)), 10)\n\t}\n\tceiled := math.Ceil(val*10) / 10\n\tif ceiled < 10 {\n\t\treturn fmt.Sprintf(\"%.1f%s\", ceiled, suffix)\n\t}\n\treturn fmt.Sprintf(\"%d%s\", int64(math.Ceil(val)), suffix)\n}\n\nfunc formatSize(blocks1K, sizeBytes int64, mode sizeMode) string {\n\tswitch mode {\n\tcase modeHuman:\n\t\treturn humanSize(sizeBytes, 1024)\n\tcase modeSI:\n\t\treturn humanSize(sizeBytes, 1000)\n\tdefault:\n\t\treturn strconv.FormatInt(blocks1K, 10)\n\t}\n}\n\nfunc getHeaders(mode sizeMode) [6]string {\n\tif mode != modeDefault {\n\t\treturn humanHeaders\n\t}\n\treturn defaultHeaders\n}\n\nfunc printTable(entries []fsEntry, mode sizeMode) {\n\tw := computeWidths(entries, mode)\n\tprintLine(getHeaders(mode), w)\n\tfor _, e := range entries {\n\t\tprintLine(entryStrings(e, mode), w)\n\t}\n}\n\nfunc entryStrings(e fsEntry, mode sizeMode) [6]string {\n\treturn [6]string{\n\t\te.filesystem,\n\t\tformatSize(e.blocks1K, e.sizeBytes, mode),\n\t\tformatSize(e.used, e.usedBytes, mode),\n\t\tformatSize(e.available, e.availBytes, mode),\n\t\te.usePercent,\n\t\te.mountedOn,\n\t}\n}\n\nfunc computeWidths(entries []fsEntry, mode sizeMode) [6]int {\n\th := getHeaders(mode)\n\tw := [6]int{len(h[0]), len(h[1]), len(h[2]), len(h[3]), len(h[4]), len(h[5])}\n\tfor _, e := range entries {\n\t\tcols := entryStrings(e, mode)\n\t\tfor i := range w {\n\t\t\tif len(cols[i]) > w[i] {\n\t\t\t\tw[i] = len(cols[i])\n\t\t\t}\n\t\t}\n\t}\n\tfor i := 1; i <= 3; i++ {\n\t\tif w[i] < 5 {\n\t\t\tw[i] = 5\n\t\t}\n\t}\n\treturn w\n}\n\nfunc printLine(cols [6]string, w [6]int) {\n\tfmt.Printf(\"%s %s %s %s %s %s\\n\",\n\t\tformat.PadRight(cols[0], w[0]),\n\t\tformat.PadLeft(cols[1], w[1]),\n\t\tformat.PadLeft(cols[2], w[2]),\n\t\tformat.PadLeft(cols[3], w[3]),\n\t\tformat.PadLeft(cols[4], w[4]),\n\t\tcols[5],\n\t)\n}\n\nfunc cstring(b []byte) string {\n\tfor i, v := range b {\n\t\tif v == 0 {\n\t\t\treturn string(b[:i])\n\t\t}\n\t}\n\treturn string(b)\n}\n","numLines":340,"startLine":1,"totalLines":340}}}
