{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K76RwH4hrrAnEMw1obg5F7","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage format\n5\t\n6\timport (\n7\t\t\"io\"\n8\t\t\"os\"\n9\t\t\"sync\"\n10\t\n11\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n12\t)\n13\t\n14\tconst (\n15\t\tansiReset    = \"\\033[0m\"\n16\t\tansiDir      = \"\\033[01;34m\"\n17\t\tansiSymlink  = \"\\033[01;36m\"\n18\t\tansiExec     = \"\\033[01;32m\"\n19\t\tansiFifo     = \"\\033[40;33m\"\n20\t\tansiSocket   = \"\\033[01;35m\"\n21\t\tansiBlockDev = \"\\033[01;33m\"\n22\t\tansiCharDev  = \"\\033[01;33m\"\n23\t)\n24\t\n25\tvar (\n26\t\tcolorMu       sync.RWMutex\n27\t\tcolorOverride *bool\n28\t)\n29\t\n30\tfunc colorDisabled() bool {\n31\t\tcolorMu.RLock()\n32\t\toverride := colorOverride\n33\t\tcolorMu.RUnlock()\n34\t\treturn override != nil && !*override\n35\t}\n36\t\n37\t// FileTypeColor returns the ANSI escape sequence for a file's type.\n38\t// R2.1, R2.4, R2.6: returns empty string when color is explicitly disabled via SetColorEnabled(false).\n39\tfunc FileTypeColor(mode os.FileMode) string {\n40\t\tif colorDisabled() {\n41\t\t\treturn \"\"\n42\t\t}\n43\t\tswitch {\n44\t\tcase mode&os.ModeDir != 0:\n45\t\t\treturn ansiDir\n46\t\tcase mode&os.ModeSymlink != 0:\n47\t\t\treturn ansiSymlink\n48\t\tcase mode&os.ModeNamedPipe != 0:\n49\t\t\treturn ansiFifo\n50\t\tcase mode&os.ModeSocket != 0:\n51\t\t\treturn ansiSocket\n52\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n53\t\t\treturn ansiCharDev\n54\t\tcase mode&os.ModeDevice != 0:\n55\t\t\treturn ansiBlockDev\n56\t\tcase mode&0o111 != 0:\n57\t\t\treturn ansiExec\n58\t\tdefault:\n59\t\t\treturn \"\"\n60\t\t}\n61\t}\n62\t\n63\t// Reset returns the ANSI reset sequence.\n64\t// R2.2, R2.6: returns empty string when color is explicitly disabled via SetColorEnabled(false).\n65\tfunc Reset() string {\n66\t\tif colorDisabled() {\n67\t\t\treturn \"\"\n68\t\t}\n69\t\treturn ansiReset\n70\t}\n71\t\n72\t// ColorEnabled reports whether color output is enabled for the given writer.\n73\t// R2.3: when no override is set, detects whether the writer is a terminal.\n74\tfunc ColorEnabled(w io.Writer) bool {\n75\t\tcolorMu.RLock()\n76\t\toverride := colorOverride\n77\t\tcolorMu.RUnlock()\n78\t\tif override != nil {\n79\t\t\treturn *override\n80\t\t}\n81\t\ttype fder interface {\n82\t\t\tFd() uintptr\n83\t\t}\n84\t\tif f, ok := w.(fder); ok {\n85\t\t\treturn sys.IsTerminal(f.Fd())\n86\t\t}\n87\t\treturn false\n88\t}\n89\t\n90\t// SetColorEnabled forces color output on or off regardless of terminal detection.\n91\t// R2.5: overrides the terminal check used by ColorEnabled and FileTypeColor.\n92\tfunc SetColorEnabled(enabled bool) {\n93\t\tcolorMu.Lock()\n94\t\tcolorOverride = &enabled\n95\t\tcolorMu.Unlock()\n96\t}\n97\t\n98\t// ResetColorEnabled clears any color override, restoring terminal-based detection.\n99\t// R2.5: undoes a prior SetColorEnabled call.\n100\tfunc ResetColorEnabled() {\n101\t\tcolorMu.Lock()\n102\t\tcolorOverride = nil\n103\t\tcolorMu.Unlock()\n104\t}\n105\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01RGAfo8rxXib9xUaCrLMoCC","session_id":"23c1c290-2627-430c-aa84-94704d0f6b79","uuid":"5b384fdf-ec3c-4308-b54a-1e32a4a3b62c","timestamp":"2026-05-27T19:46:22.522Z"}
