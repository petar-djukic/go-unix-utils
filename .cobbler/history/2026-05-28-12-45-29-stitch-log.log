{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MwhV5eJA2RPSL3CZ25wajx","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tvar keywordToCode = map[string]string{\n18\t\t\"NORMAL\":                \"no\",\n19\t\t\"FILE\":                  \"fi\",\n20\t\t\"RESET\":                 \"rs\",\n21\t\t\"DIR\":                   \"di\",\n22\t\t\"LINK\":                  \"ln\",\n23\t\t\"MULTIHARDLINK\":         \"mh\",\n24\t\t\"FIFO\":                  \"pi\",\n25\t\t\"SOCK\":                  \"so\",\n26\t\t\"DOOR\":                  \"do\",\n27\t\t\"BLK\":                   \"bd\",\n28\t\t\"CHR\":                   \"cd\",\n29\t\t\"ORPHAN\":                \"or\",\n30\t\t\"MISSING\":               \"mi\",\n31\t\t\"SETUID\":                \"su\",\n32\t\t\"SETGID\":                \"sg\",\n33\t\t\"CAPABILITY\":            \"ca\",\n34\t\t\"STICKY_OTHER_WRITABLE\": \"tw\",\n35\t\t\"OTHER_WRITABLE\":        \"ow\",\n36\t\t\"STICKY\":                \"st\",\n37\t\t\"EXEC\":                  \"ex\",\n38\t\t\"LEFT\":                  \"lc\",\n39\t\t\"RIGHT\":                 \"rc\",\n40\t\t\"END\":                   \"ec\",\n41\t}\n42\t\n43\tvar ignoredKeywords = map[string]bool{\n44\t\t\"COLOR\":    true,\n45\t\t\"OPTIONS\":  true,\n46\t\t\"EIGHTBIT\": true,\n47\t}\n48\t\n49\ttype shellFormat int\n50\t\n51\tconst (\n52\t\tshellAuto shellFormat = iota\n53\t\tshellBourne\n54\t\tshellCsh\n55\t)\n56\t\n57\tfunc main() {\n58\t\tsys.InstallSIGPIPEHandler()\n59\t\n60\t\tshell := shellAuto\n61\t\tprintDB := false\n62\t\targs := os.Args[1:]\n63\t\tvar positional []string\n64\t\n65\t\tfor i := range len(args) {\n66\t\t\ta := args[i]\n67\t\t\tif a == \"--\" {\n68\t\t\t\tpositional = append(positional, args[i+1:]...)\n69\t\t\t\tbreak\n70\t\t\t}\n71\t\t\tswitch a {\n72\t\t\tcase \"-b\", \"--sh\", \"--bourne-shell\":\n73\t\t\t\tshell = shellBourne\n74\t\t\tcase \"-c\", \"--csh\", \"--c-shell\":\n75\t\t\t\tshell = shellCsh\n76\t\t\tcase \"-p\", \"--print-database\":\n77\t\t\t\tprintDB = true\n78\t\t\tcase \"--help\":\n79\t\t\t\tfmt.Fprint(os.Stdout, \"Usage: dircolors [OPTION]... [FILE]\\nOutput commands to set the LS_COLORS environment variable.\\n\\nDetermine format of output:\\n  -b, --sh, --bourne-shell    output Bourne shell code to set LS_COLORS\\n  -c, --csh, --c-shell        output C shell code to set LS_COLORS\\n  -p, --print-database        output defaults\\n      --help        display this help and exit\\n      --version     output version information and exit\\n\")\n80\t\t\t\tos.Exit(0)\n81\t\t\tcase \"--version\":\n82\t\t\t\tfmt.Fprint(os.Stdout, \"dircolors (go-unix-utils) 0.1\\n\")\n83\t\t\t\tos.Exit(0)\n84\t\t\tdefault:\n85\t\t\t\tif strings.HasPrefix(a, \"-\") && a != \"-\" {\n86\t\t\t\t\tfmt.Fprintf(os.Stderr, \"dircolors: invalid option -- '%s'\\nTry 'dircolors --help' for more information.\\n\", a[1:])\n87\t\t\t\t\tos.Exit(1)\n88\t\t\t\t}\n89\t\t\t\tpositional = append(positional, a)\n90\t\t\t}\n91\t\t}\n92\t\n93\t\tif printDB && len(positional) > 0 {\n94\t\t\tfmt.Fprintf(os.Stderr, \"dircolors: extra operand '%s'\\nfile operands cannot be combined with --print-database (-p)\\nTry 'dircolors --help' for more information.\\n\", positional[0])\n95\t\t\tos.Exit(1)\n96\t\t}\n97\t\n98\t\tif printDB {\n99\t\t\tfmt.Fprint(os.Stdout, defaultDatabase)\n100\t\t\tos.Exit(0)\n101\t\t}\n102\t\n103\t\tif len(positional) > 1 {\n104\t\t\tfmt.Fprintf(os.Stderr, \"dircolors: extra operand '%s'\\nTry 'dircolors --help' for more information.\\n\", positional[1])\n105\t\t\tos.Exit(1)\n106\t\t}\n107\t\n108\t\tvar reader io.Reader\n109\t\tvar filename string\n110\t\tif len(positional) == 1 {\n111\t\t\tfilename = positional[0]\n112\t\t\tif filename == \"-\" {\n113\t\t\t\treader = os.Stdin\n114\t\t\t} else {\n115\t\t\t\tf, err := os.Open(filename)\n116\t\t\t\tif err != nil {\n117\t\t\t\t\tfmt.Fprintf(os.Stderr, \"dircolors: %s\\n\", err)\n118\t\t\t\t\tos.Exit(1)\n119\t\t\t\t}\n120\t\t\t\tdefer f.Close()\n121\t\t\t\treader = f\n122\t\t\t}\n123\t\t} else {\n124\t\t\treader = strings.NewReader(defaultDatabase)\n125\t\t\tfilename = \"\"\n126\t\t}\n127\t\n128\t\tlsColors, err := parseDatabase(reader, filename)\n129\t\tif err != nil {\n130\t\t\tfmt.Fprint(os.Stderr, err)\n131\t\t\tos.Exit(1)\n132\t\t}\n133\t\n134\t\tif shell == shellAuto {\n135\t\t\tshell = detectShell()\n136\t\t}\n137\t\n138\t\tswitch shell {\n139\t\tcase shellBourne:\n140\t\t\tfmt.Fprintf(os.Stdout, \"LS_COLORS='%s';\\nexport LS_COLORS\\n\", lsColors)\n141\t\tcase shellCsh:\n142\t\t\tfmt.Fprintf(os.Stdout, \"setenv LS_COLORS '%s'\\n\", lsColors)\n143\t\t}\n144\t}\n145\t\n146\tfunc detectShell() shellFormat {\n147\t\tsh := os.Getenv(\"SHELL\")\n148\t\tbase := filepath.Base(sh)\n149\t\tif strings.HasSuffix(base, \"csh\") {\n150\t\t\treturn shellCsh\n151\t\t}\n152\t\treturn shellBourne\n153\t}\n154\t\n155\tfunc parseDatabase(r io.Reader, filename string) (string, error) {\n156\t\tscanner := bufio.NewScanner(r)\n157\t\tvar termEntries []string\n158\t\tvar colortermEntries []string\n159\t\tvar entries []string\n160\t\tlineNum := 0\n161\t\n162\t\tdisplayName := filename\n163\t\tif displayName == \"\" {\n164\t\t\tdisplayName = \"<internal>\"\n165\t\t}\n166\t\tif displayName == \"-\" {\n167\t\t\tdisplayName = \"-\"\n168\t\t}\n169\t\n170\t\tfor scanner.Scan() {\n171\t\t\tlineNum++\n172\t\t\tline := scanner.Text()\n173\t\n174\t\t\tline = strings.TrimSpace(line)\n175\t\t\tif line == \"\" || line[0] == '#' {\n176\t\t\t\tcontinue\n177\t\t\t}\n178\t\n179\t\t\tfields := strings.Fields(line)\n180\t\t\tkeyword := fields[0]\n181\t\n182\t\t\tif len(fields) > 2 && fields[2][0] == '#' {\n183\t\t\t\tfields = fields[:2]\n184\t\t\t}\n185\t\n186\t\t\tif keyword == \"TERM\" {\n187\t\t\t\tif len(fields) < 2 {\n188\t\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n189\t\t\t\t}\n190\t\t\t\ttermEntries = append(termEntries, fields[1])\n191\t\t\t\tcontinue\n192\t\t\t}\n193\t\n194\t\t\tif keyword == \"COLORTERM\" {\n195\t\t\t\tif len(fields) < 2 {\n196\t\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n197\t\t\t\t}\n198\t\t\t\tcolortermEntries = append(colortermEntries, fields[1])\n199\t\t\t\tcontinue\n200\t\t\t}\n201\t\n202\t\t\tif ignoredKeywords[keyword] {\n203\t\t\t\tcontinue\n204\t\t\t}\n205\t\n206\t\t\tif code, ok := keywordToCode[keyword]; ok {\n207\t\t\t\tif len(fields) < 2 {\n208\t\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n209\t\t\t\t}\n210\t\t\t\tentries = append(entries, code+\"=\"+fields[1])\n211\t\t\t\tcontinue\n212\t\t\t}\n213\t\n214\t\t\tif strings.HasPrefix(keyword, \".\") || strings.HasPrefix(keyword, \"*\") {\n215\t\t\t\tif len(fields) < 2 {\n216\t\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n217\t\t\t\t}\n218\t\t\t\text := keyword\n219\t\t\t\tif strings.HasPrefix(ext, \".\") {\n220\t\t\t\t\text = \"*\" + ext\n221\t\t\t\t}\n222\t\t\t\tentries = append(entries, ext+\"=\"+fields[1])\n223\t\t\t\tcontinue\n224\t\t\t}\n225\t\n226\t\t\tif len(fields) < 2 {\n227\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n228\t\t\t}\n229\t\t}\n230\t\n231\t\tif err := scanner.Err(); err != nil {\n232\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s: %v\\n\", displayName, err)\n233\t\t}\n234\t\n235\t\tif len(termEntries) > 0 || len(colortermEntries) > 0 {\n236\t\t\tif !termMatches(termEntries, colortermEntries) {\n237\t\t\t\treturn \"\", nil\n238\t\t\t}\n239\t\t}\n240\t\n241\t\tif len(entries) == 0 {\n242\t\t\treturn \"\", nil\n243\t\t}\n244\t\treturn strings.Join(entries, \":\") + \":\", nil\n245\t}\n246\t\n247\tfunc termMatches(termEntries, colortermEntries []string) bool {\n248\t\tcurrentTerm := os.Getenv(\"TERM\")\n249\t\tfor _, pattern := range termEntries {\n250\t\t\tmatched, err := filepath.Match(pattern, currentTerm)\n251\t\t\tif err == nil && matched {\n252\t\t\t\treturn true\n253\t\t\t}\n254\t\t}\n255\t\n256\t\tcurrentColorterm := os.Getenv(\"COLORTERM\")\n257\t\tfor _, pattern := range colortermEntries {\n258\t\t\tmatched, err := filepath.Match(pattern, currentColorterm)\n259\t\t\tif err == nil && matched {\n260\t\t\t\treturn true\n261\t\t\t}\n262\t\t}\n263\t\n264\t\treturn false\n265\t}\n266\t\n267\tconst defaultDatabase = `# Configuration file for dircolors, a utility to help you set the\n268\t# LS_COLORS environment variable used by GNU ls with the --color option.\n269\t# Copyright (C) 1996-2026 Free Software Foundation, Inc.\n270\t# Copying and distribution of this file, with or without modification,\n271\t# are permitted provided the copyright notice and this notice are preserved.\n272\t#\n273\t# The keywords COLOR, OPTIONS, and EIGHTBIT (honored by the\n274\t# slackware version of dircolors) are recognized but ignored.\n275\t# Global config options can be specified before TERM or COLORTERM entries\n276\t# ===================================================================\n277\t# Terminal filters\n278\t# ===================================================================\n279\t# Below are TERM or COLORTERM entries, which can be glob patterns, which\n280\t# restrict following config to systems with matching environment variables.\n281\tCOLORTERM ?*\n282\tTERM Eterm\n283\tTERM ansi\n284\tTERM *color*\n285\tTERM con[0-9]*x[0-9]*\n286\tTERM cons25\n287\tTERM console\n288\tTERM cygwin\n289\tTERM *direct*\n290\tTERM dtterm\n291\tTERM gnome\n292\tTERM hurd\n293\tTERM jfbterm\n294\tTERM konsole\n295\tTERM kterm\n296\tTERM linux\n297\tTERM linux-c\n298\tTERM mlterm\n299\tTERM putty\n300\tTERM rxvt*\n301\tTERM screen*\n302\tTERM st\n303\tTERM terminator\n304\tTERM tmux*\n305\tTERM vt100\n306\tTERM vt220\n307\tTERM xterm*\n308\t# ===================================================================\n309\t# Basic file attributes\n310\t# ===================================================================\n311\t# Below are the color init strings for the basic file types.\n312\t# One can use codes for 256 or more colors supported by modern terminals.\n313\t# The default color codes use the capabilities of an 8 color terminal\n314\t# with some additional attributes as per the following codes:\n315\t# Attribute codes:\n316\t# 00=none 01=bold 04=underscore 05=blink 07=reverse 08=concealed\n317\t# Text color codes:\n318\t# 30=black 31=red 32=green 33=yellow 34=blue 35=magenta 36=cyan 37=white\n319\t# Background color codes:\n320\t# 40=black 41=red 42=green 43=yellow 44=blue 45=magenta 46=cyan 47=white\n321\t#NORMAL 00 # no color code at all\n322\t#FILE 00 # regular file: use no color at all\n323\tRESET 0 # reset to \"normal\" color\n324\tDIR 01;34 # directory\n325\tLINK 01;36 # symbolic link. (If you set this to 'target' instead of a\n326\t # numerical value, the color is as for the file pointed to.)\n327\tMULTIHARDLINK 00 # regular file with more than one link\n328\tFIFO 40;33 # pipe\n329\tSOCK 01;35 # socket\n330\tDOOR 01;35 # door\n331\tBLK 40;33;01 # block device driver\n332\tCHR 40;33;01 # character device driver\n333\tORPHAN 40;31;01 # symlink to nonexistent file, or non-stat'able file ...\n334\tMISSING 00 # ... and the files they point to\n335\tSETUID 37;41 # regular file that is setuid (u+s)\n336\tSETGID 30;43 # regular file that is setgid (g+s)\n337\tCAPABILITY 00 # regular file with capability (very expensive to lookup)\n338\tSTICKY_OTHER_WRITABLE 30;42 # dir that is sticky and other-writable (+t,o+w)\n339\tOTHER_WRITABLE 34;42 # dir that is other-writable (o+w) and not sticky\n340\tSTICKY 37;44 # dir with the sticky bit set (+t) and not other-writable\n341\t# This is for regular files with execute permission:\n342\tEXEC 01;32\n343\t# ===================================================================\n344\t# File extension attributes\n345\t# ===================================================================\n346\t# List any file extensions like '.gz' or '.tar' that you would like ls\n347\t# to color below. Put the suffix, a space, and the color init string.\n348\t# (and any comments you want to add after a '#').\n349\t# Suffixes are matched case insensitively, but if you define different\n350\t# init strings for separate cases, those will be honored.\n351\t#\n352\t# If you use DOS-style suffixes, you may want to uncomment the following:\n353\t#.cmd 01;32 # executables (bright green)\n354\t#.exe 01;32\n355\t#.com 01;32\n356\t#.btm 01;32\n357\t#.bat 01;32\n358\t# Or if you want to color scripts even if they do not have the\n359\t# executable bit actually set.\n360\t#.sh 01;32\n361\t#.csh 01;32\n362\t# archives or compressed (bright red)\n363\t.7z 01;31\n364\t.ace 01;31\n365\t.alz 01;31\n366\t.apk 01;31\n367\t.arc 01;31\n368\t.arj 01;31\n369\t.bz 01;31\n370\t.bz2 01;31\n371\t.cab 01;31\n372\t.cpio 01;31\n373\t.crate 01;31\n374\t.deb 01;31\n375\t.drpm 01;31\n376\t.dwm 01;31\n377\t.dz 01;31\n378\t.ear 01;31\n379\t.egg 01;31\n380\t.esd 01;31\n381\t.gz 01;31\n382\t.jar 01;31\n383\t.lha 01;31\n384\t.lrz 01;31\n385\t.lz 01;31\n386\t.lz4 01;31\n387\t.lzh 01;31\n388\t.lzma 01;31\n389\t.lzo 01;31\n390\t.pyz 01;31\n391\t.rar 01;31\n392\t.rpm 01;31\n393\t.rz 01;31\n394\t.sar 01;31\n395\t.swm 01;31\n396\t.t7z 01;31\n397\t.tar 01;31\n398\t.taz 01;31\n399\t.tbz 01;31\n400\t.tbz2 01;31\n401\t.tgz 01;31\n402\t.tlz 01;31\n403\t.txz 01;31\n404\t.tz 01;31\n405\t.tzo 01;31\n406\t.tzst 01;31\n407\t.udeb 01;31\n408\t.war 01;31\n409\t.whl 01;31\n410\t.wim 01;31\n411\t.xz 01;31\n412\t.z 01;31\n413\t.zip 01;31\n414\t.zoo 01;31\n415\t.zst 01;31\n416\t# image formats\n417\t.avif 01;35\n418\t.jpg 01;35\n419\t.jpeg 01;35\n420\t.jxl 01;35\n421\t.mjpg 01;35\n422\t.mjpeg 01;35\n423\t.gif 01;35\n424\t.bmp 01;35\n425\t.pbm 01;35\n426\t.pgm 01;35\n427\t.ppm 01;35\n428\t.tga 01;35\n429\t.xbm 01;35\n430\t.xpm 01;35\n431\t.tif 01;35\n432\t.tiff 01;35\n433\t.png 01;35\n434\t.svg 01;35\n435\t.svgz 01;35\n436\t.mng 01;35\n437\t.pcx 01;35\n438\t.mov 01;35\n439\t.mpg 01;35\n440\t.mpeg 01;35\n441\t.m2v 01;35\n442\t.mkv 01;35\n443\t.webm 01;35\n444\t.webp 01;35\n445\t.ogm 01;35\n446\t.mp4 01;35\n447\t.m4v 01;35\n448\t.mp4v 01;35\n449\t.vob 01;35\n450\t.qt 01;35\n451\t.nuv 01;35\n452\t.wmv 01;35\n453\t.asf 01;35\n454\t.rm 01;35\n455\t.rmvb 01;35\n456\t.flc 01;35\n457\t.avi 01;35\n458\t.fli 01;35\n459\t.flv 01;35\n460\t.gl 01;35\n461\t.dl 01;35\n462\t.xcf 01;35\n463\t.xwd 01;35\n464\t.yuv 01;35\n465\t.cgm 01;35\n466\t.emf 01;35\n467\t# https://wiki.xiph.org/MIME_Types_and_File_Extensions\n468\t.ogv 01;35\n469\t.ogx 01;35\n470\t# audio formats\n471\t.aac 00;36\n472\t.au 00;36\n473\t.flac 00;36\n474\t.m4a 00;36\n475\t.mid 00;36\n476\t.midi 00;36\n477\t.mka 00;36\n478\t.mp3 00;36\n479\t.mpc 00;36\n480\t.ogg 00;36\n481\t.ra 00;36\n482\t.wav 00;36\n483\t# https://wiki.xiph.org/MIME_Types_and_File_Extensions\n484\t.oga 00;36\n485\t.opus 00;36\n486\t.spx 00;36\n487\t.xspf 00;36\n488\t# backup files\n489\t*~ 00;90\n490\t*# 00;90\n491\t.bak 00;90\n492\t.crdownload 00;90\n493\t.dpkg-dist 00;90\n494\t.dpkg-new 00;90\n495\t.dpkg-old 00;90\n496\t.dpkg-tmp 00;90\n497\t.old 00;90\n498\t.orig 00;90\n499\t.part 00;90\n500\t.rej 00;90\n501\t.rpmnew 00;90\n502\t.rpmorig 00;90\n503\t.rpmsave 00;90\n504\t.swp 00;90\n505\t.tmp 00;90\n506\t.ucf-dist 00;90\n507\t.ucf-new 00;90\n508\t.ucf-old 00;90\n509\t#\n510\t# Subsequent TERM or COLORTERM entries, can be used to add / override\n511\t# config specific to those matching environment variables.\n512\t`\n513\t"}]},"parent_tool_use_id":null,"session_id":"00a7fe6e-2e16-4c02-acf2-f923819546ce","uuid":"5a2530d1-a02b-4c5c-814b-75e13986b144","timestamp":"2026-05-28T16:45:40.909Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5630/cmd/dircolors/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar keywordToCode = map[string]string{\n\t\"NORMAL\":                \"no\",\n\t\"FILE\":                  \"fi\",\n\t\"RESET\":                 \"rs\",\n\t\"DIR\":                   \"di\",\n\t\"LINK\":                  \"ln\",\n\t\"MULTIHARDLINK\":         \"mh\",\n\t\"FIFO\":                  \"pi\",\n\t\"SOCK\":                  \"so\",\n\t\"DOOR\":                  \"do\",\n\t\"BLK\":                   \"bd\",\n\t\"CHR\":                   \"cd\",\n\t\"ORPHAN\":                \"or\",\n\t\"MISSING\":               \"mi\",\n\t\"SETUID\":                \"su\",\n\t\"SETGID\":                \"sg\",\n\t\"CAPABILITY\":            \"ca\",\n\t\"STICKY_OTHER_WRITABLE\": \"tw\",\n\t\"OTHER_WRITABLE\":        \"ow\",\n\t\"STICKY\":                \"st\",\n\t\"EXEC\":                  \"ex\",\n\t\"LEFT\":                  \"lc\",\n\t\"RIGHT\":                 \"rc\",\n\t\"END\":                   \"ec\",\n}\n\nvar ignoredKeywords = map[string]bool{\n\t\"COLOR\":    true,\n\t\"OPTIONS\":  true,\n\t\"EIGHTBIT\": true,\n}\n\ntype shellFormat int\n\nconst (\n\tshellAuto shellFormat = iota\n\tshellBourne\n\tshellCsh\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tshell := shellAuto\n\tprintDB := false\n\targs := os.Args[1:]\n\tvar positional []string\n\n\tfor i := range len(args) {\n\t\ta := args[i]\n\t\tif a == \"--\" {\n\t\t\tpositional = append(positional, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tswitch a {\n\t\tcase \"-b\", \"--sh\", \"--bourne-shell\":\n\t\t\tshell = shellBourne\n\t\tcase \"-c\", \"--csh\", \"--c-shell\":\n\t\t\tshell = shellCsh\n\t\tcase \"-p\", \"--print-database\":\n\t\t\tprintDB = true\n\t\tcase \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, \"Usage: dircolors [OPTION]... [FILE]\\nOutput commands to set the LS_COLORS environment variable.\\n\\nDetermine format of output:\\n  -b, --sh, --bourne-shell    output Bourne shell code to set LS_COLORS\\n  -c, --csh, --c-shell        output C shell code to set LS_COLORS\\n  -p, --print-database        output defaults\\n      --help        display this help and exit\\n      --version     output version information and exit\\n\")\n\t\t\tos.Exit(0)\n\t\tcase \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, \"dircolors (go-unix-utils) 0.1\\n\")\n\t\t\tos.Exit(0)\n\t\tdefault:\n\t\t\tif strings.HasPrefix(a, \"-\") && a != \"-\" {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"dircolors: invalid option -- '%s'\\nTry 'dircolors --help' for more information.\\n\", a[1:])\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tpositional = append(positional, a)\n\t\t}\n\t}\n\n\tif printDB && len(positional) > 0 {\n\t\tfmt.Fprintf(os.Stderr, \"dircolors: extra operand '%s'\\nfile operands cannot be combined with --print-database (-p)\\nTry 'dircolors --help' for more information.\\n\", positional[0])\n\t\tos.Exit(1)\n\t}\n\n\tif printDB {\n\t\tfmt.Fprint(os.Stdout, defaultDatabase)\n\t\tos.Exit(0)\n\t}\n\n\tif len(positional) > 1 {\n\t\tfmt.Fprintf(os.Stderr, \"dircolors: extra operand '%s'\\nTry 'dircolors --help' for more information.\\n\", positional[1])\n\t\tos.Exit(1)\n\t}\n\n\tvar reader io.Reader\n\tvar filename string\n\tif len(positional) == 1 {\n\t\tfilename = positional[0]\n\t\tif filename == \"-\" {\n\t\t\treader = os.Stdin\n\t\t} else {\n\t\t\tf, err := os.Open(filename)\n\t\t\tif err != nil {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"dircolors: %s\\n\", err)\n\t\t\t\tos.Exit(1)\n\t\t\t}\n\t\t\tdefer f.Close()\n\t\t\treader = f\n\t\t}\n\t} else {\n\t\treader = strings.NewReader(defaultDatabase)\n\t\tfilename = \"\"\n\t}\n\n\tlsColors, err := parseDatabase(reader, filename)\n\tif err != nil {\n\t\tfmt.Fprint(os.Stderr, err)\n\t\tos.Exit(1)\n\t}\n\n\tif shell == shellAuto {\n\t\tshell = detectShell()\n\t}\n\n\tswitch shell {\n\tcase shellBourne:\n\t\tfmt.Fprintf(os.Stdout, \"LS_COLORS='%s';\\nexport LS_COLORS\\n\", lsColors)\n\tcase shellCsh:\n\t\tfmt.Fprintf(os.Stdout, \"setenv LS_COLORS '%s'\\n\", lsColors)\n\t}\n}\n\nfunc detectShell() shellFormat {\n\tsh := os.Getenv(\"SHELL\")\n\tbase := filepath.Base(sh)\n\tif strings.HasSuffix(base, \"csh\") {\n\t\treturn shellCsh\n\t}\n\treturn shellBourne\n}\n\nfunc parseDatabase(r io.Reader, filename string) (string, error) {\n\tscanner := bufio.NewScanner(r)\n\tvar termEntries []string\n\tvar colortermEntries []string\n\tvar entries []string\n\tlineNum := 0\n\n\tdisplayName := filename\n\tif displayName == \"\" {\n\t\tdisplayName = \"<internal>\"\n\t}\n\tif displayName == \"-\" {\n\t\tdisplayName = \"-\"\n\t}\n\n\tfor scanner.Scan() {\n\t\tlineNum++\n\t\tline := scanner.Text()\n\n\t\tline = strings.TrimSpace(line)\n\t\tif line == \"\" || line[0] == '#' {\n\t\t\tcontinue\n\t\t}\n\n\t\tfields := strings.Fields(line)\n\t\tkeyword := fields[0]\n\n\t\tif len(fields) > 2 && fields[2][0] == '#' {\n\t\t\tfields = fields[:2]\n\t\t}\n\n\t\tif keyword == \"TERM\" {\n\t\t\tif len(fields) < 2 {\n\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n\t\t\t}\n\t\t\ttermEntries = append(termEntries, fields[1])\n\t\t\tcontinue\n\t\t}\n\n\t\tif keyword == \"COLORTERM\" {\n\t\t\tif len(fields) < 2 {\n\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n\t\t\t}\n\t\t\tcolortermEntries = append(colortermEntries, fields[1])\n\t\t\tcontinue\n\t\t}\n\n\t\tif ignoredKeywords[keyword] {\n\t\t\tcontinue\n\t\t}\n\n\t\tif code, ok := keywordToCode[keyword]; ok {\n\t\t\tif len(fields) < 2 {\n\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n\t\t\t}\n\t\t\tentries = append(entries, code+\"=\"+fields[1])\n\t\t\tcontinue\n\t\t}\n\n\t\tif strings.HasPrefix(keyword, \".\") || strings.HasPrefix(keyword, \"*\") {\n\t\t\tif len(fields) < 2 {\n\t\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n\t\t\t}\n\t\t\text := keyword\n\t\t\tif strings.HasPrefix(ext, \".\") {\n\t\t\t\text = \"*\" + ext\n\t\t\t}\n\t\t\tentries = append(entries, ext+\"=\"+fields[1])\n\t\t\tcontinue\n\t\t}\n\n\t\tif len(fields) < 2 {\n\t\t\treturn \"\", fmt.Errorf(\"dircolors: %s:%d: invalid line;  missing second token\\n\", displayName, lineNum)\n\t\t}\n\t}\n\n\tif err := scanner.Err(); err != nil {\n\t\treturn \"\", fmt.Errorf(\"dircolors: %s: %v\\n\", displayName, err)\n\t}\n\n\tif len(termEntries) > 0 || len(colortermEntries) > 0 {\n\t\tif !termMatches(termEntries, colortermEntries) {\n\t\t\treturn \"\", nil\n\t\t}\n\t}\n\n\tif len(entries) == 0 {\n\t\treturn \"\", nil\n\t}\n\treturn strings.Join(entries, \":\") + \":\", nil\n}\n\nfunc termMatches(termEntries, colortermEntries []string) bool {\n\tcurrentTerm := os.Getenv(\"TERM\")\n\tfor _, pattern := range termEntries {\n\t\tmatched, err := filepath.Match(pattern, currentTerm)\n\t\tif err == nil && matched {\n\t\t\treturn true\n\t\t}\n\t}\n\n\tcurrentColorterm := os.Getenv(\"COLORTERM\")\n\tfor _, pattern := range colortermEntries {\n\t\tmatched, err := filepath.Match(pattern, currentColorterm)\n\t\tif err == nil && matched {\n\t\t\treturn true\n\t\t}\n\t}\n\n\treturn false\n}\n\nconst defaultDatabase = `# Configuration file for dircolors, a utility to help you set the\n# LS_COLORS environment variable used by GNU ls with the --color option.\n# Copyright (C) 1996-2026 Free Software Foundation, Inc.\n# Copying and distribution of this file, with or without modification,\n# are permitted provided the copyright notice and this notice are preserved.\n#\n# The keywords COLOR, OPTIONS, and EIGHTBIT (honored by the\n# slackware version of dircolors) are recognized but ignored.\n# Global config options can be specified before TERM or COLORTERM entries\n# ===================================================================\n# Terminal filters\n# ===================================================================\n# Below are TERM or COLORTERM entries, which can be glob patterns, which\n# restrict following config to systems with matching environment variables.\nCOLORTERM ?*\nTERM Eterm\nTERM ansi\nTERM *color*\nTERM con[0-9]*x[0-9]*\nTERM cons25\nTERM console\nTERM cygwin\nTERM *direct*\nTERM dtterm\nTERM gnome\nTERM hurd\nTERM jfbterm\nTERM konsole\nTERM kterm\nTERM linux\nTERM linux-c\nTERM mlterm\nTERM putty\nTERM rxvt*\nTERM screen*\nTERM st\nTERM terminator\nTERM tmux*\nTERM vt100\nTERM vt220\nTERM xterm*\n# ===================================================================\n# Basic file attributes\n# ===================================================================\n# Below are the color init strings for the basic file types.\n# One can use codes for 256 or more colors supported by modern terminals.\n# The default color codes use the capabilities of an 8 color terminal\n# with some additional attributes as per the following codes:\n# Attribute codes:\n# 00=none 01=bold 04=underscore 05=blink 07=reverse 08=concealed\n# Text color codes:\n# 30=black 31=red 32=green 33=yellow 34=blue 35=magenta 36=cyan 37=white\n# Background color codes:\n# 40=black 41=red 42=green 43=yellow 44=blue 45=magenta 46=cyan 47=white\n#NORMAL 00 # no color code at all\n#FILE 00 # regular file: use no color at all\nRESET 0 # reset to \"normal\" color\nDIR 01;34 # directory\nLINK 01;36 # symbolic link. (If you set this to 'target' instead of a\n # numerical value, the color is as for the file pointed to.)\nMULTIHARDLINK 00 # regular file with more than one link\nFIFO 40;33 # pipe\nSOCK 01;35 # socket\nDOOR 01;35 # door\nBLK 40;33;01 # block device driver\nCHR 40;33;01 # character device driver\nORPHAN 40;31;01 # symlink to nonexistent file, or non-stat'able file ...\nMISSING 00 # ... and the files they point to\nSETUID 37;41 # regular file that is setuid (u+s)\nSETGID 30;43 # regular file that is setgid (g+s)\nCAPABILITY 00 # regular file with capability (very expensive to lookup)\nSTICKY_OTHER_WRITABLE 30;42 # dir that is sticky and other-writable (+t,o+w)\nOTHER_WRITABLE 34;42 # dir that is other-writable (o+w) and not sticky\nSTICKY 37;44 # dir with the sticky bit set (+t) and not other-writable\n# This is for regular files with execute permission:\nEXEC 01;32\n# ===================================================================\n# File extension attributes\n# ===================================================================\n# List any file extensions like '.gz' or '.tar' that you would like ls\n# to color below. Put the suffix, a space, and the color init string.\n# (and any comments you want to add after a '#').\n# Suffixes are matched case insensitively, but if you define different\n# init strings for separate cases, those will be honored.\n#\n# If you use DOS-style suffixes, you may want to uncomment the following:\n#.cmd 01;32 # executables (bright green)\n#.exe 01;32\n#.com 01;32\n#.btm 01;32\n#.bat 01;32\n# Or if you want to color scripts even if they do not have the\n# executable bit actually set.\n#.sh 01;32\n#.csh 01;32\n# archives or compressed (bright red)\n.7z 01;31\n.ace 01;31\n.alz 01;31\n.apk 01;31\n.arc 01;31\n.arj 01;31\n.bz 01;31\n.bz2 01;31\n.cab 01;31\n.cpio 01;31\n.crate 01;31\n.deb 01;31\n.drpm 01;31\n.dwm 01;31\n.dz 01;31\n.ear 01;31\n.egg 01;31\n.esd 01;31\n.gz 01;31\n.jar 01;31\n.lha 01;31\n.lrz 01;31\n.lz 01;31\n.lz4 01;31\n.lzh 01;31\n.lzma 01;31\n.lzo 01;31\n.pyz 01;31\n.rar 01;31\n.rpm 01;31\n.rz 01;31\n.sar 01;31\n.swm 01;31\n.t7z 01;31\n.tar 01;31\n.taz 01;31\n.tbz 01;31\n.tbz2 01;31\n.tgz 01;31\n.tlz 01;31\n.txz 01;31\n.tz 01;31\n.tzo 01;31\n.tzst 01;31\n.udeb 01;31\n.war 01;31\n.whl 01;31\n.wim 01;31\n.xz 01;31\n.z 01;31\n.zip 01;31\n.zoo 01;31\n.zst 01;31\n# image formats\n.avif 01;35\n.jpg 01;35\n.jpeg 01;35\n.jxl 01;35\n.mjpg 01;35\n.mjpeg 01;35\n.gif 01;35\n.bmp 01;35\n.pbm 01;35\n.pgm 01;35\n.ppm 01;35\n.tga 01;35\n.xbm 01;35\n.xpm 01;35\n.tif 01;35\n.tiff 01;35\n.png 01;35\n.svg 01;35\n.svgz 01;35\n.mng 01;35\n.pcx 01;35\n.mov 01;35\n.mpg 01;35\n.mpeg 01;35\n.m2v 01;35\n.mkv 01;35\n.webm 01;35\n.webp 01;35\n.ogm 01;35\n.mp4 01;35\n.m4v 01;35\n.mp4v 01;35\n.vob 01;35\n.qt 01;35\n.nuv 01;35\n.wmv 01;35\n.asf 01;35\n.rm 01;35\n.rmvb 01;35\n.flc 01;35\n.avi 01;35\n.fli 01;35\n.flv 01;35\n.gl 01;35\n.dl 01;35\n.xcf 01;35\n.xwd 01;35\n.yuv 01;35\n.cgm 01;35\n.emf 01;35\n# https://wiki.xiph.org/MIME_Types_and_File_Extensions\n.ogv 01;35\n.ogx 01;35\n# audio formats\n.aac 00;36\n.au 00;36\n.flac 00;36\n.m4a 00;36\n.mid 00;36\n.midi 00;36\n.mka 00;36\n.mp3 00;36\n.mpc 00;36\n.ogg 00;36\n.ra 00;36\n.wav 00;36\n# https://wiki.xiph.org/MIME_Types_and_File_Extensions\n.oga 00;36\n.opus 00;36\n.spx 00;36\n.xspf 00;36\n# backup files\n*~ 00;90\n*# 00;90\n.bak 00;90\n.crdownload 00;90\n.dpkg-dist 00;90\n.dpkg-new 00;90\n.dpkg-old 00;90\n.dpkg-tmp 00;90\n.old 00;90\n.orig 00;90\n.part 00;90\n.rej 00;90\n.rpmnew 00;90\n.rpmorig 00;90\n.rpmsave 00;90\n.swp 00;90\n.tmp 00;90\n.ucf-dist 00;90\n.ucf-new 00;90\n.ucf-old 00;90\n#\n# Subsequent TERM or COLORTERM entries, can be used to add / override\n# config specific to those matching environment variables.\n`\n","numLines":513,"startLine":1,"totalLines":513}}}
