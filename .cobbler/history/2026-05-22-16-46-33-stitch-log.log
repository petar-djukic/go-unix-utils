sumeIntArg(args, arg, &i, j)\n142\t\t\t\treturn i\n143\t\t\tcase 'p':\n144\t\t\t\tflagPrefix = consumeStrArg(args, arg, &i, j)\n145\t\t\t\treturn i\n146\t\t\tcase 's':\n147\t\t\t\tflagSplit = true\n148\t\t\tcase 't':\n149\t\t\t\tflagTagged = true\n150\t\t\tcase 'u':\n151\t\t\t\tflagUniform = true\n152\t\t\tdefault:\n153\t\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid option -- '%c'\\n\", c)\n154\t\t\t\tos.Exit(1)\n155\t\t\t}\n156\t\t}\n157\t\treturn i\n158\t}\n159\t\n160\tfunc consumeIntArg(args []string, arg string, i *int, j int) int {\n161\t\trest := arg[j+1:]\n162\t\tif rest != \"\" {\n163\t\t\tv, err := strconv.Atoi(rest)\n164\t\t\tif err != nil || v < 1 {\n165\t\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", rest)\n166\t\t\t\tos.Exit(1)\n167\t\t\t}\n168\t\t\treturn v\n169\t\t}\n170\t\t*i++\n171\t\tif *i >= len(args) {\n172\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n173\t\t\tos.Exit(1)\n174\t\t}\n175\t\tv, err := strconv.Atoi(args[*i])\n176\t\tif err != nil || v < 1 {\n177\t\t\tfmt.Fprintf(os.Stderr, \"fmt: invalid width '%s'\\n\", args[*i])\n178\t\t\tos.Exit(1)\n179\t\t}\n180\t\treturn v\n181\t}\n182\t\n183\tfunc consumeStrArg(args []string, arg string, i *int, j int) string {\n184\t\trest := arg[j+1:]\n185\t\tif rest != \"\" {\n186\t\t\treturn rest\n187\t\t}\n188\t\t*i++\n189\t\tif *i >= len(args) {\n190\t\t\tfmt.Fprintf(os.Stderr, \"fmt: option requires an argument -- '%c'\\n\", arg[j])\n191\t\t\tos.Exit(1)\n192\t\t}\n193\t\treturn args[*i]\n194\t}\n195\t\n196\tfunc fmtFile(name string) error {\n197\t\tvar r io.Reader\n198\t\tif name == \"-\" {\n199\t\t\tr = os.Stdin\n200\t\t} else {\n201\t\t\tf, err := os.Open(name)\n202\t\t\tif err != nil {\n203\t\t\t\treturn err\n204\t\t\t}\n205\t\t\tdefer f.Close()\n206\t\t\tr = f\n207\t\t}\n208\t\treturn formatInput(r)\n209\t}\n210\t\n211\tfunc formatInput(r io.Reader) error {\n212\t\tparagraphs, err := detectParagraphs(r)\n213\t\tif err != nil {\n214\t\t\treturn err\