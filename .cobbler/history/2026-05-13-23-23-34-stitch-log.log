{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DcrMrUuP8YiH3R9ZibzUKB","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"os\"\n9\t\t\"os/exec\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"testing\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n15\t)\n16\t\n17\tfunc lookupRefBinary(t *testing.T) string {\n18\t\tt.Helper()\n19\t\tref, err := exec.LookPath(\"sponge\")\n20\t\tif err != nil {\n21\t\t\tt.Skip(\"reference binary sponge not found\")\n22\t\t}\n23\t\treturn ref\n24\t}\n25\t\n26\t// R4.1, R4.2, R4.3: passthrough mode (no output filename).\n27\tfunc TestDiffPassthrough(t *testing.T) {\n28\t\tgoBin := testutils.BuildBinary(t, \".\")\n29\t\trefBin := lookupRefBinary(t)\n30\t\ttests := []testutils.DiffTest{\n31\t\t\t{Name: \"passthrough_small\", Stdin: []byte(\"hello\\nworld\\n\")},\n32\t\t\t{Name: \"passthrough_empty\", Stdin: []byte{}},\n33\t\t\t{Name: \"passthrough_single_byte\", Stdin: []byte(\"x\")},\n34\t\t\t{Name: \"passthrough_no_newline\", Stdin: []byte(\"no trailing newline\")},\n35\t\t\t{Name: \"passthrough_binary\", Stdin: allBytes()},\n36\t\t\t{Name: \"passthrough_large\", Stdin: bytes.Repeat([]byte(\"abcdefghij\\n\"), 200000)},\n37\t\t}\n38\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n39\t}\n40\t\n41\t// R3.3: append mode prepend operation.\n42\tfunc TestDiffAppend(t *testing.T) {\n43\t\tgoBin := testutils.BuildBinary(t, \".\")\n44\t\trefBin := lookupRefBinary(t)\n45\t\n46\t\ttests := []struct {\n47\t\t\tname    string\n48\t\t\tinitial []byte\n49\t\t\tstdin   []byte\n50\t\t}{\n51\t\t\t{\n52\t\t\t\tname:    \"append_basic\",\n53\t\t\t\tinitial: []byte(\"original\\n\"),\n54\t\t\t\tstdin:   []byte(\"appended\\n\"),\n55\t\t\t},\n56\t\t\t{\n57\t\t\t\tname:    \"append_multiline\",\n58\t\t\t\tinitial: []byte(\"line1\\nline2\\n\"),\n59\t\t\t\tstdin:   []byte(\"line3\\nline4\\n\"),\n60\t\t\t},\n61\t\t\t{\n62\t\t\t\tname:    \"append_empty_stdin\",\n63\t\t\t\tinitial: []byte(\"keep this\\n\"),\n64\t\t\t\tstdin:   []byte{},\n65\t\t\t},\n66\t\t\t{\n67\t\t\t\tname:    \"append_empty_original\",\n68\t\t\t\tinitial: []byte{},\n69\t\t\t\tstdin:   []byte(\"new content\\n\"),\n70\t\t\t},\n71\t\t\t{\n72\t\t\t\tname:    \"append_binary_data\",\n73\t\t\t\tinitial: allBytes(),\n74\t\t\t\tstdin:   allBytes(),\n75\t\t\t},\n76\t\t\t{\n77\t\t\t\tname:    \"append_large_stdin\",\n78\t\t\t\tinitial: []byte(\"prefix\\n\"),\n79\t\t\t\tstdin:   bytes.Repeat([]byte(\"data-line\\n\"), 200000),\n80\t\t\t},\n81\t\t}\n82\t\n83\t\tfor _, tc := range tests {\n84\t\t\tt.Run(tc.name, func(t *testing.T) {\n85\t\t\t\tcompareAppendOutput(t, goBin, refBin, tc.initial, tc.stdin)\n86\t\t\t})\n87\t\t}\n88\t}\n89\t\n90\tfunc compareAppendOutput(t *testing.T, goBin, refBin string, initial, stdin []byte) {\n91\t\tt.Helper()\n92\t\n93\t\tgoDir := t.TempDir()\n94\t\trefDir := t.TempDir()\n95\t\toutName := \"out.txt\"\n96\t\tgoOut := filepath.Join(goDir, outName)\n97\t\trefOut := filepath.Join(refDir, outName)\n98\t\n99\t\twriteFile(t, goOut, initial)\n100\t\twriteFile(t, refOut, initial)\n101\t\n102\t\trunSponge(t, goBin, []string{\"-a\", goOut}, stdin)\n103\t\trunSponge(t, refBin, []string{\"-a\", refOut}, stdin)\n104\t\n105\t\tgoContent := readFile(t, goOut)\n106\t\trefContent := readFile(t, refOut)\n107\t\n108\t\tif !bytes.Equal(goContent, refContent) {\n109\t\t\tt.Fatalf(\"file content divergence\\n  ref: %q\\n  go:  %q\", refContent, goContent)\n110\t\t}\n111\t}\n112\t\n113\tfunc runSponge(t *testing.T, binary string, args []string, stdin []byte) {\n114\t\tt.Helper()\n115\t\tcmd := exec.Command(binary, args...)\n116\t\tif stdin != nil {\n117\t\t\tcmd.Stdin = bytes.NewReader(stdin)\n118\t\t}\n119\t\tvar stderr bytes.Buffer\n120\t\tcmd.Stderr = &stderr\n121\t\tif err := cmd.Run(); err != nil {\n122\t\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n123\t\t\t\tt.Fatalf(\"%s exited %d: %s\", binary, exitErr.ExitCode(), stderr.String())\n124\t\t\t}\n125\t\t\tt.Fatalf(\"%s failed: %v\", binary, err)\n126\t\t}\n127\t}\n128\t\n129\tfunc writeFile(t *testing.T, path string, content []byte) {\n130\t\tt.Helper()\n131\t\tif err := os.WriteFile(path, content, 0o644); err != nil {\n132\t\t\tt.Fatal(err)\n133\t\t}\n134\t}\n135\t\n136\tfunc readFile(t *testing.T, path string) []byte {\n137\t\tt.Helper()\n138\t\tcontent, err := os.ReadFile(path)\n139\t\tif err != nil {\n140\t\t\tt.Fatalf(\"read %s: %v\", path, err)\n141\t\t}\n142\t\treturn content\n143\t}\n144\t\n145\tfunc allBytes() []byte {\n146\t\tb := make([]byte, 256)\n147\t\tfor i := range b {\n148\t\t\tb[i] = byte(i)\n149\t\t}\n150\t\treturn b\n151\t}\n152\t\n153\t// R5.1: exit 0 on all success paths.\n154\tfunc TestDiffExitSuccess(t *testing.T) {\n155\t\tgoBin := testutils.BuildBinary(t, \".\")\n156\t\trefBin := lookupRefBinary(t)\n157\t\n158\t\ttests := []testutils.DiffTest{\n159\t\t\t{Name: \"exit0_passthrough\", Stdin: []byte(\"hello\\n\")},\n160\t\t\t{Name: \"exit0_passthrough_empty\", Stdin: []byte{}},\n161\t\t}\n162\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n163\t\n164\t\tt.Run(\"exit0_file_output\", func(t *testing.T) {\n165\t\t\tdir := t.TempDir()\n166\t\t\trunSponge(t, goBin, []string{filepath.Join(dir, \"go.txt\")}, []byte(\"content\\n\"))\n167\t\t\trunSponge(t, refBin, []string{filepath.Join(dir, \"ref.txt\")}, []byte(\"content\\n\"))\n168\t\t})\n169\t\n170\t\tt.Run(\"exit0_append_new_file\", func(t *testing.T) {\n171\t\t\tdir := t.TempDir()\n172\t\t\trunSponge(t, goBin, []string{\"-a\", filepath.Join(dir, \"go.txt\")}, []byte(\"data\\n\"))\n173\t\t\trunSponge(t, refBin, []string{\"-a\", filepath.Join(dir, \"ref.txt\")}, []byte(\"data\\n\"))\n174\t\t})\n175\t}\n176\t\n177\t// R5.2: exit 1 on error conditions with stderr message.\n178\tfunc TestDiffExitError(t *testing.T) {\n179\t\tgoBin := testutils.BuildBinary(t, \".\")\n180\t\trefBin := lookupRefBinary(t)\n181\t\n182\t\ttests := []struct {\n183\t\t\tname string\n184\t\t\targs []string\n185\t\t}{\n186\t\t\t{name: \"exit1_bad_output_dir\", args: []string{\"/nonexistent_sponge_test_5133/file.txt\"}},\n187\t\t}\n188\t\n189\t\tfor _, tc := range tests {\n190\t\t\tt.Run(tc.name, func(t *testing.T) {\n191\t\t\t\tgoExit, goStderr := runCaptureExit(t, goBin, tc.args, []byte(\"data\"))\n192\t\t\t\trefExit, refStderr := runCaptureExit(t, refBin, tc.args, []byte(\"data\"))\n193\t\n194\t\t\t\tif goExit != refExit {\n195\t\t\t\t\tt.Fatalf(\"exit code divergence: go=%d ref=%d\\n  go stderr: %s\\n  ref stderr: %s\",\n196\t\t\t\t\t\tgoExit, refExit, goStderr, refStderr)\n197\t\t\t\t}\n198\t\t\t\tif goExit != 1 {\n199\t\t\t\t\tt.Fatalf(\"expected exit 1, got %d\", goExit)\n200\t\t\t\t}\n201\t\t\t\tif len(goStderr) == 0 {\n202\t\t\t\t\tt.Fatal(\"go binary produced no stderr on error\")\n203\t\t\t\t}\n204\t\t\t\tif len(refStderr) == 0 {\n205\t\t\t\t\tt.Fatal(\"ref binary produced no stderr on error\")\n206\t\t\t\t}\n207\t\t\t})\n208\t\t}\n209\t}\n210\t\n211\t// R5.3: large input completes without panic.\n212\tfunc TestNoPanicLargeInput(t *testing.T) {\n213\t\tgoBin := testutils.BuildBinary(t, \".\")\n214\t\tlargeInput := bytes.Repeat([]byte(\"x\"), 2*1024*1024)\n215\t\n216\t\tcmd := exec.Command(goBin)\n217\t\tcmd.Stdin = bytes.NewReader(largeInput)\n218\t\tvar stdout, stderr bytes.Buffer\n219\t\tcmd.Stdout = &stdout\n220\t\tcmd.Stderr = &stderr\n221\t\n222\t\tif err := cmd.Run(); err != nil {\n223\t\t\tt.Fatalf(\"sponge failed on large input: %v\\nstderr: %s\", err, stderr.String())\n224\t\t}\n225\t\tif stdout.Len() != len(largeInput) {\n226\t\t\tt.Fatalf(\"output length %d != input length %d\", stdout.Len(), len(largeInput))\n227\t\t}\n228\t}\n229\t\n230\t// R5.4: temp files are cleaned up on error paths.\n231\tfunc TestTempFileCleanup(t *testing.T) {\n232\t\tgoBin := testutils.BuildBinary(t, \".\")\n233\t\n234\t\ttmpDir := t.TempDir()\n235\t\n236\t\tcmd := exec.Command(goBin, \"/nonexistent_sponge_test_5133/file.txt\")\n237\t\tcmd.Stdin = bytes.NewReader([]byte(\"data to sponge\\n\"))\n238\t\tcmd.Env = envWithTMPDIR(tmpDir)\n239\t\tcmd.Stderr = &bytes.Buffer{}\n240\t\t_ = cmd.Run()\n241\t\n242\t\tentries, err := os.ReadDir(tmpDir)\n243\t\tif err != nil {\n244\t\t\tt.Fatalf(\"read tmpdir: %v\", err)\n245\t\t}\n246\t\tfor _, e := range entries {\n247\t\t\tt.Errorf(\"temp file not cleaned up: %s\", e.Name())\n248\t\t}\n249\t}\n250\t\n251\tfunc runCaptureExit(t *testing.T, binary string, args []string, stdin []byte) (int, string) {\n252\t\tt.Helper()\n253\t\tcmd := exec.Command(binary, args...)\n254\t\tif stdin != nil {\n255\t\t\tcmd.Stdin = bytes.NewReader(stdin)\n256\t\t}\n257\t\tvar stderr bytes.Buffer\n258\t\tcmd.Stderr = &stderr\n259\t\terr := cmd.Run()\n260\t\tif err == nil {\n261\t\t\treturn 0, stderr.String()\n262\t\t}\n263\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n264\t\t\treturn exitErr.ExitCode(), stderr.String()\n265\t\t}\n266\t\tt.Fatalf(\"failed to run %s: %v\", binary, err)\n267\t\treturn -1, \"\"\n268\t}\n269\t\n270\tfunc envWithTMPDIR(dir string) []string {\n271\t\tvar env []string\n272\t\tfor _, e := range os.Environ() {\n273\t\t\tif !strings.HasPrefix(e, \"TMPDIR=\") {\n274\t\t\t\tenv = append(env, e)\n275\t\t\t}\n276\t\t}\n277\t\treturn append(env, \"TMPDIR=\"+dir)\n278\t}\n279\t"}]},"parent_tool_use_id":null,"session_id":"e2d2b500-2c88-4156-9136-a8a376bfff58","uuid":"3f449b27-1784-47e5-bc3e-e8e66da7f09a","timestamp":"2026-05-14T03:23:44.994Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5135/cmd/sponge/sponge_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"testing\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc lookupRefBinary(t *testing.T) string {\n\tt.Helper()\n\tref, err := exec.LookPath(\"sponge\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary sponge not found\")\n\t}\n\treturn ref\n}\n\n// R4.1, R4.2, R4.3: passthrough mode (no output filename).\nfunc TestDiffPassthrough(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin := lookupRefBinary(t)\n\ttests := []testutils.DiffTest{\n\t\t{Name: \"passthrough_small\", Stdin: []byte(\"hello\\nworld\\n\")},\n\t\t{Name: \"passthrough_empty\", Stdin: []byte{}},\n\t\t{Name: \"passthrough_single_byte\", Stdin: []byte(\"x\")},\n\t\t{Name: \"passthrough_no_newline\", Stdin: []byte(\"no trailing newline\")},\n\t\t{Name: \"passthrough_binary\", Stdin: allBytes()},\n\t\t{Name: \"passthrough_large\", Stdin: bytes.Repeat([]byte(\"abcdefghij\\n\"), 200000)},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n}\n\n// R3.3: append mode prepend operation.\nfunc TestDiffAppend(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin := lookupRefBinary(t)\n\n\ttests := []struct {\n\t\tname    string\n\t\tinitial []byte\n\t\tstdin   []byte\n\t}{\n\t\t{\n\t\t\tname:    \"append_basic\",\n\t\t\tinitial: []byte(\"original\\n\"),\n\t\t\tstdin:   []byte(\"appended\\n\"),\n\t\t},\n\t\t{\n\t\t\tname:    \"append_multiline\",\n\t\t\tinitial: []byte(\"line1\\nline2\\n\"),\n\t\t\tstdin:   []byte(\"line3\\nline4\\n\"),\n\t\t},\n\t\t{\n\t\t\tname:    \"append_empty_stdin\",\n\t\t\tinitial: []byte(\"keep this\\n\"),\n\t\t\tstdin:   []byte{},\n\t\t},\n\t\t{\n\t\t\tname:    \"append_empty_original\",\n\t\t\tinitial: []byte{},\n\t\t\tstdin:   []byte(\"new content\\n\"),\n\t\t},\n\t\t{\n\t\t\tname:    \"append_binary_data\",\n\t\t\tinitial: allBytes(),\n\t\t\tstdin:   allBytes(),\n\t\t},\n\t\t{\n\t\t\tname:    \"append_large_stdin\",\n\t\t\tinitial: []byte(\"prefix\\n\"),\n\t\t\tstdin:   bytes.Repeat([]byte(\"data-line\\n\"), 200000),\n\t\t},\n\t}\n\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tcompareAppendOutput(t, goBin, refBin, tc.initial, tc.stdin)\n\t\t})\n\t}\n}\n\nfunc compareAppendOutput(t *testing.T, goBin, refBin string, initial, stdin []byte) {\n\tt.Helper()\n\n\tgoDir := t.TempDir()\n\trefDir := t.TempDir()\n\toutName := \"out.txt\"\n\tgoOut := filepath.Join(goDir, outName)\n\trefOut := filepath.Join(refDir, outName)\n\n\twriteFile(t, goOut, initial)\n\twriteFile(t, refOut, initial)\n\n\trunSponge(t, goBin, []string{\"-a\", goOut}, stdin)\n\trunSponge(t, refBin, []string{\"-a\", refOut}, stdin)\n\n\tgoContent := readFile(t, goOut)\n\trefContent := readFile(t, refOut)\n\n\tif !bytes.Equal(goContent, refContent) {\n\t\tt.Fatalf(\"file content divergence\\n  ref: %q\\n  go:  %q\", refContent, goContent)\n\t}\n}\n\nfunc runSponge(t *testing.T, binary string, args []string, stdin []byte) {\n\tt.Helper()\n\tcmd := exec.Command(binary, args...)\n\tif stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(stdin)\n\t}\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\tif err := cmd.Run(); err != nil {\n\t\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\t\tt.Fatalf(\"%s exited %d: %s\", binary, exitErr.ExitCode(), stderr.String())\n\t\t}\n\t\tt.Fatalf(\"%s failed: %v\", binary, err)\n\t}\n}\n\nfunc writeFile(t *testing.T, path string, content []byte) {\n\tt.Helper()\n\tif err := os.WriteFile(path, content, 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n\nfunc readFile(t *testing.T, path string) []byte {\n\tt.Helper()\n\tcontent, err := os.ReadFile(path)\n\tif err != nil {\n\t\tt.Fatalf(\"read %s: %v\", path, err)\n\t}\n\treturn content\n}\n\nfunc allBytes() []byte {\n\tb := make([]byte, 256)\n\tfor i := range b {\n\t\tb[i] = byte(i)\n\t}\n\treturn b\n}\n\n// R5.1: exit 0 on all success paths.\nfunc TestDiffExitSuccess(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin := lookupRefBinary(t)\n\n\ttests := []testutils.DiffTest{\n\t\t{Name: \"exit0_passthrough\", Stdin: []byte(\"hello\\n\")},\n\t\t{Name: \"exit0_passthrough_empty\", Stdin: []byte{}},\n\t}\n\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n\n\tt.Run(\"exit0_file_output\", func(t *testing.T) {\n\t\tdir := t.TempDir()\n\t\trunSponge(t, goBin, []string{filepath.Join(dir, \"go.txt\")}, []byte(\"content\\n\"))\n\t\trunSponge(t, refBin, []string{filepath.Join(dir, \"ref.txt\")}, []byte(\"content\\n\"))\n\t})\n\n\tt.Run(\"exit0_append_new_file\", func(t *testing.T) {\n\t\tdir := t.TempDir()\n\t\trunSponge(t, goBin, []string{\"-a\", filepath.Join(dir, \"go.txt\")}, []byte(\"data\\n\"))\n\t\trunSponge(t, refBin, []string{\"-a\", filepath.Join(dir, \"ref.txt\")}, []byte(\"data\\n\"))\n\t})\n}\n\n// R5.2: exit 1 on error conditions with stderr message.\nfunc TestDiffExitError(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin := lookupRefBinary(t)\n\n\ttests := []struct {\n\t\tname string\n\t\targs []string\n\t}{\n\t\t{name: \"exit1_bad_output_dir\", args: []string{\"/nonexistent_sponge_test_5133/file.txt\"}},\n\t}\n\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tgoExit, goStderr := runCaptureExit(t, goBin, tc.args, []byte(\"data\"))\n\t\t\trefExit, refStderr := runCaptureExit(t, refBin, tc.args, []byte(\"data\"))\n\n\t\t\tif goExit != refExit {\n\t\t\t\tt.Fatalf(\"exit code divergence: go=%d ref=%d\\n  go stderr: %s\\n  ref stderr: %s\",\n\t\t\t\t\tgoExit, refExit, goStderr, refStderr)\n\t\t\t}\n\t\t\tif goExit != 1 {\n\t\t\t\tt.Fatalf(\"expected exit 1, got %d\", goExit)\n\t\t\t}\n\t\t\tif len(goStderr) == 0 {\n\t\t\t\tt.Fatal(\"go binary produced no stderr on error\")\n\t\t\t}\n\t\t\tif len(refStderr) == 0 {\n\t\t\t\tt.Fatal(\"ref binary produced no stderr on error\")\n\t\t\t}\n\t\t})\n\t}\n}\n\n// R5.3: large input completes without panic.\nfunc TestNoPanicLargeInput(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tlargeInput := bytes.Repeat([]byte(\"x\"), 2*1024*1024)\n\n\tcmd := exec.Command(goBin)\n\tcmd.Stdin = bytes.NewReader(largeInput)\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\n\tif err := cmd.Run(); err != nil {\n\t\tt.Fatalf(\"sponge failed on large input: %v\\nstderr: %s\", err, stderr.String())\n\t}\n\tif stdout.Len() != len(largeInput) {\n\t\tt.Fatalf(\"output length %d != input length %d\", stdout.Len(), len(largeInput))\n\t}\n}\n\n// R5.4: temp files are cleaned up on error paths.\nfunc TestTempFileCleanup(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\n\ttmpDir := t.TempDir()\n\n\tcmd := exec.Command(goBin, \"/nonexistent_sponge_test_5133/file.txt\")\n\tcmd.Stdin = bytes.NewReader([]byte(\"data to sponge\\n\"))\n\tcmd.Env = envWithTMPDIR(tmpDir)\n\tcmd.Stderr = &bytes.Buffer{}\n\t_ = cmd.Run()\n\n\tentries, err := os.ReadDir(tmpDir)\n\tif err != nil {\n\t\tt.Fatalf(\"read tmpdir: %v\", err)\n\t}\n\tfor _, e := range entries {\n\t\tt.Errorf(\"temp file not cleaned up: %s\", e.Name())\n\t}\n}\n\nfunc runCaptureExit(t *testing.T, binary string, args []string, stdin []byte) (int, string) {\n\tt.Helper()\n\tcmd := exec.Command(binary, args...)\n\tif stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(stdin)\n\t}\n\tvar stderr bytes.Buffer\n\tcmd.Stderr = &stderr\n\terr := cmd.Run()\n\tif err == nil {\n\t\treturn 0, stderr.String()\n\t}\n\tif exitErr, ok := err.(*exec.ExitError); ok {\n\t\treturn exitErr.ExitCode(), stderr.String()\n\t}\n\tt.Fatalf(\"failed to run %s: %v\", binary, err)\n\treturn -1, \"\"\n}\n\nfunc envWithTMPDIR(dir string) []string {\n\tvar env []string\n\tfor _, e := range os.Environ() {\n\t\tif !strings.HasPrefix(e, \"TMPDIR=\") {\n\t\t\tenv = append(env, e)\n\t\t}\n\t}\n\treturn append(env, \"TMPDIR=\"+dir)\n}\n","numLines":279,"startLine":1,"totalLines":279}}}
