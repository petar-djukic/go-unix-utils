seArgs(args []string) []string {\n\tvar remaining []string\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tremaining = append(remaining, arg)\n\t\t\tcontinue\n\t\t}\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\tendOfFlags = true\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"users: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'users --help' for more information.\")\n\t\t\tos.Exit(1)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tfmt.Fprintf(os.Stderr, \"users: invalid option -- '%c'\\n\", arg[1])\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'users --help' for more information.\")\n\t\t\tos.Exit(1)\n\t\tdefault:\n\t\t\tremaining = append(remaining, arg)\n\t\t}\n\t}\n\treturn remaining\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":342,"cache_read_input_tokens":36305,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":342},"output_tokens":61,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0bb1df27-2eb6-4fc4-8720-a21df565c08b","uuid":"bbb6ba63-f4c6-4631-9993-042831a2e374"}
