{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014eE3KuR5J5Z33icEBgVzDM","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"regexp\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype patternKind int\n19\t\n20\tconst (\n21\t\tkindRegexp patternKind = iota\n22\t\tkindSkip\n23\t\tkindInteger\n24\t)\n25\t\n26\ttype pattern struct {\n27\t\tkind    patternKind\n28\t\tregex   *regexp.Regexp\n29\t\tlineNum int\n30\t\toffset  int\n31\t\trepeat  int // 0 = no repeat, >0 = repeat N times, -1 = repeat until exhausted\n32\t\traw     string\n33\t}\n34\t\n35\ttype splitter struct {\n36\t\tlines   []string\n37\t\tpos     int\n38\t\tfileNum int\n39\t\tprefix  string\n40\t\tdigits  int\n41\t\tcreated []string\n42\t\tatMatch bool\n43\t}\n44\t\n45\tfunc main() {\n46\t\tsys.InstallSIGPIPEHandler()\n47\t\tif err := run(os.Args[1:]); err != nil {\n48\t\t\tfmt.Fprintf(os.Stderr, \"%s\\n\", err)\n49\t\t\tos.Exit(1)\n50\t\t}\n51\t}\n52\t\n53\tfunc run(args []string) error {\n54\t\tif len(args) < 2 {\n55\t\t\tif len(args) == 0 {\n56\t\t\t\treturn fmt.Errorf(\"csplit: missing operand\")\n57\t\t\t}\n58\t\t\treturn fmt.Errorf(\"csplit: missing operand after '%s'\", args[0])\n59\t\t}\n60\t\tpats, err := parsePatterns(args[1:])\n61\t\tif err != nil {\n62\t\t\treturn err\n63\t\t}\n64\t\tdata, err := readInput(args[0])\n65\t\tif err != nil {\n66\t\t\treturn err\n67\t\t}\n68\t\ts := &splitter{\n69\t\t\tlines:  splitToLines(data),\n70\t\t\tprefix: \"xx\",\n71\t\t\tdigits: 2,\n72\t\t}\n73\t\treturn s.process(pats)\n74\t}\n75\t\n76\tfunc readInput(filename string) ([]byte, error) {\n77\t\tif filename == \"-\" {\n78\t\t\tdata, err := io.ReadAll(os.Stdin)\n79\t\t\tif err != nil {\n80\t\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n81\t\t\t}\n82\t\t\treturn data, nil\n83\t\t}\n84\t\tdata, err := os.ReadFile(filename)\n85\t\tif err != nil {\n86\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n87\t\t}\n88\t\treturn data, nil\n89\t}\n90\t\n91\tfunc splitToLines(data []byte) []string {\n92\t\tif len(data) == 0 {\n93\t\t\treturn nil\n94\t\t}\n95\t\tvar lines []string\n96\t\tfor len(data) > 0 {\n97\t\t\tidx := bytes.IndexByte(data, '\\n')\n98\t\t\tif idx < 0 {\n99\t\t\t\tlines = append(lines, string(data))\n100\t\t\t\tbreak\n101\t\t\t}\n102\t\t\tlines = append(lines, string(data[:idx+1]))\n103\t\t\tdata = data[idx+1:]\n104\t\t}\n105\t\treturn lines\n106\t}\n107\t\n108\tfunc parsePatterns(args []string) ([]pattern, error) {\n109\t\tpats := make([]pattern, 0, len(args))\n110\t\tfor _, arg := range args {\n111\t\t\tif rep, ok := parseRepeat(arg); ok {\n112\t\t\t\tif len(pats) == 0 {\n113\t\t\t\t\treturn nil, fmt.Errorf(\"csplit: '%s': no preceding pattern\", arg)\n114\t\t\t\t}\n115\t\t\t\tpats[len(pats)-1].repeat = rep\n116\t\t\t\tcontinue\n117\t\t\t}\n118\t\t\tp, err := parsePattern(arg)\n119\t\t\tif err != nil {\n120\t\t\t\treturn nil, err\n121\t\t\t}\n122\t\t\tpats = append(pats, p)\n123\t\t}\n124\t\treturn pats, nil\n125\t}\n126\t\n127\tfunc parseRepeat(arg string) (int, bool) {\n128\t\tif len(arg) < 3 || arg[0] != '{' || arg[len(arg)-1] != '}' {\n129\t\t\treturn 0, false\n130\t\t}\n131\t\tinner := arg[1 : len(arg)-1]\n132\t\tif inner == \"*\" {\n133\t\t\treturn -1, true\n134\t\t}\n135\t\tn, err := strconv.Atoi(inner)\n136\t\tif err != nil || n < 0 {\n137\t\t\treturn 0, false\n138\t\t}\n139\t\treturn n, true\n140\t}\n141\t\n142\tfunc parsePattern(arg string) (pattern, error) {\n143\t\tif expr, offset, ok := parseDelimitedWithOffset(arg, '/'); ok {\n144\t\t\tre, err := regexp.Compile(expr)\n145\t\t\tif err != nil {\n146\t\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n147\t\t\t}\n148\t\t\treturn pattern{kind: kindRegexp, regex: re, offset: offset, raw: arg}, nil\n149\t\t}\n150\t\tif expr, offset, ok := parseDelimitedWithOffset(arg, '%'); ok {\n151\t\t\tre, err := regexp.Compile(expr)\n152\t\t\tif err != nil {\n153\t\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n154\t\t\t}\n155\t\t\treturn pattern{kind: kindSkip, regex: re, offset: offset, raw: arg}, nil\n156\t\t}\n157\t\tn, err := strconv.Atoi(arg)\n158\t\tif err == nil && n >= 0 {\n159\t\t\treturn pattern{kind: kindInteger, lineNum: n, raw: arg}, nil\n160\t\t}\n161\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': invalid pattern\", arg)\n162\t}\n163\t\n164\tfunc parseDelimitedWithOffset(arg string, delim byte) (string, int, bool) {\n165\t\tif len(arg) < 2 || arg[0] != delim {\n166\t\t\treturn \"\", 0, false\n167\t\t}\n168\t\tend := strings.LastIndexByte(arg[1:], delim)\n169\t\tif end < 0 {\n170\t\t\treturn \"\", 0, false\n171\t\t}\n172\t\tend += 1\n173\t\texpr := arg[1:end]\n174\t\trest := arg[end+1:]\n175\t\toffset := 0\n176\t\tif rest != \"\" {\n177\t\t\tn, err := strconv.Atoi(rest)\n178\t\t\tif err != nil {\n179\t\t\t\treturn \"\", 0, false\n180\t\t\t}\n181\t\t\toffset = n\n182\t\t}\n183\t\treturn expr, offset, true\n184\t}\n185\t\n186\tfunc (s *splitter) process(pats []pattern) error {\n187\t\tfor _, pat := range pats {\n188\t\t\tif pat.repeat == 0 {\n189\t\t\t\tif err := s.apply(pat, false); err != nil {\n190\t\t\t\t\tremoveFiles(s.created)\n191\t\t\t\t\treturn err\n192\t\t\t\t}\n193\t\t\t} else if pat.repeat == -1 {\n194\t\t\t\tif err := s.applyNoEmitOnFail(pat, false); err != nil {\n195\t\t\t\t\tbreak\n196\t\t\t\t}\n197\t\t\t\tfor {\n198\t\t\t\t\tif err := s.applyNoEmitOnFail(pat, true); err != nil {\n199\t\t\t\t\t\tbreak\n200\t\t\t\t\t}\n201\t\t\t\t}\n202\t\t\t} else {\n203\t\t\t\tif err := s.apply(pat, false); err != nil {\n204\t\t\t\t\tremoveFiles(s.created)\n205\t\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found on repetition 0\", pat.raw)\n206\t\t\t\t}\n207\t\t\t\tfor i := 1; i <= pat.repeat; i++ {\n208\t\t\t\t\tif err := s.apply(pat, true); err != nil {\n209\t\t\t\t\t\tremoveFiles(s.created)\n210\t\t\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found on repetition %d\", pat.raw, i)\n211\t\t\t\t\t}\n212\t\t\t\t}\n213\t\t\t}\n214\t\t}\n215\t\tif err := s.emitPiece(len(s.lines)); err != nil {\n216\t\t\tremoveFiles(s.created)\n217\t\t\treturn err\n218\t\t}\n219\t\treturn nil\n220\t}\n221\t\n222\tfunc (s *splitter) applyNoEmitOnFail(pat pattern, repeated bool) error {\n223\t\tswitch pat.kind {\n224\t\tcase kindRegexp:\n225\t\t\tstart := s.pos\n226\t\t\tif s.atMatch {\n227\t\t\t\tstart = s.pos + 1\n228\t\t\t}\n229\t\t\tidx := matchRegexp(s.lines, start, pat.regex)\n230\t\t\tif idx < 0 {\n231\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n232\t\t\t}\n233\t\t\ttarget := idx + pat.offset\n234\t\t\tif target < s.pos {\n235\t\t\t\ttarget = s.pos\n236\t\t\t}\n237\t\t\tif target > len(s.lines) {\n238\t\t\t\ttarget = len(s.lines)\n239\t\t\t}\n240\t\t\ts.atMatch = true\n241\t\t\treturn s.emitPiece(target)\n242\t\tcase kindSkip:\n243\t\t\tstart := s.pos\n244\t\t\tif s.atMatch {\n245\t\t\t\tstart = s.pos + 1\n246\t\t\t}\n247\t\t\tidx := matchRegexp(s.lines, start, pat.regex)\n248\t\t\tif idx < 0 {\n249\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n250\t\t\t}\n251\t\t\ttarget := idx + pat.offset\n252\t\t\tif target < s.pos {\n253\t\t\t\ttarget = s.pos\n254\t\t\t}\n255\t\t\tif target > len(s.lines) {\n256\t\t\t\ttarget = len(s.lines)\n257\t\t\t}\n258\t\t\ts.pos = target\n259\t\t\ts.atMatch = true\n260\t\t\treturn nil\n261\t\tdefault:\n262\t\t\tvar target int\n263\t\t\tif repeated {\n264\t\t\t\ttarget = s.pos + pat.lineNum\n265\t\t\t} else {\n266\t\t\t\ttarget = pat.lineNum - 1\n267\t\t\t}\n268\t\t\tif target > len(s.lines) || target < s.pos {\n269\t\t\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n270\t\t\t}\n271\t\t\ts.atMatch = false\n272\t\t\treturn s.emitPiece(target)\n273\t\t}\n274\t}\n275\t\n276\tfunc (s *splitter) apply(pat pattern, repeated bool) error {\n277\t\tswitch pat.kind {\n278\t\tcase kindRegexp:\n279\t\t\tstart := s.pos\n280\t\t\tif s.atMatch {\n281\t\t\t\tstart = s.pos + 1\n282\t\t\t}\n283\t\t\tidx := matchRegexp(s.lines, start, pat.regex)\n284\t\t\tif idx < 0 {\n285\t\t\t\ts.emitPiece(len(s.lines))\n286\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n287\t\t\t}\n288\t\t\ttarget := idx + pat.offset\n289\t\t\tif target < s.pos {\n290\t\t\t\ttarget = s.pos\n291\t\t\t}\n292\t\t\tif target > len(s.lines) {\n293\t\t\t\ttarget = len(s.lines)\n294\t\t\t}\n295\t\t\ts.atMatch = true\n296\t\t\treturn s.emitPiece(target)\n297\t\tcase kindSkip:\n298\t\t\tstart := s.pos\n299\t\t\tif s.atMatch {\n300\t\t\t\tstart = s.pos + 1\n301\t\t\t}\n302\t\t\tidx := matchRegexp(s.lines, start, pat.regex)\n303\t\t\tif idx < 0 {\n304\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n305\t\t\t}\n306\t\t\ttarget := idx + pat.offset\n307\t\t\tif target < s.pos {\n308\t\t\t\ttarget = s.pos\n309\t\t\t}\n310\t\t\tif target > len(s.lines) {\n311\t\t\t\ttarget = len(s.lines)\n312\t\t\t}\n313\t\t\ts.pos = target\n314\t\t\ts.atMatch = true\n315\t\t\treturn nil\n316\t\tdefault:\n317\t\t\treturn s.applyInteger(pat, repeated)\n318\t\t}\n319\t}\n320\t\n321\tfunc (s *splitter) applyInteger(pat pattern, repeated bool) error {\n322\t\tvar target int\n323\t\tif repeated {\n324\t\t\ttarget = s.pos + pat.lineNum\n325\t\t} else {\n326\t\t\ttarget = pat.lineNum - 1\n327\t\t}\n328\t\tif target < s.pos || target > len(s.lines) {\n329\t\t\ts.emitPiece(len(s.lines))\n330\t\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n331\t\t}\n332\t\ts.atMatch = false\n333\t\treturn s.emitPiece(target)\n334\t}\n335\t\n336\tfunc (s *splitter) emitPiece(to int) error {\n337\t\tpiece := s.lines[s.pos:to]\n338\t\tname := fmt.Sprintf(\"%s%0*d\", s.prefix, s.digits, s.fileNum)\n339\t\ts.created = append(s.created, name)\n340\t\tcontent := strings.Join(piece, \"\")\n341\t\tif err := os.WriteFile(name, []byte(content), 0666); err != nil {\n342\t\t\treturn fmt.Errorf(\"csplit: %v\", err)\n343\t\t}\n344\t\ts.fileNum++\n345\t\ts.pos = to\n346\t\tfmt.Println(len(content))\n347\t\treturn nil\n348\t}\n349\t\n350\tfunc matchRegexp(lines []string, start int, re *regexp.Regexp) int {\n351\t\tfor i := start; i < len(lines); i++ {\n352\t\t\tline := strings.TrimSuffix(lines[i], \"\\n\")\n353\t\t\tif re.MatchString(line) {\n354\t\t\t\treturn i\n355\t\t\t}\n356\t\t}\n357\t\treturn -1\n358\t}\n359\t\n360\tfunc removeFiles(files []string) {\n361\t\tfor _, f := range files {\n362\t\t\tos.Remove(f)\n363\t\t}\n364\t}\n365\t"}]},"parent_tool_use_id":null,"session_id":"8adf9be9-77d5-48e0-b511-6046f6e0d48d","uuid":"3916c88c-710a-4c18-9b9e-571beff67411","timestamp":"2026-05-21T20:13:52.313Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5451/cmd/csplit/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"regexp\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype patternKind int\n\nconst (\n\tkindRegexp patternKind = iota\n\tkindSkip\n\tkindInteger\n)\n\ntype pattern struct {\n\tkind    patternKind\n\tregex   *regexp.Regexp\n\tlineNum int\n\toffset  int\n\trepeat  int // 0 = no repeat, >0 = repeat N times, -1 = repeat until exhausted\n\traw     string\n}\n\ntype splitter struct {\n\tlines   []string\n\tpos     int\n\tfileNum int\n\tprefix  string\n\tdigits  int\n\tcreated []string\n\tatMatch bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tif err := run(os.Args[1:]); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"%s\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc run(args []string) error {\n\tif len(args) < 2 {\n\t\tif len(args) == 0 {\n\t\t\treturn fmt.Errorf(\"csplit: missing operand\")\n\t\t}\n\t\treturn fmt.Errorf(\"csplit: missing operand after '%s'\", args[0])\n\t}\n\tpats, err := parsePatterns(args[1:])\n\tif err != nil {\n\t\treturn err\n\t}\n\tdata, err := readInput(args[0])\n\tif err != nil {\n\t\treturn err\n\t}\n\ts := &splitter{\n\t\tlines:  splitToLines(data),\n\t\tprefix: \"xx\",\n\t\tdigits: 2,\n\t}\n\treturn s.process(pats)\n}\n\nfunc readInput(filename string) ([]byte, error) {\n\tif filename == \"-\" {\n\t\tdata, err := io.ReadAll(os.Stdin)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n\t\t}\n\t\treturn data, nil\n\t}\n\tdata, err := os.ReadFile(filename)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"csplit: %v\", err)\n\t}\n\treturn data, nil\n}\n\nfunc splitToLines(data []byte) []string {\n\tif len(data) == 0 {\n\t\treturn nil\n\t}\n\tvar lines []string\n\tfor len(data) > 0 {\n\t\tidx := bytes.IndexByte(data, '\\n')\n\t\tif idx < 0 {\n\t\t\tlines = append(lines, string(data))\n\t\t\tbreak\n\t\t}\n\t\tlines = append(lines, string(data[:idx+1]))\n\t\tdata = data[idx+1:]\n\t}\n\treturn lines\n}\n\nfunc parsePatterns(args []string) ([]pattern, error) {\n\tpats := make([]pattern, 0, len(args))\n\tfor _, arg := range args {\n\t\tif rep, ok := parseRepeat(arg); ok {\n\t\t\tif len(pats) == 0 {\n\t\t\t\treturn nil, fmt.Errorf(\"csplit: '%s': no preceding pattern\", arg)\n\t\t\t}\n\t\t\tpats[len(pats)-1].repeat = rep\n\t\t\tcontinue\n\t\t}\n\t\tp, err := parsePattern(arg)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tpats = append(pats, p)\n\t}\n\treturn pats, nil\n}\n\nfunc parseRepeat(arg string) (int, bool) {\n\tif len(arg) < 3 || arg[0] != '{' || arg[len(arg)-1] != '}' {\n\t\treturn 0, false\n\t}\n\tinner := arg[1 : len(arg)-1]\n\tif inner == \"*\" {\n\t\treturn -1, true\n\t}\n\tn, err := strconv.Atoi(inner)\n\tif err != nil || n < 0 {\n\t\treturn 0, false\n\t}\n\treturn n, true\n}\n\nfunc parsePattern(arg string) (pattern, error) {\n\tif expr, offset, ok := parseDelimitedWithOffset(arg, '/'); ok {\n\t\tre, err := regexp.Compile(expr)\n\t\tif err != nil {\n\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n\t\t}\n\t\treturn pattern{kind: kindRegexp, regex: re, offset: offset, raw: arg}, nil\n\t}\n\tif expr, offset, ok := parseDelimitedWithOffset(arg, '%'); ok {\n\t\tre, err := regexp.Compile(expr)\n\t\tif err != nil {\n\t\t\treturn pattern{}, fmt.Errorf(\"csplit: '%s': %v\", arg, err)\n\t\t}\n\t\treturn pattern{kind: kindSkip, regex: re, offset: offset, raw: arg}, nil\n\t}\n\tn, err := strconv.Atoi(arg)\n\tif err == nil && n >= 0 {\n\t\treturn pattern{kind: kindInteger, lineNum: n, raw: arg}, nil\n\t}\n\treturn pattern{}, fmt.Errorf(\"csplit: '%s': invalid pattern\", arg)\n}\n\nfunc parseDelimitedWithOffset(arg string, delim byte) (string, int, bool) {\n\tif len(arg) < 2 || arg[0] != delim {\n\t\treturn \"\", 0, false\n\t}\n\tend := strings.LastIndexByte(arg[1:], delim)\n\tif end < 0 {\n\t\treturn \"\", 0, false\n\t}\n\tend += 1\n\texpr := arg[1:end]\n\trest := arg[end+1:]\n\toffset := 0\n\tif rest != \"\" {\n\t\tn, err := strconv.Atoi(rest)\n\t\tif err != nil {\n\t\t\treturn \"\", 0, false\n\t\t}\n\t\toffset = n\n\t}\n\treturn expr, offset, true\n}\n\nfunc (s *splitter) process(pats []pattern) error {\n\tfor _, pat := range pats {\n\t\tif pat.repeat == 0 {\n\t\t\tif err := s.apply(pat, false); err != nil {\n\t\t\t\tremoveFiles(s.created)\n\t\t\t\treturn err\n\t\t\t}\n\t\t} else if pat.repeat == -1 {\n\t\t\tif err := s.applyNoEmitOnFail(pat, false); err != nil {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tfor {\n\t\t\t\tif err := s.applyNoEmitOnFail(pat, true); err != nil {\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t}\n\t\t} else {\n\t\t\tif err := s.apply(pat, false); err != nil {\n\t\t\t\tremoveFiles(s.created)\n\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found on repetition 0\", pat.raw)\n\t\t\t}\n\t\t\tfor i := 1; i <= pat.repeat; i++ {\n\t\t\t\tif err := s.apply(pat, true); err != nil {\n\t\t\t\t\tremoveFiles(s.created)\n\t\t\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found on repetition %d\", pat.raw, i)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\tif err := s.emitPiece(len(s.lines)); err != nil {\n\t\tremoveFiles(s.created)\n\t\treturn err\n\t}\n\treturn nil\n}\n\nfunc (s *splitter) applyNoEmitOnFail(pat pattern, repeated bool) error {\n\tswitch pat.kind {\n\tcase kindRegexp:\n\t\tstart := s.pos\n\t\tif s.atMatch {\n\t\t\tstart = s.pos + 1\n\t\t}\n\t\tidx := matchRegexp(s.lines, start, pat.regex)\n\t\tif idx < 0 {\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ttarget := idx + pat.offset\n\t\tif target < s.pos {\n\t\t\ttarget = s.pos\n\t\t}\n\t\tif target > len(s.lines) {\n\t\t\ttarget = len(s.lines)\n\t\t}\n\t\ts.atMatch = true\n\t\treturn s.emitPiece(target)\n\tcase kindSkip:\n\t\tstart := s.pos\n\t\tif s.atMatch {\n\t\t\tstart = s.pos + 1\n\t\t}\n\t\tidx := matchRegexp(s.lines, start, pat.regex)\n\t\tif idx < 0 {\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ttarget := idx + pat.offset\n\t\tif target < s.pos {\n\t\t\ttarget = s.pos\n\t\t}\n\t\tif target > len(s.lines) {\n\t\t\ttarget = len(s.lines)\n\t\t}\n\t\ts.pos = target\n\t\ts.atMatch = true\n\t\treturn nil\n\tdefault:\n\t\tvar target int\n\t\tif repeated {\n\t\t\ttarget = s.pos + pat.lineNum\n\t\t} else {\n\t\t\ttarget = pat.lineNum - 1\n\t\t}\n\t\tif target > len(s.lines) || target < s.pos {\n\t\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n\t\t}\n\t\ts.atMatch = false\n\t\treturn s.emitPiece(target)\n\t}\n}\n\nfunc (s *splitter) apply(pat pattern, repeated bool) error {\n\tswitch pat.kind {\n\tcase kindRegexp:\n\t\tstart := s.pos\n\t\tif s.atMatch {\n\t\t\tstart = s.pos + 1\n\t\t}\n\t\tidx := matchRegexp(s.lines, start, pat.regex)\n\t\tif idx < 0 {\n\t\t\ts.emitPiece(len(s.lines))\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ttarget := idx + pat.offset\n\t\tif target < s.pos {\n\t\t\ttarget = s.pos\n\t\t}\n\t\tif target > len(s.lines) {\n\t\t\ttarget = len(s.lines)\n\t\t}\n\t\ts.atMatch = true\n\t\treturn s.emitPiece(target)\n\tcase kindSkip:\n\t\tstart := s.pos\n\t\tif s.atMatch {\n\t\t\tstart = s.pos + 1\n\t\t}\n\t\tidx := matchRegexp(s.lines, start, pat.regex)\n\t\tif idx < 0 {\n\t\t\treturn fmt.Errorf(\"csplit: '%s': match not found\", pat.raw)\n\t\t}\n\t\ttarget := idx + pat.offset\n\t\tif target < s.pos {\n\t\t\ttarget = s.pos\n\t\t}\n\t\tif target > len(s.lines) {\n\t\t\ttarget = len(s.lines)\n\t\t}\n\t\ts.pos = target\n\t\ts.atMatch = true\n\t\treturn nil\n\tdefault:\n\t\treturn s.applyInteger(pat, repeated)\n\t}\n}\n\nfunc (s *splitter) applyInteger(pat pattern, repeated bool) error {\n\tvar target int\n\tif repeated {\n\t\ttarget = s.pos + pat.lineNum\n\t} else {\n\t\ttarget = pat.lineNum - 1\n\t}\n\tif target < s.pos || target > len(s.lines) {\n\t\ts.emitPiece(len(s.lines))\n\t\treturn fmt.Errorf(\"csplit: '%d': line number out of range\", pat.lineNum)\n\t}\n\ts.atMatch = false\n\treturn s.emitPiece(target)\n}\n\nfunc (s *splitter) emitPiece(to int) error {\n\tpiece := s.lines[s.pos:to]\n\tname := fmt.Sprintf(\"%s%0*d\", s.prefix, s.digits, s.fileNum)\n\ts.created = append(s.created, name)\n\tcontent := strings.Join(piece, \"\")\n\tif err := os.WriteFile(name, []byte(content), 0666); err != nil {\n\t\treturn fmt.Errorf(\"csplit: %v\", err)\n\t}\n\ts.fileNum++\n\ts.pos = to\n\tfmt.Println(len(content))\n\treturn nil\n}\n\nfunc matchRegexp(lines []string, start int, re *regexp.Regexp) int {\n\tfor i := start; i < len(lines); i++ {\n\t\tline := strings.TrimSuffix(lines[i], \"\\n\")\n\t\tif re.MatchString(line) {\n\t\t\treturn i\n\t\t}\n\t}\n\treturn -1\n}\n\nfunc removeFiles(files []string) {\n\tfor _, f := range files {\n\t\tos.Remove(f)\n\t}\n}\n","numLines":365,"startLine":1,"totalLines":365}}}
