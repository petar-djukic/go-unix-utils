{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Aea6Y7zycKPpsmU62ihbMi","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"bytes\"\n9\t\t\"context\"\n10\t\t\"errors\"\n11\t\t\"os/exec\"\n12\t\t\"testing\"\n13\t\t\"time\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n16\t)\n17\t\n18\tfunc TestDiff(t *testing.T) {\n19\t\tt.Parallel()\n20\t\tgoBin := testutils.BuildBinary(t, \".\")\n21\t\trefBin, err := exec.LookPath(\"gyes\")\n22\t\tif err != nil {\n23\t\t\tt.Skip(\"reference binary not found\")\n24\t\t}\n25\t\n26\t\ttests := []struct {\n27\t\t\tname  string\n28\t\t\targs  []string\n29\t\t\tlines int\n30\t\t}{\n31\t\t\t{\"default-y\", nil, 5},\n32\t\t\t{\"single-arg\", []string{\"hello\"}, 5},\n33\t\t\t{\"multi-args\", []string{\"hello\", \"world\"}, 5},\n34\t\t\t{\"dash-dash-arg\", []string{\"--\", \"--help\"}, 3},\n35\t\t\t{\"dash-dash-only\", []string{\"--\"}, 3},\n36\t\t\t{\"empty-string\", []string{\"\"}, 3},\n37\t\t}\n38\t\n39\t\tfor _, tc := range tests {\n40\t\t\tt.Run(tc.name, func(t *testing.T) {\n41\t\t\t\tt.Parallel()\n42\t\t\t\tgoOut := captureLines(t, goBin, tc.args, tc.lines)\n43\t\t\t\trefOut := captureLines(t, refBin, tc.args, tc.lines)\n44\t\t\t\tif !bytes.Equal(goOut, refOut) {\n45\t\t\t\t\tt.Errorf(\"output mismatch\\ngo:  %q\\nref: %q\", goOut, refOut)\n46\t\t\t\t}\n47\t\t\t})\n48\t\t}\n49\t}\n50\t\n51\tfunc TestExitCodeOnSIGPIPE(t *testing.T) {\n52\t\tt.Parallel()\n53\t\tgoBin := testutils.BuildBinary(t, \".\")\n54\t\n55\t\tcode := captureExitCode(t, goBin, nil)\n56\t\tif code != 0 {\n57\t\t\tt.Errorf(\"expected exit code 0 on broken pipe, got %d\", code)\n58\t\t}\n59\t}\n60\t\n61\tfunc captureExitCode(t *testing.T, binary string, args []string) int {\n62\t\tt.Helper()\n63\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n64\t\tdefer cancel()\n65\t\n66\t\tcmd := exec.CommandContext(ctx, binary, args...)\n67\t\tstdout, err := cmd.StdoutPipe()\n68\t\tif err != nil {\n69\t\t\tt.Fatalf(\"StdoutPipe: %v\", err)\n70\t\t}\n71\t\tif err := cmd.Start(); err != nil {\n72\t\t\tt.Fatalf(\"Start: %v\", err)\n73\t\t}\n74\t\n75\t\tscanner := bufio.NewScanner(stdout)\n76\t\tif scanner.Scan() {\n77\t\t\t_ = scanner.Text()\n78\t\t}\n79\t\tstdout.Close()\n80\t\n81\t\terr = cmd.Wait()\n82\t\tif err == nil {\n83\t\t\treturn 0\n84\t\t}\n85\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n86\t\t\treturn exitErr.ExitCode()\n87\t\t}\n88\t\tt.Fatalf(\"unexpected wait error: %v\", err)\n89\t\treturn -1\n90\t}\n91\t\n92\tfunc captureLines(t *testing.T, binary string, args []string, n int) []byte {\n93\t\tt.Helper()\n94\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n95\t\tdefer cancel()\n96\t\n97\t\tcmd := exec.CommandContext(ctx, binary, args...)\n98\t\tstdout, err := cmd.StdoutPipe()\n99\t\tif err != nil {\n100\t\t\tt.Fatalf(\"StdoutPipe: %v\", err)\n101\t\t}\n102\t\tif err := cmd.Start(); err != nil {\n103\t\t\tt.Fatalf(\"Start: %v\", err)\n104\t\t}\n105\t\n106\t\tvar buf bytes.Buffer\n107\t\tscanner := bufio.NewScanner(stdout)\n108\t\tfor i := 0; i < n && scanner.Scan(); i++ {\n109\t\t\tbuf.Write(scanner.Bytes())\n110\t\t\tbuf.WriteByte('\\n')\n111\t\t}\n112\t\n113\t\tstdout.Close()\n114\t\t_ = cmd.Wait()\n115\t\treturn buf.Bytes()\n116\t}\n117\t"}]},"parent_tool_use_id":null,"session_id":"ed0e1932-750d-44c2-9378-90254e3e2f4c","uuid":"39029131-7505-4a61-b204-cb87db8de89f","timestamp":"2026-05-14T10:56:24.393Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5143/cmd/yes/yes_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"os/exec\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nfunc TestDiff(t *testing.T) {\n\tt.Parallel()\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gyes\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttests := []struct {\n\t\tname  string\n\t\targs  []string\n\t\tlines int\n\t}{\n\t\t{\"default-y\", nil, 5},\n\t\t{\"single-arg\", []string{\"hello\"}, 5},\n\t\t{\"multi-args\", []string{\"hello\", \"world\"}, 5},\n\t\t{\"dash-dash-arg\", []string{\"--\", \"--help\"}, 3},\n\t\t{\"dash-dash-only\", []string{\"--\"}, 3},\n\t\t{\"empty-string\", []string{\"\"}, 3},\n\t}\n\n\tfor _, tc := range tests {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\tt.Parallel()\n\t\t\tgoOut := captureLines(t, goBin, tc.args, tc.lines)\n\t\t\trefOut := captureLines(t, refBin, tc.args, tc.lines)\n\t\t\tif !bytes.Equal(goOut, refOut) {\n\t\t\t\tt.Errorf(\"output mismatch\\ngo:  %q\\nref: %q\", goOut, refOut)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestExitCodeOnSIGPIPE(t *testing.T) {\n\tt.Parallel()\n\tgoBin := testutils.BuildBinary(t, \".\")\n\n\tcode := captureExitCode(t, goBin, nil)\n\tif code != 0 {\n\t\tt.Errorf(\"expected exit code 0 on broken pipe, got %d\", code)\n\t}\n}\n\nfunc captureExitCode(t *testing.T, binary string, args []string) int {\n\tt.Helper()\n\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\tdefer cancel()\n\n\tcmd := exec.CommandContext(ctx, binary, args...)\n\tstdout, err := cmd.StdoutPipe()\n\tif err != nil {\n\t\tt.Fatalf(\"StdoutPipe: %v\", err)\n\t}\n\tif err := cmd.Start(); err != nil {\n\t\tt.Fatalf(\"Start: %v\", err)\n\t}\n\n\tscanner := bufio.NewScanner(stdout)\n\tif scanner.Scan() {\n\t\t_ = scanner.Text()\n\t}\n\tstdout.Close()\n\n\terr = cmd.Wait()\n\tif err == nil {\n\t\treturn 0\n\t}\n\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n\t\treturn exitErr.ExitCode()\n\t}\n\tt.Fatalf(\"unexpected wait error: %v\", err)\n\treturn -1\n}\n\nfunc captureLines(t *testing.T, binary string, args []string, n int) []byte {\n\tt.Helper()\n\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\tdefer cancel()\n\n\tcmd := exec.CommandContext(ctx, binary, args...)\n\tstdout, err := cmd.StdoutPipe()\n\tif err != nil {\n\t\tt.Fatalf(\"StdoutPipe: %v\", err)\n\t}\n\tif err := cmd.Start(); err != nil {\n\t\tt.Fatalf(\"Start: %v\", err)\n\t}\n\n\tvar buf bytes.Buffer\n\tscanner := bufio.NewScanner(stdout)\n\tfor i := 0; i < n && scanner.Scan(); i++ {\n\t\tbuf.Write(scanner.Bytes())\n\t\tbuf.WriteByte('\\n')\n\t}\n\n\tstdout.Close()\n\t_ = cmd.Wait()\n\treturn buf.Bytes()\n}\n","numLines":117,"startLine":1,"totalLines":117}}}
