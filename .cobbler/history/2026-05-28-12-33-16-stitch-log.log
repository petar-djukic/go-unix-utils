{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T8C8ckE7JapiHKwDipXLkP","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"sort\"\n11\t\n12\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n13\t)\n14\t\n15\ttype node struct {\n16\t\tstr     string\n17\t\tcount   int\n18\t\tprinted bool\n19\t\tqlink   *node\n20\t\ttop     *successor\n21\t}\n22\t\n23\ttype successor struct {\n24\t\tsuc  *node\n25\t\tnext *successor\n26\t}\n27\t\n28\tfunc main() {\n29\t\tsys.InstallSIGPIPEHandler()\n30\t\tos.Exit(run())\n31\t}\n32\t\n33\tfunc run() int {\n34\t\targs := os.Args[1:]\n35\t\tif len(args) > 1 {\n36\t\t\tfmt.Fprintf(os.Stderr, \"tsort: extra operand %s\\n\", args[1])\n37\t\t\treturn 1\n38\t\t}\n39\t\n40\t\tfile := \"-\"\n41\t\tif len(args) == 1 {\n42\t\t\tfile = args[0]\n43\t\t}\n44\t\n45\t\tvar input *os.File\n46\t\tif file == \"-\" {\n47\t\t\tinput = os.Stdin\n48\t\t} else {\n49\t\t\tvar err error\n50\t\t\tinput, err = os.Open(file)\n51\t\t\tif err != nil {\n52\t\t\t\tfmt.Fprintf(os.Stderr, \"tsort: %s: %s\\n\", file, unwrapPathErr(err))\n53\t\t\t\treturn 1\n54\t\t\t}\n55\t\t\tdefer input.Close()\n56\t\t}\n57\t\n58\t\tscanner := bufio.NewScanner(input)\n59\t\tscanner.Split(bufio.ScanWords)\n60\t\n61\t\tnodes := make(map[string]*node)\n62\t\tvar names []string\n63\t\n64\t\tgetOrCreate := func(s string) *node {\n65\t\t\tif n, ok := nodes[s]; ok {\n66\t\t\t\treturn n\n67\t\t\t}\n68\t\t\tn := &node{str: s}\n69\t\t\tnodes[s] = n\n70\t\t\tnames = append(names, s)\n71\t\t\treturn n\n72\t\t}\n73\t\n74\t\tvar j, k *node\n75\t\tfor scanner.Scan() {\n76\t\t\tk = getOrCreate(scanner.Text())\n77\t\t\tif j != nil {\n78\t\t\t\tif j.str != k.str {\n79\t\t\t\t\tk.count++\n80\t\t\t\t\tj.top = &successor{suc: k, next: j.top}\n81\t\t\t\t}\n82\t\t\t\tk = nil\n83\t\t\t}\n84\t\t\tj = k\n85\t\t}\n86\t\n87\t\tif k != nil {\n88\t\t\tfmt.Fprintf(os.Stderr, \"tsort: %s: input contains an odd number of tokens\\n\", file)\n89\t\t\treturn 1\n90\t\t}\n91\t\n92\t\tsort.Strings(names)\n93\t\n94\t\tw := bufio.NewWriter(os.Stdout)\n95\t\n96\t\tnStrings := len(nodes)\n97\t\tok := true\n98\t\n99\t\tfor nStrings > 0 {\n100\t\t\tvar head, zeros *node\n101\t\t\tfor _, name := range names {\n102\t\t\t\tn := nodes[name]\n103\t\t\t\tif n.count == 0 && !n.printed {\n104\t\t\t\t\tif head == nil {\n105\t\t\t\t\t\thead = n\n106\t\t\t\t\t} else {\n107\t\t\t\t\t\tzeros.qlink = n\n108\t\t\t\t\t}\n109\t\t\t\t\tzeros = n\n110\t\t\t\t}\n111\t\t\t}\n112\t\n113\t\t\tfor head != nil {\n114\t\t\t\tfmt.Fprintln(w, head.str)\n115\t\t\t\thead.printed = true\n116\t\t\t\tnStrings--\n117\t\n118\t\t\t\tfor p := head.top; p != nil; p = p.next {\n119\t\t\t\t\tp.suc.count--\n120\t\t\t\t\tif p.suc.count == 0 {\n121\t\t\t\t\t\tzeros.qlink = p.suc\n122\t\t\t\t\t\tzeros = p.suc\n123\t\t\t\t\t}\n124\t\t\t\t}\n125\t\n126\t\t\t\thead = head.qlink\n127\t\t\t}\n128\t\n129\t\t\tif nStrings > 0 {\n130\t\t\t\tw.Flush()\n131\t\t\t\tfmt.Fprintf(os.Stderr, \"tsort: %s: input contains a loop:\\n\", file)\n132\t\t\t\tok = false\n133\t\t\t\tdetectLoop(nodes, names)\n134\t\t\t}\n135\t\t}\n136\t\n137\t\tw.Flush()\n138\t\n139\t\tif !ok {\n140\t\t\treturn 1\n141\t\t}\n142\t\treturn 0\n143\t}\n144\t\n145\tfunc detectLoop(nodes map[string]*node, names []string) {\n146\t\tvar loop *node\n147\t\n148\t\tfor {\n149\t\t\tfor _, name := range names {\n150\t\t\t\tk := nodes[name]\n151\t\t\t\tif k.count <= 0 || k.printed {\n152\t\t\t\t\tcontinue\n153\t\t\t\t}\n154\t\n155\t\t\t\tif loop == nil {\n156\t\t\t\t\tloop = k\n157\t\t\t\t\tcontinue\n158\t\t\t\t}\n159\t\n160\t\t\t\tpp := &k.top\n161\t\t\t\tfor *pp != nil {\n162\t\t\t\t\tif (*pp).suc == loop {\n163\t\t\t\t\t\tif k.qlink != nil {\n164\t\t\t\t\t\t\tfor loop != nil {\n165\t\t\t\t\t\t\t\ttmp := loop.qlink\n166\t\t\t\t\t\t\t\tfmt.Fprintf(os.Stderr, \"tsort: %s\\n\", loop.str)\n167\t\t\t\t\t\t\t\tif loop == k {\n168\t\t\t\t\t\t\t\t\tedge := *pp\n169\t\t\t\t\t\t\t\t\tedge.suc.count--\n170\t\t\t\t\t\t\t\t\t*pp = edge.next\n171\t\t\t\t\t\t\t\t\tbreak\n172\t\t\t\t\t\t\t\t}\n173\t\t\t\t\t\t\t\tloop.qlink = nil\n174\t\t\t\t\t\t\t\tloop = tmp\n175\t\t\t\t\t\t\t}\n176\t\t\t\t\t\t\tfor loop != nil {\n177\t\t\t\t\t\t\t\ttmp := loop.qlink\n178\t\t\t\t\t\t\t\tloop.qlink = nil\n179\t\t\t\t\t\t\t\tloop = tmp\n180\t\t\t\t\t\t\t}\n181\t\t\t\t\t\t\treturn\n182\t\t\t\t\t\t}\n183\t\t\t\t\t\tk.qlink = loop\n184\t\t\t\t\t\tloop = k\n185\t\t\t\t\t\tbreak\n186\t\t\t\t\t}\n187\t\t\t\t\tpp = &(*pp).next\n188\t\t\t\t}\n189\t\t\t}\n190\t\n191\t\t\tif loop == nil {\n192\t\t\t\treturn\n193\t\t\t}\n194\t\t}\n195\t}\n196\t\n197\tfunc unwrapPathErr(err error) string {\n198\t\tif pe, ok := err.(*os.PathError); ok {\n199\t\t\treturn pe.Err.Error()\n200\t\t}\n201\t\treturn err.Error()\n202\t}\n203\t"}]},"parent_tool_use_id":null,"session_id":"ada0722e-3827-40ee-a5e0-7817de3a2740","uuid":"303938c2-e099-446a-918e-8b08fe8bc511","timestamp":"2026-05-28T16:33:25.355Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5626/cmd/tsort/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"os\"\n\t\"sort\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype node struct {\n\tstr     string\n\tcount   int\n\tprinted bool\n\tqlink   *node\n\ttop     *successor\n}\n\ntype successor struct {\n\tsuc  *node\n\tnext *successor\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tos.Exit(run())\n}\n\nfunc run() int {\n\targs := os.Args[1:]\n\tif len(args) > 1 {\n\t\tfmt.Fprintf(os.Stderr, \"tsort: extra operand %s\\n\", args[1])\n\t\treturn 1\n\t}\n\n\tfile := \"-\"\n\tif len(args) == 1 {\n\t\tfile = args[0]\n\t}\n\n\tvar input *os.File\n\tif file == \"-\" {\n\t\tinput = os.Stdin\n\t} else {\n\t\tvar err error\n\t\tinput, err = os.Open(file)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"tsort: %s: %s\\n\", file, unwrapPathErr(err))\n\t\t\treturn 1\n\t\t}\n\t\tdefer input.Close()\n\t}\n\n\tscanner := bufio.NewScanner(input)\n\tscanner.Split(bufio.ScanWords)\n\n\tnodes := make(map[string]*node)\n\tvar names []string\n\n\tgetOrCreate := func(s string) *node {\n\t\tif n, ok := nodes[s]; ok {\n\t\t\treturn n\n\t\t}\n\t\tn := &node{str: s}\n\t\tnodes[s] = n\n\t\tnames = append(names, s)\n\t\treturn n\n\t}\n\n\tvar j, k *node\n\tfor scanner.Scan() {\n\t\tk = getOrCreate(scanner.Text())\n\t\tif j != nil {\n\t\t\tif j.str != k.str {\n\t\t\t\tk.count++\n\t\t\t\tj.top = &successor{suc: k, next: j.top}\n\t\t\t}\n\t\t\tk = nil\n\t\t}\n\t\tj = k\n\t}\n\n\tif k != nil {\n\t\tfmt.Fprintf(os.Stderr, \"tsort: %s: input contains an odd number of tokens\\n\", file)\n\t\treturn 1\n\t}\n\n\tsort.Strings(names)\n\n\tw := bufio.NewWriter(os.Stdout)\n\n\tnStrings := len(nodes)\n\tok := true\n\n\tfor nStrings > 0 {\n\t\tvar head, zeros *node\n\t\tfor _, name := range names {\n\t\t\tn := nodes[name]\n\t\t\tif n.count == 0 && !n.printed {\n\t\t\t\tif head == nil {\n\t\t\t\t\thead = n\n\t\t\t\t} else {\n\t\t\t\t\tzeros.qlink = n\n\t\t\t\t}\n\t\t\t\tzeros = n\n\t\t\t}\n\t\t}\n\n\t\tfor head != nil {\n\t\t\tfmt.Fprintln(w, head.str)\n\t\t\thead.printed = true\n\t\t\tnStrings--\n\n\t\t\tfor p := head.top; p != nil; p = p.next {\n\t\t\t\tp.suc.count--\n\t\t\t\tif p.suc.count == 0 {\n\t\t\t\t\tzeros.qlink = p.suc\n\t\t\t\t\tzeros = p.suc\n\t\t\t\t}\n\t\t\t}\n\n\t\t\thead = head.qlink\n\t\t}\n\n\t\tif nStrings > 0 {\n\t\t\tw.Flush()\n\t\t\tfmt.Fprintf(os.Stderr, \"tsort: %s: input contains a loop:\\n\", file)\n\t\t\tok = false\n\t\t\tdetectLoop(nodes, names)\n\t\t}\n\t}\n\n\tw.Flush()\n\n\tif !ok {\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc detectLoop(nodes map[string]*node, names []string) {\n\tvar loop *node\n\n\tfor {\n\t\tfor _, name := range names {\n\t\t\tk := nodes[name]\n\t\t\tif k.count <= 0 || k.printed {\n\t\t\t\tcontinue\n\t\t\t}\n\n\t\t\tif loop == nil {\n\t\t\t\tloop = k\n\t\t\t\tcontinue\n\t\t\t}\n\n\t\t\tpp := &k.top\n\t\t\tfor *pp != nil {\n\t\t\t\tif (*pp).suc == loop {\n\t\t\t\t\tif k.qlink != nil {\n\t\t\t\t\t\tfor loop != nil {\n\t\t\t\t\t\t\ttmp := loop.qlink\n\t\t\t\t\t\t\tfmt.Fprintf(os.Stderr, \"tsort: %s\\n\", loop.str)\n\t\t\t\t\t\t\tif loop == k {\n\t\t\t\t\t\t\t\tedge := *pp\n\t\t\t\t\t\t\t\tedge.suc.count--\n\t\t\t\t\t\t\t\t*pp = edge.next\n\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\tloop.qlink = nil\n\t\t\t\t\t\t\tloop = tmp\n\t\t\t\t\t\t}\n\t\t\t\t\t\tfor loop != nil {\n\t\t\t\t\t\t\ttmp := loop.qlink\n\t\t\t\t\t\t\tloop.qlink = nil\n\t\t\t\t\t\t\tloop = tmp\n\t\t\t\t\t\t}\n\t\t\t\t\t\treturn\n\t\t\t\t\t}\n\t\t\t\t\tk.qlink = loop\n\t\t\t\t\tloop = k\n\t\t\t\t\tbreak\n\t\t\t\t}\n\t\t\t\tpp = &(*pp).next\n\t\t\t}\n\t\t}\n\n\t\tif loop == nil {\n\t\t\treturn\n\t\t}\n\t}\n}\n\nfunc unwrapPathErr(err error) string {\n\tif pe, ok := err.(*os.PathError); ok {\n\t\treturn pe.Err.Error()\n\t}\n\treturn err.Error()\n}\n","numLines":203,"startLine":1,"totalLines":203}}}
