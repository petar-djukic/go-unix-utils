{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RzWTg9kMf8qEcg8Qmebec6","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\t\"syscall\"\n12\t\n13\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: truncate OPTION... FILE...\n18\tShrink or extend the size of each FILE to the specified size\n19\t\n20\tA FILE argument that does not exist is created.\n21\t\n22\tIf a FILE is larger than the specified size, the extra data is lost.\n23\tIf a FILE is shorter, it is extended and the sparse extended part (hole)\n24\treads as zero bytes.\n25\t\n26\tMandatory arguments to long options are mandatory for short options too.\n27\t  -c, --no-create        do not create any files\n28\t  -o, --io-blocks        treat SIZE as number of IO blocks instead of bytes\n29\t  -r, --reference=RFILE  base size on RFILE\n30\t  -s, --size=SIZE        set or adjust the file size by SIZE bytes\n31\t      --help     display this help and exit\n32\t      --version  output version information and exit\n33\t\n34\tThe SIZE argument is an integer and optional unit (example: 10K is 10*1024).\n35\tUnits are K,M,G,T,P,E,Z,Y,R,Q (powers of 1024) or KB,MB,... (powers of 1000).\n36\tBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\n37\t\n38\tSIZE may also be prefixed by one of the following modifying characters:\n39\t'+' extend by, '-' reduce by, '<' at most, '>' at least,\n40\t'/' round down to multiple of, '%' round up to multiple of.\n41\t`\n42\t\n43\tconst versionText = `truncate (go-unix-utils) dev\n44\t`\n45\t\n46\ttype options struct {\n47\t\tnoCreate  bool\n48\t\tioBlocks  bool\n49\t\treference string\n50\t\tsizeStr   string\n51\t\tsizeSet   bool\n52\t}\n53\t\n54\tfunc main() {\n55\t\tsys.InstallSIGPIPEHandler()\n56\t\topts, files, err := parseArgs(os.Args[1:])\n57\t\tif err != nil {\n58\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n59\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n60\t\t\tos.Exit(1)\n61\t\t}\n62\t\tif !opts.sizeSet && opts.reference == \"\" {\n63\t\t\tfmt.Fprintf(os.Stderr, \"truncate: you must specify either '--size' or '--reference'\\n\")\n64\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n65\t\t\tos.Exit(1)\n66\t\t}\n67\t\tif len(files) == 0 {\n68\t\t\tfmt.Fprintf(os.Stderr, \"truncate: missing file operand\\n\")\n69\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n70\t\t\tos.Exit(1)\n71\t\t}\n72\t\tos.Exit(run(opts, files))\n73\t}\n74\t\n75\tfunc run(opts options, files []string) int {\n76\t\tvar baseSize int64\n77\t\tif opts.reference != \"\" {\n78\t\t\tfi, err := os.Stat(opts.reference)\n79\t\t\tif err != nil {\n80\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: cannot stat %s: %s\\n\",\n81\t\t\t\t\tquote(opts.reference), errMsg(err))\n82\t\t\t\treturn 1\n83\t\t\t}\n84\t\t\tbaseSize = fi.Size()\n85\t\t}\n86\t\n87\t\tvar modifier byte\n88\t\tvar sizeVal int64\n89\t\tif opts.sizeSet {\n90\t\t\tvar err error\n91\t\t\tmodifier, sizeVal, err = parseSize(opts.sizeStr)\n92\t\t\tif err != nil {\n93\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n94\t\t\t\treturn 1\n95\t\t\t}\n96\t\t\tif opts.ioBlocks {\n97\t\t\t\tsizeVal *= ioBlockSize(files[0])\n98\t\t\t}\n99\t\t}\n100\t\n101\t\texitCode := 0\n102\t\tfor _, path := range files {\n103\t\t\tif err := truncateFile(opts, path, baseSize, modifier, sizeVal); err != nil {\n104\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n105\t\t\t\texitCode = 1\n106\t\t\t}\n107\t\t}\n108\t\treturn exitCode\n109\t}\n110\t\n111\tfunc truncateFile(opts options, path string, baseSize int64, modifier byte, sizeVal int64) error {\n112\t\tfi, err := os.Stat(path)\n113\t\tif err != nil && os.IsNotExist(err) {\n114\t\t\tif opts.noCreate {\n115\t\t\t\treturn nil\n116\t\t\t}\n117\t\t\tf, createErr := os.Create(path)\n118\t\t\tif createErr != nil {\n119\t\t\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n120\t\t\t\t\tquote(path), errMsg(createErr))\n121\t\t\t}\n122\t\t\tf.Close()\n123\t\t\tfi, err = os.Stat(path)\n124\t\t}\n125\t\tif err != nil {\n126\t\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n127\t\t\t\tquote(path), errMsg(err))\n128\t\t}\n129\t\n130\t\tvar newSize int64\n131\t\tif opts.reference != \"\" && !opts.sizeSet {\n132\t\t\tnewSize = baseSize\n133\t\t} else {\n134\t\t\tcurrentBase := baseSize\n135\t\t\tif opts.reference == \"\" {\n136\t\t\t\tcurrentBase = fi.Size()\n137\t\t\t}\n138\t\t\tnewSize, err = applySize(currentBase, modifier, sizeVal)\n139\t\t\tif err != nil {\n140\t\t\t\treturn err\n141\t\t\t}\n142\t\t}\n143\t\n144\t\tif newSize < 0 {\n145\t\t\tnewSize = 0\n146\t\t}\n147\t\tif err := os.Truncate(path, newSize); err != nil {\n148\t\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n149\t\t\t\tquote(path), errMsg(err))\n150\t\t}\n151\t\treturn nil\n152\t}\n153\t\n154\tfunc applySize(current int64, modifier byte, size int64) (int64, error) {\n155\t\tswitch modifier {\n156\t\tcase 0:\n157\t\t\treturn size, nil\n158\t\tcase '+':\n159\t\t\treturn current + size, nil\n160\t\tcase '-':\n161\t\t\treturn current - size, nil\n162\t\tcase '<':\n163\t\t\tif current < size {\n164\t\t\t\treturn current, nil\n165\t\t\t}\n166\t\t\treturn size, nil\n167\t\tcase '>':\n168\t\t\tif current > size {\n169\t\t\t\treturn current, nil\n170\t\t\t}\n171\t\t\treturn size, nil\n172\t\tcase '/':\n173\t\t\tif size == 0 {\n174\t\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n175\t\t\t}\n176\t\t\treturn (current / size) * size, nil\n177\t\tcase '%':\n178\t\t\tif size == 0 {\n179\t\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n180\t\t\t}\n181\t\t\treturn ((current + size - 1) / size) * size, nil\n182\t\t}\n183\t\treturn size, nil\n184\t}\n185\t\n186\tfunc parseSize(s string) (byte, int64, error) {\n187\t\tif s == \"\" {\n188\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n189\t\t}\n190\t\tvar modifier byte\n191\t\trest := s\n192\t\tif len(rest) > 0 {\n193\t\t\tswitch rest[0] {\n194\t\t\tcase '+', '-', '<', '>', '/', '%':\n195\t\t\t\tmodifier = rest[0]\n196\t\t\t\trest = rest[1:]\n197\t\t\t}\n198\t\t}\n199\t\tif rest == \"\" {\n200\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n201\t\t}\n202\t\tval, err := sizeparse.Parse(rest)\n203\t\tif err != nil {\n204\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n205\t\t}\n206\t\treturn modifier, val, nil\n207\t}\n208\t\n209\tfunc parseArgs(args []string) (options, []string, error) {\n210\t\tvar opts options\n211\t\tvar files []string\n212\t\tendFlags := false\n213\t\tfor i := 0; i < len(args); i++ {\n214\t\t\targ := args[i]\n215\t\t\tif endFlags || !strings.HasPrefix(arg, \"-\") {\n216\t\t\t\tfiles = append(files, arg)\n217\t\t\t\tcontinue\n218\t\t\t}\n219\t\t\tif arg == \"--\" {\n220\t\t\t\tendFlags = true\n221\t\t\t\tcontinue\n222\t\t\t}\n223\t\t\tif strings.HasPrefix(arg, \"--\") {\n224\t\t\t\tadv, err := parseLongFlag(arg, args[i+1:], &opts)\n225\t\t\t\tif err != nil {\n226\t\t\t\t\treturn options{}, nil, err\n227\t\t\t\t}\n228\t\t\t\ti += adv\n229\t\t\t\tcontinue\n230\t\t\t}\n231\t\t\tadv, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n232\t\t\tif err != nil {\n233\t\t\t\treturn options{}, nil, err\n234\t\t\t}\n235\t\t\ti += adv\n236\t\t}\n237\t\treturn opts, files, nil\n238\t}\n239\t\n240\tfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n241\t\tif strings.HasPrefix(flag, \"--size=\") {\n242\t\t\topts.sizeStr = flag[len(\"--size=\"):]\n243\t\t\topts.sizeSet = true\n244\t\t\treturn 0, nil\n245\t\t}\n246\t\tif strings.HasPrefix(flag, \"--reference=\") {\n247\t\t\topts.reference = flag[len(\"--reference=\"):]\n248\t\t\treturn 0, nil\n249\t\t}\n250\t\tswitch flag {\n251\t\tcase \"--size\":\n252\t\t\tif len(rest) == 0 {\n253\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n254\t\t\t}\n255\t\t\topts.sizeStr = rest[0]\n256\t\t\topts.sizeSet = true\n257\t\t\treturn 1, nil\n258\t\tcase \"--reference\":\n259\t\t\tif len(rest) == 0 {\n260\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n261\t\t\t}\n262\t\t\topts.reference = rest[0]\n263\t\t\treturn 1, nil\n264\t\tcase \"--no-create\":\n265\t\t\topts.noCreate = true\n266\t\tcase \"--io-blocks\":\n267\t\t\topts.ioBlocks = true\n268\t\tcase \"--help\":\n269\t\t\tfmt.Fprint(os.Stdout, helpText)\n270\t\t\tos.Exit(0)\n271\t\tcase \"--version\":\n272\t\t\tfmt.Fprint(os.Stdout, versionText)\n273\t\t\tos.Exit(0)\n274\t\tdefault:\n275\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n276\t\t}\n277\t\treturn 0, nil\n278\t}\n279\t\n280\tfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n281\t\tfor i, ch := range flags {\n282\t\t\tswitch ch {\n283\t\t\tcase 'c':\n284\t\t\t\topts.noCreate = true\n285\t\t\tcase 'o':\n286\t\t\t\topts.ioBlocks = true\n287\t\t\tcase 's':\n288\t\t\t\topts.sizeSet = true\n289\t\t\t\tremaining := flags[i+1:]\n290\t\t\t\tif remaining != \"\" {\n291\t\t\t\t\topts.sizeStr = remaining\n292\t\t\t\t\treturn 0, nil\n293\t\t\t\t}\n294\t\t\t\tif len(rest) == 0 {\n295\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n296\t\t\t\t}\n297\t\t\t\topts.sizeStr = rest[0]\n298\t\t\t\treturn 1, nil\n299\t\t\tcase 'r':\n300\t\t\t\tremaining := flags[i+1:]\n301\t\t\t\tif remaining != \"\" {\n302\t\t\t\t\topts.reference = remaining\n303\t\t\t\t\treturn 0, nil\n304\t\t\t\t}\n305\t\t\t\tif len(rest) == 0 {\n306\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'r'\")\n307\t\t\t\t}\n308\t\t\t\topts.reference = rest[0]\n309\t\t\t\treturn 1, nil\n310\t\t\tdefault:\n311\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", ch)\n312\t\t\t}\n313\t\t}\n314\t\treturn 0, nil\n315\t}\n316\t\n317\tfunc ioBlockSize(path string) int64 {\n318\t\tdir := filepath.Dir(path)\n319\t\tvar fs syscall.Statfs_t\n320\t\tif err := syscall.Statfs(dir, &fs); err != nil {\n321\t\t\treturn 512\n322\t\t}\n323\t\treturn int64(fs.Bsize)\n324\t}\n325\t\n326\tfunc quote(s string) string {\n327\t\treturn \"'\" + s + \"'\"\n328\t}\n329\t\n330\tfunc errMsg(err error) string {\n331\t\tmsg := err.Error()\n332\t\tfor _, prefix := range []string{\"stat \", \"open \", \"truncate \"} {\n333\t\t\tif strings.HasPrefix(msg, prefix) {\n334\t\t\t\tidx := strings.LastIndex(msg, \": \")\n335\t\t\t\tif idx >= 0 {\n336\t\t\t\t\treturn capitalizeFirst(msg[idx+2:])\n337\t\t\t\t}\n338\t\t\t}\n339\t\t}\n340\t\treturn capitalizeFirst(msg)\n341\t}\n342\t\n343\tfunc capitalizeFirst(s string) string {\n344\t\tif len(s) == 0 {\n345\t\t\treturn s\n346\t\t}\n347\t\treturn strings.ToUpper(s[:1]) + s[1:]\n348\t}\n349\t"}]},"parent_tool_use_id":null,"session_id":"a61810ff-70f4-4e3b-8473-0c1f0b2a6146","uuid":"eb5ce5e6-d0ff-439e-9a7f-a6e30ad620b0","timestamp":"2026-05-23T15:51:14.799Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5537/cmd/truncate/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: truncate OPTION... FILE...\nShrink or extend the size of each FILE to the specified size\n\nA FILE argument that does not exist is created.\n\nIf a FILE is larger than the specified size, the extra data is lost.\nIf a FILE is shorter, it is extended and the sparse extended part (hole)\nreads as zero bytes.\n\nMandatory arguments to long options are mandatory for short options too.\n  -c, --no-create        do not create any files\n  -o, --io-blocks        treat SIZE as number of IO blocks instead of bytes\n  -r, --reference=RFILE  base size on RFILE\n  -s, --size=SIZE        set or adjust the file size by SIZE bytes\n      --help     display this help and exit\n      --version  output version information and exit\n\nThe SIZE argument is an integer and optional unit (example: 10K is 10*1024).\nUnits are K,M,G,T,P,E,Z,Y,R,Q (powers of 1024) or KB,MB,... (powers of 1000).\nBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\n\nSIZE may also be prefixed by one of the following modifying characters:\n'+' extend by, '-' reduce by, '<' at most, '>' at least,\n'/' round down to multiple of, '%' round up to multiple of.\n`\n\nconst versionText = `truncate (go-unix-utils) dev\n`\n\ntype options struct {\n\tnoCreate  bool\n\tioBlocks  bool\n\treference string\n\tsizeStr   string\n\tsizeSet   bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\tif !opts.sizeSet && opts.reference == \"\" {\n\t\tfmt.Fprintf(os.Stderr, \"truncate: you must specify either '--size' or '--reference'\\n\")\n\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\tif len(files) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"truncate: missing file operand\\n\")\n\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n\t\tos.Exit(1)\n\t}\n\tos.Exit(run(opts, files))\n}\n\nfunc run(opts options, files []string) int {\n\tvar baseSize int64\n\tif opts.reference != \"\" {\n\t\tfi, err := os.Stat(opts.reference)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"truncate: cannot stat %s: %s\\n\",\n\t\t\t\tquote(opts.reference), errMsg(err))\n\t\t\treturn 1\n\t\t}\n\t\tbaseSize = fi.Size()\n\t}\n\n\tvar modifier byte\n\tvar sizeVal int64\n\tif opts.sizeSet {\n\t\tvar err error\n\t\tmodifier, sizeVal, err = parseSize(opts.sizeStr)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tif opts.ioBlocks {\n\t\t\tsizeVal *= ioBlockSize(files[0])\n\t\t}\n\t}\n\n\texitCode := 0\n\tfor _, path := range files {\n\t\tif err := truncateFile(opts, path, baseSize, modifier, sizeVal); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n\t\t\texitCode = 1\n\t\t}\n\t}\n\treturn exitCode\n}\n\nfunc truncateFile(opts options, path string, baseSize int64, modifier byte, sizeVal int64) error {\n\tfi, err := os.Stat(path)\n\tif err != nil && os.IsNotExist(err) {\n\t\tif opts.noCreate {\n\t\t\treturn nil\n\t\t}\n\t\tf, createErr := os.Create(path)\n\t\tif createErr != nil {\n\t\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n\t\t\t\tquote(path), errMsg(createErr))\n\t\t}\n\t\tf.Close()\n\t\tfi, err = os.Stat(path)\n\t}\n\tif err != nil {\n\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n\t\t\tquote(path), errMsg(err))\n\t}\n\n\tvar newSize int64\n\tif opts.reference != \"\" && !opts.sizeSet {\n\t\tnewSize = baseSize\n\t} else {\n\t\tcurrentBase := baseSize\n\t\tif opts.reference == \"\" {\n\t\t\tcurrentBase = fi.Size()\n\t\t}\n\t\tnewSize, err = applySize(currentBase, modifier, sizeVal)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\n\tif newSize < 0 {\n\t\tnewSize = 0\n\t}\n\tif err := os.Truncate(path, newSize); err != nil {\n\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n\t\t\tquote(path), errMsg(err))\n\t}\n\treturn nil\n}\n\nfunc applySize(current int64, modifier byte, size int64) (int64, error) {\n\tswitch modifier {\n\tcase 0:\n\t\treturn size, nil\n\tcase '+':\n\t\treturn current + size, nil\n\tcase '-':\n\t\treturn current - size, nil\n\tcase '<':\n\t\tif current < size {\n\t\t\treturn current, nil\n\t\t}\n\t\treturn size, nil\n\tcase '>':\n\t\tif current > size {\n\t\t\treturn current, nil\n\t\t}\n\t\treturn size, nil\n\tcase '/':\n\t\tif size == 0 {\n\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n\t\t}\n\t\treturn (current / size) * size, nil\n\tcase '%':\n\t\tif size == 0 {\n\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n\t\t}\n\t\treturn ((current + size - 1) / size) * size, nil\n\t}\n\treturn size, nil\n}\n\nfunc parseSize(s string) (byte, int64, error) {\n\tif s == \"\" {\n\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n\t}\n\tvar modifier byte\n\trest := s\n\tif len(rest) > 0 {\n\t\tswitch rest[0] {\n\t\tcase '+', '-', '<', '>', '/', '%':\n\t\t\tmodifier = rest[0]\n\t\t\trest = rest[1:]\n\t\t}\n\t}\n\tif rest == \"\" {\n\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n\t}\n\tval, err := sizeparse.Parse(rest)\n\tif err != nil {\n\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n\t}\n\treturn modifier, val, nil\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar files []string\n\tendFlags := false\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif endFlags || !strings.HasPrefix(arg, \"-\") {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tadv, err := parseLongFlag(arg, args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn options{}, nil, err\n\t\t\t}\n\t\t\ti += adv\n\t\t\tcontinue\n\t\t}\n\t\tadv, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\tif err != nil {\n\t\t\treturn options{}, nil, err\n\t\t}\n\t\ti += adv\n\t}\n\treturn opts, files, nil\n}\n\nfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n\tif strings.HasPrefix(flag, \"--size=\") {\n\t\topts.sizeStr = flag[len(\"--size=\"):]\n\t\topts.sizeSet = true\n\t\treturn 0, nil\n\t}\n\tif strings.HasPrefix(flag, \"--reference=\") {\n\t\topts.reference = flag[len(\"--reference=\"):]\n\t\treturn 0, nil\n\t}\n\tswitch flag {\n\tcase \"--size\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\topts.sizeStr = rest[0]\n\t\topts.sizeSet = true\n\t\treturn 1, nil\n\tcase \"--reference\":\n\t\tif len(rest) == 0 {\n\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t\t}\n\t\topts.reference = rest[0]\n\t\treturn 1, nil\n\tcase \"--no-create\":\n\t\topts.noCreate = true\n\tcase \"--io-blocks\":\n\t\topts.ioBlocks = true\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n\treturn 0, nil\n}\n\nfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n\tfor i, ch := range flags {\n\t\tswitch ch {\n\t\tcase 'c':\n\t\t\topts.noCreate = true\n\t\tcase 'o':\n\t\t\topts.ioBlocks = true\n\t\tcase 's':\n\t\t\topts.sizeSet = true\n\t\t\tremaining := flags[i+1:]\n\t\t\tif remaining != \"\" {\n\t\t\t\topts.sizeStr = remaining\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(rest) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n\t\t\t}\n\t\t\topts.sizeStr = rest[0]\n\t\t\treturn 1, nil\n\t\tcase 'r':\n\t\t\tremaining := flags[i+1:]\n\t\t\tif remaining != \"\" {\n\t\t\t\topts.reference = remaining\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(rest) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'r'\")\n\t\t\t}\n\t\t\topts.reference = rest[0]\n\t\t\treturn 1, nil\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", ch)\n\t\t}\n\t}\n\treturn 0, nil\n}\n\nfunc ioBlockSize(path string) int64 {\n\tdir := filepath.Dir(path)\n\tvar fs syscall.Statfs_t\n\tif err := syscall.Statfs(dir, &fs); err != nil {\n\t\treturn 512\n\t}\n\treturn int64(fs.Bsize)\n}\n\nfunc quote(s string) string {\n\treturn \"'\" + s + \"'\"\n}\n\nfunc errMsg(err error) string {\n\tmsg := err.Error()\n\tfor _, prefix := range []string{\"stat \", \"open \", \"truncate \"} {\n\t\tif strings.HasPrefix(msg, prefix) {\n\t\t\tidx := strings.LastIndex(msg, \": \")\n\t\t\tif idx >= 0 {\n\t\t\t\treturn capitalizeFirst(msg[idx+2:])\n\t\t\t}\n\t\t}\n\t}\n\treturn capitalizeFirst(msg)\n}\n\nfunc capitalizeFirst(s string) string {\n\tif len(s) == 0 {\n\t\treturn s\n\t}\n\treturn strings.ToUpper(s[:1]) + s[1:]\n}\n","numLines":349,"startLine":1,"totalLines":349}}}
