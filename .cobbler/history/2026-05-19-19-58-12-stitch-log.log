.Sprintf(\"%s  %s\\n%s  %s\\n\", helloHash, helloFile, fakeHash, emptyFile))\n57\t\n58\t\tmalformedChecksum := filepath.Join(tmpDir, \"malformed.sha512\")\n59\t\twriteFile(t, malformedChecksum, fmt.Sprintf(\"this is not a checksum\\n%s  %s\\n\", helloHash, helloFile))\n60\t\n61\t\tbsdChecksum := filepath.Join(tmpDir, \"bsd.sha512\")\n62\t\twriteFile(t, bsdChecksum, fmt.Sprintf(\"SHA512 (%s) = %s\\n\", helloFile, helloHash))\n63\t\n64\t\ttests := []testutils.DiffTest{\n65\t\t\t// R1.2: stdin with no arguments\n66\t\t\t{\n67\t\t\t\tName:  \"stdin-no-args\",\n68\t\t\t\tStdin: []byte(\"abc\"),\n69\t\t\t},\n70\t\t\t// R1.2: stdin with explicit \"-\"\n71\t\t\t{\n72\t\t\t\tName:  \"stdin-dash\",\n73\t\t\t\tArgs:  []string{\"-\"},\n74\t\t\t\tStdin: []byte(\"abc\"),\n75\t\t\t},\n76\t\t\t// R1.1: single file, text mode (default)\n77\t\t\t{\n78\t\t\t\tName: \"single-file-text\",\n79\t\t\t\tArgs: []string{helloFile},\n80\t\t\t},\n81\t\t\t// R1.1: single file, binary mode\n82\t\t\t{\n83\t\t\t\tName: \"single-file-binary\",\n84\t\t\t\tArgs: []string{\"-b\", helloFile},\n85\t\t\t},\n86\t\t\t// R1.3: BSD tag format\n87\t\t\t{\n88\t\t\t\tName: \"tag-format\",\n89\t\t\t\tArgs: []string{\"--tag\", helloFile},\n90\t\t\t},\n91\t\t\t// R1.3: tag with binary flag\n92\t\t\t{\n93\t\t\t\tName: \"tag-with-binary\",\n94\t\t\t\tArgs: []string{\"--tag\", \"-b\", helloFile},\n95\t\t\t},\n96\t\t\t// R1.1: multiple files\n97\t\t\t{\n98\t\t\t\tName: \"multiple-files\",\n99\t\t\t\tArgs: []string{helloFile, emptyFile},\n100\t\t\t},\n101\t\t\t// R1.2: empty stdin\n102\t\t\t{\n103\t\t\t\tName:  \"empty-stdin\",\n104\t\t\t\tStdin: []byte{},\n105\t\t\t},\n106\t\t\t// R1.1: empty file\n107\t\t\t{\n108\t\t\t\tName: \"empty-file\",\n109\t\t\t\tArgs: []string{emptyFile},\n110\t\t\t},\n111\t\t\t// R1.4: missing file exits 1, prints error to stderr\n112\t\t\t{\n113\t\t\t\tName:      \"missing-file\",\n114\t\t\t\tArgs:      []string{filepath.Join(tmpDir, \"nonexistent.txt\")},\n115\t\t\t\tExitCode:  1,\n116\t\t\