m},\n167\t\t\t\tExitCode:  0,\n168\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n169\t\t\t},\n170\t\t\t// R2.3: --check --warn with malformed lines\n171\t\t\t{\n172\t\t\t\tName:      \"check-warn-malformed\",\n173\t\t\t\tArgs:      []string{\"--check\", \"--warn\", malformedChecksum},\n174\t\t\t\tExitCode:  0,\n175\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n176\t\t\t},\n177\t\t\t// R2.3: --check --quiet suppresses OK lines\n178\t\t\t{\n179\t\t\t\tName:      \"check-quiet-all-ok\",\n180\t\t\t\tArgs:      []string{\"--check\", \"--quiet\", multiChecksum},\n181\t\t\t\tExitCode:  0,\n182\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n183\t\t\t},\n184\t\t\t// R2.3: --check --quiet shows only failures\n185\t\t\t{\n186\t\t\t\tName:      \"check-quiet-with-fail\",\n187\t\t\t\tArgs:      []string{\"--check\", \"--quiet\", mixedChecksum},\n188\t\t\t\tExitCode:  1,\n189\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n190\t\t\t},\n191\t\t\t// R2.3: --check --status suppresses all output, exit 0\n192\t\t\t{\n193\t\t\t\tName:      \"check-status-ok\",\n194\t\t\t\tArgs:      []string{\"--check\", \"--status\", validChecksum},\n195\t\t\t\tExitCode:  0,\n196\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n197\t\t\t},\n198\t\t\t// R2.3: --check --status suppresses all output, exit 1 on failure\n199\t\t\t{\n200\t\t\t\tName:      \"check-status-fail\",\n201\t\t\t\tArgs:      []string{\"--check\", \"--status\", mismatchChecksum},\n202\t\t\t\tExitCode:  1,\n203\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n204\t\t\t},\n205\t\t\t// R2.1: --check with short flag -c\n206\t\t\t{\n207\t\t\t\tName:      \"check-short-flag\",\n208\t\t\t\tArgs:      []string{\"-c\", validChecksum},\n209\t\t\t\tExitCode:  0,\n210\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n211\t\t\t},\n212\t\t\t// R3.1: binary mode with multiple files\n213\t\t\t{\n214\t\t\t\tName: \"binary-multiple-files\",\n215\t\t\t\tArgs: [