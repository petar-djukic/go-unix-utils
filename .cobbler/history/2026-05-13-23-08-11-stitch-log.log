{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MoHdMWGSUHTBR2mBy1W8eP","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/sponge implements srd007-sponge: soak all of stdin before writing\n5\t// to a named output file, preventing read-write conflicts in pipelines.\n6\tpackage main\n7\t\n8\timport (\n9\t\t\"flag\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"os/signal\"\n14\t\t\"path/filepath\"\n15\t\t\"runtime\"\n16\t\t\"sync\"\n17\t\t\"syscall\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n20\t)\n21\t\n22\tvar appendMode = flag.Bool(\"a\", false, \"append to output file\")\n23\t\n24\tvar (\n25\t\ttempFileMu   sync.Mutex\n26\t\ttempFilePath string\n27\t)\n28\t\n29\tfunc main() {\n30\t\tsys.InstallSIGPIPEHandler()\n31\t\tflag.Parse()\n32\t\tos.Exit(run())\n33\t}\n34\t\n35\tfunc run() int {\n36\t\tinstallCleanupHandler()\n37\t\tdefer cleanupCurrentTempFile()\n38\t\n39\t\tdata, tmpFile, err := readAllStdin()\n40\t\tif err != nil {\n41\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n42\t\t\treturn 1\n43\t\t}\n44\t\tif tmpFile != \"\" {\n45\t\t\tsetTempFile(tmpFile)\n46\t\t}\n47\t\n48\t\targs := flag.Args()\n49\t\tif len(args) == 0 {\n50\t\t\treturn runPassthrough(data, tmpFile)\n51\t\t}\n52\t\treturn runOutput(args[0], data, tmpFile)\n53\t}\n54\t\n55\tfunc runPassthrough(data []byte, tmpFile string) int {\n56\t\tif err := writeToStdout(data, tmpFile); err != nil {\n57\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n58\t\t\treturn 1\n59\t\t}\n60\t\treturn 0\n61\t}\n62\t\n63\tfunc runOutput(filename string, data []byte, tmpFile string) int {\n64\t\tmode, exists, isRegular, err := outputFileInfo(filename)\n65\t\tif err != nil {\n66\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n67\t\t\treturn 1\n68\t\t}\n69\t\n70\t\t// R3.1, R3.2: append only when file exists and is a regular file\n71\t\tif *appendMode && exists && isRegular {\n72\t\t\tdata, tmpFile, err = prependOriginal(filename, data, tmpFile)\n73\t\t\tif err != nil {\n74\t\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n75\t\t\t\treturn 1\n76\t\t\t}\n77\t\t\tif tmpFile != \"\" {\n78\t\t\t\tsetTempFile(tmpFile)\n79\t\t\t}\n80\t\t}\n81\t\n82\t\tif err := writeOutputFile(filename, data, tmpFile, mode, exists, isRegular); err != nil {\n83\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n84\t\t\treturn 1\n85\t\t}\n86\t\tclearTempFile()\n87\t\treturn 0\n88\t}\n89\t\n90\tfunc readAllStdin() ([]byte, string, error) {\n91\t\tdata, err := io.ReadAll(os.Stdin)\n92\t\tif err != nil {\n93\t\t\treturn nil, \"\", fmt.Errorf(\"read stdin: %w\", err)\n94\t\t}\n95\t\tthreshold := spillThreshold()\n96\t\tif uint64(len(data)) > threshold {\n97\t\t\ttmpPath, err := spillToTempFile(data)\n98\t\t\tif err != nil {\n99\t\t\t\treturn nil, \"\", err\n100\t\t\t}\n101\t\t\treturn nil, tmpPath, nil\n102\t\t}\n103\t\treturn data, \"\", nil\n104\t}\n105\t\n106\tfunc spillThreshold() uint64 {\n107\t\tvar m runtime.MemStats\n108\t\truntime.ReadMemStats(&m)\n109\t\tavail := m.Sys - m.HeapInuse\n110\t\tif avail == 0 {\n111\t\t\treturn 256 * 1024 * 1024\n112\t\t}\n113\t\tquarter := avail / 4\n114\t\tconst maxThreshold = 1024 * 1024 * 1024\n115\t\tif quarter > maxThreshold {\n116\t\t\treturn maxThreshold\n117\t\t}\n118\t\treturn quarter\n119\t}\n120\t\n121\tfunc spillToTempFile(data []byte) (string, error) {\n122\t\tf, err := os.CreateTemp(tempDir(), \"sponge.\")\n123\t\tif err != nil {\n124\t\t\treturn \"\", fmt.Errorf(\"create temp file: %w\", err)\n125\t\t}\n126\t\tpath := f.Name()\n127\t\tif _, err := f.Write(data); err != nil {\n128\t\t\tf.Close()\n129\t\t\tos.Remove(path)\n130\t\t\treturn \"\", fmt.Errorf(\"write temp file: %w\", err)\n131\t\t}\n132\t\tif err := f.Close(); err != nil {\n133\t\t\tos.Remove(path)\n134\t\t\treturn \"\", fmt.Errorf(\"close temp file: %w\", err)\n135\t\t}\n136\t\treturn path, nil\n137\t}\n138\t\n139\tfunc tempDir() string {\n140\t\tif d := os.Getenv(\"TMPDIR\"); d != \"\" {\n141\t\t\treturn d\n142\t\t}\n143\t\treturn \"/tmp\"\n144\t}\n145\t\n146\tfunc setTempFile(path string) {\n147\t\ttempFileMu.Lock()\n148\t\ttempFilePath = path\n149\t\ttempFileMu.Unlock()\n150\t}\n151\t\n152\tfunc clearTempFile() {\n153\t\ttempFileMu.Lock()\n154\t\ttempFilePath = \"\"\n155\t\ttempFileMu.Unlock()\n156\t}\n157\t\n158\tfunc cleanupCurrentTempFile() {\n159\t\ttempFileMu.Lock()\n160\t\tp := tempFilePath\n161\t\ttempFilePath = \"\"\n162\t\ttempFileMu.Unlock()\n163\t\tif p != \"\" {\n164\t\t\tos.Remove(p)\n165\t\t}\n166\t}\n167\t\n168\tfunc installCleanupHandler() {\n169\t\tsigCh := make(chan os.Signal, 1)\n170\t\tsignal.Notify(sigCh, syscall.SIGINT, syscall.SIGTERM, syscall.SIGHUP, syscall.SIGPIPE)\n171\t\tgo func() {\n172\t\t\t<-sigCh\n173\t\t\ttempFileMu.Lock()\n174\t\t\tp := tempFilePath\n175\t\t\ttempFileMu.Unlock()\n176\t\t\tif p != \"\" {\n177\t\t\t\tos.Remove(p)\n178\t\t\t}\n179\t\t\tos.Exit(1)\n180\t\t}()\n181\t}\n182\t\n183\t// R2.4: use lstat to determine file existence, mode, and whether it is regular\n184\tfunc outputFileInfo(filename string) (os.FileMode, bool, bool, error) {\n185\t\tfi, err := sys.Lstat(filename)\n186\t\tif err != nil {\n187\t\t\tif os.IsNotExist(err) {\n188\t\t\t\treturn 0666, false, false, nil\n189\t\t\t}\n190\t\t\treturn 0, false, false, fmt.Errorf(\"lstat %s: %w\", filename, err)\n191\t\t}\n192\t\treturn fi.Mode.Perm(), true, fi.Mode.IsRegular(), nil\n193\t}\n194\t\n195\t// R3.1: prepend original file content before stdin content\n196\tfunc prependOriginal(filename string, data []byte, tmpFile string) ([]byte, string, error) {\n197\t\toriginal, err := os.ReadFile(filename)\n198\t\tif err != nil {\n199\t\t\treturn nil, \"\", fmt.Errorf(\"read %s: %w\", filename, err)\n200\t\t}\n201\t\tif len(original) == 0 {\n202\t\t\treturn data, tmpFile, nil\n203\t\t}\n204\t\tif tmpFile != \"\" {\n205\t\t\tcombined, err := combineTempFiles(original, tmpFile)\n206\t\t\tif err != nil {\n207\t\t\t\treturn nil, \"\", err\n208\t\t\t}\n209\t\t\treturn nil, combined, nil\n210\t\t}\n211\t\tcombined := make([]byte, len(original)+len(data))\n212\t\tcopy(combined, original)\n213\t\tcopy(combined[len(original):], data)\n214\t\treturn combined, \"\", nil\n215\t}\n216\t\n217\tfunc combineTempFiles(original []byte, stdinTmpFile string) (string, error) {\n218\t\tf, err := os.CreateTemp(tempDir(), \"sponge.\")\n219\t\tif err != nil {\n220\t\t\treturn \"\", fmt.Errorf(\"create temp file: %w\", err)\n221\t\t}\n222\t\tpath := f.Name()\n223\t\n224\t\tif _, err := f.Write(original); err != nil {\n225\t\t\tf.Close()\n226\t\t\tos.Remove(path)\n227\t\t\treturn \"\", fmt.Errorf(\"write original to temp: %w\", err)\n228\t\t}\n229\t\tif err := appendFromFile(f, stdinTmpFile); err != nil {\n230\t\t\tf.Close()\n231\t\t\tos.Remove(path)\n232\t\t\treturn \"\", err\n233\t\t}\n234\t\tif err := f.Close(); err != nil {\n235\t\t\tos.Remove(path)\n236\t\t\treturn \"\", fmt.Errorf(\"close temp file: %w\", err)\n237\t\t}\n238\t\n239\t\tsetTempFile(path)\n240\t\tos.Remove(stdinTmpFile)\n241\t\treturn path, nil\n242\t}\n243\t\n244\tfunc appendFromFile(dst *os.File, srcPath string) error {\n245\t\tsrc, err := os.Open(srcPath)\n246\t\tif err != nil {\n247\t\t\treturn fmt.Errorf(\"open %s: %w\", srcPath, err)\n248\t\t}\n249\t\tdefer src.Close()\n250\t\tif _, err := io.Copy(dst, src); err != nil {\n251\t\t\treturn fmt.Errorf(\"copy from %s: %w\", srcPath, err)\n252\t\t}\n253\t\treturn nil\n254\t}\n255\t\n256\tfunc writeOutputFile(filename string, data []byte, tmpFile string, mode os.FileMode, exists bool, isRegular bool) error {\n257\t\ttmpPath := tmpFile\n258\t\tvar err error\n259\t\tif tmpPath == \"\" {\n260\t\t\ttmpPath, err = spillToTempFile(data)\n261\t\t\tif err != nil {\n262\t\t\t\treturn err\n263\t\t\t}\n264\t\t\tsetTempFile(tmpPath)\n265\t\t}\n266\t\n267\t\t// R2.4: only attempt atomic rename for regular files or new files\n268\t\tif !exists || isRegular {\n269\t\t\treturn attemptAtomicWrite(tmpPath, filename, mode, exists)\n270\t\t}\n271\t\treturn directWrite(tmpPath, filename, mode)\n272\t}\n273\t\n274\tfunc attemptAtomicWrite(tmpPath, filename string, mode os.FileMode, exists bool) error {\n275\t\tif err := os.Rename(tmpPath, filename); err != nil {\n276\t\t\treturn atomicFallbackCopy(tmpPath, filename, mode)\n277\t\t}\n278\t\tif exists {\n279\t\t\tif err := os.Chmod(filename, mode); err != nil {\n280\t\t\t\treturn fmt.Errorf(\"chmod %s: %w\", filename, err)\n281\t\t\t}\n282\t\t}\n283\t\treturn nil\n284\t}\n285\t\n286\t// R2.5: ensure output is never in a partially-written state\n287\tfunc atomicFallbackCopy(tmpPath, filename string, mode os.FileMode) error {\n288\t\tdir := filepath.Dir(filename)\n289\t\ttmpDst, err := os.CreateTemp(dir, \".sponge-\")\n290\t\tif err != nil {\n291\t\t\treturn directWrite(tmpPath, filename, mode)\n292\t\t}\n293\t\ttmpDstPath := tmpDst.Name()\n294\t\n295\t\tif err := copyFileToWriter(tmpPath, tmpDst, mode); err != nil {\n296\t\t\tos.Remove(tmpDstPath)\n297\t\t\treturn err\n298\t\t}\n299\t\tif err := os.Rename(tmpDstPath, filename); err != nil {\n300\t\t\tos.Remove(tmpDstPath)\n301\t\t\treturn directWrite(tmpPath, filename, mode)\n302\t\t}\n303\t\tos.Remove(tmpPath)\n304\t\treturn nil\n305\t}\n306\t\n307\tfunc copyFileToWriter(srcPath string, dst *os.File, mode os.FileMode) error {\n308\t\tsrc, err := os.Open(srcPath)\n309\t\tif err != nil {\n310\t\t\tdst.Close()\n311\t\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n312\t\t}\n313\t\tdefer src.Close()\n314\t\n315\t\tif _, err := io.Copy(dst, src); err != nil {\n316\t\t\tdst.Close()\n317\t\t\treturn fmt.Errorf(\"copy: %w\", err)\n318\t\t}\n319\t\tif err := dst.Chmod(mode); err != nil {\n320\t\t\tdst.Close()\n321\t\t\treturn fmt.Errorf(\"chmod: %w\", err)\n322\t\t}\n323\t\treturn dst.Close()\n324\t}\n325\t\n326\tfunc directWrite(tmpPath, filename string, mode os.FileMode) error {\n327\t\tsrc, err := os.Open(tmpPath)\n328\t\tif err != nil {\n329\t\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n330\t\t}\n331\t\tdefer src.Close()\n332\t\n333\t\tdst, err := os.OpenFile(filename, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n334\t\tif err != nil {\n335\t\t\treturn fmt.Errorf(\"open %s: %w\", filename, err)\n336\t\t}\n337\t\n338\t\tif _, err := io.Copy(dst, src); err != nil {\n339\t\t\tdst.Close()\n340\t\t\treturn fmt.Errorf(\"copy to %s: %w\", filename, err)\n341\t\t}\n342\t\tif err := dst.Close(); err != nil {\n343\t\t\treturn fmt.Errorf(\"close %s: %w\", filename, err)\n344\t\t}\n345\t\tos.Remove(tmpPath)\n346\t\treturn nil\n347\t}\n348\t\n349\tfunc writeToStdout(data []byte, tmpFile string) error {\n350\t\tif tmpFile != \"\" {\n351\t\t\treturn copyTempFileToStdout(tmpFile)\n352\t\t}\n353\t\tif _, err := os.Stdout.Write(data); err != nil {\n354\t\t\treturn fmt.Errorf(\"write stdout: %w\", err)\n355\t\t}\n356\t\treturn nil\n357\t}\n358\t\n359\tfunc copyTempFileToStdout(tmpFile string) error {\n360\t\tf, err := os.Open(tmpFile)\n361\t\tif err != nil {\n362\t\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n363\t\t}\n364\t\tdefer f.Close()\n365\t\tif _, err := f.Seek(0, io.SeekStart); err != nil {\n366\t\t\treturn fmt.Errorf(\"seek temp file: %w\", err)\n367\t\t}\n368\t\tif _, err := io.Copy(os.Stdout, f); err != nil {\n369\t\t\treturn fmt.Errorf(\"write stdout: %w\", err)\n370\t\t}\n371\t\treturn nil\n372\t}\n373\t"}]},"parent_tool_use_id":null,"session_id":"15bf8951-d47b-478d-b534-8844b96c176a","uuid":"9767d5b2-16e4-4b27-b5ee-dc4fbada6083","timestamp":"2026-05-14T03:08:21.896Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5133/cmd/sponge/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/sponge implements srd007-sponge: soak all of stdin before writing\n// to a named output file, preventing read-write conflicts in pipelines.\npackage main\n\nimport (\n\t\"flag\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"os/signal\"\n\t\"path/filepath\"\n\t\"runtime\"\n\t\"sync\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nvar appendMode = flag.Bool(\"a\", false, \"append to output file\")\n\nvar (\n\ttempFileMu   sync.Mutex\n\ttempFilePath string\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\tflag.Parse()\n\tos.Exit(run())\n}\n\nfunc run() int {\n\tinstallCleanupHandler()\n\tdefer cleanupCurrentTempFile()\n\n\tdata, tmpFile, err := readAllStdin()\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n\t\treturn 1\n\t}\n\tif tmpFile != \"\" {\n\t\tsetTempFile(tmpFile)\n\t}\n\n\targs := flag.Args()\n\tif len(args) == 0 {\n\t\treturn runPassthrough(data, tmpFile)\n\t}\n\treturn runOutput(args[0], data, tmpFile)\n}\n\nfunc runPassthrough(data []byte, tmpFile string) int {\n\tif err := writeToStdout(data, tmpFile); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc runOutput(filename string, data []byte, tmpFile string) int {\n\tmode, exists, isRegular, err := outputFileInfo(filename)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n\t\treturn 1\n\t}\n\n\t// R3.1, R3.2: append only when file exists and is a regular file\n\tif *appendMode && exists && isRegular {\n\t\tdata, tmpFile, err = prependOriginal(filename, data, tmpFile)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n\t\t\treturn 1\n\t\t}\n\t\tif tmpFile != \"\" {\n\t\t\tsetTempFile(tmpFile)\n\t\t}\n\t}\n\n\tif err := writeOutputFile(filename, data, tmpFile, mode, exists, isRegular); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sponge: %v\\n\", err)\n\t\treturn 1\n\t}\n\tclearTempFile()\n\treturn 0\n}\n\nfunc readAllStdin() ([]byte, string, error) {\n\tdata, err := io.ReadAll(os.Stdin)\n\tif err != nil {\n\t\treturn nil, \"\", fmt.Errorf(\"read stdin: %w\", err)\n\t}\n\tthreshold := spillThreshold()\n\tif uint64(len(data)) > threshold {\n\t\ttmpPath, err := spillToTempFile(data)\n\t\tif err != nil {\n\t\t\treturn nil, \"\", err\n\t\t}\n\t\treturn nil, tmpPath, nil\n\t}\n\treturn data, \"\", nil\n}\n\nfunc spillThreshold() uint64 {\n\tvar m runtime.MemStats\n\truntime.ReadMemStats(&m)\n\tavail := m.Sys - m.HeapInuse\n\tif avail == 0 {\n\t\treturn 256 * 1024 * 1024\n\t}\n\tquarter := avail / 4\n\tconst maxThreshold = 1024 * 1024 * 1024\n\tif quarter > maxThreshold {\n\t\treturn maxThreshold\n\t}\n\treturn quarter\n}\n\nfunc spillToTempFile(data []byte) (string, error) {\n\tf, err := os.CreateTemp(tempDir(), \"sponge.\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"create temp file: %w\", err)\n\t}\n\tpath := f.Name()\n\tif _, err := f.Write(data); err != nil {\n\t\tf.Close()\n\t\tos.Remove(path)\n\t\treturn \"\", fmt.Errorf(\"write temp file: %w\", err)\n\t}\n\tif err := f.Close(); err != nil {\n\t\tos.Remove(path)\n\t\treturn \"\", fmt.Errorf(\"close temp file: %w\", err)\n\t}\n\treturn path, nil\n}\n\nfunc tempDir() string {\n\tif d := os.Getenv(\"TMPDIR\"); d != \"\" {\n\t\treturn d\n\t}\n\treturn \"/tmp\"\n}\n\nfunc setTempFile(path string) {\n\ttempFileMu.Lock()\n\ttempFilePath = path\n\ttempFileMu.Unlock()\n}\n\nfunc clearTempFile() {\n\ttempFileMu.Lock()\n\ttempFilePath = \"\"\n\ttempFileMu.Unlock()\n}\n\nfunc cleanupCurrentTempFile() {\n\ttempFileMu.Lock()\n\tp := tempFilePath\n\ttempFilePath = \"\"\n\ttempFileMu.Unlock()\n\tif p != \"\" {\n\t\tos.Remove(p)\n\t}\n}\n\nfunc installCleanupHandler() {\n\tsigCh := make(chan os.Signal, 1)\n\tsignal.Notify(sigCh, syscall.SIGINT, syscall.SIGTERM, syscall.SIGHUP, syscall.SIGPIPE)\n\tgo func() {\n\t\t<-sigCh\n\t\ttempFileMu.Lock()\n\t\tp := tempFilePath\n\t\ttempFileMu.Unlock()\n\t\tif p != \"\" {\n\t\t\tos.Remove(p)\n\t\t}\n\t\tos.Exit(1)\n\t}()\n}\n\n// R2.4: use lstat to determine file existence, mode, and whether it is regular\nfunc outputFileInfo(filename string) (os.FileMode, bool, bool, error) {\n\tfi, err := sys.Lstat(filename)\n\tif err != nil {\n\t\tif os.IsNotExist(err) {\n\t\t\treturn 0666, false, false, nil\n\t\t}\n\t\treturn 0, false, false, fmt.Errorf(\"lstat %s: %w\", filename, err)\n\t}\n\treturn fi.Mode.Perm(), true, fi.Mode.IsRegular(), nil\n}\n\n// R3.1: prepend original file content before stdin content\nfunc prependOriginal(filename string, data []byte, tmpFile string) ([]byte, string, error) {\n\toriginal, err := os.ReadFile(filename)\n\tif err != nil {\n\t\treturn nil, \"\", fmt.Errorf(\"read %s: %w\", filename, err)\n\t}\n\tif len(original) == 0 {\n\t\treturn data, tmpFile, nil\n\t}\n\tif tmpFile != \"\" {\n\t\tcombined, err := combineTempFiles(original, tmpFile)\n\t\tif err != nil {\n\t\t\treturn nil, \"\", err\n\t\t}\n\t\treturn nil, combined, nil\n\t}\n\tcombined := make([]byte, len(original)+len(data))\n\tcopy(combined, original)\n\tcopy(combined[len(original):], data)\n\treturn combined, \"\", nil\n}\n\nfunc combineTempFiles(original []byte, stdinTmpFile string) (string, error) {\n\tf, err := os.CreateTemp(tempDir(), \"sponge.\")\n\tif err != nil {\n\t\treturn \"\", fmt.Errorf(\"create temp file: %w\", err)\n\t}\n\tpath := f.Name()\n\n\tif _, err := f.Write(original); err != nil {\n\t\tf.Close()\n\t\tos.Remove(path)\n\t\treturn \"\", fmt.Errorf(\"write original to temp: %w\", err)\n\t}\n\tif err := appendFromFile(f, stdinTmpFile); err != nil {\n\t\tf.Close()\n\t\tos.Remove(path)\n\t\treturn \"\", err\n\t}\n\tif err := f.Close(); err != nil {\n\t\tos.Remove(path)\n\t\treturn \"\", fmt.Errorf(\"close temp file: %w\", err)\n\t}\n\n\tsetTempFile(path)\n\tos.Remove(stdinTmpFile)\n\treturn path, nil\n}\n\nfunc appendFromFile(dst *os.File, srcPath string) error {\n\tsrc, err := os.Open(srcPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"open %s: %w\", srcPath, err)\n\t}\n\tdefer src.Close()\n\tif _, err := io.Copy(dst, src); err != nil {\n\t\treturn fmt.Errorf(\"copy from %s: %w\", srcPath, err)\n\t}\n\treturn nil\n}\n\nfunc writeOutputFile(filename string, data []byte, tmpFile string, mode os.FileMode, exists bool, isRegular bool) error {\n\ttmpPath := tmpFile\n\tvar err error\n\tif tmpPath == \"\" {\n\t\ttmpPath, err = spillToTempFile(data)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tsetTempFile(tmpPath)\n\t}\n\n\t// R2.4: only attempt atomic rename for regular files or new files\n\tif !exists || isRegular {\n\t\treturn attemptAtomicWrite(tmpPath, filename, mode, exists)\n\t}\n\treturn directWrite(tmpPath, filename, mode)\n}\n\nfunc attemptAtomicWrite(tmpPath, filename string, mode os.FileMode, exists bool) error {\n\tif err := os.Rename(tmpPath, filename); err != nil {\n\t\treturn atomicFallbackCopy(tmpPath, filename, mode)\n\t}\n\tif exists {\n\t\tif err := os.Chmod(filename, mode); err != nil {\n\t\t\treturn fmt.Errorf(\"chmod %s: %w\", filename, err)\n\t\t}\n\t}\n\treturn nil\n}\n\n// R2.5: ensure output is never in a partially-written state\nfunc atomicFallbackCopy(tmpPath, filename string, mode os.FileMode) error {\n\tdir := filepath.Dir(filename)\n\ttmpDst, err := os.CreateTemp(dir, \".sponge-\")\n\tif err != nil {\n\t\treturn directWrite(tmpPath, filename, mode)\n\t}\n\ttmpDstPath := tmpDst.Name()\n\n\tif err := copyFileToWriter(tmpPath, tmpDst, mode); err != nil {\n\t\tos.Remove(tmpDstPath)\n\t\treturn err\n\t}\n\tif err := os.Rename(tmpDstPath, filename); err != nil {\n\t\tos.Remove(tmpDstPath)\n\t\treturn directWrite(tmpPath, filename, mode)\n\t}\n\tos.Remove(tmpPath)\n\treturn nil\n}\n\nfunc copyFileToWriter(srcPath string, dst *os.File, mode os.FileMode) error {\n\tsrc, err := os.Open(srcPath)\n\tif err != nil {\n\t\tdst.Close()\n\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n\t}\n\tdefer src.Close()\n\n\tif _, err := io.Copy(dst, src); err != nil {\n\t\tdst.Close()\n\t\treturn fmt.Errorf(\"copy: %w\", err)\n\t}\n\tif err := dst.Chmod(mode); err != nil {\n\t\tdst.Close()\n\t\treturn fmt.Errorf(\"chmod: %w\", err)\n\t}\n\treturn dst.Close()\n}\n\nfunc directWrite(tmpPath, filename string, mode os.FileMode) error {\n\tsrc, err := os.Open(tmpPath)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n\t}\n\tdefer src.Close()\n\n\tdst, err := os.OpenFile(filename, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"open %s: %w\", filename, err)\n\t}\n\n\tif _, err := io.Copy(dst, src); err != nil {\n\t\tdst.Close()\n\t\treturn fmt.Errorf(\"copy to %s: %w\", filename, err)\n\t}\n\tif err := dst.Close(); err != nil {\n\t\treturn fmt.Errorf(\"close %s: %w\", filename, err)\n\t}\n\tos.Remove(tmpPath)\n\treturn nil\n}\n\nfunc writeToStdout(data []byte, tmpFile string) error {\n\tif tmpFile != \"\" {\n\t\treturn copyTempFileToStdout(tmpFile)\n\t}\n\tif _, err := os.Stdout.Write(data); err != nil {\n\t\treturn fmt.Errorf(\"write stdout: %w\", err)\n\t}\n\treturn nil\n}\n\nfunc copyTempFileToStdout(tmpFile string) error {\n\tf, err := os.Open(tmpFile)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"open temp file: %w\", err)\n\t}\n\tdefer f.Close()\n\tif _, err := f.Seek(0, io.SeekStart); err != nil {\n\t\treturn fmt.Errorf(\"seek temp file: %w\", err)\n\t}\n\tif _, err := io.Copy(os.Stdout, f); err != nil {\n\t\treturn fmt.Errorf(\"write stdout: %w\", err)\n\t}\n\treturn nil\n}\n","numLines":373,"startLine":1,"totalLines":373}}}
