{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VNKUsUyrrSoWc4SMbqGFCW","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/tr implements srd054-tr: translate or delete characters.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"fmt\"\n10\t\t\"io\"\n11\t\t\"os\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\ttype config struct {\n19\t\tdelete     bool\n20\t\tsqueeze    bool\n21\t\tcomplement bool\n22\t\toperands   []string\n23\t}\n24\t\n25\tfunc main() {\n26\t\tsys.InstallSIGPIPEHandler()\n27\t\n28\t\tcfg, err := parseArgs(os.Args[1:])\n29\t\tif err != nil {\n30\t\t\tfmt.Fprintf(os.Stderr, \"tr: %s\\n\", err)\n31\t\t\tos.Exit(1)\n32\t\t}\n33\t\tif err := run(cfg); err != nil {\n34\t\t\tfmt.Fprintf(os.Stderr, \"tr: %s\\n\", err)\n35\t\t\tos.Exit(1)\n36\t\t}\n37\t}\n38\t\n39\tfunc parseArgs(args []string) (config, error) {\n40\t\tvar cfg config\n41\t\tendOfFlags := false\n42\t\tfor _, arg := range args {\n43\t\t\tif endOfFlags || arg == \"-\" {\n44\t\t\t\tcfg.operands = append(cfg.operands, arg)\n45\t\t\t\tcontinue\n46\t\t\t}\n47\t\t\tif arg == \"--\" {\n48\t\t\t\tendOfFlags = true\n49\t\t\t\tcontinue\n50\t\t\t}\n51\t\t\tif arg == \"--delete\" {\n52\t\t\t\tcfg.delete = true\n53\t\t\t\tcontinue\n54\t\t\t}\n55\t\t\tif arg == \"--squeeze-repeats\" {\n56\t\t\t\tcfg.squeeze = true\n57\t\t\t\tcontinue\n58\t\t\t}\n59\t\t\tif arg == \"--complement\" {\n60\t\t\t\tcfg.complement = true\n61\t\t\t\tcontinue\n62\t\t\t}\n63\t\t\tif len(arg) > 1 && arg[0] == '-' {\n64\t\t\t\tif arg[1] == '-' {\n65\t\t\t\t\treturn cfg, fmt.Errorf(\"unrecognized option '%s'\", arg)\n66\t\t\t\t}\n67\t\t\t\tif err := parseShortFlags(&cfg, arg[1:]); err != nil {\n68\t\t\t\t\treturn cfg, err\n69\t\t\t\t}\n70\t\t\t\tcontinue\n71\t\t\t}\n72\t\t\tcfg.operands = append(cfg.operands, arg)\n73\t\t}\n74\t\treturn cfg, nil\n75\t}\n76\t\n77\tfunc parseShortFlags(cfg *config, flags string) error {\n78\t\tfor _, c := range flags {\n79\t\t\tswitch c {\n80\t\t\tcase 'd':\n81\t\t\t\tcfg.delete = true\n82\t\t\tcase 's':\n83\t\t\t\tcfg.squeeze = true\n84\t\t\tcase 'c', 'C':\n85\t\t\t\tcfg.complement = true\n86\t\t\tdefault:\n87\t\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", c)\n88\t\t\t}\n89\t\t}\n90\t\treturn nil\n91\t}\n92\t\n93\tfunc validateOperands(cfg config) error {\n94\t\tn := len(cfg.operands)\n95\t\tif n == 0 {\n96\t\t\treturn fmt.Errorf(\"missing operand\")\n97\t\t}\n98\t\tif cfg.delete && !cfg.squeeze {\n99\t\t\tif n > 1 {\n100\t\t\t\treturn fmt.Errorf(\"extra operand '%s'\", cfg.operands[1])\n101\t\t\t}\n102\t\t\treturn nil\n103\t\t}\n104\t\tif cfg.squeeze && !cfg.delete && n == 1 {\n105\t\t\treturn nil\n106\t\t}\n107\t\tif n < 2 {\n108\t\t\treturn fmt.Errorf(\"missing operand after '%s'\", cfg.operands[0])\n109\t\t}\n110\t\treturn nil\n111\t}\n112\t\n113\tfunc run(cfg config) error {\n114\t\tif err := validateOperands(cfg); err != nil {\n115\t\t\treturn err\n116\t\t}\n117\t\tset1, err := expandSet(cfg.operands[0])\n118\t\tif err != nil {\n119\t\t\treturn err\n120\t\t}\n121\t\tif cfg.complement {\n122\t\t\tset1 = complementSet(set1)\n123\t\t}\n124\t\tset1Members := memberSet(set1)\n125\t\tif cfg.delete {\n126\t\t\tif !cfg.squeeze {\n127\t\t\t\treturn process(nil, &set1Members, nil)\n128\t\t\t}\n129\t\t\tset2, err := expandSet(cfg.operands[1])\n130\t\t\tif err != nil {\n131\t\t\t\treturn err\n132\t\t\t}\n133\t\t\tsqSet := memberSet(set2)\n134\t\t\treturn process(nil, &set1Members, &sqSet)\n135\t\t}\n136\t\tif cfg.squeeze && len(cfg.operands) == 1 {\n137\t\t\treturn process(nil, nil, &set1Members)\n138\t\t}\n139\t\tif hasEquivClass(cfg.operands[1]) {\n140\t\t\treturn fmt.Errorf(\"[=c=] expressions may not appear in string2 when translating\")\n141\t\t}\n142\t\tset2, err := expandSet(cfg.operands[1])\n143\t\tif err != nil {\n144\t\t\treturn err\n145\t\t}\n146\t\tif len(set2) == 0 {\n147\t\t\treturn fmt.Errorf(\"when not truncating set1, string2 must be non-empty\")\n148\t\t}\n149\t\ttable := buildTable(set1, set2)\n150\t\tif cfg.squeeze {\n151\t\t\tsqSet := memberSet(set2)\n152\t\t\treturn process(&table, nil, &sqSet)\n153\t\t}\n154\t\treturn process(&table, nil, nil)\n155\t}\n156\t\n157\tfunc complementSet(set []byte) []byte {\n158\t\tvar present [256]bool\n159\t\tfor _, b := range set {\n160\t\t\tpresent[b] = true\n161\t\t}\n162\t\tvar result []byte\n163\t\tfor i := range 256 {\n164\t\t\tif !present[byte(i)] {\n165\t\t\t\tresult = append(result, byte(i))\n166\t\t\t}\n167\t\t}\n168\t\treturn result\n169\t}\n170\t\n171\tfunc memberSet(set []byte) [256]bool {\n172\t\tvar m [256]bool\n173\t\tfor _, b := range set {\n174\t\t\tm[b] = true\n175\t\t}\n176\t\treturn m\n177\t}\n178\t\n179\tfunc buildTable(set1, set2 []byte) [256]byte {\n180\t\tvar table [256]byte\n181\t\tfor i := range table {\n182\t\t\ttable[i] = byte(i)\n183\t\t}\n184\t\tfor i, b := range set1 {\n185\t\t\tif i < len(set2) {\n186\t\t\t\ttable[b] = set2[i]\n187\t\t\t} else {\n188\t\t\t\ttable[b] = set2[len(set2)-1]\n189\t\t\t}\n190\t\t}\n191\t\treturn table\n192\t}\n193\t\n194\tfunc process(table *[256]byte, deleteSet, squeezeSet *[256]bool) error {\n195\t\tr := bufio.NewReader(os.Stdin)\n196\t\tw := bufio.NewWriter(os.Stdout)\n197\t\tprev := -1\n198\t\tbuf := make([]byte, 32*1024)\n199\t\tfor {\n200\t\t\tn, err := r.Read(buf)\n201\t\t\tfor i := range n {\n202\t\t\t\tb := buf[i]\n203\t\t\t\tif deleteSet != nil && deleteSet[b] {\n204\t\t\t\t\tcontinue\n205\t\t\t\t}\n206\t\t\t\tif table != nil {\n207\t\t\t\t\tb = table[b]\n208\t\t\t\t}\n209\t\t\t\tif squeezeSet != nil && squeezeSet[b] && int(b) == prev {\n210\t\t\t\t\tcontinue\n211\t\t\t\t}\n212\t\t\t\tprev = int(b)\n213\t\t\t\tif werr := w.WriteByte(b); werr != nil {\n214\t\t\t\t\treturn werr\n215\t\t\t\t}\n216\t\t\t}\n217\t\t\tif err != nil {\n218\t\t\t\tif err != io.EOF {\n219\t\t\t\t\treturn err\n220\t\t\t\t}\n221\t\t\t\tbreak\n222\t\t\t}\n223\t\t}\n224\t\treturn w.Flush()\n225\t}\n226\t\n227\tfunc expandSet(spec string) ([]byte, error) {\n228\t\tvar result []byte\n229\t\ti := 0\n230\t\tfor i < len(spec) {\n231\t\t\tif spec[i] == '[' {\n232\t\t\t\tn, bytes, err := tryBracketExpr(spec, i)\n233\t\t\t\tif err != nil {\n234\t\t\t\t\treturn nil, err\n235\t\t\t\t}\n236\t\t\t\tif n > 0 {\n237\t\t\t\t\tresult = append(result, bytes...)\n238\t\t\t\t\ti += n\n239\t\t\t\t\tcontinue\n240\t\t\t\t}\n241\t\t\t}\n242\t\t\tch, n := nextByte(spec, i)\n243\t\t\trn, rangeBytes, err := tryRange(spec, i, ch, n)\n244\t\t\tif err != nil {\n245\t\t\t\treturn nil, err\n246\t\t\t}\n247\t\t\tif rn > 0 {\n248\t\t\t\tresult = append(result, rangeBytes...)\n249\t\t\t\ti += rn\n250\t\t\t\tcontinue\n251\t\t\t}\n252\t\t\tresult = append(result, ch)\n253\t\t\ti += n\n254\t\t}\n255\t\treturn result, nil\n256\t}\n257\t\n258\tfunc tryRange(spec string, i int, lo byte, loN int) (int, []byte, error) {\n259\t\tdashPos := i + loN\n260\t\tif dashPos >= len(spec) || spec[dashPos] != '-' {\n261\t\t\treturn 0, nil, nil\n262\t\t}\n263\t\tif dashPos+1 >= len(spec) {\n264\t\t\treturn 0, nil, nil\n265\t\t}\n266\t\thi, hiN := nextByte(spec, dashPos+1)\n267\t\tif lo > hi {\n268\t\t\treturn 0, nil, fmt.Errorf(\n269\t\t\t\t\"range-endpoints of '%c-%c' are in reverse collating sequence order\",\n270\t\t\t\trune(lo), rune(hi))\n271\t\t}\n272\t\treturn loN + 1 + hiN, byteRange(lo, hi), nil\n273\t}\n274\t\n275\tfunc tryBracketExpr(spec string, i int) (int, []byte, error) {\n276\t\tif strings.HasPrefix(spec[i:], \"[:\") {\n277\t\t\treturn parseCharClass(spec, i)\n278\t\t}\n279\t\tif strings.HasPrefix(spec[i:], \"[=\") {\n280\t\t\treturn parseEquivClass(spec, i)\n281\t\t}\n282\t\treturn tryRepeat(spec, i)\n283\t}\n284\t\n285\tfunc parseCharClass(spec string, i int) (int, []byte, error) {\n286\t\tend := strings.Index(spec[i:], \":]\")\n287\t\tif end < 0 {\n288\t\t\treturn 0, nil, nil\n289\t\t}\n290\t\tclassName := spec[i+2 : i+end]\n291\t\tbytes, err := expandCharClass(className)\n292\t\tif err != nil {\n293\t\t\treturn 0, nil, err\n294\t\t}\n295\t\treturn end + 2, bytes, nil\n296\t}\n297\t\n298\tfunc expandCharClass(name string) ([]byte, error) {\n299\t\tswitch name {\n300\t\tcase \"upper\":\n301\t\t\treturn byteRange('A', 'Z'), nil\n302\t\tcase \"lower\":\n303\t\t\treturn byteRange('a', 'z'), nil\n304\t\tcase \"digit\":\n305\t\t\treturn byteRange('0', '9'), nil\n306\t\tcase \"alpha\":\n307\t\t\treturn append(byteRange('A', 'Z'), byteRange('a', 'z')...), nil\n308\t\tcase \"alnum\":\n309\t\t\tr := byteRange('0', '9')\n310\t\t\tr = append(r, byteRange('A', 'Z')...)\n311\t\t\tr = append(r, byteRange('a', 'z')...)\n312\t\t\treturn r, nil\n313\t\tcase \"blank\":\n314\t\t\treturn []byte{'\\t', ' '}, nil\n315\t\tcase \"space\":\n316\t\t\treturn []byte{'\\t', '\\n', '\\v', '\\f', '\\r', ' '}, nil\n317\t\tcase \"cntrl\":\n318\t\t\treturn append(byteRange(0, 31), 127), nil\n319\t\tcase \"print\":\n320\t\t\treturn byteRange(32, 126), nil\n321\t\tcase \"graph\":\n322\t\t\treturn byteRange(33, 126), nil\n323\t\tcase \"punct\":\n324\t\t\treturn expandPunct(), nil\n325\t\tcase \"xdigit\":\n326\t\t\tr := byteRange('0', '9')\n327\t\t\tr = append(r, byteRange('A', 'F')...)\n328\t\t\tr = append(r, byteRange('a', 'f')...)\n329\t\t\treturn r, nil\n330\t\tdefault:\n331\t\t\treturn nil, fmt.Errorf(\"invalid character class '%s'\", name)\n332\t\t}\n333\t}\n334\t\n335\tfunc expandPunct() []byte {\n336\t\tvar result []byte\n337\t\tfor b := byte(33); b <= 126; b++ {\n338\t\t\tif !isAlnum(b) {\n339\t\t\t\tresult = append(result, b)\n340\t\t\t}\n341\t\t}\n342\t\treturn result\n343\t}\n344\t\n345\tfunc isAlnum(b byte) bool {\n346\t\treturn (b >= '0' && b <= '9') ||\n347\t\t\t(b >= 'A' && b <= 'Z') ||\n348\t\t\t(b >= 'a' && b <= 'z')\n349\t}\n350\t\n351\tfunc hasEquivClass(spec string) bool {\n352\t\tfor i := 0; i < len(spec); i++ {\n353\t\t\tif strings.HasPrefix(spec[i:], \"[=\") && strings.Contains(spec[i:], \"=]\") {\n354\t\t\t\treturn true\n355\t\t\t}\n356\t\t}\n357\t\treturn false\n358\t}\n359\t\n360\tfunc parseEquivClass(spec string, i int) (int, []byte, error) {\n361\t\tend := strings.Index(spec[i:], \"=]\")\n362\t\tif end < 0 {\n363\t\t\treturn 0, nil, nil\n364\t\t}\n365\t\tch := spec[i+2]\n366\t\treturn end + 2, []byte{ch}, nil\n367\t}\n368\t\n369\tfunc tryRepeat(spec string, i int) (int, []byte, error) {\n370\t\tend := strings.Index(spec[i:], \"]\")\n371\t\tif end < 0 {\n372\t\t\treturn 0, nil, nil\n373\t\t}\n374\t\tinner := spec[i+1 : i+end]\n375\t\tif len(inner) < 2 {\n376\t\t\treturn 0, nil, nil\n377\t\t}\n378\t\tch, n := nextByte(inner, 0)\n379\t\tif n >= len(inner) || inner[n] != '*' {\n380\t\t\treturn 0, nil, nil\n381\t\t}\n382\t\tcountStr := inner[n+1:]\n383\t\tbytes, err := makeRepeat(ch, countStr)\n384\t\tif err != nil {\n385\t\t\treturn 0, nil, err\n386\t\t}\n387\t\treturn end + 1, bytes, nil\n388\t}\n389\t\n390\tfunc makeRepeat(ch byte, countStr string) ([]byte, error) {\n391\t\tif countStr == \"\" {\n392\t\t\treturn []byte{ch}, nil\n393\t\t}\n394\t\tbase := 10\n395\t\tif strings.HasPrefix(countStr, \"0\") && len(countStr) > 1 {\n396\t\t\tbase = 8\n397\t\t}\n398\t\tcount, err := strconv.ParseInt(countStr, base, 64)\n399\t\tif err != nil {\n400\t\t\treturn nil, fmt.Errorf(\"invalid repeat count '%s'\", countStr)\n401\t\t}\n402\t\tresult := make([]byte, count)\n403\t\tfor j := range result {\n404\t\t\tresult[j] = ch\n405\t\t}\n406\t\treturn result, nil\n407\t}\n408\t\n409\tfunc nextByte(spec string, i int) (byte, int) {\n410\t\tif spec[i] != '\\\\' || i+1 >= len(spec) {\n411\t\t\treturn spec[i], 1\n412\t\t}\n413\t\tc := spec[i+1]\n414\t\tif c >= '0' && c <= '7' {\n415\t\t\treturn parseOctal(spec, i)\n416\t\t}\n417\t\tif ch, ok := escapeChar(c); ok {\n418\t\t\treturn ch, 2\n419\t\t}\n420\t\treturn c, 2\n421\t}\n422\t\n423\tfunc escapeChar(c byte) (byte, bool) {\n424\t\tswitch c {\n425\t\tcase 'a':\n426\t\t\treturn '\\a', true\n427\t\tcase 'b':\n428\t\t\treturn '\\b', true\n429\t\tcase 'f':\n430\t\t\treturn '\\f', true\n431\t\tcase 'n':\n432\t\t\treturn '\\n', true\n433\t\tcase 'r':\n434\t\t\treturn '\\r', true\n435\t\tcase 't':\n436\t\t\treturn '\\t', true\n437\t\tcase 'v':\n438\t\t\treturn '\\v', true\n439\t\tcase '\\\\':\n440\t\t\treturn '\\\\', true\n441\t\tdefault:\n442\t\t\treturn 0, false\n443\t\t}\n444\t}\n445\t\n446\tfunc parseOctal(spec string, i int) (byte, int) {\n447\t\tj := i + 1\n448\t\tfor j < len(spec) && j < i+4 && spec[j] >= '0' && spec[j] <= '7' {\n449\t\t\tj++\n450\t\t}\n451\t\tval, _ := strconv.ParseUint(spec[i+1:j], 8, 16)\n452\t\treturn byte(val), j - i\n453\t}\n454\t\n455\tfunc byteRange(lo, hi byte) []byte {\n456\t\tif lo > hi {\n457\t\t\treturn nil\n458\t\t}\n459\t\tresult := make([]byte, int(hi)-int(lo)+1)\n460\t\tfor i := range result {\n461\t\t\tresult[i] = lo + byte(i)\n462\t\t}\n463\t\treturn result\n464\t}\n465\t"}]},"parent_tool_use_id":null,"session_id":"a9ddd69d-a529-4f5c-9141-8a75c96216c6","uuid":"643f740a-2272-4a3b-94d9-31b51c075c54","timestamp":"2026-05-20T23:40:38.288Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5387/cmd/tr/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/tr implements srd054-tr: translate or delete characters.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype config struct {\n\tdelete     bool\n\tsqueeze    bool\n\tcomplement bool\n\toperands   []string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\tcfg, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"tr: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n\tif err := run(cfg); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"tr: %s\\n\", err)\n\t\tos.Exit(1)\n\t}\n}\n\nfunc parseArgs(args []string) (config, error) {\n\tvar cfg config\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags || arg == \"-\" {\n\t\t\tcfg.operands = append(cfg.operands, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--delete\" {\n\t\t\tcfg.delete = true\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--squeeze-repeats\" {\n\t\t\tcfg.squeeze = true\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--complement\" {\n\t\t\tcfg.complement = true\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\tif arg[1] == '-' {\n\t\t\t\treturn cfg, fmt.Errorf(\"unrecognized option '%s'\", arg)\n\t\t\t}\n\t\t\tif err := parseShortFlags(&cfg, arg[1:]); err != nil {\n\t\t\t\treturn cfg, err\n\t\t\t}\n\t\t\tcontinue\n\t\t}\n\t\tcfg.operands = append(cfg.operands, arg)\n\t}\n\treturn cfg, nil\n}\n\nfunc parseShortFlags(cfg *config, flags string) error {\n\tfor _, c := range flags {\n\t\tswitch c {\n\t\tcase 'd':\n\t\t\tcfg.delete = true\n\t\tcase 's':\n\t\t\tcfg.squeeze = true\n\t\tcase 'c', 'C':\n\t\t\tcfg.complement = true\n\t\tdefault:\n\t\t\treturn fmt.Errorf(\"invalid option -- '%c'\", c)\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc validateOperands(cfg config) error {\n\tn := len(cfg.operands)\n\tif n == 0 {\n\t\treturn fmt.Errorf(\"missing operand\")\n\t}\n\tif cfg.delete && !cfg.squeeze {\n\t\tif n > 1 {\n\t\t\treturn fmt.Errorf(\"extra operand '%s'\", cfg.operands[1])\n\t\t}\n\t\treturn nil\n\t}\n\tif cfg.squeeze && !cfg.delete && n == 1 {\n\t\treturn nil\n\t}\n\tif n < 2 {\n\t\treturn fmt.Errorf(\"missing operand after '%s'\", cfg.operands[0])\n\t}\n\treturn nil\n}\n\nfunc run(cfg config) error {\n\tif err := validateOperands(cfg); err != nil {\n\t\treturn err\n\t}\n\tset1, err := expandSet(cfg.operands[0])\n\tif err != nil {\n\t\treturn err\n\t}\n\tif cfg.complement {\n\t\tset1 = complementSet(set1)\n\t}\n\tset1Members := memberSet(set1)\n\tif cfg.delete {\n\t\tif !cfg.squeeze {\n\t\t\treturn process(nil, &set1Members, nil)\n\t\t}\n\t\tset2, err := expandSet(cfg.operands[1])\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tsqSet := memberSet(set2)\n\t\treturn process(nil, &set1Members, &sqSet)\n\t}\n\tif cfg.squeeze && len(cfg.operands) == 1 {\n\t\treturn process(nil, nil, &set1Members)\n\t}\n\tif hasEquivClass(cfg.operands[1]) {\n\t\treturn fmt.Errorf(\"[=c=] expressions may not appear in string2 when translating\")\n\t}\n\tset2, err := expandSet(cfg.operands[1])\n\tif err != nil {\n\t\treturn err\n\t}\n\tif len(set2) == 0 {\n\t\treturn fmt.Errorf(\"when not truncating set1, string2 must be non-empty\")\n\t}\n\ttable := buildTable(set1, set2)\n\tif cfg.squeeze {\n\t\tsqSet := memberSet(set2)\n\t\treturn process(&table, nil, &sqSet)\n\t}\n\treturn process(&table, nil, nil)\n}\n\nfunc complementSet(set []byte) []byte {\n\tvar present [256]bool\n\tfor _, b := range set {\n\t\tpresent[b] = true\n\t}\n\tvar result []byte\n\tfor i := range 256 {\n\t\tif !present[byte(i)] {\n\t\t\tresult = append(result, byte(i))\n\t\t}\n\t}\n\treturn result\n}\n\nfunc memberSet(set []byte) [256]bool {\n\tvar m [256]bool\n\tfor _, b := range set {\n\t\tm[b] = true\n\t}\n\treturn m\n}\n\nfunc buildTable(set1, set2 []byte) [256]byte {\n\tvar table [256]byte\n\tfor i := range table {\n\t\ttable[i] = byte(i)\n\t}\n\tfor i, b := range set1 {\n\t\tif i < len(set2) {\n\t\t\ttable[b] = set2[i]\n\t\t} else {\n\t\t\ttable[b] = set2[len(set2)-1]\n\t\t}\n\t}\n\treturn table\n}\n\nfunc process(table *[256]byte, deleteSet, squeezeSet *[256]bool) error {\n\tr := bufio.NewReader(os.Stdin)\n\tw := bufio.NewWriter(os.Stdout)\n\tprev := -1\n\tbuf := make([]byte, 32*1024)\n\tfor {\n\t\tn, err := r.Read(buf)\n\t\tfor i := range n {\n\t\t\tb := buf[i]\n\t\t\tif deleteSet != nil && deleteSet[b] {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif table != nil {\n\t\t\t\tb = table[b]\n\t\t\t}\n\t\t\tif squeezeSet != nil && squeezeSet[b] && int(b) == prev {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tprev = int(b)\n\t\t\tif werr := w.WriteByte(b); werr != nil {\n\t\t\t\treturn werr\n\t\t\t}\n\t\t}\n\t\tif err != nil {\n\t\t\tif err != io.EOF {\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t}\n\treturn w.Flush()\n}\n\nfunc expandSet(spec string) ([]byte, error) {\n\tvar result []byte\n\ti := 0\n\tfor i < len(spec) {\n\t\tif spec[i] == '[' {\n\t\t\tn, bytes, err := tryBracketExpr(spec, i)\n\t\t\tif err != nil {\n\t\t\t\treturn nil, err\n\t\t\t}\n\t\t\tif n > 0 {\n\t\t\t\tresult = append(result, bytes...)\n\t\t\t\ti += n\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tch, n := nextByte(spec, i)\n\t\trn, rangeBytes, err := tryRange(spec, i, ch, n)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif rn > 0 {\n\t\t\tresult = append(result, rangeBytes...)\n\t\t\ti += rn\n\t\t\tcontinue\n\t\t}\n\t\tresult = append(result, ch)\n\t\ti += n\n\t}\n\treturn result, nil\n}\n\nfunc tryRange(spec string, i int, lo byte, loN int) (int, []byte, error) {\n\tdashPos := i + loN\n\tif dashPos >= len(spec) || spec[dashPos] != '-' {\n\t\treturn 0, nil, nil\n\t}\n\tif dashPos+1 >= len(spec) {\n\t\treturn 0, nil, nil\n\t}\n\thi, hiN := nextByte(spec, dashPos+1)\n\tif lo > hi {\n\t\treturn 0, nil, fmt.Errorf(\n\t\t\t\"range-endpoints of '%c-%c' are in reverse collating sequence order\",\n\t\t\trune(lo), rune(hi))\n\t}\n\treturn loN + 1 + hiN, byteRange(lo, hi), nil\n}\n\nfunc tryBracketExpr(spec string, i int) (int, []byte, error) {\n\tif strings.HasPrefix(spec[i:], \"[:\") {\n\t\treturn parseCharClass(spec, i)\n\t}\n\tif strings.HasPrefix(spec[i:], \"[=\") {\n\t\treturn parseEquivClass(spec, i)\n\t}\n\treturn tryRepeat(spec, i)\n}\n\nfunc parseCharClass(spec string, i int) (int, []byte, error) {\n\tend := strings.Index(spec[i:], \":]\")\n\tif end < 0 {\n\t\treturn 0, nil, nil\n\t}\n\tclassName := spec[i+2 : i+end]\n\tbytes, err := expandCharClass(className)\n\tif err != nil {\n\t\treturn 0, nil, err\n\t}\n\treturn end + 2, bytes, nil\n}\n\nfunc expandCharClass(name string) ([]byte, error) {\n\tswitch name {\n\tcase \"upper\":\n\t\treturn byteRange('A', 'Z'), nil\n\tcase \"lower\":\n\t\treturn byteRange('a', 'z'), nil\n\tcase \"digit\":\n\t\treturn byteRange('0', '9'), nil\n\tcase \"alpha\":\n\t\treturn append(byteRange('A', 'Z'), byteRange('a', 'z')...), nil\n\tcase \"alnum\":\n\t\tr := byteRange('0', '9')\n\t\tr = append(r, byteRange('A', 'Z')...)\n\t\tr = append(r, byteRange('a', 'z')...)\n\t\treturn r, nil\n\tcase \"blank\":\n\t\treturn []byte{'\\t', ' '}, nil\n\tcase \"space\":\n\t\treturn []byte{'\\t', '\\n', '\\v', '\\f', '\\r', ' '}, nil\n\tcase \"cntrl\":\n\t\treturn append(byteRange(0, 31), 127), nil\n\tcase \"print\":\n\t\treturn byteRange(32, 126), nil\n\tcase \"graph\":\n\t\treturn byteRange(33, 126), nil\n\tcase \"punct\":\n\t\treturn expandPunct(), nil\n\tcase \"xdigit\":\n\t\tr := byteRange('0', '9')\n\t\tr = append(r, byteRange('A', 'F')...)\n\t\tr = append(r, byteRange('a', 'f')...)\n\t\treturn r, nil\n\tdefault:\n\t\treturn nil, fmt.Errorf(\"invalid character class '%s'\", name)\n\t}\n}\n\nfunc expandPunct() []byte {\n\tvar result []byte\n\tfor b := byte(33); b <= 126; b++ {\n\t\tif !isAlnum(b) {\n\t\t\tresult = append(result, b)\n\t\t}\n\t}\n\treturn result\n}\n\nfunc isAlnum(b byte) bool {\n\treturn (b >= '0' && b <= '9') ||\n\t\t(b >= 'A' && b <= 'Z') ||\n\t\t(b >= 'a' && b <= 'z')\n}\n\nfunc hasEquivClass(spec string) bool {\n\tfor i := 0; i < len(spec); i++ {\n\t\tif strings.HasPrefix(spec[i:], \"[=\") && strings.Contains(spec[i:], \"=]\") {\n\t\t\treturn true\n\t\t}\n\t}\n\treturn false\n}\n\nfunc parseEquivClass(spec string, i int) (int, []byte, error) {\n\tend := strings.Index(spec[i:], \"=]\")\n\tif end < 0 {\n\t\treturn 0, nil, nil\n\t}\n\tch := spec[i+2]\n\treturn end + 2, []byte{ch}, nil\n}\n\nfunc tryRepeat(spec string, i int) (int, []byte, error) {\n\tend := strings.Index(spec[i:], \"]\")\n\tif end < 0 {\n\t\treturn 0, nil, nil\n\t}\n\tinner := spec[i+1 : i+end]\n\tif len(inner) < 2 {\n\t\treturn 0, nil, nil\n\t}\n\tch, n := nextByte(inner, 0)\n\tif n >= len(inner) || inner[n] != '*' {\n\t\treturn 0, nil, nil\n\t}\n\tcountStr := inner[n+1:]\n\tbytes, err := makeRepeat(ch, countStr)\n\tif err != nil {\n\t\treturn 0, nil, err\n\t}\n\treturn end + 1, bytes, nil\n}\n\nfunc makeRepeat(ch byte, countStr string) ([]byte, error) {\n\tif countStr == \"\" {\n\t\treturn []byte{ch}, nil\n\t}\n\tbase := 10\n\tif strings.HasPrefix(countStr, \"0\") && len(countStr) > 1 {\n\t\tbase = 8\n\t}\n\tcount, err := strconv.ParseInt(countStr, base, 64)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"invalid repeat count '%s'\", countStr)\n\t}\n\tresult := make([]byte, count)\n\tfor j := range result {\n\t\tresult[j] = ch\n\t}\n\treturn result, nil\n}\n\nfunc nextByte(spec string, i int) (byte, int) {\n\tif spec[i] != '\\\\' || i+1 >= len(spec) {\n\t\treturn spec[i], 1\n\t}\n\tc := spec[i+1]\n\tif c >= '0' && c <= '7' {\n\t\treturn parseOctal(spec, i)\n\t}\n\tif ch, ok := escapeChar(c); ok {\n\t\treturn ch, 2\n\t}\n\treturn c, 2\n}\n\nfunc escapeChar(c byte) (byte, bool) {\n\tswitch c {\n\tcase 'a':\n\t\treturn '\\a', true\n\tcase 'b':\n\t\treturn '\\b', true\n\tcase 'f':\n\t\treturn '\\f', true\n\tcase 'n':\n\t\treturn '\\n', true\n\tcase 'r':\n\t\treturn '\\r', true\n\tcase 't':\n\t\treturn '\\t', true\n\tcase 'v':\n\t\treturn '\\v', true\n\tcase '\\\\':\n\t\treturn '\\\\', true\n\tdefault:\n\t\treturn 0, false\n\t}\n}\n\nfunc parseOctal(spec string, i int) (byte, int) {\n\tj := i + 1\n\tfor j < len(spec) && j < i+4 && spec[j] >= '0' && spec[j] <= '7' {\n\t\tj++\n\t}\n\tval, _ := strconv.ParseUint(spec[i+1:j], 8, 16)\n\treturn byte(val), j - i\n}\n\nfunc byteRange(lo, hi byte) []byte {\n\tif lo > hi {\n\t\treturn nil\n\t}\n\tresult := make([]byte, int(hi)-int(lo)+1)\n\tfor i := range result {\n\t\tresult[i] = lo + byte(i)\n\t}\n\treturn result\n}\n","numLines":465,"startLine":1,"totalLines":465}}}
