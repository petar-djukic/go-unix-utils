{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ce8KWnVGnjK76faGhnpkSH","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/install implements srd101-install R1.1-R1.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"os/user\"\n12\t\t\"path/filepath\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\n17\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n18\t)\n19\t\n20\tconst helpText = `Usage: install [OPTION]... [-T] SOURCE DEST\n21\t  or:  install [OPTION]... SOURCE... DIRECTORY\n22\t  or:  install [OPTION]... -d DIRECTORY...\n23\t\n24\tCopy files and set attributes.\n25\t\n26\t  -c                  (ignored)\n27\t  -g GROUP            set group ownership\n28\t  -m MODE             set permission mode (as in chmod), instead of rwxr-xr-x\n29\t  -o OWNER            set ownership\n30\t      --help          display this help and exit\n31\t      --version       output version information and exit\n32\t`\n33\t\n34\tconst versionText = `install (go-unix-utils) dev\n35\t`\n36\t\n37\ttype options struct {\n38\t\tmode  string\n39\t\towner string\n40\t\tgroup string\n41\t}\n42\t\n43\tfunc main() {\n44\t\tsys.InstallSIGPIPEHandler()\n45\t\n46\t\topts, args := parseArgs(os.Args[1:])\n47\t\tif len(args) == 0 {\n48\t\t\tfmt.Fprintln(os.Stderr, \"install: missing file operand\")\n49\t\t\tos.Exit(1)\n50\t\t}\n51\t\tif len(args) == 1 {\n52\t\t\tfmt.Fprintf(os.Stderr,\n53\t\t\t\t\"install: missing destination file operand after '%s'\\n\", args[0])\n54\t\t\tos.Exit(1)\n55\t\t}\n56\t\n57\t\tdest := args[len(args)-1]\n58\t\tsources := args[:len(args)-1]\n59\t\n60\t\texitCode := 0\n61\t\tif len(sources) > 1 {\n62\t\t\texitCode = installMultiple(opts, sources, dest)\n63\t\t} else {\n64\t\t\tif err := installSingle(opts, sources[0], dest); err != nil {\n65\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n66\t\t\t\texitCode = 1\n67\t\t\t}\n68\t\t}\n69\t\tif exitCode != 0 {\n70\t\t\tos.Exit(exitCode)\n71\t\t}\n72\t}\n73\t\n74\tfunc installMultiple(opts options, sources []string, dest string) int {\n75\t\tfi, err := os.Stat(dest)\n76\t\tif err != nil || !fi.IsDir() {\n77\t\t\tfmt.Fprintf(os.Stderr,\n78\t\t\t\t\"install: target '%s' is not a directory\\n\", dest)\n79\t\t\treturn 1\n80\t\t}\n81\t\texitCode := 0\n82\t\tfor _, src := range sources {\n83\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n84\t\t\tif err := installSingle(opts, src, target); err != nil {\n85\t\t\t\tfmt.Fprintf(os.Stderr, \"install: %s\\n\", err)\n86\t\t\t\texitCode = 1\n87\t\t\t}\n88\t\t}\n89\t\treturn exitCode\n90\t}\n91\t\n92\tfunc installSingle(opts options, src, dest string) error {\n93\t\tsrcInfo, err := os.Stat(src)\n94\t\tif err != nil {\n95\t\t\treturn fmt.Errorf(\"cannot stat '%s': %s\", src, unwrapErr(err))\n96\t\t}\n97\t\tif srcInfo.IsDir() {\n98\t\t\treturn fmt.Errorf(\"omitting directory '%s'\", src)\n99\t\t}\n100\t\tif fi, err := os.Stat(dest); err == nil && fi.IsDir() {\n101\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n102\t\t}\n103\t\tif err := copyFile(src, dest); err != nil {\n104\t\t\treturn err\n105\t\t}\n106\t\tif err := setMode(opts, dest); err != nil {\n107\t\t\treturn err\n108\t\t}\n109\t\treturn setOwnership(opts, dest)\n110\t}\n111\t\n112\tfunc copyFile(src, dest string) error {\n113\t\tsf, err := os.Open(src)\n114\t\tif err != nil {\n115\t\t\treturn fmt.Errorf(\"cannot open '%s': %s\", src, unwrapErr(err))\n116\t\t}\n117\t\tdefer sf.Close()\n118\t\n119\t\tdf, err := os.Create(dest)\n120\t\tif err != nil {\n121\t\t\treturn fmt.Errorf(\"cannot create regular file '%s': %s\",\n122\t\t\t\tdest, unwrapErr(err))\n123\t\t}\n124\t\tdefer df.Close()\n125\t\n126\t\tif _, err := io.Copy(df, sf); err != nil {\n127\t\t\treturn fmt.Errorf(\"writing '%s': %s\", dest, unwrapErr(err))\n128\t\t}\n129\t\treturn df.Close()\n130\t}\n131\t\n132\tfunc setMode(opts options, path string) error {\n133\t\tif opts.mode == \"\" {\n134\t\t\treturn os.Chmod(path, 0755)\n135\t\t}\n136\t\tperm, err := resolveMode(opts.mode)\n137\t\tif err != nil {\n138\t\t\treturn fmt.Errorf(\"invalid mode '%s'\", opts.mode)\n139\t\t}\n140\t\treturn os.Chmod(path, perm)\n141\t}\n142\t\n143\tfunc resolveMode(mode string) (os.FileMode, error) {\n144\t\tif isOctalMode(mode) {\n145\t\t\tval, err := strconv.ParseUint(mode, 8, 32)\n146\t\t\tif err != nil {\n147\t\t\t\treturn 0, err\n148\t\t\t}\n149\t\t\treturn os.FileMode(val), nil\n150\t\t}\n151\t\treturn evalSymbolic(mode, 0, getUmask())\n152\t}\n153\t\n154\tfunc getUmask() os.FileMode {\n155\t\told := syscall.Umask(0)\n156\t\tsyscall.Umask(old)\n157\t\treturn os.FileMode(old)\n158\t}\n159\t\n160\tfunc setOwnership(opts options, path string) error {\n161\t\tuid, gid := -1, -1\n162\t\tif opts.owner != \"\" {\n163\t\t\tvar err error\n164\t\t\tuid, err = lookupUser(opts.owner)\n165\t\t\tif err != nil {\n166\t\t\t\treturn err\n167\t\t\t}\n168\t\t}\n169\t\tif opts.group != \"\" {\n170\t\t\tvar err error\n171\t\t\tgid, err = lookupGroup(opts.group)\n172\t\t\tif err != nil {\n173\t\t\t\treturn err\n174\t\t\t}\n175\t\t}\n176\t\tif uid == -1 && gid == -1 {\n177\t\t\treturn nil\n178\t\t}\n179\t\tif err := os.Chown(path, uid, gid); err != nil {\n180\t\t\treturn fmt.Errorf(\"cannot change ownership of '%s': %s\",\n181\t\t\t\tpath, unwrapErr(err))\n182\t\t}\n183\t\treturn nil\n184\t}\n185\t\n186\tfunc lookupUser(name string) (int, error) {\n187\t\tif uid, err := strconv.Atoi(name); err == nil {\n188\t\t\treturn uid, nil\n189\t\t}\n190\t\tu, err := user.Lookup(name)\n191\t\tif err != nil {\n192\t\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n193\t\t}\n194\t\tuid, err := strconv.Atoi(u.Uid)\n195\t\tif err != nil {\n196\t\t\treturn 0, fmt.Errorf(\"invalid user: '%s'\", name)\n197\t\t}\n198\t\treturn uid, nil\n199\t}\n200\t\n201\tfunc lookupGroup(name string) (int, error) {\n202\t\tif gid, err := strconv.Atoi(name); err == nil {\n203\t\t\treturn gid, nil\n204\t\t}\n205\t\tg, err := user.LookupGroup(name)\n206\t\tif err != nil {\n207\t\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n208\t\t}\n209\t\tgid, err := strconv.Atoi(g.Gid)\n210\t\tif err != nil {\n211\t\t\treturn 0, fmt.Errorf(\"invalid group: '%s'\", name)\n212\t\t}\n213\t\treturn gid, nil\n214\t}\n215\t\n216\tfunc unwrapErr(err error) string {\n217\t\tif pe, ok := err.(*os.PathError); ok {\n218\t\t\treturn pe.Err.Error()\n219\t\t}\n220\t\treturn err.Error()\n221\t}\n222\t\n223\tfunc parseArgs(args []string) (options, []string) {\n224\t\tvar opts options\n225\t\tvar operands []string\n226\t\tendOfFlags := false\n227\t\ti := 0\n228\t\tfor i < len(args) {\n229\t\t\targ := args[i]\n230\t\t\tif endOfFlags {\n231\t\t\t\toperands = append(operands, arg)\n232\t\t\t\ti++\n233\t\t\t\tcontinue\n234\t\t\t}\n235\t\t\tif arg == \"--\" {\n236\t\t\t\tendOfFlags = true\n237\t\t\t\ti++\n238\t\t\t\tcontinue\n239\t\t\t}\n240\t\t\tif strings.HasPrefix(arg, \"--\") {\n241\t\t\t\ti = parseLongFlag(args, i, &opts)\n242\t\t\t\tcontinue\n243\t\t\t}\n244\t\t\tif strings.HasPrefix(arg, \"-\") && len(arg) > 1 {\n245\t\t\t\ti = parseShortFlags(args, i, &opts)\n246\t\t\t\tcontinue\n247\t\t\t}\n248\t\t\toperands = append(operands, arg)\n249\t\t\ti++\n250\t\t}\n251\t\treturn opts, operands\n252\t}\n253\t\n254\tfunc parseLongFlag(args []string, i int, opts *options) int {\n255\t\targ := args[i]\n256\t\tswitch {\n257\t\tcase arg == \"--help\":\n258\t\t\tfmt.Fprint(os.Stdout, helpText)\n259\t\t\tos.Exit(0)\n260\t\tcase arg == \"--version\":\n261\t\t\tfmt.Fprint(os.Stdout, versionText)\n262\t\t\tos.Exit(0)\n263\t\tcase strings.HasPrefix(arg, \"--mode=\"):\n264\t\t\topts.mode = arg[len(\"--mode=\"):]\n265\t\tcase strings.HasPrefix(arg, \"--owner=\"):\n266\t\t\topts.owner = arg[len(\"--owner=\"):]\n267\t\tcase strings.HasPrefix(arg, \"--group=\"):\n268\t\t\topts.group = arg[len(\"--group=\"):]\n269\t\t}\n270\t\treturn i + 1\n271\t}\n272\t\n273\tfunc parseShortFlag