{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T3NV6sjxPsZNvSkDwHXE1w","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd060-date R1.1-R1.4, R2.1-R2.3, R3.1-R3.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"fmt\"\n9\t\t\"os\"\n10\t\t\"strconv\"\n11\t\t\"strings\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst defaultFormat = \"%a %b %e %H:%M:%S %Z %Y\"\n18\t\n19\ttype config struct {\n20\t\tformat    string\n21\t\thasFormat bool\n22\t\tdateStr   string\n23\t\tutc       bool\n24\t\trefFile   string\n25\t}\n26\t\n27\tfunc main() {\n28\t\tsys.InstallSIGPIPEHandler()\n29\t\tcfg, err := parseArgs(os.Args[1:])\n30\t\tif err != nil {\n31\t\t\tfmt.Fprintf(os.Stderr, \"date: %s\\n\", err)\n32\t\t\tos.Exit(1)\n33\t\t}\n34\t\tt, err := resolveTime(cfg)\n35\t\tif err != nil {\n36\t\t\tfmt.Fprintf(os.Stderr, \"date: %s\\n\", err)\n37\t\t\tos.Exit(1)\n38\t\t}\n39\t\tfmt.Println(formatOutput(t, cfg.format, cfg.hasFormat))\n40\t}\n41\t\n42\tfunc parseArgs(args []string) (config, error) {\n43\t\tvar cfg config\n44\t\tfor i := 0; i < len(args); i++ {\n45\t\t\targ := args[i]\n46\t\t\tswitch {\n47\t\t\tcase strings.HasPrefix(arg, \"+\"):\n48\t\t\t\tcfg.format = arg[1:]\n49\t\t\t\tcfg.hasFormat = true\n50\t\t\tcase arg == \"-d\" || arg == \"--date\":\n51\t\t\t\ti++\n52\t\t\t\tif i >= len(args) {\n53\t\t\t\t\treturn cfg, fmt.Errorf(\"option requires an argument -- 'd'\")\n54\t\t\t\t}\n55\t\t\t\tcfg.dateStr = args[i]\n56\t\t\tcase strings.HasPrefix(arg, \"--date=\"):\n57\t\t\t\tcfg.dateStr = strings.TrimPrefix(arg, \"--date=\")\n58\t\t\tcase arg == \"-u\" || arg == \"--utc\" || arg == \"--universal\":\n59\t\t\t\tcfg.utc = true\n60\t\t\tcase arg == \"-r\" || arg == \"--reference\":\n61\t\t\t\ti++\n62\t\t\t\tif i >= len(args) {\n63\t\t\t\t\treturn cfg, fmt.Errorf(\"option requires an argument -- 'r'\")\n64\t\t\t\t}\n65\t\t\t\tcfg.refFile = args[i]\n66\t\t\tcase strings.HasPrefix(arg, \"--reference=\"):\n67\t\t\t\tcfg.refFile = strings.TrimPrefix(arg, \"--reference=\")\n68\t\t\t}\n69\t\t}\n70\t\treturn cfg, nil\n71\t}\n72\t\n73\tfunc resolveTime(cfg config) (time.Time, error) {\n74\t\tt := time.Now()\n75\t\tif cfg.refFile != \"\" {\n76\t\t\tinfo, err := os.Stat(cfg.refFile)\n77\t\t\tif err != nil {\n78\t\t\t\treturn t, fmt.Errorf(\"cannot stat '%s': No such file or directory\", cfg.refFile)\n79\t\t\t}\n80\t\t\tt = info.ModTime()\n81\t\t}\n82\t\tif cfg.dateStr != \"\" {\n83\t\t\tparsed, err := parseDateString(cfg.dateStr)\n84\t\t\tif err != nil {\n85\t\t\t\treturn t, err\n86\t\t\t}\n87\t\t\tt = parsed\n88\t\t}\n89\t\tif cfg.utc {\n90\t\t\tt = t.UTC()\n91\t\t}\n92\t\treturn t, nil\n93\t}\n94\t\n95\tvar dateLayouts = []string{\n96\t\t\"2006-01-02 15:04:05\",\n97\t\t\"2006-01-02T15:04:05\",\n98\t\t\"2006-01-02\",\n99\t}\n100\t\n101\tfunc parseDateString(s string) (time.Time, error) {\n102\t\tif strings.HasPrefix(s, \"@\") {\n103\t\t\tsec, err := strconv.ParseInt(s[1:], 10, 64)\n104\t\t\tif err != nil {\n105\t\t\t\treturn time.Time{}, fmt.Errorf(\"invalid date '%s'\", s)\n106\t\t\t}\n107\t\t\treturn time.Unix(sec, 0), nil\n108\t\t}\n109\t\tfor _, layout := range dateLayouts {\n110\t\t\tif t, err := time.ParseInLocation(layout, s, time.Local); err == nil {\n111\t\t\t\treturn t, nil\n112\t\t\t}\n113\t\t}\n114\t\treturn time.Time{}, fmt.Errorf(\"invalid date '%s'\", s)\n115\t}\n116\t\n117\tfunc formatOutput(t time.Time, format string, hasFormat bool) string {\n118\t\tif !hasFormat {\n119\t\t\treturn formatTime(t, defaultFormat)\n120\t\t}\n121\t\treturn formatTime(t, format)\n122\t}\n123\t\n124\tfunc formatTime(t time.Time, format string) string {\n125\t\tvar b strings.Builder\n126\t\tb.Grow(len(format) * 2)\n127\t\ti := 0\n128\t\tfor i < len(format) {\n129\t\t\tif format[i] != '%' {\n130\t\t\t\tb.WriteByte(format[i])\n131\t\t\t\ti++\n132\t\t\t\tcontinue\n133\t\t\t}\n134\t\t\ti