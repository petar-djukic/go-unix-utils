{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017jojrXkd6EVTiNJfz64sna","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"crypto/sha1\"\n8\t\t\"crypto/sha256\"\n9\t\t\"crypto/sha512\"\n10\t\t\"fmt\"\n11\t\t\"hash\"\n12\t\t\"io\"\n13\t\t\"os\"\n14\t\t\"strings\"\n15\t\n16\t\t\"golang.org/x/crypto/blake2b\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/hashutil\"\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n20\t)\n21\t\n22\tvar crcTable [256]uint32\n23\t\n24\tfunc init() {\n25\t\tconst poly = 0x04C11DB7\n26\t\tfor i := range 256 {\n27\t\t\tc := uint32(i) << 24\n28\t\t\tfor range 8 {\n29\t\t\t\tif c&0x80000000 != 0 {\n30\t\t\t\t\tc = (c << 1) ^ poly\n31\t\t\t\t} else {\n32\t\t\t\t\tc <<= 1\n33\t\t\t\t}\n34\t\t\t}\n35\t\t\tcrcTable[i] = c\n36\t\t}\n37\t}\n38\t\n39\ttype options struct {\n40\t\talgorithm string\n41\t\tuntagged  bool\n42\t\traw       bool\n43\t}\n44\t\n45\tfunc main() {\n46\t\tsys.InstallSIGPIPEHandler()\n47\t\topts, files := parseArgs(os.Args[1:])\n48\t\talg := opts.algorithm\n49\t\tif alg == \"\" || alg == \"crc\" {\n50\t\t\trunCRC(files)\n51\t\t\treturn\n52\t\t}\n53\t\tcfg, err := algorithmConfig(alg)\n54\t\tif err != nil {\n55\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n56\t\t\tos.Exit(1)\n57\t\t}\n58\t\tif opts.raw {\n59\t\t\tif len(files) > 1 {\n60\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: the --raw option is not supported with multiple files\\n\")\n61\t\t\t\tos.Exit(1)\n62\t\t\t}\n63\t\t\tos.Exit(digestRaw(files, cfg))\n64\t\t}\n65\t\tos.Exit(hashutil.DigestFiles(files, cfg, false, !opts.untagged, os.Stdout, os.Stderr))\n66\t}\n67\t\n68\tfunc runCRC(files []string) {\n69\t\texitCode := 0\n70\t\tif len(files) == 0 {\n71\t\t\tif err := crcStdin(os.Stdout); err != nil {\n72\t\t\t\tfmt.Fprintf(os.Stderr, \"cksum: %v\\n\", err)\n73\t\t\t\texitCode = 1\n74\t\t\t}\n75\t\t} els