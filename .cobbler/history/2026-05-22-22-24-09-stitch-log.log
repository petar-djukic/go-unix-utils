nil))\n129\t\t}\n130\t\treturn 0\n131\t}\n132\t\n133\tfunc parseArgs(args []string) (options, []string) {\n134\t\tvar opts options\n135\t\tvar files []string\n136\t\ti := 0\n137\t\tfor i < len(args) {\n138\t\t\targ := args[i]\n139\t\t\tif arg == \"--\" {\n140\t\t\t\tfiles = append(files, args[i+1:]...)\n141\t\t\t\tbreak\n142\t\t\t}\n143\t\t\tif strings.HasPrefix(arg, \"--\") {\n144\t\t\t\ti += parseLongFlag(args[i:], &opts)\n145\t\t\t\tcontinue\n146\t\t\t}\n147\t\t\tif arg != \"-\" && strings.HasPrefix(arg, \"-\") {\n148\t\t\t\ti += parseShortFlag(args[i:], &opts)\n149\t\t\t\tcontinue\n150\t\t\t}\n151\t\t\tfiles = append(files, arg)\n152\t\t\ti++\n153\t\t}\n154\t\treturn opts, files\n155\t}\n156\t\n157\tfunc parseLongFlag(remaining []string, opts *options) int {\n158\t\targ := remaining[0]\n159\t\tswitch {\n160\t\tcase arg == \"--untagged\":\n161\t\t\topts.untagged = true\n162\t\tcase arg == \"--raw\":\n163\t\t\topts.raw = true\n164\t\tcase arg == \"--algorithm\" && len(remaining) >= 2:\n165\t\t\topts.algorithm = remaining[1]\n166\t\t\treturn 2\n167\t\tcase strings.HasPrefix(arg, \"--algorithm=\"):\n168\t\t\topts.algorithm = arg[len(\"--algorithm=\"):]\n169\t\t}\n170\t\treturn 1\n171\t}\n172\t\n173\tfunc parseShortFlag(remaining []string, opts *options) int {\n174\t\targ := remaining[0]\n175\t\tif len(arg) >= 2 && arg[1] == 'a' {\n176\t\t\tif len(arg) > 2 {\n177\t\t\t\topts.algorithm = arg[2:]\n178\t\t\t\treturn 1\n179\t\t\t}\n180\t\t\tif len(remaining) >= 2 {\n181\t\t\t\topts.algorithm = remaining[1]\n182\t\t\t\treturn 2\n183\t\t\t}\n184\t\t}\n185\t\treturn 1\n186\t}\n187\t\n188\tfunc crcStdin(stdout io.Writer) error {\n189\t\tcrc, size, err := computeCRC(os.Stdin)\n190\t\tif err != nil {\n191\t\t\treturn err\n192\t\t}\n193\t\tfmt.Fprintf(stdout, \"%d %d\\n\", crc, size)\n194\t\treturn nil\n195\t}\n196\t\n197\tfunc crcFile(file string, stdout io.Writer) error {\n198\t\tr, err := openInput(file)\n199\t\tif err != nil {\n200\t\t\treturn err\n201\t\t}\n202\t\tdefer r.