{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017yyytBqyPPUDWtA2gzKqZV","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"strconv\"\n9\t\t\"strings\"\n10\t\n11\t\t\"golang.org/x/sys/unix\"\n12\t)\n13\t\n14\tfunc applySettings(fd int, t *unix.Termios, settings []string) error {\n15\t\tfor _, s := range settings {\n16\t\t\tif err := applySetting(t, s); err != nil {\n17\t\t\t\treturn err\n18\t\t\t}\n19\t\t}\n20\t\treturn unix.IoctlSetTermios(fd, unix.TIOCSETA, t)\n21\t}\n22\t\n23\tfunc applySetting(t *unix.Termios, s string) error {\n24\t\tif strings.Contains(s, \":\") {\n25\t\t\treturn restoreFromSave(t, s)\n26\t\t}\n27\t\tnegate := strings.HasPrefix(s, \"-\")\n28\t\tname := s\n29\t\tif negate {\n30\t\t\tname = s[1:]\n31\t\t}\n32\t\tif applyFlag(t, name, negate) {\n33\t\t\treturn nil\n34\t\t}\n35\t\tif !negate && applyCSize(t, name) {\n36\t\t\treturn nil\n37\t\t}\n38\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n39\t}\n40\t\n41\tfunc applyFlag(t *unix.Termios, name string, negate bool) bool {\n42\t\tif f, ok := findFlag(name, iflags); ok {\n43\t\t\ttoggleBit(&t.Iflag, f.mask, !negate)\n44\t\t\treturn true\n45\t\t}\n46\t\tif f, ok := findFlag(name, oflags); ok {\n47\t\t\ttoggleBit(&t.Oflag, f.mask, !negate)\n48\t\t\treturn true\n49\t\t}\n50\t\tif f, ok := findFlag(name, cflags); ok {\n51\t\t\ttoggleBit(&t.Cflag, f.mask, !negate)\n52\t\t\treturn true\n53\t\t}\n54\t\tif f, ok := findFlag(name, lflags); ok {\n55\t\t\ttoggleBit(&t.Lflag, f.mask, !negate)\n56\t\t\treturn true\n57\t\t}\n58\t\treturn false\n59\t}\n60\t\n61\tfunc findFlag(name string, flags []flagDef) (flagDef, bool) {\n62\t\tfor _, f := range flags {\n63\t\t\tif f.name == name {\n64\t\t\t\treturn f, true\n65\t\t\t}\n66\t\t}\n67\t\treturn flagDef{}, false\n68\t}\n69\t\n70\tfunc toggleBit(field *uint64, mask uint64, set bool) {\n71\t\tif set {\n72\t\t\t*field |= mask\n73\t\t} else {\n74\t\t\t*field &^= mask\n75\t\t}\n76\t}\n77\t\n78\tfunc applyCSize(t *unix.Termios, name string) bool {\n79\t\tvar val uint64\n80\t\tswitch name {\n81\t\tcase \"cs5\":\n82\t\t\tval = unix.CS5\n83\t\tcase \"cs6\":\n84\t\t\tval = unix.CS6\n85\t\tcase \"cs7\":\n86\t\t\tval = unix.CS7\n87\t\tcase \"cs8\":\n88\t\t\tval = unix.CS8\n89\t\tdefault:\n90\t\t\treturn false\n91\t\t}\n92\t\tt.Cflag = (t.Cflag &^ unix.CSIZE) | val\n93\t\treturn true\n94\t}\n95\t\n96\tfunc restoreFromSave(t *unix.Termios, s string) error {\n97\t\tparts := strings.Split(s, \":\")\n98\t\texpected := 4 + len(t.Cc) + 2\n99\t\tif len(parts) != expected {\n100\t\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n101\t\t}\n102\t\tvals, err := parseHexFields(parts)\n103\t\tif err != nil {\n104\t\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n105\t\t}\n106\t\tt.Iflag = vals[0]\n107\t\tt.Oflag = vals[1]\n108\t\tt.Cflag = vals[2]\n109\t\tt.Lflag = vals[3]\n110\t\tfor i := range t.Cc {\n111\t\t\tt.Cc[i] = uint8(vals[4+i])\n112\t\t}\n113\t\tt.Ispeed = vals[4+len(t.Cc)]\n114\t\tt.Ospeed = vals[4+len(t.Cc)+1]\n115\t\treturn nil\n116\t}\n117\t\n118\tfunc parseHexFields(parts []string) ([]uint64, error) {\n119\t\tvals := make([]uint64, len(parts))\n120\t\tfor i, p := range parts {\n121\t\t\tv, err := strconv.ParseUint(p, 16, 64)\n122\t\t\tif err != nil {\n123\t\t\t\treturn nil, err\n124\t\t\t}\n125\t\t\tvals[i] = v\n126\t\t}\n127\t\treturn vals, nil\n128\t}\n129\t"}]},"parent_tool_use_id":null,"session_id":"7416e55a-ea12-4a32-bcdc-63cfe8e27186","uuid":"cc025eac-e009-4c66-9bf5-0b456448dc24","timestamp":"2026-05-29T15:50:26.430Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5645/cmd/stty/settings.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"fmt\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"golang.org/x/sys/unix\"\n)\n\nfunc applySettings(fd int, t *unix.Termios, settings []string) error {\n\tfor _, s := range settings {\n\t\tif err := applySetting(t, s); err != nil {\n\t\t\treturn err\n\t\t}\n\t}\n\treturn unix.IoctlSetTermios(fd, unix.TIOCSETA, t)\n}\n\nfunc applySetting(t *unix.Termios, s string) error {\n\tif strings.Contains(s, \":\") {\n\t\treturn restoreFromSave(t, s)\n\t}\n\tnegate := strings.HasPrefix(s, \"-\")\n\tname := s\n\tif negate {\n\t\tname = s[1:]\n\t}\n\tif applyFlag(t, name, negate) {\n\t\treturn nil\n\t}\n\tif !negate && applyCSize(t, name) {\n\t\treturn nil\n\t}\n\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n}\n\nfunc applyFlag(t *unix.Termios, name string, negate bool) bool {\n\tif f, ok := findFlag(name, iflags); ok {\n\t\ttoggleBit(&t.Iflag, f.mask, !negate)\n\t\treturn true\n\t}\n\tif f, ok := findFlag(name, oflags); ok {\n\t\ttoggleBit(&t.Oflag, f.mask, !negate)\n\t\treturn true\n\t}\n\tif f, ok := findFlag(name, cflags); ok {\n\t\ttoggleBit(&t.Cflag, f.mask, !negate)\n\t\treturn true\n\t}\n\tif f, ok := findFlag(name, lflags); ok {\n\t\ttoggleBit(&t.Lflag, f.mask, !negate)\n\t\treturn true\n\t}\n\treturn false\n}\n\nfunc findFlag(name string, flags []flagDef) (flagDef, bool) {\n\tfor _, f := range flags {\n\t\tif f.name == name {\n\t\t\treturn f, true\n\t\t}\n\t}\n\treturn flagDef{}, false\n}\n\nfunc toggleBit(field *uint64, mask uint64, set bool) {\n\tif set {\n\t\t*field |= mask\n\t} else {\n\t\t*field &^= mask\n\t}\n}\n\nfunc applyCSize(t *unix.Termios, name string) bool {\n\tvar val uint64\n\tswitch name {\n\tcase \"cs5\":\n\t\tval = unix.CS5\n\tcase \"cs6\":\n\t\tval = unix.CS6\n\tcase \"cs7\":\n\t\tval = unix.CS7\n\tcase \"cs8\":\n\t\tval = unix.CS8\n\tdefault:\n\t\treturn false\n\t}\n\tt.Cflag = (t.Cflag &^ unix.CSIZE) | val\n\treturn true\n}\n\nfunc restoreFromSave(t *unix.Termios, s string) error {\n\tparts := strings.Split(s, \":\")\n\texpected := 4 + len(t.Cc) + 2\n\tif len(parts) != expected {\n\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n\t}\n\tvals, err := parseHexFields(parts)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid argument '%s'\", s)\n\t}\n\tt.Iflag = vals[0]\n\tt.Oflag = vals[1]\n\tt.Cflag = vals[2]\n\tt.Lflag = vals[3]\n\tfor i := range t.Cc {\n\t\tt.Cc[i] = uint8(vals[4+i])\n\t}\n\tt.Ispeed = vals[4+len(t.Cc)]\n\tt.Ospeed = vals[4+len(t.Cc)+1]\n\treturn nil\n}\n\nfunc parseHexFields(parts []string) ([]uint64, error) {\n\tvals := make([]uint64, len(parts))\n\tfor i, p := range parts {\n\t\tv, err := strconv.ParseUint(p, 16, 64)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tvals[i] = v\n\t}\n\treturn vals, nil\n}\n","numLines":129,"startLine":1,"totalLines":129}}}
