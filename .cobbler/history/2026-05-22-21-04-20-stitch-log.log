\t\t}\n\t\ti += parseShortFlags(arg[1:], &opts)\n\t}\n\treturn opts, files\n}\n\nfunc parseLongFlag(arg string, opts *options) (bool, int) {\n\tif !strings.HasPrefix(arg, \"--\") {\n\t\treturn false, 0\n\t}\n\tswitch arg {\n\tcase \"--binary\":\n\t\topts.binary = true\n\tcase \"--text\":\n\t\topts.binary = false\n\tcase \"--tag\":\n\t\topts.tag = true\n\tcase \"--check\":\n\t\topts.check = true\n\tcase \"--warn\":\n\t\topts.warn = true\n\tcase \"--quiet\":\n\t\topts.quiet = true\n\tcase \"--status\":\n\t\topts.status = true\n\tdefault:\n\t\treturn false, 0\n\t}\n\treturn true, 1\n}\n\nfunc parseShortFlags(flags string, opts *options) int {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase 'b':\n\t\t\topts.binary = true\n\t\tcase 't':\n\t\t\topts.binary = false\n\t\tcase 'c':\n\t\t\topts.check = true\n\t\tcase 'w':\n\t\t\topts.warn = true\n\t\t}\n\t}\n\treturn 1\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":144,"cache_read_input_tokens":25822,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":144},"output_tokens":53,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"755e3b4f-9ced-4d7f-9b76-d48c4292b13d","uuid":"50bf77cb-4e7b-4eb8-89a5-82eaac17b494"}
