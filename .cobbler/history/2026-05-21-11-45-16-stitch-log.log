c cutChars(r io.Reader, w *bufio.Writer, opts options) {\n206\t\tranges, err := parseRangeList(opts.charList)\n207\t\tif err != nil {\n208\t\t\tfmt.Fprintf(os.Stderr, \"cut: %s\\n\", err)\n209\t\t\treturn\n210\t\t}\n211\t\tif opts.complement {\n212\t\t\tranges = complementRanges(ranges)\n213\t\t}\n214\t\tprocessLines(r, w, ranges)\n215\t}\n216\t\n217\tfunc processLines(r io.Reader, w *bufio.Writer, ranges [][2]int) {\n218\t\tbr := bufio.NewReader(r)\n219\t\tfor {\n220\t\t\tline, err := br.ReadBytes('\\n')\n221\t\t\tif len(line) > 0 && line[len(line)-1] == '\\n' {\n222\t\t\t\tline = line[:len(line)-1]\n223\t\t\t}\n224\t\t\tif len(line) > 0 {\n225\t\t\t\twriteSelectedBytes(w, line, ranges)\n226\t\t\t}\n227\t\t\tif err == nil || len(line) > 0 {\n228\t\t\t\tw.WriteByte('\\n')\n229\t\t\t}\n230\t\t\tif err != nil {\n231\t\t\t\tbreak\n232\t\t\t}\n233\t\t}\n234\t}\n235\t\n236\tfunc writeSelectedBytes(w *bufio.Writer, line []byte, ranges [][2]int) {\n237\t\tlineLen := len(line)\n238\t\tfor _, rng := range ranges {\n239\t\t\tlo := rng[0] - 1\n240\t\t\thi := rng[1]\n241\t\t\tif lo >= lineLen {\n242\t\t\t\tcontinue\n243\t\t\t}\n244\t\t\tif hi > lineLen {\n245\t\t\t\thi = lineLen\n246\t\t\t}\n247\t\t\tw.Write(line[lo:hi])\n248\t\t}\n249\t}\n250\t\n251\tfunc parseRangeList(list string) ([][2]int, error) {\n252\t\tparts := strings.Split(list, \",\")\n253\t\tvar ranges [][2]int\n254\t\tfor _, p := range parts {\n255\t\t\tr, err := parseRange(p)\n256\t\t\tif err != nil {\n257\t\t\t\treturn nil, err\n258\t\t\t}\n259\t\t\tranges = append(ranges, r)\n260\t\t}\n261\t\treturn mergeRanges(ranges), nil\n262\t}\n263\t\n264\tfunc parseRange(s string) ([2]int, error) {\n265\t\tif s == \"\" {\n266\t\t\treturn [2]int{}, fmt.Errorf(\"invalid range\")\n267\t\t}\n268\t\tidx := strings.Index(s, \"-\")\n269\t\tif idx < 0 {\n270\t\t\tn, err := strconv.Atoi(s)\n271\t\t\tif err != nil || n <= 0 {\n272\t\t\t\treturn [2]int{}, fmt.Errorf(\"invalid byte/character position '%s'\", s)\n273\t\t\t}\n274\t\t\t