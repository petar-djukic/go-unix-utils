{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0114SuXiq8BUTEAW7FMh9oeK","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"math\"\n10\t\t\"os\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: seq [OPTION]... LAST\n18\t  or:  seq [OPTION]... FIRST LAST\n19\t  or:  seq [OPTION]... FIRST INCREMENT LAST\n20\tPrint numbers from FIRST to LAST, in steps of INCREMENT.\n21\t\n22\tMandatory arguments to long options are mandatory for short options too.\n23\t  -f, --format=FORMAT      use printf style floating-point FORMAT\n24\t  -s, --separator=STRING   use STRING to separate numbers (default: \\n)\n25\t  -w, --equal-width        equalize width by padding with leading zeroes\n26\t      --help        display this help and exit\n27\t      --version     output version information and exit\n28\t`\n29\t\n30\tconst versionText = `seq (go-unix-utils) dev\n31\t`\n32\t\n33\ttype options struct {\n34\t\tformat     string\n35\t\tseparator  string\n36\t\tequalWidth bool\n37\t}\n38\t\n39\tfunc main() {\n40\t\tsys.InstallSIGPIPEHandler()\n41\t\topts, operands, err := parseArgs(os.Args[1:])\n42\t\tif err != nil {\n43\t\t\texitWithError(err.Error())\n44\t\t}\n45\t\tfirst, incr, last, err := parseOperands(operands)\n46\t\tif err != nil {\n47\t\t\texitWithError(err.Error())\n48\t\t}\n49\t\tif incr == 0 {\n50\t\t\tstepStr := \"0\"\n51\t\t\tif len(operands) == 3 {\n52\t\t\t\tstepStr = operands[1]\n53\t\t\t}\n54\t\t\texitWithError(fmt.Sprintf(\"invalid Zero increment value: '%s'\", stepStr))\n55\t\t}\n56\t\tif opts.format != \"\" {\n57\t\t\tif opts.equalWidth {\n58\t\t\t\texitWithError(\"format string may not be specified when printing equal width strings\")\n59\t\t\t}\n60\t\t\tif err := validateFormat(opts.format); err != nil {\n61\t\t\t\tfmt.Fprintf(os.Stderr, \"seq: %s\\n\", err.Error())\n62\t\t\t\tos.Exit(1)\n63\t\t\t}\n64\t\t}\n65\t\tprintSequence(opts, first, incr, last, operands)\n66\t}\n67\t\n68\tfunc exitWithError(msg string) {\n69\t\tfmt.Fprintf(os.Stderr, \"seq: %s\\n\", msg)\n70\t\tfmt.Fprintf(os.Stderr, \"Try 'seq --help' for more information.\\n\")\n71\t\tos.Exit(1)\n72\t}\n73\t\n74\tfunc parseArgs(args []string) (options, []string, error) {\n75\t\topts := options{separator: \"\\n\"}\n76\t\tvar operands []string\n77\t\ti := 0\n78\t\tfor i < len(args) {\n79\t\t\targ := args[i]\n80\t\t\tif arg == \"--\" {\n81\t\t\t\toperands = append(operands, args[i+1:]...)\n82\t\t\t\tbreak\n83\t\t\t}\n84\t\t\tif strings.HasPrefix(arg, \"--\") {\n85\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n86\t\t\t\tif err != nil {\n87\t\t\t\t\treturn opts, nil, err\n88\t\t\t\t}\n89\t\t\t\ti += n\n90\t\t\t\tcontinue\n91\t\t\t}\n92\t\t\tif len(arg) > 1 && arg[0] == '-' && !isNumStart(arg) {\n93\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n94\t\t\t\tif err != nil {\n95\t\t\t\t\treturn opts, nil, err\n96\t\t\t\t}\n97\t\t\t\ti += 1 + n\n98\t\t\t\tcontinue\n99\t\t\t}\n100\t\t\toperands = append(operands, arg)\n101\t\t\ti++\n102\t\t}\n103\t\tif len(operands) == 0 {\n104\t\t\treturn opts, nil, fmt.Errorf(\"missing operand\")\n105\t\t}\n106\t\tif len(operands) > 3 {\n107\t\t\treturn opts, nil, fmt.Errorf(\"extra operand '%s'\", operands[3])\n108\t\t}\n109\t\treturn opts, operands, nil\n110\t}\n111\t\n112\tfunc isNumStart(s string) bool {\n113\t\tif len(s) < 2 {\n114\t\t\treturn false\n115\t\t}\n116\t\tc := s[1]\n117\t\treturn c == '.' || (c >= '0' && c <= '9')\n118\t}\n119\t\n120\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n121\t\tswitch {\n122\t\tcase flag == \"--help\":\n123\t\t\tfmt.Fprint(os.Stdout, helpText)\n124\t\t\tos.Exit(0)\n125\t\t\treturn 0, nil\n126\t\tcase flag == \"--version\":\n127\t\t\tfmt.Fprint(os.Stdout, versionText)\n128\t\t\tos.Exit(0)\n129\t\t\treturn 0, nil\n130\t\tcase flag == \"--format\":\n131\t\t\tif len(remaining) < 2 {\n132\t\t\t\treturn 0, fmt.Errorf(\"option '--format' requires an argument\")\n133\t\t\t}\n134\t\t\topts.format = remaining[1]\n135\t\t\treturn 2, nil\n136\t\tcase strings.HasPrefix(flag, \"--format=\"):\n137\t\t\topts.format = flag[len(\"--format=\"):]\n138\t\t\treturn 1, nil\n139\t\tcase flag == \"--separator\":\n140\t\t\tif len(remaining) < 2 {\n141\t\t\t\treturn 0, fmt.Errorf(\"option '--separator' requires an argument\")\n142\t\t\t}\n143\t\t\topts.separator = remaining[1]\n144\t\t\treturn 2, nil\n145\t\tcase strings.HasPrefix(flag, \"--separator=\"):\n146\t\t\topts.separator = flag[len(\"--separator=\"):]\n147\t\t\treturn 1, nil\n148\t\tcase flag == \"--equal-width\":\n149\t\t\topts.equalWidth = true\n150\t\t\treturn 1, nil\n151\t\tdefault:\n152\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n153\t\t}\n154\t}\n155\t\n156\tfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n157\t\tconsumed := 0\n158\t\tfor j := 0; j < len(flags); j++ {\n159\t\t\tswitch flags[j] {\n160\t\t\tcase 'f':\n161\t\t\t\tvar val string\n162\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n163\t\t\t\t\tval = rest\n164\t\t\t\t} else if len(remaining) > consumed {\n165\t\t\t\t\tval = remaining[consumed]\n166\t\t\t\t\tconsumed++\n167\t\t\t\t} else {\n168\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'f'\")\n169\t\t\t\t}\n170\t\t\t\topts.format = val\n171\t\t\t\treturn consumed, nil\n172\t\t\tcase 's':\n173\t\t\t\tvar val string\n174\t\t\t\tif rest := flags[j+1:]; rest != \"\" {\n175\t\t\t\t\tval = rest\n176\t\t\t\t} else if len(remaining) > consumed {\n177\t\t\t\t\tval = remaining[consumed]\n178\t\t\t\t\tconsumed++\n179\t\t\t\t} else {\n180\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n181\t\t\t\t}\n182\t\t\t\topts.separator = val\n183\t\t\t\treturn consumed, nil\n184\t\t\tcase 'w':\n185\t\t\t\topts.equalWidth = true\n186\t\t\tdefault:\n187\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n188\t\t\t}\n189\t\t}\n190\t\treturn consumed, nil\n191\t}\n192\t\n193\tfunc parseOperands(args []string) (first, incr, last float64, err error) {\n194\t\tswitch len(args) {\n195\t\tcase 1:\n196\t\t\tlast, err = parseNumber(args[0])\n197\t\t\tif err != nil {\n198\t\t\t\treturn 0, 0, 0, err\n199\t\t\t}\n200\t\t\treturn 1, 1, last, nil\n201\t\tcase 2:\n202\t\t\tfirst, err = parseNumber(args[0])\n203\t\t\tif err != nil {\n204\t\t\t\treturn 0, 0, 0, err\n205\t\t\t}\n206\t\t\tlast, err = parseNumber(args[1])\n207\t\t\tif err != nil {\n208\t\t\t\treturn 0, 0, 0, err\n209\t\t\t}\n210\t\t\treturn first, 1, last, nil\n211\t\tdefault:\n212\t\t\tfirst, err = parseNumber(args[0])\n213\t\t\tif err != nil {\n214\t\t\t\treturn 0, 0, 0, err\n215\t\t\t}\n216\t\t\tincr, err = parseNumber(args[1])\n217\t\t\tif err != nil {\n218\t\t\t\treturn 0, 0, 0, err\n219\t\t\t}\n220\t\t\tlast, err = parseNumber(args[2])\n221\t\t\tif err != nil {\n222\t\t\t\treturn 0, 0, 0, err\n223\t\t\t}\n224\t\t\treturn first, incr, last, nil\n225\t\t}\n226\t}\n227\t\n228\tfunc parseNumber(s string) (float64, error) {\n229\t\tn, err := strconv.ParseFloat(s, 64)\n230\t\tif err != nil {\n231\t\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n232\t\t}\n233\t\tif math.IsNaN(n) {\n234\t\t\treturn 0, fmt.Errorf(\"invalid 'not-a-number' argument: '%s'\", s)\n235\t\t}\n236\t\tif math.IsInf(n, 0) {\n237\t\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n238\t\t}\n239\t\treturn n, nil\n240\t}\n241\t\n242\tfunc validateFormat(format string) error {\n243\t\tcount := 0\n244\t\ti := 0\n245\t\tfor i < len(format) {\n246\t\t\tif format[i] != '%' {\n247\t\t\t\ti++\n248\t\t\t\tcontinue\n249\t\t\t}\n250\t\t\ti++\n251\t\t\tif i >= len(format) {\n252\t\t\t\tbreak\n253\t\t\t}\n254\t\t\tif format[i] == '%' {\n255\t\t\t\ti++\n256\t\t\t\tcontinue\n257\t\t\t}\n258\t\t\tconv, next, err := scanConversion(format, i)\n259\t\t\tif err != nil {\n260\t\t\t\treturn err\n261\t\t\t}\n262\t\t\ti = next\n263\t\t\tif strings.ContainsRune(\"aefgAEFG\", rune(conv)) {\n264\t\t\t\tcount++\n265\t\t\t} else {\n266\t\t\t\treturn fmt.Errorf(\"format '%s' has unknown %%%c directive\", format, conv)\n267\t\t\t}\n268\t\t}\n269\t\tif count == 0 {\n270\t\t\treturn fmt.Errorf(\"format '%s' has no %% directive\", format)\n271\t\t}\n272\t\tif count > 1 {\n273\t\t\treturn fmt.Errorf(\"format '%s' has too many %% directives\", format)\n274\t\t}\n275\t\treturn nil\n276\t}\n277\t\n278\tfunc scanConversion(format string, i int) (byte, int, error) {\n279\t\tfor i < len(format) && strings.ContainsRune(\"-+#0 '\", rune(format[i])) {\n280\t\t\ti++\n281\t\t}\n282\t\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n283\t\t\ti++\n284\t\t}\n285\t\tif i < len(format) && format[i] == '.' {\n286\t\t\ti++\n287\t\t\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n288\t\t\t\ti++\n289\t\t\t}\n290\t\t}\n291\t\tif i >= len(format) {\n292\t\t\treturn 0, i, fmt.Errorf(\"format '%s' has no %% directive\", format)\n293\t\t}\n294\t\tconv := format[i]\n295\t\treturn conv, i + 1, nil\n296\t}\n297\t\n298\tfunc printSequence(opts options, first, incr, last float64, rawArgs []string) {\n299\t\tw := bufio.NewWriter(os.Stdout)\n300\t\tdefer w.Flush()\n301\t\tformat := opts.format\n302\t\tif format == \"\" {\n303\t\t\tformat = defaultFormat(rawArgs)\n304\t\t\tif opts.equalWidth {\n305\t\t\t\tformat = equalWidthFormat(format, first, last)\n306\t\t\t}\n307\t\t}\n308\t\tstarted := false\n309\t\tfor i := 0; ; i++ {\n310\t\t\tval := first + float64(i)*incr\n311\t\t\tif !inRange(val, incr, last) {\n312\t\t\t\tbreak\n313\t\t\t}\n314\t\t\tif started {\n315\t\t\t\tfmt.Fprint(w, opts.separator)\n316\t\t\t}\n317\t\t\tfmt.Fprintf(w, format, val)\n318\t\t\tstarted = true\n319\t\t}\n320\t\tif started {\n321\t\t\tfmt.Fprintln(w)\n322\t\t}\n323\t}\n324\t\n325\tfunc equalWidthFormat(defFmt string, first, last float64) string {\n326\t\tw1 := len(fmt.Sprintf(defFmt, first))\n327\t\tw2 := len(fmt.Sprintf(defFmt, last))\n328\t\tmaxW := max(w1, w2)\n329\t\tprec := 0\n330\t\tif dot := strings.IndexByte(defFmt, '.'); dot >= 0 {\n331\t\t\tprec, _ = strconv.Atoi(defFmt[dot+1 : len(defFmt)-1])\n332\t\t}\n333\t\tif prec == 0 {\n334\t\t\treturn \"%0\" + strconv.Itoa(maxW) + \".0f\"\n335\t\t}\n336\t\treturn \"%0\" + strconv.Itoa(maxW) + \".\" + strconv.Itoa(prec) + \"f\"\n337\t}\n338\t\n339\tfunc inRange(val, incr, last float64) bool {\n340\t\tif incr >= 0 {\n341\t\t\treturn val <= last\n342\t\t}\n343\t\treturn val >= last\n344\t}\n345\t\n346\tfunc defaultFormat(rawArgs []string) string {\n347\t\tmaxPrec := 0\n348\t\tfor _, arg := range rawArgs {\n349\t\t\tp := argPrecision(arg)\n350\t\t\tif p > maxPrec {\n351\t\t\t\tmaxPrec = p\n352\t\t\t}\n353\t\t}\n354\t\tif maxPrec == 0 {\n355\t\t\treturn \"%.0f\"\n356\t\t}\n357\t\treturn \"%.\" + strconv.Itoa(maxPrec) + \"f\"\n358\t}\n359\t\n360\tfunc argPrecision(s string) int {\n361\t\tif len(s) > 0 && (s[0] == '-' || s[0] == '+') {\n362\t\t\ts = s[1:]\n363\t\t}\n364\t\tdot := strings.IndexByte(s, '.')\n365\t\tif dot < 0 {\n366\t\t\treturn 0\n367\t\t}\n368\t\treturn len(s) - dot - 1\n369\t}\n370\t"}]},"parent_tool_use_id":null,"session_id":"b75f48fa-b318-4f07-9709-f5ff65656f95","uuid":"c8c3a485-f3c4-499f-84ee-4efb7bd3e85a","timestamp":"2026-05-14T13:46:21.219Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5175/cmd/seq/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"math\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: seq [OPTION]... LAST\n  or:  seq [OPTION]... FIRST LAST\n  or:  seq [OPTION]... FIRST INCREMENT LAST\nPrint numbers from FIRST to LAST, in steps of INCREMENT.\n\nMandatory arguments to long options are mandatory for short options too.\n  -f, --format=FORMAT      use printf style floating-point FORMAT\n  -s, --separator=STRING   use STRING to separate numbers (default: \\n)\n  -w, --equal-width        equalize width by padding with leading zeroes\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `seq (go-unix-utils) dev\n`\n\ntype options struct {\n\tformat     string\n\tseparator  string\n\tequalWidth bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, operands, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\texitWithError(err.Error())\n\t}\n\tfirst, incr, last, err := parseOperands(operands)\n\tif err != nil {\n\t\texitWithError(err.Error())\n\t}\n\tif incr == 0 {\n\t\tstepStr := \"0\"\n\t\tif len(operands) == 3 {\n\t\t\tstepStr = operands[1]\n\t\t}\n\t\texitWithError(fmt.Sprintf(\"invalid Zero increment value: '%s'\", stepStr))\n\t}\n\tif opts.format != \"\" {\n\t\tif opts.equalWidth {\n\t\t\texitWithError(\"format string may not be specified when printing equal width strings\")\n\t\t}\n\t\tif err := validateFormat(opts.format); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"seq: %s\\n\", err.Error())\n\t\t\tos.Exit(1)\n\t\t}\n\t}\n\tprintSequence(opts, first, incr, last, operands)\n}\n\nfunc exitWithError(msg string) {\n\tfmt.Fprintf(os.Stderr, \"seq: %s\\n\", msg)\n\tfmt.Fprintf(os.Stderr, \"Try 'seq --help' for more information.\\n\")\n\tos.Exit(1)\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\topts := options{separator: \"\\n\"}\n\tvar operands []string\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\toperands = append(operands, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' && !isNumStart(arg) {\n\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + n\n\t\t\tcontinue\n\t\t}\n\t\toperands = append(operands, arg)\n\t\ti++\n\t}\n\tif len(operands) == 0 {\n\t\treturn opts, nil, fmt.Errorf(\"missing operand\")\n\t}\n\tif len(operands) > 3 {\n\t\treturn opts, nil, fmt.Errorf(\"extra operand '%s'\", operands[3])\n\t}\n\treturn opts, operands, nil\n}\n\nfunc isNumStart(s string) bool {\n\tif len(s) < 2 {\n\t\treturn false\n\t}\n\tc := s[1]\n\treturn c == '.' || (c >= '0' && c <= '9')\n}\n\nfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n\tswitch {\n\tcase flag == \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\t\treturn 0, nil\n\tcase flag == \"--format\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--format' requires an argument\")\n\t\t}\n\t\topts.format = remaining[1]\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--format=\"):\n\t\topts.format = flag[len(\"--format=\"):]\n\t\treturn 1, nil\n\tcase flag == \"--separator\":\n\t\tif len(remaining) < 2 {\n\t\t\treturn 0, fmt.Errorf(\"option '--separator' requires an argument\")\n\t\t}\n\t\topts.separator = remaining[1]\n\t\treturn 2, nil\n\tcase strings.HasPrefix(flag, \"--separator=\"):\n\t\topts.separator = flag[len(\"--separator=\"):]\n\t\treturn 1, nil\n\tcase flag == \"--equal-width\":\n\t\topts.equalWidth = true\n\t\treturn 1, nil\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n}\n\nfunc parseShortFlags(flags string, remaining []string, opts *options) (int, error) {\n\tconsumed := 0\n\tfor j := 0; j < len(flags); j++ {\n\t\tswitch flags[j] {\n\t\tcase 'f':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'f'\")\n\t\t\t}\n\t\t\topts.format = val\n\t\t\treturn consumed, nil\n\t\tcase 's':\n\t\t\tvar val string\n\t\t\tif rest := flags[j+1:]; rest != \"\" {\n\t\t\t\tval = rest\n\t\t\t} else if len(remaining) > consumed {\n\t\t\t\tval = remaining[consumed]\n\t\t\t\tconsumed++\n\t\t\t} else {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 's'\")\n\t\t\t}\n\t\t\topts.separator = val\n\t\t\treturn consumed, nil\n\t\tcase 'w':\n\t\t\topts.equalWidth = true\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[j])\n\t\t}\n\t}\n\treturn consumed, nil\n}\n\nfunc parseOperands(args []string) (first, incr, last float64, err error) {\n\tswitch len(args) {\n\tcase 1:\n\t\tlast, err = parseNumber(args[0])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\treturn 1, 1, last, nil\n\tcase 2:\n\t\tfirst, err = parseNumber(args[0])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\tlast, err = parseNumber(args[1])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\treturn first, 1, last, nil\n\tdefault:\n\t\tfirst, err = parseNumber(args[0])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\tincr, err = parseNumber(args[1])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\tlast, err = parseNumber(args[2])\n\t\tif err != nil {\n\t\t\treturn 0, 0, 0, err\n\t\t}\n\t\treturn first, incr, last, nil\n\t}\n}\n\nfunc parseNumber(s string) (float64, error) {\n\tn, err := strconv.ParseFloat(s, 64)\n\tif err != nil {\n\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n\t}\n\tif math.IsNaN(n) {\n\t\treturn 0, fmt.Errorf(\"invalid 'not-a-number' argument: '%s'\", s)\n\t}\n\tif math.IsInf(n, 0) {\n\t\treturn 0, fmt.Errorf(\"invalid floating point argument: '%s'\", s)\n\t}\n\treturn n, nil\n}\n\nfunc validateFormat(format string) error {\n\tcount := 0\n\ti := 0\n\tfor i < len(format) {\n\t\tif format[i] != '%' {\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\ti++\n\t\tif i >= len(format) {\n\t\t\tbreak\n\t\t}\n\t\tif format[i] == '%' {\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tconv, next, err := scanConversion(format, i)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\ti = next\n\t\tif strings.ContainsRune(\"aefgAEFG\", rune(conv)) {\n\t\t\tcount++\n\t\t} else {\n\t\t\treturn fmt.Errorf(\"format '%s' has unknown %%%c directive\", format, conv)\n\t\t}\n\t}\n\tif count == 0 {\n\t\treturn fmt.Errorf(\"format '%s' has no %% directive\", format)\n\t}\n\tif count > 1 {\n\t\treturn fmt.Errorf(\"format '%s' has too many %% directives\", format)\n\t}\n\treturn nil\n}\n\nfunc scanConversion(format string, i int) (byte, int, error) {\n\tfor i < len(format) && strings.ContainsRune(\"-+#0 '\", rune(format[i])) {\n\t\ti++\n\t}\n\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n\t\ti++\n\t}\n\tif i < len(format) && format[i] == '.' {\n\t\ti++\n\t\tfor i < len(format) && format[i] >= '0' && format[i] <= '9' {\n\t\t\ti++\n\t\t}\n\t}\n\tif i >= len(format) {\n\t\treturn 0, i, fmt.Errorf(\"format '%s' has no %% directive\", format)\n\t}\n\tconv := format[i]\n\treturn conv, i + 1, nil\n}\n\nfunc printSequence(opts options, first, incr, last float64, rawArgs []string) {\n\tw := bufio.NewWriter(os.Stdout)\n\tdefer w.Flush()\n\tformat := opts.format\n\tif format == \"\" {\n\t\tformat = defaultFormat(rawArgs)\n\t\tif opts.equalWidth {\n\t\t\tformat = equalWidthFormat(format, first, last)\n\t\t}\n\t}\n\tstarted := false\n\tfor i := 0; ; i++ {\n\t\tval := first + float64(i)*incr\n\t\tif !inRange(val, incr, last) {\n\t\t\tbreak\n\t\t}\n\t\tif started {\n\t\t\tfmt.Fprint(w, opts.separator)\n\t\t}\n\t\tfmt.Fprintf(w, format, val)\n\t\tstarted = true\n\t}\n\tif started {\n\t\tfmt.Fprintln(w)\n\t}\n}\n\nfunc equalWidthFormat(defFmt string, first, last float64) string {\n\tw1 := len(fmt.Sprintf(defFmt, first))\n\tw2 := len(fmt.Sprintf(defFmt, last))\n\tmaxW := max(w1, w2)\n\tprec := 0\n\tif dot := strings.IndexByte(defFmt, '.'); dot >= 0 {\n\t\tprec, _ = strconv.Atoi(defFmt[dot+1 : len(defFmt)-1])\n\t}\n\tif prec == 0 {\n\t\treturn \"%0\" + strconv.Itoa(maxW) + \".0f\"\n\t}\n\treturn \"%0\" + strconv.Itoa(maxW) + \".\" + strconv.Itoa(prec) + \"f\"\n}\n\nfunc inRange(val, incr, last float64) bool {\n\tif incr >= 0 {\n\t\treturn val <= last\n\t}\n\treturn val >= last\n}\n\nfunc defaultFormat(rawArgs []string) string {\n\tmaxPrec := 0\n\tfor _, arg := range rawArgs {\n\t\tp := argPrecision(arg)\n\t\tif p > maxPrec {\n\t\t\tmaxPrec = p\n\t\t}\n\t}\n\tif maxPrec == 0 {\n\t\treturn \"%.0f\"\n\t}\n\treturn \"%.\" + strconv.Itoa(maxPrec) + \"f\"\n}\n\nfunc argPrecision(s string) int {\n\tif len(s) > 0 && (s[0] == '-' || s[0] == '+') {\n\t\ts = s[1:]\n\t}\n\tdot := strings.IndexByte(s, '.')\n\tif dot < 0 {\n\t\treturn 0\n\t}\n\treturn len(s) - dot - 1\n}\n","numLines":370,"startLine":1,"totalLines":370}}}
