54\t\t}\n155\t\treturn b.String()\n156\t}\n157\t\n158\tfunc printColumns(names []string, width int) {\n159\t\tn := len(names)\n160\t\tif n == 0 {\n161\t\t\treturn\n162\t\t}\n163\t\tlens := make([]int, n)\n164\t\tfor i, name := range names {\n165\t\t\tlens[i] = len(name)\n166\t\t}\n167\t\tncols, nrows := computeLayout(lens, width)\n168\t\tcolWidths := make([]int, ncols)\n169\t\tfor col := range ncols {\n170\t\t\tfor row := range nrows {\n171\t\t\t\tidx := col*nrows + row\n172\t\t\t\tif idx < n && lens[idx] > colWidths[col] {\n173\t\t\t\t\tcolWidths[col] = lens[idx]\n174\t\t\t\t}\n175\t\t\t}\n176\t\t}\n177\t\tfor row := range nrows {\n178\t\t\tfor col := range ncols {\n179\t\t\t\tidx := col*nrows + row\n180\t\t\t\tif idx >= n {\n181\t\t\t\t\tbreak\n182\t\t\t\t}\n183\t\t\t\tif col > 0 {\n184\t\t\t\t\tfmt.Print(\"  \")\n185\t\t\t\t}\n186\t\t\t\tfmt.Print(names[idx])\n187\t\t\t\tnextIdx := (col+1)*nrows + row\n188\t\t\t\tif col+1 < ncols && nextIdx < n {\n189\t\t\t\t\tpad := colWidths[col] - lens[idx]\n190\t\t\t\t\tif pad > 0 {\n191\t\t\t\t\t\tfmt.Print(strings.Repeat(\" \", pad))\n192\t\t\t\t\t}\n193\t\t\t\t}\n194\t\t\t}\n195\t\t\tfmt.Println()\n196\t\t}\n197\t}\n198\t\n199\tfunc computeLayout(lens []int, width int) (int, int) {\n200\t\tn := len(lens)\n201\t\tif n == 0 {\n202\t\t\treturn 0, 0\n203\t\t}\n204\t\tmaxCols := min(n, width)\n205\t\tfor nc := maxCols; nc >= 2; nc-- {\n206\t\t\tnr := (n + nc - 1) / nc\n207\t\t\ttotal := 0\n208\t\t\tfits := true\n209\t\t\tfor col := range nc {\n210\t\t\t\tcolMax := 0\n211\t\t\t\tfor row := range nr {\n212\t\t\t\t\tidx := col*nr + row\n213\t\t\t\t\tif idx < n && lens[idx] > colMax {\n214\t\t\t\t\t\tcolMax = lens[idx]\n215\t\t\t\t\t}\n216\t\t\t\t}\n217\t\t\t\ttotal += colMax\n218\t\t\t\tif col < nc-1 {\n219\t\t\t\t\ttotal += 2\n220\t\t\t\t}\n221\t\t\t\tif total > width {\n222\t\t\t\t\tfits = false\n223\t\t\t\t\tbreak\n224\t\t\t\t}\n225\t\t\t}\n226\t\t\tif fits {\n227\t\t\t\treturn nc, nr\n228\t\t\t}\n229\t\t}\n230\t\treturn 1, n\n