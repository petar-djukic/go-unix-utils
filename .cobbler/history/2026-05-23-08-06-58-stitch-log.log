{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PKmn6Qzco5GkpBKJiYfgeG","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bytes\"\n8\t\t\"context\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"testing\"\n14\t\t\"time\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n17\t)\n18\t\n19\tfunc TestDiff(t *testing.T) {\n20\t\tgoBin := testutils.BuildBinary(t, \".\")\n21\t\trefBin, err := exec.LookPath(\"gbase32\")\n22\t\tif err != nil {\n23\t\t\tt.Skip(\"reference binary not found\")\n24\t\t}\n25\t\n26\t\ttmpDir := t.TempDir()\n27\t\thelloFile := filepath.Join(tmpDir, \"hello.txt\")\n28\t\twriteFile(t, helloFile, \"hello\\n\")\n29\t\temptyFile := filepath.Join(tmpDir, \"empty.txt\")\n30\t\twriteFile(t, emptyFile, \"\")\n31\t\tbinaryFile := filepath.Join(tmpDir, \"binary.dat\")\n32\t\twriteFile(t, binaryFile, \"\\x00\\x01\\x02\\xff\\xfe\")\n33\t\n34\t\tdiscardStderr := testutils.NormalizeFunc(func([]byte) []byte { return nil })\n35\t\n36\t\ttests := []testutils.DiffTest{\n37\t\t\t// R1.1: encode stdin\n38\t\t\t{\n39\t\t\t\tName:  \"encode-stdin\",\n40\t\t\t\tStdin: []byte(\"hello\\n\"),\n41\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n42\t\t\t},\n43\t\t\t// R1.1: encode stdin with explicit dash\n44\t\t\t{\n45\t\t\t\tName:  \"encode-stdin-dash\",\n46\t\t\t\tArgs:  []string{\"-\"},\n47\t\t\t\tStdin: []byte(\"hello\\n\"),\n48\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n49\t\t\t},\n50\t\t\t// R1.1: encode file\n51\t\t\t{\n52\t\t\t\tName: \"encode-file\",\n53\t\t\t\tArgs: []string{helloFile},\n54\t\t\t\tEnv:  []string{\"LC_ALL=C\"},\n55\t\t\t},\n56\t\t\t// R1.1: encode empty file\n57\t\t\t{\n58\t\t\t\tName: \"encode-empty\",\n59\t\t\t\tArgs: []string{emptyFile},\n60\t\t\t\tEnv:  []string{\"LC_ALL=C\"},\n61\t\t\t},\n62\t\t\t// R1.1: encode binary data\n63\t\t\t{\n64\t\t\t\tName: \"encode-binary\",\n65\t\t\t\tArgs: []string{binaryFile},\n66\t\t\t\tEnv:  []string{\"LC_ALL=C\"},\n67\t\t\t},\n68\t\t\t// R1.2: default wrapping at 76 columns\n69\t\t\t{\n70\t\t\t\tName:  \"encode-default-wrap\",\n71\t\t\t\tStdin: []byte(\"The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog.\"),\n72\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n73\t\t\t},\n74\t\t\t// R1.3: wrap at specific column\n75\t\t\t{\n76\t\t\t\tName:  \"wrap-40\",\n77\t\t\t\tArgs:  []string{\"-w\", \"40\"},\n78\t\t\t\tStdin: []byte(\"The quick brown fox jumps over the lazy dog.\"),\n79\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n80\t\t\t},\n81\t\t\t// R1.3: wrap=0 disables wrapping\n82\t\t\t{\n83\t\t\t\tName:  \"wrap-0\",\n84\t\t\t\tArgs:  []string{\"-w\", \"0\"},\n85\t\t\t\tStdin: []byte(\"The quick brown fox jumps over the lazy dog.\"),\n86\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n87\t\t\t},\n88\t\t\t// R1.3: --wrap=COLS long form\n89\t\t\t{\n90\t\t\t\tName:  \"wrap-long-form\",\n91\t\t\t\tArgs:  []string{\"--wrap=20\"},\n92\t\t\t\tStdin: []byte(\"hello world\"),\n93\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n94\t\t\t},\n95\t\t\t// R1.4: missing file exits 1\n96\t\t\t{\n97\t\t\t\tName:      \"missing-file\",\n98\t\t\t\tArgs:      []string{filepath.Join(tmpDir, \"nonexistent.txt\")},\n99\t\t\t\tExitCode:  1,\n100\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n101\t\t\t\tEnv:       []string{\"LC_ALL=C\"},\n102\t\t\t},\n103\t\t\t// R2.1: decode stdin\n104\t\t\t{\n105\t\t\t\tName:  \"decode-stdin\",\n106\t\t\t\tArgs:  []string{\"-d\"},\n107\t\t\t\tStdin: []byte(\"NBSWY3DPEB3W64TMMQ======\\n\"),\n108\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n109\t\t\t},\n110\t\t\t// R2.1: decode with --decode\n111\t\t\t{\n112\t\t\t\tName:  \"decode-long-flag\",\n113\t\t\t\tArgs:  []string{\"--decode\"},\n114\t\t\t\tStdin: []byte(\"NBSWY3DPEB3W64TMMQ======\\n\"),\n115\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n116\t\t\t},\n117\t\t\t// R2.2: decode ignores whitespace\n118\t\t\t{\n119\t\t\t\tName:  \"decode-ignores-whitespace\",\n120\t\t\t\tArgs:  []string{\"-d\"},\n121\t\t\t\tStdin: []byte(\"NBSWY3DP\\nEB3W64TM\\nMQ======\\n\"),\n122\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n123\t\t\t},\n124\t\t\t// R2.3: decode with --ignore-garbage\n125\t\t\t{\n126\t\t\t\tName:  \"decode-ignore-garbage\",\n127\t\t\t\tArgs:  []string{\"-d\", \"-i\"},\n128\t\t\t\tStdin: []byte(\"NBSWY3DP!!!EB3W64TMMQ======\\n\"),\n129\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n130\t\t\t},\n131\t\t\t// R2.3: decode --ignore-garbage long form\n132\t\t\t{\n133\t\t\t\tName:  \"decode-ignore-garbage-long\",\n134\t\t\t\tArgs:  []string{\"--decode\", \"--ignore-garbage\"},\n135\t\t\t\tStdin: []byte(\"NBS!!WY3DP\\n\"),\n136\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n137\t\t\t},\n138\t\t\t// R2.4: invalid base32 input exits 1\n139\t\t\t{\n140\t\t\t\tName:      \"decode-invalid-input\",\n141\t\t\t\tArgs:      []string{\"-d\"},\n142\t\t\t\tStdin:     []byte(\"!!!invalid!!!\\n\"),\n143\t\t\t\tExitCode:  1,\n144\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n145\t\t\t\tEnv:       []string{\"LC_ALL=C\"},\n146\t\t\t},\n147\t\t\t// R3.1: exit 0 on success\n148\t\t\t{\n149\t\t\t\tName:  \"exit-0-encode\",\n150\t\t\t\tStdin: []byte(\"test\"),\n151\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n152\t\t\t},\n153\t\t\t// R3.1: exit 0 on decode success\n154\t\t\t{\n155\t\t\t\tName:  \"exit-0-decode\",\n156\t\t\t\tArgs:  []string{\"-d\"},\n157\t\t\t\tStdin: []byte(\"ORSXG5A=\\n\"),\n158\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n159\t\t\t},\n160\t\t\t// R3.2: exit 1 on error\n161\t\t\t{\n162\t\t\t\tName:      \"exit-1-bad-file\",\n163\t\t\t\tArgs:      []string{filepath.Join(tmpDir, \"does-not-exist\")},\n164\t\t\t\tExitCode:  1,\n165\t\t\t\tNormalize: []testutils.NormalizeFunc{discardStderr},\n166\t\t\t\tEnv:       []string{\"LC_ALL=C\"},\n167\t\t\t},\n168\t\t\t// Encode roundtrip\n169\t\t\t{\n170\t\t\t\tName:  \"encode-empty-stdin\",\n171\t\t\t\tStdin: []byte(\"\"),\n172\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n173\t\t\t},\n174\t\t\t// Short flag -w with attached value\n175\t\t\t{\n176\t\t\t\tName:  \"short-w-attached\",\n177\t\t\t\tArgs:  []string{\"-w0\"},\n178\t\t\t\tStdin: []byte(\"hello\"),\n179\t\t\t\tEnv:   []string{\"LC_ALL=C\"},\n180\t\t\t},\n181\t\t}\n182\t\n183\t\ttestutils.RunDiffTests(t, goBin, refBin, tests)\n184\t}\n185\t\n186\tfunc TestSIGPIPE(t *testing.T) {\n187\t\tgoBin := testutils.BuildBinary(t, \".\")\n188\t\tdir := t.TempDir()\n189\t\tlargePath := filepath.Join(dir, \"large.dat\")\n190\t\tif err := os.WriteFile(largePath, bytes.Repeat([]byte(\"x\"), 100000), 0o644); err != nil {\n191\t\t\tt.Fatal(err)\n192\t\t}\n193\t\ttestSIGPIPE(t, goBin, largePath)\n194\t}\n195\t\n196\tfunc testSIGPIPE(t *testing.T, bin, filePath string) {\n197\t\tt.Helper()\n198\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n199\t\tdefer cancel()\n200\t\tcmd := exec.CommandContext(ctx, bin, filePath)\n201\t\tstdout, err := cmd.StdoutPipe()\n202\t\tif err != nil {\n203\t\t\tt.Fatal(err)\n204\t\t}\n205\t\tif err := cmd.Start(); err != nil {\n206\t\t\tt.Fatal(err)\n207\t\t}\n208\t\tbuf := make([]byte, 1)\n209\t\tif _, err := io.ReadFull(stdout, buf); err != nil {\n210\t\t\tt.Fatal(err)\n211\t\t}\n212\t\tstdout.Close()\n213\t\tif err := cmd.Wait(); err != nil {\n214\t\t\tif ctx.Err() == context.DeadlineExceeded {\n215\t\t\t\tt.Fatalf(\"%s timed out; SIGPIPE handler may not be installed\", bin)\n216\t\t\t}\n217\t\t\tt.Fatalf(\"%s: expected exit 0 on SIGPIPE, got: %v\", bin, err)\n218\t\t}\n219\t}\n220\t\n221\tfunc writeFile(t *testing.T, path, content string) {\n222\t\tt.Helper()\n223\t\tif err := os.WriteFile(path, []byte(content), 0o644); err != nil {\n224\t\t\tt.Fatal(err)\n225\t\t}\n226\t}\n227\t\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01FKqQrx9Zo76yS81gBqKPDK","session_id":"9ca46135-07ce-4634-a0ce-ceebccbc4e98","uuid":"3d0dc79e-0c8f-4425-9e77-a539986c751d","timestamp":"2026-05-23T12:08:43.178Z"}
