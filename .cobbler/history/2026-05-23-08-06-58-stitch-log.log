{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011Vo9g1fvQq1RX5PKQ8nhkL","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"encoding/base32\"\n8\t\t\"encoding/base64\"\n9\t\t\"encoding/hex\"\n10\t\t\"errors\"\n11\t\t\"fmt\"\n12\t\t\"os\"\n13\t\t\"strconv\"\n14\t\t\"strings\"\n15\t\t\"syscall\"\n16\t\n17\t\t\"github.com/petar-djukic/go-unix-utils/pkg/encutil\"\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n19\t)\n20\t\n21\tconst z85Alphabet = \"0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{}@%$#\"\n22\t\n23\tvar z85Decode [256]byte\n24\t\n25\tfunc init() {\n26\t\tfor i := range z85Decode {\n27\t\t\tz85Decode[i] = 0xFF\n28\t\t}\n29\t\tfor i := range len(z85Alphabet) {\n30\t\t\tz85Decode[z85Alphabet[i]] = byte(i)\n31\t\t}\n32\t}\n33\t\n34\tvar encodingFlags = map[string]string{\n35\t\t\"--base64\":    \"base64\",\n36\t\t\"--base64url\": \"base64url\",\n37\t\t\"--base32\":    \"base32\",\n38\t\t\"--base32hex\": \"base32hex\",\n39\t\t\"--base16\":    \"base16\",\n40\t\t\"--z85\":       \"z85\",\n41\t}\n42\t\n43\ttype options struct {\n44\t\tencoding      string\n45\t\tdecode        bool\n46\t\tignoreGarbage bool\n47\t\twrap          int\n48\t}\n49\t\n50\tfunc main() {\n51\t\tsys.InstallSIGPIPEHandler()\n52\t\topts, file := parseArgs(os.Args[1:])\n53\t\n54\t\tif opts.encoding == \"\" {\n55\t\t\tfmt.Fprintf(os.Stderr, \"basenc: missing encoding type\\n\")\n56\t\t\tos.Exit(1)\n57\t\t}\n58\t\n59\t\trc, err := encutil.OpenInput(file)\n60\t\tif err != nil {\n61\t\t\tfmt.Fprintf(os.Stderr, \"basenc: %s: %s\\n\", file, err.Error())\n62\t\t\tos.Exit(1)\n63\t\t}\n64\t\tdefer rc.Close()\n65\t\n66\t\tif opts.decode {\n67\t\t\terr = encutil.Decode(rc, os.Stdout, encutil.DecoderConfig{\n68\t\t\t\tDecode:        decoderFor(opts.encoding),\n69\t\t\t\tIgnoreGarbage: opts.ignoreGarbage,\n70\t\t\t})\n71\t\t} else {\n72\t\t\terr = encutil.Encode(rc, os.Stdout, encutil.EncoderConfig{\n73\t\t\t\tEncode:  encoderFor(opts.encoding),\n74\t\t\t\tWrapCol: opts.wrap,\n75\t\t\t})\n76\t\t}\n77\t\tif err != nil {\n78\t\t\tif errors.Is(err, syscall.EPIPE) {\n79\t\t\t\tos.Exit(0)\n80\t\t\t}\n81\t\t\tfmt.Fprintf(os.Stderr, \"basenc: %s\\n\", err.Error())\n82\t\t\tos.Exit(1)\n83\t\t}\n84\t}\n85\t\n86\tfunc encoderFor(encoding string) func([]byte) string {\n87\t\tswitch encoding {\n88\t\tcase \"base64\":\n89\t\t\treturn func(d []byte) string { return base64.StdEncoding.EncodeToString(d) }\n90\t\tcase \"base64url\":\n91\t\t\treturn func(d []byte) string { return base64.URLEncoding.EncodeToString(d) }\n92\t\tcase \"base32\":\n93\t\t\treturn func(d []byte) string { return base32.StdEncoding.EncodeToString(d) }\n94\t\tcase \"base32hex\":\n95\t\t\treturn func(d []byte) string { return base32.HexEncoding.EncodeToString(d) }\n96\t\tcase \"base16\":\n97\t\t\treturn func(d []byte) string { return strings.ToUpper(hex.EncodeToString(d)) }\n98\t\tdefault:\n99\t\t\treturn encodeZ85\n100\t\t}\n101\t}\n102\t\n103\tfunc decoderFor(encoding string) func(string) ([]byte, error) {\n104\t\tswitch encoding {\n105\t\tcase \"base64\":\n106\t\t\treturn base64.StdEncoding.DecodeString\n107\t\tcase \"base64url\":\n108\t\t\treturn base64.URLEncoding.DecodeString\n109\t\tcase \"base32\":\n110\t\t\treturn base32.StdEncoding.DecodeString\n111\t\tcase \"base32hex\":\n112\t\t\treturn base32.HexEncoding.DecodeString\n113\t\tcase \"base16\":\n114\t\t\treturn hex.DecodeString\n115\t\tdefault:\n116\t\t\treturn decodeZ85\n117\t\t}\n118\t}\n119\t\n120\tfunc encodeZ85(data []byte) string {\n121\t\tif len(data)%4 != 0 {\n122\t\t\tfmt.Fprintf(os.Stderr, \"basenc: invalid input (length must be multiple of 4)\\n\")\n123\t\t\tos.Exit(1)\n124\t\t}\n125\t\tvar buf strings.Builder\n126\t\tbuf.Grow(len(data) * 5 / 4)\n127\t\tvar chars [5]byte\n128\t\tfor i := 0; i < len(data); i += 4 {\n129\t\t\tval := uint32(data[i])<<24 | uint32(data[i+1])<<16 | uint32(data[i+2])<<8 | uint32(data[i+3])\n130\t\t\tfor j := 4; j >= 0; j-- {\n131\t\t\t\tchars[j] = z85Alphabet[val%85]\n132\t\t\t\tval /= 85\n133\t\t\t}\n134\t\t\tbuf.Write(chars[:])\n135\t\t}\n136\t\treturn buf.String()\n137\t}\n138\t\n139\tfunc decodeZ85(s string) ([]byte, error) {\n140\t\tif len(s)%5 != 0 {\n141\t\t\treturn nil, fmt.Errorf(\"invalid input\")\n142\t\t}\n143\t\tout := make([]byte, len(s)*4/5)\n144\t\tfor i := 0; i < len(s); i += 5 {\n145\t\t\tvar val uint32\n146\t\t\tfor j := range 5 {\n147\t\t\t\tv := z85Decode[s[i+j]]\n148\t\t\t\tif v == 0xFF {\n149\t\t\t\t\treturn nil, fmt.Errorf(\"invalid input\")\n150\t\t\t\t}\n151\t\t\t\tval = val*85 + uint32(v)\n152\t\t\t}\n153\t\t\tk := i / 5 * 4\n154\t\t\tout[k] = byte(val >> 24)\n155\t\t\tout[k+1] = byte(val >> 16)\n156\t\t\tout[k+2] = byte(val >> 8)\n157\t\t\tout[k+3] = byte(val)\n158\t\t}\n159\t\treturn out, nil\n160\t}\n161\t\n162\tfunc parseArgs(args []string) (options, string) {\n163\t\topts := options{wrap: 76}\n164\t\tvar file string\n165\t\ti := 0\n166\t\tfor i < len(args) {\n167\t\t\targ := args[i]\n168\t\t\tif arg == \"--\" {\n169\t\t\t\tif i+1 < len(args) {\n170\t\t\t\t\tfile = args[i+1]\n171\t\t\t\t}\n172\t\t\t\tbreak\n173\t\t\t}\n174\t\t\tif handled, advance := parseLongFlag(args[i:], &opts); handled {\n175\t\t\t\ti += advance\n176\t\t\t\tcontinue\n177\t\t\t}\n178\t\t\tif arg == \"-\" || !strings.HasPrefix(arg, \"-\") {\n179\t\t\t\tfile = arg\n180\t\t\t\ti++\n181\t\t\t\tcontinue\n182\t\t\t}\n183\t\t\ti += parseShortFlags(args[i:], &opts)\n184\t\t}\n185\t\treturn opts, file\n186\t}\n187\t\n188\tfunc parseLongFlag(remaining []string, opts *options) (bool, int) {\n189\t\targ := remaining[0]\n190\t\tif !strings.HasPrefix(arg, \"--\") {\n191\t\t\treturn false, 0\n192\t\t}\n193\t\tif arg == \"--wrap\" || strings.HasPrefix(arg, \"--wrap=\") {\n194\t\t\treturn parseWrapFlag(remaining, opts)\n195\t\t}\n196\t\tif enc, ok := encodingFlags[arg]; ok {\n197\t\t\tif opts.encoding