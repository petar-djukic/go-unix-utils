{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013x9zGHvJzSZeHMXg4Ljhzd","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\t\"syscall\"\n12\t\n13\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sizeparse\"\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: truncate OPTION... FILE...\n18\tShrink or extend the size of each FILE to the specified size\n19\t\n20\tA FILE argument that does not exist is created.\n21\t\n22\tIf a FILE is larger than the specified size, the extra data is lost.\n23\tIf a FILE is shorter, it is extended and the sparse extended part (hole)\n24\treads as zero bytes.\n25\t\n26\tMandatory arguments to long options are mandatory for short options too.\n27\t  -c, --no-create        do not create any files\n28\t  -o, --io-blocks        treat SIZE as number of IO blocks instead of bytes\n29\t  -r, --reference=RFILE  base size on RFILE\n30\t  -s, --size=SIZE        set or adjust the file size by SIZE bytes\n31\t      --help     display this help and exit\n32\t      --version  output version information and exit\n33\t\n34\tThe SIZE argument is an integer and optional unit (example: 10K is 10*1024).\n35\tUnits are K,M,G,T,P,E,Z,Y,R,Q (powers of 1024) or KB,MB,... (powers of 1000).\n36\tBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\n37\t\n38\tSIZE may also be prefixed by one of the following modifying characters:\n39\t'+' extend by, '-' reduce by, '<' at most, '>' at least,\n40\t'/' round down to multiple of, '%' round up to multiple of.\n41\t`\n42\t\n43\tconst versionText = `truncate (go-unix-utils) dev\n44\t`\n45\t\n46\ttype options struct {\n47\t\tnoCreate  bool\n48\t\tioBlocks  bool\n49\t\treference string\n50\t\tsizeStr   string\n51\t\tsizeSet   bool\n52\t}\n53\t\n54\tfunc main() {\n55\t\tsys.InstallSIGPIPEHandler()\n56\t\topts, files, err := parseArgs(os.Args[1:])\n57\t\tif err != nil {\n58\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n59\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n60\t\t\tos.Exit(1)\n61\t\t}\n62\t\tif !opts.sizeSet && opts.reference == \"\" {\n63\t\t\tfmt.Fprintf(os.Stderr, \"truncate: you must specify either '--size' or '--reference'\\n\")\n64\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n65\t\t\tos.Exit(1)\n66\t\t}\n67\t\tif len(files) == 0 {\n68\t\t\tfmt.Fprintf(os.Stderr, \"truncate: missing file operand\\n\")\n69\t\t\tfmt.Fprintf(os.Stderr, \"Try 'truncate --help' for more information.\\n\")\n70\t\t\tos.Exit(1)\n71\t\t}\n72\t\tos.Exit(run(opts, files))\n73\t}\n74\t\n75\tfunc run(opts options, files []string) int {\n76\t\tvar baseSize int64\n77\t\tif opts.reference != \"\" {\n78\t\t\tfi, err := os.Stat(opts.reference)\n79\t\t\tif err != nil {\n80\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: cannot stat %s: %s\\n\",\n81\t\t\t\t\tquote(opts.reference), errMsg(err))\n82\t\t\t\treturn 1\n83\t\t\t}\n84\t\t\tbaseSize = fi.Size()\n85\t\t}\n86\t\n87\t\tvar modifier byte\n88\t\tvar sizeVal int64\n89\t\tif opts.sizeSet {\n90\t\t\tvar err error\n91\t\t\tmodifier, sizeVal, err = parseSize(opts.sizeStr)\n92\t\t\tif err != nil {\n93\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n94\t\t\t\treturn 1\n95\t\t\t}\n96\t\t\tif opts.ioBlocks {\n97\t\t\t\tsizeVal *= ioBlockSize(files[0])\n98\t\t\t}\n99\t\t}\n100\t\n101\t\texitCode := 0\n102\t\tfor _, path := range files {\n103\t\t\tif err := truncateFile(opts, path, baseSize, modifier, sizeVal); err != nil {\n104\t\t\t\tfmt.Fprintf(os.Stderr, \"truncate: %s\\n\", err)\n105\t\t\t\texitCode = 1\n106\t\t\t}\n107\t\t}\n108\t\treturn exitCode\n109\t}\n110\t\n111\tfunc truncateFile(opts options, path string, baseSize int64, modifier byte, sizeVal int64) error {\n112\t\tfi, err := ensureFile(opts, path)\n113\t\tif err != nil {\n114\t\t\treturn err\n115\t\t}\n116\t\tif fi == nil {\n117\t\t\treturn nil\n118\t\t}\n119\t\tnewSize, err := computeSize(opts, fi.Size(), baseSize, modifier, sizeVal)\n120\t\tif err != nil {\n121\t\t\treturn err\n122\t\t}\n123\t\tif err := os.Truncate(path, newSize); err != nil {\n124\t\t\treturn fmt.Errorf(\"cannot open %s for writing: %s\",\n125\t\t\t\tquote(path), errMsg(err))\n126\t\t}\n127\t\treturn nil\n128\t}\n129\t\n130\tfunc ensureFile(opts options, path string) (os.FileInfo, error) {\n131\t\tfi, err := os.Stat(path)\n132\t\tif err != nil && os.IsNotExist(err) {\n133\t\t\tif opts.noCreate {\n134\t\t\t\treturn nil, nil\n135\t\t\t}\n136\t\t\tf, createErr := os.Create(path)\n137\t\t\tif createErr != nil {\n138\t\t\t\treturn nil, fmt.Errorf(\"cannot open %s for writing: %s\",\n139\t\t\t\t\tquote(path), errMsg(createErr))\n140\t\t\t}\n141\t\t\tf.Close()\n142\t\t\tfi, err = os.Stat(path)\n143\t\t}\n144\t\tif err != nil {\n145\t\t\treturn nil, fmt.Errorf(\"cannot open %s for writing: %s\",\n146\t\t\t\tquote(path), errMsg(err))\n147\t\t}\n148\t\treturn fi, nil\n149\t}\n150\t\n151\tfunc computeSize(opts options, currentSize, baseSize int64, modifier byte, sizeVal int64) (int64, error) {\n152\t\tif opts.reference != \"\" && !opts.sizeSet {\n153\t\t\treturn baseSize, nil\n154\t\t}\n155\t\tbase := baseSize\n156\t\tif opts.reference == \"\" {\n157\t\t\tbase = currentSize\n158\t\t}\n159\t\tresult, err := applySize(base, modifier, sizeVal)\n160\t\tif err != nil {\n161\t\t\treturn 0, err\n162\t\t}\n163\t\tif result < 0 {\n164\t\t\treturn 0, nil\n165\t\t}\n166\t\treturn result, nil\n167\t}\n168\t\n169\tfunc applySize(current int64, modifier byte, size int64) (int64, error) {\n170\t\tswitch modifier {\n171\t\tcase 0:\n172\t\t\treturn size, nil\n173\t\tcase '+':\n174\t\t\treturn current + size, nil\n175\t\tcase '-':\n176\t\t\treturn current - size, nil\n177\t\tcase '<':\n178\t\t\tif current < size {\n179\t\t\t\treturn current, nil\n180\t\t\t}\n181\t\t\treturn size, nil\n182\t\tcase '>':\n183\t\t\tif current > size {\n184\t\t\t\treturn current, nil\n185\t\t\t}\n186\t\t\treturn size, nil\n187\t\tcase '/':\n188\t\t\tif size == 0 {\n189\t\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n190\t\t\t}\n191\t\t\treturn (current / size) * size, nil\n192\t\tcase '%':\n193\t\t\tif size == 0 {\n194\t\t\t\treturn 0, fmt.Errorf(\"division by zero\")\n195\t\t\t}\n196\t\t\treturn ((current + size - 1) / size) * size, nil\n197\t\t}\n198\t\treturn size, nil\n199\t}\n200\t\n201\tfunc parseSize(s string) (byte, int64, error) {\n202\t\tif s == \"\" {\n203\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n204\t\t}\n205\t\tvar modifier byte\n206\t\trest := s\n207\t\tif len(rest) > 0 {\n208\t\t\tswitch rest[0] {\n209\t\t\tcase '+', '-', '<', '>', '/', '%':\n210\t\t\t\tmodifier = rest[0]\n211\t\t\t\trest = rest[1:]\n212\t\t\t}\n213\t\t}\n214\t\tif rest == \"\" {\n215\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n216\t\t}\n217\t\tval, err := sizeparse.Parse(rest)\n218\t\tif err != nil {\n219\t\t\treturn 0, 0, fmt.Errorf(\"Invalid number: %s\", quote(s))\n220\t\t}\n221\t\treturn modifier, val, nil\n222\t}\n223\t\n224\tfunc parseArgs(args []string) (options, []string, error) {\n225\t\tvar opts options\n226\t\tvar files []string\n227\t\tendFlags := false\n228\t\tfor i := 0; i < len(args); i++ {\n229\t\t\targ := args[i]\n230\t\t\tif endFlags || !strings.HasPrefix(arg, \"-\") {\n231\t\t\t\tfiles = append(files, arg)\n232\t\t\t\tcontinue\n233\t\t\t}\n234\t\t\tif arg == \"--\" {\n235\t\t\t\tendFlags = true\n236\t\t\t\tcontinue\n237\t\t\t}\n238\t\t\tif strings.HasPrefix(arg, \"--\") {\n239\t\t\t\tadv, err := parseLongFlag(arg, args[i+1:], &opts)\n240\t\t\t\tif err != nil {\n241\t\t\t\t\treturn options{}, nil, err\n242\t\t\t\t}\n243\t\t\t\ti += adv\n244\t\t\t\tcontinue\n245\t\t\t}\n246\t\t\tadv, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n247\t\t\tif err != nil {\n248\t\t\t\treturn options{}, nil, err\n249\t\t\t