\n\t\tt.Fatal(err)\n\t}\n\tbuf := make([]byte, 1)\n\tif _, err := io.ReadFull(stdout, buf); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstdout.Close()\n\terr = cmd.Wait()\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatal(\"comm timed out; SIGPIPE handler may not be installed\")\n\t}\n\tif err != nil {\n\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n\t}\n}\n\nfunc writeFile(t *testing.T, dir, name, content string) {\n\tt.Helper()\n\tif err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0644); err != nil {\n\t\tt.Fatal(err)\n\t}\n}\n```\n\n**Key Features:**\n- Uses `testutils.BuildBinary(t, \".\")` (lines 39, 369)\n- Uses `testutils.RunDiffTests(t, goBin, refBin, tests)` (line 365)\n- Sets `Env: []string{\"LC_ALL=C\"}` throughout test cases (line 69 sets env variable, used in tests)\n- Demonstrates Normalize field usage with custom normalization functions\n\nNote: While this file doesn't explicitly show ExitCode field usage, another excellent example is `/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5379/cmd/fold/fold_test.go` which contains explicit ExitCode testing (lines 349, 357, 365 with `ExitCode: 1`)."}],"totalDurationMs":51558,"totalTokens":40279,"totalToolUseCount":12,"usage":{"input_tokens":5,"cache_creation_input_tokens":5006,"cache_read_input_tokens":30408,"output_tokens":4860,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":5006},"inference_geo":"","iterations":[{"input_tokens":5,"output_tokens":4860,"cache_read_input_tokens":30408,"cache_creation_input_tokens":5006,"cache_creation":{"ephemeral_5m_input_tokens":5006,"ephemeral_1h_input_tokens":0},"type":"message"}],"speed":"standard"},"toolStats":{"readCount":3,"searchCount":8,"bashCount":1,"editFileCount":0,"linesAdded":0,"linesRemoved":0,"otherToolCount":0}}}
