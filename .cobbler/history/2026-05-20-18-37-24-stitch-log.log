{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012WKWpqHeiGVT6BtS3VQfSE","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Package testutils provides the differential testing harness for go-unix-utils.\n5\t// It executes a Go binary and a GNU reference binary with identical inputs and\n6\t// compares stdout, stderr, and exit code.\n7\t// Implements srd001-testutils.\n8\tpackage testutils\n9\t\n10\timport (\n11\t\t\"bytes\"\n12\t\t\"context\"\n13\t\t\"errors\"\n14\t\t\"fmt\"\n15\t\t\"os\"\n16\t\t\"os/exec\"\n17\t\t\"path/filepath\"\n18\t\t\"regexp\"\n19\t\t\"strings\"\n20\t\t\"testing\"\n21\t\t\"time\"\n22\t)\n23\t\n24\tconst defaultTimeout = 10 * time.Second\n25\t\n26\t// NormalizeFunc transforms raw output bytes before comparison.\n27\t// R1.4: named type alias for normalization functions.\n28\ttype NormalizeFunc = func([]byte) []byte\n29\t\n30\t// DiffTest defines a single differential test case.\n31\t//\n32\t// R1.1: Name identifies the subtest (used with t.Run). Args holds command-line\n33\t// arguments passed to both binaries.\n34\t//\n35\t// R1.2: Stdin nil means both binaries receive EOF immediately. An empty non-nil\n36\t// slice ([]byte{}) also produces no bytes but represents an open stdin that is\n37\t// immediately closed. ExitCode defaults to 0 when left as the zero value.\n38\t//\n39\t// R1.3: Env nil means both binaries inherit the test process environment with\n40\t// LC_ALL=C applied as a default override. When non-nil, KEY=VALUE pairs are\n41\t// merged into the inherited environment: matching keys are overridden, new keys\n42\t// are added.\n43\t//\n44\t// R1.4: Normalize holds a slice of NormalizeFunc applied in order to stdout and\n45\t// stderr of both binaries before comparison. Nil or empty means no normalization.\n46\ttype DiffTest struct {\n47\t\tName          string\n48\t\tArgs          []string\n49\t\tStdin         []byte\n50\t\tEnv           []string\n51\t\tWorkDir       string\n52\t\tExitCode      int\n53\t\tNormalize     []NormalizeFunc\n54\t\tExpectedFiles map[string][]byte\n55\t}\n56\t\n57\tvar tsPatterns = []*regexp.Regexp{\n58\t\tregexp.MustCompile(`[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}`),\n59\t\tregexp.MustCompile(`\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}`),\n60\t\tregexp.MustCompile(`\\d{2}:\\d{2}:\\d{2}`),\n61\t}\n62\t\n63\t// TimestampNormalizer replaces common strftime timestamp patterns with a fixed\n64\t// placeholder string.\n65\t// R4.2: built-in normalizer for cmd/ts tests.\n66\tvar TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n67\t\tresult := b\n68\t\tfor _, pat := range tsPatterns {\n69\t\t\tresult = pat.ReplaceAll(result, []byte(\"<TIMESTAMP>\"))\n70\t\t}\n71\t\treturn result\n72\t}\n73\t\n74\ttype binaryResult struct {\n75\t\tstdout   []byte\n76\t\tstderr   []byte\n77\t\texitCode int\n78\t}\n79\t\n80\t// RunDiffTests runs each DiffTest as a named subtest, executing goBinary and\n81\t// refBinary with identical inputs and comparing their outputs.\n82\t// R2.1: accepts paths to Go and reference binaries plus test cases.\n83\tfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n84\t\tt.Helper()\n85\t\tfor _, tc := range tests {\n86\t\t\tt.Run(tc.Name, func(t *testing.T) {\n87\t\t\t\trunSubtest(t, goBinary, refBinary, tc)\n88\t\t\t})\n89\t\t}\n90\t}\n91\t\n92\tfunc runSubtest(t *testing.T, goBinary, refBinary string, tc DiffTest) {\n93\t\tt.Helper()\n94\t\tworkDir := tc.WorkDir\n95\t\tif workDir == \"\" {\n96\t\t\tworkDir = t.TempDir()\n97\t\t}\n98\t\tenv := buildEnv(tc.Env)\n99\t\tgoRes := runBinary(t, goBinary, tc.Args, tc.Stdin, env, workDir)\n100\t\trefRes := runBinary(t, refBinary, tc.Args, tc.Stdin, env, workDir)\n101\t\tgoRes = applyNormalizers(goRes, tc.Normalize)\n102\t\trefRes = applyNormalizers(refRes, tc.Normalize)\n103\t\tcompareOutputs(t, tc, goRes, refRes)\n104\t\tcheckExpectedFiles(t, workDir, tc.ExpectedFiles)\n105\t}\n106\t\n107\tfunc runBinary(\n108\t\tt *testing.T, binary string, args []string,\n109\t\tstdin []byte, env []string, workDir string,\n110\t) binaryResult {\n111\t\tt.Helper()\n112\t\tctx, cancel := context.WithTimeout(context.Background(), defaultTimeout)\n113\t\tdefer cancel()\n114\t\tcmd := exec.CommandContext(ctx, binary, args...)\n115\t\tcmd.Env = env\n116\t\tcmd.Dir = workDir\n117\t\tvar stdout, stderr bytes.Buffer\n118\t\tcmd.Stdout = &stdout\n119\t\tcmd.Stderr = &stderr\n120\t\tif stdin != nil {\n121\t\t\tcmd.Stdin = bytes.NewReader(stdin)\n122\t\t}\n123\t\terr := cmd.Run()\n124\t\tif ctx.Err() == context.DeadlineExceeded {\n125\t\t\tt.Fatalf(\"binary %s timed out after %v\", binary, defaultTimeout)\n126\t\t}\n127\t\treturn extractResult(t, binary, err, stdout.Bytes(), stderr.Bytes())\n128\t}\n129\t\n130\tfunc extractResult(\n131\t\tt *testing.T, binary string, err error,\n132\t\tstdout, stderr []byte,\n133\t) binaryResult {\n134\t\tt.Helper()\n135\t\tif err == nil {\n136\t\t\treturn binaryResult{stdout: stdout, stderr: stderr, exitCode: 0}\n137\t\t}\n138\t\tvar exitErr *exec.ExitError\n139\t\tif errors.As(err, &exitErr) {\n140\t\t\treturn binaryResult{\n141\t\t\t\tstdout:   stdout,\n142\t\t\t\tstderr:   stderr,\n143\t\t\t\texitCode: exitErr.ExitCode(),\n144\t\t\t}\n145\t\t}\n146\t\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n147\t\treturn binaryResult{}\n148\t}\n149\t\n150\tfunc buildEnv(testEnv []string) []string {\n151\t\tenvMap := make(map[string]string)\n152\t\tfor _, entry := range os.Environ() {\n153\t\t\tkey, val, _ := strings.Cut(entry, \"=\")\n154\t\t\tenvMap[key] = val\n155\t\t}\n156\t\tenvMap[\"LC_ALL\"] = \"C\"\n157\t\tfor _, entry := range testEnv {\n158\t\t\tkey, val, _ := strings.Cut(entry, \"=\")\n159\t\t\tenvMap[key] = val\n160\t\t}\n161\t\tresult := make([]string, 0, len(envMap))\n162\t\tfor k, v := range envMap {\n163\t\t\tresult = append(result, k+\"=\"+v)\n164\t\t}\n165\t\treturn result\n166\t}\n167\t\n168\tfunc applyNormalizers(res binaryResult, fns []NormalizeFunc) binaryResult {\n169\t\tfor _, fn := range fns {\n170\t\t\tres.stdout = fn(res.stdout)\n171\t\t\tres.stderr = fn(res.stderr)\n172\t\t}\n173\t\treturn res\n174\t}\n175\t\n176\tfunc compareOutputs(t *testing.T, tc DiffTest, goRes, refRes binaryResult) {\n177\t\tt.Helper()\n178\t\tstdoutMatch := bytes.Equal(goRes.stdout, refRes.stdout)\n179\t\tstderrMatch := bytes.Equal(goRes.stderr, refRes.stderr)\n180\t\texitMatch := goRes.exitCode == refRes.exitCode\n181\t\tif stdoutMatch && stderrMatch && exitMatch {\n182\t\t\treturn\n183\t\t}\n184\t\tt.Fatalf(\"%s\", formatDivergence(tc, goRes, refRes))\n185\t}\n186\t\n187\tfunc formatDivergence(tc DiffTest, goRes, refRes binaryResult) string {\n188\t\tvar b strings.Builder\n189\t\tfmt.Fprintf(&b, \"divergence detected\\n\")\n190\t\tfmt.Fprintf(&b, \"  args:        %v\\n\", tc.Args)\n191\t\tfmt.Fprintf(&b, \"  stdin:       %s\\n\", formatStdin(tc.Stdin))\n192\t\tfmt.Fprintf(&b, \"  ref stdout:  %q\\n\", refRes.stdout)\n193\t\tfmt.Fprintf(&b, \"  go  stdout:  %q\\n\", goRes.stdout)\n194\t\tfmt.Fprintf(&b, \"  ref stderr:  %q\\n\", refRes.stderr)\n195\t\tfmt.Fprintf(&b, \"  go  stderr:  %q\\n\", goRes.stderr)\n196\t\tfmt.Fprintf(&b, \"  ref exit:    %d\\n\", refRes.exitCode)\n197\t\tfmt.Fprintf(&b, \"  go  exit:    %d\\n\", goRes.exitCode)\n198\t\treturn b.String()\n199\t}\n200\t\n201\tfunc formatStdin(stdin []byte) string {\n202\t\tif stdin == nil {\n203\t\t\treturn \"<nil>\"\n204\t\t}\n205\t\tif len(stdin) > 256 {\n206\t\t\treturn fmt.Sprintf(\"%q... (truncated from %d bytes)\", stdin[:256], len(stdin))\n207\t\t}\n208\t\treturn fmt.Sprintf(\"%q\", stdin)\n209\t}\n210\t\n211\tfunc checkExpectedFiles(t *testing.T, workDir string, expected map[string][]byte) {\n212\t\tt.Helper()\n213\t\tif expected == nil {\n214\t\t\treturn\n215\t\t}\n216\t\tfor relPath, want := range expected {\n217\t\t\tfullPath := filepath.Join(workDir, relPath)\n218\t\t\tgot, err := os.ReadFile(fullPath)\n219\t\t\tif err != nil {\n220\t\t\t\tt.Fatalf(\"expected file %s: %v\", relPath, err)\n221\t\t\t}\n222\t\t\tif !bytes.Equal(got, want) {\n223\t\t\t\tt.Fatalf(\"file %s divergence\\n  expected: %q\\n  actual:   %q\",\n224\t\t\t\t\trelPath, want, got)\n225\t\t\t}\n226\t\t}\n227\t}\n228\t\n229\t// ComposeNormalizers returns a single NormalizeFunc that applies the given\n230\t// functions in order.\n231\t// R4.4: convenience for combining multiple normalizers.\n232\tfunc ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n233\t\treturn func(b []byte) []byte {\n234\t\t\tfor _, fn := range fns {\n235\t\t\t\tb = fn(b)\n236\t\t\t}\n237\t\t\treturn b\n238\t\t}\n239\t}\n240\t\n241\t"}]},"parent_tool_use_id":null,"session_id":"0b139998-cefb-41d3-bcee-99a798f067f0","uuid":"dbebcadd-21d4-4a80-8713-c29db2612190","timestamp":"2026-05-20T22:38:50.669Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5379/pkg/testutils/difftest.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Package testutils provides the differential testing harness for go-unix-utils.\n// It executes a Go binary and a GNU reference binary with identical inputs and\n// compares stdout, stderr, and exit code.\n// Implements srd001-testutils.\npackage testutils\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n)\n\nconst defaultTimeout = 10 * time.Second\n\n// NormalizeFunc transforms raw output bytes before comparison.\n// R1.4: named type alias for normalization functions.\ntype NormalizeFunc = func([]byte) []byte\n\n// DiffTest defines a single differential test case.\n//\n// R1.1: Name identifies the subtest (used with t.Run). Args holds command-line\n// arguments passed to both binaries.\n//\n// R1.2: Stdin nil means both binaries receive EOF immediately. An empty non-nil\n// slice ([]byte{}) also produces no bytes but represents an open stdin that is\n// immediately closed. ExitCode defaults to 0 when left as the zero value.\n//\n// R1.3: Env nil means both binaries inherit the test process environment with\n// LC_ALL=C applied as a default override. When non-nil, KEY=VALUE pairs are\n// merged into the inherited environment: matching keys are overridden, new keys\n// are added.\n//\n// R1.4: Normalize holds a slice of NormalizeFunc applied in order to stdout and\n// stderr of both binaries before comparison. Nil or empty means no normalization.\ntype DiffTest struct {\n\tName          string\n\tArgs          []string\n\tStdin         []byte\n\tEnv           []string\n\tWorkDir       string\n\tExitCode      int\n\tNormalize     []NormalizeFunc\n\tExpectedFiles map[string][]byte\n}\n\nvar tsPatterns = []*regexp.Regexp{\n\tregexp.MustCompile(`[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}`),\n\tregexp.MustCompile(`\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}`),\n\tregexp.MustCompile(`\\d{2}:\\d{2}:\\d{2}`),\n}\n\n// TimestampNormalizer replaces common strftime timestamp patterns with a fixed\n// placeholder string.\n// R4.2: built-in normalizer for cmd/ts tests.\nvar TimestampNormalizer NormalizeFunc = func(b []byte) []byte {\n\tresult := b\n\tfor _, pat := range tsPatterns {\n\t\tresult = pat.ReplaceAll(result, []byte(\"<TIMESTAMP>\"))\n\t}\n\treturn result\n}\n\ntype binaryResult struct {\n\tstdout   []byte\n\tstderr   []byte\n\texitCode int\n}\n\n// RunDiffTests runs each DiffTest as a named subtest, executing goBinary and\n// refBinary with identical inputs and comparing their outputs.\n// R2.1: accepts paths to Go and reference binaries plus test cases.\nfunc RunDiffTests(t *testing.T, goBinary, refBinary string, tests []DiffTest) {\n\tt.Helper()\n\tfor _, tc := range tests {\n\t\tt.Run(tc.Name, func(t *testing.T) {\n\t\t\trunSubtest(t, goBinary, refBinary, tc)\n\t\t})\n\t}\n}\n\nfunc runSubtest(t *testing.T, goBinary, refBinary string, tc DiffTest) {\n\tt.Helper()\n\tworkDir := tc.WorkDir\n\tif workDir == \"\" {\n\t\tworkDir = t.TempDir()\n\t}\n\tenv := buildEnv(tc.Env)\n\tgoRes := runBinary(t, goBinary, tc.Args, tc.Stdin, env, workDir)\n\trefRes := runBinary(t, refBinary, tc.Args, tc.Stdin, env, workDir)\n\tgoRes = applyNormalizers(goRes, tc.Normalize)\n\trefRes = applyNormalizers(refRes, tc.Normalize)\n\tcompareOutputs(t, tc, goRes, refRes)\n\tcheckExpectedFiles(t, workDir, tc.ExpectedFiles)\n}\n\nfunc runBinary(\n\tt *testing.T, binary string, args []string,\n\tstdin []byte, env []string, workDir string,\n) binaryResult {\n\tt.Helper()\n\tctx, cancel := context.WithTimeout(context.Background(), defaultTimeout)\n\tdefer cancel()\n\tcmd := exec.CommandContext(ctx, binary, args...)\n\tcmd.Env = env\n\tcmd.Dir = workDir\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\tif stdin != nil {\n\t\tcmd.Stdin = bytes.NewReader(stdin)\n\t}\n\terr := cmd.Run()\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatalf(\"binary %s timed out after %v\", binary, defaultTimeout)\n\t}\n\treturn extractResult(t, binary, err, stdout.Bytes(), stderr.Bytes())\n}\n\nfunc extractResult(\n\tt *testing.T, binary string, err error,\n\tstdout, stderr []byte,\n) binaryResult {\n\tt.Helper()\n\tif err == nil {\n\t\treturn binaryResult{stdout: stdout, stderr: stderr, exitCode: 0}\n\t}\n\tvar exitErr *exec.ExitError\n\tif errors.As(err, &exitErr) {\n\t\treturn binaryResult{\n\t\t\tstdout:   stdout,\n\t\t\tstderr:   stderr,\n\t\t\texitCode: exitErr.ExitCode(),\n\t\t}\n\t}\n\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n\treturn binaryResult{}\n}\n\nfunc buildEnv(testEnv []string) []string {\n\tenvMap := make(map[string]string)\n\tfor _, entry := range os.Environ() {\n\t\tkey, val, _ := strings.Cut(entry, \"=\")\n\t\tenvMap[key] = val\n\t}\n\tenvMap[\"LC_ALL\"] = \"C\"\n\tfor _, entry := range testEnv {\n\t\tkey, val, _ := strings.Cut(entry, \"=\")\n\t\tenvMap[key] = val\n\t}\n\tresult := make([]string, 0, len(envMap))\n\tfor k, v := range envMap {\n\t\tresult = append(result, k+\"=\"+v)\n\t}\n\treturn result\n}\n\nfunc applyNormalizers(res binaryResult, fns []NormalizeFunc) binaryResult {\n\tfor _, fn := range fns {\n\t\tres.stdout = fn(res.stdout)\n\t\tres.stderr = fn(res.stderr)\n\t}\n\treturn res\n}\n\nfunc compareOutputs(t *testing.T, tc DiffTest, goRes, refRes binaryResult) {\n\tt.Helper()\n\tstdoutMatch := bytes.Equal(goRes.stdout, refRes.stdout)\n\tstderrMatch := bytes.Equal(goRes.stderr, refRes.stderr)\n\texitMatch := goRes.exitCode == refRes.exitCode\n\tif stdoutMatch && stderrMatch && exitMatch {\n\t\treturn\n\t}\n\tt.Fatalf(\"%s\", formatDivergence(tc, goRes, refRes))\n}\n\nfunc formatDivergence(tc DiffTest, goRes, refRes binaryResult) string {\n\tvar b strings.Builder\n\tfmt.Fprintf(&b, \"divergence detected\\n\")\n\tfmt.Fprintf(&b, \"  args:        %v\\n\", tc.Args)\n\tfmt.Fprintf(&b, \"  stdin:       %s\\n\", formatStdin(tc.Stdin))\n\tfmt.Fprintf(&b, \"  ref stdout:  %q\\n\", refRes.stdout)\n\tfmt.Fprintf(&b, \"  go  stdout:  %q\\n\", goRes.stdout)\n\tfmt.Fprintf(&b, \"  ref stderr:  %q\\n\", refRes.stderr)\n\tfmt.Fprintf(&b, \"  go  stderr:  %q\\n\", goRes.stderr)\n\tfmt.Fprintf(&b, \"  ref exit:    %d\\n\", refRes.exitCode)\n\tfmt.Fprintf(&b, \"  go  exit:    %d\\n\", goRes.exitCode)\n\treturn b.String()\n}\n\nfunc formatStdin(stdin []byte) string {\n\tif stdin == nil {\n\t\treturn \"<nil>\"\n\t}\n\tif len(stdin) > 256 {\n\t\treturn fmt.Sprintf(\"%q... (truncated from %d bytes)\", stdin[:256], len(stdin))\n\t}\n\treturn fmt.Sprintf(\"%q\", stdin)\n}\n\nfunc checkExpectedFiles(t *testing.T, workDir string, expected map[string][]byte) {\n\tt.Helper()\n\tif expected == nil {\n\t\treturn\n\t}\n\tfor relPath, want := range expected {\n\t\tfullPath := filepath.Join(workDir, relPath)\n\t\tgot, err := os.ReadFile(fullPath)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"expected file %s: %v\", relPath, err)\n\t\t}\n\t\tif !bytes.Equal(got, want) {\n\t\t\tt.Fatalf(\"file %s divergence\\n  expected: %q\\n  actual:   %q\",\n\t\t\t\trelPath, want, got)\n\t\t}\n\t}\n}\n\n// ComposeNormalizers returns a single NormalizeFunc that applies the given\n// functions in order.\n// R4.4: convenience for combining multiple normalizers.\nfunc ComposeNormalizers(fns ...NormalizeFunc) NormalizeFunc {\n\treturn func(b []byte) []byte {\n\t\tfor _, fn := range fns {\n\t\t\tb = fn(b)\n\t\t}\n\t\treturn b\n\t}\n}\n\n","numLines":241,"startLine":1,"totalLines":241}}}
