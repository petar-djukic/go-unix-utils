asPrev = true\n\t}\n\treturn 0\n}\n\nfunc isDisorder(cmp func(string, string) int, prev, curr string, unique bool) bool {\n\tr := cmp(prev, curr)\n\treturn r > 0 || (unique && r == 0)\n}\n","structuredPatch":[{"oldStart":43,"oldLines":7,"newStart":43,"newLines":7,"lines":["     line := scanner.Text()","     if *hasPrev && isDisorder(cmp, *prev, line, opts.unique) {","       if opts.check == checkDiagnose {","-        fmt.Fprintf(os.Stderr, \"sort: %s: %d: disorder: %s\\n\",","+        fmt.Fprintf(os.Stderr, \"sort: %s:%d: disorder: %s\\n\",","           file, lineNum, line)","       }","       return 1"]}],"userModified":false,"replaceAll":false}}
