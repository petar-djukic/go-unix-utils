{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ELU7Kfie3CzQ1YWZQvBWpx","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"bufio\"\n8\t\t\"fmt\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"slices\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: sort [OPTION]... [FILE]...\n18\tWrite sorted concatenation of all FILE(s) to standard output.\n19\t\n20\tWith no FILE, or when FILE is -, read standard input.\n21\t\n22\tMandatory arguments to long options are mandatory for short options too.\n23\tOrdering options:\n24\t\n25\t  -b, --ignore-leading-blanks  ignore leading blanks\n26\t  -h, --human-numeric-sort     compare human readable numbers (e.g., 2K 1G)\n27\t  -M, --month-sort             compare (unknown) < 'JAN' < ... < 'DEC'\n28\t  -n, --numeric-sort           compare according to string numerical value\n29\t  -V, --version-sort           natural sort of (version) numbers within text\n30\t  -r, --reverse                reverse the result of comparisons\n31\t\n32\tOther options:\n33\t\n34\t  -k, --key=KEYDEF             sort via a key; KEYDEF gives location and type\n35\t  -o, --output=FILE            write result to FILE instead of standard output\n36\t  -s, --stable                 stabilize sort by disabling last-resort comparison\n37\t  -t, --field-separator=SEP    use SEP instead of non-blank to blank transition\n38\t  -u, --unique                 with -c, check for strict ordering;\n39\t                                 without -c, output only the first of an equal run\n40\t      --help        display this help and exit\n41\t      --version     output version information and exit\n42\t`\n43\t\n44\tconst versionText = `sort (go-unix-utils) dev\n45\t`\n46\t\n47\ttype sortMode int\n48\t\n49\tconst (\n50\t\tsortDefault sortMode = iota\n51\t\tsortNumeric\n52\t\tsortHumanNumeric\n53\t\tsortMonth\n54\t\tsortVersion\n55\t)\n56\t\n57\ttype options struct {\n58\t\treverse        bool\n59\t\tunique         bool\n60\t\tstable         bool\n61\t\tignoreBlanks   bool\n62\t\tmode           sortMode\n63\t\toutputFile     string\n64\t\tfieldSeparator string\n65\t\tkeys           []keyDef\n66\t}\n67\t\n68\tvar monthMap = map[string]int{\n69\t\t\"JAN\": 1, \"FEB\": 2, \"MAR\": 3, \"APR\": 4,\n70\t\t\"MAY\": 5, \"JUN\": 6, \"JUL\": 7, \"AUG\": 8,\n71\t\t\"SEP\": 9, \"OCT\": 10, \"NOV\": 11, \"DEC\": 12,\n72\t}\n73\t\n74\tfunc main() {\n75\t\tsys.InstallSIGPIPEHandler()\n76\t\n77\t\topts, files, err := parseArgs(os.Args[1:])\n78\t\tif err != nil {\n79\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n80\t\t\tfmt.Fprintf(os.Stderr, \"Try 'sort --help' for more information.\\n\")\n81\t\t\tos.Exit(2)\n82\t\t}\n83\t\n84\t\tif len(files) == 0 {\n85\t\t\tfiles = []string{\"-\"}\n86\t\t}\n87\t\n88\t\tlines, err := readAllLines(files)\n89\t\tif err != nil {\n90\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n91\t\t\tos.Exit(2)\n92\t\t}\n93\t\n94\t\tlines = sortAndFilter(lines, opts)\n95\t\n96\t\tvar w io.Writer = os.Stdout\n97\t\tif opts.outputFile != \"\" {\n98\t\t\tf, err := os.Create(opts.outputFile)\n99\t\t\tif err != nil {\n100\t\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n101\t\t\t\tos.Exit(2)\n102\t\t\t}\n103\t\t\tdefer f.Close()\n104\t\t\tw = f\n105\t\t}\n106\t\twriteLines(lines, w)\n107\t}\n108\t\n109\tfunc parseArgs(args []string) (options, []string, error) {\n110\t\tvar opts options\n111\t\tvar files []string\n112\t\n113\t\ti := 0\n114\t\tfor i < len(args) {\n115\t\t\targ := args[i]\n116\t\t\tif arg == \"--\" {\n117\t\t\t\tfiles = append(files, args[i+1:]...)\n118\t\t\t\tbreak\n119\t\t\t}\n120\t\t\tif strings.HasPrefix(arg, \"--\") {\n121\t\t\t\tn, err := parseLongFlag(arg, &opts, args[i+1:])\n122\t\t\t\tif err != nil {\n123\t\t\t\t\treturn opts, nil, err\n124\t\t\t\t}\n125\t\t\t\ti += n\n126\t\t\t\tcontinue\n127\t\t\t}\n128\t\t\tif len(arg) > 1 && arg[0] == '-' {\n129\t\t\t\textra, err := parseShortFlags(arg[1:], &opts, args[i+1:])\n130\t\t\t\tif err != nil {\n131\t\t\t\t\treturn opts, nil, err\n132\t\t\t\t}\n133\t\t\t\ti += 1 + extra\n134\t\t\t\tcontinue\n135\t\t\t}\n136\t\t\tfiles = append(files, arg)\n137\t\t\ti++\n138\t\t}\n139\t\n140\t\treturn opts, files, nil\n141\t}\n142\t\n143\tfunc parseLongPrefix(flag string, opts *options) (int, bool, error) {\n144\t\tif v, ok := strings.CutPrefix(flag, \"--output=\"); ok {\n145\t\t\topts.outputFile = v\n146\t\t\treturn 1, true, nil\n147\t\t}\n148\t\tif v, ok := strings.CutPrefix(flag, \"--field-separator=\"); ok {\n149\t\t\tif len(v) != 1 {\n150\t\t\t\treturn 0, true, fmt.Errorf(\"multi-character tab '%s'\", v)\n151\t\t\t}\n152\t\t\topts.fieldSeparator = v\n153\t\t\treturn 1, true, nil\n154\t\t}\n155\t\tif v, ok := strings.CutPrefix(flag, \"--key=\"); ok {\n156\t\t\tkey, err := parseKeyDef(v)\n157\t\t\tif err != nil {\n158\t\t\t\treturn 0, true, err\n159\t\t\t}\n160\t\t\topts.keys = append(opts.keys, key)\n161\t\t\treturn 1, true, nil\n162\t\t}\n163\t\treturn 0, false, nil\n164\t}\n165\t\n166\tfunc parseLongFlag(flag string, opts *options, remaining []string) (int, error) {\n167\t\tif n, handled, err := parseLongPrefix(flag, opts); handled {\n168\t\t\treturn n, err\n169\t\t}\n170\t\tswitch flag {\n171\t\tcase \"--help\":\n172\t\t\tfmt.Fprint(os.Stdout, helpText)\n173\t\t\tos.Exit(0)\n174\t\tcase \"--version\":\n175\t\t\tfmt.Fprint(os.Stdout, versionText)\n176\t\t\tos.Exit(0)\n177\t\tcase \"--reverse\":\n178\t\t\topts.reverse = true\n179\t\tcase \"--unique\":\n180\t\t\topts.unique = true\n181\t\tcase \"--stable\":\n182\t\t\topts.stable = true\n183\t\tcase \"--ignore-leading-blanks\":\n184\t\t\topts.ignoreBlanks = true\n185\t\tcase \"--numeric-sort\":\n186\t\t\topts.mode = sortNumeric\n187\t\tcase \"--human-numeric-sort\":\n188\t\t\topts.mode = sortHumanNumeric\n189\t\tcase \"--month-sort\":\n190\t\t\topts.mode = sortMonth\n191\t\tcase \"--version-sort\":\n192\t\t\topts.mode = sortVersion\n193\t\tcase \"--output\", \"--field-separator\", \"--key\":\n194\t\t\treturn parseLongWithArg(flag, opts, remaining)\n195\t\tdefault:\n196\t\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n197\t\t}\n198\t\treturn 1, nil\n199\t}\n200\t\n201\tfunc parseLongWithArg(flag string, opts *options, remaining []string) (int, error) {\n202\t\tif len(remaining) == 0 {\n203\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n204\t\t}\n205\t\tswitch flag {\n206\t\tcase \"--output\":\n207\t\t\topts.outputFile = remaining[0]\n208\t\tcase \"--field-separator\":\n209\t\t\tif len(remaining[0]) != 1 {\n210\t\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n211\t\t\t}\n212\t\t\topts.fieldSeparator = remaining[0]\n213\t\tcase \"--key\":\n214\t\t\tkey, err := parseKeyDef(remaining[0])\n215\t\t\tif err != nil {\n216\t\t\t\treturn 0, err\n217\t\t\t}\n218\t\t\topts.keys = append(opts.keys, key)\n219\t\t}\n220\t\treturn 2, nil\n221\t}\n222\t\n223\tfunc parseShortFlags(flags string, opts *options, remaining []string) (int, error) {\n224\t\tfor idx := 0; idx < len(flags); idx++ {\n225\t\t\tswitch flags[idx] {\n226\t\t\tcase 'r':\n227\t\t\t\topts.reverse = true\n228\t\t\tcase 'u':\n229\t\t\t\topts.unique = true\n230\t\t\tcase 's':\n231\t\t\t\topts.stable = true\n232\t\t\tcase 'b':\n233\t\t\t\topts.ignoreBlanks = true\n234\t\t\tcase 'n':\n235\t\t\t\topts.mode = sortNumeric\n236\t\t\tcase 'h':\n237\t\t\t\topts.mode = sortHumanNumeric\n238\t\t\tcase 'M':\n239\t\t\t\topts.mode = sortMonth\n240\t\t\tcase 'V':\n241\t\t\t\topts.mode = sortVersion\n242\t\t\tcase 'o':\n243\t\t\t\trest := flags[idx+1:]\n244\t\t\t\tif rest != \"\" {\n245\t\t\t\t\topts.outputFile = rest\n246\t\t\t\t\treturn 0, nil\n247\t\t\t\t}\n248\t\t\t\tif len(remaining) == 0 {\n249\t\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'o'\")\n250\t\t\t\t}\n251\t\t\t\topts.outputFile = remaining[0]\n252\t\t\t\treturn 1, nil\n253\t\t\tcase 't':\n254\t\t\t\treturn parseFieldSep(flags[idx+1:], remaining, opts)\n255\t\t\tcase 'k':\n256\t\t\t\treturn parseKeyArg(flags[idx+1:], remaining, opts)\n257\t\t\tdefault:\n258\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[idx])\n259\t\t\t}\n260\t\t}\n261\t\treturn 0, nil\n262\t}\n263\t\n264\tfunc parseFieldSep(rest string, remaining []string, opts *options) (int, error) {\n265\t\tif rest != \"\" {\n266\t\t\tif len(rest) != 1 {\n267\t\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", rest)\n268\t\t\t}\n269\t\t\topts.fieldSeparator = rest\n270\t\t\treturn 0, nil\n271\t\t}\n272\t\tif len(remaining) == 0 {\n273\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 't'\")\n274\t\t}\n275\t\tif len(remaining[0]) != 1 {\n276\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n277\t\t}\n278\t\topts.fieldSeparator = remaining[0]\n279\t\treturn 1, nil\n280\t}\n281\t\n282\tfunc parseKeyArg(rest string, remaining []string, opts *options) (int, error) {\n283\t\tif rest != \"\" {\n284\t\t\tkey, err := parseKeyDef(rest)\n285\t\t\tif err != nil {\n286\t\t\t\treturn 0, err\n287\t\t\t}\n288\t\t\topts.keys = append(opts.keys, key)\n289\t\t\treturn 0, nil\n290\t\t}\n291\t\tif len(remaining) == 0 {\n292\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'k'\")\n293\t\t}\n294\t\tkey, err := parseKeyDef(remaining[0])\n295\t\tif err != nil {\n296\t\t\treturn 0, err\n297\t\t}\n298\t\topts.keys = append(opts.keys, key)\n299\t\treturn 1, nil\n300\t}\n301\t\n302\tfunc readAllLines(files []string) ([]string, error) {\n303\t\tvar lines []string\n304\t\tfor _, file := range files {\n305\t\t\tr, closer, err := openInput(file)\n306\t\t\tif err != nil {\n307\t\t\t\treturn nil, err\n308\t\t\t}\n309\t\t\tfileLines, err := readLines(r)\n310\t\t\tif closer != nil {\n311\t\t\t\tcloser.Close()\n312\t\t\t}\n313\t\t\tif err != nil {\n314\t\t\t\treturn nil, err\n315\t\t\t}\n316\t\t\tlines = append(lines, fileLines...)\n317\t\t}\n318\t\treturn lines, nil\n319\t}\n320\t\n321\tfunc openInput(name string) (io.Reader, io.Closer, error) {\n322\t\tif name == \"-\" {\n323\t\t\treturn os.Stdin, nil, nil\n324\t\t}\n325\t\tf, err := os.Open(name)\n326\t\tif err != nil {\n327\t\t\treturn nil, nil, err\n328\t\t}\n329\t\treturn f, f, nil\n330\t}\n331\t\n332\tfunc readLines(r io.Reader) ([]string, error) {\n333\t\tvar lines []string\n334\t\tscanner := bufio.NewScanner(r)\n335\t\tfor scanner.Scan() {\n336\t\t\tlines = append(lines, scanner.Text())\n337\t\t}\n338\t\tif err := scanner.Err(); err != nil {\n339\t\t\treturn nil, err\n340\t\t}\n341\t\treturn lines, nil\n342\t}\n343\t\n344\tfunc sortAndFilter(lines []string, opts options) []string {\n345\t\tkeyCmp := buildKeyCmp(opts)\n346\t\thasKeys := len(opts.keys) > 0\n347\t\tsortCmp := buildSortCmp(keyCmp, opts, hasKeys)\n348\t\n349\t\tif opts.stable {\n350\t\t\tslices.SortStableFunc(lines, sortCmp)\n351\t\t} else {\n352\t\t\tslices.SortFunc(lines, sortCmp)\n353\t\t}\n354\t\tif opts.unique {\n355\t\t\tlines = dedup(lines, keyCmp)\n356\t\t}\n357\t\treturn lines\n358\t}\n359\t\n360\tfunc buildSortCmp(\n361\t\tkeyCmp func(string, string) int, opts options, hasKeys bool,\n362\t) func(string, string) int {\n363\t\tcmp := keyCmp\n364\t\tif !opts.stable && (hasKeys || opts.mode != sortDefault) {\n365\t\t\trev := opts.reverse && hasKeys\n366\t\t\tcmp = withLastResort(keyCmp, rev)\n367\t\t}\n368\t\tif opts.reverse && !hasKeys {\n369\t\t\tinner := cmp\n370\t\t\tcmp = func(a, b string) int { return inner(b, a) }\n371\t\t}\n372\t\treturn cmp\n373\t}\n374\t\n375\tfunc withLastResort(\n376\t\tkeyCmp func(string, string) int, rev bool,\n377\t) func(string, string) int {\n378\t\treturn func(a, b string) int {\n379\t\t\tif r := keyCmp(a, b); r != 0 {\n380\t\t\t\treturn r\n381\t\t\t}\n382\t\t\tr := strings.Compare(a, b)\n383\t\t\tif rev {\n384\t\t\t\treturn -r\n385\t\t\t}\n386\t\t\treturn r\n387\t\t}\n388\t}\n389\t\n390\tfunc buildKeyCmp(opts options) func(string, string) int {\n391\t\tif len(opts.keys) > 0 {\n392\t\t\treturn buildKeysCmp(opts)\n393\t\t}\n394\t\tcmp := buildModeCmp(opts.mode)\n395\t\tif opts.ignoreBlanks {\n396\t\t\treturn func(a, b string) int {\n397\t\t\t\treturn cmp(strings.TrimLeft(a, \" \\t\"), strings.TrimLeft(b, \" \\t\"))\n398\t\t\t}\n399\t\t}\n400\t\treturn cmp\n401\t}\n402\t\n403\tfunc buildModeCmp(mode sortMode) func(string, string) int {\n404\t\tswitch mode {\n405\t\tcase sortHumanNumeric:\n406\t\t\treturn cmpFloat(parseHumanNumeric)\n407\t\tcase sortMonth:\n408\t\t\treturn func(a, b string) int { return monthRank(a) - monthRank(b) }\n409\t\tcase sortVersion:\n410\t\t\treturn compareVersion\n411\t\tcase sortNumeric:\n412\t\t\treturn cmpFloat(parseNumeric)\n413\t\tdefault:\n414\t\t\treturn strings.Compare\n415\t\t}\n416\t}\n417\t\n418\tfunc dedup(lines []string, cmp func(string, string) int) []string {\n419\t\tif len(lines) == 0 {\n420\t\t\treturn lines\n421\t\t}\n422\t\tresult := []string{lines[0]}\n423\t\tfor _, line := range lines[1:] {\n424\t\t\tif cmp(line, result[len(result)-1]) != 0 {\n425\t\t\t\tresult = append(result, line)\n426\t\t\t}\n427\t\t}\n428\t\treturn result\n429\t}\n430\t\n431\tfunc writeLines(lines []string, w io.Writer) {\n432\t\tbw := bufio.NewWriter(w)\n433\t\tfor _, line := range lines {\n434\t\t\tfmt.Fprintln(bw, line)\n435\t\t}\n436\t\tbw.Flush()\n437\t}\n438\t"}]},"parent_tool_use_id":null,"session_id":"0b139998-cefb-41d3-bcee-99a798f067f0","uuid":"7ab6b550-0c15-4632-9f43-df861b1af42e","timestamp":"2026-05-20T22:38:40.856Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5379/cmd/sort/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\npackage main\n\nimport (\n\t\"bufio\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"slices\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: sort [OPTION]... [FILE]...\nWrite sorted concatenation of all FILE(s) to standard output.\n\nWith no FILE, or when FILE is -, read standard input.\n\nMandatory arguments to long options are mandatory for short options too.\nOrdering options:\n\n  -b, --ignore-leading-blanks  ignore leading blanks\n  -h, --human-numeric-sort     compare human readable numbers (e.g., 2K 1G)\n  -M, --month-sort             compare (unknown) < 'JAN' < ... < 'DEC'\n  -n, --numeric-sort           compare according to string numerical value\n  -V, --version-sort           natural sort of (version) numbers within text\n  -r, --reverse                reverse the result of comparisons\n\nOther options:\n\n  -k, --key=KEYDEF             sort via a key; KEYDEF gives location and type\n  -o, --output=FILE            write result to FILE instead of standard output\n  -s, --stable                 stabilize sort by disabling last-resort comparison\n  -t, --field-separator=SEP    use SEP instead of non-blank to blank transition\n  -u, --unique                 with -c, check for strict ordering;\n                                 without -c, output only the first of an equal run\n      --help        display this help and exit\n      --version     output version information and exit\n`\n\nconst versionText = `sort (go-unix-utils) dev\n`\n\ntype sortMode int\n\nconst (\n\tsortDefault sortMode = iota\n\tsortNumeric\n\tsortHumanNumeric\n\tsortMonth\n\tsortVersion\n)\n\ntype options struct {\n\treverse        bool\n\tunique         bool\n\tstable         bool\n\tignoreBlanks   bool\n\tmode           sortMode\n\toutputFile     string\n\tfieldSeparator string\n\tkeys           []keyDef\n}\n\nvar monthMap = map[string]int{\n\t\"JAN\": 1, \"FEB\": 2, \"MAR\": 3, \"APR\": 4,\n\t\"MAY\": 5, \"JUN\": 6, \"JUL\": 7, \"AUG\": 8,\n\t\"SEP\": 9, \"OCT\": 10, \"NOV\": 11, \"DEC\": 12,\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, files, err := parseArgs(os.Args[1:])\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\tfmt.Fprintf(os.Stderr, \"Try 'sort --help' for more information.\\n\")\n\t\tos.Exit(2)\n\t}\n\n\tif len(files) == 0 {\n\t\tfiles = []string{\"-\"}\n\t}\n\n\tlines, err := readAllLines(files)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\tos.Exit(2)\n\t}\n\n\tlines = sortAndFilter(lines, opts)\n\n\tvar w io.Writer = os.Stdout\n\tif opts.outputFile != \"\" {\n\t\tf, err := os.Create(opts.outputFile)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"sort: %s\\n\", err)\n\t\t\tos.Exit(2)\n\t\t}\n\t\tdefer f.Close()\n\t\tw = f\n\t}\n\twriteLines(lines, w)\n}\n\nfunc parseArgs(args []string) (options, []string, error) {\n\tvar opts options\n\tvar files []string\n\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\tfiles = append(files, args[i+1:]...)\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tn, err := parseLongFlag(arg, &opts, args[i+1:])\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += n\n\t\t\tcontinue\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' {\n\t\t\textra, err := parseShortFlags(arg[1:], &opts, args[i+1:])\n\t\t\tif err != nil {\n\t\t\t\treturn opts, nil, err\n\t\t\t}\n\t\t\ti += 1 + extra\n\t\t\tcontinue\n\t\t}\n\t\tfiles = append(files, arg)\n\t\ti++\n\t}\n\n\treturn opts, files, nil\n}\n\nfunc parseLongPrefix(flag string, opts *options) (int, bool, error) {\n\tif v, ok := strings.CutPrefix(flag, \"--output=\"); ok {\n\t\topts.outputFile = v\n\t\treturn 1, true, nil\n\t}\n\tif v, ok := strings.CutPrefix(flag, \"--field-separator=\"); ok {\n\t\tif len(v) != 1 {\n\t\t\treturn 0, true, fmt.Errorf(\"multi-character tab '%s'\", v)\n\t\t}\n\t\topts.fieldSeparator = v\n\t\treturn 1, true, nil\n\t}\n\tif v, ok := strings.CutPrefix(flag, \"--key=\"); ok {\n\t\tkey, err := parseKeyDef(v)\n\t\tif err != nil {\n\t\t\treturn 0, true, err\n\t\t}\n\t\topts.keys = append(opts.keys, key)\n\t\treturn 1, true, nil\n\t}\n\treturn 0, false, nil\n}\n\nfunc parseLongFlag(flag string, opts *options, remaining []string) (int, error) {\n\tif n, handled, err := parseLongPrefix(flag, opts); handled {\n\t\treturn n, err\n\t}\n\tswitch flag {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase \"--reverse\":\n\t\topts.reverse = true\n\tcase \"--unique\":\n\t\topts.unique = true\n\tcase \"--stable\":\n\t\topts.stable = true\n\tcase \"--ignore-leading-blanks\":\n\t\topts.ignoreBlanks = true\n\tcase \"--numeric-sort\":\n\t\topts.mode = sortNumeric\n\tcase \"--human-numeric-sort\":\n\t\topts.mode = sortHumanNumeric\n\tcase \"--month-sort\":\n\t\topts.mode = sortMonth\n\tcase \"--version-sort\":\n\t\topts.mode = sortVersion\n\tcase \"--output\", \"--field-separator\", \"--key\":\n\t\treturn parseLongWithArg(flag, opts, remaining)\n\tdefault:\n\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n\t}\n\treturn 1, nil\n}\n\nfunc parseLongWithArg(flag string, opts *options, remaining []string) (int, error) {\n\tif len(remaining) == 0 {\n\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n\t}\n\tswitch flag {\n\tcase \"--output\":\n\t\topts.outputFile = remaining[0]\n\tcase \"--field-separator\":\n\t\tif len(remaining[0]) != 1 {\n\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n\t\t}\n\t\topts.fieldSeparator = remaining[0]\n\tcase \"--key\":\n\t\tkey, err := parseKeyDef(remaining[0])\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.keys = append(opts.keys, key)\n\t}\n\treturn 2, nil\n}\n\nfunc parseShortFlags(flags string, opts *options, remaining []string) (int, error) {\n\tfor idx := 0; idx < len(flags); idx++ {\n\t\tswitch flags[idx] {\n\t\tcase 'r':\n\t\t\topts.reverse = true\n\t\tcase 'u':\n\t\t\topts.unique = true\n\t\tcase 's':\n\t\t\topts.stable = true\n\t\tcase 'b':\n\t\t\topts.ignoreBlanks = true\n\t\tcase 'n':\n\t\t\topts.mode = sortNumeric\n\t\tcase 'h':\n\t\t\topts.mode = sortHumanNumeric\n\t\tcase 'M':\n\t\t\topts.mode = sortMonth\n\t\tcase 'V':\n\t\t\topts.mode = sortVersion\n\t\tcase 'o':\n\t\t\trest := flags[idx+1:]\n\t\t\tif rest != \"\" {\n\t\t\t\topts.outputFile = rest\n\t\t\t\treturn 0, nil\n\t\t\t}\n\t\t\tif len(remaining) == 0 {\n\t\t\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'o'\")\n\t\t\t}\n\t\t\topts.outputFile = remaining[0]\n\t\t\treturn 1, nil\n\t\tcase 't':\n\t\t\treturn parseFieldSep(flags[idx+1:], remaining, opts)\n\t\tcase 'k':\n\t\t\treturn parseKeyArg(flags[idx+1:], remaining, opts)\n\t\tdefault:\n\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[idx])\n\t\t}\n\t}\n\treturn 0, nil\n}\n\nfunc parseFieldSep(rest string, remaining []string, opts *options) (int, error) {\n\tif rest != \"\" {\n\t\tif len(rest) != 1 {\n\t\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", rest)\n\t\t}\n\t\topts.fieldSeparator = rest\n\t\treturn 0, nil\n\t}\n\tif len(remaining) == 0 {\n\t\treturn 0, fmt.Errorf(\"option requires an argument -- 't'\")\n\t}\n\tif len(remaining[0]) != 1 {\n\t\treturn 0, fmt.Errorf(\"multi-character tab '%s'\", remaining[0])\n\t}\n\topts.fieldSeparator = remaining[0]\n\treturn 1, nil\n}\n\nfunc parseKeyArg(rest string, remaining []string, opts *options) (int, error) {\n\tif rest != \"\" {\n\t\tkey, err := parseKeyDef(rest)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t\topts.keys = append(opts.keys, key)\n\t\treturn 0, nil\n\t}\n\tif len(remaining) == 0 {\n\t\treturn 0, fmt.Errorf(\"option requires an argument -- 'k'\")\n\t}\n\tkey, err := parseKeyDef(remaining[0])\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\topts.keys = append(opts.keys, key)\n\treturn 1, nil\n}\n\nfunc readAllLines(files []string) ([]string, error) {\n\tvar lines []string\n\tfor _, file := range files {\n\t\tr, closer, err := openInput(file)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfileLines, err := readLines(r)\n\t\tif closer != nil {\n\t\t\tcloser.Close()\n\t\t}\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tlines = append(lines, fileLines...)\n\t}\n\treturn lines, nil\n}\n\nfunc openInput(name string) (io.Reader, io.Closer, error) {\n\tif name == \"-\" {\n\t\treturn os.Stdin, nil, nil\n\t}\n\tf, err := os.Open(name)\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn f, f, nil\n}\n\nfunc readLines(r io.Reader) ([]string, error) {\n\tvar lines []string\n\tscanner := bufio.NewScanner(r)\n\tfor scanner.Scan() {\n\t\tlines = append(lines, scanner.Text())\n\t}\n\tif err := scanner.Err(); err != nil {\n\t\treturn nil, err\n\t}\n\treturn lines, nil\n}\n\nfunc sortAndFilter(lines []string, opts options) []string {\n\tkeyCmp := buildKeyCmp(opts)\n\thasKeys := len(opts.keys) > 0\n\tsortCmp := buildSortCmp(keyCmp, opts, hasKeys)\n\n\tif opts.stable {\n\t\tslices.SortStableFunc(lines, sortCmp)\n\t} else {\n\t\tslices.SortFunc(lines, sortCmp)\n\t}\n\tif opts.unique {\n\t\tlines = dedup(lines, keyCmp)\n\t}\n\treturn lines\n}\n\nfunc buildSortCmp(\n\tkeyCmp func(string, string) int, opts options, hasKeys bool,\n) func(string, string) int {\n\tcmp := keyCmp\n\tif !opts.stable && (hasKeys || opts.mode != sortDefault) {\n\t\trev := opts.reverse && hasKeys\n\t\tcmp = withLastResort(keyCmp, rev)\n\t}\n\tif opts.reverse && !hasKeys {\n\t\tinner := cmp\n\t\tcmp = func(a, b string) int { return inner(b, a) }\n\t}\n\treturn cmp\n}\n\nfunc withLastResort(\n\tkeyCmp func(string, string) int, rev bool,\n) func(string, string) int {\n\treturn func(a, b string) int {\n\t\tif r := keyCmp(a, b); r != 0 {\n\t\t\treturn r\n\t\t}\n\t\tr := strings.Compare(a, b)\n\t\tif rev {\n\t\t\treturn -r\n\t\t}\n\t\treturn r\n\t}\n}\n\nfunc buildKeyCmp(opts options) func(string, string) int {\n\tif len(opts.keys) > 0 {\n\t\treturn buildKeysCmp(opts)\n\t}\n\tcmp := buildModeCmp(opts.mode)\n\tif opts.ignoreBlanks {\n\t\treturn func(a, b string) int {\n\t\t\treturn cmp(strings.TrimLeft(a, \" \\t\"), strings.TrimLeft(b, \" \\t\"))\n\t\t}\n\t}\n\treturn cmp\n}\n\nfunc buildModeCmp(mode sortMode) func(string, string) int {\n\tswitch mode {\n\tcase sortHumanNumeric:\n\t\treturn cmpFloat(parseHumanNumeric)\n\tcase sortMonth:\n\t\treturn func(a, b string) int { return monthRank(a) - monthRank(b) }\n\tcase sortVersion:\n\t\treturn compareVersion\n\tcase sortNumeric:\n\t\treturn cmpFloat(parseNumeric)\n\tdefault:\n\t\treturn strings.Compare\n\t}\n}\n\nfunc dedup(lines []string, cmp func(string, string) int) []string {\n\tif len(lines) == 0 {\n\t\treturn lines\n\t}\n\tresult := []string{lines[0]}\n\tfor _, line := range lines[1:] {\n\t\tif cmp(line, result[len(result)-1]) != 0 {\n\t\t\tresult = append(result, line)\n\t\t}\n\t}\n\treturn result\n}\n\nfunc writeLines(lines []string, w io.Writer) {\n\tbw := bufio.NewWriter(w)\n\tfor _, line := range lines {\n\t\tfmt.Fprintln(bw, line)\n\t}\n\tbw.Flush()\n}\n","numLines":438,"startLine":1,"totalLines":438}}}
