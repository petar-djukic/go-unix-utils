{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BZxRRTmT2tEWv8XYStReSd","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd037-ln R4.1, R4.2, R4.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"context\"\n10\t\t\"errors\"\n11\t\t\"os\"\n12\t\t\"os/exec\"\n13\t\t\"path/filepath\"\n14\t\t\"regexp\"\n15\t\t\"testing\"\n16\t\t\"time\"\n17\t\n18\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n19\t)\n20\t\n21\tfunc TestDiff(t *testing.T) {\n22\t\tgoBin := testutils.BuildBinary(t, \".\")\n23\t\trefBin, err := exec.LookPath(\"gln\")\n24\t\tif err != nil {\n25\t\t\tt.Skip(\"reference binary gln not found\")\n26\t\t}\n27\t\n28\t\tt.Run(\"error_missing_operand\", func(t *testing.T) {\n29\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n30\t\t\t\t{\n31\t\t\t\t\tName:     \"no_args\",\n32\t\t\t\t\tArgs:     []string{},\n33\t\t\t\t\tExitCode: 1,\n34\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n35\t\t\t\t\t\tnormalizeBinaryName,\n36\t\t\t\t\t},\n37\t\t\t\t},\n38\t\t\t})\n39\t\t})\n40\t\n41\t\tt.Run(\"error_hard_link_directory\", func(t *testing.T) {\n42\t\t\tdir := t.TempDir()\n43\t\t\tos.Mkdir(filepath.Join(dir, \"subdir\"), 0o755)\n44\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n45\t\t\t\t{\n46\t\t\t\t\tName:     \"hard_link_dir\",\n47\t\t\t\t\tArgs:     []string{\"subdir\", \"link\"},\n48\t\t\t\t\tWorkDir:  dir,\n49\t\t\t\t\tExitCode: 1,\n50\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n51\t\t\t\t\t\tnormalizeBinaryName,\n52\t\t\t\t\t},\n53\t\t\t\t},\n54\t\t\t})\n55\t\t})\n56\t\n57\t\tt.Run(\"error_existing_destination\", func(t *testing.T) {\n58\t\t\tdir := t.TempDir()\n59\t\t\twriteFile(t, dir, \"src\", \"aaa\")\n60\t\t\twriteFile(t, dir, \"dest\", \"bbb\")\n61\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n62\t\t\t\t{\n63\t\t\t\t\tName:     \"exists_no_force\",\n64\t\t\t\t\tArgs:     []string{\"src\", \"dest\"},\n65\t\t\t\t\tWorkDir:  dir,\n66\t\t\t\t\tExitCode: 1,\n67\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n68\t\t\t\t\t\tnormalizeBinaryName,\n69\t\t\t\t\t},\n70\t\t\t\t},\n71\t\t\t})\n72\t\t})\n73\t\n74\t\tt.Run(\"error_nonexistent_target\", func(t *testing.T) {\n75\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n76\t\t\t\t{\n77\t\t\t\t\tName:     \"missing_target\",\n78\t\t\t\t\tArgs:     []string{\"nonexistent\", \"link\"},\n79\t\t\t\t\tExitCode: 1,\n80\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n81\t\t\t\t\t\tnormalizeBinaryName,\n82\t\t\t\t\t},\n83\t\t\t\t},\n84\t\t\t})\n85\t\t})\n86\t\n87\t\tt.Run(\"error_multi_target_not_dir\", func(t *testing.T) {\n88\t\t\tdir := t.TempDir()\n89\t\t\twriteFile(t, dir, \"a\", \"a\")\n90\t\t\twriteFile(t, dir, \"b\", \"b\")\n91\t\t\twriteFile(t, dir, \"notdir\", \"c\")\n92\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n93\t\t\t\t{\n94\t\t\t\t\tName:     \"multi_not_dir\",\n95\t\t\t\t\tArgs:     []string{\"a\", \"b\", \"notdir\"},\n96\t\t\t\t\tWorkDir:  dir,\n97\t\t\t\t\tExitCode: 1,\n98\t\t\t\t\tNormalize: []testutils.NormalizeFunc{\n99\t\t\t\t\t\tnormalizeBinaryName,\n100\t\t\t\t\t},\n101\t\t\t\t},\n102\t\t\t})\n103\t\t})\n104\t\n105\t\tt.Run(\"hard_link_basic\", func(t *testing.T) {\n106\t\t\trunLinkTest(t, goBin, refBin,\n107\t\t\t\tmap[string]string{\"source\": \"content\"},\n108\t\t\t\t[]string{\"source\", \"link1\"},\n109\t\t\t\tfunc(t *testing.T, dir string) {\n110\t\t\t\t\tverifyHardLink(t, dir, \"source\", \"link1\")\n111\t\t\t\t},\n112\t\t\t)\n113\t\t})\n114\t\n115\t\tt.Run(\"hard_link_multi_dir\", func(t *testing.T) {\n116\t\t\trunLinkTest(t, goBin, refBin,\n117\t\t\t\tmap[string]string{\"a\": \"aa\", \"b\": \"bb\"},\n118\t\t\t\t[]string{\"a\", \"b\", \"dest\"},\n119\t\t\t\tfunc(t *testing.T, dir string) {\n120\t\t\t\t\tverifyHardLink(t, dir, \"a\", filepath.Join(\"dest\", \"a\"))\n121\t\t\t\t\tverifyHardLink(t