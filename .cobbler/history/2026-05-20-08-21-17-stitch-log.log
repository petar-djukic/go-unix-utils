"src\": \"data\"},\n179\t\t\t\t[]string{\"-v\", \"src\", \"vlink\"},\n180\t\t\t\tfunc(t *testing.T, dir string) {\n181\t\t\t\t\tverifyHardLink(t, dir, \"src\", \"vlink\")\n182\t\t\t\t},\n183\t\t\t)\n184\t\t})\n185\t\n186\t\tt.Run(\"verbose_symlink\", func(t *testing.T) {\n187\t\t\trunLinkTestV(t, goBin, refBin,\n188\t\t\t\tmap[string]string{\"target\": \"data\"},\n189\t\t\t\t[]string{\"-sv\", \"target\", \"vslink\"},\n190\t\t\t\tfunc(t *testing.T, dir string) {\n191\t\t\t\t\tverifySymlink(t, dir, \"vslink\", \"target\")\n192\t\t\t\t},\n193\t\t\t)\n194\t\t})\n195\t\n196\t\tt.Run(\"verbose_force\", func(t *testing.T) {\n197\t\t\trunLinkTestV(t, goBin, refBin,\n198\t\t\t\tmap[string]string{\"src\": \"new\", \"dest\": \"old\"},\n199\t\t\t\t[]string{\"-fv\", \"src\", \"dest\"},\n200\t\t\t\tfunc(t *testing.T, dir string) {\n201\t\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n202\t\t\t\t},\n203\t\t\t)\n204\t\t})\n205\t\n206\t\tt.Run(\"no_dereference_symlink_to_dir\", func(t *testing.T) {\n207\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n208\t\t\t\tos.Mkdir(filepath.Join(dir, \"realdir\"), 0o755)\n209\t\t\t\tos.Symlink(\"realdir\", filepath.Join(dir, \"dirlink\"))\n210\t\t\t\twriteFile(t, dir, \"src\", \"data\")\n211\t\t\t}, []string{\"-sfn\", \"src\", \"dirlink\"}, func(t *testing.T, dir string) {\n212\t\t\t\tverifySymlink(t, dir, \"dirlink\", \"src\")\n213\t\t\t})\n214\t\t})\n215\t\n216\t\tt.Run(\"relative_symlink\", func(t *testing.T) {\n217\t\t\trunLinkTestV(t, goBin, refBin,\n218\t\t\t\tmap[string]string{\"target\": \"data\"},\n219\t\t\t\t[]string{\"-srv\", \"target\", \"rlink\"},\n220\t\t\t\tfunc(t *testing.T, dir string) {\n221\t\t\t\t\tverifySymlink(t, dir, \"rlink\", \"target\")\n222\t\t\t\t},\n223\t\t\t)\n224\t\t})\n225\t\n226\t\tt.Run(\"relative_symlink_subdir\", func(t *testing.T) {\n227\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n228\t\t\t\twriteFile(t, dir, \"src\", \"data\")\n229\t\t\t\tos.Mkdir(filepath.Join(dir, \"sub\"), 0o755)\n230\t\t\t}, []string{\"-sr\", \"src\", \"sub/link\"}, func(t *testing.T, dir string) {\n231\t\t\t\ttarget, err := os.Readlink(filepath.Join(dir, \"sub\", \"link\"))\n232\t\t\t\tif err != nil {\n233\t\t\t\t\tt.Fatalf(\"readlink: %v\", err)\n234\t\t\t\t}\n235\t\t\t\tif target != \"../src\" {\n236\t\t\t\t\tt.Fatalf(\"expected relative target '../src', got %q\", target)\n237\t\t\t\t}\n238\t\t\t})\n239\t\t})\n240\t\n241\t\tt.Run(\"backup_simple\", func(t *testing.T) {\n242\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n243\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n244\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n245\t\t\t}, []string{\"-b\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n246\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n247\t\t\t\tverifyFileContent(t, dir, \"dest~\", \"old\")\n248\t\t\t})\n249\t\t})\n250\t\n251\t\tt.Run(\"backup_simple_symlink\", func(t *testing.T) {\n252\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n253\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n254\t\t\t}, []string{\"-sb\", \"newtarget\", \"dest\"}, func(t *testing.T, dir string) {\n255\t\t\t\tverifySymlink(t, dir, \"dest\", \"newtarget\")\n256\t\t\t\tverifyFileContent(t, dir, \"dest~\", \"old\")\n257\t\t\t})\n258\t\t})\n259\t\n260\t\tt.Run(\"backup_numbered\", func(t *testing.T) {\n261\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n262\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n263\t\t\t\twriteFile(t, dir, \"dest\", \"old\")\n264\t\t\t}, []string{\"--backup=numbered\", \"src\", \"dest\"}, func(t *testing.T, dir string) {\n265\t\t\t\tverifyHardLink(t, dir, \"src\", \"dest\")\n266\t\t\t\tverifyFileContent(t, dir, \"dest.~1~\", \"old\")\n267\t\t\t})\n268\t\t})\n269\t\n270\t\tt.Run(\"backup_numbered_increments\", func(t *testing.T) {\n271\t\t\trunLinkTestN(t, goBin, refBin, func(t *testing.T, dir string) {\n272\t\t\t\twriteFile(t, dir, \"src\", \"new\")\n273\t\t\t\twriteFile(t,