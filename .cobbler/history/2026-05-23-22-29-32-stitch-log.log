mand == \"\" {\n\t\tprio, err := syscall.Getpriority(syscall.PRIO_PROCESS, 0)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"nice: cannot get niceness: %s\\n\", err)\n\t\t\tos.Exit(125)\n\t\t}\n\t\tfmt.Println(prio)\n\t\tos.Exit(0)\n\t}\n\n\tprio, err := syscall.Getpriority(syscall.PRIO_PROCESS, 0)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: cannot get niceness: %s\\n\", err)\n\t\tos.Exit(125)\n\t}\n\n\tnewPrio := prio + adjustment\n\tif newPrio > 19 {\n\t\tnewPrio = 19\n\t}\n\tif newPrio < -20 {\n\t\tnewPrio = -20\n\t}\n\n\tif err := syscall.Setpriority(syscall.PRIO_PROCESS, 0, newPrio); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: cannot set niceness: %s\\n\", err)\n\t\tos.Exit(125)\n\t}\n\n\tbinary, err := exec.LookPath(command)\n\tif err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: %q: %s\\n\", command, noSuchFile(err))\n\t\tos.Exit(127)\n\t}\n\n\targv := append([]string{command}, cmdArgs...)\n\texecErr := syscall.Exec(binary, argv, os.Environ())\n\tif execErr != nil {\n\t\tfmt.Fprintf(os.Stderr, \"nice: %q: %s\\n\", command, execErr)\n\t\tos.Exit(126)\n\t}\n}\n\nfunc noSuchFile(err error) string {\n\tif pe, ok := err.(*exec.Error); ok {\n\t\treturn pe.Err.Error()\n\t}\n\treturn err.Error()\n}\n\nfunc parseArgs(args []string) (int, string, []string, error) {\n\tadjustment := 10\n\tadjustmentSet := false\n\ti := 0\n\tfor i < len(args) {\n\t\targ := args[i]\n\t\tif arg == \"--\" {\n\t\t\ti++\n\t\t\tbreak\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--adjustment=\") {\n\t\t\tval := arg[13:]\n\t\t\tn, err := strconv.Atoi(val)\n\t\t\tif err != nil {\n\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment %q\", val)\n\t\t\t}\n\t\t\tadjustment = n\n\t\t\tadjustmentSet = true\n\t\t\ti++\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--adjustment\" {\n\t\t\tif i+1 >= len(args) {\n\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"option '--adjustment' requires an argument\")\n\t\t\t}\n\t\t\tn, err := strconv.Atoi(args[i+1])\n\t\t\tif err != nil {\n\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment %q\", args[i+1])\n\t\t\t}\n\t\t\tadjustment = n\n\t\t\tadjustmentSet = true\n\t\t\ti += 2\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--help\" {\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\t}\n\t\tif arg == \"--version\" {\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\t}\n\t\tif len(arg) > 1 && arg[0] == '-' && !strings.HasPrefix(arg, \"--\") {\n\t\t\tif arg[1] == 'n' {\n\t\t\t\trest := arg[2:]\n\t\t\t\tif rest != \"\" {\n\t\t\t\t\tn, err := strconv.Atoi(rest)\n\t\t\t\t\tif err != nil {\n\t\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment %q\", rest)\n\t\t\t\t\t}\n\t\t\t\t\tadjustment = n\n\t\t\t\t\tadjustmentSet = true\n\t\t\t\t\ti++\n\t\t\t\t\tcontinue\n\t\t\t\t}\n\t\t\t\tif i+1 >= len(args) {\n\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"option requires an argument -- 'n'\")\n\t\t\t\t}\n\t\t\t\tn, err := strconv.Atoi(args[i+1])\n\t\t\t\tif err != nil {\n\t\t\t\t\treturn 0, \"\", nil, fmt.Errorf(\"invalid adjustment %q\", args[i+1])\n\t\t\t\t}\n\t\t\t\tadjustment = n\n\t\t\t\tadjustmentSet = true\n\t\t\t\ti += 2\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\t// GNU nice treats -N as --adjustment=N for numeric N\n\t\t\tif n, err := strconv.Atoi(arg[1:]); err == nil {\n\t\t\t\tadjustment = n\n\t\t\t\tadjustmentSet = true\n\t\t\t\ti++\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tbreak\n\t\t}\n\t\tbreak\n\t}\n\t_ = adjustmentSet\n\n\tif i >= len(args) {\n\t\treturn adjustment, \"\", nil, nil\n\t}\n\tcommand := args[i]\n\tcmdArgs := args[i+1:]\n\treturn adjustment, command, cmdArgs, nil\n}\n","structuredPatch":[{"oldStart":54,"oldLines":13,"newStart":54,"newLines":7,"lines":["     os.Exit(125)","   }"," ","-  newPrio := prio + adjustment","-  if newPrio > 19 {","-    newPrio = 19","-  }","-  if newPrio < -20 {","-    newPrio = -20","-  }","+  newPrio := min(max(prio+adjustment, -20), 19)"," ","   if err := syscall.Setpriority(syscall.PRIO_PROCESS, 0, newPrio); err != nil {","     fmt.Fprintf(os.Stderr, \"nice: cannot set niceness: %s\\n\", err)"]}],"userModified":false,"replaceAll":false}}
