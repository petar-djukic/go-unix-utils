{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MgGxJLrjiGEugaoB4Tm12j","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd092-mkfifo R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"context\"\n10\t\t\"errors\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"os/exec\"\n14\t\t\"path/filepath\"\n15\t\t\"regexp\"\n16\t\t\"testing\"\n17\t\t\"time\"\n18\t\n19\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n20\t)\n21\t\n22\tvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mkfifo\\b`)\n23\t\n24\tfunc normalizeBinaryName(b []byte) []byte {\n25\t\treturn binaryNameRe.ReplaceAll(b, []byte(\"mkfifo\"))\n26\t}\n27\t\n28\tfunc TestDiff(t *testing.T) {\n29\t\tgoBin := testutils.BuildBinary(t, \".\")\n30\t\trefBin, err := exec.LookPath(\"gmkfifo\")\n31\t\tif err != nil {\n32\t\t\tt.Skip(\"reference binary not found\")\n33\t\t}\n34\t\n35\t\tt.Run(\"no_args\", func(t *testing.T) {\n36\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n37\t\t\t\t{\n38\t\t\t\t\tName:      \"missing_operand\",\n39\t\t\t\t\tArgs:      []string{},\n40\t\t\t\t\tExitCode:  1,\n41\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n42\t\t\t\t},\n43\t\t\t})\n44\t\t})\n45\t\n46\t\tt.Run(\"create_single\", func(t *testing.T) {\n47\t\t\trunCreationTest(t, goBin, refBin, []string{\"pipe1\"})\n48\t\t})\n49\t\n50\t\tt.Run(\"create_multiple\", func(t *testing.T) {\n51\t\t\trunCreationTest(t, goBin, refBin, []string{\"p1\", \"p2\", \"p3\"})\n52\t\t})\n53\t\n54\t\tt.Run(\"mode_octal\", func(t *testing.T) {\n55\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"0600\", \"pipe1\"})\n56\t\t})\n57\t\n58\t\tt.Run(\"mode_octal_no_leading_zero\", func(t *testing.T) {\n59\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"600\", \"pipe1\"})\n60\t\t})\n61\t\n62\t\tt.Run(\"mode_long_flag\", func(t *testing.T) {\n63\t\t\trunCreationTest(t, goBin, refBin, []string{\"--mode=0600\", \"pipe1\"})\n64\t\t})\n65\t\n66\t\tt.Run(\"mode_long_flag_separate\", func(t *testing.T) {\n67\t\t\trunCreationTest(t, goBin, refBin, []string{\"--mode\", \"0600\", \"pipe1\"})\n68\t\t})\n69\t\n70\t\tt.Run(\"mode_combined_short\", func(t *testing.T) {\n71\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m0600\", \"pipe1\"})\n72\t\t})\n73\t\n74\t\tt.Run(\"mode_symbolic\", func(t *testing.T) {\n75\t\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"u=rw,go=r\", \"pipe1\"})\n76\t\t})\n77\t\n78\t\tt.Run(\"error_existing\", func(t *testing.T) {\n79\t\t\tworkDir := t.TempDir()\n80\t\t\tos.WriteFile(filepath.Join(workDir, \"existing\"), nil, 0o644)\n81\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n82\t\t\t\t{\n83\t\t\t\t\tName:      \"exists\",\n84\t\t\t\t\tArgs:      []string{\"existing\"},\n85\t\t\t\t\tWorkDir:   workDir,\n86\t\t\t\t\tExitCode:  1,\n87\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n88\t\t\t\t},\n89\t\t\t})\n90\t\t})\n91\t\n92\t\tt.Run(\"error_missing_parent\", func(t *testing.T) {\n93\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n94\t\t\t\t{\n95\t\t\t\t\tName:      \"no_parent\",\n96\t\t\t\t\tArgs:      []string{\"no/parent/pipe\"},\n97\t\t\t\t\tExitCode:  1,\n98\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n99\t\t\t\t},\n100\t\t\t})\n101\t\t})\n102\t\n103\t\tt.Run(\"partial_failure\", func(t *testing.T) {\n104\t\t\tgoDir := t.TempDir()\n105\t\t\trefDir := t.TempDir()\n106\t\t\tos.WriteFile(filepath.Join(goDir, \"existing\"), nil, 0o644)\n107\t\t\tos.WriteFile(filepath.Join(refDir, \"existing\"), nil, 0o644)\n108\t\t\targs := []string{\"existing\", \"newpipe\"}\n109\t\t\tgoRes := runBin(t, goBin, args, goDir)\n110\t\t\trefRes := runBin(t, refBin, args, refDir)\n111\t\t\tcompareResults(t, args, goRes, refRes)\n112\t\t})\n113\t\n114\t\tt.Run(\"mode_invalid\", func(t *testing.T) {\n115\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n116\t\t\t\t{\n117\t\t\t\t\tName:      \"bogus_mode\",\n118\t\t\t\t\tArgs:      []string{\"-m\", \"bogus\", \"pipe\"},\n119\t\t\t\t\tExitCode:  1,\n120\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n121\t\t\t\t},\n122\t\t\t})\n123\t\t})\n124\t\n125\t\tt.Run(\"mode_missing_arg\", func(t *testing.T) {\n126\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n127\t\t\t\t{\n128\t\t\t\t\tName:      \"m_no_arg\",\n129\t\t\t\t\tArgs:      []string{\"-m\"},\n130\t\t\t\t\tExitCode:  1,\n131\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n132\t\t\t\t},\n133\t\t\t})\n134\t\t})\n135\t\n136\t\tt.Run(\"invalid_option\", func(t *testing.T) {\n137\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n138\t\t\t\t{\n139\t\t\t\t\tName:      \"bad_short_option\",\n140\t\t\t\t\tArgs:      []string{\"-x\"},\n141\t\t\t\t\tExitCode:  1,\n142\t\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n143\t\t\t\t},\n144\t\t\t})\n145\t\t})\n146\t\n147\t\tt.Run(\"double_dash\", func(t *testing.T) {\n148\t\t\trunCreationTest(t, goBin, refBin, []string{\"--\", \"-pipename\"})\n149\t\t})\n150\t\n151\t\tt.Run(\"all_failures\", func(t *testing.T) {\n152\t\t\tgoDir := t.TempDir()\n153\t\t\trefDir := t.TempDir()\n154\t\t\tos.WriteFile(filepath.Join(goDir, \"a\"), nil, 0o644)\n155\t\t\tos.WriteFile(filepath.Join(goDir, \"b\"), nil, 0o644)\n156\t\t\tos.WriteFile(filepath.Join(refDir, \"a\"), nil, 0o644)\n157\t\t\tos.WriteFile(filepath.Join(refDir, \"b\"), nil, 0o644)\n158\t\t\targs := []string{\"a\", \"b\"}\n159\t\t\tgoRes := runBin(t, goBin, args, goDir)\n160\t\t\trefRes := runBin(t, refBin, args, refDir)\n161\t\t\tcompareResults(t, args, goRes, refRes)\n162\t\t})\n163\t\n164\t\tt.Run(\"partial_failure_last\", func(t *testing.T) {\n165\t\t\tgoDir := t.TempDir()\n166\t\t\trefDir := t.TempDir()\n167\t\t\tos.WriteFile(filepath.Join(goDir, \"existing\"), nil, 0o644)\n168\t\t\tos.WriteFile(filepath.Join(refDir, \"existing\"), nil, 0o644)\n169\t\t\targs := []string{\"newpipe\", \"existing\"}\n170\t\t\tgoRes := runBin(t, goBin, args, goDir)\n171\t\t\trefRes := runBin(t, refBin, args, refDir)\n172\t\t\tcompareResults(t, args, goRes, refRes)\n173\t\t})\n174\t}\n175\t\n176\tfunc TestCreationPermissions(t *testing.T) {\n177\t\tgoBin := testutils.BuildBinary(t, \".\")\n178\t\trefBin, err := exec.LookPath(\"gmkfifo\")\n179\t\tif err != nil {\n180\t\t\tt.Skip(\"reference binary not found\")\n181\t\t}\n182\t\n183\t\tgoDir := t.TempDir()\n184\t\trefDir := t.TempDir()\n185\t\targs := []string{\"testpipe\"}\n186\t\trunBin(t, goBin, args, goDir)\n187\t\trunBin(t, refBin, args, refDir)\n188\t\n189\t\tgoInfo, err := os.Stat(filepath.Join(goDir, \"testpipe\"))\n190\t\tif err != nil {\n191\t\t\tt.Fatalf(\"go binary did not create FIFO: %v\", err)\n192\t\t}\n193\t\trefInfo, err := os.Stat(filepath.Join(refDir, \"testpipe\"))\n194\t\tif err != nil {\n195\t\t\tt.Fatalf(\"ref binary did not create FIFO: %v\", err)\n196\t\t}\n197\t\tif goInfo.Mode().Type()&os.ModeNamedPipe == 0 {\n198\t\t\tt.Fatal(\"go binary created a non-FIFO file\")\n199\t\t}\n200\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n201\t\t\tt.Fatalf(\"permission mismatch: go=%v ref=%v\",\n202\t\t\t\tgoInfo.Mode().Perm(), refInfo.Mode().Perm())\n203\t\t}\n204\t}\n205\t\n206\tfunc TestModePermissions(t *testing.T) {\n207\t\tgoBin := testutils.BuildBinary(t, \".\")\n208\t\trefBin, err := exec.LookPath(\"gmkfifo\")\n209\t\tif err != nil {\n210\t\t\tt.Skip(\"reference binary not found\")\n211\t\t}\n212\t\n213\t\ttests := []struct {\n214\t\t\tname string\n215\t\t\targs []string\n216\t\t}{\n217\t\t\t{\"octal_0600\", []string{\"-m\", \"0600\", \"p1\"}},\n218\t\t\t{\"octal_0644\", []string{\"-m\", \"0644\", \"p2\"}},\n219\t\t\t{\"octal_0666\", []string{\"-m\", \"0666\", \"p3\"}},\n220\t\t\t{\"symbolic_urw_gor\", []string{\"-m\", \"u=rw,go=r\", \"p4\"}},\n221\t\t\t{\"symbolic_arw\", []string{\"-m\", \"a=rw\", \"p5\"}},\n222\t\t}\n223\t\n224\t\tfor _, tt := range tests {\n225\t\t\tt.Run(tt.name, func(t *testing.T) {\n226\t\t\t\tgoDir := t.TempDir()\n227\t\t\t\trefDir := t.TempDir()\n228\t\t\t\trunBin(t, goBin, tt.args, goDir)\n229\t\t\t\trunBin(t, refBin, tt.args, refDir)\n230\t\t\t\tname := tt.args[len(tt.args)-1]\n231\t\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, name))\n232\t\t\t\tif err != nil {\n233\t\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", name, err)\n234\t\t\t\t}\n235\t\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, name))\n236\t\t\t\tif err != nil {\n237\t\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", name, err)\n238\t\t\t\t}\n239\t\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n240\t\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n241\t\t\t\t\t\tname, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n242\t\t\t\t}\n243\t\t\t})\n244\t\t}\n245\t}\n246\t\n247\tfunc runCreationTest(t *testing.T, goBin, refBin string, args []string) {\n248\t\tt.Helper()\n249\t\tgoDir := t.TempDir()\n250\t\trefDir := t.TempDir()\n251\t\tgoRes := runBin(t, goBin, args, goDir)\n252\t\trefRes := runBin(t, refBin, args, refDir)\n253\t\tcompareResults(t, args, goRes, refRes)\n254\t}\n255\t\n256\ttype binResult struct {\n257\t\tstdout   []byte\n258\t\tstderr   []byte\n259\t\texitCode int\n260\t}\n261\t\n262\tfunc runBin(t *testing.T, binary string, args []string, workDir string) binResult {\n263\t\tt.Helper()\n264\t\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n265\t\tdefer cancel()\n266\t\tcmd := exec.CommandContext(ctx, binary, args...)\n267\t\tcmd.Dir = workDir\n268\t\tcmd.Env = append(os.Environ(), \"LC_ALL=C\")\n269\t\tvar stdout, stderr bytes.Buffer\n270\t\tcmd.Stdout = &stdout\n271\t\tcmd.Stderr = &stderr\n272\t\terr := cmd.Run()\n273\t\tif ctx.Err() == context.DeadlineExceeded {\n274\t\t\tt.Fatalf(\"binary %s timed out\", binary)\n275\t\t}\n276\t\texitCode := 0\n277\t\tif err != nil {\n278\t\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n279\t\t\t\texitCode = exitErr.ExitCode()\n280\t\t\t} else {\n281\t\t\t\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n282\t\t\t}\n283\t\t}\n284\t\treturn binResult{stdout: stdout.Bytes(), stderr: stderr.Bytes(), exitCode: exitCode}\n285\t}\n286\t\n287\tfunc compareResults(t *testing.T, args []string, goRes, refRes binResult) {\n288\t\tt.Helper()\n289\t\tgoStdout := normalizeBinaryName(goRes.stdout)\n290\t\trefStdout := normalizeBinaryName(refRes.stdout)\n291\t\tgoStderr := normalizeBinaryName(goRes.stderr)\n292\t\trefStderr := normalizeBinaryName(refRes.stderr)\n293\t\tif !bytes.Equal(goStdout, refStdout) ||\n294\t\t\t!bytes.Equal(goStderr, refStderr) ||\n295\t\t\tgoRes.exitCode != refRes.exitCode {\n296\t\t\tt.Fatalf(\"divergence detected\\n\"+\n297\t\t\t\t\"  args:       %v\\n\"+\n298\t\t\t\t\"  ref stdout: %q\\n\"+\n299\t\t\t\t\"  go  stdout: %q\\n\"+\n300\t\t\t\t\"  ref stderr: %q\\n\"+\n301\t\t\t\t\"  go  stderr: %q\\n\"+\n302\t\t\t\t\"  ref exit:   %d\\n\"+\n303\t\t\t\t\"  go  exit:   %d\\n\",\n304\t\t\t\targs, refStdout, goStdout, refStderr, goStderr, refRes.exitCode, goRes.exitCode)\n305\t\t}\n306\t}\n307\t\n308\tfunc TestSIGPIPE(t *testing.T) {\n309\t\tgoBin := testutils.BuildBinary(t, \".\")\n310\t\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n311\t\tdefer cancel()\n312\t\tcmd := exec.CommandContext(ctx, goBin, \"--help\")\n313\t\tstdout, err := cmd.StdoutPipe()\n314\t\tif err != nil {\n315\t\t\tt.Fatal(err)\n316\t\t}\n317\t\tif err := cmd.Start(); err != nil {\n318\t\t\tt.Fatal(err)\n319\t\t}\n320\t\tbuf := make([]byte, 1)\n321\t\tif _, err := io.ReadFull(stdout, buf); err != nil {\n322\t\t\tt.Fatal(err)\n323\t\t}\n324\t\tstdout.Close()\n325\t\terr = cmd.Wait()\n326\t\tif ctx.Err() == context.DeadlineExceeded {\n327\t\t\tt.Fatal(\"mkfifo timed out; SIGPIPE handler may not be installed\")\n328\t\t}\n329\t\tif err != nil {\n330\t\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n331\t\t}\n332\t}\n333\t"}]},"parent_tool_use_id":null,"session_id":"7bf3d195-37dc-4716-b8df-76f355abf711","uuid":"39d25089-50cc-4551-8e11-e03e84167096","timestamp":"2026-05-24T02:31:14.894Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5561/cmd/mkfifo/mkfifo_test.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd092-mkfifo R1.1, R1.2, R1.3, R1.4, R2.1, R2.2, R2.3.\npackage main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"errors\"\n\t\"io\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"regexp\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n)\n\nvar binaryNameRe = regexp.MustCompile(`(/\\S+/)?g?mkfifo\\b`)\n\nfunc normalizeBinaryName(b []byte) []byte {\n\treturn binaryNameRe.ReplaceAll(b, []byte(\"mkfifo\"))\n}\n\nfunc TestDiff(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gmkfifo\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\tt.Run(\"no_args\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"missing_operand\",\n\t\t\t\tArgs:      []string{},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"create_single\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"pipe1\"})\n\t})\n\n\tt.Run(\"create_multiple\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"p1\", \"p2\", \"p3\"})\n\t})\n\n\tt.Run(\"mode_octal\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"0600\", \"pipe1\"})\n\t})\n\n\tt.Run(\"mode_octal_no_leading_zero\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"600\", \"pipe1\"})\n\t})\n\n\tt.Run(\"mode_long_flag\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"--mode=0600\", \"pipe1\"})\n\t})\n\n\tt.Run(\"mode_long_flag_separate\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"--mode\", \"0600\", \"pipe1\"})\n\t})\n\n\tt.Run(\"mode_combined_short\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"-m0600\", \"pipe1\"})\n\t})\n\n\tt.Run(\"mode_symbolic\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"-m\", \"u=rw,go=r\", \"pipe1\"})\n\t})\n\n\tt.Run(\"error_existing\", func(t *testing.T) {\n\t\tworkDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(workDir, \"existing\"), nil, 0o644)\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"exists\",\n\t\t\t\tArgs:      []string{\"existing\"},\n\t\t\t\tWorkDir:   workDir,\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"error_missing_parent\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"no_parent\",\n\t\t\t\tArgs:      []string{\"no/parent/pipe\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"partial_failure\", func(t *testing.T) {\n\t\tgoDir := t.TempDir()\n\t\trefDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(goDir, \"existing\"), nil, 0o644)\n\t\tos.WriteFile(filepath.Join(refDir, \"existing\"), nil, 0o644)\n\t\targs := []string{\"existing\", \"newpipe\"}\n\t\tgoRes := runBin(t, goBin, args, goDir)\n\t\trefRes := runBin(t, refBin, args, refDir)\n\t\tcompareResults(t, args, goRes, refRes)\n\t})\n\n\tt.Run(\"mode_invalid\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"bogus_mode\",\n\t\t\t\tArgs:      []string{\"-m\", \"bogus\", \"pipe\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"mode_missing_arg\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"m_no_arg\",\n\t\t\t\tArgs:      []string{\"-m\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"invalid_option\", func(t *testing.T) {\n\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n\t\t\t{\n\t\t\t\tName:      \"bad_short_option\",\n\t\t\t\tArgs:      []string{\"-x\"},\n\t\t\t\tExitCode:  1,\n\t\t\t\tNormalize: []testutils.NormalizeFunc{normalizeBinaryName},\n\t\t\t},\n\t\t})\n\t})\n\n\tt.Run(\"double_dash\", func(t *testing.T) {\n\t\trunCreationTest(t, goBin, refBin, []string{\"--\", \"-pipename\"})\n\t})\n\n\tt.Run(\"all_failures\", func(t *testing.T) {\n\t\tgoDir := t.TempDir()\n\t\trefDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(goDir, \"a\"), nil, 0o644)\n\t\tos.WriteFile(filepath.Join(goDir, \"b\"), nil, 0o644)\n\t\tos.WriteFile(filepath.Join(refDir, \"a\"), nil, 0o644)\n\t\tos.WriteFile(filepath.Join(refDir, \"b\"), nil, 0o644)\n\t\targs := []string{\"a\", \"b\"}\n\t\tgoRes := runBin(t, goBin, args, goDir)\n\t\trefRes := runBin(t, refBin, args, refDir)\n\t\tcompareResults(t, args, goRes, refRes)\n\t})\n\n\tt.Run(\"partial_failure_last\", func(t *testing.T) {\n\t\tgoDir := t.TempDir()\n\t\trefDir := t.TempDir()\n\t\tos.WriteFile(filepath.Join(goDir, \"existing\"), nil, 0o644)\n\t\tos.WriteFile(filepath.Join(refDir, \"existing\"), nil, 0o644)\n\t\targs := []string{\"newpipe\", \"existing\"}\n\t\tgoRes := runBin(t, goBin, args, goDir)\n\t\trefRes := runBin(t, refBin, args, refDir)\n\t\tcompareResults(t, args, goRes, refRes)\n\t})\n}\n\nfunc TestCreationPermissions(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gmkfifo\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\tgoDir := t.TempDir()\n\trefDir := t.TempDir()\n\targs := []string{\"testpipe\"}\n\trunBin(t, goBin, args, goDir)\n\trunBin(t, refBin, args, refDir)\n\n\tgoInfo, err := os.Stat(filepath.Join(goDir, \"testpipe\"))\n\tif err != nil {\n\t\tt.Fatalf(\"go binary did not create FIFO: %v\", err)\n\t}\n\trefInfo, err := os.Stat(filepath.Join(refDir, \"testpipe\"))\n\tif err != nil {\n\t\tt.Fatalf(\"ref binary did not create FIFO: %v\", err)\n\t}\n\tif goInfo.Mode().Type()&os.ModeNamedPipe == 0 {\n\t\tt.Fatal(\"go binary created a non-FIFO file\")\n\t}\n\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n\t\tt.Fatalf(\"permission mismatch: go=%v ref=%v\",\n\t\t\tgoInfo.Mode().Perm(), refInfo.Mode().Perm())\n\t}\n}\n\nfunc TestModePermissions(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\trefBin, err := exec.LookPath(\"gmkfifo\")\n\tif err != nil {\n\t\tt.Skip(\"reference binary not found\")\n\t}\n\n\ttests := []struct {\n\t\tname string\n\t\targs []string\n\t}{\n\t\t{\"octal_0600\", []string{\"-m\", \"0600\", \"p1\"}},\n\t\t{\"octal_0644\", []string{\"-m\", \"0644\", \"p2\"}},\n\t\t{\"octal_0666\", []string{\"-m\", \"0666\", \"p3\"}},\n\t\t{\"symbolic_urw_gor\", []string{\"-m\", \"u=rw,go=r\", \"p4\"}},\n\t\t{\"symbolic_arw\", []string{\"-m\", \"a=rw\", \"p5\"}},\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(tt.name, func(t *testing.T) {\n\t\t\tgoDir := t.TempDir()\n\t\t\trefDir := t.TempDir()\n\t\t\trunBin(t, goBin, tt.args, goDir)\n\t\t\trunBin(t, refBin, tt.args, refDir)\n\t\t\tname := tt.args[len(tt.args)-1]\n\t\t\tgoInfo, err := os.Stat(filepath.Join(goDir, name))\n\t\t\tif err != nil {\n\t\t\t\tt.Fatalf(\"go binary did not create %s: %v\", name, err)\n\t\t\t}\n\t\t\trefInfo, err := os.Stat(filepath.Join(refDir, name))\n\t\t\tif err != nil {\n\t\t\t\tt.Fatalf(\"ref binary did not create %s: %v\", name, err)\n\t\t\t}\n\t\t\tif goInfo.Mode().Perm() != refInfo.Mode().Perm() {\n\t\t\t\tt.Fatalf(\"permission mismatch on %s: go=%v ref=%v\",\n\t\t\t\t\tname, goInfo.Mode().Perm(), refInfo.Mode().Perm())\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc runCreationTest(t *testing.T, goBin, refBin string, args []string) {\n\tt.Helper()\n\tgoDir := t.TempDir()\n\trefDir := t.TempDir()\n\tgoRes := runBin(t, goBin, args, goDir)\n\trefRes := runBin(t, refBin, args, refDir)\n\tcompareResults(t, args, goRes, refRes)\n}\n\ntype binResult struct {\n\tstdout   []byte\n\tstderr   []byte\n\texitCode int\n}\n\nfunc runBin(t *testing.T, binary string, args []string, workDir string) binResult {\n\tt.Helper()\n\tctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)\n\tdefer cancel()\n\tcmd := exec.CommandContext(ctx, binary, args...)\n\tcmd.Dir = workDir\n\tcmd.Env = append(os.Environ(), \"LC_ALL=C\")\n\tvar stdout, stderr bytes.Buffer\n\tcmd.Stdout = &stdout\n\tcmd.Stderr = &stderr\n\terr := cmd.Run()\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatalf(\"binary %s timed out\", binary)\n\t}\n\texitCode := 0\n\tif err != nil {\n\t\tif exitErr, ok := errors.AsType[*exec.ExitError](err); ok {\n\t\t\texitCode = exitErr.ExitCode()\n\t\t} else {\n\t\t\tt.Fatalf(\"failed to start binary %s: %v\", binary, err)\n\t\t}\n\t}\n\treturn binResult{stdout: stdout.Bytes(), stderr: stderr.Bytes(), exitCode: exitCode}\n}\n\nfunc compareResults(t *testing.T, args []string, goRes, refRes binResult) {\n\tt.Helper()\n\tgoStdout := normalizeBinaryName(goRes.stdout)\n\trefStdout := normalizeBinaryName(refRes.stdout)\n\tgoStderr := normalizeBinaryName(goRes.stderr)\n\trefStderr := normalizeBinaryName(refRes.stderr)\n\tif !bytes.Equal(goStdout, refStdout) ||\n\t\t!bytes.Equal(goStderr, refStderr) ||\n\t\tgoRes.exitCode != refRes.exitCode {\n\t\tt.Fatalf(\"divergence detected\\n\"+\n\t\t\t\"  args:       %v\\n\"+\n\t\t\t\"  ref stdout: %q\\n\"+\n\t\t\t\"  go  stdout: %q\\n\"+\n\t\t\t\"  ref stderr: %q\\n\"+\n\t\t\t\"  go  stderr: %q\\n\"+\n\t\t\t\"  ref exit:   %d\\n\"+\n\t\t\t\"  go  exit:   %d\\n\",\n\t\t\targs, refStdout, goStdout, refStderr, goStderr, refRes.exitCode, goRes.exitCode)\n\t}\n}\n\nfunc TestSIGPIPE(t *testing.T) {\n\tgoBin := testutils.BuildBinary(t, \".\")\n\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\tdefer cancel()\n\tcmd := exec.CommandContext(ctx, goBin, \"--help\")\n\tstdout, err := cmd.StdoutPipe()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := cmd.Start(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tbuf := make([]byte, 1)\n\tif _, err := io.ReadFull(stdout, buf); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tstdout.Close()\n\terr = cmd.Wait()\n\tif ctx.Err() == context.DeadlineExceeded {\n\t\tt.Fatal(\"mkfifo timed out; SIGPIPE handler may not be installed\")\n\t}\n\tif err != nil {\n\t\tt.Fatalf(\"expected exit 0 on SIGPIPE, got: %v\", err)\n\t}\n}\n","numLines":333,"startLine":1,"totalLines":333}}}
