ng) error {\n68\t\tprefix, token, trailing := splitWhitespace(line)\n69\t\tif token == \"\" {\n70\t\t\treturn fmt.Errorf(\"invalid number: %q\", \"\")\n71\t\t}\n72\t\tval, err := parseNumber(token, fromUnit)\n73\t\tif err != nil {\n74\t\t\treturn err\n75\t\t}\n76\t\tout := formatNumber(val, toUnit)\n77\t\tif prefix != \"\" {\n78\t\t\tfieldWidth := len(prefix) + len(token)\n79\t\t\tif len(out) < fieldWidth {\n80\t\t\t\tout = strings.Repeat(\" \", fieldWidth-len(out)) + out\n81\t\t\t}\n82\t\t}\n83\t\tfmt.Printf(\"%s%s\\n\", out, trailing)\n84\t\treturn nil\n85\t}\n86\t\n87\tfunc processToken(token, fromUnit, toUnit string) error {\n88\t\tval, err := parseNumber(token, fromUnit)\n89\t\tif err != nil {\n90\t\t\treturn err\n91\t\t}\n92\t\tout := formatNumber(val, toUnit)\n93\t\tfmt.Println(out)\n94\t\treturn nil\n95\t}\n96\t\n97\tfunc splitWhitespace(s string) (prefix, body, suffix string) {\n98\t\ttrimLeft := strings.TrimLeft(s, \" \\t\")\n99\t\tprefix = s[:len(s)-len(trimLeft)]\n100\t\ttrimRight := strings.TrimRight(trimLeft, \" \\t\")\n101\t\tsuffix = trimLeft[len(trimRight):]\n102\t\tbody = trimRight\n103\t\treturn\n104\t}\n105\t\n106\tfunc parseNumber(s, unit string) (float64, error) {\n107\t\tif unit == \"none\" {\n108\t\t\tval, err := strconv.ParseFloat(s, 64)\n109\t\t\tif err != nil {\n110\t\t\t\tif hasSuffix(s) {\n111\t\t\t\t\treturn 0, fmt.Errorf(\n112\t\t\t\t\t\t\"rejecting suffix in input: '%s' (consider using --from)\", s)\n113\t\t\t\t}\n114\t\t\t\treturn 0, fmt.Errorf(\"invalid number: '%s'\", s)\n115\t\t\t}\n116\t\t\treturn val, nil\n117\t\t}\n118\t\tnumStr, mult, err := extractSuffix(s, unit)\n119\t\tif err != nil {\n120\t\t\treturn 0, err\n121\t\t}\n122\t\tval, err := strconv.ParseFloat(numStr, 64)\n123\t\tif err != nil {\n124\t\t\treturn 0, fmt.Errorf(\"invalid number: '%s'\", s)\n125\t\t}\n126\t\treturn val * mult, nil\n127\t}\n128\t\n129\tfunc hasSuffix(s string) bool {\n130\t\tif len(s) == 0 {\n131\t\t\treturn false\n132\t\t}\n133\t\tif len(s) >= 2 {\n134\t\t\ttail := s[len(s)-2:]\n135\t\t\tswitch tail {\n136\t\t\tcase \"Ki\", \"Mi\", \"Gi\", \"Ti\", \"Pi\", \"Ei\":\n137\t\t\t\treturn true\n138\t\t\t}\n139\t\t}\n140\t\tswitch s[len(s)-1] {\n141\t\tcase 'K', 'k', 'M', 'G', 'T', 'P', 'E':\n142\t\t\treturn true\n143\t\t}\n144\t\treturn false\n145\t}\n146\t\n147\tfunc extractSuffix(s, unit string) (string, float64, error) {\n148\t\tif len(s) == 0 {\n149\t\t\treturn \"\", 0, fmt.Errorf(\"invalid number: ''\")\n150\t\t}\n151\t\tbase := baseForUnit(unit)\n152\t\tsuffixMap := suffixMultipliers(unit, base)\n153\t\tif unit == \"iec-i\" && len(s) >= 2 {\n154\t\t\ttail := s[len(s)-2:]\n155\t\t\tif m, ok := suffixMap[tail]; ok {\n156\t\t\t\treturn s[:len(s)-2], m, nil\n157\t\t\t}\n158\t\t}\n159\t\ttail := s[len(s)-1:]\n160\t\tif m, ok := suffixMap[tail]; ok {\n161\t\t\treturn s[:len(s)-1], m, nil\n162\t\t}\n163\t\tif endsWithLetter(s) {\n164\t\t\treturn \"\", 0, fmt.Errorf(\"invalid suffix in input: '%s'\", s)\n165\t\t}\n166\t\treturn s, 1, nil\n167\t}\n168\t\n169\tfunc endsWithLetter(s string) bool {\n170\t\tif len(s) == 0 {\n171\t\t\treturn false\n172\t\t}\n173\t\tc := s[len(s)-1]\n174\t\treturn (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')\n175\t}\n176\t\n177\tfunc baseForUnit(unit string) float64 {\n178\t\tif unit == \"si\" {\n179\t\t\treturn 1000\n180\t\t}\n181\t\treturn 1024\n182\t}\n183\t\n184\tfunc suffixMultipliers(unit string, base float64) map[string]float64 {\n185\t\tm := make(map[string]float64)\n186\t\tswitch unit {\n187\t\tcase \"si\":\n188\t\t\tm[\"K\"] = base\n189\t\t\tm[\"k\"] = base\n190\t\t\tm[\"M\"] = math.Pow(base, 2)\n191\t\t\tm[\"G\"] = math.Pow(base, 3)\n192\t\t\tm[\"T\"] = math.Pow(base, 4)\n193\t\t\tm[\"P\"] = math.Pow(base, 5)\n194\t\t\tm[\"E\"] = math.Pow(base, 6)\n195\t\tcase \"iec\":\n196\t\t\tm[\"K\"] = base\n197\t\t\tm[\"M\"] = math.Pow(base, 2)\n198\t\t\tm[\"G\"] = math.Pow(base, 3)\n199\t\t\tm[\"T\"] = math.Pow(base, 4)\n200\t\t\tm[\"P\"] = math.Pow(base, 5)\n201\t\t\tm[\"E\"] = math.Pow(base, 6)\n202\t\tcase \"iec-i\":\n203\t\t\tm[\"Ki\"] = base\n204\t\t\tm[\"Mi\"] = math.Pow(base, 2)\n205\t\t\tm[\"Gi\"] = math.Pow(base, 3)\n206\t\t\tm[\"Ti\"] = math.Pow(base, 4)\n207\t\t\tm[\"Pi\"] = math.Pow(base, 5)\n208\t\t\tm[\"Ei\"] = math.Pow(base, 6)\n209\t\t}\n210\t\treturn m\n211\t}\n212\t\n213\tfunc formatNumber(val float64, unit string) string {\n214\t\tif unit == \"none\" {\n215\t\t\treturn formatRaw(val)\n216\t\t}\n217\t\tbase := baseForUnit(unit)\n218\t\tsuffixes := suffixesForUnit(unit)\n219\t\treturn formatWithSuffix(val, base, suffixes)\n220\t}\n221\t\n222\tfunc formatRaw(val float64) string {\n223\t\tif val == math.Trunc(val) && !math.IsInf(val, 0) {\n224\t\t\treturn strconv.FormatInt(int64(val), 10)\n225\t\t}\n226\t\treturn strconv.FormatFloat(val, 'f', -1, 64)\n227\t}\n228\t\n229\tfunc suffixesForUnit(unit string) []string {\n230\t\tswitch unit {\n231\t\tcase \"si\":\n232\t\t\treturn siSuffixes\n233\t\tcase \"iec\":\n234\t\t\treturn iecSuffixes\n235\t\tcase \"iec-i\":\n236\t\t\treturn ieciSuffixes\n237\t\t}\n238\t\treturn nil\n239\t}\n240\t\n241\tfunc formatWithSuffix(val, base float64, suffixes []string) string {\n242\t\tnegative := val < 0\n243\t\tabs := math.Abs(val)\n244\t\tlevel := 0\n245\t\tscaled := abs\n246\t\tfor level+1 < len(suffixes) && scaled >= base {\n247\t\t\tscaled /= base\n248\t\t\tlevel++\n249\t\t}\n250\t\tif level == 0 {\n251\t\t\treturn formatRaw(val)\n252\t\t}\n253\t\trounded1 := math.Ceil(scaled*10) / 10\n254\t\tif rounded1 < 10 {\n255\t\t\tif negative {\n256\t\t\t\treturn fmt.Sprintf(\"-%.1f%s\", rounded1, suffixes[level])\n257\t\t\t}\n258\t\t\treturn fmt.Sprintf(\"%.1f%s\", rounded1, suffixes[level])\n259\t\t}\n260\t\tintVal := int64(math.Ceil(scaled))\n261\t\tif float64(intVal) >= base && level+1 < len(suffixes) {\n262\t\t\tlevel++\n263\t\t\tnewScaled := abs / math.Pow(base, float64(level))\n264\t\t\tr := math.Ceil(newScaled*10) / 10\n265\t\t\tif r < 10 {\n266\t\t\t\tif negative {\n267\t\t\t\t\treturn fmt.Sprintf(\"-