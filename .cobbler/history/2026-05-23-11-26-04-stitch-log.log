{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012QwuVhqbHWieogXp46AFdB","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"os\"\n9\t\t\"os/user\"\n10\t\t\"strconv\"\n11\t\t\"syscall\"\n12\t\t\"time\"\n13\t\t\"unicode\"\n14\t\n15\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n16\t)\n17\t\n18\tfunc fmtError(path string, err error) error {\n19\t\tmsg := err.Error()\n20\t\tif pe, ok := err.(*os.PathError); ok {\n21\t\t\tmsg = pe.Err.Error()\n22\t\t}\n23\t\tif len(msg) > 0 && unicode.IsLower(rune(msg[0])) {\n24\t\t\tmsg = string(unicode.ToUpper(rune(msg[0]))) + msg[1:]\n25\t\t}\n26\t\treturn fmt.Errorf(\"stat: cannot stat '%s': %s\", path, msg)\n27\t}\n28\t\n29\tfunc fileTypeStrSize(mode os.FileMode, size int64) string {\n30\t\tif mode.IsRegular() && size == 0 {\n31\t\t\treturn \"regular empty file\"\n32\t\t}\n33\t\treturn fileTypeStr(mode)\n34\t}\n35\t\n36\tfunc fileTypeStr(mode os.FileMode) string {\n37\t\tswitch {\n38\t\tcase mode.IsRegular():\n39\t\t\treturn \"regular file\"\n40\t\tcase mode.IsDir():\n41\t\t\treturn \"directory\"\n42\t\tcase mode&os.ModeSymlink != 0:\n43\t\t\treturn \"symbolic link\"\n44\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n45\t\t\treturn \"character special file\"\n46\t\tcase mode&os.ModeDevice != 0:\n47\t\t\treturn \"block special file\"\n48\t\tcase mode&os.ModeNamedPipe != 0:\n49\t\t\treturn \"fifo\"\n50\t\tcase mode&os.ModeSocket != 0:\n51\t\t\treturn \"socket\"\n52\t\tdefault:\n53\t\t\treturn \"weird file\"\n54\t\t}\n55\t}\n56\t\n57\tfunc permString(mode os.FileMode) string {\n58\t\tvar buf [10]byte\n59\t\tbuf[0] = fileTypeChar(mode)\n60\t\tconst rwx = \"rwx\"\n61\t\tperm := mode.Perm()\n62\t\tfor i := range 9 {\n63\t\t\tif perm&(1<<uint(8-i)) != 0 {\n64\t\t\t\tbuf[1+i] = rwx[i%3]\n65\t\t\t} else {\n66\t\t\t\tbuf[1+i] = '-'\n67\t\t\t}\n68\t\t}\n69\t\tapplySpecialBits(mode, &buf)\n70\t\treturn string(buf[:])\n71\t}\n72\t\n73\tfunc fileTypeChar(mode os.FileMode) byte {\n74\t\tswitch {\n75\t\tcase mode.IsRegular():\n76\t\t\treturn '-'\n77\t\tcase mode.IsDir():\n78\t\t\treturn 'd'\n79\t\tcase mode&os.ModeSymlink != 0:\n80\t\t\treturn 'l'\n81\t\tcase mode&os.ModeDevice != 0 && mode&os.ModeCharDevice != 0:\n82\t\t\treturn 'c'\n83\t\tcase mode&os.ModeDevice != 0:\n84\t\t\treturn 'b'\n85\t\tcase mode&os.ModeNamedPipe != 0:\n86\t\t\treturn 'p'\n87\t\tcase mode&os.ModeSocket != 0:\n88\t\t\treturn 's'\n89\t\tdefault:\n90\t\t\treturn '?'\n91\t\t}\n92\t}\n93\t\n94\tfunc applySpecialBits(mode os.FileMode, buf *[10]byte) {\n95\t\tif mode&os.ModeSetuid != 0 {\n96\t\t\tif buf[3] == 'x' {\n97\t\t\t\tbuf[3] = 's'\n98\t\t\t} else {\n99\t\t\t\tbuf[3] = 'S'\n100\t\t\t}\n101\t\t}\n102\t\tif mode&os.ModeSetgid != 0 {\n103\t\t\tif buf[6] == 'x' {\n104\t\t\t\tbuf[6] = 's'\n105\t\t\t} else {\n106\t\t\t\tbuf[6] = 'S'\n107\t\t\t}\n108\t\t}\n109\t\tif mode&os.ModeSticky != 0 {\n110\t\t\tif buf[9] == 'x' {\n111\t\t\t\tbuf[9] = 't'\n112\t\t\t} else {\n113\t\t\t\tbuf[9] = 'T'\n114\t\t\t}\n115\t\t}\n116\t}\n117\t\n118\tfunc formatTime(t time.Time) string {\n119\t\treturn t.Format(\"2006-01-02 15:04:05.000000000 -0700\")\n120\t}\n121\t\n122\tfunc formatTimeBirth(t time.Time) string {\n123\t\tif t.IsZero() {\n124\t\t\treturn \"-\"\n125\t\t}\n126\t\treturn formatTime(t)\n127\t}\n128\t\n129\tfunc epochBirth(t time.Time) string {\n130\t\tif t.IsZero() {\n131\t\t\treturn \"0\"\n132\t\t}\n133\t\treturn fmt.Sprintf(\"%d\", t.Unix())\n134\t}\n135\t\n136\tfunc birthTime(fi *sys.FileInfo) time.Time {\n137\t\tif fi.Info == nil {\n138\t\t\treturn time.Time{}\n139\t\t}\n140\t\tstat, ok := fi.Info.Sys().(*syscall.Stat_t)\n141\t\tif !ok {\n142\t\t\treturn time.Time{}\n143\t\t}\n144\t\treturn time.Unix(stat.Birthtimespec.Sec, stat.Birthtimespec.Nsec)\n145\t}\n146\t\n147\tfunc rawModeFromInfo(fi *sys.FileInfo) uint16 {\n148\t\tif fi.Info == nil {\n149\t\t\tret