rgs[:len(args)-1]\n75\t\tcode := 0\n76\t\tif len(sources) > 1 {\n77\t\t\tcode = copyMultiple(sources, dest)\n78\t\t} else {\n79\t\t\tcode = copySingle(sources[0], dest)\n80\t\t}\n81\t\tif code != 0 {\n82\t\t\tos.Exit(code)\n83\t\t}\n84\t}\n85\t\n86\tfunc parseFlags(args []string) []string {\n87\t\tvar files []string\n88\t\tendOfFlags := false\n89\t\tfor i := 0; i < len(args); i++ {\n90\t\t\targ := args[i]\n91\t\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n92\t\t\t\tfiles = append(files, arg)\n93\t\t\t\tcontinue\n94\t\t\t}\n95\t\t\tif arg == \"--\" {\n96\t\t\t\tendOfFlags = true\n97\t\t\t\tcontinue\n98\t\t\t}\n99\t\t\tif strings.HasPrefix(arg, \"--\") {\n100\t\t\t\tapplyLongFlag(arg[2:])\n101\t\t\t\tcontinue\n102\t\t\t}\n103\t\t\trest := arg[1:]\n104\t\t\tfor j, c := range rest {\n105\t\t\t\tif c == 't' {\n106\t\t\t\t\tsuffix := rest[j+1:]\n107\t\t\t\t\tif suffix != \"\" {\n108\t\t\t\t\t\ttargetDir = suffix\n109\t\t\t\t\t} else if i+1 < len(args) {\n110\t\t\t\t\t\ti++\n111\t\t\t\t\t\ttargetDir = args[i]\n112\t\t\t\t\t}\n113\t\t\t\t\tbreak\n114\t\t\t\t}\n115\t\t\t\tapplyFlag(c)\n116\t\t\t}\n117\t\t}\n118\t\treturn files\n119\t}\n120\t\n121\tfunc applyFlag(c rune) {\n122\t\tswitch c {\n123\t\tcase 'f':\n124\t\t\towMode = owDefault\n125\t\t\tunlinkDest = true\n126\t\tcase 'i':\n127\t\t\towMode = owAskUser\n128\t\t\tunlinkDest = false\n129\t\tcase 'n':\n130\t\t\towMode = owNoClobber\n131\t\tcase 'r', 'R':\n132\t\t\trecursive = true\n133\t\tcase 'L':\n134\t\t\tderef = derefAlways\n135\t\tcase 'P':\n136\t\t\tderef = derefNever\n137\t\tcase 'p':\n138\t\t\tpreserveMode = true\n139\t\t\tpreserveOwnership = true\n140\t\t\tpreserveTimestamps = true\n141\t\tcase 'a':\n142\t\t\tapplyArchive()\n143\t\tcase 'v':\n144\t\t\tverbose = true\n145\t\t}\n146\t}\n147\t\n148\tfunc applyLongFlag(name string) {\n149\t\tif attr, ok := strings.CutPrefix(name, \"preserve=\"); ok {\n150\t\t\tparsePreserve(attr)\n151\t\t\treturn\n152\t\t}\n153\t\tif dir, ok := strings.CutPrefix(name, \"target-directory=\"); ok {\n154\t\t\ttargetDir = dir\n155\t\t\treturn\n156\t\t}\n157\t\tswitch name {\n158\t\tcase \"force\":\n159\t\t\towMode = owDefault\n160\t\t\tunlinkDest = true\n161\t\tcase \"interactive\":\n162\t\t\towMode = owAskUser\n163\t\t\tunlinkDest = false\n164\t\tcase \"no-clobber\":\n165\t\t\towMode = owNoClobber\n166\t\tcase \"recursive\":\n167\t\t\trecursive = true\n168\t\tcase \"dereference\":\n169\t\t\tderef = derefAlways\n170\t\tcase \"no-dereference\":\n171\t\t\tderef = derefNever\n172\t\tcase \"preserve\":\n173\t\t\tparsePreserve(\"mode,ownership,timestamps\")\n174\t\tcase \"archive\":\n175\t\t\tapplyArchive()\n176\t\tcase \"verbose\":\n177\t\t\tverbose = true\n178\t\t}\n179\t}\n180\t\n181\tfunc applyArchive() {\n182\t\trecursive = true\n183\t\tderef = derefNever\n184\t\tpreserveMode = true\n185\t\tpreserveOwnership = true\n186\t\tpreserveTimestamps = true\n187\t}\n188\t\n189\tfunc parsePreserve(attrList string) {\n190\t\tfor attr := range strings.SplitSeq(attrList, \",\") {\n191\t\t\tswitch attr {\n192\t\t\tcase \"mode\":\n193\t\t\t\tpreserveMode = true\n194\t\t\tcase \"ownership\":\n195\t\t\t\tpreserveOwnership = true\n196\t\t\tcase \"timestamps\":\n197\t\t\t\tpreserveTimestamps = true\n198\t\t\tcase \"all\":\n199\t\t\t\tpreserveMode = true\n200\t\t\t\tpreserveOwnership = true\n201\t\t\t\tpreserveTimestamps = true\n202\t\t\t}\n203\t\t}\n204\t}\n205\t\n206\tfunc shouldDeref() bool {\n207\t\tswitch deref {\n208\t\tcase derefAlways:\n209\t\t\treturn true\n210\t\tcase derefNever:\n211\t\t\treturn false\n212\t\tdefault:\n213\t\t\treturn !recursive\n214\t\t}\n215\t}\n216\t\n217\tfunc statSource(path string) (os.FileInfo, error) {\n218\t\tif shouldDeref() {\n219\t\t\treturn os.Stat(path)\n220\t\t}\n221\t\treturn os.Lstat(path)\n222\t}\n223\t\n224\tfunc copySingle(src, dest string) int {\n225\t\tinfo, err := os.Stat(dest)\n226\t\tif err == nil && info.IsDir() {\n227\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n228\t\t}\n229\t\tif err := copyFile(src, dest); err != nil {\n230\t\t\tif err != errDeclined && err != errPartial {\n231\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n232\t\t\t}\n233\t\t\treturn 1\n234\t\t}\n235\t\treturn 0\n236\t}\n237\t\n238\tfunc copyMultiple(sources []string, dest string) int {\n239\t\tinfo, err := os.Stat(dest)\n240\t\tif err != nil || !info.IsDir() {\n241\t\t\tfmt.Fprintf(os.Stderr, \"cp: target '%s': not a directory\\n\", dest)\n242\t\t\treturn 1\n243\t\t}\n244\t\tcode := 0\n245\t\tfor _, src := range sources {\n246\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n247\t\t\tif err := copyFile(src, target); err != nil {\n248\t\t\t\tif err != errDeclined && err != errPartial {\n249\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n250\t\t\t\t}\n251\t\t\t\tcode = 1\n252\t\t\t}\n253\t\t}\n254\t\treturn code\n255\t}\n256\t\n257\tfunc copyFile(src, dest string) error {\n258\t\tsrcInfo, err := statSource(src)\n259\t\tif err != nil {\n260\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n261\t\t}\n262\t\tif srcInfo.IsDir() {\n263\t\t\tif !recursive {\n264\t\t\t\treturn fmt.Errorf(\"-r not specified; omitting directory '%s'\", src)\n265\t\t\t}\n266\t\t\treturn copyDir(src, dest)\n267\t\t}\n268\t\tisLink := srcInfo.Mode()&os.ModeSymlink != 0\n269\t\tif destInfo, err := os.Stat(dest); err == nil {\n270\t\t\tif !isLink && os.SameFile(srcInfo, destInfo) {\n271\t\t\t\treturn fmt.Errorf(\"'%s' and '%s' are the same file\", src, dest)\n272\t\t\t}\n273\t\t\tswitch owMode {\n274\t\t\tcase owNoClobber:\n275\t\t\t\treturn nil\n276\t\t\tcase owAskUser:\n277\t\t\t\tif !confirmOverwrite(dest) {\n278\t\t\t\t\treturn errDeclined\n279\t\t\t\t}\n280\t\t\t}\n281\t\t}\n282\t\tif isLink {\n283\t\t\treturn copyLink(src, dest)\n284\t\t}\n285\t\treturn doCopy(src, dest, srcInfo.Mode())\n286\t}\n287\t\n288\tfunc copyDir(src, dest string) error {\n289\t\tsrcInfo, err := os.Stat(src)\n290\t\tif err != nil {\n291\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n292\t\t}\n293\t\tif err := os.Mkdir(dest, srcInfo.Mode().Perm()); err != nil && !os.IsExist(err) {\n294\t\t\treturn fmtPathErr(\"cannot create directory\", dest, err)\n295\t\t}\n296\t\tprintVerbose(src, dest)\n297\t\tentries, err := os.ReadDir(src)\n298\t\tif err != nil {\n299\t\t\treturn fmtPathErr(\"cannot read directory\", src, err)\n300\t\t}\n301\t\tfailed := false\n302\t\tfor _, e := range entries {\n303\t\t\ts := filepath.Join(src, e.Name())\n304\t\t\td := filepath.Join(dest, e.Name())\n305\t\t\tif err := copyFile(s, d); err != nil {\n306\t\t\t\tif err != errDeclined && err != errPartial {\n307\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n308\t\t\t\t}\n309\t\t\t\tfailed = true\n310\t\t\t}\n311\t\t}\n312\t\tif err := preserveAttrs(src, dest); err != nil {\n313\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n314\t\t\tfailed = true\n315\t\t}\n316\t\tif failed {\n317\t\t\treturn errPartial\n318\t\t}\n319\t\treturn nil\n320\t}\n321\t\n322\tfunc copyLink(src, dest string) error {\n323\t\ttarget, err := os.Readlink(src)\n324\t\tif err != nil {\n325\t\t\treturn fmtPathErr(\"cannot readlink\", src, err)\n326\t\t}\n327\t\tos.Remove(dest)\n328\t\tif err := os.Symlink(target, dest); err != nil {\n329\t\t\treturn fmtPathErr(\"cannot create symlink\", dest, err)\n330\t\t}\n331\t\tprintVerbose(src, dest)\n332\t\treturn preserveAttrs(src, dest)\n333\t}\n334\t\n335\tfunc doCopy(src, dest string, mode os.FileMode) error {\n336\t\tin, err := os.Open(src)\n337\t\tif err != nil {\n338\t\t\treturn fmtPathErr(\"cannot open\", src, err)\n339\t\t}\n340\t\tdefer in.Close()\n341\t\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n342\t\tif err != nil && unlinkDest {\n343\t\t\tos.Remove(dest)\n344\t\t\tout, err = os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n345\t\t}\n346\t\tif err != nil {\n347\t\t\treturn fmtPathErr(\"cannot create regular file\", dest, err)\n348\t\t}\n349\t\tdefer out.Close()\n350\t\tif _, err := io.Copy(out, in); err != nil {\n351\t\t\treturn err\n352\t\t}\n353\t\tif err := out.Close(); err != nil {\n354\t\t\treturn err\n355\t\t}\n356\t\tprintVerbose(src, dest)\n357\t\treturn preserveAttrs(src, dest)\n358\t}\n359\t\n360\tfunc confirmOverwrite(dest string) bool {\n361\t\tfmt.Fprintf(os.Stderr, \"cp: overwrite '%s'? \", dest)\n362\t\tline, _ := stdinReader.ReadString('\\n')\n363\t\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n364\t}\n365\t\n366\tfunc fmtPathErr(verb, path string, err error) error {\n367\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n368\t\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n369\t\t}\n370\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n371\t}\n372\t\n373\tfunc preserveAttrs(src, dest string) error {\n374\t\tif !preserveMode && !preserveOwnership && !preserveTimestamps {\n375\t\t\treturn nil\n376\t\t}\n377\t\tfi, err := sys.Lstat(src)\n378\t\tif err != nil {\n379\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n380\t\t}\n381\t\tisLink := fi.Mode&os.ModeSymlink != 0\n382\t\tif preserveMode && !isLink {\n383\t\t\tperm := fi.Mode & (os.ModePerm | os.ModeSetuid | os.ModeSetgid | os.ModeSticky)\n384\t\t\tif err := os.Chmod(dest, perm); err != nil {\n385\t\t\t\treturn fmtPathErr(\"preserving permissions for\", dest, err)\n386\t\t\t}\n387\t\t}\n388\t\tif preserveTimestamps && !isLink {\n389\t\t\tif err := os.Chtimes(dest, fi.AccessTime, fi.ModTime); err != nil {\n390\t\t\t\treturn fmtPathErr(\"preserving times for\", dest, err)\n391\t\t\t}\n392\t\t}\n393\t\tif preserveOwnership {\n394\t\t\tif err := os.Lchown(dest, int(fi.Uid), int(fi.Gid)); err != nil {\n395\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\",\n396\t\t\t\t\tfmtPathErr(\"preserving ownership for\", dest, err))\n397\t\t\t}\n398\t\t}\n399\t\treturn nil\n400\t}\n401\t\n402\tfunc printVerbose(src, dest string) {\n403\t\tif verbose {\n404\t\t\tfmt.Printf(\"'%s' -> '%s'\\n\", src, dest)\n405\t\t}\n406\t}\n407\t"}]},"parent_tool_use_id":null,"session_id":"f2328bfb-f30c-46fd-a083-af24b31ecb76","uuid":"e4748bbf-8930-4142-8f2a-cefa29ce073b","timestamp":"2026-05-21T00:47:20.005Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5395/cmd/cp/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/cp implements srd056-cp: copy files and directories.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype overwriteMode int\n\nconst (\n\towDefault   overwriteMode = iota\n\towAskUser                 // -i\n\towNoClobber               // -n\n)\n\ntype derefMode int\n\nconst (\n\tderefDefault derefMode = iota\n\tderefAlways\n\tderefNever\n)\n\nvar (\n\towMode      overwriteMode\n\tunlinkDest  bool\n\trecursive   bool\n\tderef       derefMode\n\tstdinReader = bufio.NewReader(os.Stdin)\n\terrDeclined = errors.New(\"declined\")\n\terrPartial         = errors.New(\"partial failure\")\n\tpreserveMode       bool\n\tpreserveOwnership  bool\n\tpreserveTimestamps bool\n\tverbose            bool\n\ttargetDir          string\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\targs := parseFlags(os.Args[1:])\n\tif targetDir != \"\" {\n\t\tif len(args) == 0 {\n\t\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n\t\t\tos.Exit(1)\n\t\t}\n\t\tcode := copyMultiple(args, targetDir)\n\t\tif code != 0 {\n\t\t\tos.Exit(code)\n\t\t}\n\t\treturn\n\t}\n\tif len(args) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n\t\tos.Exit(1)\n\t}\n\tif len(args) == 1 {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"cp: missing destination file operand after '%s'\\n\", args[0])\n\t\tos.Exit(1)\n\t}\n\tdest := args[len(args)-1]\n\tsources := args[:len(args)-1]\n\tcode := 0\n\tif len(sources) > 1 {\n\t\tcode = copyMultiple(sources, dest)\n\t} else {\n\t\tcode = copySingle(sources[0], dest)\n\t}\n\tif code != 0 {\n\t\tos.Exit(code)\n\t}\n}\n\nfunc parseFlags(args []string) []string {\n\tvar files []string\n\tendOfFlags := false\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tapplyLongFlag(arg[2:])\n\t\t\tcontinue\n\t\t}\n\t\trest := arg[1:]\n\t\tfor j, c := range rest {\n\t\t\tif c == 't' {\n\t\t\t\tsuffix := rest[j+1:]\n\t\t\t\tif suffix != \"\" {\n\t\t\t\t\ttargetDir = suffix\n\t\t\t\t} else if i+1 < len(args) {\n\t\t\t\t\ti++\n\t\t\t\t\ttargetDir = args[i]\n\t\t\t\t}\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tapplyFlag(c)\n\t\t}\n\t}\n\treturn files\n}\n\nfunc applyFlag(c rune) {\n\tswitch c {\n\tcase 'f':\n\t\towMode = owDefault\n\t\tunlinkDest = true\n\tcase 'i':\n\t\towMode = owAskUser\n\t\tunlinkDest = false\n\tcase 'n':\n\t\towMode = owNoClobber\n\tcase 'r', 'R':\n\t\trecursive = true\n\tcase 'L':\n\t\tderef = derefAlways\n\tcase 'P':\n\t\tderef = derefNever\n\tcase 'p':\n\t\tpreserveMode = true\n\t\tpreserveOwnership = true\n\t\tpreserveTimestamps = true\n\tcase 'a':\n\t\tapplyArchive()\n\tcase 'v':\n\t\tverbose = true\n\t}\n}\n\nfunc applyLongFlag(name string) {\n\tif attr, ok := strings.CutPrefix(name, \"preserve=\"); ok {\n\t\tparsePreserve(attr)\n\t\treturn\n\t}\n\tif dir, ok := strings.CutPrefix(name, \"target-directory=\"); ok {\n\t\ttargetDir = dir\n\t\treturn\n\t}\n\tswitch name {\n\tcase \"force\":\n\t\towMode = owDefault\n\t\tunlinkDest = true\n\tcase \"interactive\":\n\t\towMode = owAskUser\n\t\tunlinkDest = false\n\tcase \"no-clobber\":\n\t\towMode = owNoClobber\n\tcase \"recursive\":\n\t\trecursive = true\n\tcase \"dereference\":\n\t\tderef = derefAlways\n\tcase \"no-dereference\":\n\t\tderef = derefNever\n\tcase \"preserve\":\n\t\tparsePreserve(\"mode,ownership,timestamps\")\n\tcase \"archive\":\n\t\tapplyArchive()\n\tcase \"verbose\":\n\t\tverbose = true\n\t}\n}\n\nfunc applyArchive() {\n\trecursive = true\n\tderef = derefNever\n\tpreserveMode = true\n\tpreserveOwnership = true\n\tpreserveTimestamps = true\n}\n\nfunc parsePreserve(attrList string) {\n\tfor attr := range strings.SplitSeq(attrList, \",\") {\n\t\tswitch attr {\n\t\tcase \"mode\":\n\t\t\tpreserveMode = true\n\t\tcase \"ownership\":\n\t\t\tpreserveOwnership = true\n\t\tcase \"timestamps\":\n\t\t\tpreserveTimestamps = true\n\t\tcase \"all\":\n\t\t\tpreserveMode = true\n\t\t\tpreserveOwnership = true\n\t\t\tpreserveTimestamps = true\n\t\t}\n\t}\n}\n\nfunc shouldDeref() bool {\n\tswitch deref {\n\tcase derefAlways:\n\t\treturn true\n\tcase derefNever:\n\t\treturn false\n\tdefault:\n\t\treturn !recursive\n\t}\n}\n\nfunc statSource(path string) (os.FileInfo, error) {\n\tif shouldDeref() {\n\t\treturn os.Stat(path)\n\t}\n\treturn os.Lstat(path)\n}\n\nfunc copySingle(src, dest string) int {\n\tinfo, err := os.Stat(dest)\n\tif err == nil && info.IsDir() {\n\t\tdest = filepath.Join(dest, filepath.Base(src))\n\t}\n\tif err := copyFile(src, dest); err != nil {\n\t\tif err != errDeclined && err != errPartial {\n\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n\t\t}\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc copyMultiple(sources []string, dest string) int {\n\tinfo, err := os.Stat(dest)\n\tif err != nil || !info.IsDir() {\n\t\tfmt.Fprintf(os.Stderr, \"cp: target '%s': not a directory\\n\", dest)\n\t\treturn 1\n\t}\n\tcode := 0\n\tfor _, src := range sources {\n\t\ttarget := filepath.Join(dest, filepath.Base(src))\n\t\tif err := copyFile(src, target); err != nil {\n\t\t\tif err != errDeclined && err != errPartial {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n\t\t\t}\n\t\t\tcode = 1\n\t\t}\n\t}\n\treturn code\n}\n\nfunc copyFile(src, dest string) error {\n\tsrcInfo, err := statSource(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot stat\", src, err)\n\t}\n\tif srcInfo.IsDir() {\n\t\tif !recursive {\n\t\t\treturn fmt.Errorf(\"-r not specified; omitting directory '%s'\", src)\n\t\t}\n\t\treturn copyDir(src, dest)\n\t}\n\tisLink := srcInfo.Mode()&os.ModeSymlink != 0\n\tif destInfo, err := os.Stat(dest); err == nil {\n\t\tif !isLink && os.SameFile(srcInfo, destInfo) {\n\t\t\treturn fmt.Errorf(\"'%s' and '%s' are the same file\", src, dest)\n\t\t}\n\t\tswitch owMode {\n\t\tcase owNoClobber:\n\t\t\treturn nil\n\t\tcase owAskUser:\n\t\t\tif !confirmOverwrite(dest) {\n\t\t\t\treturn errDeclined\n\t\t\t}\n\t\t}\n\t}\n\tif isLink {\n\t\treturn copyLink(src, dest)\n\t}\n\treturn doCopy(src, dest, srcInfo.Mode())\n}\n\nfunc copyDir(src, dest string) error {\n\tsrcInfo, err := os.Stat(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot stat\", src, err)\n\t}\n\tif err := os.Mkdir(dest, srcInfo.Mode().Perm()); err != nil && !os.IsExist(err) {\n\t\treturn fmtPathErr(\"cannot create directory\", dest, err)\n\t}\n\tprintVerbose(src, dest)\n\tentries, err := os.ReadDir(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot read directory\", src, err)\n\t}\n\tfailed := false\n\tfor _, e := range entries {\n\t\ts := filepath.Join(src, e.Name())\n\t\td := filepath.Join(dest, e.Name())\n\t\tif err := copyFile(s, d); err != nil {\n\t\t\tif err != errDeclined && err != errPartial {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n\t\t\t}\n\t\t\tfailed = true\n\t\t}\n\t}\n\tif err := preserveAttrs(src, dest); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n\t\tfailed = true\n\t}\n\tif failed {\n\t\treturn errPartial\n\t}\n\treturn nil\n}\n\nfunc copyLink(src, dest string) error {\n\ttarget, err := os.Readlink(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot readlink\", src, err)\n\t}\n\tos.Remove(dest)\n\tif err := os.Symlink(target, dest); err != nil {\n\t\treturn fmtPathErr(\"cannot create symlink\", dest, err)\n\t}\n\tprintVerbose(src, dest)\n\treturn preserveAttrs(src, dest)\n}\n\nfunc doCopy(src, dest string, mode os.FileMode) error {\n\tin, err := os.Open(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot open\", src, err)\n\t}\n\tdefer in.Close()\n\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n\tif err != nil && unlinkDest {\n\t\tos.Remove(dest)\n\t\tout, err = os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n\t}\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot create regular file\", dest, err)\n\t}\n\tdefer out.Close()\n\tif _, err := io.Copy(out, in); err != nil {\n\t\treturn err\n\t}\n\tif err := out.Close(); err != nil {\n\t\treturn err\n\t}\n\tprintVerbose(src, dest)\n\treturn preserveAttrs(src, dest)\n}\n\nfunc confirmOverwrite(dest string) bool {\n\tfmt.Fprintf(os.Stderr, \"cp: overwrite '%s'? \", dest)\n\tline, _ := stdinReader.ReadString('\\n')\n\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n}\n\nfunc fmtPathErr(verb, path string, err error) error {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n\t}\n\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n}\n\nfunc preserveAttrs(src, dest string) error {\n\tif !preserveMode && !preserveOwnership && !preserveTimestamps {\n\t\treturn nil\n\t}\n\tfi, err := sys.Lstat(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot stat\", src, err)\n\t}\n\tisLink := fi.Mode&os.ModeSymlink != 0\n\tif preserveMode && !isLink {\n\t\tperm := fi.Mode & (os.ModePerm | os.ModeSetuid | os.ModeSetgid | os.ModeSticky)\n\t\tif err := os.Chmod(dest, perm); err != nil {\n\t\t\treturn fmtPathErr(\"preserving permissions for\", dest, err)\n\t\t}\n\t}\n\tif preserveTimestamps && !isLink {\n\t\tif err := os.Chtimes(dest, fi.AccessTime, fi.ModTime); err != nil {\n\t\t\treturn fmtPathErr(\"preserving times for\", dest, err)\n\t\t}\n\t}\n\tif preserveOwnership {\n\t\tif err := os.Lchown(dest, int(fi.Uid), int(fi.Gid)); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\",\n\t\t\t\tfmtPathErr(\"preserving ownership for\", dest, err))\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc printVerbose(src, dest string) {\n\tif verbose {\n\t\tfmt.Printf(\"'%s' -> '%s'\\n\", src, dest)\n\t}\n}\n","numLines":407,"startLine":1,"totalLines":407}}}
