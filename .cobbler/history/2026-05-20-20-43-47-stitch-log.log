nc main() {\n\tsys.InstallSIGPIPEHandler()\n\targs := parseFlags(os.Args[1:])\n\tif len(args) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n\t\tos.Exit(1)\n\t}\n\tif len(args) == 1 {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"cp: missing destination file operand after '%s'\\n\", args[0])\n\t\tos.Exit(1)\n\t}\n\tdest := args[len(args)-1]\n\tsources := args[:len(args)-1]\n\tcode := 0\n\tif len(sources) > 1 {\n\t\tcode = copyMultiple(sources, dest)\n\t} else {\n\t\tcode = copySingle(sources[0], dest)\n\t}\n\tif code != 0 {\n\t\tos.Exit(code)\n\t}\n}\n\nfunc parseFlags(args []string) []string {\n\tvar files []string\n\tendOfFlags := false\n\tfor i := 0; i < len(args); i++ {\n\t\targ := args[i]\n\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tapplyLongFlag(arg[2:])\n\t\t\tcontinue\n\t\t}\n\t\trest := arg[1:]\n\t\tfor j, c := range rest {\n\t\t\tif c == 't' {\n\t\t\t\tsuffix := rest[j+1:]\n\t\t\t\tif suffix != \"\" {\n\t\t\t\t\ttargetDir = suffix\n\t\t\t\t} else if i+1 < len(args) {\n\t\t\t\t\ti++\n\t\t\t\t\ttargetDir = args[i]\n\t\t\t\t}\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tapplyFlag(c)\n\t\t}\n\t}\n\treturn files\n}\n\nfunc applyFlag(c rune) {\n\tswitch c {\n\tcase 'f':\n\t\towMode = owDefault\n\t\tunlinkDest = true\n\tcase 'i':\n\t\towMode = owAskUser\n\t\tunlinkDest = false\n\tcase 'n':\n\t\towMode = owNoClobber\n\tcase 'r', 'R':\n\t\trecursive = true\n\tcase 'L':\n\t\tderef = derefAlways\n\tcase 'P':\n\t\tderef = derefNever\n\tcase 'p':\n\t\tpreserveMode = true\n\t\tpreserveOwnership = true\n\t\tpreserveTimestamps = true\n\tcase 'a':\n\t\tapplyArchive()\n\tcase 'v':\n\t\tverbose = true\n\t}\n}\n\nfunc applyLongFlag(name string) {\n\tif attr, ok := strings.CutPrefix(name, \"preserve=\"); ok {\n\t\tparsePreserve(attr)\n\t\treturn\n\t}\n\tswitch name {\n\tcase \"force\":\n\t\towMod