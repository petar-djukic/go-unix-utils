\t\n173\t\tt.Run(\"r1_1_error_one_arg\", func(t *testing.T) {\n174\t\t\tdir := t.TempDir()\n175\t\t\twriteFile(t, dir, \"src.txt\", \"hello\\n\")\n176\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n177\t\t\t\t{\n178\t\t\t\t\tName:      \"one_arg\",\n179\t\t\t\t\tArgs:      []string{\"src.txt\"},\n180\t\t\t\t\tWorkDir:   dir,\n181\t\t\t\t\tExitCode:  1,\n182\t\t\t\t\tNormalize: errNorm,\n183\t\t\t\t\tEnv:       env,\n184\t\t\t\t},\n185\t\t\t})\n186\t\t})\n187\t\n188\t\tt.Run(\"r1_2_interactive_yes\", func(t *testing.T) {\n189\t\t\tdir := t.TempDir()\n190\t\t\twriteFile(t, dir, \"src.txt\", \"new\\n\")\n191\t\t\twriteFile(t, dir, \"dest.txt\", \"old\\n\")\n192\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n193\t\t\t\t{\n194\t\t\t\t\tName:      \"yes\",\n195\t\t\t\t\tArgs:      []string{\"-i\", \"src.txt\", \"dest.txt\"},\n196\t\t\t\t\tStdin:     []byte(\"y\\n\"),\n197\t\t\t\t\tWorkDir:   dir,\n198\t\t\t\t\tEnv:       env,\n199\t\t\t\t\tNormalize: promptNorm,\n200\t\t\t\t\tExpectedFiles: map[string][]byte{\n201\t\t\t\t\t\t\"dest.txt\": []byte(\"new\\n\"),\n202\t\t\t\t\t},\n203\t\t\t\t},\n204\t\t\t})\n205\t\t})\n206\t\n207\t\tt.Run(\"r1_2_interactive_no\", func(t *testing.T) {\n208\t\t\tdir := t.TempDir()\n209\t\t\twriteFile(t, dir, \"src.txt\", \"new\\n\")\n210\t\t\twriteFile(t, dir, \"dest.txt\", \"old\\n\")\n211\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n212\t\t\t\t{\n213\t\t\t\t\tName:      \"no\",\n214\t\t\t\t\tArgs:      []string{\"-i\", \"src.txt\", \"dest.txt\"},\n215\t\t\t\t\tStdin:     []byte(\"n\\n\"),\n216\t\t\t\t\tWorkDir:   dir,\n217\t\t\t\t\tExitCode:  1,\n218\t\t\t\t\tEnv:       env,\n219\t\t\t\t\tNormalize: promptNorm,\n220\t\t\t\t\tExpectedFiles: map[string][]byte{\n221\t\t\t\t\t\t\"dest.txt\": []byte(\"old\\n\"),\n222\t\t\t\t\t},\n223\t\t\t\t},\n224\t\t\t})\n225\t\t})\n226\t\n227\t\tt.Run(\"r1_3_force_readonly\", func(t *testing.T) {\n228\t\t\tdir := t.TempDir()\n229\t\t\twriteFile(