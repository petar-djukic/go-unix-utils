{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CU9Gszq27xQTFZXY8AWQNy","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/cp implements srd056-cp: copy files and directories.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"bufio\"\n9\t\t\"errors\"\n10\t\t\"fmt\"\n11\t\t\"io\"\n12\t\t\"os\"\n13\t\t\"path/filepath\"\n14\t\t\"strings\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\ttype overwriteMode int\n20\t\n21\tconst (\n22\t\towDefault   overwriteMode = iota\n23\t\towAskUser                 // -i\n24\t\towNoClobber               // -n\n25\t)\n26\t\n27\ttype derefMode int\n28\t\n29\tconst (\n30\t\tderefDefault derefMode = iota\n31\t\tderefAlways\n32\t\tderefNever\n33\t)\n34\t\n35\tvar (\n36\t\towMode      overwriteMode\n37\t\tunlinkDest  bool\n38\t\trecursive   bool\n39\t\tderef       derefMode\n40\t\tstdinReader = bufio.NewReader(os.Stdin)\n41\t\terrDeclined = errors.New(\"declined\")\n42\t\terrPartial         = errors.New(\"partial failure\")\n43\t\tpreserveMode       bool\n44\t\tpreserveOwnership  bool\n45\t\tpreserveTimestamps bool\n46\t\tverbose            bool\n47\t)\n48\t\n49\tfunc main() {\n50\t\tsys.InstallSIGPIPEHandler()\n51\t\targs := parseFlags(os.Args[1:])\n52\t\tif len(args) == 0 {\n53\t\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n54\t\t\tos.Exit(1)\n55\t\t}\n56\t\tif len(args) == 1 {\n57\t\t\tfmt.Fprintf(os.Stderr,\n58\t\t\t\t\"cp: missing destination file operand after '%s'\\n\", args[0])\n59\t\t\tos.Exit(1)\n60\t\t}\n61\t\tdest := args[len(args)-1]\n62\t\tsources := args[:len(args)-1]\n63\t\tcode := 0\n64\t\tif len(sources) > 1 {\n65\t\t\tcode = copyMultiple(sources, dest)\n66\t\t} else {\n67\t\t\tcode = copySingle(sources[0], dest)\n68\t\t}\n69\t\tif code != 0 {\n70\t\t\tos.Exit(code)\n71\t\t}\n72\t}\n73\t\n74\tfunc parseFlags(args []string) []string {\n75\t\tvar files []string\n76\t\tendOfFlags := false\n77\t\tfor _, arg := range args {\n78\t\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n79\t\t\t\tfiles = append(files, arg)\n80\t\t\t\tcontinue\n81\t\t\t}\n82\t\t\tif arg == \"--\" {\n83\t\t\t\tendOfFlags = true\n84\t\t\t\tcontinue\n85\t\t\t}\n86\t\t\tif strings.HasPrefix(arg, \"--\") {\n87\t\t\t\tapplyLongFlag(arg[2:])\n88\t\t\t\tcontinue\n89\t\t\t}\n90\t\t\tfor _, c := range arg[1:] {\n91\t\t\t\tapplyFlag(c)\n92\t\t\t}\n93\t\t}\n94\t\treturn files\n95\t}\n96\t\n97\tfunc applyFlag(c rune) {\n98\t\tswitch c {\n99\t\tcase 'f':\n100\t\t\towMode = owDefault\n101\t\t\tunlinkDest = true\n102\t\tcase 'i':\n103\t\t\towMode = owAskUser\n104\t\t\tunlinkDest = false\n105\t\tcase 'n':\n106\t\t\towMode = owNoClobber\n107\t\tcase 'r', 'R':\n108\t\t\trecursive = true\n109\t\tcase 'L':\n110\t\t\tderef = derefAlways\n111\t\tcase 'P':\n112\t\t\tderef = derefNever\n113\t\tcase 'p':\n114\t\t\tpreserveMode = true\n115\t\t\tpreserveOwnership = true\n116\t\t\tpreserveTimestamps = true\n117\t\tcase 'a':\n118\t\t\tapplyArchive()\n119\t\tcase 'v':\n120\t\t\tverbose = true\n121\t\t}\n122\t}\n123\t\n124\tfunc applyLongFlag(name string) {\n125\t\tif attr, ok := strings.CutPrefix(name, \"preserve=\"); ok {\n126\t\t\tparsePreserve(attr)\n127\t\t\treturn\n128\t\t}\n129\t\tswitch name {\n130\t\tcase \"force\":\n131\t\t\towMode = owDefault\n132\t\t\tunlinkDest = true\n133\t\tcase \"interactive\":\n134\t\t\towMode = owAskUser\n135\t\t\tunlinkDest = false\n136\t\tcase \"no-clobber\":\n137\t\t\towMode = owNoClobber\n138\t\tcase \"recursive\":\n139\t\t\trecursive = true\n140\t\tcase \"dereference\":\n141\t\t\tderef = derefAlways\n142\t\tcase \"no-dereference\":\n143\t\t\tderef = derefNever\n144\t\tcase \"preserve\":\n145\t\t\tparsePreserve(\"mode,ownership,timestamps\")\n146\t\tcase \"archive\":\n147\t\t\tapplyArchive()\n148\t\tcase \"verbose\":\n149\t\t\tverbose = true\n150\t\t}\n151\t}\n152\t\n153\tfunc applyArchive() {\n154\t\trecursive = true\n155\t\tderef = derefNever\n156\t\tpreserveMode = true\n157\t\tpreserveOwnership = true\n158\t\tpreserveTimestamps = true\n159\t}\n160\t\n161\tfunc parsePreserve(attrList string) {\n162\t\tfor attr := range strings.SplitSeq(attrList, \",\") {\n163\t\t\tswitch attr {\n164\t\t\tcase \"mode\":\n165\t\t\t\tpreserveMode = true\n166\t\t\tcase \"ownership\":\n167\t\t\t\tpreserveOwnership = true\n168\t\t\tcase \"timestamps\":\n169\t\t\t\tpreserveTimestamps = true\n170\t\t\tcase \"all\":\n171\t\t\t\tpreserveMode = true\n172\t\t\t\tpreserveOwnership = true\n173\t\t\t\tpreserveTimestamps = true\n174\t\t\t}\n175\t\t}\n176\t}\n177\t\n178\tfunc shouldDeref() bool {\n179\t\tswitch deref {\n180\t\tcase derefAlways:\n181\t\t\treturn true\n182\t\tcase derefNever:\n183\t\t\treturn false\n184\t\tdefault:\n185\t\t\treturn !recursive\n186\t\t}\n187\t}\n188\t\n189\tfunc statSource(path string) (os.FileInfo, error) {\n190\t\tif shouldDeref() {\n191\t\t\treturn os.Stat(path)\n192\t\t}\n193\t\treturn os.Lstat(path)\n194\t}\n195\t\n196\tfunc copySingle(src, dest string) int {\n197\t\tinfo, err := os.Stat(dest)\n198\t\tif err == nil && info.IsDir() {\n199\t\t\tdest = filepath.Join(dest, filepath.Base(src))\n200\t\t}\n201\t\tif err := copyFile(src, dest); err != nil {\n202\t\t\tif err != errDeclined && err != errPartial {\n203\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n204\t\t\t}\n205\t\t\treturn 1\n206\t\t}\n207\t\treturn 0\n208\t}\n209\t\n210\tfunc copyMultiple(sources []string, dest string) int {\n211\t\tinfo, err := os.Stat(dest)\n212\t\tif err != nil || !info.IsDir() {\n213\t\t\tfmt.Fprintf(os.Stderr, \"cp: target '%s': not a directory\\n\", dest)\n214\t\t\treturn 1\n215\t\t}\n216\t\tcode := 0\n217\t\tfor _, src := range sources {\n218\t\t\ttarget := filepath.Join(dest, filepath.Base(src))\n219\t\t\tif err := copyFile(src, target); err != nil {\n220\t\t\t\tif err != errDeclined && err != errPartial {\n221\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n222\t\t\t\t}\n223\t\t\t\tcode = 1\n224\t\t\t}\n225\t\t}\n226\t\treturn code\n227\t}\n228\t\n229\tfunc copyFile(src, dest string) error {\n230\t\tsrcInfo, err := statSource(src)\n231\t\tif err != nil {\n232\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n233\t\t}\n234\t\tif srcInfo.IsDir() {\n235\t\t\tif !recursive {\n236\t\t\t\treturn fmt.Errorf(\"-r not specified; omitting directory '%s'\", src)\n237\t\t\t}\n238\t\t\treturn copyDir(src, dest)\n239\t\t}\n240\t\tisLink := srcInfo.Mode()&os.ModeSymlink != 0\n241\t\tif destInfo, err := os.Stat(dest); err == nil {\n242\t\t\tif !isLink && os.SameFile(srcInfo, destInfo) {\n243\t\t\t\treturn fmt.Errorf(\"'%s' and '%s' are the same file\", src, dest)\n244\t\t\t}\n245\t\t\tswitch owMode {\n246\t\t\tcase owNoClobber:\n247\t\t\t\treturn nil\n248\t\t\tcase owAskUser:\n249\t\t\t\tif !confirmOverwrite(dest) {\n250\t\t\t\t\treturn errDeclined\n251\t\t\t\t}\n252\t\t\t}\n253\t\t}\n254\t\tif isLink {\n255\t\t\treturn copyLink(src, dest)\n256\t\t}\n257\t\treturn doCopy(src, dest, srcInfo.Mode())\n258\t}\n259\t\n260\tfunc copyDir(src, dest string) error {\n261\t\tsrcInfo, err := os.Stat(src)\n262\t\tif err != nil {\n263\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n264\t\t}\n265\t\tif err := os.Mkdir(dest, srcInfo.Mode().Perm()); err != nil && !os.IsExist(err) {\n266\t\t\treturn fmtPathErr(\"cannot create directory\", dest, err)\n267\t\t}\n268\t\tprintVerbose(src, dest)\n269\t\tentries, err := os.ReadDir(src)\n270\t\tif err != nil {\n271\t\t\treturn fmtPathErr(\"cannot read directory\", src, err)\n272\t\t}\n273\t\tfailed := false\n274\t\tfor _, e := range entries {\n275\t\t\ts := filepath.Join(src, e.Name())\n276\t\t\td := filepath.Join(dest, e.Name())\n277\t\t\tif err := copyFile(s, d); err != nil {\n278\t\t\t\tif err != errDeclined && err != errPartial {\n279\t\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n280\t\t\t\t}\n281\t\t\t\tfailed = true\n282\t\t\t}\n283\t\t}\n284\t\tif err := preserveAttrs(src, dest); err != nil {\n285\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n286\t\t\tfailed = true\n287\t\t}\n288\t\tif failed {\n289\t\t\treturn errPartial\n290\t\t}\n291\t\treturn nil\n292\t}\n293\t\n294\tfunc copyLink(src, dest string) error {\n295\t\ttarget, err := os.Readlink(src)\n296\t\tif err != nil {\n297\t\t\treturn fmtPathErr(\"cannot readlink\", src, err)\n298\t\t}\n299\t\tos.Remove(dest)\n300\t\tif err := os.Symlink(target, dest); err != nil {\n301\t\t\treturn fmtPathErr(\"cannot create symlink\", dest, err)\n302\t\t}\n303\t\tprintVerbose(src, dest)\n304\t\treturn preserveAttrs(src, dest)\n305\t}\n306\t\n307\tfunc doCopy(src, dest string, mode os.FileMode) error {\n308\t\tin, err := os.Open(src)\n309\t\tif err != nil {\n310\t\t\treturn fmtPathErr(\"cannot open\", src, err)\n311\t\t}\n312\t\tdefer in.Close()\n313\t\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n314\t\tif err != nil && unlinkDest {\n315\t\t\tos.Remove(dest)\n316\t\t\tout, err = os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n317\t\t}\n318\t\tif err != nil {\n319\t\t\treturn fmtPathErr(\"cannot create regular file\", dest, err)\n320\t\t}\n321\t\tdefer out.Close()\n322\t\tif _, err := io.Copy(out, in); err != nil {\n323\t\t\treturn err\n324\t\t}\n325\t\tif err := out.Close(); err != nil {\n326\t\t\treturn err\n327\t\t}\n328\t\tprintVerbose(src, dest)\n329\t\treturn preserveAttrs(src, dest)\n330\t}\n331\t\n332\tfunc confirmOverwrite(dest string) bool {\n333\t\tfmt.Fprintf(os.Stderr, \"cp: overwrite '%s'? \", dest)\n334\t\tline, _ := stdinReader.ReadString('\\n')\n335\t\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n336\t}\n337\t\n338\tfunc fmtPathErr(verb, path string, err error) error {\n339\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n340\t\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n341\t\t}\n342\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n343\t}\n344\t\n345\tfunc preserveAttrs(src, dest string) error {\n346\t\tif !preserveMode && !preserveOwnership && !preserveTimestamps {\n347\t\t\treturn nil\n348\t\t}\n349\t\tfi, err := sys.Lstat(src)\n350\t\tif err != nil {\n351\t\t\treturn fmtPathErr(\"cannot stat\", src, err)\n352\t\t}\n353\t\tisLink := fi.Mode&os.ModeSymlink != 0\n354\t\tif preserveMode && !isLink {\n355\t\t\tperm := fi.Mode & (os.ModePerm | os.ModeSetuid | os.ModeSetgid | os.ModeSticky)\n356\t\t\tif err := os.Chmod(dest, perm); err != nil {\n357\t\t\t\treturn fmtPathErr(\"preserving permissions for\", dest, err)\n358\t\t\t}\n359\t\t}\n360\t\tif preserveTimestamps && !isLink {\n361\t\t\tif err := os.Chtimes(dest, fi.AccessTime, fi.ModTime); err != nil {\n362\t\t\t\treturn fmtPathErr(\"preserving times for\", dest, err)\n363\t\t\t}\n364\t\t}\n365\t\tif preserveOwnership {\n366\t\t\tif err := os.Lchown(dest, int(fi.Uid), int(fi.Gid)); err != nil {\n367\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\",\n368\t\t\t\t\tfmtPathErr(\"preserving ownership for\", dest, err))\n369\t\t\t}\n370\t\t}\n371\t\treturn nil\n372\t}\n373\t\n374\tfunc printVerbose(src, dest string) {\n375\t\tif verbose {\n376\t\t\tfmt.Printf(\"'%s' -> '%s'\\n\", src, dest)\n377\t\t}\n378\t}\n379\t"}]},"parent_tool_use_id":null,"session_id":"f2328bfb-f30c-46fd-a083-af24b31ecb76","uuid":"521eb546-59d5-42cf-b922-5b23cd7f639e","timestamp":"2026-05-21T00:43:55.747Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5395/cmd/cp/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/cp implements srd056-cp: copy files and directories.\npackage main\n\nimport (\n\t\"bufio\"\n\t\"errors\"\n\t\"fmt\"\n\t\"io\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\ntype overwriteMode int\n\nconst (\n\towDefault   overwriteMode = iota\n\towAskUser                 // -i\n\towNoClobber               // -n\n)\n\ntype derefMode int\n\nconst (\n\tderefDefault derefMode = iota\n\tderefAlways\n\tderefNever\n)\n\nvar (\n\towMode      overwriteMode\n\tunlinkDest  bool\n\trecursive   bool\n\tderef       derefMode\n\tstdinReader = bufio.NewReader(os.Stdin)\n\terrDeclined = errors.New(\"declined\")\n\terrPartial         = errors.New(\"partial failure\")\n\tpreserveMode       bool\n\tpreserveOwnership  bool\n\tpreserveTimestamps bool\n\tverbose            bool\n)\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\targs := parseFlags(os.Args[1:])\n\tif len(args) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"cp: missing file operand\\n\")\n\t\tos.Exit(1)\n\t}\n\tif len(args) == 1 {\n\t\tfmt.Fprintf(os.Stderr,\n\t\t\t\"cp: missing destination file operand after '%s'\\n\", args[0])\n\t\tos.Exit(1)\n\t}\n\tdest := args[len(args)-1]\n\tsources := args[:len(args)-1]\n\tcode := 0\n\tif len(sources) > 1 {\n\t\tcode = copyMultiple(sources, dest)\n\t} else {\n\t\tcode = copySingle(sources[0], dest)\n\t}\n\tif code != 0 {\n\t\tos.Exit(code)\n\t}\n}\n\nfunc parseFlags(args []string) []string {\n\tvar files []string\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags || arg == \"\" || arg[0] != '-' {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif arg == \"--\" {\n\t\t\tendOfFlags = true\n\t\t\tcontinue\n\t\t}\n\t\tif strings.HasPrefix(arg, \"--\") {\n\t\t\tapplyLongFlag(arg[2:])\n\t\t\tcontinue\n\t\t}\n\t\tfor _, c := range arg[1:] {\n\t\t\tapplyFlag(c)\n\t\t}\n\t}\n\treturn files\n}\n\nfunc applyFlag(c rune) {\n\tswitch c {\n\tcase 'f':\n\t\towMode = owDefault\n\t\tunlinkDest = true\n\tcase 'i':\n\t\towMode = owAskUser\n\t\tunlinkDest = false\n\tcase 'n':\n\t\towMode = owNoClobber\n\tcase 'r', 'R':\n\t\trecursive = true\n\tcase 'L':\n\t\tderef = derefAlways\n\tcase 'P':\n\t\tderef = derefNever\n\tcase 'p':\n\t\tpreserveMode = true\n\t\tpreserveOwnership = true\n\t\tpreserveTimestamps = true\n\tcase 'a':\n\t\tapplyArchive()\n\tcase 'v':\n\t\tverbose = true\n\t}\n}\n\nfunc applyLongFlag(name string) {\n\tif attr, ok := strings.CutPrefix(name, \"preserve=\"); ok {\n\t\tparsePreserve(attr)\n\t\treturn\n\t}\n\tswitch name {\n\tcase \"force\":\n\t\towMode = owDefault\n\t\tunlinkDest = true\n\tcase \"interactive\":\n\t\towMode = owAskUser\n\t\tunlinkDest = false\n\tcase \"no-clobber\":\n\t\towMode = owNoClobber\n\tcase \"recursive\":\n\t\trecursive = true\n\tcase \"dereference\":\n\t\tderef = derefAlways\n\tcase \"no-dereference\":\n\t\tderef = derefNever\n\tcase \"preserve\":\n\t\tparsePreserve(\"mode,ownership,timestamps\")\n\tcase \"archive\":\n\t\tapplyArchive()\n\tcase \"verbose\":\n\t\tverbose = true\n\t}\n}\n\nfunc applyArchive() {\n\trecursive = true\n\tderef = derefNever\n\tpreserveMode = true\n\tpreserveOwnership = true\n\tpreserveTimestamps = true\n}\n\nfunc parsePreserve(attrList string) {\n\tfor attr := range strings.SplitSeq(attrList, \",\") {\n\t\tswitch attr {\n\t\tcase \"mode\":\n\t\t\tpreserveMode = true\n\t\tcase \"ownership\":\n\t\t\tpreserveOwnership = true\n\t\tcase \"timestamps\":\n\t\t\tpreserveTimestamps = true\n\t\tcase \"all\":\n\t\t\tpreserveMode = true\n\t\t\tpreserveOwnership = true\n\t\t\tpreserveTimestamps = true\n\t\t}\n\t}\n}\n\nfunc shouldDeref() bool {\n\tswitch deref {\n\tcase derefAlways:\n\t\treturn true\n\tcase derefNever:\n\t\treturn false\n\tdefault:\n\t\treturn !recursive\n\t}\n}\n\nfunc statSource(path string) (os.FileInfo, error) {\n\tif shouldDeref() {\n\t\treturn os.Stat(path)\n\t}\n\treturn os.Lstat(path)\n}\n\nfunc copySingle(src, dest string) int {\n\tinfo, err := os.Stat(dest)\n\tif err == nil && info.IsDir() {\n\t\tdest = filepath.Join(dest, filepath.Base(src))\n\t}\n\tif err := copyFile(src, dest); err != nil {\n\t\tif err != errDeclined && err != errPartial {\n\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n\t\t}\n\t\treturn 1\n\t}\n\treturn 0\n}\n\nfunc copyMultiple(sources []string, dest string) int {\n\tinfo, err := os.Stat(dest)\n\tif err != nil || !info.IsDir() {\n\t\tfmt.Fprintf(os.Stderr, \"cp: target '%s': not a directory\\n\", dest)\n\t\treturn 1\n\t}\n\tcode := 0\n\tfor _, src := range sources {\n\t\ttarget := filepath.Join(dest, filepath.Base(src))\n\t\tif err := copyFile(src, target); err != nil {\n\t\t\tif err != errDeclined && err != errPartial {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n\t\t\t}\n\t\t\tcode = 1\n\t\t}\n\t}\n\treturn code\n}\n\nfunc copyFile(src, dest string) error {\n\tsrcInfo, err := statSource(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot stat\", src, err)\n\t}\n\tif srcInfo.IsDir() {\n\t\tif !recursive {\n\t\t\treturn fmt.Errorf(\"-r not specified; omitting directory '%s'\", src)\n\t\t}\n\t\treturn copyDir(src, dest)\n\t}\n\tisLink := srcInfo.Mode()&os.ModeSymlink != 0\n\tif destInfo, err := os.Stat(dest); err == nil {\n\t\tif !isLink && os.SameFile(srcInfo, destInfo) {\n\t\t\treturn fmt.Errorf(\"'%s' and '%s' are the same file\", src, dest)\n\t\t}\n\t\tswitch owMode {\n\t\tcase owNoClobber:\n\t\t\treturn nil\n\t\tcase owAskUser:\n\t\t\tif !confirmOverwrite(dest) {\n\t\t\t\treturn errDeclined\n\t\t\t}\n\t\t}\n\t}\n\tif isLink {\n\t\treturn copyLink(src, dest)\n\t}\n\treturn doCopy(src, dest, srcInfo.Mode())\n}\n\nfunc copyDir(src, dest string) error {\n\tsrcInfo, err := os.Stat(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot stat\", src, err)\n\t}\n\tif err := os.Mkdir(dest, srcInfo.Mode().Perm()); err != nil && !os.IsExist(err) {\n\t\treturn fmtPathErr(\"cannot create directory\", dest, err)\n\t}\n\tprintVerbose(src, dest)\n\tentries, err := os.ReadDir(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot read directory\", src, err)\n\t}\n\tfailed := false\n\tfor _, e := range entries {\n\t\ts := filepath.Join(src, e.Name())\n\t\td := filepath.Join(dest, e.Name())\n\t\tif err := copyFile(s, d); err != nil {\n\t\t\tif err != errDeclined && err != errPartial {\n\t\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n\t\t\t}\n\t\t\tfailed = true\n\t\t}\n\t}\n\tif err := preserveAttrs(src, dest); err != nil {\n\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\", err)\n\t\tfailed = true\n\t}\n\tif failed {\n\t\treturn errPartial\n\t}\n\treturn nil\n}\n\nfunc copyLink(src, dest string) error {\n\ttarget, err := os.Readlink(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot readlink\", src, err)\n\t}\n\tos.Remove(dest)\n\tif err := os.Symlink(target, dest); err != nil {\n\t\treturn fmtPathErr(\"cannot create symlink\", dest, err)\n\t}\n\tprintVerbose(src, dest)\n\treturn preserveAttrs(src, dest)\n}\n\nfunc doCopy(src, dest string, mode os.FileMode) error {\n\tin, err := os.Open(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot open\", src, err)\n\t}\n\tdefer in.Close()\n\tout, err := os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n\tif err != nil && unlinkDest {\n\t\tos.Remove(dest)\n\t\tout, err = os.OpenFile(dest, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, mode)\n\t}\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot create regular file\", dest, err)\n\t}\n\tdefer out.Close()\n\tif _, err := io.Copy(out, in); err != nil {\n\t\treturn err\n\t}\n\tif err := out.Close(); err != nil {\n\t\treturn err\n\t}\n\tprintVerbose(src, dest)\n\treturn preserveAttrs(src, dest)\n}\n\nfunc confirmOverwrite(dest string) bool {\n\tfmt.Fprintf(os.Stderr, \"cp: overwrite '%s'? \", dest)\n\tline, _ := stdinReader.ReadString('\\n')\n\treturn len(line) > 0 && (line[0] == 'y' || line[0] == 'Y')\n}\n\nfunc fmtPathErr(verb, path string, err error) error {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, pe.Err)\n\t}\n\treturn fmt.Errorf(\"%s '%s': %s\", verb, path, err)\n}\n\nfunc preserveAttrs(src, dest string) error {\n\tif !preserveMode && !preserveOwnership && !preserveTimestamps {\n\t\treturn nil\n\t}\n\tfi, err := sys.Lstat(src)\n\tif err != nil {\n\t\treturn fmtPathErr(\"cannot stat\", src, err)\n\t}\n\tisLink := fi.Mode&os.ModeSymlink != 0\n\tif preserveMode && !isLink {\n\t\tperm := fi.Mode & (os.ModePerm | os.ModeSetuid | os.ModeSetgid | os.ModeSticky)\n\t\tif err := os.Chmod(dest, perm); err != nil {\n\t\t\treturn fmtPathErr(\"preserving permissions for\", dest, err)\n\t\t}\n\t}\n\tif preserveTimestamps && !isLink {\n\t\tif err := os.Chtimes(dest, fi.AccessTime, fi.ModTime); err != nil {\n\t\t\treturn fmtPathErr(\"preserving times for\", dest, err)\n\t\t}\n\t}\n\tif preserveOwnership {\n\t\tif err := os.Lchown(dest, int(fi.Uid), int(fi.Gid)); err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"cp: %s\\n\",\n\t\t\t\tfmtPathErr(\"preserving ownership for\", dest, err))\n\t\t}\n\t}\n\treturn nil\n}\n\nfunc printVerbose(src, dest string) {\n\tif verbose {\n\t\tfmt.Printf(\"'%s' -> '%s'\\n\", src, dest)\n\t}\n}\n","numLines":379,"startLine":1,"totalLines":379}}}
