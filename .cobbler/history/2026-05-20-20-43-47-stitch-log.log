estutils.DiffTest{\n283\t\t\t\t{\n284\t\t\t\t\tName:    \"precedence\",\n285\t\t\t\t\tArgs:    []string{\"-in\", \"src.txt\", \"dest.txt\"},\n286\t\t\t\t\tWorkDir: dir,\n287\t\t\t\t\tEnv:     env,\n288\t\t\t\t\tExpectedFiles: map[string][]byte{\n289\t\t\t\t\t\t\"dest.txt\": []byte(\"original\\n\"),\n290\t\t\t\t\t},\n291\t\t\t\t},\n292\t\t\t})\n293\t\t})\n294\t\n295\t\tt.Run(\"r2_1_recursive\", func(t *testing.T) {\n296\t\t\tdir := t.TempDir()\n297\t\t\tos.MkdirAll(filepath.Join(dir, \"src\", \"sub\"), 0o755)\n298\t\t\twriteFile(t, dir, \"src/a.txt\", \"aaa\\n\")\n299\t\t\twriteFile(t, dir, \"src/sub/b.txt\", \"bbb\\n\")\n300\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n301\t\t\t\t{\n302\t\t\t\t\tName:    \"nested\",\n303\t\t\t\t\tArgs:    []string{\"-r\", \"src\", \"dest\"},\n304\t\t\t\t\tWorkDir: dir,\n305\t\t\t\t\tEnv:     env,\n306\t\t\t\t\tExpectedFiles: map[string][]byte{\n307\t\t\t\t\t\t\"dest/a.txt\":     []byte(\"aaa\\n\"),\n308\t\t\t\t\t\t\"dest/sub/b.txt\": []byte(\"bbb\\n\"),\n309\t\t\t\t\t},\n310\t\t\t\t},\n311\t\t\t})\n312\t\t})\n313\t\n314\t\tt.Run(\"r2_1_recursive_into_dir\", func(t *testing.T) {\n315\t\t\tdir := t.TempDir()\n316\t\t\tos.MkdirAll(filepath.Join(dir, \"src\"), 0o755)\n317\t\t\twriteFile(t, dir, \"src/a.txt\", \"hello\\n\")\n318\t\t\tos.Mkdir(filepath.Join(dir, \"target\"), 0o755)\n319\t\t\ttestutils.RunDiffTests(t, goBin, refBin, []testutils.DiffTest{\n320\t\t\t\t{\n321\t\t\t\t\tName:    \"into_dir\",\n322\t\t\t\t\tArgs:    []string{\"-r\", \"src\", \"target\"},\n323\t\t\t\t\tWorkDir: dir,\n324\t\t\t\t\tEnv:     env,\n325\t\t\t\t\tExpectedFiles: map[string][]byte{\n326\t\t\t\t\t\t\"target/src/a.txt\": []byte(\"hello\\n\"),\n327\t\t\t\t\t},\n328\t\t\t\t},\n329\t\t\t})\n330\t\t})\n331\t\n332\t\tt.Run(\"r2_1_R_flag\", func(t *testing.T) {\n333\t\t\tdir := t.TempDir()\n334\t\t\tos.MkdirAll(filepath.Join(dir, \"src\"), 0o755)\n335\t\t\twriteFile(t, dir, \"src/f.txt\", \"data\\n\")\n336\t\t\ttestutils.RunDiffTests(t, g