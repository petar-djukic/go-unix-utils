{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UcAnLgeqtUigdVveYQ7fT8","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// cmd/chmod implements srd089-chmod R1.1-R1.4, R2.1-R2.4, R4.1-R4.3.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strconv\"\n13\t\t\"strings\"\n14\t\t\"syscall\"\n15\t\n16\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n17\t)\n18\t\n19\tconst helpText = `Usage: chmod [OPTION]... MODE[,MODE]... FILE...\n20\t  or:  chmod [OPTION]... OCTAL-MODE FILE...\n21\tChange the mode of each FILE to MODE.\n22\t\n23\t  -c, --changes        like verbose but report only when a change is made\n24\t  -f, --silent, --quiet  suppress most error messages\n25\t  -v, --verbose        output a diagnostic for every file processed\n26\t  -R, --recursive      change files and directories recursively\n27\t      --help     display this help and exit\n28\t      --version  output version information and exit\n29\t\n30\tEach MODE is of the form '[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+'.\n31\t`\n32\t\n33\tconst versionText = `chmod (go-unix-utils) dev\n34\t`\n35\t\n36\ttype options struct {\n37\t\tverbose   bool\n38\t\tchanges   bool\n39\t\tsilent    bool\n40\t\trecursive bool\n41\t}\n42\t\n43\tfunc main() {\n44\t\tsys.InstallSIGPIPEHandler()\n45\t\n46\t\topts, mode, files := parseArgs(os.Args[1:])\n47\t\tif len(files) == 0 {\n48\t\t\tfmt.Fprintf(os.Stderr, \"chmod: missing operand after '%s'\\n\", mode)\n49\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n50\t\t\tos.Exit(1)\n51\t\t}\n52\t\n53\t\texitCode := 0\n54\t\tfor _, file := range files {\n55\t\t\tif err := processFile(opts, mode, file); err != nil {\n56\t\t\t\texitCode = 1\n57\t\t\t}\n58\t\t}\n59\t\tif exitCode != 0 {\n60\t\t\tos.Exit(exitCode)\n61\t\t}\n62\t}\n63\t\n64\tfunc processFile(opts options, mode string, path string) error {\n65\t\tif opts.recursive {\n66\t\t\treturn processRecursive(opts, mode, path)\n67\t\t}\n68\t\treturn applyAndReport(opts, mode, path)\n69\t}\n70\t\n71\tfunc processRecursive(opts options, mode string, root string) error {\n72\t\tvar walkErr error\n73\t\terr := filepath.WalkDir(root, func(path string, _ os.DirEntry, err error) error {\n74\t\t\tif err != nil {\n75\t\t\t\treportError(opts, path, err)\n76\t\t\t\twalkErr = err\n77\t\t\t\treturn nil\n78\t\t\t}\n79\t\t\tif applyErr := applyAndReport(opts, mode, path); applyErr != nil {\n80\t\t\t\twalkErr = applyErr\n81\t\t\t}\n82\t\t\treturn nil\n83\t\t})\n84\t\tif err != nil {\n85\t\t\treturn err\n86\t\t}\n87\t\treturn walkErr\n88\t}\n89\t\n90\tfunc applyAndReport(opts options, mode string, path string) error {\n91\t\toldMode, err := getMode(path)\n92\t\tif err != nil {\n93\t\t\treportError(opts, path, err)\n94\t\t\treturn err\n95\t\t}\n96\t\tif err := applyMode(mode, path); err != nil {\n97\t\t\treportError(opts, path, err)\n98\t\t\treturn err\n99\t\t}\n100\t\tnewMode, err := getMode(path)\n101\t\tif err != nil {\n102\t\t\treportError(opts, path, err)\n103\t\t\treturn err\n104\t\t}\n105\t\tprintDiagnostic(opts, path, oldMode, newMode)\n106\t\treturn nil\n107\t}\n108\t\n109\tfunc getMode(path string) (os.FileMode, error) {\n110\t\tinfo, err := os.Lstat(path)\n111\t\tif err != nil {\n112\t\t\treturn 0, err\n113\t\t}\n114\t\treturn info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky)), nil\n115\t}\n116\t\n117\tfunc reportError(opts options, _ string, err error) {\n118\t\tif opts.silent {\n119\t\t\treturn\n120\t\t}\n121\t\tfmt.Fprintf(os.Stderr, \"chmod: %s\\n\", formatErr(err))\n122\t}\n123\t\n124\tfunc printDiagnostic(opts options, path string, oldMode, newMode os.FileMode) {\n125\t\tif opts.verbose {\n126\t\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n127\t\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n128\t\t\treturn\n129\t\t}\n130\t\tif opts.changes && oldMode != newMode {\n131\t\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n132\t\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n133\t\t}\n134\t}\n135\t\n136\tfunc symbolicString(mode os.FileMode) string {\n137\t\tvar buf [9]byte\n138\t\tconst rwx = \"rwx\"\n139\t\tfor i := range 9 {\n140\t\t\tif mode&(1<<uint(8-i)) != 0 {\n141\t\t\t\tbuf[i] = rwx[i%3]\n142\t\t\t} else {\n143\t\t\t\tbuf[i] = '-'\n144\t\t\t}\n145\t\t}\n146\t\tapplySpecialBits(&buf, mode)\n147\t\treturn string(buf[:])\n148\t}\n149\t\n150\tfunc applySpecialBits(buf *[9]byte, mode os.FileMode) {\n151\t\tif mode&os.ModeSetuid != 0 {\n152\t\t\tif buf[2] == 'x' {\n153\t\t\t\tbuf[2] = 's'\n154\t\t\t} else {\n155\t\t\t\tbuf[2] = 'S'\n156\t\t\t}\n157\t\t}\n158\t\tif mode&os.ModeSetgid != 0 {\n159\t\t\tif buf[5] == 'x' {\n160\t\t\t\tbuf[5] = 's'\n161\t\t\t} else {\n162\t\t\t\tbuf[5] = 'S'\n163\t\t\t}\n164\t\t}\n165\t\tif mode&os.ModeSticky != 0 {\n166\t\t\tif buf[8] == 'x' {\n167\t\t\t\tbuf[8] = 't'\n168\t\t\t} else {\n169\t\t\t\tbuf[8] = 'T'\n170\t\t\t}\n171\t\t}\n172\t}\n173\t\n174\tfunc parseArgs(args []string) (options, string, []string) {\n175\t\tvar opts options\n176\t\tvar files []string\n177\t\tmode := \"\"\n178\t\tendOfFlags := false\n179\t\tfor _, arg := range args {\n180\t\t\tif endOfFlags {\n181\t\t\t\tfiles = append(files, arg)\n182\t\t\t\tcontinue\n183\t\t\t}\n184\t\t\tif handled := handleSpecialArg(arg, &endOfFlags); handled {\n185\t\t\t\tcontinue\n186\t\t\t}\n187\t\t\tif mode == \"\" {\n188\t\t\t\tif parseLongFlag(arg, &opts) {\n189\t\t\t\t\tcontinue\n190\t\t\t\t}\n191\t\t\t\tif strings.HasPrefix(arg, \"-\") && parseShortFlags(arg[1:], &opts) {\n192\t\t\t\t\tcontinue\n193\t\t\t\t}\n194\t\t\t\tmode = arg\n195\t\t\t} else {\n196\t\t\t\tfiles = append(files, arg)\n197\t\t\t}\n198\t\t}\n199\t\tif mode == \"\" {\n200\t\t\tfmt.Fprintln(os.Stderr, \"chmod: missing operand\")\n201\t\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n202\t\t\tos.Exit(1)\n203\t\t}\n204\t\treturn opts, mode, files\n205\t}\n206\t\n207\tfunc handleSpecialArg(arg string, endOfFlags *bool) bool {\n208\t\tswitch arg {\n209\t\tcase \"--help\":\n210\t\t\tfmt.Fprint(os.Stdout, helpText)\n211\t\t\tos.Exit(0)\n212\t\tcase \"--version\":\n213\t\t\tfmt.Fprint(os.Stdout, versionText)\n214\t\t\tos.Exit(0)\n215\t\tcase \"--\":\n216\t\t\t*endOfFlags = true\n217\t\tdefault:\n218\t\t\treturn false\n219\t\t}\n220\t\treturn true\n221\t}\n222\t\n223\tfunc parseLongFlag(arg string, opts *options) bool {\n224\t\tswitch arg {\n225\t\tcase \"--verbose\":\n226\t\t\topts.verbose = true\n227\t\tcase \"--changes\":\n228\t\t\topts.changes = true\n229\t\tcase \"--silent\", \"--quiet\":\n230\t\t\topts.silent = true\n231\t\tcase \"--recursive\":\n232\t\t\topts.recursive = true\n233\t\tdefault:\n234\t\t\treturn false\n235\t\t}\n236\t\treturn true\n237\t}\n238\t\n239\tfunc parseShortFlags(flags string, opts *options) bool {\n240\t\tfor _, c := range flags {\n241\t\t\tswitch c {\n242\t\t\tcase 'v':\n243\t\t\t\topts.verbose = true\n244\t\t\tcase 'c':\n245\t\t\t\topts.changes = true\n246\t\t\tcase 'f':\n247\t\t\t\topts.silent = true\n248\t\t\tcase 'R':\n249\t\t\t\topts.recursive = true\n250\t\t\tdefault:\n251\t\t\t\treturn false\n252\t\t\t}\n253\t\t}\n254\t\treturn true\n255\t}\n256\t\n257\tfunc applyMode(mode string, path string) error {\n258\t\tif isOctalMode(mode) {\n259\t\t\treturn applyOctalMode(mode, path)\n260\t\t}\n261\t\treturn applySymbolicMode(mode, path)\n262\t}\n263\t\n264\tfunc isOctalMode(mode string) bool {\n265\t\ts := mode\n266\t\tif strings.HasPrefix(s, \"0\") && len(s) > 1 {\n267\t\t\ts = s[1:]\n268\t\t}\n269\t\tif len(s) == 0 {\n270\t\t\treturn false\n271\t\t}\n272\t\tfor _, c := range s {\n273\t\t\tif c < '0' || c > '7' {\n274\t\t\t\treturn false\n275\t\t\t}\n276\t\t}\n277\t\treturn true\n278\t}\n279\t\n280\tfunc applyOctalMode(mode string, path string) error {\n281\t\tval, err := strconv.ParseUint(mode, 8, 32)\n282\t\tif err != nil {\n283\t\t\treturn fmt.Errorf(\"invalid mode: %q\", mode)\n284\t\t}\n285\t\treturn os.Chmod(path, os.FileMode(val))\n286\t}\n287\t\n288\tfunc getUmask() os.FileMode {\n289\t\told := syscall.Umask(0)\n290\t\tsyscall.Umask(old)\n291\t\treturn os.FileMode(old)\n292\t}\n293\t\n294\tfunc applySymbolicMode(mode string, path string) error {\n295\t\tinfo, err := os.Stat(path)\n296\t\tif err != nil {\n297\t\t\treturn err\n298\t\t}\n299\t\tcurrent := info.Mode()\n300\t\tnewMode, err := evalSymbolic(mode, current, getUmask())\n301\t\tif err != nil {\n302\t\t\treturn err\n303\t\t}\n304\t\treturn os.Chmod(path, newMode)\n305\t}\n306\t\n307\tfunc evalSymbolic(spec string, current os.FileMode, umask os.FileMode) (os.FileMode, error) {\n308\t\tperm := current.Perm() | (current & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky))\n309\t\tfor clause := range strings.SplitSeq(spec, \",\") {\n310\t\t\tvar err error\n311\t\t\tperm, err = evalClause(clause, perm, umask)\n312\t\t\tif err != nil {\n313\t\t\t\treturn 0, err\n314\t\t\t}\n315\t\t}\n316\t\treturn perm, nil\n317\t}\n318\t\n319\tfunc evalClause(clause string, perm os.FileMode, umask os.FileMode) (os.FileMode, error) {\n320\t\ti := 0\n321\t\twho := parseWho(clause, &i)\n322\t\tif i >= len(clause) {\n323\t\t\treturn 0, fmt.Errorf(\"invalid mode: %q\", clause)\n324\t\t}\n325\t\tfor i < len(clause) {\n326\t\t\top := clause[i]\n327\t\t\tif op != '+' && op != '-' && op != '=' {\n328\t\t\t\treturn 0, fmt.Errorf(\"invalid mode: %q\", clause)\n329\t\t\t}\n330\t\t\ti++\n331\t\t\tbits := parsePerms(clause, &i)\n332\t\t\tperm = applyOp(perm, who, op, bits, umask)\n333\t\t}\n334\t\treturn perm, nil\n335\t}\n336\t\n337\ttype permBits struct {\n338\t\tread    bool\n339\t\twrite   bool\n340\t\texec    bool\n341\t\texecX   bool\n342\t\tsetuid  bool\n343\t\tsetgid  bool\n344\t\tsticky  bool\n345\t}\n346\t\n347\tfunc parseWho(clause string, pos *int) string {\n348\t\tstart := *pos\n349\t\tfor *pos < len(clause) {\n350\t\t\tc := clause[*pos]\n351\t\t\tif c == 'u' || c == 'g' || c == 'o' || c == 'a' {\n352\t\t\t\t*pos++\n353\t\t\t} else {\n354\t\t\t\tbreak\n355\t\t\t}\n356\t\t}\n357\t\treturn clause[start:*pos]\n358\t}\n359\t\n360\tfunc parsePerms(clause string, pos *int) permBits {\n361\t\tvar bits permBits\n362\t\tfor *pos < len(clause) {\n363\t\t\tc := clause[*pos]\n364\t\t\tswitch c {\n365\t\t\tcase 'r':\n366\t\t\t\tbits.read = true\n367\t\t\tcase 'w':\n368\t\t\t\tbits.write = true\n369\t\t\tcase 'x':\n370\t\t\t\tbits.exec = true\n371\t\t\tcase 'X':\n372\t\t\t\tbits.execX = true\n373\t\t\tcase 's':\n374\t\t\t\tbits.setuid = true\n375\t\t\t\tbits.setgid = true\n376\t\t\tcase 't':\n377\t\t\t\tbits.sticky = true\n378\t\t\tdefault:\n379\t\t\t\treturn bits\n380\t\t\t}\n381\t\t\t*pos++\n382\t\t}\n383\t\treturn bits\n384\t}\n385\t\n386\tfunc applyOp(perm os.FileMode, who string, op byte, bits permBits, umask os.FileMode) os.FileMode {\n387\t\timplicit := who == \"\"\n388\t\tif implicit || strings.ContainsRune(who, 'a') {\n389\t\t\twho = \"ugo\"\n390\t\t}\n391\t\n392\t\tvar mask os.FileMode\n393\t\tfor _, w := range who {\n394\t\t\tmask |= buildMask(w, bits, perm)\n395\t\t}\n396\t\n397\t\tif implicit {\n398\t\t\tmask &^= umask\n399\t\t}\n400\t\n401\t\tswitch op {\n402\t\tcase '+':\n403\t\t\tperm |= mask\n404\t\tcase '-':\n405\t\t\tperm &^= mask\n406\t\tcase '=':\n407\t\t\tperm = applyEquals(perm, who, mask)\n408\t\t}\n409\t\treturn perm\n410\t}\n411\t\n412\tfunc buildMask(who rune, bits permBits, current os.FileMode) os.FileMode {\n413\t\tvar rBit, wBit, xBit os.FileMode\n414\t\tvar specialBit os.FileMode\n415\t\tuseSpecial := false\n416\t\n417\t\tswitch who {\n418\t\tcase 'u':\n419\t\t\trBit, wBit, xBit = 0400, 0200, 0100\n420\t\t\tspecialBit = os.ModeSetuid\n421\t\t\tuseSpecial = bits.setuid || bits.setgid\n422\t\tcase 'g':\n423\t\t\trBit, wBit, xBit = 0040, 0020, 0010\n424\t\t\tspecialBit = os.ModeSetgid\n425\t\t\tuseSpecial = bits.setuid || bits.setgid\n426\t\tcase 'o':\n427\t\t\trBit, wBit, xBit = 0004, 0002, 0001\n428\t\t\tspecialBit = os.ModeSticky\n429\t\t\tuseSpecial = bits.sticky\n430\t\t}\n431\t\n432\t\tvar mask os.FileMode\n433\t\tif bits.read {\n434\t\t\tmask |= rBit\n435\t\t}\n436\t\tif bits.write {\n437\t\t\tmask |= wBit\n438\t\t}\n439\t\tif bits.exec {\n440\t\t\tmask |= xBit\n441\t\t}\n442\t\tif bits.execX && current&0111 != 0 {\n443\t\t\tmask |= xBit\n444\t\t}\n445\t\tif useSpecial {\n446\t\t\tmask |= specialBit\n447\t\t}\n448\t\treturn mask\n449\t}\n450\t\n451\tfunc applyEquals(perm os.FileMode, who string, mask os.FileMode) os.FileMode {\n452\t\tvar clear os.FileMode\n453\t\tfor _, w := range who {\n454\t\t\tswitch w {\n455\t\t\tcase 'u':\n456\t\t\t\tclear |= 0700 | os.ModeSetuid\n457\t\t\tcase 'g':\n458\t\t\t\tclear |= 0070 | os.ModeSetgid\n459\t\t\tcase 'o':\n460\t\t\t\tclear |= 0007 | os.ModeSticky\n461\t\t\t}\n462\t\t}\n463\t\tperm &^= clear\n464\t\tperm |= mask\n465\t\treturn perm\n466\t}\n467\t\n468\tfunc formatErr(err error) string {\n469\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n470\t\t\treturn fmt.Sprintf(\"cannot access '%s': %s\", pe.Path, pe.Err)\n471\t\t}\n472\t\treturn err.Error()\n473\t}\n474\t"}]},"parent_tool_use_id":null,"session_id":"3c405804-8588-4f74-b501-dd34c5ea73f5","uuid":"d35e1c47-97fc-4833-8867-9cd461f3877f","timestamp":"2026-05-23T17:13:51.090Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5549/cmd/chmod/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// cmd/chmod implements srd089-chmod R1.1-R1.4, R2.1-R2.4, R4.1-R4.3.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"strconv\"\n\t\"strings\"\n\t\"syscall\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: chmod [OPTION]... MODE[,MODE]... FILE...\n  or:  chmod [OPTION]... OCTAL-MODE FILE...\nChange the mode of each FILE to MODE.\n\n  -c, --changes        like verbose but report only when a change is made\n  -f, --silent, --quiet  suppress most error messages\n  -v, --verbose        output a diagnostic for every file processed\n  -R, --recursive      change files and directories recursively\n      --help     display this help and exit\n      --version  output version information and exit\n\nEach MODE is of the form '[ugoa]*([-+=]([rwxXst]*|[ugo]))+|[-+=][0-7]+'.\n`\n\nconst versionText = `chmod (go-unix-utils) dev\n`\n\ntype options struct {\n\tverbose   bool\n\tchanges   bool\n\tsilent    bool\n\trecursive bool\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\n\topts, mode, files := parseArgs(os.Args[1:])\n\tif len(files) == 0 {\n\t\tfmt.Fprintf(os.Stderr, \"chmod: missing operand after '%s'\\n\", mode)\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\n\texitCode := 0\n\tfor _, file := range files {\n\t\tif err := processFile(opts, mode, file); err != nil {\n\t\t\texitCode = 1\n\t\t}\n\t}\n\tif exitCode != 0 {\n\t\tos.Exit(exitCode)\n\t}\n}\n\nfunc processFile(opts options, mode string, path string) error {\n\tif opts.recursive {\n\t\treturn processRecursive(opts, mode, path)\n\t}\n\treturn applyAndReport(opts, mode, path)\n}\n\nfunc processRecursive(opts options, mode string, root string) error {\n\tvar walkErr error\n\terr := filepath.WalkDir(root, func(path string, _ os.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treportError(opts, path, err)\n\t\t\twalkErr = err\n\t\t\treturn nil\n\t\t}\n\t\tif applyErr := applyAndReport(opts, mode, path); applyErr != nil {\n\t\t\twalkErr = applyErr\n\t\t}\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn walkErr\n}\n\nfunc applyAndReport(opts options, mode string, path string) error {\n\toldMode, err := getMode(path)\n\tif err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tif err := applyMode(mode, path); err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tnewMode, err := getMode(path)\n\tif err != nil {\n\t\treportError(opts, path, err)\n\t\treturn err\n\t}\n\tprintDiagnostic(opts, path, oldMode, newMode)\n\treturn nil\n}\n\nfunc getMode(path string) (os.FileMode, error) {\n\tinfo, err := os.Lstat(path)\n\tif err != nil {\n\t\treturn 0, err\n\t}\n\treturn info.Mode().Perm() | (info.Mode() & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky)), nil\n}\n\nfunc reportError(opts options, _ string, err error) {\n\tif opts.silent {\n\t\treturn\n\t}\n\tfmt.Fprintf(os.Stderr, \"chmod: %s\\n\", formatErr(err))\n}\n\nfunc printDiagnostic(opts options, path string, oldMode, newMode os.FileMode) {\n\tif opts.verbose {\n\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n\t\treturn\n\t}\n\tif opts.changes && oldMode != newMode {\n\t\tfmt.Fprintf(os.Stdout, \"mode of '%s' changed from %04o (%s) to %04o (%s)\\n\",\n\t\t\tpath, uint32(oldMode), symbolicString(oldMode), uint32(newMode), symbolicString(newMode))\n\t}\n}\n\nfunc symbolicString(mode os.FileMode) string {\n\tvar buf [9]byte\n\tconst rwx = \"rwx\"\n\tfor i := range 9 {\n\t\tif mode&(1<<uint(8-i)) != 0 {\n\t\t\tbuf[i] = rwx[i%3]\n\t\t} else {\n\t\t\tbuf[i] = '-'\n\t\t}\n\t}\n\tapplySpecialBits(&buf, mode)\n\treturn string(buf[:])\n}\n\nfunc applySpecialBits(buf *[9]byte, mode os.FileMode) {\n\tif mode&os.ModeSetuid != 0 {\n\t\tif buf[2] == 'x' {\n\t\t\tbuf[2] = 's'\n\t\t} else {\n\t\t\tbuf[2] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSetgid != 0 {\n\t\tif buf[5] == 'x' {\n\t\t\tbuf[5] = 's'\n\t\t} else {\n\t\t\tbuf[5] = 'S'\n\t\t}\n\t}\n\tif mode&os.ModeSticky != 0 {\n\t\tif buf[8] == 'x' {\n\t\t\tbuf[8] = 't'\n\t\t} else {\n\t\t\tbuf[8] = 'T'\n\t\t}\n\t}\n}\n\nfunc parseArgs(args []string) (options, string, []string) {\n\tvar opts options\n\tvar files []string\n\tmode := \"\"\n\tendOfFlags := false\n\tfor _, arg := range args {\n\t\tif endOfFlags {\n\t\t\tfiles = append(files, arg)\n\t\t\tcontinue\n\t\t}\n\t\tif handled := handleSpecialArg(arg, &endOfFlags); handled {\n\t\t\tcontinue\n\t\t}\n\t\tif mode == \"\" {\n\t\t\tif parseLongFlag(arg, &opts) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tif strings.HasPrefix(arg, \"-\") && parseShortFlags(arg[1:], &opts) {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tmode = arg\n\t\t} else {\n\t\t\tfiles = append(files, arg)\n\t\t}\n\t}\n\tif mode == \"\" {\n\t\tfmt.Fprintln(os.Stderr, \"chmod: missing operand\")\n\t\tfmt.Fprintln(os.Stderr, \"Try 'chmod --help' for more information.\")\n\t\tos.Exit(1)\n\t}\n\treturn opts, mode, files\n}\n\nfunc handleSpecialArg(arg string, endOfFlags *bool) bool {\n\tswitch arg {\n\tcase \"--help\":\n\t\tfmt.Fprint(os.Stdout, helpText)\n\t\tos.Exit(0)\n\tcase \"--version\":\n\t\tfmt.Fprint(os.Stdout, versionText)\n\t\tos.Exit(0)\n\tcase \"--\":\n\t\t*endOfFlags = true\n\tdefault:\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc parseLongFlag(arg string, opts *options) bool {\n\tswitch arg {\n\tcase \"--verbose\":\n\t\topts.verbose = true\n\tcase \"--changes\":\n\t\topts.changes = true\n\tcase \"--silent\", \"--quiet\":\n\t\topts.silent = true\n\tcase \"--recursive\":\n\t\topts.recursive = true\n\tdefault:\n\t\treturn false\n\t}\n\treturn true\n}\n\nfunc parseShortFlags(flags string, opts *options) bool {\n\tfor _, c := range flags {\n\t\tswitch c {\n\t\tcase 'v':\n\t\t\topts.verbose = true\n\t\tcase 'c':\n\t\t\topts.changes = true\n\t\tcase 'f':\n\t\t\topts.silent = true\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tdefault:\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc applyMode(mode string, path string) error {\n\tif isOctalMode(mode) {\n\t\treturn applyOctalMode(mode, path)\n\t}\n\treturn applySymbolicMode(mode, path)\n}\n\nfunc isOctalMode(mode string) bool {\n\ts := mode\n\tif strings.HasPrefix(s, \"0\") && len(s) > 1 {\n\t\ts = s[1:]\n\t}\n\tif len(s) == 0 {\n\t\treturn false\n\t}\n\tfor _, c := range s {\n\t\tif c < '0' || c > '7' {\n\t\t\treturn false\n\t\t}\n\t}\n\treturn true\n}\n\nfunc applyOctalMode(mode string, path string) error {\n\tval, err := strconv.ParseUint(mode, 8, 32)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"invalid mode: %q\", mode)\n\t}\n\treturn os.Chmod(path, os.FileMode(val))\n}\n\nfunc getUmask() os.FileMode {\n\told := syscall.Umask(0)\n\tsyscall.Umask(old)\n\treturn os.FileMode(old)\n}\n\nfunc applySymbolicMode(mode string, path string) error {\n\tinfo, err := os.Stat(path)\n\tif err != nil {\n\t\treturn err\n\t}\n\tcurrent := info.Mode()\n\tnewMode, err := evalSymbolic(mode, current, getUmask())\n\tif err != nil {\n\t\treturn err\n\t}\n\treturn os.Chmod(path, newMode)\n}\n\nfunc evalSymbolic(spec string, current os.FileMode, umask os.FileMode) (os.FileMode, error) {\n\tperm := current.Perm() | (current & (os.ModeSetuid | os.ModeSetgid | os.ModeSticky))\n\tfor clause := range strings.SplitSeq(spec, \",\") {\n\t\tvar err error\n\t\tperm, err = evalClause(clause, perm, umask)\n\t\tif err != nil {\n\t\t\treturn 0, err\n\t\t}\n\t}\n\treturn perm, nil\n}\n\nfunc evalClause(clause string, perm os.FileMode, umask os.FileMode) (os.FileMode, error) {\n\ti := 0\n\twho := parseWho(clause, &i)\n\tif i >= len(clause) {\n\t\treturn 0, fmt.Errorf(\"invalid mode: %q\", clause)\n\t}\n\tfor i < len(clause) {\n\t\top := clause[i]\n\t\tif op != '+' && op != '-' && op != '=' {\n\t\t\treturn 0, fmt.Errorf(\"invalid mode: %q\", clause)\n\t\t}\n\t\ti++\n\t\tbits := parsePerms(clause, &i)\n\t\tperm = applyOp(perm, who, op, bits, umask)\n\t}\n\treturn perm, nil\n}\n\ntype permBits struct {\n\tread    bool\n\twrite   bool\n\texec    bool\n\texecX   bool\n\tsetuid  bool\n\tsetgid  bool\n\tsticky  bool\n}\n\nfunc parseWho(clause string, pos *int) string {\n\tstart := *pos\n\tfor *pos < len(clause) {\n\t\tc := clause[*pos]\n\t\tif c == 'u' || c == 'g' || c == 'o' || c == 'a' {\n\t\t\t*pos++\n\t\t} else {\n\t\t\tbreak\n\t\t}\n\t}\n\treturn clause[start:*pos]\n}\n\nfunc parsePerms(clause string, pos *int) permBits {\n\tvar bits permBits\n\tfor *pos < len(clause) {\n\t\tc := clause[*pos]\n\t\tswitch c {\n\t\tcase 'r':\n\t\t\tbits.read = true\n\t\tcase 'w':\n\t\t\tbits.write = true\n\t\tcase 'x':\n\t\t\tbits.exec = true\n\t\tcase 'X':\n\t\t\tbits.execX = true\n\t\tcase 's':\n\t\t\tbits.setuid = true\n\t\t\tbits.setgid = true\n\t\tcase 't':\n\t\t\tbits.sticky = true\n\t\tdefault:\n\t\t\treturn bits\n\t\t}\n\t\t*pos++\n\t}\n\treturn bits\n}\n\nfunc applyOp(perm os.FileMode, who string, op byte, bits permBits, umask os.FileMode) os.FileMode {\n\timplicit := who == \"\"\n\tif implicit || strings.ContainsRune(who, 'a') {\n\t\twho = \"ugo\"\n\t}\n\n\tvar mask os.FileMode\n\tfor _, w := range who {\n\t\tmask |= buildMask(w, bits, perm)\n\t}\n\n\tif implicit {\n\t\tmask &^= umask\n\t}\n\n\tswitch op {\n\tcase '+':\n\t\tperm |= mask\n\tcase '-':\n\t\tperm &^= mask\n\tcase '=':\n\t\tperm = applyEquals(perm, who, mask)\n\t}\n\treturn perm\n}\n\nfunc buildMask(who rune, bits permBits, current os.FileMode) os.FileMode {\n\tvar rBit, wBit, xBit os.FileMode\n\tvar specialBit os.FileMode\n\tuseSpecial := false\n\n\tswitch who {\n\tcase 'u':\n\t\trBit, wBit, xBit = 0400, 0200, 0100\n\t\tspecialBit = os.ModeSetuid\n\t\tuseSpecial = bits.setuid || bits.setgid\n\tcase 'g':\n\t\trBit, wBit, xBit = 0040, 0020, 0010\n\t\tspecialBit = os.ModeSetgid\n\t\tuseSpecial = bits.setuid || bits.setgid\n\tcase 'o':\n\t\trBit, wBit, xBit = 0004, 0002, 0001\n\t\tspecialBit = os.ModeSticky\n\t\tuseSpecial = bits.sticky\n\t}\n\n\tvar mask os.FileMode\n\tif bits.read {\n\t\tmask |= rBit\n\t}\n\tif bits.write {\n\t\tmask |= wBit\n\t}\n\tif bits.exec {\n\t\tmask |= xBit\n\t}\n\tif bits.execX && current&0111 != 0 {\n\t\tmask |= xBit\n\t}\n\tif useSpecial {\n\t\tmask |= specialBit\n\t}\n\treturn mask\n}\n\nfunc applyEquals(perm os.FileMode, who string, mask os.FileMode) os.FileMode {\n\tvar clear os.FileMode\n\tfor _, w := range who {\n\t\tswitch w {\n\t\tcase 'u':\n\t\t\tclear |= 0700 | os.ModeSetuid\n\t\tcase 'g':\n\t\t\tclear |= 0070 | os.ModeSetgid\n\t\tcase 'o':\n\t\t\tclear |= 0007 | os.ModeSticky\n\t\t}\n\t}\n\tperm &^= clear\n\tperm |= mask\n\treturn perm\n}\n\nfunc formatErr(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn fmt.Sprintf(\"cannot access '%s': %s\", pe.Path, pe.Err)\n\t}\n\treturn err.Error()\n}\n","numLines":474,"startLine":1,"totalLines":474}}}
