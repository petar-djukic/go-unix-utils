!= nil {\n\t\treturn err\n\t}\n\tend := int64(len(data)) - n\n\tif end <= 0 {\n\t\treturn nil\n\t}\n\t_, err = w.Write(data[:end])\n\treturn err\n}\n","numLines":330,"startLine":1,"totalLines":330}}}
