\n79\t\t\tgapSize: defaultGapSize,\n80\t\t}\n81\t\ti := 0\n82\t\tfor i < len(args) {\n83\t\t\ta := args[i]\n84\t\t\tif a == \"--\" {\n85\t\t\t\ti++\n86\t\t\t\tbreak\n87\t\t\t}\n88\t\t\tif strings.HasPrefix(a, \"--\") {\n89\t\t\t\tn, err := parseLongFlag(a, args[i+1:], &opts)\n90\t\t\t\tif err != nil {\n91\t\t\t\t\treturn opts, err\n92\t\t\t\t}\n93\t\t\t\ti += 1 + n\n94\t\t\t\tcontinue\n95\t\t\t}\n96\t\t\tif a != \"-\" && strings.HasPrefix(a, \"-\") {\n97\t\t\t\tn, err := parseShortFlags(a[1:], args[i+1:], &opts)\n98\t\t\t\tif err != nil {\n99\t\t\t\t\treturn opts, err\n100\t\t\t\t}\n101\t\t\t\ti += 1 + n\n102\t\t\t\tcontinue\n103\t\t\t}\n104\t\t\tbreak\n105\t\t}\n106\t\topts.files = args[i:]\n107\t\tif len(opts.files) == 0 {\n108\t\t\topts.files = []string{\"-\"}\n109\t\t}\n110\t\treturn opts, nil\n111\t}\n112\t\n113\tfunc parseLongFlag(flag string, rest []string, opts *options) (int, error) {\n114\t\tif flag == \"--ignore-case\" {\n115\t\t\topts.ignoreCase = true\n116\t\t\treturn 0, nil\n117\t\t}\n118\t\tif strings.HasPrefix(flag, \"--width=\") {\n119\t\t\treturn 0, parseIntVal(flag[len(\"--width=\"):], &opts.width, \"width\")\n120\t\t}\n121\t\tif flag == \"--width\" {\n122\t\t\tif len(rest) == 0 {\n123\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n124\t\t\t}\n125\t\t\treturn 1, parseIntVal(rest[0], &opts.width, \"width\")\n126\t\t}\n127\t\tif strings.HasPrefix(flag, \"--gap-size=\") {\n128\t\t\treturn 0, parseIntVal(flag[len(\"--gap-size=\"):], &opts.gapSize, \"gap-size\")\n129\t\t}\n130\t\tif flag == \"--gap-size\" {\n131\t\t\tif len(rest) == 0 {\n132\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n133\t\t\t}\n134\t\t\treturn 1, parseIntVal(rest[0], &opts.gapSize, \"gap-size\")\n135\t\t}\n136\t\tif strings.HasPrefix(flag, \"--word-regexp=\") {\n137\t\t\treturn 0, parseRegexpVal(flag[len(\"--word-regexp=\"):], &opts.wordRegexp)\n138\t\t}\n139\t\tif flag == \"--word-regexp\" {\n140\t\t\tif len(rest) == 0 {\n141\t\t\t\treturn 0, fmt.Errorf(\"option '%s' requires an argument\", flag)\n142\t\t\t}\n143\t\t\treturn 1, parseRegexpVal(rest[0], &opts.wordRegexp)\n144\t\t}\n145\t\treturn 0, fmt.Errorf(\"unrecognized option '%s'\", flag)\n146\t}\n147\t\n148\tfunc parseShortFlags(flags string, rest []string, opts *options) (int, error) {\n149\t\tfor i := 0; i < len(flags); i++ {\n150\t\t\tswitch flags[i] {\n151\t\t\tcase 'f':\n152\t\t\t\topts.ignoreCase = true\n153\t\t\tcase 'w':\n154\t\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.width, 'w')\n155\t\t\tcase 'g':\n156\t\t\t\treturn extractAndSetInt(flags[i+1:], rest, &opts.gapSize, 'g')\n157\t\t\tcase 'W':\n158\t\t\t\treturn extractAndSetRegexp(flags[i+1:], rest, &opts.wordRegexp)\n159\t\t\tdefault:\n160\t\t\t\treturn 0, fmt.Errorf(\"invalid option -- '%c'\", flags[i])\n161\t\t\t}\n162\t\t}\n163\t\treturn 0, nil\n164\t}\n165\t\n166\tfunc extractAndSetInt(tail string, rest []string, dst *int, flag byte) (int, error) {\n167\t\tval, consumed, err := extractFlagValue(tail, rest, flag)\n168\t\tif err != nil {\n169\t\t\treturn 0, err\n170\t\t}\n171\t\tif err := parseIntVal(val, dst, string(flag)); err != nil {\n172\t\t\treturn 0, err\n173\t\t}\n174\t\treturn consumed, nil\n175\t}\n176\t\n177\tfunc extractFlagValue(tail string, rest []string, flag byte) (string, int, error) {\n178\t\tif tail != \"\" {\n179\t\t\treturn tail, 0, nil\n180\t\t}\n181\t\tif len(rest) > 0 {\n182\t\t\treturn rest[0], 1, nil\n183\t\t}\n184\t\treturn \"\", 0, fmt.Errorf(\"option requires an argument -- '%c'\", flag)\n185\t}\n186\t\n187\tfunc extractAndSetRegexp(tail string, rest []string, dst **regexp.Regexp) (int, error) {\n188\t\tval, consumed, err := extractFlagValue(tail, rest, 'W')\n189\t\tif err != nil {\n190\t\t\treturn 0, err\n191\t\t}\n192\t\tif err := parseRegexpVal(val, dst); err != nil {\n193\t\t\treturn 0, err\n194\t\t}\n195\t\treturn consumed, nil\n196\t}\n197\t\n198\tfunc parseRegexpVal(s string, dst **regexp.Regexp) error {\n199\t\tre, err := re