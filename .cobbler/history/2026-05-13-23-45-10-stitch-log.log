\tfunc parseArgs(args []string) (options, []string, error) {\n64\t\tvar opts options\n65\t\tvar names []string\n66\t\n67\t\ti := 0\n68\t\tfor i < len(args) {\n69\t\t\targ := args[i]\n70\t\t\tif arg == \"--\" {\n71\t\t\t\tnames = append(names, args[i+1:]...)\n72\t\t\t\tbreak\n73\t\t\t}\n74\t\t\tif strings.HasPrefix(arg, \"--\") {\n75\t\t\t\tn, err := parseLongFlag(arg, args[i:], &opts)\n76\t\t\t\tif err != nil {\n77\t\t\t\t\treturn opts, nil, err\n78\t\t\t\t}\n79\t\t\t\ti += n\n80\t\t\t\tcontinue\n81\t\t\t}\n82\t\t\tif len(arg) > 1 && arg[0] == '-' {\n83\t\t\t\tn, err := parseShortFlags(arg[1:], args[i+1:], &opts)\n84\t\t\t\tif err != nil {\n85\t\t\t\t\treturn opts, nil, err\n86\t\t\t\t}\n87\t\t\t\ti += 1 + n\n88\t\t\t\tcontinue\n89\t\t\t}\n90\t\t\tnames = append(names, arg)\n91\t\t\ti++\n92\t\t}\n93\t\n94\t\tif len(names) == 0 {\n95\t\t\treturn opts, nil, fmt.Errorf(\"missing operand\")\n96\t\t}\n97\t\tif !opts.multiple && len(names) > 2 {\n98\t\t\treturn opts, nil, fmt.Errorf(\"extra operand '%s'\", names[2])\n99\t\t}\n100\t\t// R1.2: single-argument mode treats second positional arg as suffix\n101\t\tif !opts.multiple && len(names) == 2 {\n102\t\t\topts.suffix = names[1]\n103\t\t\tnames = names[:1]\n104\t\t}\n105\t\n106\t\treturn opts, names, nil\n107\t}\n108\t\n109\tfunc parseLongFlag(flag string, remaining []string, opts *options) (int, error) {\n110\t\tswitch {\n111\t\tcase flag == \"--help\":\n112\t\t\tfmt.Fprint(os.Stdout, helpText)\n113\t\t\tos.Exit(0)\n114\t\t\treturn 0, nil\n115\t\tcase flag == \"--version\":\n116\t\t\tfmt.Fprint(os.Stdout, versionText)\n117\t\t\tos.Exit(0)\n118\t\t\treturn 0, nil\n119\t\tcase flag == \"--multiple\":\n120\t\t\topts.multiple = true\n121\t\t\treturn 1, nil\n122\t\tcase flag == \"--zero\":\n123\t\t\topts.zero = true\n124\t\t\treturn 1, nil\n125\t\tcase flag == \"--suffix\":\n126\t\t\tif len(remaining) < 2 {\n127\t\t\t\treturn 0, fmt.Errorf(\"option '--suffix' requires an argument\")\n128\t\t\t}\n129\t\t\topts.suffix = remaini