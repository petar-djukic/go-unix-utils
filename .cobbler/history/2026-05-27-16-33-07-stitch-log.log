{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014mnt4UixYE1iyEv3kfw8ZK","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\t// Implements srd107-dir R1.1-R1.5, R2.1-R2.4.\n5\tpackage main\n6\t\n7\timport (\n8\t\t\"errors\"\n9\t\t\"fmt\"\n10\t\t\"os\"\n11\t\t\"sort\"\n12\t\t\"strings\"\n13\t\n14\t\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n15\t)\n16\t\n17\tconst helpText = `Usage: dir [OPTION]... [FILE]...\n18\tList directory contents.\n19\t\n20\t  -a             do not ignore entries starting with .\n21\t  -A             do not list implied . and ..\n22\t  -C             list entries by columns\n23\t  -d             list directories themselves, not their contents\n24\t  -F             append indicator (one of */=>@|) to entries\n25\t  -h             with -l and/or -s, print human readable sizes\n26\t  -i             print the index number of each file\n27\t  -l             use a long listing format\n28\t  -n             like -l, but list numeric user and group IDs\n29\t  -R             list subdirectories recursively\n30\t  -r             reverse order while sorting\n31\t  -s             print the allocated size of each file, in blocks\n32\t  -S             sort by file size, largest first\n33\t  -t             sort by modification time, newest first\n34\t  -U             do not sort; list entries in directory order\n35\t  -v             natural sort of (version) numbers within text\n36\t  -x             list entries by lines instead of by columns\n37\t  -1             list one file per line\n38\t      --color[=WHEN]  colorize the output; WHEN can be 'always'\n39\t                         (default if omitted), 'auto', or 'never'\n40\t      --help     display this help and exit\n41\t      --version  output version information and exit\n42\t`\n43\t\n44\tconst versionText = `dir (go-unix-utils) dev\n45\t`\n46\t\n47\ttype options struct {\n48\t\tsingleColumn   bool\n49\t\tlongFormat     bool\n50\t\tforceColumns   bool\n51\t\thorizontalSort bool\n52\t\tshowAll        bool\n53\t\tshowAlmostAll  bool\n54\t\tdirAsEntry     bool\n55\t\tsortByTime     bool\n56\t\tsortBySize     bool\n57\t\treverseSort    bool\n58\t\tunsorted       bool\n59\t\tversionSort    bool\n60\t\tshowInode      bool\n61\t\tshowBlocks     bool\n62\t\tnumericIds     bool\n63\t\thumanReadable  bool\n64\t\tclassify       bool\n65\t\trecursive      bool\n66\t\tcolorMode      string\n67\t}\n68\t\n69\tfunc main() {\n70\t\tsys.InstallSIGPIPEHandler()\n71\t\topts, paths := parseArgs(os.Args[1:])\n72\t\tos.Exit(run(paths, opts))\n73\t}\n74\t\n75\tfunc parseArgs(args []string) (options, []string) {\n76\t\topts := options{forceColumns: true}\n77\t\tvar paths []string\n78\t\tfor len(args) > 0 {\n79\t\t\targ := args[0]\n80\t\t\targs = args[1:]\n81\t\t\tswitch {\n82\t\t\tcase arg == \"--help\":\n83\t\t\t\tfmt.Fprint(os.Stdout, helpText)\n84\t\t\t\tos.Exit(0)\n85\t\t\tcase arg == \"--version\":\n86\t\t\t\tfmt.Fprint(os.Stdout, versionText)\n87\t\t\t\tos.Exit(0)\n88\t\t\tcase arg == \"--\":\n89\t\t\t\treturn opts, append(paths, args...)\n90\t\t\tcase arg == \"--color\":\n91\t\t\t\topts.colorMode = \"always\"\n92\t\t\tcase strings.HasPrefix(arg, \"--color=\"):\n93\t\t\t\topts.colorMode = parseColorValue(arg)\n94\t\t\tcase strings.HasPrefix(arg, \"--\"):\n95\t\t\t\tfmt.Fprintf(os.Stderr, \"dir: unrecognized option '%s'\\n\", arg)\n96\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'dir --help' for more information.\")\n97\t\t\t\tos.Exit(2)\n98\t\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n99\t\t\t\tparseShortFlags(arg[1:], &opts)\n100\t\t\tdefault:\n101\t\t\t\tpaths = append(paths, arg)\n102\t\t\t}\n103\t\t}\n104\t\treturn opts, paths\n105\t}\n106\t\n107\tfunc parseShortFlags(flags string, opts *options) {\n108\t\tfor _, ch := range flags {\n109\t\t\tswitch ch {\n110\t\t\tcase '1':\n111\t\t\t\topts.forceColumns = false\n112\t\t\t\topts.horizontalSort = false\n113\t\t\t\tif !opts.longFormat {\n114\t\t\t\t\topts.singleColumn = true\n115\t\t\t\t}\n116\t\t\tcase 'l':\n117\t\t\t\topts.longFormat = true\n118\t\t\t\topts.singleColumn = false\n119\t\t\t\topts.forceColumns = false\n120\t\t\t\topts.horizontalSort = false\n121\t\t\tcase 'C':\n122\t\t\t\topts.forceColumns = true\n123\t\t\t\topts.horizontalSort = false\n124\t\t\t\topts.longFormat = false\n125\t\t\t\topts.singleColumn = false\n126\t\t\tcase 'x':\n127\t\t\t\topts.forceColumns = true\n128\t\t\t\topts.horizontalSort = true\n129\t\t\t\topts.longFormat = false\n130\t\t\t\topts.singleColumn = false\n131\t\t\tcase 'a':\n132\t\t\t\topts.showAll = true\n133\t\t\t\topts.showAlmostAll = false\n134\t\t\tcase 'A':\n135\t\t\t\topts.showAlmostAll = true\n136\t\t\t\topts.showAll = false\n137\t\t\tcase 'b', 'B', 'c', 'G', 'H', 'k', 'L', 'm', 'N',\n138\t\t\t\t'o', 'p', 'q', 'Q', 'u', 'X', 'Z':\n139\t\t\tcase 'd':\n140\t\t\t\topts.dirAsEntry = true\n141\t\t\tcase 'f':\n142\t\t\t\topts.showAll = true\n143\t\t\t\topts.showAlmostAll = false\n144\t\t\t\topts.unsorted = true\n145\t\t\t\topts.sortByTime = false\n146\t\t\t\topts.sortBySize = false\n147\t\t\t\topts.versionSort = false\n148\t\t\tcase 'F':\n149\t\t\t\topts.classify = true\n150\t\t\tcase 'g':\n151\t\t\t\topts.longFormat = true\n152\t\t\t\topts.singleColumn = false\n153\t\t\t\topts.forceColumns = false\n154\t\t\t\topts.horizontalSort = false\n155\t\t\tcase 'h':\n156\t\t\t\topts.humanReadable = true\n157\t\t\tcase 'i':\n158\t\t\t\topts.showInode = true\n159\t\t\tcase 'n':\n160\t\t\t\topts.numericIds = true\n161\t\t\t\topts.longFormat = true\n162\t\t\t\topts.singleColumn = false\n163\t\t\t\topts.forceColumns = false\n164\t\t\t\topts.horizontalSort = false\n165\t\t\tcase 'R':\n166\t\t\t\topts.recursive = true\n167\t\t\tcase 'r':\n168\t\t\t\topts.reverseSort = true\n169\t\t\tcase 's':\n170\t\t\t\topts.showBlocks = true\n171\t\t\tcase 't':\n172\t\t\t\topts.sortByTime = true\n173\t\t\t\topts.sortBySize = false\n174\t\t\t\topts.unsorted = false\n175\t\t\t\topts.versionSort = false\n176\t\t\tcase 'S':\n177\t\t\t\topts.sortBySize = true\n178\t\t\t\topts.sortByTime = false\n179\t\t\t\topts.unsorted = false\n180\t\t\t\topts.versionSort = false\n181\t\t\tcase 'U':\n182\t\t\t\topts.unsorted = true\n183\t\t\t\topts.sortByTime = false\n184\t\t\t\topts.sortBySize = false\n185\t\t\t\topts.versionSort = false\n186\t\t\tcase 'v':\n187\t\t\t\topts.versionSort = true\n188\t\t\t\topts.sortByTime = false\n189\t\t\t\topts.sortBySize = false\n190\t\t\t\topts.unsorted = false\n191\t\t\tdefault:\n192\t\t\t\tfmt.Fprintf(os.Stderr, \"dir: invalid option -- '%c'\\n\", ch)\n193\t\t\t\tfmt.Fprintln(os.Stderr, \"Try 'dir --help' for more information.\")\n194\t\t\t\tos.Exit(2)\n195\t\t\t}\n196\t\t}\n197\t}\n198\t\n199\tfunc parseColorValue(arg string) string {\n200\t\tval := arg[len(\"--color=\"):]\n201\t\tswitch val {\n202\t\tcase \"always\", \"auto\", \"never\":\n203\t\t\treturn val\n204\t\tdefault:\n205\t\t\tfmt.Fprintf(os.Stderr, \"dir: invalid argument '%s' for '--color'\\n\", val)\n206\t\t\tfmt.Fprintln(os.Stderr, \"Try 'dir --help' for more information.\")\n207\t\t\tos.Exit(2)\n208\t\t\treturn \"\"\n209\t\t}\n210\t}\n211\t\n212\tfunc run(paths []string, opts options) int {\n213\t\tif len(paths) == 0 {\n214\t\t\tpaths = []string{\".\"}\n215\t\t}\n216\t\n217\t\twidth := termWidth()\n218\t\texitCode := 0\n219\t\n220\t\tvar files []string\n221\t\tvar dirs []string\n222\t\tfor _, p := range paths {\n223\t\t\tinfo, err := os.Lstat(p)\n224\t\t\tif err != nil {\n225\t\t\t\tfmt.Fprintf(os.Stderr, \"dir: cannot access '%s': %s\\n\", p, sysErrMsg(err))\n226\t\t\t\texitCode = 2\n227\t\t\t\tcontinue\n228\t\t\t}\n229\t\t\tif info.IsDir() && !opts.dirAsEntry {\n230\t\t\t\tdirs = append(dirs, p)\n231\t\t\t} else {\n232\t\t\t\tfiles = append(files, p)\n233\t\t\t}\n234\t\t}\n235\t\n236\t\tshowHeaders := len(dirs) > 1 || len(files) > 0 || opts.recursive\n237\t\tprinted := false\n238\t\n239\t\tif len(files) > 0 {\n240\t\t\tsortNames(files, opts)\n241\t\t\tescaped := make([]string, len(files))\n242\t\t\tfor i, f := range files {\n243\t\t\t\tescaped[i] = escapeC(f)\n244\t\t\t}\n245\t\t\twriteEntries(escaped, width, opts)\n246\t\t\tprinted = true\n247\t\t}\n248\t\n249\t\tfor _, d := range dirs {\n250\t\t\tif printed {\n251\t\t\t\tfmt.Println()\n252\t\t\t}\n253\t\t\tif showHeaders {\n254\t\t\t\tfmt.Printf(\"%s:\\n\", d)\n255\t\t\t}\n256\t\t\tnames, err := listDir(d, opts)\n257\t\t\tif err != nil {\n258\t\t\t\tfmt.Fprintf(os.Stderr, \"dir: cannot open directory '%s': %s\\n\", d, sysErrMsg(err))\n259\t\t\t\texitCode = 1\n260\t\t\t\tprinted = true\n261\t\t\t\tcontinue\n262\t\t\t}\n263\t\t\twriteEntries(names, width, opts)\n264\t\t\tprinted = true\n265\t\t}\n266\t\n267\t\treturn exitCode\n268\t}\n269\t\n270\tfunc sortNames(names []string, opts options) {\n271\t\tif opts.unsorted {\n272\t\t\treturn\n273\t\t}\n274\t\tif opts.reverseSort {\n275\t\t\tsort.Sort(sort.Reverse(sort.StringSlice(names)))\n276\t\t} else {\n277\t\t\tsort.Strings(names)\n278\t\t}\n279\t}\n280\t\n281\tfunc writeEntries(names []string, width int, opts options) {\n282\t\tif opts.singleColumn || opts.longFormat {\n283\t\t\tfor _, name := range names {\n284\t\t\t\tfmt.Println(name)\n285\t\t\t}\n286\t\t} else {\n287\t\t\tprintColumns(names, width)\n288\t\t}\n289\t}\n290\t\n291\tfunc termWidth() int {\n292\t\tw, err := sys.TerminalWidth()\n293\t\tif err != nil {\n294\t\t\treturn 80\n295\t\t}\n296\t\treturn w\n297\t}\n298\t\n299\tfunc listDir(path string, opts options) ([]string, error) {\n300\t\tentries, err := os.ReadDir(path)\n301\t\tif err != nil {\n302\t\t\treturn nil, err\n303\t\t}\n304\t\tnames := make([]string, 0, len(entries))\n305\t\tif opts.showAll {\n306\t\t\tnames = append(names, \".\", \"..\")\n307\t\t}\n308\t\tfor _, e := range entries {\n309\t\t\tname := e.Name()\n310\t\t\tif len(name) > 0 && name[0] == '.' {\n311\t\t\t\tif !opts.showAll && !opts.showAlmostAll {\n312\t\t\t\t\tcontinue\n313\t\t\t\t}\n314\t\t\t}\n315\t\t\tnames = append(names, name)\n316\t\t}\n317\t\tsortNames(names, opts)\n318\t\tescaped := make([]string, len(names))\n319\t\tfor i, name := range names {\n320\t\t\tescaped[i] = escapeC(name)\n321\t\t}\n322\t\treturn escaped, nil\n323\t}\n324\t\n325\tfunc escapeC(s string) string {\n326\t\tneedsEscape := false\n327\t\tfor i := 0; i < len(s); i++ {\n328\t\t\tc := s[i]\n329\t\t\tif c == '\\\\' || c == ' ' || c < 0x20 || c >= 0x7f {\n330\t\t\t\tneedsEscape = true\n331\t\t\t\tbreak\n332\t\t\t}\n333\t\t}\n334\t\tif !needsEscape {\n335\t\t\treturn s\n336\t\t}\n337\t\tvar b strings.Builder\n338\t\tb.Grow(len(s) * 2)\n339\t\tfor i := 0; i < len(s); i++ {\n340\t\t\tc := s[i]\n341\t\t\tswitch c {\n342\t\t\tcase '\\\\':\n343\t\t\t\tb.WriteString(\"\\\\\\\\\")\n344\t\t\tcase '\\a':\n345\t\t\t\tb.WriteString(\"\\\\a\")\n346\t\t\tcase '\\b':\n347\t\t\t\tb.WriteString(\"\\\\b\")\n348\t\t\tcase '\\t':\n349\t\t\t\tb.WriteString(\"\\\\t\")\n350\t\t\tcase '\\n':\n351\t\t\t\tb.WriteString(\"\\\\n\")\n352\t\t\tcase '\\v':\n353\t\t\t\tb.WriteString(\"\\\\v\")\n354\t\t\tcase '\\f':\n355\t\t\t\tb.WriteString(\"\\\\f\")\n356\t\t\tcase '\\r':\n357\t\t\t\tb.WriteString(\"\\\\r\")\n358\t\t\tcase ' ':\n359\t\t\t\tb.WriteString(\"\\\\ \")\n360\t\t\tdefault:\n361\t\t\t\tif c < 0x20 || c >= 0x7f {\n362\t\t\t\t\tb.WriteByte('\\\\')\n363\t\t\t\t\tb.WriteByte('0' + c>>6)\n364\t\t\t\t\tb.WriteByte('0' + (c>>3)&7)\n365\t\t\t\t\tb.WriteByte('0' + c&7)\n366\t\t\t\t} else {\n367\t\t\t\t\tb.WriteByte(c)\n368\t\t\t\t}\n369\t\t\t}\n370\t\t}\n371\t\treturn b.String()\n372\t}\n373\t\n374\tfunc printColumns(names []string, width int) {\n375\t\tn := len(names)\n376\t\tif n == 0 {\n377\t\t\treturn\n378\t\t}\n379\t\tlens := make([]int, n)\n380\t\tfor i, name := range names {\n381\t\t\tlens[i] = len(name)\n382\t\t}\n383\t\tncols, nrows := computeLayout(lens, width)\n384\t\tcolWidths := make([]int, ncols)\n385\t\tfor col := range ncols {\n386\t\t\tfor row := range nrows {\n387\t\t\t\tidx := col*nrows + row\n388\t\t\t\tif idx < n && lens[idx] > colWidths[col] {\n389\t\t\t\t\tcolWidths[col] = lens[idx]\n390\t\t\t\t}\n391\t\t\t}\n392\t\t\tif col < ncols-1 {\n393\t\t\t\tcolWidths[col] += 2\n394\t\t\t}\n395\t\t}\n396\t\tfor row := range nrows {\n397\t\t\tpos := 0\n398\t\t\tfor col := range ncols {\n399\t\t\t\tidx := col*nrows + row\n400\t\t\t\tif idx >= n {\n401\t\t\t\t\tbreak\n402\t\t\t\t}\n403\t\t\t\tfmt.Print(names[idx])\n404\t\t\t\tnameEnd := pos + lens[idx]\n405\t\t\t\tnextIdx := (col+1)*nrows + row\n406\t\t\t\tif col+1 < ncols && nextIdx < n {\n407\t\t\t\t\ttarget := pos + colWidths[col]\n408\t\t\t\t\tprintIndent(nameEnd, target)\n409\t\t\t\t\tpos = target\n410\t\t\t\t}\n411\t\t\t}\n412\t\t\tfmt.Println()\n413\t\t}\n414\t}\n415\t\n416\tfunc printIndent(from, to int) {\n417\t\tfor from < to {\n418\t\t\tif to/8 > (from+1)/8 {\n419\t\t\t\tfmt.Print(\"\\t\")\n420\t\t\t\tfrom += 8 - from%8\n421\t\t\t} else {\n422\t\t\t\tfmt.Print(\" \")\n423\t\t\t\tfrom++\n424\t\t\t}\n425\t\t}\n426\t}\n427\t\n428\tfunc computeLayout(lens []int, width int) (int, int) {\n429\t\tn := len(lens)\n430\t\tif n == 0 {\n431\t\t\treturn 0, 0\n432\t\t}\n433\t\tmaxCols := min(n, width)\n434\t\tfor nc := maxCols; nc >= 2; nc-- {\n435\t\t\tnr := (n + nc - 1) / nc\n436\t\t\ttotal := 0\n437\t\t\tfits := true\n438\t\t\tfor col := range nc {\n439\t\t\t\tcolMax := 0\n440\t\t\t\tfor row := range nr {\n441\t\t\t\t\tidx := col*nr + row\n442\t\t\t\t\tif idx < n && lens[idx] > colMax {\n443\t\t\t\t\t\tcolMax = lens[idx]\n444\t\t\t\t\t}\n445\t\t\t\t}\n446\t\t\t\ttotal += colMax\n447\t\t\t\tif col < nc-1 {\n448\t\t\t\t\ttotal += 2\n449\t\t\t\t}\n450\t\t\t\tif total > width {\n451\t\t\t\t\tfits = false\n452\t\t\t\t\tbreak\n453\t\t\t\t}\n454\t\t\t}\n455\t\t\tif fits {\n456\t\t\t\treturn nc, nr\n457\t\t\t}\n458\t\t}\n459\t\treturn 1, n\n460\t}\n461\t\n462\tfunc sysErrMsg(err error) string {\n463\t\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n464\t\t\treturn capitalize(pe.Err.Error())\n465\t\t}\n466\t\treturn capitalize(err.Error())\n467\t}\n468\t\n469\tfunc capitalize(s string) string {\n470\t\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n471\t\t\treturn strings.ToUpper(s[:1]) + s[1:]\n472\t\t}\n473\t\treturn s\n474\t}\n475\t"}]},"parent_tool_use_id":null,"session_id":"c7ba62e5-5152-4b58-8bb2-97c322bbe1e7","uuid":"fa7265d6-f1ab-457c-a5cf-782320eeee70","timestamp":"2026-05-27T20:33:18.667Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/dl/cbns6zkx7txc7pt64b6cgzp40000gn/T/go-unix-utils-worktrees/5611/cmd/dir/main.go","content":"// Copyright (c) 2026 Petar Djukic. All rights reserved.\n// SPDX-License-Identifier: MIT\n\n// Implements srd107-dir R1.1-R1.5, R2.1-R2.4.\npackage main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"sort\"\n\t\"strings\"\n\n\t\"github.com/petar-djukic/go-unix-utils/pkg/sys\"\n)\n\nconst helpText = `Usage: dir [OPTION]... [FILE]...\nList directory contents.\n\n  -a             do not ignore entries starting with .\n  -A             do not list implied . and ..\n  -C             list entries by columns\n  -d             list directories themselves, not their contents\n  -F             append indicator (one of */=>@|) to entries\n  -h             with -l and/or -s, print human readable sizes\n  -i             print the index number of each file\n  -l             use a long listing format\n  -n             like -l, but list numeric user and group IDs\n  -R             list subdirectories recursively\n  -r             reverse order while sorting\n  -s             print the allocated size of each file, in blocks\n  -S             sort by file size, largest first\n  -t             sort by modification time, newest first\n  -U             do not sort; list entries in directory order\n  -v             natural sort of (version) numbers within text\n  -x             list entries by lines instead of by columns\n  -1             list one file per line\n      --color[=WHEN]  colorize the output; WHEN can be 'always'\n                         (default if omitted), 'auto', or 'never'\n      --help     display this help and exit\n      --version  output version information and exit\n`\n\nconst versionText = `dir (go-unix-utils) dev\n`\n\ntype options struct {\n\tsingleColumn   bool\n\tlongFormat     bool\n\tforceColumns   bool\n\thorizontalSort bool\n\tshowAll        bool\n\tshowAlmostAll  bool\n\tdirAsEntry     bool\n\tsortByTime     bool\n\tsortBySize     bool\n\treverseSort    bool\n\tunsorted       bool\n\tversionSort    bool\n\tshowInode      bool\n\tshowBlocks     bool\n\tnumericIds     bool\n\thumanReadable  bool\n\tclassify       bool\n\trecursive      bool\n\tcolorMode      string\n}\n\nfunc main() {\n\tsys.InstallSIGPIPEHandler()\n\topts, paths := parseArgs(os.Args[1:])\n\tos.Exit(run(paths, opts))\n}\n\nfunc parseArgs(args []string) (options, []string) {\n\topts := options{forceColumns: true}\n\tvar paths []string\n\tfor len(args) > 0 {\n\t\targ := args[0]\n\t\targs = args[1:]\n\t\tswitch {\n\t\tcase arg == \"--help\":\n\t\t\tfmt.Fprint(os.Stdout, helpText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--version\":\n\t\t\tfmt.Fprint(os.Stdout, versionText)\n\t\t\tos.Exit(0)\n\t\tcase arg == \"--\":\n\t\t\treturn opts, append(paths, args...)\n\t\tcase arg == \"--color\":\n\t\t\topts.colorMode = \"always\"\n\t\tcase strings.HasPrefix(arg, \"--color=\"):\n\t\t\topts.colorMode = parseColorValue(arg)\n\t\tcase strings.HasPrefix(arg, \"--\"):\n\t\t\tfmt.Fprintf(os.Stderr, \"dir: unrecognized option '%s'\\n\", arg)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'dir --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\tcase strings.HasPrefix(arg, \"-\") && len(arg) > 1:\n\t\t\tparseShortFlags(arg[1:], &opts)\n\t\tdefault:\n\t\t\tpaths = append(paths, arg)\n\t\t}\n\t}\n\treturn opts, paths\n}\n\nfunc parseShortFlags(flags string, opts *options) {\n\tfor _, ch := range flags {\n\t\tswitch ch {\n\t\tcase '1':\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\t\tif !opts.longFormat {\n\t\t\t\topts.singleColumn = true\n\t\t\t}\n\t\tcase 'l':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'C':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = false\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'x':\n\t\t\topts.forceColumns = true\n\t\t\topts.horizontalSort = true\n\t\t\topts.longFormat = false\n\t\t\topts.singleColumn = false\n\t\tcase 'a':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\tcase 'A':\n\t\t\topts.showAlmostAll = true\n\t\t\topts.showAll = false\n\t\tcase 'b', 'B', 'c', 'G', 'H', 'k', 'L', 'm', 'N',\n\t\t\t'o', 'p', 'q', 'Q', 'u', 'X', 'Z':\n\t\tcase 'd':\n\t\t\topts.dirAsEntry = true\n\t\tcase 'f':\n\t\t\topts.showAll = true\n\t\t\topts.showAlmostAll = false\n\t\t\topts.unsorted = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.versionSort = false\n\t\tcase 'F':\n\t\t\topts.classify = true\n\t\tcase 'g':\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'h':\n\t\t\topts.humanReadable = true\n\t\tcase 'i':\n\t\t\topts.showInode = true\n\t\tcase 'n':\n\t\t\topts.numericIds = true\n\t\t\topts.longFormat = true\n\t\t\topts.singleColumn = false\n\t\t\topts.forceColumns = false\n\t\t\topts.horizontalSort = false\n\t\tcase 'R':\n\t\t\topts.recursive = true\n\t\tcase 'r':\n\t\t\topts.reverseSort = true\n\t\tcase 's':\n\t\t\topts.showBlocks = true\n\t\tcase 't':\n\t\t\topts.sortByTime = true\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'S':\n\t\t\topts.sortBySize = true\n\t\t\topts.sortByTime = false\n\t\t\topts.unsorted = false\n\t\t\topts.versionSort = false\n\t\tcase 'U':\n\t\t\topts.unsorted = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.versionSort = false\n\t\tcase 'v':\n\t\t\topts.versionSort = true\n\t\t\topts.sortByTime = false\n\t\t\topts.sortBySize = false\n\t\t\topts.unsorted = false\n\t\tdefault:\n\t\t\tfmt.Fprintf(os.Stderr, \"dir: invalid option -- '%c'\\n\", ch)\n\t\t\tfmt.Fprintln(os.Stderr, \"Try 'dir --help' for more information.\")\n\t\t\tos.Exit(2)\n\t\t}\n\t}\n}\n\nfunc parseColorValue(arg string) string {\n\tval := arg[len(\"--color=\"):]\n\tswitch val {\n\tcase \"always\", \"auto\", \"never\":\n\t\treturn val\n\tdefault:\n\t\tfmt.Fprintf(os.Stderr, \"dir: invalid argument '%s' for '--color'\\n\", val)\n\t\tfmt.Fprintln(os.Stderr, \"Try 'dir --help' for more information.\")\n\t\tos.Exit(2)\n\t\treturn \"\"\n\t}\n}\n\nfunc run(paths []string, opts options) int {\n\tif len(paths) == 0 {\n\t\tpaths = []string{\".\"}\n\t}\n\n\twidth := termWidth()\n\texitCode := 0\n\n\tvar files []string\n\tvar dirs []string\n\tfor _, p := range paths {\n\t\tinfo, err := os.Lstat(p)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"dir: cannot access '%s': %s\\n\", p, sysErrMsg(err))\n\t\t\texitCode = 2\n\t\t\tcontinue\n\t\t}\n\t\tif info.IsDir() && !opts.dirAsEntry {\n\t\t\tdirs = append(dirs, p)\n\t\t} else {\n\t\t\tfiles = append(files, p)\n\t\t}\n\t}\n\n\tshowHeaders := len(dirs) > 1 || len(files) > 0 || opts.recursive\n\tprinted := false\n\n\tif len(files) > 0 {\n\t\tsortNames(files, opts)\n\t\tescaped := make([]string, len(files))\n\t\tfor i, f := range files {\n\t\t\tescaped[i] = escapeC(f)\n\t\t}\n\t\twriteEntries(escaped, width, opts)\n\t\tprinted = true\n\t}\n\n\tfor _, d := range dirs {\n\t\tif printed {\n\t\t\tfmt.Println()\n\t\t}\n\t\tif showHeaders {\n\t\t\tfmt.Printf(\"%s:\\n\", d)\n\t\t}\n\t\tnames, err := listDir(d, opts)\n\t\tif err != nil {\n\t\t\tfmt.Fprintf(os.Stderr, \"dir: cannot open directory '%s': %s\\n\", d, sysErrMsg(err))\n\t\t\texitCode = 1\n\t\t\tprinted = true\n\t\t\tcontinue\n\t\t}\n\t\twriteEntries(names, width, opts)\n\t\tprinted = true\n\t}\n\n\treturn exitCode\n}\n\nfunc sortNames(names []string, opts options) {\n\tif opts.unsorted {\n\t\treturn\n\t}\n\tif opts.reverseSort {\n\t\tsort.Sort(sort.Reverse(sort.StringSlice(names)))\n\t} else {\n\t\tsort.Strings(names)\n\t}\n}\n\nfunc writeEntries(names []string, width int, opts options) {\n\tif opts.singleColumn || opts.longFormat {\n\t\tfor _, name := range names {\n\t\t\tfmt.Println(name)\n\t\t}\n\t} else {\n\t\tprintColumns(names, width)\n\t}\n}\n\nfunc termWidth() int {\n\tw, err := sys.TerminalWidth()\n\tif err != nil {\n\t\treturn 80\n\t}\n\treturn w\n}\n\nfunc listDir(path string, opts options) ([]string, error) {\n\tentries, err := os.ReadDir(path)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tnames := make([]string, 0, len(entries))\n\tif opts.showAll {\n\t\tnames = append(names, \".\", \"..\")\n\t}\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif len(name) > 0 && name[0] == '.' {\n\t\t\tif !opts.showAll && !opts.showAlmostAll {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t}\n\t\tnames = append(names, name)\n\t}\n\tsortNames(names, opts)\n\tescaped := make([]string, len(names))\n\tfor i, name := range names {\n\t\tescaped[i] = escapeC(name)\n\t}\n\treturn escaped, nil\n}\n\nfunc escapeC(s string) string {\n\tneedsEscape := false\n\tfor i := 0; i < len(s); i++ {\n\t\tc := s[i]\n\t\tif c == '\\\\' || c == ' ' || c < 0x20 || c >= 0x7f {\n\t\t\tneedsEscape = true\n\t\t\tbreak\n\t\t}\n\t}\n\tif !needsEscape {\n\t\treturn s\n\t}\n\tvar b strings.Builder\n\tb.Grow(len(s) * 2)\n\tfor i := 0; i < len(s); i++ {\n\t\tc := s[i]\n\t\tswitch c {\n\t\tcase '\\\\':\n\t\t\tb.WriteString(\"\\\\\\\\\")\n\t\tcase '\\a':\n\t\t\tb.WriteString(\"\\\\a\")\n\t\tcase '\\b':\n\t\t\tb.WriteString(\"\\\\b\")\n\t\tcase '\\t':\n\t\t\tb.WriteString(\"\\\\t\")\n\t\tcase '\\n':\n\t\t\tb.WriteString(\"\\\\n\")\n\t\tcase '\\v':\n\t\t\tb.WriteString(\"\\\\v\")\n\t\tcase '\\f':\n\t\t\tb.WriteString(\"\\\\f\")\n\t\tcase '\\r':\n\t\t\tb.WriteString(\"\\\\r\")\n\t\tcase ' ':\n\t\t\tb.WriteString(\"\\\\ \")\n\t\tdefault:\n\t\t\tif c < 0x20 || c >= 0x7f {\n\t\t\t\tb.WriteByte('\\\\')\n\t\t\t\tb.WriteByte('0' + c>>6)\n\t\t\t\tb.WriteByte('0' + (c>>3)&7)\n\t\t\t\tb.WriteByte('0' + c&7)\n\t\t\t} else {\n\t\t\t\tb.WriteByte(c)\n\t\t\t}\n\t\t}\n\t}\n\treturn b.String()\n}\n\nfunc printColumns(names []string, width int) {\n\tn := len(names)\n\tif n == 0 {\n\t\treturn\n\t}\n\tlens := make([]int, n)\n\tfor i, name := range names {\n\t\tlens[i] = len(name)\n\t}\n\tncols, nrows := computeLayout(lens, width)\n\tcolWidths := make([]int, ncols)\n\tfor col := range ncols {\n\t\tfor row := range nrows {\n\t\t\tidx := col*nrows + row\n\t\t\tif idx < n && lens[idx] > colWidths[col] {\n\t\t\t\tcolWidths[col] = lens[idx]\n\t\t\t}\n\t\t}\n\t\tif col < ncols-1 {\n\t\t\tcolWidths[col] += 2\n\t\t}\n\t}\n\tfor row := range nrows {\n\t\tpos := 0\n\t\tfor col := range ncols {\n\t\t\tidx := col*nrows + row\n\t\t\tif idx >= n {\n\t\t\t\tbreak\n\t\t\t}\n\t\t\tfmt.Print(names[idx])\n\t\t\tnameEnd := pos + lens[idx]\n\t\t\tnextIdx := (col+1)*nrows + row\n\t\t\tif col+1 < ncols && nextIdx < n {\n\t\t\t\ttarget := pos + colWidths[col]\n\t\t\t\tprintIndent(nameEnd, target)\n\t\t\t\tpos = target\n\t\t\t}\n\t\t}\n\t\tfmt.Println()\n\t}\n}\n\nfunc printIndent(from, to int) {\n\tfor from < to {\n\t\tif to/8 > (from+1)/8 {\n\t\t\tfmt.Print(\"\\t\")\n\t\t\tfrom += 8 - from%8\n\t\t} else {\n\t\t\tfmt.Print(\" \")\n\t\t\tfrom++\n\t\t}\n\t}\n}\n\nfunc computeLayout(lens []int, width int) (int, int) {\n\tn := len(lens)\n\tif n == 0 {\n\t\treturn 0, 0\n\t}\n\tmaxCols := min(n, width)\n\tfor nc := maxCols; nc >= 2; nc-- {\n\t\tnr := (n + nc - 1) / nc\n\t\ttotal := 0\n\t\tfits := true\n\t\tfor col := range nc {\n\t\t\tcolMax := 0\n\t\t\tfor row := range nr {\n\t\t\t\tidx := col*nr + row\n\t\t\t\tif idx < n && lens[idx] > colMax {\n\t\t\t\t\tcolMax = lens[idx]\n\t\t\t\t}\n\t\t\t}\n\t\t\ttotal += colMax\n\t\t\tif col < nc-1 {\n\t\t\t\ttotal += 2\n\t\t\t}\n\t\t\tif total > width {\n\t\t\t\tfits = false\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t\tif fits {\n\t\t\treturn nc, nr\n\t\t}\n\t}\n\treturn 1, n\n}\n\nfunc sysErrMsg(err error) string {\n\tif pe, ok := errors.AsType[*os.PathError](err); ok {\n\t\treturn capitalize(pe.Err.Error())\n\t}\n\treturn capitalize(err.Error())\n}\n\nfunc capitalize(s string) string {\n\tif len(s) > 0 && s[0] >= 'a' && s[0] <= 'z' {\n\t\treturn strings.ToUpper(s[:1]) + s[1:]\n\t}\n\treturn s\n}\n","numLines":475,"startLine":1,"totalLines":475}}}
