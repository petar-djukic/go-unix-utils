{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ABdHJRyrFRJ4XKkyjzQraz","type":"tool_result","content":"1\t// Copyright (c) 2026 Petar Djukic. All rights reserved.\n2\t// SPDX-License-Identifier: MIT\n3\t\n4\tpackage main\n5\t\n6\timport (\n7\t\t\"os\"\n8\t\t\"os/exec\"\n9\t\t\"path/filepath\"\n10\t\t\"regexp\"\n11\t\t\"testing\"\n12\t\n13\t\t\"github.com/petar-djukic/go-unix-utils/pkg/testutils\"\n14\t)\n15\t\n16\tvar progNameRe = regexp.MustCompile(`[^\\s']*gdir`)\n17\t\n18\tfunc programNameNormalizer(b []byte) []byte {\n19\t\treturn progNameRe.ReplaceAll(b, []byte(\"dir\"))\n20\t}\n21\t\n22\tfunc touchFile(t *testing.T, dir, name string) {\n23\t\tt.Helper()\n24\t\tif err := os.WriteFile(filepath.Join(dir, name), nil, 0644); err != nil {\n25\t\t\tt.Fatal(err)\n26\t\t}\n27\t}\n28\t\n29\tfunc TestDiff(t *testing.T) {\n30\t\tgoBin := testutils.BuildBinary(t, \".\")\n31\t\trefBin, err := exec.LookPath(\"gdir\")\n32\t\tif err != nil {\n33\t\t\tt.Skip(\"reference binary not found\")\n34\t\t}\n35\t\n36\t\terrNorm := []testutils.NormalizeFunc{programNameNormalizer}\n37\t\n38\t\tbasicDir := t.TempDir()\n39\t\tfor _, name := range []string{\n40\t\t\t\"alpha\", \"bravo\", \"charlie\", \"delta\", \"echo\",\n41\t\t\t\"foxtrot\", \"golf\", \"hotel\", \"india\", \"juliet\",\n42\t\t} {\n43\t\t\ttouchFile(t, basicDir, name)\n44\t\t}\n45\t\n46\t\tmixedDir := t.TempDir()\n47\t\tfor _, name := range []string{\".hidden\", \"Bravo\", \"alpha\", \".secret\", \"Charlie\"} {\n48\t\t\ttouchFile(t, mixedDir, name)\n49\t\t}\n50\t\n51\t\tsortDir := t.TempDir()\n52\t\tfor _, name := range []string{\"A\", \"B\", \"a\", \"b\", \"Z\", \"z\"} {\n53\t\t\ttouchFile(t, sortDir, name)\n54\t\t}\n55\t\n56\t\tescapeDir := t.TempDir()\n57\t\tfor _, name := range []string{\"normal\", \"has space\", \"back\\\\slash\", \"tab\\there\"} {\n58\t\t\ttouchFile(t, escapeDir, name)\n59\t\t}\n60\t\n61\t\tdefaultDir := t.TempDir()\n62\t\tfor _, name := range []string{\"one\", \"two\", \"three\"} {\n63\t\t\ttouchFile(t, defaultDir, name)\n64\t\t}\n65\t\n66\t\tshowAllDir := t.TempDir()\n67\t\tfor _, name := range []string{\".hidden\", \"visible\", \".dot\"} {\n68\t\t\ttouchFile(t, showAllDir, name)\n69\t\t}\n70\t\n71\t\treverseDir := t.TempDir()\n72\t\tfor _, name := range []string{\"alpha\", \"bravo\", \"charlie\"} {\n73\t\t\ttouchFile(t, reverseDir, name)\n74\t\t}\n75\t\n76\t\ttests := []testutils.DiffTest{\n77\t\t\t{Name: \"basic-listing\", Args: []string{basicDir}, Env: []string{\"COLUMNS=80\"}},\n78\t\t\t{Name: \"hidden-excluded\", Args: []string{mixedDir}, Env: []string{\"COLUMNS=80\"}},\n79\t\t\t{Name: \"c-locale-sort\", Args: []string{sortDir}, Env: []string{\"COLUMNS=80\"}},\n80\t\t\t{Name: \"escape-special\", Args: []string{escapeDir}, Env: []string{\"COLUMNS=80\"}},\n81\t\t\t{Name: \"default-cwd\", WorkDir: defaultDir, Env: []string{\"COLUMNS=80\"}},\n82\t\t\t{\n83\t\t\t\tName:      \"nonexistent\",\n84\t\t\t\tArgs:      []string{\"/nonexistent-path-12345\"},\n85\t\t\t\tExitCode:  2,\n86\t\t\t\tNormalize: errNorm,\n87\t\t\t},\n88\t\t\t{\n89\t\t\t\tName: \"flag-show-all\",\n90\t\t\t\tArgs: []string{\"-a\", showAllDir},\n91\t\t\t\tEnv:  []string{\"COLUMNS=80\"},\n92\t\t\t},\n93\t\t\t{\n94\t\t\t\tName: \"flag-almost-all\",\n95\t\t\t\tArgs: []string{\"-A\", showAllDir},\n96\t\t\t\tEnv:  []string{\"COLUMNS=80\"},\n97\t\t\t},\n98\t\t\t{\n99\t\t\t\tName: \"flag-reverse\",\n100\t\t\t\tArgs: []string{\"-r\", reverseDir},\n101\t\t\t\tEnv:  []string{\"COLUMNS=80\"},\n102\t\t\t},\n103\t\t\t{\n104\t\t\t\tName: \"flag-single-column\",\n105\t\t\t\tArgs: []string{\"-1\", basicDir},\n106\t\t\t\tEnv:  []string{\"COLUMNS=80\"},\n107\t\t\t},\n108\t\t\t{\n109\t\t\t\tName:      \"invalid-option\",\n110\t\t\t\tArgs:      []string{\"-j\"},\n111\t\t\t\tExitCode:  2,\n112\t\t\t\tNormalize: errNorm,\n113\t\t\t},\n114\t\t\t{\n115\t\t\t\tName:      \"invalid-long-option\",\n116\t\t\t\tArgs:      []string{\"--bogus-flag\"},\n117\t\t\t\tExitCode:  2,\n118\t\t\t\tNormalize: